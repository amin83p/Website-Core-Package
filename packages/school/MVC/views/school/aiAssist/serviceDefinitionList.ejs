<%
  const rows = Array.isArray(services) ? services : [];
  const headerBtns = (typeof headerManageBtns !== 'undefined' && Array.isArray(headerManageBtns)) ? headerManageBtns : [];
  const toolbarBtns = (typeof manageBtns !== 'undefined' && Array.isArray(manageBtns)) ? manageBtns : [];
%>

<div class="sections-page">
  <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <div class="d-flex align-items-center gap-2 flex-wrap">
      <h1 class="page-heading size-md m-0">
        <i class="bi bi-braces me-2"></i><%= title || 'School AI Service Definitions' %>
      </h1>
      <span class="badge bg-light text-dark border"><%= rows.length %> service<%= rows.length === 1 ? '' : 's' %></span>
    </div>
    <% if (headerBtns.length) { %>
      <div class="d-flex align-items-center flex-wrap gap-2">
        <% headerBtns.forEach((btn) => { %><%- String(btn || '').replace(/\bmb-2\b/g, '') %><% }) %>
      </div>
    <% } %>
  </div>

  <% if (toolbarBtns.length) { %>
    <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end mb-4">
      <% toolbarBtns.forEach((btn) => { %><%- btn %><% }) %>
    </div>
  <% } %>

  <div class="form-container wide" style="max-width: 1200px;" data-floating-row-actions="true">
    <div class="alert alert-light border d-flex gap-3 align-items-start mb-4">
      <i class="bi bi-info-circle-fill text-primary fs-5"></i>
      <div>
        <div class="fw-semibold">Configure inputs, prompts, and output shaping for each registered AI service.</div>
        <div class="small text-muted">Service keys come from code; this UI stores per-organization prompt templates and input schemas. Pair with Service Assignments for provider routing.</div>
      </div>
    </div>

    <% rows.forEach((row) => { %>
      <% const statusText = String(row.status || 'planned').toLowerCase(); %>
      <% const statusBadge = statusText === 'active' ? 'bg-success' : (statusText === 'planned' ? 'bg-secondary' : 'bg-light text-dark border'); %>
      <% const configured = Boolean(row.configured); %>
      <div class="card border-0 shadow-sm mb-3">
        <div class="card-body p-4">
          <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
              <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                <h5 class="fw-bold mb-0"><%= row.label || row.serviceKey %></h5>
                <span class="badge <%= statusBadge %> text-uppercase" style="font-size:0.7rem;"><%= statusText %></span>
                <% if (configured) { %>
                  <span class="badge bg-success-subtle text-success border border-success-subtle">Configured</span>
                <% } else { %>
                  <span class="badge bg-warning-subtle text-warning-emphasis border">Not configured</span>
                <% } %>
                <% if (row.isActive === false) { %>
                  <span class="badge bg-danger-subtle text-danger border">Inactive</span>
                <% } %>
              </div>
              <div class="small text-muted font-monospace mb-2"><%= row.serviceKey %></div>
              <% if (row.description) { %>
                <p class="small text-body-secondary mb-0"><%= row.description %></p>
              <% } %>
            </div>
            <div class="table-actions">
              <%- include('school/aiAssist/partials/aiAssistRowActions', {
                rowActionId: 'svcdef-' + row.serviceKey.replace(/[^a-zA-Z0-9_-]/g, '_'),
                rowActionTitle: 'Service definition actions',
                rowActionItems: [
                  { href: '/school/ai-assist/service-definitions/' + encodeURIComponent(row.serviceKey) + '/edit', label: 'Edit definition', icon: 'bi-pencil-square', className: 'btn-outline-primary' },
                  { href: '/school/ai-assist/service-assignments', label: 'Assignments', icon: 'bi-sliders' }
                ]
              }) %>
            </div>
          </div>
        </div>
      </div>
    <% }) %>

    <% if (!rows.length) { %>
      <p class="text-muted">No registered AI services are available.</p>
    <% } %>
  </div>
</div>