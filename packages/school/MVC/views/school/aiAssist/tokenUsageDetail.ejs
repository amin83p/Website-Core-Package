<%
  const row = usage || {};
%>

<div class="sections-page">
  <div class="d-flex flex-wrap gap-2 mb-3 justify-content-end">
    <% (navButtons || []).forEach((btn) => { %><%- btn %><% }) %>
  </div>
  <h1 class="page-heading size-md mb-4"><%= title %></h1>

  <dl class="row">
    <dt class="col-sm-3">ID</dt><dd class="col-sm-9"><code><%= row.id %></code></dd>
    <dt class="col-sm-3">Status</dt><dd class="col-sm-9"><%= row.status %></dd>
    <dt class="col-sm-3">User</dt><dd class="col-sm-9"><%= row.userId %></dd>
    <dt class="col-sm-3">Service</dt><dd class="col-sm-9"><%= row.serviceKey %></dd>
    <dt class="col-sm-3">Provider</dt><dd class="col-sm-9"><%= row.providerId %> (<%= row.providerRecordId %>)</dd>
    <dt class="col-sm-3">Model</dt><dd class="col-sm-9"><%= row.modelId %></dd>
    <dt class="col-sm-3">Tokens</dt><dd class="col-sm-9">prompt <%= row.promptTokenCount %> / completion <%= row.completionTokenCount %> / total <%= row.totalTokenCount %></dd>
    <dt class="col-sm-3">Duration</dt><dd class="col-sm-9"><%= row.durationMs %> ms</dd>
    <dt class="col-sm-3">Trace</dt><dd class="col-sm-9"><code><%= row.traceId %></code></dd>
    <% if (row.errorMessage) { %>
      <dt class="col-sm-3">Error</dt><dd class="col-sm-9 text-danger"><%= row.errorMessage %></dd>
    <% } %>
    <dt class="col-sm-3">Request summary</dt><dd class="col-sm-9"><pre class="small mb-0"><%= row.requestSummary || '' %></pre></dd>
    <dt class="col-sm-3">Response summary</dt><dd class="col-sm-9"><pre class="small mb-0"><%= row.responseSummary || '' %></pre></dd>
    <% if (String(row.usageSource || '').trim() === 'report_ai_assist') { %>
      <dt class="col-sm-3">Report context</dt>
      <dd class="col-sm-9"><code><%= row.reportContext || '' %></code></dd>
      <% if (row.reportInstanceId) { %>
        <dt class="col-sm-3">Report instance</dt><dd class="col-sm-9"><code><%= row.reportInstanceId %></code></dd>
      <% } %>
      <% if (row.reportAssignmentId) { %>
        <dt class="col-sm-3">Report assignment</dt><dd class="col-sm-9"><code><%= row.reportAssignmentId %></code></dd>
      <% } %>
      <% if (row.reportAssignmentRowId) { %>
        <dt class="col-sm-3">Assignment row</dt><dd class="col-sm-9"><code><%= row.reportAssignmentRowId %></code></dd>
      <% } %>
      <% if (row.reportTeacherId) { %>
        <dt class="col-sm-3">Teacher</dt><dd class="col-sm-9"><code><%= row.reportTeacherId %></code></dd>
      <% } %>
      <% if (row.reportTemplateId) { %>
        <dt class="col-sm-3">Template</dt><dd class="col-sm-9"><code><%= row.reportTemplateId %></code></dd>
      <% } %>
      <% if (row.bindingRowId) { %>
        <dt class="col-sm-3">AI binding</dt><dd class="col-sm-9"><code><%= row.bindingRowId %></code></dd>
      <% } %>
      <dt class="col-sm-3">Run inputs</dt>
      <dd class="col-sm-9">
        <pre class="small mb-0"><%= JSON.stringify(row.inputPayload || {}, null, 2) %></pre>
      </dd>
      <dt class="col-sm-3">Run output</dt>
      <dd class="col-sm-9">
        <pre class="small mb-0"><%= JSON.stringify(row.outputPayload || {}, null, 2) %></pre>
      </dd>
    <% } %>
  </dl>

  <a href="/school/ai-assist/token-usage" class="btn btn-outline-secondary">Back to list</a>
</div>