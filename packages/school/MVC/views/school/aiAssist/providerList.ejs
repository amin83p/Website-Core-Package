<%- include('partials/tablePages-start', {
  title,
  newUrl,
  newLabel,
  user,
  tableName,
  actionStateId,
  btn_export: true,
  print: true,
  headerManageBtns: typeof headerManageBtns !== 'undefined' ? headerManageBtns : [],
  manageBtns: typeof manageBtns !== 'undefined' ? manageBtns : []
}) %>

<%- include('partials/tablePages-search', {
  placeholder: 'Search by name, vendor, notes...',
  fields: ['id', 'name', 'providerId', 'notes', 'project', 'location']
}) %>

<div class="table-scroll-wrapper" data-floating-row-actions="true">
  <table class="table-responsive size-md" id="first-table">
    <thead>
      <tr>
        <th class="draggable ps-4" data-column="name">Name</th>
        <th class="draggable" data-column="providerId">Vendor</th>
        <th class="draggable" data-column="modelCount">Models</th>
        <th class="draggable" data-column="apiKeyMasked">Key</th>
        <th class="draggable" data-column="isDefault">Default</th>
        <th class="draggable" data-column="isActive">Status</th>
        <th class="draggable" data-column="updatedAt">Updated</th>
        <th class="text-end pe-4">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (!data || !data.length) { %>
        <tr><td colspan="8" class="text-center py-5 text-muted">No provider keys found.</td></tr>
      <% } %>
      <% (data || []).forEach((item) => { %>
        <tr>
          <td class="ps-4 fw-semibold"><%= item.name || item.id %></td>
          <td><span class="badge bg-info text-dark"><%= item.providerId || '-' %></span></td>
          <td><%= item.modelCount || 0 %></td>
          <td><span class="badge bg-light text-dark border"><%= item.apiKeyMasked || 'Not set' %></span></td>
          <td><%= item.isDefault ? 'Yes' : 'No' %></td>
          <td><%= item.isActive === false ? 'Inactive' : 'Active' %></td>
          <td><%= item.updatedAt || '-' %></td>
          <td class="table-actions text-end pe-4">
            <a href="/<%= newUrl %>/edit/<%= item.id %>" class="btn btn-sm btn-filled btn-edit">Edit</a>
            <button type="button" class="btn btn-sm btn-filled btn-delete delete-btn" data-id="<%= item.id %>">Delete</button>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('partials/pagination', {
  pagination,
  filters,
  baseUrlPath: newUrl
}) %>
<%- include('partials/tablePages-end') %>