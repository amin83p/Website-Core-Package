<%
  const actionId = typeof rowActionId !== 'undefined' ? String(rowActionId) : '';
  const items = Array.isArray(rowActionItems) ? rowActionItems : [];
  const menuTitle = typeof rowActionTitle !== 'undefined' ? String(rowActionTitle) : 'Actions';
%>
<% if (actionId && items.length) { %>
  <div class="row-actions-wrap">
    <button
      type="button"
      class="btn btn-secondary btn-sm btn-row-actions-toggle"
      data-row-actions-id="<%= actionId %>"
      title="<%= menuTitle %>">
      <i class="bi bi-three-dots-vertical"></i>
    </button>
    <div class="row-actions-menu d-none" data-row-actions-id="<%= actionId %>">
      <% items.forEach((item) => { %>
        <% if (item && item.type === 'delete') { %>
          <button type="button" class="btn btn-outline-danger btn-sm delete-btn" data-id="<%= item.id %>"><i class="bi bi-trash me-2"></i><%= item.label || 'Delete' %></button>
        <% } else if (item && item.href) { %>
          <a href="<%= item.href %>" class="btn btn-outline-secondary btn-sm<%= item.className ? ' ' + item.className : '' %>"><i class="bi <%= item.icon || 'bi-pencil-square' %> me-2"></i><%= item.label %></a>
        <% } %>
      <% }) %>
    </div>
  </div>
<% } %>