<% const isEdit = mode === 'edit' && entry;
const wodFormAccess = typeof wordOfDayAccess !== 'undefined' ? wordOfDayAccess : {};
const editCaps = typeof entryCapabilities !== 'undefined' ? entryCapabilities : {};
const canEdit = isEdit ? Boolean(editCaps.canEdit) : Boolean(wodFormAccess.canCreateWords);
const canSubmit = isEdit ? Boolean(editCaps.canSubmit) : Boolean(wodFormAccess.canCreateWords);
const examples = isEdit && Array.isArray(entry.examples) ? entry.examples : [];
const selectedTypes = isEdit
  ? (Array.isArray(entry.wordTypes) && entry.wordTypes.length ? entry.wordTypes : (entry.wordType ? [entry.wordType] : ['noun']))
  : ['noun'];
const selectedDifficulty = isEdit ? (entry.difficulty || 'medium') : 'medium';
const years = authorStats && authorStats.byYear ? Object.keys(authorStats.byYear).sort().reverse() : [];
const wodContributionLimit = typeof wordOfDayContributionLimit !== 'undefined' ? Number(wordOfDayContributionLimit) : 0;
const wodContributionYear = typeof wordOfDayContributionYear !== 'undefined' ? String(wordOfDayContributionYear) : '';
const wodCurrentYearCount = typeof wordOfDayCurrentYearContributionCount !== 'undefined' ? Number(wordOfDayCurrentYearContributionCount) : 0;
const wodQuotaExempt = typeof wordOfDayContributionQuotaExempt !== 'undefined' && wordOfDayContributionQuotaExempt;
const wodQuotaBlocked = !isEdit && wodContributionLimit > 0 && !wodQuotaExempt && wodCurrentYearCount >= wodContributionLimit;
const wodStatsYearSet = new Set(years);
if (wodContributionYear) wodStatsYearSet.add(wodContributionYear);
const wodStatsTableYears = Array.from(wodStatsYearSet).sort().reverse();
const canPickAuthor = (!isEdit && wodFormAccess.canCreateAsOtherUser) || (isEdit && wodFormAccess.canChangeAuthorOnEdit);
const authorUserIdValue = isEdit ? (entry.authorUserId || entry.audit?.createdBy || '') : '';
const authorNameValue = isEdit ? (entry.authorName || '') : '';
const activeUserId = String(user?.id || user?.userId || '').trim();
const activeUserLabel = String(user?.name || user?.username || user?.email || activeUserId).trim();
const wodReviewerNote = isEdit ? String(entry?.workflow?.reviewerNote || '').trim() : '';
const wodEntryStatusLabel = isEdit ? String(entry?.status || '').replace(/_/g, ' ') : '';
const canClearWodWorkflowNote = Boolean(isEdit && wodFormAccess.canClearWorkflowNote);
%>

<style>
  .word-of-day-form-page .wod-type-toggle .btn { min-width: 5.5rem; }
  .word-of-day-form-page .wod-difficulty .btn-check:checked + .btn-outline-success { background-color: var(--bs-success); color: #fff; border-color: var(--bs-success); }
  .word-of-day-form-page .wod-difficulty .btn-check:checked + .btn-outline-warning { background-color: var(--bs-warning); color: #000; border-color: var(--bs-warning); }
  .word-of-day-form-page .wod-difficulty .btn-check:checked + .btn-outline-danger { background-color: var(--bs-danger); color: #fff; border-color: var(--bs-danger); }
  .word-of-day-form-page #wodExamplesList .list-group-item { align-items: center; }
  .word-of-day-form-page #wodExamplesList .wod-example-text { flex: 1 1 auto; }
  .word-of-day-form-page .wod-year-stats-toggle {
    cursor: pointer;
    user-select: none;
  }
  .word-of-day-form-page .wod-year-stats-toggle .wod-year-stats-chevron {
    transition: transform 0.2s ease;
  }
  .word-of-day-form-page .wod-year-stats-toggle[aria-expanded="false"] .wod-year-stats-chevron {
    transform: rotate(-90deg);
  }
  .word-of-day-form-page #wodAuthorStatsTable th,
  .word-of-day-form-page #wodAuthorStatsTable td {
    font-size: 0.85rem;
    vertical-align: middle;
  }
  .word-of-day-form-page #wodAuthorStatsTable .wod-year-col {
    font-weight: 700;
    white-space: nowrap;
  }
</style>

<span id="actionStateIdRef" data-id="<%= actionStateId || '' %>" hidden></span>
<div class="sections-page word-of-day-form-page">
  <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div class="d-flex align-items-center gap-2 flex-wrap">
      <h1 class="page-heading size-md m-0">
        <i class="bi bi-journal-richtext me-2"></i><%= title %>
      </h1>
      <% if (isEdit && entry?.id) { %>
        <span class="badge bg-primary border font-monospace">ID: <%= entry.id %></span>
      <% } %>
    </div>
    <a href="/school/word-of-day" class="btn btn-outline-secondary btn-sm">
      <i class="bi bi-arrow-left me-1"></i> Back to List
    </a>
  </div>

  <div class="form-container wide" style="max-width: 1400px;">
    <div class="card border-0 shadow-sm mb-4">
      <button class="card-header bg-white border-bottom w-100 text-start d-flex align-items-center justify-content-between gap-2 py-3 px-4 wod-year-stats-toggle"
        type="button"
        id="wodAuthorStatsToggle"
        data-bs-toggle="collapse"
        data-bs-target="#wodAuthorStatsCollapse"
        aria-expanded="true"
        aria-controls="wodAuthorStatsCollapse">
        <span class="fw-bold m-0 text-primary"><i class="bi bi-bar-chart me-2"></i>Your words by year</span>
        <i class="bi bi-chevron-down wod-year-stats-chevron text-muted" aria-hidden="true"></i>
      </button>
      <div id="wodAuthorStatsCollapse" class="collapse show">
        <div class="card-body p-4">
          <% if (!isEdit && wodQuotaBlocked) { %>
            <div class="alert alert-warning small mb-3">You cannot create another word until the next calendar year or an administrator raises the limit.</div>
          <% } %>
          <% if (!wodStatsTableYears.length) { %>
            <p class="text-muted mb-0 small">No entries yet.</p>
          <% } else { %>
            <div class="table-responsive border rounded">
              <table class="table table-sm table-hover align-middle mb-0" id="wodAuthorStatsTable">
                <thead class="table-light">
                  <tr>
                    <th class="ps-3 wod-year-col">Year</th>
                    <th class="text-center">Saved</th>
                    <th class="text-center">Submitted</th>
                    <th class="text-center">Approved</th>
                    <th class="text-center">Rejected</th>
                    <th class="text-center">Reopened</th>
                    <th class="text-center">On hold</th>
                    <th class="text-center">Archived</th>
                    <th class="text-center">Total</th>
                    <th class="text-end pe-3">Contributions</th>
                  </tr>
                </thead>
                <tbody>
                  <% wodStatsTableYears.forEach((year) => {
                    const bucket = (authorStats && authorStats.byYear && authorStats.byYear[year]) ? authorStats.byYear[year] : {};
                    const total = Number(bucket.total) || 0;
                    const isCurrentYear = wodContributionYear && String(year) === String(wodContributionYear);
                    const rowClass = isCurrentYear ? 'table-primary' : '';
                  %>
                    <tr class="<%= rowClass %>">
                      <td class="ps-3 wod-year-col">
                        <%= year %>
                        <% if (isCurrentYear) { %><span class="badge bg-primary ms-1">Current</span><% } %>
                      </td>
                      <td class="text-center"><%= bucket.saved || 0 %></td>
                      <td class="text-center"><%= bucket.submitted || 0 %></td>
                      <td class="text-center"><%= bucket.approved || 0 %></td>
                      <td class="text-center"><%= bucket.rejected || 0 %></td>
                      <td class="text-center"><%= bucket.reopened || 0 %></td>
                      <td class="text-center"><%= bucket.on_hold || 0 %></td>
                      <td class="text-center"><%= bucket.archived || 0 %></td>
                      <td class="text-center fw-semibold"><%= total %></td>
                      <td class="text-end pe-3">
                        <% if (wodQuotaExempt) { %>
                          <span class="text-muted">Exempt</span>
                        <% } else if (wodContributionLimit > 0) { %>
                          <span class="<%= (isCurrentYear && wodQuotaBlocked) ? 'text-danger fw-semibold' : '' %>">
                            <strong><%= isCurrentYear ? wodCurrentYearCount : total %></strong>
                            <span class="text-muted">/</span>
                            <%= wodContributionLimit %>
                          </span>
                        <% } else { %>
                          <span class="text-muted">Unlimited</span>
                          <span class="d-block small text-muted">(<%= total %> used)</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <p class="small text-muted mb-0 mt-2">
              Contributions count every entry you created that calendar year (all statuses). The limit is the organization setting in School settings → Word of Day.
            </p>
          <% } %>
        </div>
      </div>
    </div>

    <form id="wordOfDayForm" method="post" action="<%= formAction %>" data-entry-id="<%= typeof entryId !== 'undefined' ? entryId : '' %>">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <input type="hidden" name="actionStateId" value="<%= actionStateId || '' %>">
      <input type="hidden" name="wordTypes" id="wodWordTypesInput" value='<%- JSON.stringify(selectedTypes) %>'>
      <input type="hidden" name="photo" id="wodPhotoInput" value='<%- JSON.stringify(isEdit ? (entry.photo || {}) : {}) %>'>
      <input type="hidden" name="audio" id="wodAudioInput" value='<%- JSON.stringify(isEdit ? (entry.audio || {}) : {}) %>'>
      <input type="hidden" name="examples" id="wodExamplesInput" value='<%- JSON.stringify(examples) %>'>
      <input type="hidden" name="saveAction" id="wodSaveAction" value="saved">

      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom">
          <h6 class="fw-bold m-0 text-primary"><i class="bi bi-pencil-square me-2"></i>Word details</h6>
        </div>
        <div class="card-body p-4">
        <% if (canPickAuthor) { %>
          <input type="hidden" id="wodAuthorUserId" name="authorUserId" value="<%= authorUserIdValue %>">
          <input type="hidden" id="wodAuthorName" name="authorName" value="<%= authorNameValue %>">
          <input type="hidden" id="wodActiveAuthorMeta" value='<%- JSON.stringify({ userId: activeUserId, displayName: activeUserLabel }) %>'>
          <div class="mb-3">
            <span class="form-label fw-bold d-block">Author</span>
            <div class="d-flex flex-wrap align-items-center gap-2">
              <button type="button" class="btn btn-outline-primary btn-sm" id="wodPickAuthorBtn" <%= canEdit ? '' : 'disabled' %>>
                <i class="bi bi-person-check me-1"></i>Pick user
              </button>
              <button type="button" class="btn btn-outline-secondary btn-sm" id="wodAssignSelfAuthorBtn" <%= (canEdit && activeUserId) ? '' : 'disabled' %>>
                <i class="bi bi-person-badge me-1"></i>Use me as author
              </button>
              <button type="button" class="btn btn-outline-secondary btn-sm<%= authorUserIdValue ? '' : ' d-none' %>" id="wodClearAuthorBtn" <%= canEdit ? '' : 'disabled' %>>Clear</button>
              <span class="small">
                <span id="wodAuthorChipLabel"><%= authorNameValue || authorUserIdValue || (isEdit ? (entry.authorName || entry.authorUserId || '—') : 'You (default)') %></span>
                <span id="wodAuthorChipId" class="text-muted font-monospace<%= authorUserIdValue ? '' : ' d-none' %>"><%= authorUserIdValue ? '(' + authorUserIdValue + ')' : '' %></span>
              </span>
            </div>
          </div>
        <% } else if (isEdit) { %>
          <div class="mb-3">
            <label class="form-label fw-bold">Author</label>
            <div class="text-muted"><%= entry.authorName || entry.authorUserId || '—' %></div>
          </div>
        <% } %>
        <div class="mb-3">
          <label class="form-label fw-bold" for="wodWord">Word <span class="text-danger">*</span></label>
          <input type="text" class="form-control size-md" id="wodWord" name="word" required maxlength="200" value="<%= isEdit ? (entry.word || '') : '' %>" <%= canEdit ? '' : 'readonly' %>>
        </div>

        <div class="mb-3">
          <span class="form-label fw-bold d-block">Word type <span class="text-muted fw-normal">(select all that apply)</span></span>
          <div class="d-flex flex-wrap gap-2 wod-type-toggle">
            <% (wordTypes || []).forEach((key) => {
              const label = (wordTypeLabels || {})[key] || key;
              const checked = selectedTypes.includes(key);
            %>
              <input type="checkbox" class="btn-check" id="wodType_<%= key %>" value="<%= key %>" data-wod-word-type autocomplete="off" <%= checked ? 'checked' : '' %> <%= canEdit ? '' : 'disabled' %>>
              <label class="btn btn-sm btn-outline-primary" for="wodType_<%= key %>"><%= label %></label>
            <% }) %>
          </div>
        </div>

        <div class="mb-3">
          <span class="form-label fw-bold d-block">Difficulty</span>
            <div class="d-flex flex-wrap gap-2 wod-difficulty" role="radiogroup" aria-label="Difficulty">
              <% const diffStyles = { easy: 'btn-outline-success', medium: 'btn-outline-warning', hard: 'btn-outline-danger' };
              (difficultyLevels || []).forEach((key) => {
                const label = (difficultyLabels || {})[key] || key;
              %>
                <input type="radio" class="btn-check" name="difficulty" id="wodDiff_<%= key %>" value="<%= key %>" autocomplete="off" <%= selectedDifficulty === key ? 'checked' : '' %> <%= canEdit ? '' : 'disabled' %>>
                <label class="btn btn-sm <%= diffStyles[key] || 'btn-outline-secondary' %>" for="wodDiff_<%= key %>"><%= label %></label>
              <% }) %>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label fw-bold" for="wodPronunciation">Pronunciation</label>
            <input type="text" class="form-control size-md font-monospace" id="wodPronunciation" name="pronunciation" maxlength="500" value="<%= isEdit ? (entry.pronunciation || '') : '' %>" <%= canEdit ? '' : 'readonly' %>>
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold" for="wodMeaning">Meaning</label>
            <textarea class="form-control size-md" id="wodMeaning" name="meaning" rows="4" <%= canEdit ? '' : 'readonly' %>><%= isEdit ? (entry.meaning || '') : '' %></textarea>
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold" for="wodExampleDraft">Examples</label>
            <div class="form-text mb-2">Add one sentence per example. Anything left in the box below is included when you save.</div>
            <div class="input-group mb-2">
              <textarea class="form-control size-md" id="wodExampleDraft" rows="2" placeholder="Type an example sentence" <%= canEdit ? '' : 'readonly' %>></textarea>
              <% if (canEdit) { %>
                <button type="button" class="btn btn-outline-primary" id="btnAddWodExample">Add to list</button>
              <% } %>
            </div>
            <ol class="list-group list-group-numbered border rounded mb-0" id="wodExamplesList" aria-label="Example sentences"></ol>
          </div>
          <div class="mb-0">
            <label class="form-label fw-bold" for="wodVideoUrl">Video URL</label>
            <input type="url" class="form-control size-md" id="wodVideoUrl" name="videoUrl" placeholder="https://..." value="<%= isEdit ? (entry.videoUrl || '') : '' %>" <%= canEdit ? '' : 'readonly' %>>
          </div>
        </div>
      </div>

      <% if (isEdit && wodReviewerNote) { %>
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom d-flex flex-wrap align-items-center justify-content-between gap-2">
          <h6 class="fw-bold m-0 text-primary"><i class="bi bi-chat-left-text me-2"></i>Workflow note</h6>
          <% if (wodEntryStatusLabel) { %>
            <span class="badge bg-light text-dark border text-capitalize"><%= wodEntryStatusLabel %></span>
          <% } %>
        </div>
        <div class="card-body p-4">
          <p class="text-muted small mb-2">Note from the latest status change on this entry.</p>
          <div class="border rounded bg-light p-3 mb-0" style="white-space: pre-wrap;"><%= wodReviewerNote %></div>
          <% if (canClearWodWorkflowNote && canEdit) { %>
            <div class="form-check mt-3 mb-0">
              <input class="form-check-input" type="checkbox" value="1" id="wodClearWorkflowNote" name="clearWorkflowNote">
              <label class="form-check-label" for="wodClearWorkflowNote">Remove this note when you save</label>
            </div>
          <% } %>
        </div>
      </div>
      <% } %>

      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom">
          <h6 class="fw-bold m-0 text-primary"><i class="bi bi-images me-2"></i>Media</h6>
        </div>
        <div class="card-body p-4">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-bold" for="wodPhotoFile">Photo (max 2 MB)</label>
              <input type="file" class="form-control size-md" id="wodPhotoFile" accept="image/*" <%= canEdit ? '' : 'disabled' %>>
              <div id="wodPhotoPreview" class="small mt-2"></div>
              <% if (canEdit) { %>
                <button type="button" class="btn btn-sm btn-outline-secondary mt-2" id="wodClearPhotoBtn">Remove photo</button>
              <% } %>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-bold" for="wodAudioFile">Audio (max 3 MB)</label>
              <input type="file" class="form-control size-md" id="wodAudioFile" accept="audio/*" <%= canEdit ? '' : 'disabled' %>>
              <div id="wodAudioPreview" class="small mt-2"></div>
              <% if (canEdit) { %>
                <button type="button" class="btn btn-sm btn-outline-secondary mt-2" id="wodClearAudioBtn">Remove audio</button>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <% if (canEdit || canSubmit) { %>
        <div class="d-flex flex-wrap gap-2">
          <% if (canEdit) { %>
            <button type="button" class="btn btn-outline-secondary" data-wod-save="saved"<%= (!isEdit && wodQuotaBlocked) ? ' disabled' : '' %>>Save draft</button>
          <% } %>
          <% if (canSubmit) { %>
            <button type="button" class="btn btn-filled btn-primary" data-wod-save="submit"<%= (!isEdit && wodQuotaBlocked) ? ' disabled' : '' %>>Save &amp; submit</button>
          <% } %>
        </div>
      <% } %>
    </form>
  </div>

  <div class="modal fade" id="wodDuplicateModal" tabindex="-1" aria-labelledby="wodDuplicateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content">
        <div class="modal-header border-0 pb-0">
          <h2 class="modal-title h5" id="wodDuplicateModalLabel">Word already saved</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p class="text-muted small mb-3">This word is already in your organization. The entry below was not changed.</p>
          <dl class="row small mb-0" id="wodDuplicateDetails"></dl>
          <ul class="small mb-0 ps-3 d-none" id="wodDuplicateExamples"></ul>
        </div>
        <div class="modal-footer border-0 pt-0">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
          <a href="#" class="btn btn-primary" id="wodDuplicateOpenLink" target="_self">Open saved entry</a>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/modal_GenericPicker') %>
<script src="/scripts/schoolMessageUi.js"></script>
<script src="/scripts/wordOfDayForm.js"></script>
<script>
  if (window.WordOfDayForm) {
    window.WordOfDayForm.init({
      csrfToken: document.querySelector('#wordOfDayForm input[name="_csrf"]')?.value || ''
    });
  }
</script>