  <a href="<%= detailHref %>" class="word-of-day-widget <%= isBanner ? 'word-of-day-widget--banner wod-home-pte-banner reveal' : 'word-of-day-widget--dashboard wod-school-dash-card' %> wod-widget-card-link" aria-label="Word of the day: <%= entry.word %>. Open full details."<% if (openInNewTab) { %> target="_blank" rel="noopener noreferrer"<% } %>>
    <div class="wod-widget-inner">
      <% if (!isBanner) { %><span class="wod-dash-watermark" aria-hidden="true"><i class="bi bi-book-half"></i></span><% } %>
      <div class="wod-widget-row-top">
        <div class="wod-widget-meta-left">
          <span class="wod-widget-icon" aria-hidden="true"><i class="bi bi-book-half"></i></span>
          <p class="wod-widget-kicker mb-0">Word of the Day</p>
          <% if (wordTypeKeys.length || entry.difficulty) { %>
            <div class="wod-widget-chips" aria-hidden="true">
              <% wordTypeKeys.forEach((key, idx) => { %>
                <span class="wod-widget-chip"><i class="bi <%= wodIconClass('wordTypeIcon', key) %>" aria-hidden="true"></i><%= typeLabels[idx] || key %></span>
              <% }) %>
              <% if (entry.difficulty) { %>
                <span class="wod-widget-chip"><i class="bi <%= wodIconClass('difficultyIcon', entry.difficulty) %>" aria-hidden="true"></i><%= entry.difficultyLabel || entry.difficulty %></span>
              <% } %>
            </div>
          <% } %>
        </div>
      </div>
      <div class="wod-widget-row-word">
        <h2 class="wod-widget-word"><%= entry.word %></h2>
        <% if (entry.pronunciation) { %>
          <p class="wod-widget-phonetics" lang="en"><%= entry.pronunciation %></p>
        <% } %>
      </div>
    </div>
  </a>
