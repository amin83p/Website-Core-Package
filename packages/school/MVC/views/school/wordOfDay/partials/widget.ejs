<% const w = (typeof wordOfDayPayload !== 'undefined' && wordOfDayPayload) ? wordOfDayPayload : null;
const entry = w && w.entry ? w.entry : null;
const variant = String(typeof wordOfDayWidgetVariant !== 'undefined' ? wordOfDayWidgetVariant : 'dashboard').toLowerCase();
const isBanner = variant === 'banner' || variant === 'home';
const typeLabels = Array.isArray(entry?.wordTypeLabels) && entry.wordTypeLabels.length
  ? entry.wordTypeLabels
  : (entry?.wordTypeLabel ? String(entry.wordTypeLabel).split(',').map((s) => s.trim()).filter(Boolean) : []);
const wordTypeKeys = Array.isArray(entry?.wordTypes) && entry.wordTypes.length
  ? entry.wordTypes
  : (entry?.wordType ? [entry.wordType] : []);
const dateKey = w && w.dateKey ? String(w.dateKey) : '';
const orgId = w && w.orgId ? String(w.orgId) : '';
const publicSourceOrgId = typeof wordOfDayPublicSourceOrgId !== 'undefined' ? String(wordOfDayPublicSourceOrgId || '').trim() : '';
const uiConstants = (typeof wordOfDayUiConstants !== 'undefined' && wordOfDayUiConstants)
  ? wordOfDayUiConstants
  : null;
function wodIconClass(mapFn, key) {
  if (uiConstants && typeof uiConstants[mapFn] === 'function') return uiConstants[mapFn](key);
  return mapFn === 'wordTypeIcon' ? 'bi-tag' : 'bi-speedometer2';
}
let detailHref = '#';
if (entry && dateKey) {
  detailHref = `/word-of-the-day/${encodeURIComponent(dateKey)}`;
  if (orgId && (!publicSourceOrgId || orgId !== publicSourceOrgId)) {
    detailHref += `?org=${encodeURIComponent(orgId)}`;
  }
}
const openInNewTab = !isBanner || Boolean(typeof wordOfDayOpenInNewTab !== 'undefined' && wordOfDayOpenInNewTab);
