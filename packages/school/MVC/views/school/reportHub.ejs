    const activeIndex = getWeeklyReportsTeacherDeckIndex(groupKey, classCount);
    const activeRow = classes[activeIndex] || classes[0];
    const flipClass = weeklyReportsTeacherDeckFlipClassForGroup(groupKey);
    const peekIndices = weeklyReportsStackPeekIndices(activeIndex, classCount);
    const peekLayers = peekIndices.map(function (peekIndex, i) {
      const layerClass = i === 0 ? 'hub-wr-class-stack-peek--1' : 'hub-wr-class-stack-peek--2';
      return renderWeeklyReportsClassStackPeek(classes[peekIndex], layerClass, peekIndex);
    }).join('');
    const stackMultiClass = classCount > 1
      ? ' hub-wr-class-stack--multi' + (classCount > 2 ? ' hub-wr-class-stack--deep' : '')
      : '';
    const stackHint = classCount > 1 ? ' title="Scroll to browse classes"' : '';
    const peekWrap = peekLayers
      ? '<div class="hub-wr-class-stack-peeks" aria-hidden="true">' + peekLayers + '</div>'
      : '';
    return [
      '<div class="hub-wr-class-stack', stackMultiClass, '" data-hub-wr-deck-stack="1" tabindex="0"', stackHint, '>',
      peekWrap,
      '<div class="hub-wr-class-stack-front">',
      renderWeeklyReportsTeacherClassDetailCard(activeRow, { isFront: true, flipClass: flipClass, classIndex: activeIndex }),
      '</div>',
      '</div>'
    ].join('');
  }

  function findWeeklyReportsTeacherDeckElement(panel, groupKey) {
    if (!panel) return null;
    const key = String(groupKey || '');
    const decks = panel.querySelectorAll('.hub-wr-teacher-deck');
    for (let i = 0; i < decks.length; i++) {
      if (decks[i].getAttribute('data-hub-wr-deck-key') === key) return decks[i];
    }
    return null;
  }

  function bindWeeklyReportsTeacherDeckContent(deckEl, panel) {
    if (!deckEl || !panel) return;
    const openWeeklyReportsClassFromTarget = function (target) {
      const classId = target.getAttribute('data-hub-weekly-reports-class-id') || '';
      const className = target.getAttribute('data-hub-weekly-reports-class-name') || classId;
      if (!classId) return;
      drillIntoWeeklyReportsClass(classId, className);
    };
    deckEl.querySelectorAll('[data-hub-wr-deck-prev]').forEach(function (button) {
      button.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();
        const groupKey = button.getAttribute('data-hub-wr-deck-key') || '';
        const classCount = Number(deckEl.getAttribute('data-hub-wr-deck-count') || 0);
        if (!groupKey || classCount <= 1) return;
        cycleWeeklyReportsTeacherDeckIndex(groupKey, classCount, -1);
      });
    });
    deckEl.querySelectorAll('[data-hub-wr-deck-next]').forEach(function (button) {
      button.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();
        const groupKey = button.getAttribute('data-hub-wr-deck-key') || '';
        const classCount = Number(deckEl.getAttribute('data-hub-wr-deck-count') || 0);
        if (!groupKey || classCount <= 1) return;
        cycleWeeklyReportsTeacherDeckIndex(groupKey, classCount, 1);
      });
    });
    deckEl.querySelectorAll('[data-hub-wr-deck-stack]').forEach(function (stack) {
      let lastWheelAt = 0;
      stack.addEventListener('wheel', function (event) {
        const groupKey = deckEl.getAttribute('data-hub-wr-deck-key') || '';
        const classCount = Number(deckEl.getAttribute('data-hub-wr-deck-count') || 0);
        if (!groupKey || classCount <= 1) return;
        if (Math.abs(event.deltaY) < 4) return;
        const now = Date.now();
        if (now - lastWheelAt < 280) {
          event.preventDefault();
          return;
        }
        lastWheelAt = now;
        event.preventDefault();
        event.stopPropagation();
        cycleWeeklyReportsTeacherDeckIndex(groupKey, classCount, event.deltaY > 0 ? 1 : -1);
      }, { passive: false });
    });
    deckEl.querySelectorAll('.hub-weekly-reports-class-open').forEach(function (target) {
      target.addEventListener('click', function (event) {
        event.stopPropagation();
        openWeeklyReportsClassFromTarget(target);
      });
      target.addEventListener('keydown', function (event) {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        openWeeklyReportsClassFromTarget(target);
      });
    });
    deckEl.querySelectorAll('[data-hub-wr-drill]').forEach(function (button) {
      button.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();
        openWeeklyReportsDrilldown(
          button.getAttribute('data-class-id') || '',
          button.getAttribute('data-metric-key') || ''
        );
      });
    });
    if (deckEl.getAttribute('data-hub-wr-deck-keybound') !== '1') {
      deckEl.setAttribute('data-hub-wr-deck-keybound', '1');
      deckEl.addEventListener('keydown', function (event) {
        const key = String(event.key || '');
        if (key !== 'ArrowLeft' && key !== 'ArrowRight') return;
        const groupKey = deckEl.getAttribute('data-hub-wr-deck-key') || '';
        const classCount = Number(deckEl.getAttribute('data-hub-wr-deck-count') || 0);
        if (!groupKey || classCount <= 1) return;
        event.preventDefault();
        cycleWeeklyReportsTeacherDeckIndex(groupKey, classCount, key === 'ArrowRight' ? 1 : -1);
      });
    }
  }

  function refreshWeeklyReportsTeacherDeckPanel(groupKey) {
    const panel = document.getElementById('hubWeeklyReportsResults');
    const group = findWeeklyReportsTeacherGroupByKey(groupKey);
    const deckEl = findWeeklyReportsTeacherDeckElement(panel, groupKey);
    if (!panel || !group || !deckEl) {
      renderWeeklyReportsResultsPanel();
      return;
    }
    const classes = Array.isArray(group.classes) ? group.classes : [];
    const classCount = classes.length;
    const activeIndex = getWeeklyReportsTeacherDeckIndex(groupKey, classCount);
    const activeRow = classes[activeIndex] || classes[0];
    const activeName = String(activeRow.className || activeRow.classId || 'Class').trim();
    const teacherName = String(group.teacherName || 'Unassigned').trim() || 'Unassigned';
    const ariaLabel = teacherName + ' classes, showing ' + String(activeIndex + 1) + ' of ' + String(classCount) + ': ' + activeName;
    deckEl.setAttribute('aria-label', ariaLabel);
    const header = deckEl.querySelector('.hub-wr-teacher-deck-header');
    while (deckEl.lastElementChild && deckEl.lastElementChild !== header) {
      deckEl.removeChild(deckEl.lastElementChild);
    }
    const navEl = deckEl.querySelector('[data-hub-wr-deck-nav]');
    if (navEl) {
      navEl.outerHTML = renderWeeklyReportsTeacherDeckNav(group);
    }
    const temp = document.createElement('div');
    temp.innerHTML = renderWeeklyReportsTeacherDeckStack(group);
    while (temp.firstChild) {
      deckEl.appendChild(temp.firstChild);
    }
    bindWeeklyReportsTeacherDeckContent(deckEl, panel);
    updateWeeklyReportsEngagementRings();
    scheduleFitWeeklyReportsDeckClassTitles(deckEl);
    hubWeeklyReportsTeacherDeckFlip = { groupKey: '', dir: '' };
    persistActiveWeeklyReportsTab();
  }

