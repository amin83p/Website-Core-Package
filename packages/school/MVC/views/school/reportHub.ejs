  function sumWeeklyReportsOperationalMetrics(rows) {
    const list = Array.isArray(rows) ? rows : [];
    const totals = readWeeklyReportsOperationalMetrics({});
    list.forEach(function (row) {
      const m = readWeeklyReportsOperationalMetrics(row);
      totals.sessions.total += m.sessions.total;
      totals.sessions.finalized += m.sessions.finalized;
      totals.sessions.uncompleted += m.sessions.uncompleted;
      totals.bookCoverage.with += m.bookCoverage.with;
      totals.bookCoverage.without += m.bookCoverage.without;
      totals.gradebooks.with += m.gradebooks.with;
      totals.gradebooks.without += m.gradebooks.without;
      totals.notes.with += m.notes.with;
      totals.notes.without += m.notes.without;
      totals.reports.assigned += m.reports.assigned;
      totals.reports.completed += m.reports.completed;
      totals.reports.incomplete += m.reports.incomplete;
      totals.studentCases.total += m.studentCases.total;
      totals.attendance.absence.count += m.attendance.absence.count;
      totals.attendance.absence.minutes += m.attendance.absence.minutes;
      totals.attendance.late.count += m.attendance.late.count;
      totals.attendance.late.minutes += m.attendance.late.minutes;
      totals.attendance.early.count += m.attendance.early.count;
      totals.attendance.early.minutes += m.attendance.early.minutes;
      totals.attendance.unmarked += m.attendance.unmarked;
    });
    return totals;
  }

