  function renderSessionIssueWorkspace(payload) {
    const section = payload && payload.section ? payload.section : { label: 'Session Issues', icon: 'bi bi-exclamation-triangle-fill', sourceUrl: '/school/sessions' };
    const rows = Array.isArray(payload && payload.rows) ? payload.rows : [];
    const notLoaded = payload && payload.notLoaded === true;
    const filters = payload && payload.filters ? payload.filters : {};
    const refreshed = payload && payload.refreshedAt ? formatHubInstant(payload.refreshedAt) : 'just now';
    const severityOptions = Array.isArray(payload && payload.severityOptions) ? payload.severityOptions : ['info', 'warning', 'urgent'];
    const categoryOptions = Array.isArray(payload && payload.categoryOptions) ? payload.categoryOptions : ['learning', 'technology', 'engagement', 'behavior', 'support', 'resources', 'lesson_delivery', 'other'];
    const statusGroupOptions = Array.isArray(payload && payload.statusGroupOptions) ? payload.statusGroupOptions : [
      { value: '', label: 'All Cases' },
      { value: 'open', label: 'Open / Active' },
      { value: 'resolved', label: 'Resolved / Cancelled' }
    ];

    const teacherIds = splitHubIdList(filters.teacherPersonId || '');
    const studentIds = splitHubIdList(filters.studentPersonId || '');
    const classIds = splitHubIdList(filters.classId || '');
    const existingTeachers = new Map(hubSessionIssueTeacherSelections.map(function (item) { return [String(item.id || '').trim(), item]; }));
    const existingStudents = new Map(hubSessionIssueStudentSelections.map(function (item) { return [String(item.id || '').trim(), item]; }));
    const existingClasses = new Map(hubSessionIssueClassSelections.map(function (item) { return [String(item.id || '').trim(), item]; }));
    hubSessionIssueTeacherSelections = teacherIds.map(function (id) { return existingTeachers.get(id) || { id: id, name: id }; });
    hubSessionIssueStudentSelections = studentIds.map(function (id) { return existingStudents.get(id) || { id: id, name: id }; });
    hubSessionIssueClassSelections = classIds.map(function (id) { return existingClasses.get(id) || { id: id, name: id }; });

    const severitySelect = ['<option value="">All Severities</option>'].concat(severityOptions.map(function (item) {
      const value = String(item || '').toLowerCase();
      return '<option value="' + escapeHtml(value) + '"' + (value === String(filters.severity || '').toLowerCase() ? ' selected' : '') + '>' + escapeHtml(toHubTitleCase(value)) + '</option>';
    })).join('');
    const categorySelect = ['<option value="">All Categories</option>'].concat(categoryOptions.map(function (item) {
      const value = String(item || '').toLowerCase();
