  function resolveWeeklyReportsAbsoluteUrl(href) {
    const path = String(href || '').trim();
    if (!path) return '';
    if (/^https?:\/\//i.test(path)) return path;
    const origin = (typeof window !== 'undefined' && window.location && window.location.origin)
      ? window.location.origin
      : '';
    return origin + (path.charAt(0) === '/' ? path : '/' + path);
  }

  function renderWeeklyReportsPrintTeacherCasesPage(group, classes) {
    const list = Array.isArray(classes) ? classes : [];
    const withCases = list.filter(function (row) {
      return Array.isArray(row.studentCaseItems) && row.studentCaseItems.length > 0;
    });
    if (!withCases.length) return '';
    const rangeLabel = hubWeeklyReportsState.lastRangeLabel || formatWeeklyReportsRangeLabel();
    const teacherName = String(group.teacherName || 'Unassigned').trim() || 'Unassigned';
    const sections = withCases.map(function (row) {
      const items = row.studentCaseItems;
      const body = items.map(function (item) {
        const timeLine = (item.startTime || '--:--') + ' – ' + (item.endTime || '--:--');
        const absUrl = resolveWeeklyReportsAbsoluteUrl(item.href);
        const urlCell = absUrl
          ? '<div class="hub-wr-print-case-link text-muted">' + escapeHtml(absUrl) + '</div>'
          : '';
        const categoryBit = item.category
          ? '<div class="small text-muted">' + escapeHtml(item.category) + '</div>'
          : '';
        const detailHref = item.href
          ? '<a href="' + escapeHtml(item.href) + '" class="text-decoration-none">' + escapeHtml(item.detail || 'View case') + '</a>'
          : escapeHtml(item.detail || '—');
        return [
          '<tr>',
          '<td class="ps-2 align-middle">', formatHubTableDateCellHtml(item.date, timeLine), '</td>',
          '<td class="align-middle">', escapeHtml(item.studentName || '—'), categoryBit, '</td>',
          '<td class="align-middle"><span class="hub-wr-print-case-status">', escapeHtml(item.statusLabel || '-'), '</span></td>',
          '<td class="align-middle pe-2">', detailHref, urlCell, '</td>',
          '</tr>'
        ].join('');
      }).join('');
      return [
        '<section class="hub-wr-print-cases-class-block">',
        '<h3 class="hub-wr-print-cases-class-title">', escapeHtml(row.className || row.classId || 'Class'), '</h3>',
        '<table class="table table-sm hub-wr-print-cases-table mb-0">',
        '<thead><tr><th class="ps-2">Session</th><th>Student</th><th>Status</th><th class="pe-2">Details</th></tr></thead>',
        '<tbody>', body, '</tbody></table>',
        '</section>'
      ].join('');
    }).join('');
    return [
      '<div class="hub-wr-print-teacher-cases-page">',
      '<header class="hub-wr-print-cases-header">',
      '<div class="hub-wr-print-cases-title">Student cases</div>',
      '<div class="hub-wr-print-cases-teacher">', escapeHtml(teacherName), '</div>',
      '<div class="text-muted small">', escapeHtml(rangeLabel), '</div>',
      '</header>',
      sections,
      '</div>'
    ].join('');
  }

  function renderWeeklyReportsPrintDocument() {
    const rows = Array.isArray(hubWeeklyReportsState.classRows) ? hubWeeklyReportsState.classRows : [];
    const groups = groupWeeklyReportsClassesByTeacher(rows);
    const teacherPages = groups.map(function (group) {
      const classes = Array.isArray(group.classes) ? group.classes : [];
      if (!classes.length) return '';
      const groupKey = weeklyReportsTeacherGroupKey(group);
      const classSections = classes.map(function (row) {
        return renderWeeklyReportsPrintClassSection(row);
      }).join('');
      const casesPage = renderWeeklyReportsPrintTeacherCasesPage(group, classes);
      return [
        '<div class="hub-wr-print-teacher-page">',
        renderWeeklyReportsTeacherPrintHeader(group, classes, groupKey),
        classSections,
        '</div>',
        casesPage
      ].join('');
    }).join('');
    return [
      '<div class="hub-wr-print-doc">',
      renderWeeklyReportsPrintDocumentMeta({ title: 'Weekly Reports — Classes' }),
      teacherPages,
      '</div>'
    ].join('');
  }

  async function runWeeklyReportsPrintJob(renderPrintHtml) {
    const root = ensureWeeklyReportsPrintRootElement();
    root.innerHTML = renderPrintHtml();
    root.setAttribute('aria-hidden', 'false');
    const cleanup = function () {
      document.body.classList.remove('hub-print-weekly-reports');
      root.innerHTML = '';
      root.setAttribute('aria-hidden', 'true');
    };
    if (typeof window.hideLoading === 'function') {
      window.hideLoading({ force: true });
    }
    document.body.classList.add('hub-print-weekly-reports');
    if (typeof window.scrollTo === 'function') {
      window.scrollTo(0, 0);
    }
    await new Promise(function (resolve) {
      if (typeof window.requestAnimationFrame === 'function') {
        window.requestAnimationFrame(function () {
          window.requestAnimationFrame(resolve);
        });
      } else {
        window.setTimeout(resolve, 0);
      }
    });
    window.addEventListener('afterprint', cleanup, { once: true });
    window.print();
    window.setTimeout(cleanup, 1500);
  }

  async function printWeeklyReportsHub() {
    if (hubWeeklyReportsPrintInProgress) {
      void showHubMessage({
        title: 'Print',
        icon: 'info',
        message: 'Print is already preparing. Please wait…'
      });
      return;
    }
    const level = hubWeeklyReportsState.level === 'students' ? 'students' : 'classes';
    if (level === 'students') {
      const printRows = resolveWeeklyReportsPrintStudentRows();
      if (!printRows.length) {
        void showHubMessage({
          title: 'Print',
          icon: 'info',
          message: 'Load the student report before printing.'
        });
        return;
      }
      hubWeeklyReportsPrintInProgress = true;
      setWeeklyReportsPrintButtonsBusy(true);
      try {
        await runWeeklyReportsPrintJob(function () {
          return renderWeeklyReportsPrintStudentDocument(printRows);
        });
      } finally {
        hubWeeklyReportsPrintInProgress = false;
        setWeeklyReportsPrintButtonsBusy(false);
        if (typeof window.hideLoading === 'function') {
          window.hideLoading({ force: true });
        }
      }
      return;
    }

    const rows = Array.isArray(hubWeeklyReportsState.classRows) ? hubWeeklyReportsState.classRows : [];
    if (!rows.length) {
      void showHubMessage({
        title: 'Print',
        icon: 'info',
        message: 'Load the class report before printing.'
      });
      return;
    }

    hubWeeklyReportsPrintInProgress = true;
    setWeeklyReportsPrintButtonsBusy(true);
    const engagementPending = weeklyReportsEngagementStillLoadingForPrint();
    if (engagementPending) {
      void showHubMessage({
        title: 'Print',
        icon: 'info',
        message: 'Please wait while class engagement finishes loading, then we will open the print dialog.'
      });
    }

    try {
      const engagementReady = await ensureWeeklyReportsEngagementForPrint(15000);
      if (!engagementReady && weeklyReportsEngagementStillLoadingForPrint()) {
        void showHubMessage({
          title: 'Print',
          icon: 'warning',
          message: 'Engagement is still loading. Try Print again in a moment.'
        });
        return;
      }
      await runWeeklyReportsPrintJob(function () {
        return renderWeeklyReportsPrintDocument();
      });
    } finally {
      hubWeeklyReportsPrintInProgress = false;
      setWeeklyReportsPrintButtonsBusy(false);
      if (typeof window.hideLoading === 'function') {
        window.hideLoading({ force: true });
      }
    }
  }

  function renderWeeklyReportsSharePrintButtons(options) {
    const opts = options || {};
    const requireLoaded = opts.requireLoaded === true;
    const shareDisabled = requireLoaded
      && !hubWeeklyReportsActiveTabId
