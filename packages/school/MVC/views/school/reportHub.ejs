      '<div class="col-md-2"><label class="form-label fw-bold small" for="hubTimesheetPeriodStartDate">Period From</label><input type="date" id="hubTimesheetPeriodStartDate" class="form-control form-control-sm" value="' + escapeHtml(filters.periodStartDate || '') + '"></div>',
