  function renderStudentProgressPrintDocument(payload) {
    const students = Array.isArray(payload && payload.students) ? payload.students : [];
    const range = payload && payload.range ? payload.range : {};
    const rangeLabel = formatStudentProgressWeekLabel(range.startDate, range.endDate);
    const prepared = formatHubInstant(new Date());
    const pages = students.map(function (student) {
      const classHtml = (Array.isArray(student.classes) ? student.classes : [])
        .map(function (classBlock) {
          return renderStudentProgressPrintClassTable(classBlock);
