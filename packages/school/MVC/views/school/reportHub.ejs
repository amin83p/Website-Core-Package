  function readWeeklyReportsStudentAttendance(row) {
    const att = row && row.attendance && typeof row.attendance === 'object' ? row.attendance : {};
    return {
      sessionCount: Number(att.sessionCount != null ? att.sessionCount : row.sessionCount || 0),
      presentCount: Number(att.presentCount != null ? att.presentCount : row.presentCount || 0),
      lateCount: Number(att.lateCount || 0),
      lateMinutes: Number(att.lateMinutes || 0),
      lateExcusedCount: Number(att.lateExcusedCount || 0),
      lateExcusedMinutes: Number(att.lateExcusedMinutes || 0),
      earlyCount: Number(att.earlyCount || 0),
      earlyMinutes: Number(att.earlyMinutes || 0),
      earlyExcusedCount: Number(att.earlyExcusedCount || 0),
      earlyExcusedMinutes: Number(att.earlyExcusedMinutes || 0),
      absenceCount: Number(att.absenceCount != null ? att.absenceCount : row.absenceCount || 0),
      absenceExcusedCount: Number(att.absenceExcusedCount || 0),
      acfCount: Number(att.acfCount || 0),
      acfExcusedCount: Number(att.acfExcusedCount || 0),
      naCount: Number(att.naCount || 0)
    };
