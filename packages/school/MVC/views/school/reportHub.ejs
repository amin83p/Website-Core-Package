  function buildWeeklyReportsClassColumnTooltip(row) {
    const parts = [];
    const addDetail = function (label, value) {
      const cleaned = String(value || '').trim();
      if (cleaned) parts.push(label + ': ' + cleaned);
    };
    addDetail('Class', row.className || row.classId);
    addDetail('Organization', row.orgName || row.orgId);
    addDetail('Class ID', row.classId);
    addDetail('Department', row.departmentName || row.departmentId);
    return parts.join('\n');
  }

  function renderWeeklyReportsClassColumnCell(row) {
    const classId = String(row.classId || '').trim();
    const className = String(row.className || row.classId || 'Class').trim();
    const tooltip = buildWeeklyReportsClassColumnTooltip(row);
    const tooltipAttrs = tooltip
      ? ' data-tip="' + escapeHtml(tooltip) + '" data-hub-schedule-tip="' + escapeHtml(tooltip) + '" aria-label="' + escapeHtml(tooltip.replace(/\n/g, ', ')) + '"'
      : '';
    return [
      '<td class="hub-weekly-reports-class-open hub-wr-col-class" role="button" tabindex="0" data-hub-wr-class-tip="1"',
      ' data-hub-weekly-reports-class-id="' + escapeHtml(classId) + '"',
      ' data-hub-weekly-reports-class-name="' + escapeHtml(className) + '"',
      tooltipAttrs,
      '>',
      '<div class="hub-weekly-reports-class-name">' + escapeHtml(className) + '</div>',
      '</td>'
