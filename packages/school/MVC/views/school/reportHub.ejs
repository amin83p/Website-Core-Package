<%
  const canManageAllTasksFlag = canManageAllTasks === true;
%>

<style>
  body.school-report-hub-page main.school-report-hub-main {
    width: 80vw;
    max-width: 80vw;
    margin-left: auto;
    margin-right: auto;
    padding-left: 0;
    padding-right: 0;
    box-sizing: border-box;
  }

  html.app-page-width-wide body.school-report-hub-page main.school-report-hub-main,
  html.app-page-width-full body.school-report-hub-page main.school-report-hub-main {
    width: min(80vw, calc(100vw - 32px - var(--app-side-controls-gutter, 64px)));
    max-width: min(80vw, calc(100vw - 32px - var(--app-side-controls-gutter, 64px)));
  }

  .school-master-hub {
    --hub-page-gutter: clamp(0.35rem, 0.5vw, 0.5rem);
    width: 100%;
    max-width: 100%;
    margin-left: 0;
    margin-right: 0;
    padding-left: var(--hub-page-gutter) !important;
    padding-right: var(--hub-page-gutter) !important;
    box-sizing: border-box;
    overflow-x: clip;
  }

  .school-master-hub .hub-shell {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    min-width: 0;
    padding-left: 0;
    padding-right: 0;
  }

  .school-master-hub .hub-page-header {
    padding-left: 0;
    padding-right: 0;
  }

  .school-master-hub .hub-section-panel {
    margin-left: 0;
    margin-right: 0;
    margin-bottom: 0.5rem;
    padding: 0;
    border: 1px solid rgba(15, 23, 42, 0.09);
    border-radius: 1rem;
    background:
      linear-gradient(135deg, rgba(2, 132, 199, 0.08), rgba(34, 197, 94, 0.06)),
      #ffffff;
    box-shadow: 0 14px 30px rgba(15, 23, 42, 0.06);
    overflow: hidden;
  }

  .school-master-hub .hub-section-panel-inner {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    direction: rtl;
  }

  .school-master-hub .hub-section-segment {
    appearance: none;
    position: relative;
    display: grid;
    place-items: center;
    border: 0;
    border-left: 1px solid rgba(15, 23, 42, 0.09);
    background: rgba(255, 255, 255, 0.68);
    color: #475569;
    padding: 1rem 0.85rem;
    min-height: 4.25rem;
    text-align: center;
    font-weight: 700;
    text-decoration: none;
    transition: background 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .school-master-hub .hub-section-segment:first-child {
    border-left: 0;
  }

  .school-master-hub .hub-section-segment:hover,
  .school-master-hub .hub-section-segment.is-active {
    background: #0284c7;
    color: #ffffff;
    transform: translateY(-1px);
  }

  .school-master-hub .hub-section-main-link {
    appearance: none;
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    border: 0;
    background: transparent;
    color: inherit;
    text-decoration: none;
    font: inherit;
  }

  .school-master-hub .hub-section-segment > span,
  .school-master-hub .hub-section-main-link > span {
    direction: ltr;
  }

  .school-master-hub .hub-task-count {
    position: absolute;
    top: 0.42rem;
    left: 0.42rem;
    z-index: 3;
    min-width: 1.65rem;
    height: 1.65rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #ef4444;
    color: #ffffff;
    font-size: 0.72rem;
    line-height: 1;
    box-shadow: 0 8px 18px rgba(239, 68, 68, 0.24);
  }

  .school-master-hub .hub-task-count.is-muted {
    background: #94a3b8;
    box-shadow: none;
  }

  .school-master-hub .hub-task-gear {
    position: absolute;
    top: 0.42rem;
    right: 0.42rem;
    z-index: 4;
    width: 1.8rem;
    height: 1.8rem;
    border: 1px solid rgba(15, 23, 42, 0.12);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    color: #0f172a;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 160ms ease, background 160ms ease;
  }

  .school-master-hub .hub-task-gear:hover {
    transform: rotate(32deg);
    background: #ffffff;
  }

  @keyframes reportPriorityBlink {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: .35; transform: scale(1.18); }
  }

  @media (prefers-reduced-motion: reduce) {
    .school-master-hub .report-priority-marker { animation: none; }
  }

  .school-master-hub .hub-main {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: #ffffff;
    box-shadow: none;
    overflow: hidden;
  }

  .school-master-hub [data-hub-workspace] {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    min-height: 0;
    margin: 0;
    padding: 0;
    background: #ffffff;
  }

  .school-master-hub [data-hub-workspace] > .hub-stage-empty {
    flex: 1 1 auto;
    min-height: 12rem;
    display: grid;
    place-items: center;
    color: #94a3b8;
    background:
      radial-gradient(circle at 20% 20%, rgba(14, 165, 233, 0.06), transparent 28%),
      radial-gradient(circle at 80% 30%, rgba(34, 197, 94, 0.06), transparent 30%),
      #ffffff;
  }

  .school-master-hub [data-hub-workspace] > .hub-workspace {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    min-height: 0;
    margin: 0;
    padding: 0;
    background: transparent;
  }

  .school-master-hub .hub-stage-empty {
    display: grid;
    place-items: center;
    color: #94a3b8;
  }

  .school-master-hub .hub-workspace-card {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    min-height: 0;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 0;
    border-left: 0;
    border-right: 0;
    background: #ffffff;
    box-shadow: none;
    overflow: hidden;
  }

  .school-master-hub .hub-workspace-header {
    padding: 1rem 1.15rem;
    border-bottom: 1px solid rgba(15, 23, 42, 0.08);
    background: linear-gradient(135deg, rgba(2, 132, 199, 0.08), rgba(34, 197, 94, 0.07));
  }

  .school-master-hub .hub-workspace-table {
    min-width: 860px;
    margin-bottom: 0;
  }

  .school-master-hub .hub-attendance-matrix-wrap {
    max-height: calc(100vh - 310px);
    overflow: auto;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 1rem;
    background: #ffffff;
  }

  .school-master-hub .hub-attendance-table {
    min-width: 920px;
    margin-bottom: 0;
  }

  .school-master-hub .hub-attendance-table th {
    position: sticky;
    top: 0;
    z-index: 2;
    background: #f8fafc;
    box-shadow: 0 1px 0 rgba(15, 23, 42, 0.08);
  }

  .school-master-hub .hub-weekly-reports-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .school-master-hub .hub-weekly-reports-filter-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.75rem;
    align-items: end;
  }

  @media (max-width: 1199.98px) {
    .school-master-hub .hub-weekly-reports-filter-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 767.98px) {
    .school-master-hub .hub-weekly-reports-filter-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .school-master-hub .hub-weekly-reports-filter-field .form-label {
    margin-bottom: 0.25rem;
  }

  .school-master-hub .hub-weekly-reports-filter-field .hub-weekly-reports-filter-chips {
    min-height: 0;
    margin-top: 0.35rem;
  }

  .school-master-hub .hub-student-progress-student {
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 0.75rem;
    margin-bottom: 1rem;
    overflow: hidden;
    background: #fff;
  }

  .school-master-hub .hub-student-progress-student-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    padding: 0.75rem 1rem;
    border: 0;
    background: rgba(2, 132, 199, 0.06);
    font-weight: 700;
    text-align: start;
    cursor: pointer;
  }

  .school-master-hub .hub-student-progress-class-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    margin: 0;
    padding: 0.55rem 0.15rem;
    border: 0;
    background: transparent;
    font-size: 1rem;
    font-weight: 600;
    text-align: start;
    cursor: pointer;
  }

  .school-master-hub .hub-student-progress-class {
    padding: 0.35rem 1rem 0.85rem;
  }

  .school-master-hub .hub-student-progress-chevron {
    flex: 0 0 auto;
    color: #64748b;
  }

  .school-master-hub .hub-student-progress-week-row {
    cursor: pointer;
  }

  .school-master-hub .hub-student-progress-chart-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem 1rem;
    align-items: start;
  }

  .school-master-hub .hub-student-progress-chart-card {
    min-width: 0;
    margin-bottom: 0;
  }

  .school-master-hub .hub-student-progress-chart-frame {
    position: relative;
    height: 150px;
  }

  .school-master-hub .hub-student-progress-week-legend {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.72rem;
    color: #64748b;
  }

  @media (max-width: 767.98px) {
    .school-master-hub .hub-student-progress-chart-grid {
      grid-template-columns: 1fr;
    }
  }

  .school-master-hub .hub-weekly-reports-board {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 1rem;
    padding: 0.25rem;
  }

  .school-master-hub .hub-weekly-reports-tile {
    position: relative;
    aspect-ratio: 1;
    border-radius: 1rem;
    border: 1px solid rgba(15, 23, 42, 0.1);
    background: linear-gradient(145deg, rgba(255, 251, 235, 0.95), rgba(254, 243, 199, 0.9));
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0.85rem;
    transition: transform 0.22s ease, box-shadow 0.22s ease;
    cursor: default;
    overflow: visible;
  }

  .school-master-hub .hub-weekly-reports-tile:hover {
    transform: scale(1.2);
    box-shadow: 0 20px 36px rgba(15, 23, 42, 0.2);
    z-index: 5;
  }

  .school-master-hub .hub-weekly-reports-tile-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    width: 100%;
  }

  .school-master-hub .hub-weekly-reports-tile-name {
    font-weight: 700;
    font-size: 0.92rem;
    line-height: 1.25;
    color: #1e293b;
    word-break: break-word;
  }

  .school-master-hub .hub-weekly-reports-tile-sessions {
    font-size: 0.78rem;
    font-weight: 600;
    font-style: italic;
    line-height: 1.2;
    color: #0284c7;
    transition: color 0.22s ease, font-size 0.22s ease;
  }

  .school-master-hub .hub-weekly-reports-tile:hover .hub-weekly-reports-tile-sessions {
    color: #dc2626;
    font-size: 0.86rem;
  }

  .school-master-hub .hub-weekly-reports-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid rgba(15, 23, 42, 0.08);
    background: rgba(248, 250, 252, 0.85);
  }

  .school-master-hub .hub-weekly-reports-tab {
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    max-width: 280px;
  }

  .school-master-hub .hub-weekly-reports-tab-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 220px;
  }

  .school-master-hub .hub-weekly-reports-tab-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 999px;
    font-size: 0.95rem;
    line-height: 1;
    opacity: 0.75;
  }

  .school-master-hub .hub-weekly-reports-tab-close:hover {
    opacity: 1;
    background: rgba(15, 23, 42, 0.08);
  }

  .school-master-hub .hub-weekly-reports-class-board {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
    gap: 1.5rem;
    padding: 0.25rem;
  }

  .school-master-hub .hub-weekly-reports-class-tile {
    position: relative;
    min-height: 220px;
    border-radius: 1rem;
    border: 1px solid rgba(15, 23, 42, 0.1);
    border-left-width: 6px;
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.08);
    display: flex;
    align-items: stretch;
    justify-content: flex-start;
    padding: 1.35rem 1.6rem;
    transition: transform 0.22s ease, box-shadow 0.22s ease;
    cursor: pointer;
    overflow: hidden;
  }

  .school-master-hub .hub-weekly-reports-class-tile:hover {
    transform: scale(1.04);
    box-shadow: 0 20px 36px rgba(15, 23, 42, 0.2);
    z-index: 5;
  }

  .school-master-hub .hub-weekly-reports-class-tile-body {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    gap: 0.85rem;
    width: 100%;
    min-height: 100%;
  }

  .school-master-hub .hub-weekly-reports-class-tile-name {
    font-weight: 700;
    font-size: 1.2rem;
    line-height: 1.3;
    color: #1e293b;
    word-break: break-word;
    text-align: center;
    width: 100%;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid rgba(15, 23, 42, 0.08);
  }

  .school-master-hub .hub-weekly-reports-class-tile-department {
    font-size: 0.78rem;
    font-weight: 600;
    color: #64748b;
    text-align: center;
    margin-top: -0.35rem;
  }

  .school-master-hub .hub-weekly-reports-class-tile-metrics {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.55rem;
    width: 100%;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.35;
    color: #0f172a;
    text-align: left;
  }

  .school-master-hub .hub-weekly-reports-class-tile-metric-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .school-master-hub .hub-weekly-reports-class-tile-metric-line .label {
    color: #475569;
    font-weight: 600;
    flex: 0 0 auto;
  }

  .school-master-hub .hub-weekly-reports-class-tile-metric-line .value {
    color: #0284c7;
    font-weight: 700;
    flex: 1 1 auto;
    text-align: right;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .school-master-hub .hub-weekly-reports-class-tile:hover .hub-weekly-reports-class-tile-metric-line .value {
    color: #dc2626;
  }

  .school-master-hub .hub-weekly-reports-class-board--decks {
    grid-template-columns: repeat(auto-fill, minmax(440px, 1fr));
    grid-auto-rows: 1fr;
    align-items: stretch;
  }

  .school-master-hub .hub-wr-teacher-deck {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
    height: 100%;
    min-height: 100%;
    outline: none;
    border-radius: 1rem;
    border: 1px solid rgba(15, 23, 42, 0.12);
    background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
    padding: 1rem 1.1rem 1.15rem;
    box-sizing: border-box;
  }

  .school-master-hub .hub-wr-teacher-deck:focus-visible {
    box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.35), 0 10px 24px rgba(15, 23, 42, 0.08);
  }

  .school-master-hub .hub-wr-teacher-deck-header {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.35rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid rgba(15, 23, 42, 0.08);
  }

  .school-master-hub .hub-wr-teacher-deck-header-main {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .school-master-hub .hub-wr-teacher-deck-nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.3rem;
    min-height: 1.35rem;
  }

  .school-master-hub .hub-wr-teacher-deck-nav--placeholder {
    visibility: hidden;
    pointer-events: none;
  }

  .school-master-hub .hub-wr-teacher-deck-nav .btn.hub-wr-deck-nav-btn {
    padding: 0.05rem 0.3rem;
    font-size: 0.65rem;
    line-height: 1;
    border-radius: 0.35rem;
    min-width: 1.35rem;
  }

  .school-master-hub .hub-wr-teacher-deck-nav .btn.hub-wr-deck-nav-btn .bi {
    font-size: 0.72rem;
  }

  .school-master-hub .hub-wr-teacher-deck-nav .hub-wr-teacher-deck-index {
    font-size: 0.68rem;
    min-width: 2.75rem;
    padding: 0 0.15rem;
  }

  .school-master-hub .hub-wr-teacher-deck-header .hub-weekly-reports-teacher-name {
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.3;
    color: #0f172a;
    flex: 1 1 auto;
    min-width: 0;
    word-break: break-word;
  }

  .school-master-hub .hub-wr-teacher-deck-count {
    font-size: 0.72rem;
    font-weight: 600;
    color: #64748b;
    white-space: nowrap;
    background: #fff;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 999px;
    padding: 0.15rem 0.55rem;
  }

  .school-master-hub .hub-wr-class-stack {
    position: relative;
    flex: 1 1 auto;
    width: 100%;
    min-height: 0;
    box-sizing: border-box;
    isolation: isolate;
  }

  .school-master-hub .hub-wr-class-stack--multi {
    cursor: default;
    padding-bottom: 1.05rem;
  }

  .school-master-hub .hub-wr-class-stack-peeks {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: calc(100% - 1.05rem);
    z-index: 1;
    pointer-events: none;
  }

  .school-master-hub .hub-wr-class-stack-peek {
    position: absolute;
    top: 0;
    left: 0;
    width: calc(100% - 1.15rem);
    height: 100%;
    border-radius: 0.85rem;
    border: 1px solid rgba(15, 23, 42, 0.12);
    border-left-width: 6px;
    box-shadow: 0 6px 16px rgba(15, 23, 42, 0.1);
    box-sizing: border-box;
    pointer-events: none;
    overflow: hidden;
  }

  .school-master-hub .hub-wr-class-stack-peek--1 {
    transform: translate(0.5rem, 0.6rem);
    z-index: 2;
    opacity: 0.94;
  }

  .school-master-hub .hub-wr-class-stack-peek--2 {
    transform: translate(0.25rem, 1.05rem);
    z-index: 1;
    opacity: 0.8;
  }

  .school-master-hub .hub-wr-class-stack--multi.hub-wr-class-stack--deep .hub-wr-class-stack-peek {
    width: calc(100% - 1.45rem);
  }

  .school-master-hub .hub-wr-class-stack--multi.hub-wr-class-stack--deep .hub-wr-class-stack-peek--1 {
    transform: translate(0.55rem, 0.65rem);
  }

  .school-master-hub .hub-wr-class-stack--multi.hub-wr-class-stack--deep .hub-wr-class-stack-peek--2 {
    transform: translate(0.3rem, 1.15rem);
  }

  .school-master-hub .hub-wr-class-stack-peek-name {
    display: none;
  }

  .school-master-hub .hub-wr-class-stack--multi .hub-wr-class-stack-front {
    margin-left: 1.15rem;
    width: calc(100% - 1.15rem);
  }

  .school-master-hub .hub-wr-class-stack--multi.hub-wr-class-stack--deep .hub-wr-class-stack-front {
    margin-left: 1.45rem;
    width: calc(100% - 1.45rem);
  }

  .school-master-hub .hub-wr-class-stack-front {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    width: 100%;
    min-width: 0;
  }

  .school-master-hub .hub-wr-class-stack--multi .hub-wr-teacher-deck-card.is-front {
    box-shadow: -5px 0 0 0 #fff, 0 10px 22px rgba(15, 23, 42, 0.12);
  }

  .school-master-hub .hub-wr-teacher-deck-card {
    position: relative;
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    border-radius: 0.85rem;
    border: 1px solid rgba(15, 23, 42, 0.1);
    border-left-width: 6px;
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.1);
    background: #fff;
    padding: 1rem 1.1rem 1.15rem;
    box-sizing: border-box;
    overflow: visible;
  }

  .school-master-hub .hub-wr-teacher-deck-card.is-front.hub-wr-stack-flip-next {
