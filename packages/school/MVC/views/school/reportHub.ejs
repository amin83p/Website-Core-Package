  function bindSessionIssueWorkspaceControls() {
    const loadBtn = document.getElementById('hubSessionIssueFilterLoad');
    if (loadBtn) loadBtn.addEventListener('click', function () { loadWorkspaceSection('session-issues'); });
    const resetBtn = document.getElementById('hubSessionIssueReset');
    if (resetBtn) resetBtn.addEventListener('click', function () {
      ['hubSessionIssueStartDate', 'hubSessionIssueEndDate', 'hubSessionIssueSeverity', 'hubSessionIssueCategory', 'hubSessionIssueStatusGroup'].forEach(function (id) {
        const el = document.getElementById(id);
        if (el) el.value = '';
      });
      hubSessionIssueTeacherSelections = [];
      hubSessionIssueClassSelections = [];
      syncSessionIssueInputs();
      workspaceState.serverSearch['session-issues'] = '';
