  function openWeeklyReportsStudentCasesDrilldown(studentId) {
    const normalizedId = String(studentId || '').trim();
    const rows = Array.isArray(hubWeeklyReportsState.rows) ? hubWeeklyReportsState.rows : [];
    const row = rows.find(function (item) { return String(item.studentId || '') === normalizedId; }) || null;
    const caseItems = row && Array.isArray(row.studentCaseItems) ? row.studentCaseItems : [];
    const modalEl = ensureWeeklyReportsDrilldownModal();
