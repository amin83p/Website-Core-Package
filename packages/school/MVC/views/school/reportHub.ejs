  function renderWeeklyReportsPrintStudentSessionsHorizontal(row, options) {
    const opts = options || {};
    const sessions = Array.isArray(row && row.sessions) ? row.sessions : [];
    if (!sessions.length) {
      return '<div class="text-muted">No scheduled sessions in this range for this student.</div>';
    }
    const colsPerRow = opts.detail ? 5 : 8;
    const gridClass = opts.detail
      ? 'hub-wr-print-student-sessions-grid hub-wr-print-student-sessions-grid--detail'
      : 'hub-wr-print-student-sessions-grid';
    const rowsHtml = [];
    for (let i = 0; i < sessions.length; i += colsPerRow) {
      let rowHtml = '<tr>';
      for (let j = 0; j < colsPerRow; j += 1) {
        const session = sessions[i + j];
        if (!session) {
          rowHtml += '<td class="hub-wr-print-session-cell hub-wr-print-session-cell--empty"></td>';
          continue;
        }
        const statusLabel = String(session.label || session.status || 'Unmarked');
        const statusClass = weeklyReportsSessionStatusClass(statusLabel);
        rowHtml += [
          '<td class="hub-wr-print-session-cell">',
          '<div class="hub-wr-print-session-date">', formatHubDateKey(session.date, { month: 'short', day: 'numeric' }), '</div>',
          '<div class="hub-weekly-reports-session-status ', escapeHtml(statusClass), '">', escapeHtml(statusLabel), '</div>',
          '</td>'
        ].join('');
      }
      rowHtml += '</tr>';
      rowsHtml.push(rowHtml);
    }
    return [
      '<table class="', gridClass, ' mb-0">',
      '<tbody>', rowsHtml.join(''), '</tbody>',
      '</table>'
    ].join('');
  }

