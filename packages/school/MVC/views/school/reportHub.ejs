        '<td class="text-center">', renderWeeklyReportsAttendanceCountCell(att.lateCount, { tone: 'warning' }), '</td>',
        '<td class="text-center">', renderWeeklyReportsAttendanceCountCell(att.earlyCount, { tone: 'early' }), '</td>',
        '<td class="text-center">', renderWeeklyReportsAttendanceCountCell(att.absenceCount, { showMinutes: false, tone: 'danger' }), '</td>',
        acfCell,
        '<td class="text-center">', renderWeeklyReportsMetricStack(String(Number(week.caseCount || 0)), ''), '</td>',
