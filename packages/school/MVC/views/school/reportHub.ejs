  function fitWeeklyReportsDeckClassTitle(nameEl) {
    if (!nameEl) return;
    const slot = nameEl.closest('.hub-wr-deck-card-title-slot');
    if (!slot) return;
    const maxPx = 16.8;
    const minPx = 11.5;
    nameEl.style.fontSize = maxPx + 'px';
    const limit = slot.clientHeight;
    if (!limit) return;
    let sizePx = maxPx;
    let guard = 0;
    while (guard < 48 && nameEl.scrollHeight > limit + 1 && sizePx > minPx) {
      sizePx -= 0.5;
      nameEl.style.fontSize = sizePx + 'px';
      guard += 1;
    }
  }

