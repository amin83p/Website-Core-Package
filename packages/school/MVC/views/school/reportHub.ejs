  function bindWeeklyReportsDrilldownCaseRows(container) {
    if (!container) return;
    container.querySelectorAll('.hub-weekly-reports-drilldown-case-row[data-hub-wr-case-href]').forEach(function (rowEl) {
      const href = String(rowEl.getAttribute('data-hub-wr-case-href') || '').trim();
      if (!href) return;
      rowEl.addEventListener('click', function (event) {
        if (event.target.closest('a, button')) return;
        window.location.href = href;
      });
      rowEl.addEventListener('keydown', function (event) {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        if (event.target.closest('a, button')) return;
        event.preventDefault();
        window.location.href = href;
      });
    });
  }

  async function openWeeklyReportsDrilldown(classId, metricKey) {
    const modalEl = ensureWeeklyReportsDrilldownModal();
    const titleEl = document.getElementById('hubWeeklyReportsDrilldownTitle');
    const subtitleEl = document.getElementById('hubWeeklyReportsDrilldownSubtitle');
    const bodyEl = document.getElementById('hubWeeklyReportsDrilldownBody');
    if (titleEl) titleEl.textContent = 'Loading...';
    if (subtitleEl) subtitleEl.textContent = '';
    if (bodyEl) bodyEl.innerHTML = '<div class="text-center py-4 text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Loading details...</div>';
    const modal = window.bootstrap && window.bootstrap.Modal
      ? window.bootstrap.Modal.getOrCreateInstance(modalEl)
      : null;
    if (modal) modal.show();

    const params = new URLSearchParams();
    params.set('classId', classId || '');
    params.set('metricKey', metricKey || '');
    snapHubWeeklyReportsDateInputs();
    const filterValues = {
      startDate: hubInputValue('hubWeeklyReportsStartDate'),
      endDate: hubInputValue('hubWeeklyReportsEndDate'),
      departmentId: hubInputValue('hubWeeklyReportsDepartmentId'),
      programId: hubInputValue('hubWeeklyReportsProgramId'),
      teacherPersonId: hubInputValue('hubWeeklyReportsTeacherId')
    };
    Object.keys(filterValues).forEach(function (key) {
      if (filterValues[key]) params.set(key, filterValues[key]);
    });

    try {
      const response = await fetch('/school/report-hub/api/workspace/weekly-reports/drilldown?' + params.toString(), {
        credentials: 'same-origin',
        headers: { Accept: 'application/json' }
      });
      const payload = await response.json();
      if (!response.ok || payload.status === 'error') {
        throw new Error(payload.message || 'Unable to load details.');
      }
      if (titleEl) titleEl.textContent = payload.title || 'Details';
      const dateBits = [];
      if (filterValues.startDate) dateBits.push(filterValues.startDate);
      if (filterValues.endDate) dateBits.push(filterValues.endDate);
      if (subtitleEl) {
        subtitleEl.textContent = dateBits.length ? dateBits.join(' – ') : '';
      }
      if (bodyEl) {
        bodyEl.innerHTML = renderWeeklyReportsDrilldownTable(payload);
        bindWeeklyReportsDrilldownCaseRows(bodyEl);
      }
    } catch (error) {
      if (titleEl) titleEl.textContent = 'Unable to load';
      if (subtitleEl) subtitleEl.textContent = '';
      if (bodyEl) bodyEl.innerHTML = '<div class="alert alert-danger mb-0">' + escapeHtml(error.message || 'Unable to load details.') + '</div>';
    }
  }

  function formatWeeklyReportsClassMetrics(row) {
    const sessionCount = Number(row.sessionCount || 0);
    const sessionLabel = sessionCount === 1 ? '1' : String(sessionCount);
    const avgStudents = Number(row.avgStudentsPerSession || 0);
    const absenceCount = Number(row.absenceCount || 0);
    const lateCount = Number(row.lateCount || 0);
    const earlyLeaveCount = Number(row.earlyLeaveCount || 0);
    const attendanceLabel = String(absenceCount) + ' · ' + String(lateCount) + ' · ' + String(earlyLeaveCount);
    const gradebookCount = Number(row.gradebookCount || 0);
    const gradebookLabel = gradebookCount === 1 ? '1' : String(gradebookCount);
    return {
      sessionLabel: sessionLabel,
      avgLabel: String(avgStudents),
      attendanceLabel: attendanceLabel,
      gradebookLabel: gradebookLabel
    };
  }

  function weeklyReportsClassSortIndicator(key) {
    const sort = hubWeeklyReportsState.classListSort || { key: 'className', dir: 'asc' };
    if (sort.key !== key) return '';
    return sort.dir === 'desc' ? ' <i class="bi bi-sort-down"></i>' : ' <i class="bi bi-sort-up"></i>';
  }

  function buildWeeklyReportsEmptyFilterHint() {
    const parts = [];
    const departmentId = hubInputValue('hubWeeklyReportsDepartmentId');
    const programId = hubInputValue('hubWeeklyReportsProgramId');
    const teacherPersonId = hubInputValue('hubWeeklyReportsTeacherId');
    if (departmentId) {
      parts.push('department: ' + resolveWeeklyReportsDepartmentName(departmentId));
    }
    if (programId) {
      const programMatch = hubWeeklyReportsProgramOptions.find(function (row) { return row.id === programId; });
      parts.push('program: ' + (programMatch ? (programMatch.name || programId) : programId));
    }
    if (teacherPersonId) {
      const teacherMatch = hubWeeklyReportsTeacherOptions.find(function (row) { return row.id === teacherPersonId; });
      parts.push('teacher: ' + (teacherMatch ? (teacherMatch.name || teacherPersonId) : teacherPersonId));
    }
    if (hubWeeklyReportsClassSelections.length) {
      parts.push('classes: ' + String(hubWeeklyReportsClassSelections.length));
    }
    if (hubWeeklyReportsStudentSelections.length) {
      parts.push('students: ' + String(hubWeeklyReportsStudentSelections.length));
    }
    if (!parts.length) return '';
    return 'Active filters — ' + parts.join('; ') + '. Try clearing a filter or widening the date range, then click Apply again.';
  }

  function weeklyReportsNoResultsHint(defaultHint) {
    const filterHint = buildWeeklyReportsEmptyFilterHint();
    return filterHint || defaultHint || 'Try widening the date range or clearing class filters.';
