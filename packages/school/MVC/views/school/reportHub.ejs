  async function printStudentProgressHub() {
    if (hubStudentProgressPrintInProgress) {
      void showHubMessage({ title: 'Print', icon: 'info', message: 'Print is already preparing. Please wait…' });
      return;
    }
    if (!hubStudentProgressPayload || !Array.isArray(hubStudentProgressPayload.students) || !hubStudentProgressPayload.students.length) {
      void showHubMessage({ title: 'Print', icon: 'info', message: 'Generate a progress report before printing.' });
      return;
    }
    hubStudentProgressPrintInProgress = true;
    try {
      await runStudentProgressPrintJob(function () {
        return renderStudentProgressPrintDocument(hubStudentProgressPayload);
      });
    } finally {
      hubStudentProgressPrintInProgress = false;
      if (typeof window.hideLoading === 'function') {
        window.hideLoading({ force: true });
      }
    }
  }

  function weeklyReportsStudentSortValue(row, key) {
    if (key === 'name') return String(row.name || '');
    if (key === 'sessionCount' || key === 'presentCount') {
      const att = readWeeklyReportsStudentAttendance(row);
      return Number(att[key] || 0);
    }
    if (key === 'engagement.percent') {
      const pct = row.engagement && row.engagement.percent != null ? Number(row.engagement.percent) : -1;
      return Number.isFinite(pct) ? pct : -1;
    }
    if (key === 'punctuality.punctualityPercent') {
      const pct = punctualityPercentNumber(readWeeklyReportsStudentPunctuality(row));
      return pct == null ? -1 : pct;
    }
    if (String(key || '').indexOf('punctuality.') === 0) {
      const p = readWeeklyReportsStudentPunctuality(row);
      return Number(p[String(key).slice('punctuality.'.length)] || 0);
    }
    if (String(key || '').indexOf('attendance.') === 0) {
      const att = readWeeklyReportsStudentAttendance(row);
      return Number(att[String(key).slice('attendance.'.length)] || 0);
    }
    return Number(row[key] || 0);
  }

  function sortWeeklyReportsRows(rows) {
    const list = Array.isArray(rows) ? rows.slice() : [];
    const sort = hubWeeklyReportsState.listSort || { key: 'name', dir: 'asc' };
    const dir = sort.dir === 'desc' ? -1 : 1;
    const numericKeys = [
      'sessionCount', 'classCount', 'attendanceHealth', 'presentCount', 'lateCount', 'absenceCount', 'caseCount',
      'engagement.percent', 'punctuality.punctualityPercent', 'attendance.earlyCount', 'attendance.naCount', 'attendance.acfCount',
      'attendance.absenceCount', 'attendance.lateCount'
    ];
    list.sort(function (a, b) {
      if (sort.key === 'name') {
        return String(a.name || '').localeCompare(String(b.name || '')) * dir;
      }
      if (numericKeys.indexOf(sort.key) >= 0) {
        const left = weeklyReportsStudentSortValue(a, sort.key);
        const right = weeklyReportsStudentSortValue(b, sort.key);
        if (left !== right) return (left - right) * dir;
      }
      return String(a.name || '').localeCompare(String(b.name || '')) * dir;
    });
    return list;
  }

  function filterWeeklyReportsStudentsWithSessions(rows) {
    return (Array.isArray(rows) ? rows : []).filter(function (row) {
      const att = readWeeklyReportsStudentAttendance(row);
      return Number(att.sessionCount || row.sessionCount || 0) > 0;
    });
  }

  function renderWeeklyReportsAttendanceCountCell(count, options) {
    const opts = options || {};
    const excusedCount = Number(opts.excusedCount || 0);
    const excusedMinutes = Number(opts.excusedMinutes || 0);
    const showMinutes = opts.showMinutes !== false;
    const primaryCount = String(Number(count || 0));
    let excusedHtml = '';
    if (excusedCount > 0) {
      const bits = [String(excusedCount) + ' excused'];
      if (showMinutes && excusedMinutes > 0) bits.push(String(excusedMinutes) + 'm');
      excusedHtml = ' <span class="hub-wr-attendance-excused">(' + escapeHtml(bits.join(', ')) + ')</span>';
    }
    const primary = primaryCount + excusedHtml;
    return renderWeeklyReportsMetricStack(primary, '', {
      rawPrimary: !!excusedHtml,
      tone: opts.tone || ''
    });
  }

  function renderWeeklyReportsStudentEngagementRing(engagement) {
    const data = engagement && typeof engagement === 'object' ? engagement : {};
    const entry = {
      loading: false,
      error: '',
      percent: data.percent,
      presentMinutes: data.presentMinutes,
      scheduledMinutes: data.scheduledMinutes
    };
    const minutesLine = Number(entry.scheduledMinutes || 0) > 0
      ? '<div class="hub-wr-student-engagement-minutes">' + escapeHtml(String(entry.presentMinutes || 0) + '/' + String(entry.scheduledMinutes || 0) + ' min') + '</div>'
      : '';
    return [
      '<div class="hub-wr-student-engagement-cell">',
      '<div class="hub-weekly-reports-engagement-ring hub-weekly-reports-engagement-ring--compact">',
