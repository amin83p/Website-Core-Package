  function renderTimesheetManagementSummaryModal() {
    return [
      '<div class="modal fade" id="hubTimesheetManagementSummaryModal" tabindex="-1" aria-hidden="true">',
      '<div class="modal-dialog modal-xl modal-dialog-scrollable">',
      '<div class="modal-content">',
      '<div class="modal-header bg-primary text-white">',
      '<div><h5 class="modal-title fw-bold">Department Hours Summary</h5><div class="small opacity-75" id="hubTimesheetManagementSummarySubtitle"></div></div>',
      '<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>',
      '</div>',
      '<div class="modal-body" id="hubTimesheetManagementSummaryContent">',
      '<div class="text-center text-muted py-4"><span class="spinner-border spinner-border-sm me-2"></span>Loading summary...</div>',
      '</div>',
      '<div class="modal-footer bg-light"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button></div>',
      '</div>',
      '</div>',
