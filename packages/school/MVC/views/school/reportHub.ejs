<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
(function () {
  function formatHubDateKey(dateValue, options = {}) {
    const raw = String(dateValue || '').trim();
    if (!raw) return '-';
    if (window.AppOrgDateTime && typeof window.AppOrgDateTime.formatDateKey === 'function') {
      return window.AppOrgDateTime.formatDateKey(raw, options);
    }
    return raw;
  }

  function formatHubTableDateCellHtml(dateValue, timeLine) {
    const raw = String(dateValue || '').trim();
    if (!raw) {
      return '<span class="text-muted">—</span>';
    }
    const weekdayLine = formatHubDateKey(raw, { weekday: 'short', month: 'short', day: 'numeric' });
    const isoLine = formatHubDateKey(raw, { year: 'numeric', month: '2-digit', day: '2-digit' });
    const secondary = isoLine && isoLine !== weekdayLine ? isoLine : raw;
    const timeHtml = timeLine
      ? '<div class="hub-table-date-time"><i class="bi bi-clock me-1"></i>' + escapeHtml(timeLine) + '</div>'
      : '';
    return [
      '<div class="hub-table-date-cell">',
      '<div class="hub-table-date-primary">' + escapeHtml(weekdayLine || raw) + '</div>',
      '<div class="hub-table-date-secondary">' + escapeHtml(secondary) + '</div>',
      timeHtml,
      '</div>'
    ].join('');
  }

  function formatHubAttendanceSessionHeaderHtml(session) {
    const dateText = String(session && session.date || '').trim();
    if (!dateText) {
      return '<th class="text-center small hub-attendance-session-date">' + escapeHtml(String(session && session.id || '')) + '</th>';
    }
    const weekdayLine = formatHubDateKey(dateText, { weekday: 'short' });
    const dayLine = formatHubDateKey(dateText, { month: 'short', day: 'numeric' });
    return [
      '<th class="text-center small hub-attendance-session-date">',
      '<div class="hub-table-date-primary">' + escapeHtml(dayLine) + '</div>',
      '<div class="hub-table-date-secondary">' + escapeHtml(weekdayLine) + '</div>',
      '</th>'
    ].join('');
  }

  function formatHubInstant(value) {
    if (value === undefined || value === null || value === '') return 'just now';
    if (window.AppOrgDateTime && typeof window.AppOrgDateTime.formatInstant === 'function') {
      return window.AppOrgDateTime.formatInstant(value);
    }
    const date = new Date(value);
    return Number.isNaN(date.getTime()) ? 'just now' : date.toLocaleString();
  }

  function formatHubPrepareDuration(ms) {
    const value = Number(ms);
    if (!Number.isFinite(value) || value < 0) return '';
    if (value < 1000) return Math.round(value) + ' ms';
    if (value < 60000) return (value / 1000).toFixed(1) + ' s';
    const minutes = Math.floor(value / 60000);
    const seconds = Math.round((value % 60000) / 1000);
    return minutes + ' min ' + seconds + ' s';
  }

  function hubTodayIso() {
    if (window.AppOrgDateTime && window.AppOrgDateTime.today) {
      return String(window.AppOrgDateTime.today);
    }
    return '';
  }

  function hubOrgYear() {
    if (window.AppOrgDateTime && typeof window.AppOrgDateTime.orgYear === 'function') {
      const year = String(window.AppOrgDateTime.orgYear() || '').trim();
      if (year) return year;
    }
    return hubTodayIso().slice(0, 4);
  }

  function hubTodayDate() {
    if (window.AppOrgDateTime && typeof window.AppOrgDateTime.dateKeyToDate === 'function') {
      const parsed = window.AppOrgDateTime.dateKeyToDate(hubTodayIso());
      if (parsed) return parsed;
    }
    return new Date();
  }

  function hubDateToIso(date) {
    if (window.AppOrgDateTime && typeof window.AppOrgDateTime.dateToDateKey === 'function') {
      return window.AppOrgDateTime.dateToDateKey(date);
    }
    if (!(date instanceof Date) || Number.isNaN(date.getTime())) return '';
    const local = new Date(date.getTime() - (date.getTimezoneOffset() * 60000));
    return local.toISOString().slice(0, 10);
  }

  const root = document.querySelector('[data-master-hub]');
  if (!root) return;

  const canManageAllTasks = root.getAttribute('data-can-manage-all-tasks') === 'true';
  const TASK_ADMIN_SHOW_ALL_KEY = 'school_tasks_admin_show_all';

  function readTaskAdminShowAll() {
    try {
      return window.localStorage.getItem(TASK_ADMIN_SHOW_ALL_KEY) === 'true';
    } catch (error) {
      return false;
    }
  }

  function writeTaskAdminShowAll(value) {
    try {
      window.localStorage.setItem(TASK_ADMIN_SHOW_ALL_KEY, value ? 'true' : 'false');
    } catch (error) {
      // ignore storage errors
    }
  }

  const els = {
    taskCount: document.getElementById('schoolReportHubTaskCount'),
    taskSettings: document.getElementById('schoolReportHubTaskSettings'),
    workspace: document.getElementById('schoolReportHubWorkspace'),
    workspaceButtons: root.querySelectorAll('[data-hub-workspace-section]')
  };

  function escapeHtml(value) {
    return String(value == null ? '' : value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function hubStudentNameHtml(name, studentRecordId, className) {
    if (typeof schoolRenderStudentNameHtml === 'function') {
      return schoolRenderStudentNameHtml(name, studentRecordId, { className: className || 'text-decoration-none fw-semibold' });
    }
    return escapeHtml(name || '-');
  }

  async function showHubMessage(options) {
    if (typeof window.showMessageModal === 'function') {
      return window.showMessageModal(options || {});
    }
    return null;
  }

  async function confirmHubReload({ title = 'Reload Report Hub', message = 'Reload this Report Hub view?' } = {}) {
    const selected = await showHubMessage({
      title,
      icon: 'warning',
      message,
      buttons: [
        { text: 'Cancel', class: 'btn-secondary' },
        { text: 'Reload', class: 'btn-primary' }
      ]
    });
    return selected === 'Reload';
  }

  async function showCloseLimitationMessage() {
    return showHubMessage({
      title: 'Close Report Hub',
      icon: 'info',
      message: 'Browser tab close is controlled by the browser, so the app cannot replace it with this message modal. Use in-page navigation when you want a modal-confirmed exit.',
      buttons: [
        { text: 'OK', class: 'btn-primary' }
      ]
    });
  }

  const taskState = {
    intervalSeconds: 60,
    timer: null,
    visibilityPoller: null,
    loading: false
  };

  function setTaskCount(value, muted) {
    if (!els.taskCount) return;
    els.taskCount.textContent = String(value == null ? '-' : value);
    els.taskCount.classList.toggle('is-muted', Boolean(muted));
  }

  async function refreshTaskCount() {
    if (taskState.loading || !els.taskCount) return;
    taskState.loading = true;

    try {
      let taskCountUrl = '/school/report-hub/api/task-count';
      if (canManageAllTasks && !workspaceState.taskShowAll) {
        taskCountUrl += '?assignment=mine';
      }
      const response = await fetch(taskCountUrl, {
        headers: { Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        credentials: 'same-origin'
      });
      const payload = await response.json().catch(function () {
        return { status: 'error', message: 'Unable to read task count.' };
      });
      if (!response.ok || payload.status !== 'success') {
        throw new Error(payload.message || 'Unable to read task count.');
      }
      setTaskCount(payload.unresolvedCount || 0, false);
    } catch (error) {
      setTaskCount('-', true);
    } finally {
      taskState.loading = false;
    }
  }

  function restartTaskTimer() {
    if (taskState.visibilityPoller) {
      taskState.visibilityPoller.stop();
      taskState.visibilityPoller = null;
    }
    if (taskState.timer) {
      window.clearInterval(taskState.timer);
      taskState.timer = null;
    }

    const intervalMs = Math.max(10, taskState.intervalSeconds) * 1000;
    if (typeof window.createVisibilityInterval === 'function') {
      taskState.visibilityPoller = window.createVisibilityInterval(refreshTaskCount, intervalMs);
      taskState.visibilityPoller.start();
      return;
    }

    refreshTaskCount();
    taskState.timer = window.setInterval(refreshTaskCount, intervalMs);
  }

  function applyTaskInterval(value) {
    const parsed = Number(value);
    taskState.intervalSeconds = Number.isFinite(parsed) && parsed >= 10 ? parsed : 60;
    const intervalMs = Math.max(10, taskState.intervalSeconds) * 1000;
    if (taskState.visibilityPoller) {
      taskState.visibilityPoller.setIntervalMs(intervalMs);
      return;
    }
    restartTaskTimer();
  }

  async function openTaskSettings() {
    if (typeof window.showMessageModal !== 'function') {
      renderWorkspaceStatus('Message modal is not available on this page.', 'bi-exclamation-triangle', 'danger');
      return;
    }

    const inputId = 'schoolReportHubTaskIntervalInput';
    const selected = await window.showMessageModal({
      title: 'Task refresh timer',
      icon: 'info',
      size: 'md',
      message: [
        '<p class="mb-3">Set how often Report Hub checks unresolved or incomplete tasks while this page remains open.</p>',
        '<label class="form-label fw-semibold" for="' + inputId + '">Interval timer, in seconds</label>',
        '<div class="input-group">',
        '<input type="number" class="form-control" id="' + inputId + '" min="10" step="5" value="' + escapeHtml(taskState.intervalSeconds || 60) + '">',
        '<span class="input-group-text">seconds</span>',
        '</div>',
        '<div class="form-text">Default is 60 seconds. Minimum allowed value is 10 seconds.</div>'
      ].join(''),
      buttons: [
        { text: 'Cancel', class: 'btn-secondary' },
        { text: 'Save Timer', class: 'btn-primary' }
      ]
    });

    if (selected === 'Save Timer') {
      const input = document.getElementById(inputId);
      applyTaskInterval(input ? input.value : 60);
    }
  }

  const workspaceState = {
    currentSection: '',
    loading: false,
    serverSearch: {
      holidays: ''
    },
    holidaysYear: String((typeof orgToday !== 'undefined' && orgToday) ? String(orgToday).slice(0, 4) : hubTodayIso().slice(0, 4))
    ,
    taskShowAll: canManageAllTasks ? readTaskAdminShowAll() : false,
    taskPersonId: '',
    taskPersonName: '',
    activityPersonId: '',
    activityPersonName: '',
    reportAssignmentTeacherPersonId: '',
    reportAssignmentTeacherName: '',
    reportAssignmentScope: '',
    academicLedgerStudents: []
  };

  const workspaceSections = {
    holidays: {
      label: 'Holidays',
      endpoint: '/school/report-hub/api/workspace/holidays',
      sourceUrl: '/school/holidays',
      icon: 'bi bi-calendar-event-fill'
    },
    'academic-ledger': {
      label: 'Academic Ledger',
      endpoint: '/school/report-hub/api/workspace/academic-ledger',
      sourceUrl: '/school/academic-ledger',
      icon: 'bi bi-journal-bookmark-fill'
    },
    'weekly-reports': {
      label: 'Weekly Reports',
      endpoint: '/school/report-hub/api/workspace/weekly-reports',
      sourceUrl: '/school/report-hub',
      icon: 'bi bi-calendar-week'
    },
    'student-progress': {
      label: 'Student Progress',
      endpoint: '/school/report-hub/api/workspace/student-progress',
      sourceUrl: '/school/report-hub',
      icon: 'bi bi-graph-up'
    }
  };

  function setWorkspaceButtons(activeKey) {
    els.workspaceButtons.forEach(function (button) {
      const key = button.getAttribute('data-hub-workspace-section') || '';
      const segment = button.closest('.hub-section-segment');
      if (segment) {
        segment.classList.toggle('is-active', key === activeKey);
      }
    });
  }

  function renderWorkspaceStatus(message, icon, tone) {
    if (!els.workspace) return;
    els.workspace.innerHTML = [
      '<div class="hub-stage-empty text-' + escapeHtml(tone || 'muted') + '">',
      '<div class="text-center px-4">',
      '<i class="bi ' + escapeHtml(icon || 'bi-grid-1x2-fill') + ' display-5 d-block mb-3"></i>',
      '<h2 class="h5">' + escapeHtml(message || 'Select a section to begin.') + '</h2>',
      '</div>',
      '</div>'
    ].join('');
  }

  function statusBadgeClass(status) {
    const value = String(status || '').toLowerCase();
    if (value === 'resolved') return 'text-bg-success';
    if (value === 'in_progress') return 'text-bg-primary';
    if (value === 'dismissed') return 'text-bg-secondary';
    return 'text-bg-warning';
  }

  function severityBadgeClass(severity) {
    const value = String(severity || '').toLowerCase();
    if (value === 'critical' || value === 'high') return 'text-bg-danger';
    if (value === 'warning' || value === 'medium') return 'text-bg-warning';
    if (value === 'success' || value === 'low') return 'text-bg-success';
    return 'text-bg-info';
  }

  function workspaceToolbarHtml(key, options) {
    const opts = options || {};
    const label = opts.label || 'records';
    const serverValue = workspaceState.serverSearch[key] || '';
    return [
      '<div class="hub-workspace-toolbar">',
      '<div class="row g-2 align-items-end">',
      '<div class="col-lg-6">',
      '<label class="form-label small fw-semibold" for="hubServerSearch_' + escapeHtml(key) + '">DB Search</label>',
      '<div class="input-group">',
      '<input type="search" class="form-control form-control-sm" id="hubServerSearch_' + escapeHtml(key) + '" data-hub-server-search-input="' + escapeHtml(key) + '" value="' + escapeHtml(serverValue) + '" placeholder="Search ' + escapeHtml(label) + ' in database...">',
      '<button type="button" class="btn btn-primary btn-sm" data-hub-server-search-button="' + escapeHtml(key) + '"><i class="bi bi-search me-1"></i> Search</button>',
      '<button type="button" class="btn btn-outline-secondary btn-sm" data-hub-server-search-clear="' + escapeHtml(key) + '"><i class="bi bi-x-circle me-1"></i> Clear</button>',
      '</div>',
      '</div>',
      '<div class="col-lg-6">',
      '<label class="form-label small fw-semibold" for="hubTableSearch_' + escapeHtml(key) + '">Search Visible Table</label>',
      '<input type="search" class="form-control form-control-sm" id="hubTableSearch_' + escapeHtml(key) + '" data-hub-table-search-input="' + escapeHtml(key) + '" placeholder="Filter displayed rows...">',
      '</div>',
      '</div>',
      '</div>'
    ].join('');
  }

  function bindWorkspaceSearchControls(key) {
    if (!els.workspace) return;
    const serverInput = els.workspace.querySelector('[data-hub-server-search-input="' + key + '"]');
    const serverButton = els.workspace.querySelector('[data-hub-server-search-button="' + key + '"]');
    const clearButton = els.workspace.querySelector('[data-hub-server-search-clear="' + key + '"]');
    const tableInput = els.workspace.querySelector('[data-hub-table-search-input="' + key + '"]');

    const runServerSearch = function () {
      workspaceState.serverSearch[key] = String(serverInput ? serverInput.value : '').trim();
      loadWorkspaceSection(key);
    };

    if (serverButton) serverButton.addEventListener('click', runServerSearch);
    if (serverInput) {
      serverInput.addEventListener('keydown', function (event) {
        if (event.key === 'Enter') {
          event.preventDefault();
          runServerSearch();
        }
      });
    }
    if (clearButton) {
      clearButton.addEventListener('click', function () {
        workspaceState.serverSearch[key] = '';
        if (serverInput) serverInput.value = '';
        loadWorkspaceSection(key);
      });
    }
    if (tableInput) {
      tableInput.addEventListener('input', function () {
        const term = String(tableInput.value || '').trim().toLowerCase();
        els.workspace.querySelectorAll('[data-hub-workspace-row]').forEach(function (row) {
          const text = String(row.getAttribute('data-search-text') || row.textContent || '').toLowerCase();
          row.classList.toggle('d-none', Boolean(term && !text.includes(term)));
        });
      });
    }
  }

  function hubTaskPersonLabelFromItem(item) {
    const firstName = String(item && (item.firstName || item.name?.first) || '').trim();
    const lastName = String(item && (item.lastName || item.name?.last) || '').trim();
    const preferredName = String(item && (item.preferredName || item.name?.preferred) || '').trim();
    const directName = String(item && (item.label || item.displayName || item.fullName || item.name) || '').trim();
    const name = preferredName || [firstName, lastName].filter(Boolean).join(' ').trim() || directName;
