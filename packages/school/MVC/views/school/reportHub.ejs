  function formatWeeklyReportsSkillPercent(value) {
    const n = Number(value);
    if (!Number.isFinite(n)) return '0%';
    const rounded = Math.round(n * 10) / 10;
    const text = rounded % 1 === 0 ? String(Math.round(rounded)) : String(rounded);
    return text + '%';
  }

  function renderWeeklyReportsStudentSkillsVisual(skillAverages, options) {
    const opts = options || {};
    const printList = !!opts.printList;
    const printDetail = !!opts.printDetail;
    const list = Array.isArray(skillAverages) ? skillAverages : [];
    if (!list.length) {
      return '<span class="text-muted small">—</span>';
    }
    const rows = list.map(function (skill) {
      const label = String(skill.skillLabel || skill.skillId || 'Skill');
      const rawPct = Number(skill.averagePercent);
      const pct = Math.max(0, Math.min(100, Number.isFinite(rawPct) ? rawPct : 0));
      const barWidth = Math.max(0, Math.min(100, Math.round(pct)));
      const pctLabel = formatWeeklyReportsSkillPercent(pct);
      const fillColor = weeklyReportsEngagementStrokeColor(barWidth);
      const blockClass = printDetail
        ? 'hub-wr-student-skill-block hub-wr-student-skill-block--print-detail'
        : (printList
          ? 'hub-wr-student-skill-block hub-wr-student-skill-block--print-list'
          : 'hub-wr-student-skill-block');
      const barHtml = [
        '<div class="hub-wr-student-skill-bar-track" title="', escapeHtml(pctLabel), '">',
        '<div class="hub-wr-student-skill-bar-fill" style="width:', escapeHtml(String(barWidth)), '%;background:', escapeHtml(fillColor), ';"></div>',
        '</div>'
      ].join('');
      const pctHtml = '<div class="hub-wr-student-skill-pct">' + escapeHtml(pctLabel) + '</div>';
      const labelHtml = '<div class="hub-wr-student-skill-label" title="' + escapeHtml(label) + '">' + escapeHtml(label) + '</div>';
      const blockParts = (printList || printDetail)
        ? [labelHtml, barHtml, pctHtml]
        : [labelHtml, pctHtml, barHtml];
      return '<div class="' + blockClass + '">' + blockParts.join('') + '</div>';
    }).join('');
    return '<div class="hub-wr-student-skill-visual">' + rows + '</div>';
  }

  function renderWeeklyReportsStudentCasesCell(row) {
    const items = Array.isArray(row.studentCaseItems) ? row.studentCaseItems : [];
    const count = items.length || Number(row.caseCount || 0);
