      if (!classes.length) return '';
      const groupKey = weeklyReportsTeacherGroupKey(group);
      const collapsed = isWeeklyReportsTeacherGroupCollapsed(groupKey);
      if (collapsed) {
        return renderWeeklyReportsCollapsedTeacherRow(group, classes, groupKey);
