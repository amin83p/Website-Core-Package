  function readWeeklyReportsStudentPunctuality(rowOrWeek) {
    const raw = rowOrWeek && rowOrWeek.punctuality && typeof rowOrWeek.punctuality === 'object'
      ? rowOrWeek.punctuality
      : null;
    if (raw) return raw;
    return {
      attendedSessions: 0,
      onTimeSessions: 0,
      totalIssueSessions: 0,
      punctualityPercent: 'N/A',
      punctualityLabel: 'Not available'
    };
  }

  function punctualityPercentNumber(summary) {
    const n = Number(summary && summary.punctualityPercent);
    return Number.isFinite(n) ? n : null;
  }

  function punctualityToneFromPercent(percent) {
    const pct = punctualityPercentNumber({ punctualityPercent: percent });
    if (pct == null) return 'info';
    if (pct >= 95) return 'success';
    if (pct >= 85) return 'info';
    if (pct >= 70) return 'warning';
    return 'danger';
  }

  function punctualityStrokeColor(percent) {
    const tone = punctualityToneFromPercent(percent);
    if (tone === 'success') return '#16a34a';
    if (tone === 'warning') return '#d97706';
    if (tone === 'danger') return '#dc2626';
    return '#0284c7';
  }

  function buildPunctualityDonutSvg(summary, options) {
    const opts = options || {};
    const data = readWeeklyReportsStudentPunctuality({ punctuality: summary });
    const attended = Number(data.attendedSessions || 0);
    if (!attended) {
      return '<div class="hub-weekly-reports-engagement-placeholder" title="No attended sessions in period">—</div>';
    }
    const pctRaw = punctualityPercentNumber(data);
    const pct = pctRaw == null ? 0 : Math.max(0, Math.min(100, Math.round(pctRaw)));
    const radius = 15;
    const circumference = 2 * Math.PI * radius;
    const offset = circumference * (1 - pct / 100);
    const onTime = Number(data.onTimeSessions || 0);
    const issues = Math.max(0, attended - onTime);
    const tooltip = onTime + ' on time / ' + attended + ' attended (' + issues + ' timing issues)';
    const strokeColor = punctualityStrokeColor(pctRaw);
    const svgClass = opts.svgClass || 'hub-wr-punctuality-svg';
    return [
      '<svg class="', escapeHtml(svgClass), '" viewBox="0 0 36 36" role="img" aria-label="Punctuality ', escapeHtml(String(pct)), ' percent">',
      '<title>', escapeHtml(tooltip), '</title>',
      '<circle class="hub-wr-punctuality-track" cx="18" cy="18" r="', String(radius), '" fill="none" stroke-width="3"></circle>',
      '<circle class="hub-wr-punctuality-progress" cx="18" cy="18" r="', String(radius), '" fill="none" stroke-width="3" stroke-linecap="round" stroke="',
      escapeHtml(strokeColor), '" stroke-dasharray="', String(circumference), '" stroke-dashoffset="', String(offset), '" transform="rotate(-90 18 18)"></circle>',
      '<text class="hub-wr-punctuality-text" x="18" y="18" text-anchor="middle" dominant-baseline="central" fill="', escapeHtml(strokeColor), '">', escapeHtml(String(pct)), '</text>',
      '</svg>'
    ].join('');
  }

  function renderWeeklyReportsPunctualityCell(summary, options) {
    const opts = options || {};
    const data = readWeeklyReportsStudentPunctuality({ punctuality: summary });
    const showLabel = opts.showLabel !== false;
    const compact = !!opts.compact;
    const ringClass = [
      'hub-wr-punctuality-ring',
      compact ? 'hub-wr-punctuality-ring--compact' : '',
      opts.printList ? 'hub-wr-print-punctuality-ring' : ''
    ].filter(Boolean).join(' ');
    const labelHtml = showLabel && data.punctualityLabel
      ? '<div class="hub-wr-punctuality-label">' + escapeHtml(String(data.punctualityLabel)) + '</div>'
      : '';
    return [
      '<div class="', ringClass, '">',
      buildPunctualityDonutSvg(data, opts),
      labelHtml,
      '</div>'
    ].join('');
  }

  function renderWeeklyReportsPunctualityBreakdown(summary) {
