    const level = hubWeeklyReportsState.level === 'students' ? 'students' : 'classes';
    if (hubWeeklyReportsState.loading) {
      const loadingLabel = level === 'students' ? 'Loading students...' : 'Loading classes...';
      return '<div class="text-center py-5 text-muted"><span class="spinner-border spinner-border-sm me-2"></span>' + escapeHtml(loadingLabel) + '</div>';
    }
    if (hubWeeklyReportsState.lastError) {
      return renderWeeklyReportsEmptyState('Unable to load weekly reports.', hubWeeklyReportsState.lastError);
    }
    if (!hubWeeklyReportsActiveTabId && !hubWeeklyReportsState.lastLoadedAt && !hubWeeklyReportsState.loading) {
      return renderWeeklyReportsEmptyState('Ready to load classes.', 'Choose filters and click Apply, or use a quick report shortcut below.');
    }
    if (level === 'classes') {
      const classRows = Array.isArray(hubWeeklyReportsState.classRows) ? hubWeeklyReportsState.classRows : [];
      const body = hubWeeklyReportsState.viewMode === 'list'
        ? renderWeeklyReportsClassList(classRows)
        : renderWeeklyReportsClassBoard(classRows);
      return renderWeeklyReportsResultsToolbar() + body;
    }
    const rows = Array.isArray(hubWeeklyReportsState.rows) ? hubWeeklyReportsState.rows : [];
    const detailId = String(hubWeeklyReportsState.studentDetailId || '').trim();
    if (detailId) {
      const detailRow = rows.find(function (row) { return String(row.studentId || '') === detailId; }) || null;
      const body = renderWeeklyReportsStudentDetail(detailRow);
      return renderWeeklyReportsResultsToolbar() + body;
    }
    const body = hubWeeklyReportsState.viewMode === 'list'
      ? renderWeeklyReportsList(rows)
      : renderWeeklyReportsBoard(rows);
    return renderWeeklyReportsResultsToolbar() + body;
  }

