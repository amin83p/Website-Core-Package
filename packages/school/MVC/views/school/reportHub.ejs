  function hubSnapToWeekStart(date) {
    const d = new Date(date.getFullYear(), date.getMonth(), date.getDate());
    const day = d.getDay() || 7;
    d.setDate(d.getDate() - (day - 1));
    return d;
  }

  function hubSnapToWeekEnd(date) {
    const start = hubSnapToWeekStart(date);
    const end = new Date(start);
    end.setDate(start.getDate() + 6);
    return end;
  }

  function hubParseDateInputValue(value) {
    const raw = String(value || '').trim();
    if (!raw) return null;
    const parts = raw.split('-').map(Number);
    if (parts.length !== 3 || parts.some(function (n) { return Number.isNaN(n); })) return null;
    return new Date(parts[0], parts[1] - 1, parts[2]);
  }

