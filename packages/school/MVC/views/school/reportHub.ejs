      '<div class="d-flex gap-2 hub-no-print ' + escapeHtml(opts.extraClass || '') + '">',
      '<button type="button" class="btn btn-outline-secondary btn-sm"' + shareDisabledAttr + ' data-hub-weekly-reports-share><i class="bi bi-link-45deg me-1"></i>Share</button>',
      '<button type="button" class="btn btn-outline-secondary btn-sm"' + printDisabledAttr + ' data-hub-weekly-reports-print><i class="bi bi-printer me-1"></i>Print</button>',
      '</div>'
    ].join('');
