      updateWeeklyReportsEngagementRings();
      if (weeklyReportsShouldScheduleTeacherEngagement()) {
        scheduleWeeklyReportsTeacherEngagement();
      }
    }
    if (hubWeeklyReportsState.level === 'classes' && hubWeeklyReportsState.viewMode === 'board') {
      scheduleFitWeeklyReportsDeckClassTitles(panel);
