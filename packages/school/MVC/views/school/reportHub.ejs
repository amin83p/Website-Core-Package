      return [
        '<section class="hub-sp-print-student-page hub-wr-print-student-page">',
        '<div class="hub-wr-print-doc-meta">',
        '<div class="hub-wr-print-doc-title">', escapeHtml(title), '</div>',
        '<div class="text-muted small">', escapeHtml(rangeLabel), ' &nbsp;|&nbsp; Printed ', escapeHtml(prepared), '</div>',
        '</div>',
        classHtml || '<div class="text-muted">No scheduled sessions in this range.</div>',
        '</section>'
      ].join('');
