      if (searchInput) searchInput.value = '';
      loadWorkspaceSection('session-issues');
    });
    root.querySelectorAll('[data-hub-session-issue-range]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        setHubSessionIssueDateRange(btn.getAttribute('data-hub-session-issue-range') || 'today');
