  function buildWeeklyReportsStudentTileStyle(health) {
    const score = Math.max(0, Math.min(100, Number(health) || 0));
    const t = score / 100;
    const r = Math.round(220 + ((22 - 220) * t));
    const g = Math.round(38 + ((163 - 38) * t));
    const b = Math.round(38 + ((74 - 38) * t));
    const color = 'rgb(' + String(r) + ', ' + String(g) + ', ' + String(b) + ')';
    const toRgba = function (alpha) {
      return 'rgba(' + String(r) + ', ' + String(g) + ', ' + String(b) + ', ' + String(alpha) + ')';
    };
    return [
      'border-left-color:' + color + ';',
      'background:linear-gradient(145deg, ' + toRgba(0.14) + ', ' + toRgba(0.06) + ');'
    ].join('');
  }

  function renderWeeklyReportsStudentMetricLine(label, value, valueClass) {
    const valueClassName = valueClass ? ('value ' + valueClass) : 'value';
    return [
      '<div class="hub-weekly-reports-student-tile-metric-line">',
      '<span class="label">' + escapeHtml(label) + '</span>',
      '<span class="' + escapeHtml(valueClassName) + '">' + escapeHtml(value) + '</span>',
      '</div>'
    ].join('');
  }

  function renderWeeklyReportsStudentAttendanceSummary(row) {
    const att = readWeeklyReportsStudentAttendance(row);
    const engagementPct = row.engagement && row.engagement.percent != null
      ? Math.round(Number(row.engagement.percent) || 0) + '%'
      : '—';
    const lines = [
      renderWeeklyReportsStudentMetricLine('Engagement', engagementPct),
      renderWeeklyReportsStudentMetricLine('Sessions', String(att.sessionCount)),
      renderWeeklyReportsStudentMetricLine('Present', String(att.presentCount), 'attendance-status-present'),
      renderWeeklyReportsStudentMetricLine('Late', String(att.lateCount), 'attendance-status-late'),
      renderWeeklyReportsStudentMetricLine('Early', String(att.earlyCount)),
      renderWeeklyReportsStudentMetricLine('Absent', String(att.absenceCount), 'attendance-status-absent')
    ];
    if (hubWeeklyReportsState.studentClassContext && hubWeeklyReportsState.studentClassContext.showAcfColumn) {
      lines.push(renderWeeklyReportsStudentMetricLine('ACF', String(att.acfCount)));
    }
    lines.push(renderWeeklyReportsStudentMetricLine('N/A', String(att.naCount)));
    return [
      '<div class="hub-weekly-reports-student-tile-section">',
      '<div class="hub-weekly-reports-student-tile-section-title">Attendance</div>',
      lines.join(''),
      '</div>'
    ].join('');
  }

  function renderWeeklyReportsStudentSkillsSummary(skillAverages) {
    const list = Array.isArray(skillAverages) ? skillAverages : [];
    if (!list.length) return '';
    return [
      '<div class="hub-weekly-reports-student-tile-section">',
      '<div class="hub-weekly-reports-student-tile-section-title">Activity skills</div>',
      renderWeeklyReportsStudentSkillsVisual(skillAverages),
      '</div>'
    ].join('');
  }

  function formatWeeklyReportsSkillSummary(skillAverages) {
    const list = Array.isArray(skillAverages) ? skillAverages : [];
    if (!list.length) return '-';
    const top = list.slice(0, 2).map(function (row) {
      return String(row.skillLabel || row.skillId || 'Skill') + ' ' + String(row.averagePercent) + '%';
    });
    if (list.length > 2) top.push('+' + String(list.length - 2));
    return top.join(', ');
  }

  function sortWeeklyReportsClassRows(rows) {
    const list = Array.isArray(rows) ? rows.slice() : [];
    const sort = hubWeeklyReportsState.classListSort || { key: 'className', dir: 'asc' };
    const dir = sort.dir === 'desc' ? -1 : 1;
    const numericKeys = ['sessionCount', 'avgStudentsPerSession', 'absenceCount', 'lateCount', 'earlyLeaveCount', 'gradebookCount', 'scheduledHours'];
    list.sort(function (a, b) {
      if (numericKeys.indexOf(sort.key) >= 0) {
        const left = Number(a[sort.key] || 0);
        const right = Number(b[sort.key] || 0);
        if (left !== right) return (left - right) * dir;
      }
      return String(a.className || a.classId || '').localeCompare(String(b.className || b.classId || '')) * dir;
    });
    return list;
  }

  function groupWeeklyReportsClassesByTeacher(rows) {
    const sorted = sortWeeklyReportsClassRows(rows);
    const map = new Map();
    sorted.forEach(function (row) {
      const key = String(row.teacherPersonId || row.teacherName || 'unassigned').trim() || 'unassigned';
      if (!map.has(key)) {
        map.set(key, {
          teacherPersonId: String(row.teacherPersonId || '').trim(),
          teacherName: String(row.teacherName || 'Unassigned').trim() || 'Unassigned',
          classes: []
        });
      }
      map.get(key).classes.push(row);
    });
    return Array.from(map.values()).sort(function (a, b) {
      return String(a.teacherName || '').localeCompare(String(b.teacherName || ''));
    });
  }

  function weeklyReportsTeacherGroupKey(group) {
    const personId = String(group && group.teacherPersonId || '').trim();
    if (personId) return 'person:' + personId;
    const name = String(group && group.teacherName || 'unassigned').trim().toLowerCase() || 'unassigned';
    return 'name:' + name;
  }

  function clampWeeklyReportsTeacherDeckIndex(index, classCount) {
    const count = Math.max(0, Number(classCount) || 0);
    if (count <= 0) return 0;
    const value = Number(index);
    if (!Number.isFinite(value)) return 0;
    return Math.max(0, Math.min(count - 1, Math.round(value)));
  }

  function getWeeklyReportsTeacherDeckIndex(groupKey, classCount) {
    const map = hubWeeklyReportsState.teacherBoardDeckIndex || {};
    return clampWeeklyReportsTeacherDeckIndex(map[groupKey], classCount);
  }

  function findWeeklyReportsTeacherGroupByKey(groupKey) {
    const key = String(groupKey || '').trim();
    if (!key) return null;
    const rows = Array.isArray(hubWeeklyReportsState.classRows) ? hubWeeklyReportsState.classRows : [];
    const groups = groupWeeklyReportsClassesByTeacher(rows);
    return groups.find(function (group) { return weeklyReportsTeacherGroupKey(group) === key; }) || null;
  }

  function setWeeklyReportsTeacherDeckIndex(groupKey, index, classCount) {
    if (!hubWeeklyReportsState.teacherBoardDeckIndex) {
      hubWeeklyReportsState.teacherBoardDeckIndex = {};
    }
    hubWeeklyReportsState.teacherBoardDeckIndex[groupKey] = clampWeeklyReportsTeacherDeckIndex(index, classCount);
    if (hubWeeklyReportsState.viewMode === 'board') {
      refreshWeeklyReportsTeacherDeckPanel(groupKey);
    } else {
      renderWeeklyReportsResultsPanel();
    }
    syncWeeklyReportsShareUrl();
  }

  function cycleWeeklyReportsTeacherDeckIndex(groupKey, classCount, delta) {
    const count = Math.max(0, Number(classCount) || 0);
    if (count <= 1) return;
    const current = getWeeklyReportsTeacherDeckIndex(groupKey, count);
    const next = (current + Number(delta || 0) + count) % count;
    hubWeeklyReportsTeacherDeckFlip = {
      groupKey: String(groupKey || ''),
      dir: Number(delta || 0) >= 0 ? 'next' : 'prev'
    };
    setWeeklyReportsTeacherDeckIndex(groupKey, next, count);
  }

  function weeklyReportsShouldScheduleTeacherEngagement() {
    return hubWeeklyReportsState.level === 'classes'
      && (hubWeeklyReportsState.viewMode === 'list' || hubWeeklyReportsState.viewMode === 'board')
      && !hubWeeklyReportsState.lastError
      && Array.isArray(hubWeeklyReportsState.classRows)
      && hubWeeklyReportsState.classRows.length > 0;
  }

  function isWeeklyReportsTeacherGroupCollapsed(groupKey) {
    const map = hubWeeklyReportsState.teacherGroupCollapsed || {};
    return map[groupKey] === true;
  }

  function weeklyReportsEngagementSnapshotKey() {
    snapHubWeeklyReportsDateInputs();
    return [
      hubInputValue('hubWeeklyReportsStartDate'),
      hubInputValue('hubWeeklyReportsEndDate'),
      hubInputValue('hubWeeklyReportsDepartmentId'),
      hubInputValue('hubWeeklyReportsProgramId'),
      hubInputValue('hubWeeklyReportsTeacherId')
    ].join('|');
  }

  function getWeeklyReportsTeacherEngagementEntry(groupKey) {
    const map = hubWeeklyReportsState.teacherEngagement || {};
    return map[groupKey] || { loading: true };
  }

  function getWeeklyReportsClassEngagementEntry(classId) {
    const id = String(classId || '').trim();
    const map = hubWeeklyReportsState.classEngagement || {};
    return map[id] || { loading: true };
  }

  function renderWeeklyReportsPrintClassEngagementRing(classId) {
    const id = String(classId || '').trim();
    const entry = getWeeklyReportsClassEngagementEntry(id);
    const stateClass = entry.loading
      ? 'hub-weekly-reports-engagement-ring--loading'
      : (entry.percent == null && !entry.error ? 'hub-weekly-reports-engagement-ring--empty' : '');
    return [
      '<div class="hub-weekly-reports-engagement-ring hub-weekly-reports-engagement-ring--compact ', stateClass,
      '" data-hub-wr-class-engagement-id="', escapeHtml(id), '">',
      buildWeeklyReportsEngagementRingInner(entry),
      '</div>'
    ].join('');
  }

  function renderWeeklyReportsPrintClassTitleRow(row) {
    const classId = String(row.classId || '').trim();
    const className = String(row.className || row.classId || 'Class').trim();
    return [
      '<div class="hub-wr-print-class-title-row hub-wr-print-engagement">',
      renderWeeklyReportsPrintClassEngagementRing(classId),
      '<div class="hub-wr-print-class-title">', escapeHtml(className), '</div>',
      '</div>'
    ].join('');
  }

  function renderWeeklyReportsClassEngagementBlock(classId) {
    const id = String(classId || '').trim();
    return [
      '<div class="hub-weekly-reports-engagement-block hub-wr-deck-class-engagement">',
      renderWeeklyReportsPrintClassEngagementRing(id),
      '<span class="hub-weekly-reports-engagement-label">Engagement</span>',
      '</div>'
    ].join('');
  }

  function weeklyReportsEngagementStrokeColor(percent) {
    const pct = Math.max(0, Math.min(100, Number(percent) || 0));
    if (pct <= 20) return '#dc2626';
    if (pct >= 100) return '#16a34a';
    const t = (pct - 20) / 80;
    const r = Math.round(220 + (22 - 220) * t);
    const g = Math.round(38 + (163 - 38) * t);
    const b = Math.round(38 + (74 - 38) * t);
    return 'rgb(' + String(r) + ',' + String(g) + ',' + String(b) + ')';
  }

  function buildWeeklyReportsEngagementRingInner(entry) {
    const data = entry || {};
    if (data.loading) {
      return '<div class="hub-weekly-reports-engagement-placeholder"><span class="spinner-border spinner-border-sm"></span></div>';
    }
    if (data.error) {
      return '<div class="hub-weekly-reports-engagement-placeholder text-danger" title="Unable to load engagement">!</div>';
    }
    const scheduled = Number(data.scheduledMinutes || 0);
    const present = Number(data.presentMinutes || 0);
    if (!scheduled || data.percent == null) {
      return '<div class="hub-weekly-reports-engagement-placeholder" title="No scheduled student time in period">—</div>';
    }
    const pct = Math.max(0, Math.min(100, Math.round(Number(data.percent) || 0)));
    const radius = 15;
    const circumference = 2 * Math.PI * radius;
    const offset = circumference * (1 - pct / 100);
    const tooltip = present + ' / ' + scheduled + ' min present';
    const strokeColor = weeklyReportsEngagementStrokeColor(pct);
    return [
      '<svg class="hub-weekly-reports-engagement-svg" viewBox="0 0 36 36" role="img" aria-label="Engagement ' + escapeHtml(String(pct)) + ' percent">',
      '<title>', escapeHtml(tooltip), '</title>',
      '<circle class="hub-wr-engagement-track" cx="18" cy="18" r="' + String(radius) + '" fill="none" stroke-width="3"></circle>',
      '<circle class="hub-wr-engagement-progress" cx="18" cy="18" r="' + String(radius) + '" fill="none" stroke-width="3" stroke-linecap="round" stroke="',
      escapeHtml(strokeColor), '" stroke-dasharray="',
      String(circumference), '" stroke-dashoffset="', String(offset), '" transform="rotate(-90 18 18)"></circle>',
      '<text class="hub-wr-engagement-text" x="18" y="18" text-anchor="middle" dominant-baseline="central" fill="', escapeHtml(strokeColor), '">', escapeHtml(String(pct)), '</text>',
      '</svg>'
    ].join('');
  }

  function renderWeeklyReportsEngagementRing(groupKey, options) {
    const opts = options || {};
    const compact = !!opts.compact;
    const entry = getWeeklyReportsTeacherEngagementEntry(groupKey);
    const stateClass = entry.loading
      ? 'hub-weekly-reports-engagement-ring--loading'
      : (entry.percent == null && !entry.error ? 'hub-weekly-reports-engagement-ring--empty' : '');
    return [
      '<div class="hub-weekly-reports-engagement-ring ' + (compact ? 'hub-weekly-reports-engagement-ring--compact ' : '') + stateClass + '" data-hub-wr-engagement-key="',
      escapeHtml(groupKey || ''), '" data-hub-wr-engagement-compact="', compact ? '1' : '0', '">',
      buildWeeklyReportsEngagementRingInner(entry),
      '</div>'
    ].join('');
  }

  function updateWeeklyReportsEngagementRings() {
    const panel = document.getElementById('hubWeeklyReportsResults');
    if (!panel) return;
    panel.querySelectorAll('[data-hub-wr-engagement-key]').forEach(function (el) {
      const groupKey = el.getAttribute('data-hub-wr-engagement-key') || '';
      const compact = el.getAttribute('data-hub-wr-engagement-compact') === '1';
      const entry = getWeeklyReportsTeacherEngagementEntry(groupKey);
      el.classList.remove('hub-weekly-reports-engagement-ring--loading', 'hub-weekly-reports-engagement-ring--empty');
      if (entry.loading) el.classList.add('hub-weekly-reports-engagement-ring--loading');
      else if (entry.percent == null && !entry.error) el.classList.add('hub-weekly-reports-engagement-ring--empty');
      el.innerHTML = buildWeeklyReportsEngagementRingInner(entry);
      if (compact) el.classList.add('hub-weekly-reports-engagement-ring--compact');
    });
    panel.querySelectorAll('[data-hub-wr-class-engagement-id]').forEach(function (el) {
      const classId = el.getAttribute('data-hub-wr-class-engagement-id') || '';
      const entry = getWeeklyReportsClassEngagementEntry(classId);
      el.classList.remove('hub-weekly-reports-engagement-ring--loading', 'hub-weekly-reports-engagement-ring--empty');
      if (entry.loading) el.classList.add('hub-weekly-reports-engagement-ring--loading');
      else if (entry.percent == null && !entry.error) el.classList.add('hub-weekly-reports-engagement-ring--empty');
      el.innerHTML = buildWeeklyReportsEngagementRingInner(entry);
      el.classList.add('hub-weekly-reports-engagement-ring--compact');
    });
  }

  function weeklyReportsClassEngagementReadyForRows(rows, snapshot) {
    const list = Array.isArray(rows) ? rows : [];
    if (!list.length) return true;
    const map = hubWeeklyReportsState.classEngagement || {};
    return list.every(function (row) {
      const id = String(row.classId || '').trim();
      if (!id) return true;
      const entry = map[id];
      if (!entry || entry.snapshot !== snapshot) return false;
      return !entry.loading;
    });
  }

  function scheduleWeeklyReportsTeacherEngagement() {
    const run = function () {
      loadWeeklyReportsTeacherEngagement();
    };
    if (typeof window.requestIdleCallback === 'function') {
      window.requestIdleCallback(run, { timeout: 1500 });
    } else {
      setTimeout(run, 50);
    }
  }

  async function loadWeeklyReportsTeacherEngagement() {
    if (hubWeeklyReportsState.level !== 'classes') return;
    if (hubWeeklyReportsState.viewMode !== 'list' && hubWeeklyReportsState.viewMode !== 'board') return;
    const rows = Array.isArray(hubWeeklyReportsState.classRows) ? hubWeeklyReportsState.classRows : [];
    if (!rows.length) return;

    const snapshot = weeklyReportsEngagementSnapshotKey();
    if (
      hubWeeklyReportsState.teacherEngagementSnapshot === snapshot
      && hubWeeklyReportsState.classEngagementSnapshot === snapshot
      && Object.keys(hubWeeklyReportsState.teacherEngagement || {}).length
      && !Object.values(hubWeeklyReportsState.teacherEngagement).some(function (row) { return row && row.loading; })
      && weeklyReportsClassEngagementReadyForRows(rows, snapshot)
    ) {
      return;
    }

    const token = ++hubWeeklyReportsEngagementToken;
    const groups = groupWeeklyReportsClassesByTeacher(rows);
    const queue = groups.map(function (group) {
      const classes = Array.isArray(group.classes) ? group.classes : [];
      return {
        groupKey: weeklyReportsTeacherGroupKey(group),
        classIds: classes.map(function (row) { return String(row.classId || '').trim(); }).filter(Boolean)
      };
    }).filter(function (item) { return item.classIds.length; });

    hubWeeklyReportsState.teacherEngagement = {};
    hubWeeklyReportsState.classEngagement = {};
    hubWeeklyReportsState.teacherEngagementSnapshot = snapshot;
    hubWeeklyReportsState.classEngagementSnapshot = snapshot;
    queue.forEach(function (item) {
      hubWeeklyReportsState.teacherEngagement[item.groupKey] = { loading: true, snapshot: snapshot };
      item.classIds.forEach(function (classId) {
        hubWeeklyReportsState.classEngagement[classId] = { loading: true, snapshot: snapshot };
      });
    });
    updateWeeklyReportsEngagementRings();

    let cursor = 0;
    const concurrency = 2;

    async function fetchGroupEngagement(item) {
      if (token !== hubWeeklyReportsEngagementToken) return;
      const params = new URLSearchParams();
      params.set('classIds', item.classIds.join(','));
      snapHubWeeklyReportsDateInputs();
      const filterValues = {
        startDate: hubInputValue('hubWeeklyReportsStartDate'),
        endDate: hubInputValue('hubWeeklyReportsEndDate'),
        departmentId: hubInputValue('hubWeeklyReportsDepartmentId'),
        programId: hubInputValue('hubWeeklyReportsProgramId'),
        teacherPersonId: hubInputValue('hubWeeklyReportsTeacherId')
      };
      Object.keys(filterValues).forEach(function (key) {
        if (filterValues[key]) params.set(key, filterValues[key]);
      });
      try {
        const response = await fetch('/school/report-hub/api/workspace/weekly-reports/engagement?' + params.toString(), {
          credentials: 'same-origin',
          headers: { Accept: 'application/json' }
        });
        const payload = await response.json();
        if (token !== hubWeeklyReportsEngagementToken) return;
        if (!response.ok || payload.status === 'error') {
          throw new Error(payload.message || 'Unable to load engagement.');
        }
        hubWeeklyReportsState.teacherEngagement[item.groupKey] = {
          loading: false,
          percent: payload.percent,
          presentMinutes: payload.presentMinutes,
          scheduledMinutes: payload.scheduledMinutes,
          snapshot: snapshot
        };
        const classBreakdown = Array.isArray(payload.classes) ? payload.classes : [];
        classBreakdown.forEach(function (classRow) {
          const classId = String(classRow.classId || '').trim();
          if (!classId) return;
          hubWeeklyReportsState.classEngagement[classId] = {
            loading: false,
            percent: classRow.percent,
            presentMinutes: classRow.presentMinutes,
            scheduledMinutes: classRow.scheduledMinutes,
            snapshot: snapshot
          };
        });
        item.classIds.forEach(function (classId) {
          if (hubWeeklyReportsState.classEngagement[classId] && !hubWeeklyReportsState.classEngagement[classId].loading) return;
          hubWeeklyReportsState.classEngagement[classId] = {
            loading: false,
            percent: null,
            presentMinutes: 0,
            scheduledMinutes: 0,
            snapshot: snapshot
          };
        });
      } catch (error) {
        if (token !== hubWeeklyReportsEngagementToken) return;
        hubWeeklyReportsState.teacherEngagement[item.groupKey] = {
          loading: false,
          error: true,
          message: error.message || 'Error',
          snapshot: snapshot
        };
        item.classIds.forEach(function (classId) {
          hubWeeklyReportsState.classEngagement[classId] = {
            loading: false,
            error: true,
            message: error.message || 'Error',
            snapshot: snapshot
          };
        });
      }
      updateWeeklyReportsEngagementRings();
    }

    async function worker() {
      while (cursor < queue.length) {
        const index = cursor;
        cursor += 1;
        await fetchGroupEngagement(queue[index]);
      }
    }

    const workers = [];
    for (let i = 0; i < Math.min(concurrency, queue.length); i++) {
      workers.push(worker());
    }
    await Promise.all(workers);
  }

