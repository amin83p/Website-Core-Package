  function appendSessionIssueWorkspaceQuery(requestQuery) {
    const values = {
      startDate: hubInputValue('hubSessionIssueStartDate'),
      endDate: hubInputValue('hubSessionIssueEndDate'),
      severity: hubInputValue('hubSessionIssueSeverity'),
      category: hubInputValue('hubSessionIssueCategory'),
      statusGroup: hubInputValue('hubSessionIssueStatusGroup'),
      classId: hubInputValue('hubSessionIssueClassId'),
      teacherPersonId: hubInputValue('hubSessionIssueTeacherId'),
      studentPersonId: hubInputValue('hubSessionIssueStudentId')
    };
    Object.keys(values).forEach(function (key) {
      if (values[key]) requestQuery.set(key, values[key]);
    });
  }

  function setHubSessionIssueDateRange(range) {
    const startEl = document.getElementById('hubSessionIssueStartDate');
    const endEl = document.getElementById('hubSessionIssueEndDate');
    if (!startEl || !endEl) return;
    const today = hubTodayDate();
    let start = new Date(today);
    let end = new Date(today);

    if (range === 'allTime') {
      startEl.value = '';
      endEl.value = '';
      loadWorkspaceSection('session-issues');
      return;
    }
    if (range === 'thisWeek') {
      const day = today.getDay() || 7;
      start.setDate(today.getDate() - (day - 1));
      end = new Date(start);
      end.setDate(start.getDate() + 6);
    } else if (range === 'last7') {
      start.setDate(today.getDate() - 6);
    } else if (range === 'thisMonth') {
      start = new Date(today.getFullYear(), today.getMonth(), 1);
      end = new Date(today.getFullYear(), today.getMonth() + 1, 0);
    }
    startEl.value = hubDateToIso(start);
    endEl.value = hubDateToIso(end);
    loadWorkspaceSection('session-issues');
  }

  function openHubSessionIssueTeacherPicker() {
    if (!window.GenericPicker || !window.GenericPickerPresets) {
      showHubMessage({ title: 'Teacher Picker', icon: 'warning', message: 'Teacher picker is not available yet.' });
      return;
    }
    window.GenericPicker.open(window.GenericPickerPresets.teacher({
      title: 'Filter Session Issues by Teachers',
      placeholder: 'Search teachers, select one or more...',
      multiselect: true,
      context: window.GenericPickerContexts
        ? window.GenericPickerContexts.activeOrganizationScope({ label: 'Active Organization' })
        : undefined,
      onSelect: function (items) {
        (Array.isArray(items) ? items : [items]).forEach(function (item) {
          const id = resolveHubTeacherId(item);
          const name = formatHubTeacherName(item, id);
          if (id && !hubSessionIssueTeacherSelections.some(function (row) { return row.id === id; })) {
            hubSessionIssueTeacherSelections.push({ id, name });
          }
        });
        syncSessionIssueInputs();
        loadWorkspaceSection('session-issues');
      }
    }));
  }

  function resolveHubPersonRecordId(item) {
    return String(item?.personId || item?.id || item?._id || '').trim();
  }

  function formatHubPersonRecordName(item, fallbackId) {
    const direct = String(item?.displayName || item?.fullName || item?.label || item?.personName || item?.name || '').trim();
    if (direct && direct !== '[object Object]') return direct;
    const objectName = item?.name && typeof item.name === 'object' ? item.name : null;
    if (objectName) {
      const fromObject = [objectName.first, objectName.middle, objectName.last]
        .map(function (part) { return String(part || '').trim(); })
        .filter(Boolean)
        .join(' ');
      if (fromObject) return fromObject;
    }
    const fromParts = [item?.firstName, item?.middleName, item?.lastName]
      .map(function (part) { return String(part || '').trim(); })
      .filter(Boolean)
      .join(' ');
    return fromParts || String(fallbackId || '').trim();
  }

