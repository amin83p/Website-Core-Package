  function applyWeeklyReportsPayloadToState(payload, opts) {
    const options = opts || {};
    const view = String(payload.view || options.view || 'classes');
    cacheWeeklyReportsDepartmentOptions(payload);
    if (view === 'students') {
      hubWeeklyReportsState.level = 'students';
      hubWeeklyReportsState.rows = Array.isArray(payload.rows) ? payload.rows : [];
      hubWeeklyReportsState.studentClassContext = payload.classContext && typeof payload.classContext === 'object'
        ? payload.classContext
        : { showAcfColumn: false };
      hubWeeklyReportsState.selectedClassId = String(options.classId || hubWeeklyReportsState.selectedClassId || '');
      hubWeeklyReportsState.selectedClassName = String(options.className || hubWeeklyReportsState.selectedClassName || '');
      hubWeeklyReportsState.viewMode = 'list';
      hubWeeklyReportsState.studentDetailId = '';
      hubWeeklyReportsState.studentDetailName = '';
    } else {
      hubWeeklyReportsState.level = 'classes';
      hubWeeklyReportsState.classRows = Array.isArray(payload.rows) ? payload.rows : [];
      hubWeeklyReportsState.selectedClassId = '';
      hubWeeklyReportsState.selectedClassName = '';
      hubWeeklyReportsState.rows = [];
      hubWeeklyReportsState.studentClassContext = { showAcfColumn: false };
      hubWeeklyReportsState.studentDetailId = '';
      hubWeeklyReportsState.studentDetailName = '';
      hubWeeklyReportsState.viewMode = 'list';
    }
    hubWeeklyReportsState.lastLoadedAt = payload.refreshedAt || new Date().toISOString();
    const serverPrepareMs = Number(payload.preparedInMs);
    if (Number.isFinite(serverPrepareMs) && serverPrepareMs >= 0) {
      hubWeeklyReportsState.lastPrepareDurationMs = Math.round(serverPrepareMs);
    }
    hubWeeklyReportsState.lastRangeLabel = formatWeeklyReportsRangeLabel();
    hubWeeklyReportsState.lastError = '';
  }

  function openWeeklyReportsClassBoardTab() {
    const filtersSnapshot = captureWeeklyReportsFiltersSnapshot();
    const requestKey = buildWeeklyReportsBoardRequestKey(filtersSnapshot) + '|' + String(Date.now());
    const tab = createWeeklyReportsTab({
      label: buildWeeklyReportsTabLabel('classes', filtersSnapshot),
      type: 'classes',
      requestKey: requestKey,
      filtersSnapshot: filtersSnapshot,
      loaded: false
    });
    activateWeeklyReportsTab(tab.id, { skipPersist: true });
    return loadWeeklyReportsWorkspace({ view: 'classes', tabId: tab.id });
  }

  function openWeeklyReportsStudentTab(classId, className, parentTabId) {
    const filtersSnapshot = captureWeeklyReportsFiltersSnapshot();
    const normalizedClassId = String(classId || '').trim();
    const normalizedClassName = String(className || classId || '').trim();
    const normalizedParentTabId = String(parentTabId || hubWeeklyReportsActiveTabId || '').trim();
    const requestKey = buildWeeklyReportsStudentRequestKey(normalizedParentTabId, normalizedClassId, filtersSnapshot);
    const existing = findWeeklyReportsTabByRequestKey(requestKey);
    if (existing) {
      activateWeeklyReportsTab(existing.id);
      return Promise.resolve();
    }
    const tab = createWeeklyReportsTab({
      label: buildWeeklyReportsTabLabel('students', filtersSnapshot, normalizedClassName),
      type: 'students',
      parentTabId: normalizedParentTabId,
      requestKey: requestKey,
      classId: normalizedClassId,
      className: normalizedClassName,
      filtersSnapshot: filtersSnapshot,
      loaded: false
    });
    activateWeeklyReportsTab(tab.id, { skipPersist: true });
    return loadWeeklyReportsWorkspace({
      view: 'students',
      tabId: tab.id,
      classId: normalizedClassId,
      className: normalizedClassName
    });
  }

  function drillIntoWeeklyReportsClass(classId, className) {
    persistActiveWeeklyReportsTab();
    const parentTabId = hubWeeklyReportsActiveTabId;
    openWeeklyReportsStudentTab(classId, className, parentTabId);
  }

  async function loadWeeklyReportsWorkspace(options) {
    const opts = options || {};
    const tab = opts.tabId
      ? hubWeeklyReportsTabs.find(function (row) { return row.id === opts.tabId; })
      : getActiveWeeklyReportsTab();
    if (!tab) return;
    if (tab.loaded && !opts.forceReload) {
      activateWeeklyReportsTab(tab.id, { skipPersist: true });
      return;
    }
    if (hubWeeklyReportsState.loading) return;
    hubWeeklyReportsState.loading = true;
    hubWeeklyReportsState.lastError = '';
    if (opts.view !== 'students') {
      hubWeeklyReportsEngagementToken += 1;
      hubWeeklyReportsState.teacherEngagement = {};
      hubWeeklyReportsState.teacherEngagementSnapshot = '';
      hubWeeklyReportsState.classEngagement = {};
      hubWeeklyReportsState.classEngagementSnapshot = '';
    }
    renderWeeklyReportsResultsPanel();

    const applyBtn = document.getElementById('hubWeeklyReportsFilterApply');
    const originalHtml = applyBtn ? applyBtn.innerHTML : '';
    if (applyBtn) {
      applyBtn.disabled = true;
      applyBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Loading';
    }
    const loadingMessage = opts.view === 'students' ? 'Loading students...' : 'Loading classes...';
    if (typeof window.showLoading === 'function') window.showLoading(loadingMessage);

    const clientLoadStartedAt = (typeof performance !== 'undefined' && performance.now)
      ? performance.now()
      : Date.now();
    try {
      const requestQuery = new URLSearchParams();
      appendWeeklyReportsWorkspaceQuery(requestQuery, opts);
      const response = await fetch('/school/report-hub/api/workspace/weekly-reports?' + requestQuery.toString(), {
        headers: { Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        credentials: 'same-origin'
      });
      const payload = await response.json().catch(function () {
        return { status: 'error', message: 'Unable to load weekly reports.' };
      });
      if (!response.ok || payload.status !== 'success') {
        throw new Error(payload.message || 'Unable to load weekly reports.');
      }
      const clientFetchMs = (typeof performance !== 'undefined' && performance.now)
        ? Math.round(performance.now() - clientLoadStartedAt)
        : Math.round(Date.now() - clientLoadStartedAt);
      applyWeeklyReportsPayloadToState(payload, opts);
      if (!hubWeeklyReportsState.lastPrepareDurationMs) {
        hubWeeklyReportsState.lastPrepareDurationMs = clientFetchMs;
      }
      applyWeeklyReportsPendingShareView();
      tab.loaded = true;
      tab.filtersSnapshot = captureWeeklyReportsFiltersSnapshot();
      tab.viewState = captureWeeklyReportsViewState();
    } catch (error) {
      hubWeeklyReportsState.lastError = error.message || 'Unable to load weekly reports.';
      if (opts.view === 'students') {
        hubWeeklyReportsState.rows = [];
      } else {
        hubWeeklyReportsState.classRows = [];
        hubWeeklyReportsState.level = 'classes';
        hubWeeklyReportsState.selectedClassId = '';
        hubWeeklyReportsState.selectedClassName = '';
      }
      tab.loaded = false;
      tab.viewState = captureWeeklyReportsViewState();
    } finally {
      hubWeeklyReportsState.loading = false;
      if (typeof window.hideLoading === 'function') window.hideLoading({ force: true });
      if (applyBtn) {
        applyBtn.disabled = false;
        applyBtn.innerHTML = originalHtml;
      }
      renderWeeklyReportsTabBar();
      renderWeeklyReportsResultsPanel();
      if (weeklyReportsShouldScheduleTeacherEngagement()) {
        scheduleWeeklyReportsTeacherEngagement();
      }
      syncWeeklyReportsShareUrl();
    }
  }

  async function loadWeeklyReportsClasses() {
    return openWeeklyReportsClassBoardTab();
  }

  async function loadWeeklyReportsStudents(options) {
    const opts = options || {};
    const classId = String(opts.classId || hubWeeklyReportsState.selectedClassId || '').trim();
    const className = String(opts.className || hubWeeklyReportsState.selectedClassName || classId).trim();
    const parentTabId = opts.parentTabId || hubWeeklyReportsActiveTabId;
    return openWeeklyReportsStudentTab(classId, className, parentTabId);
  }

