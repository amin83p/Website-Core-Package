  function ensureStudentProgressPrintRootElement() {
    let root = document.getElementById('hubStudentProgressPrintRoot');
    if (root) return root;
    root = document.createElement('div');
    root.id = 'hubStudentProgressPrintRoot';
    root.className = 'hub-sp-print-root';
    root.setAttribute('aria-hidden', 'true');
    document.body.appendChild(root);
    return root;
  }

  async function runStudentProgressPrintJob(renderPrintHtml) {
    const root = ensureStudentProgressPrintRootElement();
    root.innerHTML = renderPrintHtml();
    root.setAttribute('aria-hidden', 'false');
    const cleanup = function () {
      document.body.classList.remove('hub-print-student-progress');
      root.innerHTML = '';
      root.setAttribute('aria-hidden', 'true');
    };
    if (typeof window.hideLoading === 'function') {
      window.hideLoading({ force: true });
    }
    document.body.classList.add('hub-print-student-progress');
    if (typeof window.scrollTo === 'function') {
      window.scrollTo(0, 0);
    }
    await new Promise(function (resolve) {
      if (typeof window.requestAnimationFrame === 'function') {
        window.requestAnimationFrame(function () {
          window.requestAnimationFrame(resolve);
        });
      } else {
        window.setTimeout(resolve, 0);
      }
    });
    window.addEventListener('afterprint', cleanup, { once: true });
    window.print();
    window.setTimeout(cleanup, 1500);
  }

