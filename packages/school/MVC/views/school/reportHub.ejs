      '<i class="bi bi-calendar-week display-6 d-block mb-3"></i>',
      '<div class="fw-semibold">' + escapeHtml(message || 'No results to display yet.') + '</div>',
      '<div class="text-muted small mt-1">' + escapeHtml(hint || 'Choose filters and click Apply, or use a quick report shortcut below.') + '</div>',
      '</div></div>'
    ].join('');
