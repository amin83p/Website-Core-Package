      '<div class="hub-wr-print-class-block mb-3">',
      '<div class="hub-wr-print-student-section-title mb-2">', escapeHtml(classBlock.className || classBlock.classId || 'Class'), '</div>',
      '<div class="d-flex align-items-center gap-3 mb-2">',
      '<div class="small text-muted">Period punctuality</div>',
      renderWeeklyReportsPunctualityCell(readWeeklyReportsStudentPunctuality(classBlock), { compact: true, showLabel: true }),
      '</div>',
      '<div class="hub-table-wrap">',
      '<table class="table align-middle hub-wr-print-metrics-table mb-0">',
      '<thead><tr>',
      '<th class="ps-2">Week</th>',
      '<th class="text-center">Punctuality</th>',
      '<th class="text-center">Trend</th>',
      '<th class="text-center">Engagement</th>',
      '<th class="text-center">Sessions</th>',
      '<th class="text-center">Present</th>',
      '<th class="text-center">Late</th>',
      '<th class="text-center">Early</th>',
      '<th class="text-center">Absent</th>',
      acfHeader,
      '<th class="text-center">Cases</th>',
      '</tr></thead>',
      '<tbody>', body, '</tbody>',
      '</table>',
      '</div>',
