  function ensureWeeklyReportsClassTipElement() {
    if (hubWeeklyReportsClassTipEl && document.body.contains(hubWeeklyReportsClassTipEl)) {
      return hubWeeklyReportsClassTipEl;
    }
    hubWeeklyReportsClassTipEl = document.getElementById('hubWeeklyReportsClassTip');
    if (!hubWeeklyReportsClassTipEl) {
      hubWeeklyReportsClassTipEl = document.createElement('div');
      hubWeeklyReportsClassTipEl.id = 'hubWeeklyReportsClassTip';
      hubWeeklyReportsClassTipEl.className = 'hub-schedule-tip';
      hubWeeklyReportsClassTipEl.setAttribute('role', 'tooltip');
      hubWeeklyReportsClassTipEl.hidden = true;
      document.body.appendChild(hubWeeklyReportsClassTipEl);
    }
    return hubWeeklyReportsClassTipEl;
  }

  function hideWeeklyReportsClassTip() {
    if (activeWeeklyReportsClassTipTrigger) {
      activeWeeklyReportsClassTipTrigger.removeAttribute('aria-describedby');
    }
    activeWeeklyReportsClassTipTrigger = null;
    if (!hubWeeklyReportsClassTipEl) return;
    hubWeeklyReportsClassTipEl.classList.remove('is-visible', 'is-below');
    hubWeeklyReportsClassTipEl.hidden = true;
  }

  function showWeeklyReportsClassTip(trigger) {
    const label = String(
      trigger?.getAttribute('data-tip') || trigger?.getAttribute('data-hub-schedule-tip') || ''
    ).trim();
    if (!label) {
      hideWeeklyReportsClassTip();
      return;
    }
    const tip = ensureWeeklyReportsClassTipElement();
    if (activeWeeklyReportsClassTipTrigger && activeWeeklyReportsClassTipTrigger !== trigger) {
      activeWeeklyReportsClassTipTrigger.removeAttribute('aria-describedby');
    }
    activeWeeklyReportsClassTipTrigger = trigger;
    trigger.setAttribute('aria-describedby', tip.id);
    const tipBg = trigger.getAttribute('data-tip-bg') || '#0f172a';
    const tipFg = trigger.getAttribute('data-tip-fg') || '#ffffff';
    const tipBorder = trigger.getAttribute('data-tip-border') || tipBg;
    const parts = (label.includes('\n') ? label.split('\n') : label.split(' | ')).map(function (part) {
      return String(part || '').trim();
    }).filter(Boolean);
    tip.innerHTML = parts.map(function (part, index) {
      const isDate = /^Date:/i.test(part);
      return '<span class="sch-tip-line' + (index > 0 ? ' sch-tip-sub' : '') + (isDate ? ' sch-tip-date' : '') + '">' + escapeHtml(part) + '</span>';
    }).join('');
    tip.style.background = tipBg;
    tip.style.color = tipFg;
    tip.style.borderColor = tipBorder;
    tip.style.setProperty('--sch-tip-arrow', tipBg);
    tip.hidden = false;
    tip.removeAttribute('hidden');
    tip.classList.remove('is-below');
    const rect = trigger.getBoundingClientRect();
    let left = rect.left + (rect.width / 2);
    const tipWidth = tip.offsetWidth || 160;
    const tipHeight = tip.offsetHeight || 80;
    const pad = 10;
    left = Math.max(pad + tipWidth / 2, Math.min(left, window.innerWidth - pad - tipWidth / 2));
    tip.style.left = left + 'px';
    if ((rect.top - tipHeight - 14) < pad) {
      tip.classList.add('is-below');
      tip.style.top = Math.min(window.innerHeight - pad - tipHeight, rect.bottom) + 'px';
    } else {
      tip.style.top = rect.top + 'px';
    }
    tip.classList.add('is-visible');
  }

  function readWeeklyReportsClassColumnWidthPx() {
    try {
      const stored = Number(localStorage.getItem(HUB_WR_CLASS_COL_WIDTH_STORAGE_KEY));
      if (Number.isFinite(stored) && stored >= HUB_WR_CLASS_COL_MIN_PX && stored <= HUB_WR_CLASS_COL_MAX_PX) {
        return Math.round(stored);
      }
    } catch (error) {
      /* ignore storage errors */
    }
    return HUB_WR_CLASS_COL_DEFAULT_PX;
  }

  function clampWeeklyReportsClassColumnWidthPx(widthPx) {
    const value = Number(widthPx);
    if (!Number.isFinite(value)) return HUB_WR_CLASS_COL_DEFAULT_PX;
    return Math.max(HUB_WR_CLASS_COL_MIN_PX, Math.min(HUB_WR_CLASS_COL_MAX_PX, Math.round(value)));
  }

  function applyWeeklyReportsClassColumnWidth(table, widthPx) {
    if (!table) return;
    const width = clampWeeklyReportsClassColumnWidthPx(widthPx);
    table.style.setProperty('--hub-wr-class-col-width', width + 'px');
    return width;
  }

  function persistWeeklyReportsClassColumnWidth(widthPx) {
    const width = clampWeeklyReportsClassColumnWidthPx(widthPx);
    try {
      localStorage.setItem(HUB_WR_CLASS_COL_WIDTH_STORAGE_KEY, String(width));
    } catch (error) {
      /* ignore storage errors */
    }
    return width;
  }

  function initWeeklyReportsClassColumnWidth(table) {
    if (!table) return;
    applyWeeklyReportsClassColumnWidth(table, readWeeklyReportsClassColumnWidthPx());
  }

  function bindWeeklyReportsClassColumnResize(container) {
    if (!container || container.dataset.hubWrClassColResizeBound === '1') return;
    container.dataset.hubWrClassColResizeBound = '1';
    container.addEventListener('mousedown', function (event) {
      const handle = event.target && event.target.closest('[data-hub-wr-resize-class-col]');
      if (!handle || !container.contains(handle)) return;
      event.preventDefault();
      event.stopPropagation();
      const table = handle.closest('.hub-weekly-reports-data-table');
      const headerCell = handle.closest('th.hub-wr-col-class');
      if (!table || !headerCell) return;
      const startX = event.clientX;
      const startWidth = headerCell.offsetWidth || readWeeklyReportsClassColumnWidthPx();
      document.body.classList.add('hub-wr-class-col-resizing');
      handle.classList.add('is-dragging');
      const onMove = function (moveEvent) {
        applyWeeklyReportsClassColumnWidth(table, startWidth + (moveEvent.clientX - startX));
      };
      const onUp = function () {
        handle.classList.remove('is-dragging');
        document.body.classList.remove('hub-wr-class-col-resizing');
        document.removeEventListener('mousemove', onMove);
        document.removeEventListener('mouseup', onUp);
        const computed = getComputedStyle(table).getPropertyValue('--hub-wr-class-col-width').trim();
        const parsed = parseFloat(computed);
        if (Number.isFinite(parsed)) persistWeeklyReportsClassColumnWidth(parsed);
      };
      document.addEventListener('mousemove', onMove);
      document.addEventListener('mouseup', onUp);
    });
    container.querySelectorAll('.hub-weekly-reports-data-table').forEach(initWeeklyReportsClassColumnWidth);
  }

  function bindWeeklyReportsClassColumnTooltips(container) {
    if (!container || container.dataset.hubWrClassTooltipsBound === '1') return;
    container.dataset.hubWrClassTooltipsBound = '1';
    container.addEventListener('pointerover', function (event) {
      const trigger = event.target && event.target.closest('[data-hub-wr-class-tip]');
      if (!trigger || !container.contains(trigger)) return;
      showWeeklyReportsClassTip(trigger);
    });
    container.addEventListener('pointerout', function (event) {
      const trigger = event.target && event.target.closest('[data-hub-wr-class-tip]');
      if (!trigger) return;
      const next = event.relatedTarget;
      if (next && trigger.contains(next)) return;
      hideWeeklyReportsClassTip();
    });
    container.addEventListener('focusin', function (event) {
      const trigger = event.target && event.target.closest('[data-hub-wr-class-tip]');
      if (trigger) showWeeklyReportsClassTip(trigger);
    });
    container.addEventListener('focusout', function (event) {
      const trigger = event.target && event.target.closest('[data-hub-wr-class-tip]');
      if (!trigger) return;
      const next = event.relatedTarget;
      if (next && trigger.contains(next)) return;
      hideWeeklyReportsClassTip();
    });
    if (!hubWeeklyReportsClassTipWindowEventsBound) {
      hubWeeklyReportsClassTipWindowEventsBound = true;
      window.addEventListener('scroll', hideWeeklyReportsClassTip, true);
      window.addEventListener('resize', hideWeeklyReportsClassTip);
    }
  }

  function renderWeeklyReportsClassList(rows) {
    const groups = groupWeeklyReportsClassesByTeacher(rows);
    if (!groups.length) {
      return renderWeeklyReportsEmptyState('No classes found.', weeklyReportsNoResultsHint());
