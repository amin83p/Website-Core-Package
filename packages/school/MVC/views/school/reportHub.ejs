  function weeklyReportsStackPeekIndices(activeIndex, classCount) {
    if (classCount <= 1) return [];
    const indices = [];
    const next = (activeIndex + 1) % classCount;
    indices.push(next);
    if (classCount > 2) {
      indices.push((activeIndex + 2) % classCount);
    }
    return indices;
  }

