    const state = getWeeklyReportsShareStateFromUi({ skipPersist: true });
    if (!state) return;
    const nextUrl = api.buildShareUrl(window.location.origin, window.location.pathname, state);
    const nextPath = nextUrl.replace(window.location.origin, '');
    const currentPath = window.location.pathname + window.location.search;
    if (currentPath === nextPath) return;
    window.history.replaceState(null, '', nextPath);
  }

  function clearWeeklyReportsShareUrl() {
    if (!window.location.search) return;
    window.history.replaceState(null, '', window.location.pathname);
  }

  async function copyWeeklyReportsShareLink() {
    const state = getWeeklyReportsShareStateFromUi();
    if (!state) {
      void showHubMessage({ title: 'Share link', icon: 'warning', message: 'Unable to build share link.' });
      return;
    }
    const url = buildWeeklyReportsHubShareUrlFromState(state);
    try {
      if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
        await navigator.clipboard.writeText(url);
      } else {
        window.prompt('Copy this link:', url);
      }
      void showHubMessage({ title: 'Link copied', icon: 'success', message: 'Report link copied to clipboard.' });
    } catch (error) {
      window.prompt('Copy this link:', url);
      void showHubMessage({ title: 'Link copied', icon: 'info', message: 'Copy the link from the prompt if needed.' });
    }
  }

  function weeklyReportsEngagementStillLoadingForPrint() {
    const rows = Array.isArray(hubWeeklyReportsState.classRows) ? hubWeeklyReportsState.classRows : [];
    if (!rows.length) return false;
    const snapshot = weeklyReportsEngagementSnapshotKey();
    const teacherEng = hubWeeklyReportsState.teacherEngagement || {};
    if (Object.values(teacherEng).some(function (entry) { return entry && entry.loading; })) {
      return true;
    }
    return !weeklyReportsClassEngagementReadyForRows(rows, snapshot);
  }

  function setWeeklyReportsPrintButtonsBusy(busy) {
    document.querySelectorAll('[data-hub-weekly-reports-print]').forEach(function (button) {
      if (busy) {
        if (!button.dataset.hubWrPrintOriginalHtml) {
          button.dataset.hubWrPrintOriginalHtml = button.innerHTML;
        }
        button.disabled = true;
        button.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Preparing…';
      } else {
        button.disabled = false;
        if (button.dataset.hubWrPrintOriginalHtml) {
          button.innerHTML = button.dataset.hubWrPrintOriginalHtml;
          delete button.dataset.hubWrPrintOriginalHtml;
        }
      }
    });
  }

  async function ensureWeeklyReportsEngagementForPrint(timeoutMs) {
    if (!weeklyReportsShouldScheduleTeacherEngagement()) return false;
    if (!weeklyReportsEngagementStillLoadingForPrint()) return false;
    scheduleWeeklyReportsTeacherEngagement();
    const waitMs = Math.max(1000, Number(timeoutMs) || 15000);
    const started = Date.now();
    while (Date.now() - started < waitMs) {
      if (!weeklyReportsEngagementStillLoadingForPrint()) return true;
      await new Promise(function (resolve) { window.setTimeout(resolve, 120); });
    }
    return !weeklyReportsEngagementStillLoadingForPrint();
  }

