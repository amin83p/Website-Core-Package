    if (teacherNameEl) teacherNameEl.value = hubReportInstanceTeacherSelections.map(function (item) { return item.name || item.id; }).join(', ');
    if (studentIdEl) studentIdEl.value = hubReportInstanceStudentSelections.map(function (item) { return item.id; }).filter(Boolean).join(',');
    if (studentNameEl) studentNameEl.value = hubReportInstanceStudentSelections.map(function (item) { return item.name || item.id; }).join(', ');
