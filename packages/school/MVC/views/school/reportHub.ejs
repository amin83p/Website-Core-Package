        '<thead class="table-light"><tr><th class="ps-3">Session</th><th>Student / details</th><th>Status</th><th class="pe-3 text-end">Action</th></tr></thead>',
        '<tbody>', body, '</tbody></table></div>'
      ].join('');
    }
    const summary = '<div class="hub-weekly-reports-drilldown-summary">' + escapeHtml(String(rows.length)) + ' session' + (rows.length === 1 ? '' : 's') + '</div>';
    const body = rows.map(function (row) {
