  function setHubStudentProgressRange(range) {
    const startEl = document.getElementById('hubStudentProgressStartDate');
    const endEl = document.getElementById('hubStudentProgressEndDate');
    if (!startEl || !endEl) return;

    const today = hubTodayDate();
    const startOfDay = new Date(today.getFullYear(), today.getMonth(), today.getDate());
    let start;
    let end = hubSnapToWeekEnd(startOfDay);

    if (range === 'thisWeek') {
      start = hubSnapToWeekStart(startOfDay);
    } else if (range === 'lastFourWeeks') {
      start = hubSnapToWeekStart(startOfDay);
      start.setDate(start.getDate() - 21);
    } else if (range === 'lastThreeMonths') {
      const anchor = new Date(startOfDay);
      anchor.setMonth(anchor.getMonth() - 3);
      start = hubSnapToWeekStart(anchor);
    } else if (range === 'wholeYear') {
      const year = parseInt(hubOrgYear(), 10) || startOfDay.getFullYear();
      start = hubSnapToWeekStart(new Date(year, 0, 1));
      end = hubSnapToWeekEnd(new Date(year, 11, 31));
    } else {
      return;
    }

    startEl.value = hubDateToIso(start);
    endEl.value = hubDateToIso(end);
  }

  function snapHubStudentProgressDateInputs() {
    const startEl = document.getElementById('hubStudentProgressStartDate');
    const endEl = document.getElementById('hubStudentProgressEndDate');
    if (!startEl || !endEl) return;

    if (startEl.value) {
      const startDate = hubParseDateInputValue(startEl.value);
      if (startDate) startEl.value = hubDateToIso(hubSnapToWeekStart(startDate));
    }
    if (endEl.value) {
      const endDate = hubParseDateInputValue(endEl.value);
      if (endDate) endEl.value = hubDateToIso(hubSnapToWeekEnd(endDate));
    }
    if (startEl.value && endEl.value && endEl.value < startEl.value) {
      const startDate = hubParseDateInputValue(startEl.value);
      if (startDate) endEl.value = hubDateToIso(hubSnapToWeekEnd(startDate));
    }
  }

