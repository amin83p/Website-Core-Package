  function getActiveWeeklyReportsTab() {
    return hubWeeklyReportsTabs.find(function (tab) { return tab.id === hubWeeklyReportsActiveTabId; }) || null;
  }

  function persistActiveWeeklyReportsTab() {
    const tab = getActiveWeeklyReportsTab();
    if (!tab) return;
    tab.filtersSnapshot = captureWeeklyReportsFiltersSnapshot();
    tab.viewState = captureWeeklyReportsViewState();
  }

  function nextWeeklyReportsTabId() {
    hubWeeklyReportsTabSeq += 1;
    return 'wr-tab-' + String(hubWeeklyReportsTabSeq);
  }

  function resolveWeeklyReportsDepartmentName(departmentId) {
    const normalizedId = String(departmentId || '').trim();
    if (!normalizedId) return 'All departments';
    const match = hubWeeklyReportsDepartmentOptions.find(function (row) { return row.id === normalizedId; });
    return match ? (match.name || normalizedId) : normalizedId;
  }

  function hashWeeklyReportsDepartmentColorSeed(value) {
    const raw = String(value || '').trim() || '__none__';
    let hash = 0;
    for (let i = 0; i < raw.length; i += 1) {
      hash = ((hash << 5) - hash) + raw.charCodeAt(i);
      hash |= 0;
    }
    return Math.abs(hash);
  }

  function resolveWeeklyReportsDepartmentColor(departmentId) {
    const palette = HUB_WEEKLY_REPORTS_DEPARTMENT_COLORS;
    const index = hashWeeklyReportsDepartmentColorSeed(departmentId) % palette.length;
    return palette[index];
  }

  function hexToRgba(hex, alpha) {
    const normalized = String(hex || '').replace('#', '');
    if (normalized.length !== 6) return 'rgba(100, 116, 139, ' + String(alpha) + ')';
    const r = parseInt(normalized.slice(0, 2), 16);
    const g = parseInt(normalized.slice(2, 4), 16);
    const b = parseInt(normalized.slice(4, 6), 16);
    return 'rgba(' + String(r) + ', ' + String(g) + ', ' + String(b) + ', ' + String(alpha) + ')';
  }

  function buildWeeklyReportsClassTileStyle(departmentId) {
    const color = resolveWeeklyReportsDepartmentColor(departmentId);
    return [
      'border-left-color:' + color + ';',
      'background:linear-gradient(145deg, ' + hexToRgba(color, 0.14) + ', ' + hexToRgba(color, 0.06) + ');'
    ].join('');
  }

  const WEEKLY_REPORTS_BOARD_DECK_PALETTE = [
    { border: '#1d4ed8', bgStart: 'rgba(219, 234, 254, 0.95)', bgEnd: 'rgba(239, 246, 255, 0.98)', peek: '#bfdbfe' },
    { border: '#2563eb', bgStart: 'rgba(191, 219, 254, 0.92)', bgEnd: 'rgba(248, 250, 252, 0.98)', peek: '#93c5fd' },
    { border: '#0284c7', bgStart: 'rgba(186, 230, 253, 0.92)', bgEnd: 'rgba(240, 249, 255, 0.98)', peek: '#7dd3fc' },
    { border: '#059669', bgStart: 'rgba(209, 250, 229, 0.92)', bgEnd: 'rgba(236, 253, 245, 0.98)', peek: '#6ee7b7' },
    { border: '#10b981', bgStart: 'rgba(167, 243, 208, 0.9)', bgEnd: 'rgba(240, 253, 244, 0.98)', peek: '#34d399' },
    { border: '#047857', bgStart: 'rgba(153, 246, 228, 0.88)', bgEnd: 'rgba(236, 253, 245, 0.98)', peek: '#2dd4bf' }
  ];

  function weeklyReportsBoardDeckPaletteEntry(classIndex) {
    const list = WEEKLY_REPORTS_BOARD_DECK_PALETTE;
    const idx = Math.abs(Number(classIndex) || 0) % list.length;
    return list[idx];
  }

  function buildWeeklyReportsBoardDeckCardStyle(classIndex) {
    const entry = weeklyReportsBoardDeckPaletteEntry(classIndex);
    return [
      'border-left-color:', entry.border, ';',
      'background:linear-gradient(145deg, ', entry.bgStart, ', ', entry.bgEnd, ');'
    ].join('');
  }

  function buildWeeklyReportsBoardDeckPeekStyle(classIndex) {
    const entry = weeklyReportsBoardDeckPaletteEntry(classIndex);
    return [
      'border-left-color:', entry.border, ';',
      'background:', entry.peek, ';'
    ].join('');
  }

  function buildWeeklyReportsBoardRequestKey(filters) {
    const snapshot = filters || captureWeeklyReportsFiltersSnapshot();
    return [
      'classes',
      snapshot.startDate || '',
      snapshot.endDate || '',
      snapshot.departmentId || '',
      snapshot.programId || '',
      snapshot.teacherPersonId || '',
      (snapshot.classSelections || []).map(function (item) { return item.id; }).join(','),
      (snapshot.studentSelections || []).map(function (item) { return item.id; }).join(',')
    ].join('|');
  }

  function buildWeeklyReportsStudentRequestKey(parentTabId, classId, filters) {
    const snapshot = filters || captureWeeklyReportsFiltersSnapshot();
    return [
      'students',
      parentTabId || '',
      classId || '',
      snapshot.startDate || '',
      snapshot.endDate || '',
      snapshot.departmentId || '',
      snapshot.programId || '',
      snapshot.teacherPersonId || '',
      (snapshot.studentSelections || []).map(function (item) { return item.id; }).join(',')
    ].join('|');
  }

  function buildWeeklyReportsTabLabel(type, filters, className) {
    const snapshot = filters || captureWeeklyReportsFiltersSnapshot();
    const rangeLabel = snapshot.startDate && snapshot.endDate
      ? snapshot.startDate + ' to ' + snapshot.endDate
      : (snapshot.startDate || snapshot.endDate || 'All time');
    if (type === 'students') {
      return String(className || 'Class') + ' · ' + rangeLabel;
    }
    const departmentLabel = snapshot.departmentId
      ? resolveWeeklyReportsDepartmentName(snapshot.departmentId)
      : 'All depts';
    return rangeLabel + ' · ' + departmentLabel;
  }

  function findWeeklyReportsTabByRequestKey(requestKey) {
    return hubWeeklyReportsTabs.find(function (tab) { return tab.requestKey === requestKey; }) || null;
  }

  function createWeeklyReportsTab(options) {
    const opts = options || {};
    const tab = {
      id: opts.id || nextWeeklyReportsTabId(),
      label: String(opts.label || 'Weekly report'),
      type: opts.type === 'students' ? 'students' : 'classes',
      parentTabId: String(opts.parentTabId || ''),
      requestKey: String(opts.requestKey || ''),
      classId: String(opts.classId || ''),
      className: String(opts.className || ''),
      filtersSnapshot: opts.filtersSnapshot || captureWeeklyReportsFiltersSnapshot(),
      viewState: opts.viewState || createDefaultWeeklyReportsViewState(),
      loaded: opts.loaded === true
    };
    hubWeeklyReportsTabs.push(tab);
    return tab;
  }

  function activateWeeklyReportsTab(tabId, options) {
    const opts = options || {};
    if (!opts.skipPersist) persistActiveWeeklyReportsTab();
    const tab = hubWeeklyReportsTabs.find(function (row) { return row.id === tabId; });
    if (!tab) {
      hubWeeklyReportsActiveTabId = '';
      Object.assign(hubWeeklyReportsState, createDefaultWeeklyReportsViewState());
      renderWeeklyReportsTabBar();
      renderWeeklyReportsResultsPanel();
      return null;
    }
    hubWeeklyReportsActiveTabId = tab.id;
    restoreWeeklyReportsFiltersSnapshot(tab.filtersSnapshot);
    restoreWeeklyReportsViewState(tab.viewState);
    renderWeeklyReportsTabBar();
    renderWeeklyReportsResultsPanel();
    syncWeeklyReportsShareUrl();
    return tab;
  }

  function closeWeeklyReportsTab(tabId, options) {
    const opts = options || {};
    const closingId = String(tabId || '').trim();
    if (!closingId) return;
    const childIds = hubWeeklyReportsTabs
      .filter(function (tab) { return tab.parentTabId === closingId; })
      .map(function (tab) { return tab.id; });
    const removeIds = new Set([closingId].concat(childIds));
    hubWeeklyReportsTabs = hubWeeklyReportsTabs.filter(function (tab) { return !removeIds.has(tab.id); });
    if (opts.activateTabId && hubWeeklyReportsTabs.some(function (tab) { return tab.id === opts.activateTabId; })) {
      activateWeeklyReportsTab(opts.activateTabId, { skipPersist: true });
      return;
    }
    const wasActive = !hubWeeklyReportsActiveTabId || removeIds.has(hubWeeklyReportsActiveTabId);
    if (!wasActive) {
      renderWeeklyReportsTabBar();
      return;
    }
    const lastTab = hubWeeklyReportsTabs[hubWeeklyReportsTabs.length - 1] || null;
    if (lastTab) {
      activateWeeklyReportsTab(lastTab.id, { skipPersist: true });
      return;
    }
    hubWeeklyReportsActiveTabId = '';
    Object.assign(hubWeeklyReportsState, createDefaultWeeklyReportsViewState());
    renderWeeklyReportsTabBar();
    renderWeeklyReportsResultsPanel();
  }

  function renderWeeklyReportsTabBar() {
    const container = document.getElementById('hubWeeklyReportsTabBar');
    if (!container) return;
    if (!hubWeeklyReportsTabs.length) {
      container.innerHTML = '';
      container.classList.add('d-none');
      return;
    }
    container.classList.remove('d-none');
    container.innerHTML = hubWeeklyReportsTabs.map(function (tab) {
      const active = tab.id === hubWeeklyReportsActiveTabId;
      return [
        '<button type="button" class="btn btn-sm hub-weekly-reports-tab ' + (active ? 'btn-primary' : 'btn-outline-primary') + '" data-hub-weekly-reports-tab-id="' + escapeHtml(tab.id) + '">',
        '<span class="hub-weekly-reports-tab-label">' + escapeHtml(tab.label || 'Report') + '</span>',
        '<span class="hub-weekly-reports-tab-close" data-hub-weekly-reports-tab-close="' + escapeHtml(tab.id) + '" aria-label="Close tab">&times;</span>',
        '</button>'
      ].join('');
    }).join('');
    bindWeeklyReportsTabBarControls();
  }

  function bindWeeklyReportsTabBarControls() {
    const container = document.getElementById('hubWeeklyReportsTabBar');
    if (!container) return;
    container.querySelectorAll('[data-hub-weekly-reports-tab-id]').forEach(function (button) {
      button.addEventListener('click', function (event) {
        if (event.target && event.target.closest('[data-hub-weekly-reports-tab-close]')) return;
        const tabId = button.getAttribute('data-hub-weekly-reports-tab-id') || '';
        if (!tabId || tabId === hubWeeklyReportsActiveTabId) return;
        activateWeeklyReportsTab(tabId);
      });
    });
    container.querySelectorAll('[data-hub-weekly-reports-tab-close]').forEach(function (button) {
      button.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();
        closeWeeklyReportsTab(button.getAttribute('data-hub-weekly-reports-tab-close') || '');
      });
    });
  }

  function cacheWeeklyReportsFilterOptions(payload) {
    const departmentRows = payload && Array.isArray(payload.departmentOptions) ? payload.departmentOptions : [];
    if (departmentRows.length) {
      hubWeeklyReportsDepartmentOptions = departmentRows.map(function (row) {
        return { id: String(row.id || '').trim(), name: String(row.name || row.id || 'Department').trim() };
      }).filter(function (row) { return row.id; });
    }
    const programRows = payload && Array.isArray(payload.programOptions) ? payload.programOptions : [];
    if (programRows.length) {
      hubWeeklyReportsProgramOptions = programRows.map(function (row) {
        return { id: String(row.id || '').trim(), name: String(row.name || row.id || 'Program').trim() };
      }).filter(function (row) { return row.id; });
    }
    const teacherRows = payload && Array.isArray(payload.teacherOptions) ? payload.teacherOptions : [];
    if (teacherRows.length) {
      hubWeeklyReportsTeacherOptions = teacherRows.map(function (row) {
        return { id: String(row.id || '').trim(), name: String(row.name || row.id || 'Teacher').trim() };
      }).filter(function (row) { return row.id; });
    }
    renderWeeklyReportsDepartmentSelect();
    renderWeeklyReportsProgramSelect();
    renderWeeklyReportsTeacherSelect();
  }

  function cacheWeeklyReportsDepartmentOptions(payload) {
    cacheWeeklyReportsFilterOptions(payload);
  }

  async function ensureWeeklyReportsDepartmentOptionsLoaded() {
    if (hubWeeklyReportsDepartmentOptions.length
      && hubWeeklyReportsProgramOptions.length
      && hubWeeklyReportsTeacherOptions.length) {
      renderWeeklyReportsDepartmentSelect();
      renderWeeklyReportsProgramSelect();
      renderWeeklyReportsTeacherSelect();
      return;
    }
    try {
      const requestQuery = new URLSearchParams();
      requestQuery.set('departmentsOnly', '1');
      const response = await fetch('/school/report-hub/api/workspace/weekly-reports?' + requestQuery.toString(), {
        headers: { Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        credentials: 'same-origin'
      });
      const payload = await response.json().catch(function () {
        return { status: 'error' };
      });
      if (response.ok && payload.status === 'success') {
        cacheWeeklyReportsFilterOptions(payload);
      } else {
        renderWeeklyReportsDepartmentSelect();
        renderWeeklyReportsProgramSelect();
        renderWeeklyReportsTeacherSelect();
      }
    } catch (error) {
      renderWeeklyReportsDepartmentSelect();
      renderWeeklyReportsProgramSelect();
      renderWeeklyReportsTeacherSelect();
    }
  }

  function renderWeeklyReportsOptionSelect(selectId, placeholder, optionRows) {
    const selectEl = document.getElementById(selectId);
    if (!selectEl) return;
    const currentValue = selectEl.value;
    const options = ['<option value="">' + escapeHtml(placeholder) + '</option>'].concat(
      (Array.isArray(optionRows) ? optionRows : []).map(function (row) {
        return '<option value="' + escapeHtml(row.id) + '">' + escapeHtml(row.name || row.id) + '</option>';
      })
    );
    selectEl.innerHTML = options.join('');
    if (currentValue && optionRows.some(function (row) { return row.id === currentValue; })) {
      selectEl.value = currentValue;
    }
  }

  function renderWeeklyReportsDepartmentSelect() {
    renderWeeklyReportsOptionSelect('hubWeeklyReportsDepartmentId', 'All Departments', hubWeeklyReportsDepartmentOptions);
  }

  function renderWeeklyReportsProgramSelect() {
    renderWeeklyReportsOptionSelect('hubWeeklyReportsProgramId', 'All Programs', hubWeeklyReportsProgramOptions);
