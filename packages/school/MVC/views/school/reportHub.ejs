    const rows = Array.isArray(hubMakeupSummary?.sessions) ? hubMakeupSummary.sessions : [];
    const body = rows.length ? rows.map(function (item) {
      const href = String(item?.manageUrl || '').trim();
      const link = href
        ? '<a href="' + escapeHtml(href) + '" target="_blank" rel="noopener noreferrer" class="fw-semibold text-decoration-none"><i class="bi bi-box-arrow-up-right me-1"></i>' + escapeHtml(item?.sessionId || '-') + '</a>'
        : escapeHtml(item?.sessionId || '-');
      return '<tr><td>' + link + '</td>'
        + '<td><div>' + escapeHtml(item?.date || '-') + '</div><div class="small text-muted">' + escapeHtml(item?.startTime || '-') + ' &ndash; ' + escapeHtml(item?.endTime || '-') + '</div></td>'
        + '<td class="text-end fw-semibold">' + Number(item?.durationHours || 0).toFixed(2) + ' hrs</td>'
        + '<td>' + escapeHtml(item?.teacherName || item?.teacherId || '-') + '</td>'
        + '<td>' + escapeHtml(item?.room || '-') + '</td>'
        + '<td><span class="badge bg-light text-dark border">' + escapeHtml(item?.statusLabel || item?.status || '-') + '</span></td></tr>';
    }).join('') : '<tr><td colspan="6" class="text-center text-muted py-3">No make-up sessions have been created yet.</td></tr>';
    overview.innerHTML = '<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2"><div><h6 class="fw-bold mb-0">Created Make-up Sessions</h6><div class="small text-muted">Every directly linked session counts regardless of status.</div></div><span class="badge rounded-pill bg-warning-subtle text-warning-emphasis border border-warning-subtle">' + rows.length + ' session(s)</span></div>'
      + '<div class="table-responsive border rounded"><table class="table table-sm table-hover align-middle mb-0"><thead class="table-light"><tr><th>Session</th><th>Date / Time</th><th class="text-end">Duration</th><th>Teacher</th><th>Room</th><th>Status</th></tr></thead><tbody>' + body + '</tbody></table></div>';
  }

  function syncHubMakeupSessionDurationPreview(options) {
    options = options || {};
    const modal = document.getElementById('hubSessionMakeupModal');
    if (!modal) return;
    const percentInput = modal.querySelector('#hubMakeupSessionDurationPercent');
    const startInput = modal.querySelector('#hubMakeupSessionStart');
    const endInput = modal.querySelector('#hubMakeupSessionEnd');
    const summary = modal.querySelector('#hubMakeupSessionDurationSummary');
    const createButton = modal.querySelector('#hubMakeupSessionCreate');
    const percent = Math.max(1, Math.min(100, Number(percentInput?.value || hubMakeupDefaultPercent || 100)));
    if (percentInput) percentInput.value = String(percent);
    const originalMinutes = Number(hubMakeupSummary?.originalDurationMinutes || Math.round(Number(hubMakeupOriginalDurationHours || 0) * 60));
    const allocatedMinutes = Number(hubMakeupSummary?.allocatedDurationMinutes || 0);
    const allowedMinutes = Math.max(0, Math.round(originalMinutes * (percent / 100)));
    const availableMinutes = Math.max(0, allowedMinutes - allocatedMinutes);
    const excessMinutes = Math.max(0, allocatedMinutes - allowedMinutes);
    if (options.updateEndTime === true && startInput?.value && availableMinutes > 0) {
      const computedEnd = hubAddMinutesToClockTime(startInput.value, availableMinutes);
      if (computedEnd && endInput) endInput.value = computedEnd;
    }
    const proposedMinutes = hubCalculateClockRangeMinutes(startInput?.value, endInput?.value);
    const remainingAfterMinutes = Math.max(0, availableMinutes - proposedMinutes);
    const invalid = excessMinutes > 0 || availableMinutes <= 0 || proposedMinutes <= 0 || proposedMinutes > availableMinutes;
    if (createButton) {
      createButton.disabled = invalid;
      createButton.title = excessMinutes > 0 ? 'The selected percentage is below the hours already defined.'
        : (availableMinutes <= 0 ? 'The full make-up allowance has already been defined.' : (proposedMinutes > availableMinutes ? 'The proposed session exceeds the remaining allowance.' : ''));
    }
    if (!summary) return;
    summary.innerHTML = '<strong>Original session:</strong> ' + hubFormatDurationHoursLabel(hubMakeupOriginalDurationHours)
      + '<br><strong>Allowed at ' + percent + '%:</strong> ' + hubFormatDurationHoursLabel(allowedMinutes / 60)
      + '<br><strong>Already defined:</strong> ' + hubFormatDurationHoursLabel(allocatedMinutes / 60)
      + '<br><strong>Proposed session:</strong> ' + hubFormatDurationHoursLabel(proposedMinutes / 60)
      + '<br><strong>' + (excessMinutes > 0 ? 'Excess' : 'Missing after creation') + ':</strong> <span class="' + (excessMinutes > 0 || proposedMinutes > availableMinutes ? 'text-danger' : 'text-primary') + '">' + hubFormatDurationHoursLabel((excessMinutes > 0 ? excessMinutes : remainingAfterMinutes) / 60) + '</span>'
      + (proposedMinutes > availableMinutes && availableMinutes > 0 ? '<div class="text-danger fw-semibold mt-2"><i class="bi bi-exclamation-octagon-fill me-1"></i>The proposed session is longer than the remaining allowance.</div>' : '')
      + (availableMinutes <= 0 && excessMinutes <= 0 ? '<div class="text-success fw-semibold mt-2"><i class="bi bi-check-circle-fill me-1"></i>The full allowed duration has already been defined.</div>' : '')
      + '<br><span class="text-muted">The percentage limits all linked make-up sessions combined. Payroll calculations are unchanged.</span>';
  }

  function openHubSessionMakeupModal(row) {
    if (!row) return;
    const modal = ensureHubSessionMakeupModal();
    const statusMap = buildSessionStatusMetaMap(hubSessionStatusMeta || []);
    const statusMeta = statusMap.get(normalizeSessionStatusCode(row.status)) || null;
    hubMakeupOriginalDurationHours = hubResolveOriginalDurationHours(row);
    hubMakeupSummary = row.makeupSummary && typeof row.makeupSummary === 'object'
      ? row.makeupSummary
      : { sessions: [], originalDurationMinutes: Math.round(hubMakeupOriginalDurationHours * 60), allocatedDurationMinutes: 0, allowedDurationPercent: Number(statusMeta?.makeupDurationPercent || 100), allowedDurationHours: Number((hubMakeupOriginalDurationHours * (Number(statusMeta?.makeupDurationPercent || 100) / 100)).toFixed(2)) };
    hubMakeupDefaultPercent = Number(hubMakeupSummary?.allowedDurationPercent || statusMeta?.makeupDurationPercent || 100);
    modal.querySelector('#hubMakeupSessionClassId').value = row.classId || '';
    modal.querySelector('#hubMakeupSessionSessionId').value = row.sessionId || '';
    modal.querySelector('#hubMakeupSessionTeacherId').value = row.teacherId || '';
    modal.querySelector('#hubMakeupSessionDate').value = '';
    modal.querySelector('#hubMakeupSessionStart').value = row.startTime || '';
    modal.querySelector('#hubMakeupSessionEnd').value = '';
    const percentInput = modal.querySelector('#hubMakeupSessionDurationPercent');
    percentInput.value = String(hubMakeupDefaultPercent || 100);
    percentInput.disabled = !hubSessionCanOverrideMakeupDuration;
    const accessNote = modal.querySelector('#hubMakeupSessionDurationAccessNote');
    if (accessNote) accessNote.innerHTML = hubSessionCanOverrideMakeupDuration
      ? '<i class="bi bi-shield-check me-1"></i>Administrators may adjust the combined allowance.'
      : '<i class="bi bi-lock-fill me-1"></i>Set by policy; only administrators can change it.';
    modal.querySelector('#hubMakeupSessionTeacherName').value = row.teacherName || '';
    modal.querySelector('#hubMakeupSessionRoom').value = row.room || '';
    modal.querySelector('#hubMakeupSessionReason').value = '';
    modal.querySelector('#hubMakeupSessionContext').innerHTML = '<strong>' + escapeHtml(row.className || row.classId || 'Class') + '</strong><div class="text-muted font-monospace">' + escapeHtml(row.sessionId || '') + '</div><div class="small text-muted mt-1">Defined: ' + Number(hubMakeupSummary?.allocatedDurationHours || 0).toFixed(2) + ' hrs of ' + Number(hubMakeupSummary?.allowedDurationHours || 0).toFixed(2) + ' hrs allowed.</div>';
    renderHubMakeupAllocationTable();
    syncHubMakeupSessionDurationPreview({ updateEndTime: true });
    if (window.bootstrap) window.bootstrap.Modal.getOrCreateInstance(modal).show();
  }

  async function createHubMakeupSessionFromModal() {
    const modal = ensureHubSessionMakeupModal();
    const button = modal.querySelector('#hubMakeupSessionCreate');
    const oldHtml = button ? button.innerHTML : '';
    const classId = hubInputValue('hubMakeupSessionClassId');
    const sessionId = hubInputValue('hubMakeupSessionSessionId');
    const payload = {
      date: hubInputValue('hubMakeupSessionDate'),
      startTime: hubInputValue('hubMakeupSessionStart'),
      endTime: hubInputValue('hubMakeupSessionEnd'),
      makeupDurationPercent: hubInputValue('hubMakeupSessionDurationPercent') || hubMakeupDefaultPercent || 100,
      teacherId: hubInputValue('hubMakeupSessionTeacherId'),
      teacherName: hubInputValue('hubMakeupSessionTeacherName'),
      room: hubInputValue('hubMakeupSessionRoom'),
      reason: hubInputValue('hubMakeupSessionReason')
    };
    if (!payload.date) {
      await showHubMessage({ title: 'Date Required', icon: 'warning', message: 'Please select the make-up session date.', buttons: [{ text: 'OK', class: 'btn-primary' }] });
      return;
    }
    try {
      if (button) {
        button.disabled = true;
        button.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Creating...';
      }
      if (typeof window.showLoading === 'function') window.showLoading('Creating make-up session...');
      const submitMakeup = async function (bodyPayload) {
        const response = await fetch('/school/classes/' + encodeURIComponent(classId) + '/sessions/' + encodeURIComponent(sessionId) + '/makeup', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
            'X-AJAX-Request': 'true'
          },
          credentials: 'same-origin',
          body: JSON.stringify(bodyPayload || {})
        });
        const parsed = await response.json().catch(function () {
          return { status: 'error', message: 'Unable to read server response.' };
        });
        return { response, parsed };
      };
      let responseAndPayload = await submitMakeup(payload);
      let result = responseAndPayload.parsed;
      if (result.status === 'warning' && result.code === 'MAKEUP_SESSION_WARNINGS') {
        const warningList = Array.isArray(result?.data?.warnings) && result.data.warnings.length
          ? '<ul>' + result.data.warnings.map(function (item) { return '<li>' + escapeHtml(item) + '</li>'; }).join('') + '</ul>'
          : '';
        if (typeof window.hideLoading === 'function') window.hideLoading({ force: true });
        const selected = await showHubMessage({
          title: 'Review Make-up Warnings',
          icon: 'warning',
          message: (result.message || 'Review warnings before creating this make-up session.') + warningList,
          buttons: [{ text: 'Cancel', class: 'btn-secondary' }, { text: 'Create Anyway', class: 'btn-warning' }]
        });
        if (selected !== 'Create Anyway') return;
        if (typeof window.showLoading === 'function') window.showLoading('Creating make-up session...');
        responseAndPayload = await submitMakeup({ ...payload, force: true });
        result = responseAndPayload.parsed;
      }
      if (!responseAndPayload.response.ok || result.status !== 'success') throw new Error(result.message || 'Could not create make-up session.');
      if (window.bootstrap) window.bootstrap.Modal.getOrCreateInstance(modal).hide();
      const warnings = Array.isArray(result?.data?.warnings) && result.data.warnings.length
        ? '<hr><strong>Warnings</strong><ul>' + result.data.warnings.map(function (item) { return '<li>' + escapeHtml(item) + '</li>'; }).join('') + '</ul>'
        : '';
      await showHubMessage({ title: 'Make-up Session Created', icon: result?.data?.warnings?.length ? 'warning' : 'success', message: (result.message || 'Make-up session created.') + warnings, buttons: [{ text: 'OK', class: 'btn-success' }] });
      hubWorkspaceNodeCache.delete('sessions');
      loadWorkspaceSection('sessions');
    } catch (error) {
      await showHubMessage({ title: 'Make-up Session Failed', icon: 'error', message: error.message || 'Could not create make-up session.', buttons: [{ text: 'Close', class: 'btn-secondary' }] });
    } finally {
      if (typeof window.hideLoading === 'function') window.hideLoading({ force: true });
      if (button) {
        button.innerHTML = oldHtml;
      }
      syncHubMakeupSessionDurationPreview();
    }
  }

  function ensureHubSessionEditModal() {
