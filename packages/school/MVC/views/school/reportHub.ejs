      const teacherCell = renderWeeklyReportsTeacherCell(group, classes, groupKey, classes.length);
      return classes.map(function (row, index) {
        const classCells = [
          renderWeeklyReportsClassColumnCell(row),
          renderWeeklyReportsOperationalMetricCells(row)
        ].join('');
