  function renderWeeklyReportsPrintClassSection(row) {
    const department = String(row.departmentName || '').trim();
    const subtitle = department
      ? '<div class="hub-wr-print-class-subtitle">' + escapeHtml(department) + '</div>'
      : '';
    return [
