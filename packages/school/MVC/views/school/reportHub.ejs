    if (modal) return modal;
    modal = document.createElement('div');
    modal.className = 'modal fade';
    modal.id = 'hubSessionEditModal';
    modal.tabIndex = -1;
    modal.setAttribute('aria-hidden', 'true');
    modal.innerHTML = [
      '<div class="modal-dialog modal-lg modal-dialog-scrollable">',
      '<div class="modal-content">',
      '<div class="modal-header bg-primary text-white">',
      '<h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2"></i>Edit Session</h5>',
      '<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>',
      '</div>',
      '<div class="modal-body">',
      '<input type="hidden" id="hubEditSessionClassId">',
      '<input type="hidden" id="hubEditSessionSessionId">',
      '<input type="hidden" id="hubEditSessionTeacherId">',
      '<div class="alert alert-light border small" id="hubEditSessionContext"></div>',
      '<div class="row g-3">',
      '<div class="col-md-4"><label class="form-label fw-bold">Date</label><input type="date" class="form-control" id="hubEditSessionDate"></div>',
      '<div class="col-md-4"><label class="form-label fw-bold">Start Time</label><input type="time" class="form-control" id="hubEditSessionStart"></div>',
      '<div class="col-md-4"><label class="form-label fw-bold">End Time</label><input type="time" class="form-control" id="hubEditSessionEnd"></div>',
      '<div class="col-md-6"><label class="form-label fw-bold">Teacher</label><div class="input-group"><input type="text" class="form-control bg-white" id="hubEditSessionTeacherName" readonly><button type="button" class="btn btn-outline-primary" id="hubEditSessionPickTeacher"><i class="bi bi-person-check"></i></button></div></div>',
      '<div class="col-md-3"><label class="form-label fw-bold">Status</label><select class="form-select" id="hubEditSessionStatus"></select></div>',
      '<div class="col-md-3"><label class="form-label fw-bold">Location</label><input type="text" class="form-control" id="hubEditSessionRoom" maxlength="200"></div>',
      '<div class="col-12"><div class="form-check form-switch border rounded bg-light px-3 py-2"><input class="form-check-input ms-0 me-2" type="checkbox" role="switch" id="hubEditSessionLocked"><label class="form-check-label fw-bold" for="hubEditSessionLocked"><i class="bi bi-lock-fill me-1"></i>Lock this session</label><div class="small text-muted mt-1">Locked sessions cannot be edited from attendance/session screens unless the user can override locks.</div></div></div>',
      '<div class="col-12"><label class="form-label fw-bold">Notes</label><textarea class="form-control" id="hubEditSessionNotes" rows="4" maxlength="2000"></textarea></div>',
      '</div>',
      '</div>',
      '<div class="modal-footer bg-light">',
      '<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>',
      '<button type="button" class="btn btn-primary fw-bold" id="hubEditSessionSave"><i class="bi bi-save me-1"></i>Save Session</button>',
      '</div>',
      '</div>',
      '</div>'
    ].join('');
    document.body.appendChild(modal);
    modal.querySelector('#hubEditSessionPickTeacher')?.addEventListener('click', function () {
      if (!window.GenericPicker || !window.GenericPickerPresets) {
        showHubMessage({ title: 'Teacher Picker', icon: 'warning', message: 'Teacher picker is not available yet.' });
        return;
      }
      window.GenericPicker.open(window.GenericPickerPresets.teacher({
        title: 'Select Session Teacher',
        placeholder: 'Search teachers...',
        context: window.GenericPickerContexts
          ? window.GenericPickerContexts.activeOrganizationScope({ label: 'Active Organization' })
          : undefined,
        onSelect: function (item) {
          const teacherId = resolveHubTeacherId(item);
          const teacherName = formatHubTeacherName(item, teacherId);
          modal.querySelector('#hubEditSessionTeacherId').value = teacherId;
          modal.querySelector('#hubEditSessionTeacherName').value = teacherName;
