<div class="modal fade" id="referralQuickCreateModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-person-plus me-1"></i>New Referral Contact</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="quickReferral_alert" class="alert alert-danger border py-2 px-3 small d-none mb-3"></div>
        <div class="alert alert-light border small mb-3">
          Create a new referral contact. To link an existing contact, cancel this dialog and use <strong>Search</strong> on the referral row. Email, gender, and date of birth are required. Select at least one referring organization.
        </div>
        <input type="hidden" id="quickReferral_personMode" value="new">
        <input type="hidden" id="quickReferral_status" value="Active">

        <h6 class="fw-bold text-uppercase text-muted small mb-3">Profile &amp; identity</h6>
        <div class="row g-2 mb-2">
          <div class="col-md-4">
            <label class="form-label small fw-bold" for="quickReferral_firstName">First name *</label>
            <input type="text" id="quickReferral_firstName" class="form-control form-control-sm" autocomplete="given-name">
          </div>
          <div class="col-md-4">
            <label class="form-label small fw-bold" for="quickReferral_middleName">Middle name</label>
            <input type="text" id="quickReferral_middleName" class="form-control form-control-sm" autocomplete="additional-name">
          </div>
          <div class="col-md-4">
            <label class="form-label small fw-bold" for="quickReferral_lastName">Last name *</label>
            <input type="text" id="quickReferral_lastName" class="form-control form-control-sm" autocomplete="family-name">
          </div>
        </div>
        <div class="row g-2 mb-2">
          <div class="col-md-6">
            <label class="form-label small fw-bold" for="quickReferral_gender">Gender *</label>
            <select id="quickReferral_gender" class="form-select form-select-sm">
              <option value="">-- Select --</option>
              <option value="male">Male</option>
              <option value="female">Female</option>
              <option value="nonbinary">Non-binary</option>
              <option value="other">Other</option>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label small fw-bold" for="quickReferral_dob">Date of birth *</label>
            <input type="date" id="quickReferral_dob" class="form-control form-control-sm" value="2000-01-01">
          </div>
        </div>
        <div class="row g-2 mb-2">
          <div class="col-md-6">
            <label class="form-label small fw-bold" for="quickReferral_email">Email address *</label>
            <input type="email" id="quickReferral_email" class="form-control form-control-sm" autocomplete="email">
          </div>
          <div class="col-md-6">
            <label class="form-label small fw-bold" for="quickReferral_phone">Phone</label>
            <input type="text" id="quickReferral_phone" class="form-control form-control-sm" autocomplete="tel">
          </div>
        </div>
        <h6 class="fw-bold text-uppercase text-muted small mb-2 mt-3">Address</h6>
        <div class="row g-2 mb-2">
          <div class="col-12">
            <label class="form-label small fw-bold" for="quickReferral_addrLine1">Street</label>
            <input type="text" id="quickReferral_addrLine1" class="form-control form-control-sm" autocomplete="street-address">
          </div>
          <div class="col-md-4">
            <label class="form-label small fw-bold" for="quickReferral_addrCity">City</label>
            <input type="text" id="quickReferral_addrCity" class="form-control form-control-sm" autocomplete="address-level2">
          </div>
          <div class="col-md-4">
            <label class="form-label small fw-bold" for="quickReferral_addrProvince">Province</label>
            <input type="text" id="quickReferral_addrProvince" class="form-control form-control-sm" autocomplete="address-level1">
          </div>
          <div class="col-md-4">
            <label class="form-label small fw-bold" for="quickReferral_addrPostal">Postal</label>
            <input type="text" id="quickReferral_addrPostal" class="form-control form-control-sm" autocomplete="postal-code">
          </div>
        </div>
        <input type="hidden" name="newPersonActive" id="quickReferral_newPersonActive" value="true">

        <hr class="my-3">

        <div class="mb-3">
          <label class="form-label small fw-bold">Organizations *</label>
          <div id="quickReferral_orgs" class="row g-2"></div>
        </div>

        <div class="mb-0">
          <label class="form-label small fw-bold" for="quickReferral_notes">Referral notes</label>
          <textarea id="quickReferral_notes" class="form-control form-control-sm" rows="2" maxlength="5000" placeholder="Optional"></textarea>
        </div>
      </div>
      <div class="modal-footer flex-wrap gap-2">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary btn-sm" id="btn_quickReferralSave"><i class="bi bi-save me-1"></i>Save Referral</button>
      </div>
    </div>
  </div>
</div>