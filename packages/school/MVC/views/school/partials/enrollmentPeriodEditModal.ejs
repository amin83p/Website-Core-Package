<%
  const editCycleStartDate = typeof cycleStartDate !== 'undefined' ? String(cycleStartDate || '').trim() : '';
  const editCycleEndDate = typeof cycleEndDate !== 'undefined' ? String(cycleEndDate || '').trim() : '';
  const editFunderOptions = Array.isArray(typeof funderOptions !== 'undefined' ? funderOptions : null) ? funderOptions : [];
%>
<div class="modal fade" id="editPeriodModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Edit Enrollment Period</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="edit_periodId">
        <div class="row g-2">
          <div class="col-md-6">
            <label class="form-label">Start Date *</label>
            <input type="date" id="edit_startDate" class="form-control"<% if (editCycleStartDate) { %> min="<%= editCycleStartDate %>"<% } %><% if (editCycleEndDate) { %> max="<%= editCycleEndDate %>"<% } %>>
          </div>
          <div class="col-md-6">
            <label class="form-label">End Date</label>
            <input type="date" id="edit_endDate" class="form-control"<% if (editCycleStartDate) { %> min="<%= editCycleStartDate %>"<% } %>>
          </div>
          <div class="col-md-6" id="wrap_edit_targetSessionCount">
            <label class="form-label">Number of Sessions <span class="text-muted fw-normal">(optional)</span></label>
            <input type="number" id="edit_targetSessionCount" class="form-control" min="1" step="1" placeholder="e.g. 10">
            <div class="form-text compact-help">Session target; cannot combine with hour target.</div>
          </div>
          <div class="col-md-6" id="wrap_edit_targetHours">
            <label class="form-label">Number of Hours <span class="text-muted fw-normal">(optional)</span></label>
            <input type="number" id="edit_targetHours" class="form-control" min="0.25" step="0.25" placeholder="e.g. 20">
            <div class="form-text compact-help">Hour target; cannot combine with session target.</div>
          </div>

          <div class="col-md-6" id="wrap_edit_status">
            <label class="form-label" for="edit_status">Status</label>
            <select id="edit_status" class="form-select">
              <option value="active">Active</option>
              <option value="to_be_confirmed">To be Confirmed</option>
              <option value="waiting_list">Waiting list</option>
              <option value="close">Close</option>
            </select>
            <div id="edit_statusAttendanceHelp" class="form-text compact-help text-warning d-none"></div>
          </div>
          <div class="col-md-6 d-none" id="wrap_edit_statusReadonly">
            <label class="form-label" for="edit_statusReadonly">Status</label>
            <input type="text" id="edit_statusReadonly" class="form-control" readonly>
            <div class="form-text compact-help" id="edit_statusReadonlyHelp"></div>
          </div>
          <div class="col-12 d-none" id="wrap_edit_closeReason">
            <label class="form-label" for="edit_closeReason">Close Reason</label>
            <select id="edit_closeReason" class="form-select">
              <option value="withdrawn">Withdrawn</option>
              <option value="cancelled">Cancelled</option>
              <option value="archived">Archived</option>
              <option value="completed" selected>Completed</option>
            </select>
          </div>
          <div class="col-12 d-none" id="wrap_edit_closeFields">
            <div class="row g-2">
              <div class="col-md-6">
                <label class="form-label" for="edit_closeEndDate">End Date *</label>
                <input type="date" id="edit_closeEndDate" class="form-control">
              </div>
              <div class="col-12">
                <label class="form-label" for="edit_closeReasonEnd">Reason *</label>
                <textarea id="edit_closeReasonEnd" class="form-control" rows="2"></textarea>
              </div>
              <div class="col-12">
                <div id="edit_closeStatusPreview" class="alert alert-light border mb-0">
                  Preview the financial effect before applying cancellation, completion, or archival.
                </div>
                <button type="button" class="btn btn-outline-primary btn-sm mt-2" id="btn_previewEditClosePeriod">Preview</button>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <label class="form-label" for="edit_sessionCapacityType">Session Capacity</label>
            <select id="edit_sessionCapacityType" class="form-select">
              <option value="group" selected>Group</option>
              <option value="one_on_one">1 On 1</option>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label" for="edit_funder">Funder</label>
            <select id="edit_funder" class="form-select">
              <option value="self" selected>Self Fund</option>
              <% editFunderOptions.forEach((funder) => { %>
              <option value="<%= String(funder.id || '') %>"><%= String(funder.label || funder.id || '') %></option>
              <% }); %>
            </select>
            <div class="form-text compact-help" id="edit_funder_help">Self Fund posts to the student account. Other funders post to the funder account with student detail.</div>
          </div>
          <div class="col-md-6">
            <label class="form-label" for="edit_claimNumber">Claim Number</label>
            <select id="edit_claimNumber" class="form-select">
              <option value="">— None —</option>
              <option value="__add_new__">+ Add New...</option>
            </select>
          </div>
          <div class="col-12">
            <label class="form-label">Reason Start</label>
            <textarea id="edit_reasonStart" class="form-control" rows="2"></textarea>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-filled btn-primary btn-sm" id="btn_confirmEditPeriod">Save Changes</button>
      </div>
    </div>
  </div>
</div>
