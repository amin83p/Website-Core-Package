<div class="modal fade rolling-student-manage-modal" id="rollingStudentClaimNumbersModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-card-checklist me-1"></i>Manage Claim Numbers</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="rolling-student-manage-summary">
          <div class="row g-2">
            <div class="col-md-8">
              <label class="form-label small fw-bold text-muted mb-1" for="rollingClaim_studentLabel">Student</label>
              <input type="text" id="rollingClaim_studentLabel" class="form-control form-control-sm bg-white border-0 px-0 fw-semibold" readonly>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-bold text-muted mb-1" for="rollingClaim_studentId">Student ID</label>
              <input type="text" id="rollingClaim_studentId" class="form-control form-control-sm bg-white border-0 px-0 font-monospace" readonly>
            </div>
          </div>
        </div>
        <div id="rollingClaim_blockers" class="alert alert-warning border py-2 px-3 small d-none mb-3"></div>
        <div id="rollingClaim_alert" class="alert alert-danger border py-2 px-3 small d-none mb-3"></div>
        <div id="rollingClaim_empty" class="text-muted small text-center py-3 border rounded bg-light">No claim numbers saved yet.</div>
        <div id="rollingClaim_listWrap" class="d-none">
          <div class="table-responsive">
            <table class="table table-sm table-bordered align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Claim Number</th>
                  <th style="width: 22%;">Label</th>
                  <th style="width: 10%;" class="text-center">Primary</th>
                  <th class="text-end rolling-claim-actions-col">Actions</th>
                </tr>
              </thead>
              <tbody id="rollingClaim_tbody"></tbody>
            </table>
          </div>
        </div>
        <div id="rollingClaim_editorPanel" class="claim-number-row-editor mt-3 d-none">
          <div class="fw-semibold small mb-2" id="rollingClaim_editorTitle">New Claim Number</div>
          <div class="row g-2">
            <div class="col-md-5">
              <label class="form-label small fw-bold" for="rollingClaim_number">Claim Number *</label>
              <input type="text" id="rollingClaim_number" class="form-control form-control-sm" maxlength="120">
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-bold" for="rollingClaim_label">Label</label>
              <input type="text" id="rollingClaim_label" class="form-control form-control-sm" maxlength="120" placeholder="Optional">
            </div>
            <div class="col-md-3 d-flex align-items-end">
              <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="rollingClaim_isPrimary">
                <label class="form-check-label small" for="rollingClaim_isPrimary">Primary</label>
              </div>
            </div>
            <div class="col-12">
              <label class="form-label small fw-bold" for="rollingClaim_notes">Notes</label>
              <textarea id="rollingClaim_notes" class="form-control form-control-sm" rows="2" maxlength="500" placeholder="Optional"></textarea>
            </div>
          </div>
          <div class="d-flex flex-wrap gap-2 mt-2">
            <button type="button" class="btn btn-sm btn-primary" id="btn_rollingClaimApplyEditor"><i class="bi bi-save me-1"></i>Save</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="btn_rollingClaimCancelEditor">Cancel</button>
          </div>
        </div>
      </div>
      <div class="modal-footer flex-wrap gap-2">
        <button type="button" class="btn btn-outline-primary btn-sm" id="btn_rollingClaimAdd"><i class="bi bi-plus-lg me-1"></i>Add Claim Number</button>
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>
