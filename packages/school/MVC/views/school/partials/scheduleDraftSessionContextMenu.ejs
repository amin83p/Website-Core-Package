  <div class="session-enrollment-stage-panel card shadow">

    <div class="card-header py-2 d-flex align-items-start justify-content-between gap-2">

      <div>

        <h5 class="card-title mb-0" id="scheduleDraftMoveOverlayTitle">Move session</h5>

        <div class="small text-muted" id="scheduleDraftMoveOverlayContext"></div>

      </div>

      <button type="button" class="btn-close" data-draft-move-dismiss="1" aria-label="Close"></button>

    </div>

    <div class="card-body py-2">

      <div class="session-stage-section mb-3">

        <label class="session-stage-label small text-muted mb-1" for="scheduleDraftMoveDate">Date</label>

