<div class="modal fade" id="rollingStudentClbModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-bar-chart-steps me-1"></i>CLB Entries</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="row g-2 mb-3">
          <div class="col-md-8">
            <label class="form-label small fw-bold" for="rollingClb_studentLabel">Student</label>
            <input type="text" id="rollingClb_studentLabel" class="form-control form-control-sm bg-light" readonly>
          </div>
          <div class="col-md-4">
            <label class="form-label small fw-bold" for="rollingClb_studentId">Student ID</label>
            <input type="text" id="rollingClb_studentId" class="form-control form-control-sm bg-light font-monospace" readonly>
          </div>
        </div>

        <div id="rollingClb_listPanel">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="fw-semibold small">CLB history (newest Goal / Current date first)</div>
            <button type="button" class="btn btn-sm btn-outline-primary d-none" id="btn_rollingClbAddEntry">
              <i class="bi bi-plus-lg me-1"></i>Add CLB Entry
            </button>
          </div>
          <div id="rollingClb_historyEmpty" class="text-muted small text-center py-3 border rounded bg-light">No CLB entries yet.</div>
          <div id="rollingClb_historyWrap" class="d-none table-responsive">
            <table class="table table-sm table-bordered align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th style="width: 13%;">Dates</th>
                  <th style="width: 14%;">Row</th>
                  <th class="text-center">Listening</th>
                  <th class="text-center">Speaking</th>
                  <th class="text-center">Reading</th>
                  <th class="text-center">Writing</th>
                </tr>
              </thead>
              <tbody id="rollingClb_historyTbody"></tbody>
            </table>
          </div>
        </div>

        <div id="rollingClb_editorPanel" class="rolling-clb-editor-shell mt-3 d-none">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold mb-0" id="rollingClb_editorTitle">CLB Entry</h6>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="btn_rollingClbCancelEditor">Back to list</button>
          </div>
          <div id="rollingClb_previousEntryHeadsUp" class="d-none"></div>
          <div class="row g-3 mb-2">
            <div class="col-md-6">
              <label class="form-label fw-bold small" for="inp_rolling_clbRecordedAt">Goal / Current Date *</label>
              <input type="date" class="form-control form-control-sm rolling-clb-editor-input" id="inp_rolling_clbRecordedAt">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-bold small" for="inp_rolling_clbResultRecordedAt">Result Date</label>
              <input type="date" class="form-control form-control-sm rolling-clb-editor-input" id="inp_rolling_clbResultRecordedAt">
            </div>
          </div>
          <div class="row g-3 align-items-end mb-2">
            <div class="col-md-5 col-lg-4">
              <label class="form-label fw-bold small" for="inp_rolling_clb_evaluationType">Evaluation</label>
              <select class="form-select form-select-sm rolling-clb-editor-input" id="inp_rolling_clb_evaluationType">
                <option value="referral">Referral</option>
                <option value="placement_test">Placement test</option>
                <option value="teacher">Teacher</option>
                <option value="previous_enrollments" id="opt_rolling_clb_eval_previous_enrollments">Previous Enrollment(s)</option>
              </select>
            </div>
            <div class="col-md-7 col-lg-6 d-none" id="rollingClbTeacherPickCol">
              <label class="form-label fw-bold small" for="inp_rolling_clb_evaluationTeacherLabel">Teacher *</label>
              <div class="input-group input-group-sm">
                <input type="hidden" id="inp_rolling_clb_evaluationTeacherId">
                <input type="text" class="form-control bg-white rolling-clb-editor-input" id="inp_rolling_clb_evaluationTeacherLabel" readonly placeholder="Select teacher...">
                <button type="button" class="btn btn-outline-secondary" id="btnPickRollingClbEvaluationTeacher" title="Select Teacher"><i class="bi bi-person"></i></button>
              </div>
            </div>
          </div>
          <div class="row g-3 mb-3">
            <div class="col-12">
              <label class="form-label fw-bold small" for="inp_rolling_clb_note">Note</label>
              <textarea class="form-control form-control-sm rolling-clb-editor-input" id="inp_rolling_clb_note" rows="2" maxlength="500" placeholder="Optional note about this assessment"></textarea>
            </div>
          </div>
          <div id="rollingClb_entryWarnings" class="alert alert-warning border py-2 px-3 small d-none mb-3"></div>
          <div class="table-responsive">
            <table class="table table-sm table-bordered align-middle rolling-clb-editor-table mb-3">
              <thead class="table-light">
                <tr>
                  <th style="width: 18%;">Row</th>
                  <th>Listening</th>
                  <th>Speaking</th>
                  <th>Reading</th>
                  <th>Writing</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="fw-bold small">CLB Goal</td>
                  <td><input type="text" class="form-control form-control-sm rolling-clb-editor-input" id="inp_rolling_clb_goal_listening" maxlength="20"></td>
                  <td><input type="text" class="form-control form-control-sm rolling-clb-editor-input" id="inp_rolling_clb_goal_speaking" maxlength="20"></td>
                  <td><input type="text" class="form-control form-control-sm rolling-clb-editor-input" id="inp_rolling_clb_goal_reading" maxlength="20"></td>
                  <td><input type="text" class="form-control form-control-sm rolling-clb-editor-input" id="inp_rolling_clb_goal_writing" maxlength="20"></td>
                </tr>
                <tr>
                  <td class="fw-bold small">Current CLB Level</td>
                  <td><input type="text" class="form-control form-control-sm rolling-clb-editor-input" id="inp_rolling_clb_current_listening" maxlength="20"></td>
                  <td><input type="text" class="form-control form-control-sm rolling-clb-editor-input" id="inp_rolling_clb_current_speaking" maxlength="20"></td>
                  <td><input type="text" class="form-control form-control-sm rolling-clb-editor-input" id="inp_rolling_clb_current_reading" maxlength="20"></td>
                  <td><input type="text" class="form-control form-control-sm rolling-clb-editor-input" id="inp_rolling_clb_current_writing" maxlength="20"></td>
                </tr>
                <tr>
                  <td class="fw-bold small">CLB Result</td>
                  <td><input type="text" class="form-control form-control-sm rolling-clb-editor-input" id="inp_rolling_clb_result_listening" maxlength="20"></td>
                  <td><input type="text" class="form-control form-control-sm rolling-clb-editor-input" id="inp_rolling_clb_result_speaking" maxlength="20"></td>
                  <td><input type="text" class="form-control form-control-sm rolling-clb-editor-input" id="inp_rolling_clb_result_reading" maxlength="20"></td>
                  <td><input type="text" class="form-control form-control-sm rolling-clb-editor-input" id="inp_rolling_clb_result_writing" maxlength="20"></td>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-sm btn-primary fw-bold d-none" id="btn_rollingClbSaveEntry">Save CLB Entry</button>
            <button type="button" class="btn btn-sm btn-outline-danger d-none" id="btn_rollingClbRemoveEntry">Remove Entry</button>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>