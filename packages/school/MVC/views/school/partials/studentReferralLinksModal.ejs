<div class="modal fade rolling-student-manage-modal" id="rollingStudentReferralLinksModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-people me-1"></i>Manage Referrals</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="rolling-student-manage-summary">
          <div class="row g-2">
            <div class="col-md-8">
              <label class="form-label small fw-bold text-muted mb-1" for="rollingRefLink_studentLabel">Student</label>
              <input type="text" id="rollingRefLink_studentLabel" class="form-control form-control-sm bg-white border-0 px-0 fw-semibold" readonly>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-bold text-muted mb-1" for="rollingRefLink_studentId">Student ID</label>
              <input type="text" id="rollingRefLink_studentId" class="form-control form-control-sm bg-white border-0 px-0 font-monospace" readonly>
            </div>
          </div>
        </div>
        <div id="rollingRefLink_alert" class="alert alert-danger border py-2 px-3 small d-none mb-3"></div>
        <div id="rollingRefLink_empty" class="text-muted small text-center py-3 border rounded bg-light">No referral links saved yet.</div>
        <div id="rollingRefLink_listWrap" class="d-none">
          <div class="table-responsive">
            <table class="table table-sm table-bordered align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Referral</th>
                  <th>Organization</th>
                  <th style="width: 16%;">Date</th>
                  <th>Program</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody id="rollingRefLink_tbody"></tbody>
            </table>
          </div>
        </div>
        <div id="rollingRefLink_editorPanel" class="border rounded p-3 bg-light mt-3 d-none">
          <div class="fw-semibold small mb-2" id="rollingRefLink_editorTitle">New Referral Link</div>
          <div class="row g-2">
            <div class="col-md-6">
              <label class="form-label small fw-bold">Referral contact *</label>
              <input type="hidden" id="rollingRefLink_referralId" value="">
              <div class="input-group input-group-sm">
                <input type="text" id="rollingRefLink_referralLabel" class="form-control" placeholder="Search referral contact..." readonly>
                <button type="button" class="btn btn-primary" id="btn_rollingRefLinkPickReferral" title="Search referrals"><i class="bi bi-search"></i></button>
                <button type="button" class="btn btn-outline-primary" id="btn_rollingRefLinkAddReferral" title="Add new referral"><i class="bi bi-plus-lg"></i></button>
              </div>
            </div>
            <div class="col-md-6" id="rollingRefLink_orgCol">
              <label class="form-label small fw-bold" for="rollingRefLink_organizationId">Organization *</label>
              <select id="rollingRefLink_organizationId" class="form-select form-select-sm">
                <option value="">— Select —</option>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-bold" for="rollingRefLink_linkDate">Date *</label>
              <input type="date" id="rollingRefLink_linkDate" class="form-control form-control-sm">
            </div>
            <div class="col-md-8">
              <label class="form-label small fw-bold" for="rollingRefLink_programId">Program *</label>
              <select id="rollingRefLink_programId" class="form-select form-select-sm">
                <option value="">— Select —</option>
              </select>
            </div>
            <div class="col-12">
              <label class="form-label small fw-bold" for="rollingRefLink_comment">Comment</label>
              <textarea id="rollingRefLink_comment" class="form-control form-control-sm" rows="2" maxlength="500" placeholder="Optional"></textarea>
            </div>
          </div>
          <div class="d-flex flex-wrap gap-2 mt-2">
            <button type="button" class="btn btn-sm btn-primary" id="btn_rollingRefLinkApplyEditor"><i class="bi bi-save me-1"></i>Save</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="btn_rollingRefLinkCancelEditor">Cancel</button>
          </div>
        </div>
      </div>
      <div class="modal-footer flex-wrap gap-2">
        <button type="button" class="btn btn-outline-primary btn-sm" id="btn_rollingRefLinkAdd"><i class="bi bi-plus-lg me-1"></i>Add Referral Link</button>
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>