<div class="modal fade" id="sessionEnrollmentCalendarModal" tabindex="-1" aria-hidden="true" aria-labelledby="sessionEnrollmentCalendarModalTitle">
  <div class="modal-dialog modal-xl modal-dialog-scrollable session-enrollment-calendar-dialog">
    <div class="modal-content">
      <div class="modal-header py-2">
        <div>
          <h5 class="modal-title" id="sessionEnrollmentCalendarModalTitle">Select sessions</h5>
          <div class="small text-muted" id="sessionEnrollmentCalendarContext"></div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body session-enrollment-calendar-body">
        <div class="session-enrollment-toolbar d-flex flex-wrap align-items-center gap-2 mb-2">
          <div class="btn-group btn-group-sm" role="group" aria-label="Range preset" id="sessionEnrollmentCalendarPresetGroup">
            <button type="button" class="btn btn-outline-secondary" data-session-picker-preset="day">Day</button>
            <button type="button" class="btn btn-outline-secondary" data-session-picker-preset="week">Week</button>
            <button type="button" class="btn btn-outline-secondary" data-session-picker-preset="twoWeeks">2 Weeks</button>
            <button type="button" class="btn btn-outline-secondary d-none" data-session-picker-preset="thirtyDays" id="btn_sessionEnrollmentPresetThirtyDays">30 Days</button>
            <button type="button" class="btn btn-outline-secondary" data-session-picker-preset="month">Month</button>
            <button type="button" class="btn btn-outline-secondary" data-session-picker-preset="twoMonths">2 Months</button>
            <button type="button" class="btn btn-outline-secondary" data-session-picker-preset="threeMonths">3 Months</button>
          </div>
          <div class="btn-group btn-group-sm" role="group" aria-label="Navigate range">
            <button type="button" class="btn btn-outline-secondary" id="btn_sessionEnrollmentCalendarPrev" title="Previous"><i class="bi bi-chevron-left"></i></button>
            <button type="button" class="btn btn-outline-secondary" id="btn_sessionEnrollmentCalendarToday">Today</button>
            <button type="button" class="btn btn-outline-secondary" id="btn_sessionEnrollmentCalendarNext" title="Next"><i class="bi bi-chevron-right"></i></button>
          </div>
          <span class="small text-muted ms-1" id="sessionEnrollmentCalendarRangeLabel"></span>
          <div class="ms-auto d-flex flex-wrap align-items-center gap-2">
            <div class="btn-group btn-group-sm" role="group" aria-label="View mode">
              <button type="button" class="btn btn-outline-primary" data-session-picker-view="singleDay">List</button>
              <button type="button" class="btn btn-outline-primary active" data-session-picker-view="vertical">Vertical</button>
              <button type="button" class="btn btn-outline-primary" data-session-picker-view="timeline">Timeline</button>
            </div>
            <label class="small text-muted d-flex align-items-center gap-1 mb-0" id="sessionEnrollmentDayWidthWrap">
              Day width
              <input type="range" class="form-range" id="sessionEnrollmentDayWidth" min="72" max="280" value="140">
            </label>
          </div>
        </div>
        <div id="sessionEnrollmentCalendarHost" class="session-enrollment-calendar-host border rounded p-2 bg-white"></div>
        <div class="mt-2 p-2 bg-light border rounded" id="sessionEnrollmentCalendarSummary" role="status">
          Selected: 0 session(s), 0 Hr | Span: —
        </div>
        <div class="small text-muted mt-1 flex-shrink-0" id="sessionEnrollmentCalendarHint">
          Click empty grid space to stage sessions; click sessions to include or exclude.
        </div>
      </div>
      <div class="modal-footer py-2">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-outline-secondary btn-sm" id="btn_sessionEnrollmentCalendarClear">Clear selection</button>
        <button type="button" class="btn btn-primary btn-sm" id="btn_sessionEnrollmentCalendarSave">Save selection</button>
        <button type="button" class="btn btn-primary btn-sm d-none" id="btn_sessionEnrollmentCalendarDone">Done</button>
      </div>
      <%- include('school/partials/sessionEnrollmentStageModal') %>
      <%- include('school/partials/sessionEnrollmentMarkModal') %>
    </div>
  </div>
</div>
