<style>
  #rollingStudentClaimNumbersModal.rolling-student-manage-modal .modal-header,
  #rollingStudentClbModal .modal-header {
    border-bottom: 1px solid #e8edf3;
    background: #f8fafc;
  }
  #rollingStudentClaimNumbersModal .rolling-student-manage-summary {
    border: 1px solid #e8edf3;
    border-radius: 0.5rem;
    background: #f8fafc;
    padding: 0.75rem 0.85rem;
    margin-bottom: 1rem;
  }
  #rollingStudentClaimNumbersModal .claim-number-row-editor,
  #rollingStudentClbModal .rolling-clb-editor-shell {
    border: 1px solid var(--bs-border-color, #dee2e6);
    border-radius: 0.5rem;
    padding: 0.75rem;
    background: #f8fafc;
  }
  #rollingStudentClaimNumbersModal .rolling-claim-actions {
    display: inline-flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.25rem;
    white-space: nowrap;
  }
  #rollingStudentClaimNumbersModal th.rolling-claim-actions-col,
  #rollingStudentClaimNumbersModal td.rolling-claim-actions-col {
    width: 1%;
    white-space: nowrap;
  }
  .clb-level-value-warning { border-color: var(--bs-warning) !important; }
  #rollingStudentClbModal .rolling-clb-heads-up {
    border: 1px solid rgba(15, 23, 42, 0.1);
    border-radius: 0.5rem;
    background: #f8fafc;
    padding: 0.75rem;
    margin-bottom: 0.75rem;
  }
  #rollingStudentClbModal .rolling-clb-heads-up__header {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    margin-bottom: 0.5rem;
  }
  #rollingStudentClbModal .rolling-clb-heads-up__dates {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    font-size: 0.8rem;
    margin-bottom: 0.5rem;
  }
  #rollingStudentClbModal #rollingClb_historyWrap .rolling-clb-history-spacer td {
    padding: 0.35rem 0;
    border: 0;
    background: transparent;
  }
  #rollingStudentClbModal #rollingClb_historyWrap tr.rolling-clb-history-entry-block > td {
    border-top-width: 2px;
  }
  #rollingStudentClbModal #rollingClb_historyWrap .rolling-clb-history-row:hover > td {
    background: rgba(2, 132, 199, 0.06);
    cursor: pointer;
  }
</style>

<div class="modal fade" id="hubStudentsDateRangeModal" tabindex="-1" aria-labelledby="hubStudentsDateRangeModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold" id="hubStudentsDateRangeModalLabel">Choose date range</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="text-muted small mb-3" id="hubStudentsDateRangeModalHint">Pick the reporting window for the selected student.</p>
        <div class="hub-students-date-range-shortcuts mb-3" role="group" aria-label="Date shortcuts" id="hubStudentsDateRangeShortcuts">
          <button type="button" class="btn btn-sm btn-outline-secondary" data-hub-students-range-token="m0-full">This Month</button>
          <button type="button" class="btn btn-sm btn-outline-secondary" data-hub-students-range-token="m-1-full">Last Month</button>
          <button type="button" class="btn btn-sm btn-outline-secondary" data-hub-students-range-token="last-2-months">Last Two Months</button>
          <button type="button" class="btn btn-sm btn-outline-secondary" data-hub-students-range-token="last-3-months">Last Three Months</button>
          <button type="button" class="btn btn-sm btn-outline-secondary" data-hub-students-range-token="last-6-months">Last Six Months</button>
          <button type="button" class="btn btn-sm btn-outline-secondary" data-hub-students-range-token="year">This Year</button>
        </div>
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label" for="hubStudentsDateRangeStart">From</label>
            <input type="date" class="form-control" id="hubStudentsDateRangeStart" autocomplete="off">
          </div>
          <div class="col-md-6">
            <label class="form-label" for="hubStudentsDateRangeEnd">To</label>
            <input type="date" class="form-control" id="hubStudentsDateRangeEnd" autocomplete="off">
          </div>
        </div>
        <div class="small text-danger mt-2 d-none" id="hubStudentsDateRangeError" role="alert"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="hubStudentsDateRangeConfirm">Open</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade hub-students-timeline-modal" id="hubStudentsTimelineModal" tabindex="-1" aria-labelledby="hubStudentsTimelineModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-fullscreen modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header py-2">
        <h5 class="modal-title fw-bold" id="hubStudentsTimelineModalLabel">Student timeline</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="hubStudentsTimelineModalBody">
        <div class="hub-students-timeline-empty d-none text-muted small text-center py-4" id="hubStudentsTimelineEmpty">
          No dated events were found for this student.
        </div>
        <div class="hub-students-timeline-wrap d-none" id="hubStudentsTimelineWrap">
          <div class="hub-students-timeline-track-scroll">
            <p class="hub-students-timeline-load-status small text-muted text-center mb-2 d-none" id="hubStudentsTimelineLoadStatus" role="status" aria-live="polite"></p>
            <div class="hub-students-timeline-range-sync" id="hubStudentsTimelineRangeSync" aria-hidden="true">
              <span class="hub-students-timeline-range-sync-label" id="hubStudentsTimelineMinLabel"></span>
              <span class="hub-students-timeline-range-sync-label" id="hubStudentsTimelineMaxLabel"></span>
            </div>
            <div class="hub-students-timeline-track" id="hubStudentsTimelineTrack" role="list" style="--axis-progress: 0;"></div>
          </div>
          <div class="hub-students-timeline-truncated d-none alert alert-warning py-2 small mt-3" id="hubStudentsTimelineTruncated" role="status">
            Some activities or cases were omitted because of list size limits. Use the related tools for the full lists.
          </div>
          <p class="hub-students-timeline-adjust-hint small text-muted mb-2 mb-md-0">
            Drag up/down: shorten the vertical stem to zero on the timeline, then keep going to move the card above or below the axis (opposite of where it started); stem length can grow again on that side. Drag horizontally to shrink the L-indent to zero, then cross left/right of the stem. The dot stays on its date. Saved per student in this browser. Ctrl+wheel (Cmd+wheel on Mac) zooms the timeline length; when zoomed, drag empty space or use the horizontal scrollbar to pan.
          </p>
          <div class="hub-students-timeline-legend small text-muted mt-3 d-flex flex-wrap gap-2" aria-hidden="true">
            <span class="hub-students-timeline-legend-item hub-students-timeline-type--enrollment">Enrollments</span>
            <span class="hub-students-timeline-legend-item hub-students-timeline-type--clb">CLB</span>
            <span class="hub-students-timeline-legend-item hub-students-timeline-type--referral">Referrals</span>
            <span class="hub-students-timeline-legend-item hub-students-timeline-type--report">Reports</span>
            <span class="hub-students-timeline-legend-item hub-students-timeline-type--case">Cases</span>
            <span class="hub-students-timeline-legend-item hub-students-timeline-type--activity">Activities</span>
          </div>
        </div>
      </div>
      <div class="modal-footer py-2">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade hub-students-embed-modal" id="hubStudentsEmbedModal" tabindex="-1" aria-labelledby="hubStudentsEmbedModalLabel" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-scrollable hub-students-embed-dialog">
    <div class="modal-content border-0 shadow">
      <div class="modal-header py-2">
        <h5 class="modal-title fw-bold text-truncate pe-3" id="hubStudentsEmbedModalLabel">Loading…</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body hub-students-embed-body p-0">
        <div class="hub-students-embed-loading" id="hubStudentsEmbedLoading" role="status" aria-live="polite">
          <span class="spinner-border text-primary" aria-hidden="true"></span>
          <span class="small text-muted fw-semibold">Loading page…</span>
        </div>
        <iframe class="hub-students-embed-frame" id="hubStudentsEmbedFrame" title="School tool workspace" loading="lazy"></iframe>
      </div>
    </div>
  </div>
</div>

