<style>
  #rollingStudentClaimNumbersModal.rolling-student-manage-modal .modal-header,
  #rollingStudentClbModal .modal-header {
    border-bottom: 1px solid #e8edf3;
    background: #f8fafc;
  }
  #rollingStudentClaimNumbersModal .rolling-student-manage-summary {
    border: 1px solid #e8edf3;
    border-radius: 0.5rem;
    background: #f8fafc;
    padding: 0.75rem 0.85rem;
    margin-bottom: 1rem;
  }
  #rollingStudentClaimNumbersModal .claim-number-row-editor,
  #rollingStudentClbModal .rolling-clb-editor-shell {
    border: 1px solid var(--bs-border-color, #dee2e6);
    border-radius: 0.5rem;
    padding: 0.75rem;
    background: #f8fafc;
  }
  #rollingStudentClaimNumbersModal .rolling-claim-actions {
    display: inline-flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.25rem;
    white-space: nowrap;
  }
  #rollingStudentClaimNumbersModal th.rolling-claim-actions-col,
  #rollingStudentClaimNumbersModal td.rolling-claim-actions-col {
    width: 1%;
    white-space: nowrap;
  }
  .clb-level-value-warning { border-color: var(--bs-warning) !important; }
  #rollingStudentClbModal .rolling-clb-heads-up {
    border: 1px solid rgba(15, 23, 42, 0.1);
    border-radius: 0.5rem;
    background: #f8fafc;
    padding: 0.75rem;
    margin-bottom: 0.75rem;
  }
  #rollingStudentClbModal .rolling-clb-heads-up__header {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    margin-bottom: 0.5rem;
  }
  #rollingStudentClbModal .rolling-clb-heads-up__dates {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    font-size: 0.8rem;
    margin-bottom: 0.5rem;
  }
  #rollingStudentClbModal #rollingClb_historyWrap .rolling-clb-history-spacer td {
    padding: 0.35rem 0;
    border: 0;
    background: transparent;
  }
  #rollingStudentClbModal #rollingClb_historyWrap tr.rolling-clb-history-entry-block > td {
    border-top-width: 2px;
  }
  #rollingStudentClbModal #rollingClb_historyWrap .rolling-clb-history-row:hover > td {
    background: rgba(2, 132, 199, 0.06);
    cursor: pointer;
  }
</style>

<div class="modal fade" id="hubStudentsDateRangeModal" tabindex="-1" aria-labelledby="hubStudentsDateRangeModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold" id="hubStudentsDateRangeModalLabel">Choose date range</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="text-muted small mb-3" id="hubStudentsDateRangeModalHint">Pick the reporting window for the selected student.</p>
        <div class="hub-students-date-range-shortcuts mb-3" role="group" aria-label="Date shortcuts" id="hubStudentsDateRangeShortcuts">
          <button type="button" class="btn btn-sm btn-outline-secondary" data-hub-students-range-token="m0-full">This Month</button>
          <button type="button" class="btn btn-sm btn-outline-secondary" data-hub-students-range-token="m-1-full">Last Month</button>
          <button type="button" class="btn btn-sm btn-outline-secondary" data-hub-students-range-token="last-2-months">Last Two Months</button>
          <button type="button" class="btn btn-sm btn-outline-secondary" data-hub-students-range-token="last-3-months">Last Three Months</button>
          <button type="button" class="btn btn-sm btn-outline-secondary" data-hub-students-range-token="last-6-months">Last Six Months</button>
          <button type="button" class="btn btn-sm btn-outline-secondary" data-hub-students-range-token="year">This Year</button>
        </div>
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label" for="hubStudentsDateRangeStart">From</label>
            <input type="date" class="form-control" id="hubStudentsDateRangeStart" autocomplete="off">
          </div>
          <div class="col-md-6">
            <label class="form-label" for="hubStudentsDateRangeEnd">To</label>
            <input type="date" class="form-control" id="hubStudentsDateRangeEnd" autocomplete="off">
          </div>
        </div>
        <div class="small text-danger mt-2 d-none" id="hubStudentsDateRangeError" role="alert"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="hubStudentsDateRangeConfirm">Open</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="hubStudentsTimelineLoadModal" tabindex="-1" aria-labelledby="hubStudentsTimelineLoadModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable hub-students-timeline-load-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold" id="hubStudentsTimelineLoadModalLabel">Load student timeline</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div id="hubStudentsTimelineLoadBusy" class="text-center py-4" role="status" aria-live="polite">
          <span class="spinner-border text-primary" aria-hidden="true"></span>
          <div class="small text-muted fw-semibold mt-2">Loading available dates and event types…</div>
        </div>
        <div id="hubStudentsTimelineLoadForm" class="d-none">
          <p class="text-muted small mb-2" id="hubStudentsTimelineLoadSpanHint">Available span: —</p>
          <div class="hub-students-timeline-load-shortcuts mb-3" role="group" aria-label="Timeline range shortcuts" id="hubStudentsTimelineLoadShortcuts">
            <button type="button" class="btn btn-sm btn-outline-secondary" data-hub-timeline-range="full">Full span</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-hub-timeline-range="last-12-months">Last 12 months</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-hub-timeline-range="last-6-months">Last 6 months</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-hub-timeline-range="last-3-months">Last 3 months</button>
          </div>
          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label" for="hubStudentsTimelineLoadStart">From</label>
              <input type="date" class="form-control" id="hubStudentsTimelineLoadStart" autocomplete="off">
            </div>
            <div class="col-md-6">
              <label class="form-label" for="hubStudentsTimelineLoadEnd">To</label>
              <input type="date" class="form-control" id="hubStudentsTimelineLoadEnd" autocomplete="off">
            </div>
          </div>
          <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
            <span class="fw-semibold small">Events to include</span>
            <span class="btn-group btn-group-sm" role="group" aria-label="Select event sources">
              <button type="button" class="btn btn-outline-secondary" id="hubStudentsTimelineSourcesAll">All</button>
              <button type="button" class="btn btn-outline-secondary" id="hubStudentsTimelineSourcesNone">None</button>
            </span>
          </div>
          <div class="hub-students-timeline-source-list" id="hubStudentsTimelineSourceList" role="group" aria-label="Timeline event categories"></div>
          <div class="small text-danger mt-2 d-none" id="hubStudentsTimelineLoadError" role="alert"></div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="hubStudentsTimelineLoadConfirm" disabled>Load timeline</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade hub-students-timeline-modal" id="hubStudentsTimelineModal" tabindex="-1" aria-labelledby="hubStudentsTimelineModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-fullscreen modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header py-2 hub-students-timeline-modal-header">
        <h5 class="modal-title fw-bold mb-0" id="hubStudentsTimelineModalLabel">Student timeline</h5>
        <div class="hub-students-timeline-modal-header-actions ms-auto d-flex align-items-center gap-2">
          <button type="button" class="hub-students-timeline-filters-btn" id="hubStudentsTimelineChangeFilters" title="Change date range and event sources">
            <i class="bi bi-sliders hub-students-timeline-filters-btn-icon" aria-hidden="true"></i>
            <span class="hub-students-timeline-filters-btn-text">Range &amp; sources</span>
          </button>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
      </div>
      <div class="modal-body" id="hubStudentsTimelineModalBody">
        <div class="hub-students-timeline-empty d-none text-muted small text-center py-4" id="hubStudentsTimelineEmpty">
          No dated events were found for this student.
        </div>
        <div class="hub-students-timeline-wrap d-none" id="hubStudentsTimelineWrap">
          <div class="hub-students-timeline-track-scroll">
            <p class="hub-students-timeline-load-status small text-muted text-center mb-2 d-none" id="hubStudentsTimelineLoadStatus" role="status" aria-live="polite"></p>
            <div class="hub-students-timeline-range-sync" id="hubStudentsTimelineRangeSync" aria-hidden="true">
              <span class="hub-students-timeline-range-sync-label" id="hubStudentsTimelineMinLabel"></span>
              <span class="hub-students-timeline-range-sync-label" id="hubStudentsTimelineMaxLabel"></span>
            </div>
            <div class="hub-students-timeline-track" id="hubStudentsTimelineTrack" role="list" style="--axis-progress: 0;"></div>
          </div>
          <div class="hub-students-timeline-truncated d-none alert alert-warning py-2 small mt-3" id="hubStudentsTimelineTruncated" role="status">
            Some activities or cases were omitted because of list size limits. Use the related tools for the full lists.
          </div>
          <div class="hub-students-timeline-legend-bar mt-3">
            <div class="hub-students-timeline-legend small d-flex flex-wrap gap-2" id="hubStudentsTimelineLegend" role="group" aria-label="Show or hide event types on the timeline">
              <button type="button" class="hub-students-timeline-legend-item hub-students-timeline-type--enrollment" data-timeline-source="enrollment" role="switch" aria-pressed="true">Enrollments</button>
              <button type="button" class="hub-students-timeline-legend-item hub-students-timeline-type--registration" data-timeline-source="registration" role="switch" aria-pressed="true">Registrations</button>
              <button type="button" class="hub-students-timeline-legend-item hub-students-timeline-type--clb" data-timeline-source="clb" role="switch" aria-pressed="true">CLB</button>
              <button type="button" class="hub-students-timeline-legend-item hub-students-timeline-type--referral" data-timeline-source="referral" role="switch" aria-pressed="true">Referrals</button>
              <button type="button" class="hub-students-timeline-legend-item hub-students-timeline-type--report" data-timeline-source="report" role="switch" aria-pressed="true">Reports</button>
              <button type="button" class="hub-students-timeline-legend-item hub-students-timeline-type--case" data-timeline-source="case" role="switch" aria-pressed="true">Cases</button>
              <button type="button" class="hub-students-timeline-legend-item hub-students-timeline-type--activity" data-timeline-source="activity" role="switch" aria-pressed="true">Activities</button>
            </div>
            <div class="hub-students-timeline-help-anchor" id="hubStudentsTimelineHelpAnchor">
              <button type="button" class="hub-students-timeline-legend-item hub-students-timeline-help-btn" id="hubStudentsTimelineHelpBtn" aria-expanded="false" aria-controls="hubStudentsTimelineHelpPanel" aria-label="Timeline interaction help">
                <i class="bi bi-info-circle me-1" aria-hidden="true"></i>How to adjust
              </button>
              <div class="hub-students-timeline-help-panel d-none" id="hubStudentsTimelineHelpPanel" role="dialog" aria-labelledby="hubStudentsTimelineHelpTitle">
                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                  <span class="fw-bold small" id="hubStudentsTimelineHelpTitle">Timeline interaction help</span>
                  <button type="button" class="btn-close btn-close-sm mt-1" id="hubStudentsTimelineHelpClose" aria-label="Close help"></button>
                </div>
                <div class="hub-students-timeline-help-body small text-start">
                  <p class="mb-2"><strong>Drag up/down</strong> — shorten the vertical stem to zero on the timeline, then keep going to move the card above or below the axis (opposite of where it started); stem length can grow again on that side.</p>
                  <p class="mb-2"><strong>Drag horizontally</strong> — shrink the L-indent to zero, then cross left or right of the stem. The dot stays on its date.</p>
                  <p class="mb-2">Layout preferences are saved per student in this browser.</p>
                  <p class="mb-0"><strong>Ctrl+wheel</strong> (Cmd+wheel on Mac) zooms the timeline length; when zoomed, drag empty space or use the horizontal scrollbar to pan.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer py-2">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade hub-students-reports-modal" id="hubStudentsReportsModal" tabindex="-1" aria-labelledby="hubStudentsReportsModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable hub-students-reports-dialog">
    <div class="modal-content border-0 shadow">
      <div class="modal-header py-2">
        <h5 class="modal-title fw-bold" id="hubStudentsReportsModalLabel">Report instances</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body py-3">
        <div id="hubStudentsReportsLoading" class="hub-students-reports-loading text-center py-4" role="status" aria-live="polite">
          <span class="spinner-border text-primary" aria-hidden="true"></span>
          <div class="small text-muted fw-semibold mt-2">Loading report instances…</div>
        </div>
        <div id="hubStudentsReportsError" class="alert alert-danger d-none mb-0" role="alert"></div>
        <div id="hubStudentsReportsAccessNote" class="alert alert-light border small d-none mb-3" role="status"></div>
        <div id="hubStudentsReportsList" class="hub-students-reports-list d-none"></div>
      </div>
      <div class="modal-footer py-2 d-flex flex-wrap justify-content-between gap-2">
        <a href="#" id="hubStudentsReportsFullListLink" class="btn btn-outline-primary btn-sm d-none" target="_blank" rel="noopener noreferrer">
          <i class="bi bi-collection me-1"></i>All reports (person filter)
        </a>
        <button type="button" class="btn btn-outline-secondary btn-sm ms-auto" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade hub-students-embed-modal" id="hubStudentsEmbedModal" tabindex="-1" aria-labelledby="hubStudentsEmbedModalLabel" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-scrollable hub-students-embed-dialog">
    <div class="modal-content border-0 shadow">
      <div class="modal-header py-2">
        <h5 class="modal-title fw-bold text-truncate pe-3" id="hubStudentsEmbedModalLabel">Loading…</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body hub-students-embed-body p-0">
        <div class="hub-students-embed-loading" id="hubStudentsEmbedLoading" role="status" aria-live="polite">
          <span class="spinner-border text-primary" aria-hidden="true"></span>
          <span class="small text-muted fw-semibold">Loading page…</span>
        </div>
        <iframe class="hub-students-embed-frame" id="hubStudentsEmbedFrame" title="School tool workspace" loading="lazy"></iframe>
      </div>
    </div>
  </div>
</div>

