  async function loadRows() {
    const search = (typeof window !== 'undefined' && window.location && window.location.search)
      ? window.location.search
      : '';
    const result = await requestJson(`/school/classes/api/${encodeURIComponent(classId)}/enrollment-periods${search}`);
    if (!result) return;
    periodRows = Array.isArray(result.items) ? result.items : [];
    renderRows();
  }

  async function addPeriod() {
    if (enrollWizardStep === 'form') {
      readEnrollmentCapFields();
      if (hasTargetSessionCount() && hasTargetHours()) {
        await showMsg('Validation', 'warning', 'Set either a session target or an hour target, not both.');
        return;
      }
      if (isGroupSessionCapacityEnrollment()) {
        if (hasEnrollmentCap()) {
          if (!beginEnrollmentModalWork('Checking session alignment...')) return;
          try {
            const alignmentGate = await ensureEnrollmentSessionAlignment();
            if (!alignmentGate.ok) return;
          } finally {
            endEnrollmentModalWork();
          }
        }
        await proceedWithEnrollmentAfterAlignment();
        return;
      }
      const studentId = String(qs('inp_studentId')?.value || '').trim();
      const startDate = String(qs('inp_startDate')?.value || '').trim();
      if (!studentId || !startDate) {
        await showMsg('Missing Required Fields', 'warning', 'Student and Start Date are required.');
        return;
      }
      await runAlignmentRefresh({ showSpinner: !canUseLocalAlignment() });
      enrollWizardPath = 'oneOnOne';
      prepareUnmarkSessionsStep(lastAlignmentResult);
      enrollWizardStep = 'unmarkSessions';
      setEnrollmentWizardStepVisibility();
      return;
    }

    if (enrollWizardStep === 'unmarkSessions') {
      const selected = filterSelectableUnmarkSessionIds(readSelectedUnmarkSessionIds());
      if (!selected.length) {
        await showMsg('Validation', 'warning', 'Select at least one empty session to unmark.');
        return;
      }
      pendingUnmarkSessionIds = selected.slice();
      await proceedWithEnrollmentAfterAlignment();
      return;
    }

    if (enrollWizardStep === 'addSessions') {
      if (!beginEnrollmentModalWork('Refreshing session alignment...')) return;
      try {
        await refreshAlignmentWithStagedSessions();
        if (!await validateEnrollmentPickForContinue()) {
          syncEnrollmentWizardPrimaryButton();
          return;
        }
        syncPlannedNaFromIncludedSelection();
        if (pendingStagedSessions.length) {
          showBusy('Loading conflict review...');
          const loaded = await loadConflictReviewStep();
          if (!loaded) return;
          enrollWizardStep = 'conflicts';
          setEnrollmentWizardStepVisibility();
          return;
        }
      } finally {
        endEnrollmentModalWork();
      }
      await proceedWithEnrollmentAfterAlignment();
      return;
    }

    if (enrollWizardStep === 'markNa') {
      const requiredHours = Number(lastAlignmentResult?.requiredNaHours || 0);
      const requiredSessions = Number(lastAlignmentResult?.requiredNaCount || 0);
      const selectedHours = readSelectedNaSessionHours();
      const selectedSessions = readSelectedNaSessionIds();
      if (requiredHours > 0 && selectedHours < requiredHours) {
        await showMsg('Validation', 'warning', `Select sessions totaling at least ${requiredHours} hour(s) to mark N/A (selected ${selectedHours} hr).`);
        return;
      }
      if (requiredHours <= 0 && selectedSessions.length !== requiredSessions) {
        await showMsg('Validation', 'warning', `Select exactly ${requiredSessions} session(s) to mark N/A.`);
        return;
      }
      pendingPlannedNaSessionIds = selectedSessions.slice();
      if (pendingStagedSessions.length) {
        if (!beginEnrollmentModalWork('Loading conflict review...')) return;
        try {
          const loaded = await loadConflictReviewStep();
          if (!loaded) return;
          enrollWizardStep = 'conflicts';
          setEnrollmentWizardStepVisibility();
          return;
        } finally {
          endEnrollmentModalWork();
        }
      }
      await proceedWithEnrollmentAfterAlignment();
      return;
    }

    if (enrollWizardStep === 'conflicts') {
      if (conflictReviewHasConflicts) {
        await showMsg('Conflicts remain', 'warning', 'Go Back to the add-sessions step and resolve conflicts before adding the enrollment period.');
        return;
      }
      await proceedWithEnrollmentAfterAlignment();
    }
  }

  function isOpenEditableEnrollmentStatus(status) {
    return OPEN_EDITABLE_ENROLLMENT_STATUSES.includes(String(status || '').trim().toLowerCase());
  }

  function syncCloseModalUi() {
    const targetStatus = String(qs('close_status')?.value || 'completed').trim().toLowerCase();
    const isWithdrawn = targetStatus === 'withdrawn';
    const previewBtn = qs('btn_previewClosePeriod');
    const previewPanel = qs('close_statusPreview');
    if (previewBtn) previewBtn.classList.toggle('d-none', isWithdrawn);
    if (previewPanel) previewPanel.classList.toggle('d-none', isWithdrawn);
    if (isWithdrawn) {
      approvedCloseStatusPayload = null;
      syncCloseModalWithdrawnConfirmState();
    } else {
      approvedCloseStatusPayload = null;
      if (qs('btn_confirmClosePeriod')) qs('btn_confirmClosePeriod').disabled = true;
      if (previewPanel) {
        previewPanel.className = 'alert alert-light border mt-3 mb-0';
        previewPanel.textContent = 'Preview the financial effect before applying the status change.';
      }
    }
  }

  function syncCloseModalWithdrawnConfirmState() {
    const periodId = String(qs('close_periodId')?.value || '').trim();
    const effectiveDate = String(qs('close_endDate')?.value || '').trim();
    const reason = String(qs('close_reasonEnd')?.value || '').trim();
    const confirmBtn = qs('btn_confirmClosePeriod');
    if (!confirmBtn) return;
    confirmBtn.disabled = !(periodId && effectiveDate && reason);
  }

  function resetMovePreviewState() {
    approvedMovePayload = null;
    approvedMovePreviewHash = null;
    const applyBtn = qs('btn_applyMoveEnrollment');
    if (applyBtn) applyBtn.disabled = true;
    const panel = qs('move_previewPanel');
    if (panel) {
      panel.className = 'alert alert-light border mb-0';
      panel.textContent = 'Preview the move before applying it.';
    }
