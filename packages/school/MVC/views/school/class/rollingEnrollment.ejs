<div class="modal fade" id="programRegistrationShortcutModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <div>
          <h5 class="modal-title mb-1"><i class="bi bi-journal-plus me-1"></i>Register Student In Program</h5>
