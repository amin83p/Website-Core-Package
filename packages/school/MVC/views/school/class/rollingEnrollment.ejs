  function getGapSummaryTitle(alignment = lastAlignmentResult, status = '') {
    const hourMode = hasTargetHours() || Number(alignment?.effectiveTargetHours || 0) > 0;
    const normalized = String(status || alignment?.alignmentStatus || '').trim();
    if (normalized === 'overage_requires_na') {
      return hourMode ? 'Hours over target' : 'Sessions over target';
    }
    if (normalized === 'insufficient_hours') return 'Hours below target';
    if (normalized === 'insufficient_sessions') return 'Sessions below target';
    return hourMode ? 'Hour target alignment' : 'Session target alignment';
  }

  function buildGapSummaryDetail(alignment = lastAlignmentResult) {
    const hourMode = hasTargetHours() || Number(alignment?.effectiveTargetHours || 0) > 0;
    const status = String(alignment?.alignmentStatus || '').trim();
    if (hourMode) {
      const needHours = Number(alignment?.effectiveTargetHours || alignment?.targetHours || normalizeTargetHoursValue(qs('inp_targetHours')?.value));
      const availableHours = Number(alignment?.availableHours || 0);
      const gapHours = Number(alignment?.gapHours || Math.max(0, needHours - availableHours));
      if (status === 'overage_requires_na') {
        const excessHours = Number(alignment?.requiredNaHours || Math.max(0, availableHours - needHours));
        return `Need ${needHours} hour(s) from the start date, but ${availableHours} hour(s) are scheduled (${excessHours} hr over). Use Include in Actions to pick sessions for this enrollment, or stage sessions if needed.`;
      }
      if (status === 'insufficient_hours') {
        return `Need ${needHours} hour(s) from the start date, but only ${availableHours} hour(s) are scheduled (${gapHours} hr gap). Use Include in Actions and/or stage sessions below.`;
      }
      return `Target is ${needHours} hour(s) from the start date (${availableHours} hour(s) currently scheduled). Add or remove sessions below as needed.`;
    }
    const need = Number(alignment?.effectiveTarget || alignment?.targetSessionCount || 0);
    const available = Number(alignment?.availableCount || 0);
    const gap = Number(alignment?.gapCount || Math.max(0, need - available));
    if (status === 'overage_requires_na') {
      const excess = Number(alignment?.requiredNaCount || Math.max(0, available - need));
      return `Need ${need || 'at least 1'} countable session(s) between ${alignment?.startDate || ''} and ${alignment?.endDate || ''}, but ${available} exist (${excess} over). Use Include in Actions to pick sessions for this enrollment, or stage sessions if needed.`;
    }
    if (status === 'insufficient_sessions') {
      return `Need ${need || 'at least 1'} countable session(s) between ${alignment?.startDate || ''} and ${alignment?.endDate || ''}, but only ${available} exist. Use Include in Actions and/or stage sessions below.`;
    }
    return `Target is ${need || 'at least 1'} countable session(s) in the enrollment window (${available} currently scheduled). Add or remove sessions below as needed.`;
  }

