  function openEnrollmentOnHoldModal(periodId) {
    if (!canManageEnrollmentOffice) return;
    const row = (Array.isArray(periodRows) ? periodRows : []).find((item) => String(item?.id || '') === String(periodId || ''));
    if (!row || !onHoldModal) return;
    onHoldModalCurrentRow = row;
    approvedOnHoldPayload = null;
    clearOnHoldEditMode();
    qs('onHold_periodId').value = String(row?.id || '').trim();
    const enrollmentEnd = String(row?.endDate || '').trim() || 'Open';
    const contextText = qs('onHold_contextText');
    if (contextText) {
      contextText.textContent = `${row?.studentLabel || row?.studentId || ''} · Enrollment: ${row?.startDate || '?'} to ${enrollmentEnd}`;
    }
    qs('onHold_startDate').value = String(row?.startDate || '').trim();
    qs('onHold_endDate').value = String(row?.endDate || '').trim() || orgTodayFallback();
    qs('onHold_startDate').min = String(row?.startDate || '').trim();
    qs('onHold_endDate').min = String(row?.startDate || '').trim();
    if (row?.endDate) {
      qs('onHold_startDate').max = String(row.endDate).trim();
      qs('onHold_endDate').max = String(row.endDate).trim();
    } else {
      qs('onHold_startDate').removeAttribute('max');
      qs('onHold_endDate').removeAttribute('max');
    }
    qs('onHold_reason').value = '';
    renderOnHoldExistingRows(row?.enrollmentHoldPeriods || []);
    resetOnHoldPreviewState();
    onHoldModal.show();
  }

  async function previewEnrollmentHold() {
    const periodId = String(qs('onHold_periodId')?.value || '').trim();
    const payload = readOnHoldPayload();
    if (!periodId || !payload.startDate || !payload.endDate || !payload.reason) {
      await showMsg('Missing Fields', 'warning', 'Start date, end date, and reason are required.');
      return;
    }
    try {
      showBusy('Previewing on-hold period...');
      const result = await requestJson(`/school/classes/api/enrollment-periods/${encodeURIComponent(periodId)}/on-hold/preview`, 'POST', payload);
      if (!result) return;
      const preview = result.preview || {};
      if (onHoldModalCurrentRow && preview.existingHolds) {
        onHoldModalCurrentRow.enrollmentHoldPeriods = preview.existingHolds;
      }
      renderOnHoldExistingRows(preview.existingHolds || onHoldModalCurrentRow?.enrollmentHoldPeriods || []);
      const sessions = Array.isArray(preview.sessions) ? preview.sessions : [];
      const blockers = Array.isArray(preview.blockers) ? preview.blockers : [];
      const previewSessionIds = sessions.map((row) => String(row?.sessionId || '').trim()).filter(Boolean);
      openOnHoldCalendarPreview({
        periodId,
        previewSessionIds,
        previewKind: 'projected',
        anchorDate: payload.startDate,
        blockers
      });
      if (preview.canApply) {
        approvedOnHoldPayload = { ...payload };
        if (qs('btn_applyOnHoldPeriod')) qs('btn_applyOnHoldPeriod').disabled = false;
        setOnHoldApplyHint(`${sessions.length} session(s) ready to mark N/A on attendance.`, 'success');
      } else {
        approvedOnHoldPayload = null;
        if (qs('btn_applyOnHoldPeriod')) qs('btn_applyOnHoldPeriod').disabled = true;
        const blockerText = blockers.length
          ? blockers.map((row) => String(row?.message || '')).filter(Boolean).join(' ')
          : 'No sessions fall within this on-hold date range.';
        setOnHoldApplyHint(blockerText, 'warning');
      }
    } catch (error) {
      approvedOnHoldPayload = null;
      if (qs('btn_applyOnHoldPeriod')) qs('btn_applyOnHoldPeriod').disabled = true;
      setOnHoldApplyHint(error.message || 'Preview failed.', 'warning');
      await showMsg('Preview failed', 'error', error.message || 'Unable to preview on-hold period.');
    } finally {
      hideBusy();
    }
  }

  async function applyEnrollmentHold() {
    const periodId = String(qs('onHold_periodId')?.value || '').trim();
    const payload = readOnHoldPayload();
    const editingHoldId = String(qs('onHold_editingHoldId')?.value || '').trim();
    const approvedPayload = approvedOnHoldPayload || null;
    const comparablePayload = approvedPayload ? { ...approvedPayload } : null;
    const comparableCurrent = { ...payload };
    if (comparablePayload) delete comparablePayload.excludeHoldId;
    if (comparableCurrent.excludeHoldId && !editingHoldId) delete comparableCurrent.excludeHoldId;
    if (!approvedPayload || JSON.stringify(comparableCurrent) !== JSON.stringify(comparablePayload)) {
      await showMsg('Preview Required', 'warning', 'Preview the current dates and reason before applying the on-hold period.');
      if (qs('btn_applyOnHoldPeriod')) qs('btn_applyOnHoldPeriod').disabled = true;
      return;
    }
    try {
      const busyLabel = editingHoldId ? 'Updating on-hold period...' : 'Applying on-hold period...';
      showBusy(busyLabel);
      const submitPayload = {
        startDate: payload.startDate,
        endDate: payload.endDate,
        reason: payload.reason
      };
      const url = editingHoldId
        ? `/school/classes/api/enrollment-periods/${encodeURIComponent(periodId)}/on-hold/${encodeURIComponent(editingHoldId)}/update`
        : `/school/classes/api/enrollment-periods/${encodeURIComponent(periodId)}/on-hold/apply`;
      const result = await requestJson(url, 'POST', submitPayload);
      if (!result) return;
      onHoldModal.hide();
      onHoldModalCurrentRow = null;
      approvedOnHoldPayload = null;
      clearOnHoldEditMode();
      await showMsg('On Hold Saved', 'success', result.message || 'On-hold period saved.');
      await loadRows();
    } catch (error) {
      await showMsg('Save Failed', 'error', error.message || 'Unable to save on-hold period.');
    } finally {
      hideBusy();
    }
  }

  function startEditOnHoldPeriod(holdId) {
    const hold = findOnHoldPeriodById(holdId);
    if (!hold) return;
    qs('onHold_editingHoldId').value = String(hold.id || '').trim();
    qs('onHold_startDate').value = String(hold.startDate || '').trim();
    qs('onHold_endDate').value = String(hold.endDate || '').trim();
    qs('onHold_reason').value = String(hold.reason || '').trim();
    syncOnHoldFormMode();
    resetOnHoldPreviewState();
    qs('onHold_newPeriodSection')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  async function deleteOnHoldPeriod(holdId) {
    const hold = findOnHoldPeriodById(holdId);
    if (!hold) return;
    const confirmed = await showConfirm(
      `Remove the on-hold period from <b>${htmlEscape(String(hold.startDate || ''))}</b> to <b>${htmlEscape(String(hold.endDate || ''))}</b>?<br><br>Safe N/A markings from this hold will be reverted.`,
      'Delete On-Hold Period',
      { html: true, icon: 'warning', confirmText: 'Delete', confirmClass: 'btn-danger' }
    );
    if (!confirmed) return;
    const periodId = String(qs('onHold_periodId')?.value || '').trim();
    if (!periodId) return;
    try {
      showBusy('Removing on-hold period...');
      const result = await requestJson(
        `/school/classes/api/enrollment-periods/${encodeURIComponent(periodId)}/on-hold/${encodeURIComponent(hold.id)}/revoke`,
        'POST',
        {}
      );
      if (!result) return;
      if (String(qs('onHold_editingHoldId')?.value || '') === String(hold.id || '')) {
        clearOnHoldEditMode();
        qs('onHold_reason').value = '';
      }
      if (result.period) {
        onHoldModalCurrentRow = {
          ...(onHoldModalCurrentRow || {}),
          enrollmentHoldPeriods: result.period.enrollmentHoldPeriods || []
        };
        renderOnHoldExistingRows(onHoldModalCurrentRow.enrollmentHoldPeriods);
      }
      resetOnHoldPreviewState();
      await loadRows();
      const refreshedRow = (Array.isArray(periodRows) ? periodRows : []).find((item) => String(item?.id || '') === periodId);
      if (refreshedRow) {
        onHoldModalCurrentRow = refreshedRow;
        renderOnHoldExistingRows(refreshedRow.enrollmentHoldPeriods || []);
      }
      await showMsg('On Hold Removed', 'success', result.message || 'On-hold period removed.');
    } catch (error) {
      await showMsg('Delete Failed', 'error', error.message || 'Unable to remove on-hold period.');
    } finally {
      hideBusy();
    }
  }

  function handleOnHoldExistingBodyClick(event) {
    const previewBtn = event.target.closest('.btn-onhold-preview');
    if (previewBtn) {
      const hold = findOnHoldPeriodById(previewBtn.getAttribute('data-hold-id'));
      if (!hold) return;
      openOnHoldCalendarPreview({
        periodId: String(qs('onHold_periodId')?.value || '').trim(),
        previewSessionIds: Array.isArray(hold.sessionIds) ? hold.sessionIds : [],
        previewKind: 'applied',
        anchorDate: hold.startDate
      });
      return;
    }
    const editBtn = event.target.closest('.btn-onhold-edit');
    if (editBtn) {
      startEditOnHoldPeriod(editBtn.getAttribute('data-hold-id'));
      return;
    }
    const deleteBtn = event.target.closest('.btn-onhold-delete');
    if (deleteBtn) {
      deleteOnHoldPeriod(deleteBtn.getAttribute('data-hold-id'));
    }
  }

  async function openEnrollmentSessionManagerModal(periodId) {
    if (!canManageEnrollmentOffice) return;
    const row = (Array.isArray(periodRows) ? periodRows : []).find((item) => String(item?.id || '') === String(periodId || ''));
    if (window.SessionEnrollmentCalendarModal && window.SessionCalendarCore) {
      window.SessionEnrollmentCalendarModal.open({
        mode: 'manageEnrollmentSessions',
        periodId: String(periodId || ''),
        classId,
        studentId: String(row?.studentId || '').trim(),
        studentLabel: String(row?.studentLabel || row?.studentId || '').trim(),
        classLabel: String(classId || '').trim(),
        startDate: String(row?.startDate || '').trim(),
        endDate: String(row?.endDate || '').trim(),
        cycleEndDate: String(cycleWindow?.endDate || '').trim(),
        targetSessionCount: Number(row?.targetSessionCount || 0),
        targetHours: Number(row?.targetHours || 0),
        requestJson,
        onMarksChanged: async () => {
          await loadRows();
        }
      });
      return;
    }
    const modalEl = document.getElementById('enrollmentSessionManagerModal');
    const bodyEl = document.getElementById('enrollmentSessionManagerBody');
    const summaryEl = document.getElementById('enrollmentSessionManagerSummary');
    if (!modalEl || !bodyEl) return;
    bodyEl.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4">Loading sessions...</td></tr>';
    if (summaryEl) summaryEl.textContent = '';
    const result = await requestJson(`/school/classes/api/enrollment-periods/${encodeURIComponent(periodId)}/session-window`);
    if (!result || result.status !== 'success') return;
    const data = result.data || {};
    if (summaryEl) {
      const summary = data.cycleAttendanceSummary;
      const parts = [`Enrollment window: ${data.startDate || '-'} to ${data.endDate || 'Open'}`];
      if (summary) {
        parts.push(`Consumed ${summary.consumedSessions || 0} session(s); present ${summary.present || 0}, absent ${summary.absent || 0} (${summary.absentExcused || 0} excused), ACF ${summary.acf || 0} (${summary.acfExcused || 0} excused).`);
      }
      summaryEl.textContent = parts.join(' · ');
    }
    const sessions = Array.isArray(data.sessions) ? data.sessions : [];
    if (!sessions.length) {
      bodyEl.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4">No sessions in this enrollment window.</td></tr>';
    } else {
      bodyEl.innerHTML = sessions.map((row) => {
        const marked = Boolean(row.mark);
        const note = marked ? String(row.mark?.note || '') : '';
        const actionLabel = marked ? 'Unmark N/A' : 'Mark N/A';
        const action = marked ? 'unmark' : 'mark_na';
        return `<tr data-session-id="${htmlEscape(String(row.sessionId || ''))}">
          <td>${htmlEscape(String(row.date || '-'))}</td>
          <td>${htmlEscape(`${row.startTime || ''} - ${row.endTime || ''}`.trim())}</td>
          <td>${htmlEscape(String(row.attendance || '-'))}</td>
          <td>${marked ? '<span class="badge bg-secondary">N/A (locked)</span>' : '<span class="text-muted">Expected</span>'}</td>
          <td class="small">${htmlEscape(note)}</td>
          <td class="text-end">
            ${action === 'mark_na' ? `<input type="text" class="form-control form-control-sm enrollment-session-mark-note mb-1" placeholder="Required note">` : ''}
            <button type="button" class="btn btn-outline-primary btn-sm js-enrollment-session-mark" data-period-id="${htmlEscape(String(periodId))}" data-session-id="${htmlEscape(String(row.sessionId || ''))}" data-action="${action}">${actionLabel}</button>
          </td>
        </tr>`;
      }).join('');
    }
    bootstrap.Modal.getOrCreateInstance(modalEl).show();
  }

  function syncExtensionEnrollmentFields() {
    const kind = String(qs('extension_kind')?.value || 'additional_sessions');
    qs('extension_sessionsWrap')?.classList.toggle('d-none', kind !== 'additional_sessions');
    qs('extension_hoursWrap')?.classList.toggle('d-none', kind !== 'additional_hours');
    qs('extension_endDateWrap')?.classList.toggle('d-none', kind !== 'extended_end_date');
  }

  function openExtensionEnrollmentModal(periodId) {
    if (!canManageEnrollmentOffice) return;
    const row = (Array.isArray(periodRows) ? periodRows : []).find((item) => String(item?.id || '') === String(periodId || ''));
    const modalEl = document.getElementById('extensionEnrollmentModal');
    if (!modalEl) return;
    qs('extension_sourcePeriodId').value = String(periodId || '');
    qs('extension_kind').value = (normalizeTargetSessionCountValue(row?.targetSessionCount) > 0)
      ? 'additional_sessions'
      : (normalizeTargetHoursValue(row?.targetHours) > 0 ? 'additional_hours' : 'extended_end_date');
    qs('extension_startDate').value = orgTodayFallback();
    qs('extension_reason').value = '';
    syncExtensionEnrollmentFields();
    bootstrap.Modal.getOrCreateInstance(modalEl).show();
  }

  async function submitExtensionEnrollment() {
    const periodId = String(qs('extension_sourcePeriodId')?.value || '').trim();
    if (!periodId) return;
    const payload = {
      extensionKind: String(qs('extension_kind')?.value || '').trim(),
      additionalSessions: Number(qs('extension_additionalSessions')?.value || 0),
      additionalHours: Number(qs('extension_additionalHours')?.value || 0),
      newEndDate: String(qs('extension_newEndDate')?.value || '').trim(),
      startDate: String(qs('extension_startDate')?.value || '').trim(),
      reason: String(qs('extension_reason')?.value || '').trim()
    };
    const result = await requestJson(`/school/classes/api/enrollment-periods/${encodeURIComponent(periodId)}/extension`, {
      method: 'POST',
      body: JSON.stringify(payload)
    });
    if (!result || result.status !== 'success') return;
    bootstrap.Modal.getInstance(document.getElementById('extensionEnrollmentModal'))?.hide();
    await showMsg('Extension created', 'success', 'Extension enrollment was created successfully.');
    await loadRows();
  }

  document.getElementById('enrollmentSessionManagerBody')?.addEventListener('click', async (event) => {
    const btn = event.target.closest('.js-enrollment-session-mark');
    if (!btn) return;
    const periodId = String(btn.getAttribute('data-period-id') || '').trim();
    const sessionId = String(btn.getAttribute('data-session-id') || '').trim();
    const action = String(btn.getAttribute('data-action') || '').trim();
    const row = btn.closest('tr');
    const note = String(row?.querySelector('.enrollment-session-mark-note')?.value || '').trim();
    if (action === 'mark_na' && !note) {
      await showMsg('Note required', 'warning', 'Enter a note explaining why this session is N/A.');
      return;
    }
    const result = await requestJson(`/school/classes/api/enrollment-periods/${encodeURIComponent(periodId)}/session-marks`, {
      method: 'POST',
      body: JSON.stringify({ changes: [{ sessionId, action, note }] })
    });
    if (!result || result.status !== 'success') return;
    await openEnrollmentSessionManagerModal(periodId);
    await loadRows();
  });

