  function isOpenStatus(status) {
    const s = String(status || '').trim().toLowerCase();
    return ['draft', 'planned', 'to_be_confirmed', 'waiting_list', 'active'].includes(s);
  }

  const ENDED_ENROLLMENT_STATUSES = new Set([
    'completed',
    'withdrawn',
    'cancelled',
    'archived',
    'void',
    'error'
  ]);

  function isEndedEnrollmentRow(row = {}) {
    const status = String(row?.status || '').trim().toLowerCase();
    if (ENDED_ENROLLMENT_STATUSES.has(status)) return true;

    const completion = row?.sessionCompletion
      || (row?.completionDate ? { date: row.completionDate } : null);
    if (String(completion?.date || '').trim()) return true;

    const explicitTargetSessionCount = normalizeTargetSessionCountValue(row?.targetSessionCount);
    const explicitTargetHours = normalizeTargetHoursValue(row?.targetHours);
    const hasEnrollmentTarget = explicitTargetSessionCount > 0 || explicitTargetHours > 0;
    if (hasEnrollmentTarget) return false;

    const endDate = String(row?.endDate || '').trim();
    const today = orgTodayFallback();
    return Boolean(endDate && today && endDate < today);
  }

  function formatPeriodStatusLabel(status) {
    const s = String(status || '').trim().toLowerCase();
    if (s === 'to_be_confirmed') return 'To be Confirmed';
    if (s === 'waiting_list') return 'Waiting list';
    if (!s) return '-';
    return s.replace(/_/g, ' ').replace(/\b\w/g, (ch) => ch.toUpperCase());
  }

  function buildEnrollmentDetailApiUrl(studentId, enrollmentId) {
    const normalizedStudentId = String(studentId || '').trim();
    const normalizedEnrollmentId = String(enrollmentId || '').trim();
    if (!normalizedStudentId || !normalizedEnrollmentId) return '';
    return `/school/academic-ledger/student-overview/${encodeURIComponent(normalizedStudentId)}/enrollment-detail/${encodeURIComponent(normalizedEnrollmentId)}`;
