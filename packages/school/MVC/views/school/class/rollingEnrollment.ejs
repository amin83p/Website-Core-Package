<%
  const c = classData || {};
  const lifecycle = lifecycleContext || {};
  const isRolling = String(c.registrationMode || '').trim().toLowerCase() === 'rolling';
  const cycleStartDate = String(lifecycle.cycleStartDate || c.cycleStartDate || '').trim();
  const cycleEndDate = String(lifecycle.cycleEndDate || c.cycleEndDate || '').trim();
  const isClosedForNewEnrollment = lifecycle.isClosedForNewEnrollment === true
    || c.isClosedForNewEnrollment === true
    || String(lifecycle.isClosedForNewEnrollment || c.isClosedForNewEnrollment || '').trim().toLowerCase() === 'true';
  const nextCycleClassId = String(lifecycle.nextClass?.id || c.nextClassId || '').trim();
  const nextCycleClassTitle = String(lifecycle.nextClass?.title || '').trim();
  const asid = (typeof actionStateId !== 'undefined' && actionStateId) ? actionStateId : '';
  function jsonForScript(value) {
    return JSON.stringify(value)
      .replace(/</g, '\\u003c')
      .replace(/\u2028/g, '\\u2028')
      .replace(/\u2029/g, '\\u2029');
  }
  const initialRowsJson = jsonForScript(Array.isArray(periodRows) ? periodRows : []);
  const studentOptionsJson = jsonForScript(Array.isArray(studentOptions) ? studentOptions : []);
  const funderOptionsJson = jsonForScript(Array.isArray(funderOptions) ? funderOptions : []);
  const enrollmentProgramChoicesJson = jsonForScript(Array.isArray(enrollmentProgramChoices) ? enrollmentProgramChoices : []);
  const canCreateProgramRegistrationsJson = jsonForScript(Boolean(typeof canCreateProgramRegistrations !== 'undefined' && canCreateProgramRegistrations));
  const canCreatePriorSubjectCreditsJson = jsonForScript(Boolean(typeof canCreatePriorSubjectCredits !== 'undefined' && canCreatePriorSubjectCredits));
  const classInstructors = Array.isArray(c.instructors) ? c.instructors : [];
  const defaultInstructor = classInstructors.find((row) => String(row?.status || '').trim().toLowerCase() === 'active') || classInstructors[0] || null;
  const defaultTeacherJson = jsonForScript({
    teacherId: String(defaultInstructor?.personId || '').trim(),
    teacherName: String(defaultInstructor?.name || '').trim()
  });
  const rollingClassDataJson = jsonForScript({
    id: String(c.id || ''),
    orgId: String(c.orgId || ''),
    room: String(c.room || ''),
    instructors: classInstructors,
    maxCapacity: Number(c?.enrollment?.maxCapacity || c?.maxCapacity || 0)
  });
  const orgTodayJson = jsonForScript(typeof orgToday !== 'undefined' ? orgToday : '');
  const classIdJson = jsonForScript(String(c.id || ''));
  const actionStateIdJson = jsonForScript(String(asid || ''));
  const cycleStartDateJson = jsonForScript(cycleStartDate);
  const cycleEndDateJson = jsonForScript(cycleEndDate);
  const isClosedForNewEnrollmentJson = jsonForScript(Boolean(isClosedForNewEnrollment));
  const canManageEnrollmentOfficeJson = jsonForScript(Boolean(typeof canManageEnrollmentOffice !== 'undefined' && canManageEnrollmentOffice));
  const canEditStudentClbJson = jsonForScript(Boolean(typeof canEditStudentClb !== 'undefined' && canEditStudentClb));
  const isRollingJson = jsonForScript(Boolean(isRolling));
  const rollingFilters = (typeof filters !== 'undefined' && filters && typeof filters === 'object') ? filters : {};
  const hasRollingFiltersAppliedFlag = typeof hasRollingFiltersApplied !== 'undefined' && hasRollingFiltersApplied === true;
  const rollingEnrollmentGroupOptions = Array.isArray(typeof enrollmentGroupOptions !== 'undefined' ? enrollmentGroupOptions : null)
    ? enrollmentGroupOptions
    : [];
  const rollingPeriodStatusOptions = Array.isArray(typeof periodStatusOptions !== 'undefined' ? periodStatusOptions : null)
    ? periodStatusOptions
    : [];
  const rollingTargetTypeOptions = Array.isArray(typeof targetTypeOptions !== 'undefined' ? targetTypeOptions : null)
    ? targetTypeOptions
    : [];
  const rollingFunderOptions = Array.isArray(funderOptions) ? funderOptions : [];
