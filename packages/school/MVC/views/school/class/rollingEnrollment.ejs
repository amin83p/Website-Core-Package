  async function saveEnrollmentNote() {
    const periodId = String(qs('enrollmentNote_periodId')?.value || '').trim();
    const notes = String(qs('enrollmentNote_text')?.value || '').trim();
    if (!periodId) return;
    const saveBtn = qs('btn_saveEnrollmentNote');
    if (saveBtn) {
      saveBtn.disabled = true;
      saveBtn.textContent = 'Saving...';
    }
    try {
      showBusy('Saving enrollment note...');
      const result = await requestJson(
        `/school/classes/api/enrollment-periods/${encodeURIComponent(periodId)}/notes`,
        'POST',
        { notes }
      );
      if (!result) return;
      const savedNotes = String(result.notes ?? result.data?.notes ?? notes).trim();
      const row = (Array.isArray(periodRows) ? periodRows : []).find((item) => String(item?.id || '') === periodId);
      if (row) row.notes = savedNotes;
      enrollmentNoteModal.hide();
      await showMsg('Saved', 'success', result.message || 'Enrollment note saved.');
    } catch (error) {
      await showMsg('Save Failed', 'error', error.message || 'Could not save enrollment note.');
    } finally {
      hideBusy();
      if (saveBtn) {
        saveBtn.disabled = false;
        saveBtn.textContent = 'Save Note';
      }
    }
