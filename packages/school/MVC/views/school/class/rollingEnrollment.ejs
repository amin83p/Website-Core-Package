  function bindDraftRowAccountPickers() {
    document.querySelectorAll('#draftTransactionsTbody tr[data-draft-row-index]').forEach(function (row) {
      const debitBtn = row.querySelector('.draft-change-debit-account');
      const creditBtn = row.querySelector('.draft-change-credit-account');
      if (debitBtn && !debitBtn.dataset.boundPicker) {
        debitBtn.dataset.boundPicker = '1';
        debitBtn.addEventListener('click', function () { openDraftRowAccountPicker(row, 'debit'); });
      }
      if (creditBtn && !creditBtn.dataset.boundPicker) {
        creditBtn.dataset.boundPicker = '1';
        creditBtn.addEventListener('click', function () { openDraftRowAccountPicker(row, 'credit'); });
      }
    });
  }

  function updateDraftTotalsIndicator() {
    const draftRowsTotal = Array.from(document.querySelectorAll('#draftTransactionsTbody tr[data-draft-row-index]')).reduce(function (sum, row) {
      const include = row.querySelector('.draft-include')?.checked !== false;
      if (!include) return sum;
      const amount = Number(row.querySelector('.draft-amount')?.value || 0);
      if (!Number.isFinite(amount) || amount <= 0) return sum;
      return sum + amount;
    }, 0);

    const manualRowsTotal = manualRows.reduce(function (sum, row) {
      const amount = Number(row?.amount || 0);
      if (!Number.isFinite(amount) || amount <= 0) return sum;
      return sum + amount;
    }, 0);

    const draftTotal = Number(draftRowsTotal.toFixed(2));
    const manualTotal = Number(manualRowsTotal.toFixed(2));
    const projected = Number((draftTotal + manualTotal).toFixed(2));

    const draftLabel = qs('txt_draftRowsTotal');
    const manualLabel = qs('txt_manualRowsTotal');
    const projectedLabel = qs('txt_projectedRowsTotal');
    if (draftLabel) draftLabel.textContent = draftTotal.toFixed(2);
    if (manualLabel) manualLabel.textContent = manualTotal.toFixed(2);
    if (projectedLabel) projectedLabel.textContent = projected.toFixed(2);
  }

  function collectEditedRows() {
    return Array.from(document.querySelectorAll('#draftTransactionsTbody tr[data-draft-row-index]')).map(function (row) {
      const rowIndex = Number(row.getAttribute('data-draft-row-index'));
      const include = row.querySelector('.draft-include')?.checked !== false;
      const amount = Number(row.querySelector('.draft-amount')?.value || 0);
      const memo = String(row.querySelector('.draft-memo')?.value || '').trim();
      const debitAccountId = String(row.querySelector('.draft-debit-account-id')?.value || '').trim();
      const creditAccountId = String(row.querySelector('.draft-credit-account-id')?.value || '').trim();
      return { rowIndex, include, amount, memo, debitAccountId, creditAccountId };
    }).filter(function (row) {
      return Number.isInteger(row.rowIndex) && row.rowIndex >= 0;
    });
  }

  function collectAddedRows() {
    return manualRows.map(function (row) {
      return {
        debitAccountId: String(row.debitAccountId || '').trim(),
        creditAccountId: String(row.creditAccountId || '').trim(),
        amount: Number(row.amount || 0),
        currency: String(row.currency || 'CAD').trim().toUpperCase() || 'CAD',
        memo: String(row.memo || '').trim()
      };
    });
  }

  function renderManualRows() {
    const tbodyManual = qs('manualRowsTbody');
    if (!tbodyManual) return;
    if (!manualRows.length) {
      tbodyManual.innerHTML = '<tr data-empty-row="1"><td colspan="5" class="text-center text-muted py-3">No manual rows added.</td></tr>';
      updateDraftTotalsIndicator();
      return;
    }

    tbodyManual.innerHTML = manualRows.map(function (row, index) {
      return ''
        + '<tr data-manual-row-index="' + index + '">'
        +   '<td><div class="fw-bold font-monospace">' + htmlEscape(row.debitAccountCode || row.debitAccountId || '-') + '</div><div class="small text-muted">' + htmlEscape(row.debitAccountName || '-') + '</div></td>'
        +   '<td><div class="fw-bold font-monospace">' + htmlEscape(row.creditAccountCode || row.creditAccountId || '-') + '</div><div class="small text-muted">' + htmlEscape(row.creditAccountName || '-') + '</div></td>'
        +   '<td class="fw-bold">' + Number(row.amount || 0).toFixed(2) + ' ' + htmlEscape(row.currency || 'CAD') + '</td>'
        +   '<td class="small">' + htmlEscape(row.memo || '-') + '</td>'
        +   '<td class="text-end"><button type="button" class="btn btn-outline-danger btn-sm" data-remove-manual-row="' + index + '">Remove</button></td>'
        + '</tr>';
    }).join('');

    tbodyManual.querySelectorAll('button[data-remove-manual-row]').forEach(function (button) {
      button.addEventListener('click', function () {
        const idx = Number(button.getAttribute('data-remove-manual-row'));
        if (!Number.isInteger(idx) || idx < 0 || idx >= manualRows.length) return;
        manualRows.splice(idx, 1);
        renderManualRows();
      });
    });
    updateDraftTotalsIndicator();
  }

  function renderDraftTransactionRows(rows) {
    const tbodyDraft = qs('draftTransactionsTbody');
    const draftRows = Array.isArray(rows) ? rows : [];
    if (!tbodyDraft) return;
    if (!draftRows.length) {
      tbodyDraft.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-3">No draft transaction rows available.</td></tr>';
      return;
    }

    tbodyDraft.innerHTML = draftRows.map(function (row) {
      const amount = Number(row?.amount || 0);
      return ''
        + '<tr data-draft-row-index="' + Number(row?.rowIndex || 0) + '">'
        +   '<td><div class="form-check"><input class="form-check-input draft-include" type="checkbox" checked></div></td>'
        +   '<td>'
        +     '<div class="fw-bold font-monospace draft-debit-account-code">' + htmlEscape(row?.debitAccount?.code || row?.debitAccount?.id || '-') + '</div>'
        +     '<div class="small text-muted draft-debit-account-name">' + htmlEscape(row?.debitAccount?.name || '-') + '</div>'
        +     '<input type="hidden" class="draft-debit-account-id" value="' + htmlEscape(String(row?.debitAccount?.id || '')) + '">'
        +     '<button type="button" class="btn btn-outline-secondary btn-sm mt-1 draft-change-debit-account"><i class="bi bi-search me-1"></i>Change</button>'
        +   '</td>'
        +   '<td>'
        +     '<div class="fw-bold font-monospace draft-credit-account-code">' + htmlEscape(row?.creditAccount?.code || row?.creditAccount?.id || '-') + '</div>'
        +     '<div class="small text-muted draft-credit-account-name">' + htmlEscape(row?.creditAccount?.name || '-') + '</div>'
        +     '<input type="hidden" class="draft-credit-account-id" value="' + htmlEscape(String(row?.creditAccount?.id || '')) + '">'
        +     '<button type="button" class="btn btn-outline-secondary btn-sm mt-1 draft-change-credit-account"><i class="bi bi-search me-1"></i>Change</button>'
        +   '</td>'
        +   '<td><div class="input-group input-group-sm"><input type="number" class="form-control draft-amount" min="0.01" step="0.01" value="' + Number(amount.toFixed(2)) + '"><span class="input-group-text">' + htmlEscape(row?.currency || 'CAD') + '</span></div></td>'
        +   '<td><input type="text" class="form-control form-control-sm draft-memo" value="' + htmlEscape(row?.memo || '') + '" placeholder="Memo"></td>'
        + '</tr>';
    }).join('');

    document.querySelectorAll('#draftTransactionsTbody .draft-include, #draftTransactionsTbody .draft-amount').forEach(function (el) {
      el.addEventListener('change', updateDraftTotalsIndicator);
      el.addEventListener('input', updateDraftTotalsIndicator);
    });
    bindDraftRowAccountPickers();
    updateDraftTotalsIndicator();
  }

  function resetChargeModalState() {
    pendingEnrollmentPayload = null;
    pendingDraftTransactionItems = [];
    manualRows = [];
    draftReviewMode = 'create';
    if (qs('charge_draftPeriodId')) qs('charge_draftPeriodId').value = '';
    if (qs('charge_startDate')) qs('charge_startDate').value = '';
    if (qs('charge_endDate')) qs('charge_endDate').value = '';
    if (qs('charge_status')) qs('charge_status').value = 'active';
    renderDraftTransactionRows([]);
    renderManualRows();
    clearManualAccount('Debit');
    clearManualAccount('Credit');
    if (qs('inp_manualAmount')) qs('inp_manualAmount').value = '';
    if (qs('inp_manualCurrency')) qs('inp_manualCurrency').value = 'CAD';
    if (qs('inp_manualMemo')) qs('inp_manualMemo').value = '';
    setChargeSummaryText('Review and adjust draft rows before posting.');
    setChargeModalMode('create');
  }

  function openChargeModalWithDraft(payload, draft, options = {}) {
    pendingEnrollmentPayload = { ...(payload || {}) };
    pendingDraftTransactionItems = Array.isArray(draft?.draftTransactionItems) ? draft.draftTransactionItems : [];
    manualRows = [];
    const isReview = String(options?.mode || '').trim().toLowerCase() === 'review';
    setChargeModalMode(isReview ? 'review' : 'create');

    if (qs('charge_draftPeriodId')) qs('charge_draftPeriodId').value = String(options?.periodId || '').trim();
    if (qs('charge_startDate')) qs('charge_startDate').value = String(payload?.startDate || '').trim();
    if (qs('charge_endDate')) qs('charge_endDate').value = String(payload?.endDate || '').trim();
    if (qs('charge_status')) qs('charge_status').value = String(payload?.status || 'draft').trim().toLowerCase() || 'draft';

    renderManualRows();
    renderDraftTransactionRows(Array.isArray(draft?.draftPreviewRows) ? draft.draftPreviewRows : []);
    const txName = String(draft?.classFeeRule?.transactionDefinitionName || draft?.classFeeRule?.transactionDefinitionCode || '').trim();
    const feeCategory = String(draft?.feeCategory || '').trim();
    const total = Number(draft?.totalAmount || 0).toFixed(2);
    const summaryParts = [
      feeCategory ? `Fee Category: ${feeCategory}` : '',
      txName ? `Template: ${txName}` : '',
      `Draft Total: ${total}`,
      isReview ? 'Mode: Review Draft' : 'Mode: New Draft'
    ].filter(Boolean);
    setChargeSummaryText(summaryParts.join(' | '));

    if (!chargeModal || typeof chargeModal.show !== 'function') {
      showMsg(
        'Draft Unavailable',
        'error',
        'Draft was generated, but the review panel could not be opened. Transactions were not posted. Please reload the page and try again.'
      );
      return;
    }

    addEnrollmentModal?.hide();
    chargeModal.show();
  }

  async function addManualRow() {
    const debitAccountId = String(qs('inp_manualDebitAccountId')?.value || '').trim();
    const creditAccountId = String(qs('inp_manualCreditAccountId')?.value || '').trim();
    const debitLabel = String(qs('inp_manualDebitAccountLabel')?.value || '').trim();
    const creditLabel = String(qs('inp_manualCreditAccountLabel')?.value || '').trim();
    const amount = Number(qs('inp_manualAmount')?.value || 0);
    const currency = String(qs('inp_manualCurrency')?.value || 'CAD').trim().toUpperCase();
    const memo = String(qs('inp_manualMemo')?.value || '').trim();

    if (!debitAccountId || !creditAccountId) {
      await showMsg('Validation', 'warning', 'Both debit and credit accounts are required.');
      return;
    }
    if (debitAccountId === creditAccountId) {
      await showMsg('Validation', 'warning', 'Debit and credit accounts cannot be the same.');
      return;
    }
    if (!Number.isFinite(amount) || amount <= 0) {
      await showMsg('Validation', 'warning', 'Amount must be greater than zero.');
      return;
    }
    if (!/^[A-Z]{3}$/.test(currency)) {
      await showMsg('Validation', 'warning', 'Currency must be a valid ISO code (for example CAD).');
      return;
    }

    manualRows.push({
      debitAccountId,
      debitAccountCode: debitLabel.split(' - ')[0] || debitAccountId,
      debitAccountName: debitLabel,
      creditAccountId,
      creditAccountCode: creditLabel.split(' - ')[0] || creditAccountId,
      creditAccountName: creditLabel,
      amount,
      currency,
      memo
    });

    clearManualAccount('Debit');
    clearManualAccount('Credit');
    if (qs('inp_manualAmount')) qs('inp_manualAmount').value = '';
    if (qs('inp_manualCurrency')) qs('inp_manualCurrency').value = 'CAD';
    if (qs('inp_manualMemo')) qs('inp_manualMemo').value = '';
    renderManualRows();
  }

  async function submitChargeableEnrollment() {
    if (chargeActionInProgress) return;
    if (!pendingEnrollmentPayload || !pendingDraftTransactionItems.length) {
      await showMsg('Missing Draft', 'warning', 'Transaction draft is missing. Re-run Add Period.');
      return;
    }
    chargeActionInProgress = true;
    try {
      showBusy('Saving enrollment and posting transactions...');
      const draftContext = readChargeModalDraftContext();
      if (!draftContext.startDate) {
        await showMsg('Validation', 'warning', 'Effective Start Date is required.');
        return;
      }
      const result = await requestJson('/school/classes/api/enrollment-periods/create-with-transactions', 'POST', {
        ...pendingEnrollmentPayload,
        startDate: draftContext.startDate,
        endDate: draftContext.endDate,
        status: draftContext.status || 'draft',
        funderType: draftContext.funderType,
        funderId: draftContext.funderId,
        authorizationRef: draftContext.authorizationRef,
        reasonStart: draftContext.reasonStart,
        targetSessionCount: draftContext.targetSessionCount,
        targetHours: draftContext.targetHours,
        sessionCountPolicy: draftContext.sessionCountPolicy,
        plannedNotApplicableSessionIds: Array.isArray(pendingEnrollmentPayload?.plannedNotApplicableSessionIds)
          ? pendingEnrollmentPayload.plannedNotApplicableSessionIds
          : [],
        draftTransactionItems: pendingDraftTransactionItems,
        editedRows: collectEditedRows(),
        addedRows: collectAddedRows()
      });
      if (!result) return;
      chargeModal?.hide();
      await showMsg('Success', 'success', result.message || 'Draft enrollment saved.');
      await loadRows();
      clearEntryDraft();
      resetChargeModalState();
      qs('inp_startDate')?.focus();
    } catch (error) {
      await showMsg('Create Failed', 'error', error.message || 'Unable to create enrollment and post transactions.');
    } finally {
      chargeActionInProgress = false;
      hideBusy();
    }
  }

  async function saveExistingDraftEnrollment() {
    if (chargeActionInProgress) return;
    const draftContext = readChargeModalDraftContext();
    if (!draftContext.periodId) {
      await showMsg('Validation', 'warning', 'Draft period id is missing.');
      return;
    }
    if (!draftContext.startDate) {
      await showMsg('Validation', 'warning', 'Effective Start Date is required.');
      return;
    }
    chargeActionInProgress = true;
    try {
      showBusy('Saving draft changes...');
      const result = await requestJson(`/school/classes/api/enrollment-periods/${encodeURIComponent(draftContext.periodId)}/draft`, 'POST', {
        startDate: draftContext.startDate,
        endDate: draftContext.endDate,
        status: draftContext.status,
        funderType: draftContext.funderType,
        funderId: draftContext.funderId,
        authorizationRef: draftContext.authorizationRef,
        reasonStart: draftContext.reasonStart,
        targetSessionCount: draftContext.targetSessionCount,
        targetHours: draftContext.targetHours,
        sessionCountPolicy: draftContext.sessionCountPolicy,
        plannedNotApplicableSessionIds: Array.isArray(pendingEnrollmentPayload?.plannedNotApplicableSessionIds)
          ? pendingEnrollmentPayload.plannedNotApplicableSessionIds
          : [],
        draftTransactionItems: pendingDraftTransactionItems,
        editedRows: collectEditedRows(),
        addedRows: collectAddedRows()
      });
      if (!result) return;
      await showMsg('Saved', 'success', result.message || 'Draft enrollment updated.');
      await loadRows();
    } catch (error) {
      await showMsg('Save Failed', 'error', error.message || 'Unable to save draft changes.');
    } finally {
      chargeActionInProgress = false;
      hideBusy();
    }
  }

  async function approveDraftEnrollment() {
    if (chargeActionInProgress) return;
    const draftContext = readChargeModalDraftContext();
    if (!draftContext.periodId) {
      await showMsg('Validation', 'warning', 'Draft period id is missing.');
      return;
    }
    if (!draftContext.startDate) {
      await showMsg('Validation', 'warning', 'Effective Start Date is required.');
      return;
    }
    chargeActionInProgress = true;
    try {
      showBusy('Approving draft and posting transactions...');
      const result = await requestJson(`/school/classes/api/enrollment-periods/${encodeURIComponent(draftContext.periodId)}/approve`, 'POST', {
        startDate: draftContext.startDate,
        endDate: draftContext.endDate,
        status: ['active', 'to_be_confirmed', 'waiting_list'].includes(draftContext.status)
          ? draftContext.status
          : 'active',
        funderType: draftContext.funderType,
        funderId: draftContext.funderId,
        authorizationRef: draftContext.authorizationRef,
        reasonStart: draftContext.reasonStart,
        targetSessionCount: draftContext.targetSessionCount,
        targetHours: draftContext.targetHours,
        sessionCountPolicy: draftContext.sessionCountPolicy,
        plannedNotApplicableSessionIds: Array.isArray(pendingEnrollmentPayload?.plannedNotApplicableSessionIds)
          ? pendingEnrollmentPayload.plannedNotApplicableSessionIds
          : [],
        draftTransactionItems: pendingDraftTransactionItems,
        editedRows: collectEditedRows(),
        addedRows: collectAddedRows()
      });
      if (!result) return;
      chargeModal?.hide();
      const approveIcon = (result.academicLedger && ['skipped_no_program', 'skipped_program_not_found', 'error'].includes(result.academicLedger.status))
        ? 'warning'
        : 'success';
      await showMsg('Approved', approveIcon, (result.message || 'Draft approved and posted.') + academicLedgerHtmlNote(result.academicLedger));
      await loadRows();
      resetChargeModalState();
      clearEntryDraft();
    } catch (error) {
      await showMsg('Approve Failed', 'error', error.message || 'Unable to approve draft.');
    } finally {
      chargeActionInProgress = false;
      hideBusy();
    }
  }

  function openDraftReviewModal(periodId) {
    const row = (Array.isArray(periodRows) ? periodRows : []).find((item) => String(item?.id || '') === String(periodId || ''));
    if (!row) return;
    const transactionSummary = (row?.transactionSummary && typeof row.transactionSummary === 'object') ? row.transactionSummary : {};
    const draftTransactionItems = Array.isArray(transactionSummary?.draftTransactionItems) ? transactionSummary.draftTransactionItems : [];
    const draftPreviewRows = Array.isArray(transactionSummary?.draftPreviewRows) ? transactionSummary.draftPreviewRows : [];
    if (!draftTransactionItems.length || !draftPreviewRows.length) {
      showMsg('Draft Missing', 'warning', 'No draft transaction rows were found for this enrollment period.');
      return;
    }

    const funderId = String(row?.funderId || '').trim();
    const funderType = (!funderId || funderId.toLowerCase() === 'self')
      ? 'self'
      : (String(row?.funderType || '').trim() || 'funder');
    const payload = {
      classId,
      studentId: String(row?.studentId || '').trim(),
      startDate: String(row?.startDate || '').trim(),
      endDate: String(row?.endDate || '').trim(),
      status: String(row?.status || 'draft').trim().toLowerCase() || 'draft',
      funderType: funderType === 'self' ? 'self' : 'funder',
      funderId: funderType === 'self' || !funderId ? 'self' : funderId,
      authorizationRef: '',
      reasonStart: String(row?.reasonStart || '').trim(),
      targetSessionCount: String(row?.targetSessionCount || '').trim(),
      sessionCountPolicy: String(row?.sessionCountPolicy || 'all_non_na').trim() || 'all_non_na'
    };
    setFunderSelectValue('inp_funder', payload);

    openChargeModalWithDraft(payload, {
      draftTransactionItems,
      draftPreviewRows,
      totalAmount: Number(transactionSummary?.totalAmount || 0),
      feeCategory: String(row?.feeCategory || '').trim(),
      classFeeRule: { transactionDefinitionName: 'Draft Enrollment Transactions' }
    }, {
      mode: 'review',
      periodId: String(row?.id || '').trim()
    });
  }

  async function requestJson(url, method = 'GET', payload = null, { allowErrorResult = false } = {}) {
    const upperMethod = String(method || 'GET').toUpperCase();
    const isMutating = ['POST', 'PUT', 'PATCH', 'DELETE'].includes(upperMethod);
    const normalizedPayload = (payload && typeof payload === 'object') ? { ...payload } : payload;
    if (isMutating && actionStateId && normalizedPayload && typeof normalizedPayload === 'object' && !normalizedPayload.actionStateId) {
      normalizedPayload.actionStateId = actionStateId;
    }
    const classScopedEnrollmentAction = isMutating
      && /^\/school\/classes\/api\/enrollment-periods\/(preview-create|create-with-transactions|create|check-overlap|evaluate-reentry)(\?|$)/.test(String(url || ''));
    const urlParams = [];
    if (!isMutating && actionStateId) {
      urlParams.push('actionStateId=' + encodeURIComponent(actionStateId));
    }
    if (classScopedEnrollmentAction && classId && !/[?&]id=/.test(String(url || ''))) {
      urlParams.push('id=' + encodeURIComponent(classId));
    }
    const urlWithActionState = urlParams.length
      ? `${url}${url.includes('?') ? '&' : '?'}${urlParams.join('&')}`
      : url;
    const headers = { 'X-AJAX-Request': 'true' };
    if (actionStateId) headers['X-Action-State-Id'] = actionStateId;
    if (normalizedPayload) headers['Content-Type'] = 'application/json';
    const response = await fetch(urlWithActionState, {
      method: upperMethod,
      headers,
      body: normalizedPayload ? JSON.stringify(normalizedPayload) : undefined
    });
    const result = await response.json().catch(() => ({}));
    if (window.applyGuardedApiResult) {
      const wrapped = await window.applyGuardedApiResult(result, {
        busyTitle: 'Operation In Progress',
        replayTitle: 'Already Processed'
      });
      if (wrapped.stop) return null;
    }
    if (!response.ok || (!allowErrorResult && String(result.status || '').toLowerCase() === 'error')) {
      const err = new Error(result?.message || 'Request failed.');
      if (result?.code) err.code = String(result.code);
      throw err;
    }
    return result;
  }

  function resolveStudentRowDisplay(row) {
    const studentId = String(row?.studentId || '').trim();
    const mapped = studentMap.get(studentId)
      || [...studentMap.values()].find((item) => String(item?.id || '') === studentId)
      || [...studentMap.values()].find((item) => String(item?.personId || '') === studentId);
    const label = String(row?.studentLabel || mapped?.label || '').trim();
    const recordId = String(row?.studentRecordId || mapped?.id || studentId).trim();
    return {
      label: label || studentId || '-',
      recordId: recordId || studentId
    };
  }

  function resolvePeriodEndSortValue(row = {}, explicitTargetSessionCount = 0) {
    if (explicitTargetSessionCount > 0) return '9999-12-31';
    const endDate = String(row?.endDate || '').trim();
    return endDate || '9999-12-31';
  }

  function reapplyActiveTableSort() {
    const table = document.getElementById('first-table');
    if (!table) return;
    const activeHeader = table.querySelector('thead th.sort-asc, thead th.sort-desc');
    if (!activeHeader) return;
    const column = String(activeHeader.dataset.column || '').trim();
    const order = activeHeader.classList.contains('sort-desc') ? 'desc' : 'asc';
    const tbody = table.querySelector('tbody');
    if (!tbody || !column) return;
    const headerArray = Array.from(table.querySelectorAll('thead th'));
    const idx = headerArray.findIndex((header) => header.dataset.column === column);
    if (idx < 0) return;

    const resolveComparableSortValue = (cell) => {
      const explicitRaw = cell?.dataset?.sortValue;
      const cellRaw = String(
        explicitRaw == null || String(explicitRaw).trim() === ''
          ? (cell?.textContent || '')
          : explicitRaw
      ).replace(/\s+/g, ' ').trim();
      if (!cellRaw) return { type: 'string', value: '' };
      const normalizedNumeric = cellRaw.replace(/,/g, '');
      if (/^-?\d+(\.\d+)?$/.test(normalizedNumeric)) {
        return { type: 'number', value: Number(normalizedNumeric) };
      }
      if (/^\d{4}-\d{2}-\d{2}(?:[T\s].*)?$/.test(cellRaw)) {
        const asTimestamp = Date.parse(cellRaw);
        if (!Number.isNaN(asTimestamp)) return { type: 'number', value: asTimestamp };
      }
      return { type: 'string', value: cellRaw.toLowerCase() };
    };

    const compareSortValues = (left, right) => {
      if (left.type === 'number' && right.type === 'number') return left.value - right.value;
      return String(left.value).localeCompare(String(right.value), undefined, { sensitivity: 'base', numeric: true });
    };

    const rows = Array.from(tbody.querySelectorAll('tr'));
    rows.sort((leftRow, rightRow) => {
      const leftVal = resolveComparableSortValue(leftRow.children[idx]);
      const rightVal = resolveComparableSortValue(rightRow.children[idx]);
      const comparison = compareSortValues(leftVal, rightVal);
      return order === 'asc' ? comparison : -comparison;
    });
    tbody.innerHTML = '';
    rows.forEach((row) => tbody.appendChild(row));
  }

  function renderRows() {
    closeAllActionMenus();
    const rows = Array.isArray(periodRows) ? [...periodRows] : [];
    periodCount.textContent = `${rows.length} row${rows.length === 1 ? '' : 's'}`;
    if (!rows.length) {
      tbody.innerHTML = '<tr><td colspan="' + String(periodTableColspan) + '" class="text-center py-4 text-muted">No enrollment periods found.</td></tr>';
      if (typeof window.reapplyCurrentTableSettings === 'function') {
        window.reapplyCurrentTableSettings(document.getElementById('first-table'));
      }
      return;
    }

    tbody.innerHTML = rows.map((row) => {
      const studentId = String(row?.studentId || '');
      const studentDisplay = resolveStudentRowDisplay(row);
      const status = String(row?.status || '').trim().toLowerCase();
      const badgeClass = status === 'active' ? 'bg-success'
        : (status === 'to_be_confirmed' ? 'bg-info text-dark'
          : (status === 'waiting_list' ? 'bg-primary'
            : (status === 'planned' ? 'bg-primary' : (status === 'draft' ? 'bg-warning text-dark' : 'bg-secondary'))));
      const canClose = isOpenStatus(status);
      const canArchive = ['completed', 'withdrawn', 'cancelled'].includes(status);
      const canReenter = ['completed', 'withdrawn', 'cancelled', 'archived'].includes(status);
      const transactionSummary = row?.transactionSummary && typeof row.transactionSummary === 'object'
        ? row.transactionSummary
        : {};
      const postingCycles = Array.isArray(transactionSummary.postingCycles) ? transactionSummary.postingCycles : [];
      const activePostingCycle = postingCycles.find((cycle) => Number(cycle?.cycleNo || 0) === Number(transactionSummary.activePostingCycleNo || 0))
        || postingCycles[postingCycles.length - 1]
        || null;
      const financialStatus = (transactionSummary.unresolvedTransactionIds || []).length
        || (transactionSummary.reconciliationIssues || []).length
        ? 'unresolved'
        : String(activePostingCycle?.status || ((transactionSummary.draftTransactionIds || []).length ? 'draft' : 'none')).trim().toLowerCase();
      const canReviewDraft = ['draft', 'to_be_confirmed', 'waiting_list'].includes(status)
        && Array.isArray(row?.transactionSummary?.draftPreviewRows)
        && row.transactionSummary.draftPreviewRows.length > 0
        && !(Array.isArray(row?.transactionSummary?.postedTransactionIds) && row.transactionSummary.postedTransactionIds.length);
      const hasPostedTransactions = status !== 'draft'
        && Array.isArray(row?.transactionSummary?.postedTransactionIds)
        && row.transactionSummary.postedTransactionIds.length > 0;
      const canSyncAcademicLedger = hasPostedTransactions || status === 'active';
      const removeLabel = hasPostedTransactions ? 'Rollback' : 'Delete';
      const funderLabel = resolveFunderDisplayLabel(row);
      const explicitTargetSessionCount = normalizeTargetSessionCountValue(row?.targetSessionCount);
      const explicitTargetHours = normalizeTargetHoursValue(row?.targetHours);
      const hasEnrollmentTarget = explicitTargetSessionCount > 0 || explicitTargetHours > 0;
      const targetDisplay = formatEnrollmentCapDisplay(row, 'target');
      const consumedDisplay = formatEnrollmentCapDisplay(row, 'consumed');
      const remainingDisplay = formatEnrollmentCapDisplay(row, 'remaining');
      const completion = row?.sessionCompletion || (row?.completionDate ? { date: row.completionDate, sessionId: row?.completionSessionId || '', reason: row?.completionReason || '' } : null);
      const completionHtml = completion?.date
        ? '<div class="small fw-semibold">' + htmlEscape(String(completion.date || '')) + '</div>'
          + (completion.sessionId ? '<div class="x-small text-muted font-monospace">' + htmlEscape(String(completion.sessionId)) + '</div>' : '')
        : '<span class="text-muted">-</span>';
      const completionSortValue = String(completion?.date || '').trim();
      const studentSortValue = `${String(studentDisplay.label || '').trim()} ${studentId}`.trim().toLowerCase();
      const endSortValue = resolvePeriodEndSortValue(row, explicitTargetSessionCount || explicitTargetHours);
      const targetSortValue = targetDisplay || '';
      const consumedSortValue = consumedDisplay || '';
      const remainingSortValue = remainingDisplay || '';
      return `
        <tr>
          <td class="ps-4" data-sort-value="${htmlEscape(studentSortValue)}">
            <div class="fw-semibold">${(typeof schoolRenderStudentNameHtml === 'function' ? schoolRenderStudentNameHtml(studentDisplay.label, studentDisplay.recordId, { className: 'text-decoration-none fw-semibold' }) : htmlEscape(studentDisplay.label))}</div>
            <div class="x-small text-muted font-monospace">${htmlEscape(studentId)}</div>
          </td>
          <td data-sort-value="${htmlEscape(String(row?.startDate || ''))}">${htmlEscape(String(row?.startDate || '-'))}</td>
          <td data-sort-value="${htmlEscape(endSortValue)}">${hasEnrollmentTarget ? '<span class="text-muted">Target-based</span>' : htmlEscape(String(row?.endDate || 'Open'))}</td>
          <td class="text-center small" data-sort-value="${htmlEscape(targetSortValue)}">${targetDisplay ? htmlEscape(targetDisplay) : '<span class="text-muted">-</span>'}</td>
          <td class="text-center small" data-sort-value="${htmlEscape(consumedSortValue)}">${consumedDisplay ? htmlEscape(consumedDisplay) : '<span class="text-muted">-</span>'}</td>
          <td class="text-center small" data-sort-value="${htmlEscape(remainingSortValue)}">${remainingDisplay ? htmlEscape(remainingDisplay) : '<span class="text-muted">-</span>'}</td>
          <td data-sort-value="${htmlEscape(completionSortValue)}">${completionHtml}</td>
          <td class="text-center" data-sort-value="${htmlEscape(status)}">
            <span class="badge ${badgeClass}">${htmlEscape(formatPeriodStatusLabel(status))}</span>
            <div class="x-small text-muted mt-1">Finance: ${htmlEscape(financialStatus)}</div>
          </td>
          <td data-sort-value="${htmlEscape(String(funderLabel || '').toLowerCase())}">${htmlEscape(funderLabel)}</td>
          <td class="text-end table-actions pe-4">
            <div class="rolling-row-actions-wrap">
              <button type="button" class="btn btn-secondary btn-sm rolling-row-actions-toggle" data-period-id="${htmlEscape(String(row?.id || ''))}">
                <i class="bi bi-three-dots-vertical"></i>
              </button>
              <div class="rolling-row-actions-menu d-none" data-period-id="${htmlEscape(String(row?.id || ''))}">
                <button type="button" class="btn btn-outline-primary btn-sm btn-row-edit" data-period-id="${htmlEscape(String(row?.id || ''))}"><i class="bi bi-pencil-square me-1"></i>Edit</button>
                ${canReviewDraft ? `<button type="button" class="btn btn-outline-primary btn-sm btn-row-review-draft" data-period-id="${htmlEscape(String(row?.id || ''))}"><i class="bi bi-journal-text me-1"></i>Review Draft</button>` : ''}
                ${canReenter ? `<button type="button" class="btn btn-outline-secondary btn-sm btn-row-reentry" data-period-id="${htmlEscape(String(row?.id || ''))}"><i class="bi bi-arrow-repeat me-1"></i>Next</button>` : ''}
                ${canClose ? `<button type="button" class="btn btn-outline-danger btn-sm btn-row-close" data-period-id="${htmlEscape(String(row?.id || ''))}"><i class="bi bi-x-circle me-1"></i>Close</button>` : ''}
                ${canArchive ? `<button type="button" class="btn btn-outline-secondary btn-sm btn-row-archive" data-period-id="${htmlEscape(String(row?.id || ''))}"><i class="bi bi-archive me-1"></i>Archive</button>` : ''}
                ${canSyncAcademicLedger ? `<button type="button" class="btn btn-outline-info btn-sm btn-row-sync-ledger" data-period-id="${htmlEscape(String(row?.id || ''))}"><i class="bi bi-journal-bookmark me-1"></i>Sync academic ledger</button>` : ''}
                <button type="button" class="btn btn-outline-danger btn-sm btn-row-remove" data-period-id="${htmlEscape(String(row?.id || ''))}"><i class="bi bi-trash me-1"></i>${removeLabel}</button>
              </div>
            </div>
          </td>
        </tr>
      `;
    }).join('');
    if (typeof window.reapplyCurrentTableSettings === 'function') {
      window.reapplyCurrentTableSettings(document.getElementById('first-table'));
    }
    reapplyActiveTableSort();
  }

