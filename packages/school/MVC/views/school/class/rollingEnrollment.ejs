  function bindKeyboardFlow() {
    const triggerAddOnEnterIds = [
      'inp_startDate',
      'inp_endDate',
      'inp_status',
      'inp_funder'
    ];
    triggerAddOnEnterIds.forEach((id) => {
      const el = qs(id);
      if (!el) return;
      el.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' || event.shiftKey || event.ctrlKey || event.altKey || event.metaKey) return;
        event.preventDefault();
        addButton?.click();
      });
    });

    qs('inp_reasonStart')?.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' && event.ctrlKey) {
        event.preventDefault();
        addButton?.click();
      }
    });

    qs('close_reasonEnd')?.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' && event.ctrlKey) {
        event.preventDefault();
        qs('btn_confirmClosePeriod')?.click();
      }
    });

    qs('reentry_reasonStart')?.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' && event.ctrlKey) {
        event.preventDefault();
        qs('btn_confirmReentry')?.click();
      }
    });

    document.addEventListener('keydown', (event) => {
      const key = String(event.key || '').toLowerCase();
      if (event.altKey && key === 's') {
        event.preventDefault();
        pickStudent();
        return;
      }
      if (event.altKey && key === 'a') {
        event.preventDefault();
        addButton?.click();
        return;
      }
      if (event.key === 'Escape') {
        if (addEnrollmentModalEl?.classList.contains('show')) addEnrollmentModal?.hide();
        if (closeModalEl?.classList.contains('show')) closeModal?.hide();
        if (reentryModalEl?.classList.contains('show')) reentryModal?.hide();
        if (editModalEl?.classList.contains('show')) editModal?.hide();
        if (chargeModalEl?.classList.contains('show')) chargeModal?.hide();
      }
    });

    closeModalEl?.addEventListener('shown.bs.modal', () => {
      qs('close_endDate')?.focus();
    });
    reentryModalEl?.addEventListener('shown.bs.modal', () => {
      qs('reentry_startDate')?.focus();
    });
    editModalEl?.addEventListener('shown.bs.modal', () => {
      qs('edit_startDate')?.focus();
    });
    chargeModalEl?.addEventListener('shown.bs.modal', () => {
      qs('btn_confirmChargeEnrollment')?.focus();
    });
    chargeModalEl?.addEventListener('hidden.bs.modal', () => {
      resetChargeModalState();
    });
  }

  async function submitEditPeriod() {
    const periodId = String(qs('edit_periodId')?.value || '').trim();
    const startDate = String(qs('edit_startDate')?.value || '').trim();
    const endDate = String(qs('edit_endDate')?.value || '').trim();
    if (!periodId || !startDate) {
      await showMsg('Missing Fields', 'warning', 'Period and Start Date are required.');
      return;
    }
    const cycleDateIssue = validateCycleEnrollmentDates(startDate, endDate);
    if (cycleDateIssue) {
      await showMsg('Date out of range', 'warning', cycleDateIssue);
      return;
    }
    const row = (Array.isArray(periodRows) ? periodRows : []).find((item) => String(item?.id || '') === periodId)
      || editModalCurrentRow
      || {};
    const priorStatus = String(row?.status || '').trim().toLowerCase();
    const statusPayload = readEditStatusPayload();
    const nextOpenStatus = statusPayload.mode === 'open' ? statusPayload.status : priorStatus;

    if (statusPayload.mode === 'open'
      && ['waiting_list', 'to_be_confirmed'].includes(nextOpenStatus)
      && row?.hasNonNaAttendanceMarkings) {
      await showMsg('Status blocked', 'warning', 'Cannot change to Waiting List or To Be Confirmed when attendance has been recorded for non-N/A sessions.');
      return;
    }
    if (cycleWindow?.isClosedForNewEnrollment && nextOpenStatus === 'active') {
      if (['draft', 'planned', 'to_be_confirmed', 'waiting_list', 'error'].includes(priorStatus)) {
        await showMsg('Cycle closed', 'warning', 'This cycle is closed for new enrollment. Pending periods cannot be approved to active.');
        return;
      }
    }
    if (statusPayload.mode === 'close') {
      if (!statusPayload.effectiveDate || !statusPayload.reason) {
        await showMsg('Missing Fields', 'warning', 'End date and reason are required to close the enrollment.');
        return;
      }
      if (statusPayload.closeReason !== 'withdrawn') {
        if (!approvedEditCloseStatusPayload
          || JSON.stringify({
            targetStatus: statusPayload.closeReason,
            effectiveDate: statusPayload.effectiveDate,
            reason: statusPayload.reason
          }) !== JSON.stringify(approvedEditCloseStatusPayload)) {
          await showMsg('Preview Required', 'warning', 'Preview the close reason, date, and reason before applying.');
          return;
        }
      }
    }
    try {
      showBusy(statusPayload.mode === 'close' ? 'Closing enrollment period...' : 'Saving enrollment period changes...');
      const funderLocked = enrollmentHasAttachedTransactions(row);
      const funder = funderLocked
        ? {
            funderId: String(row?.funderId || 'self').trim() || 'self',
            funderType: (!row?.funderId || String(row.funderId).trim().toLowerCase() === 'self')
              ? 'self'
              : (String(row?.funderType || 'funder').trim() || 'funder')
          }
        : resolveFunderSelectionFromSelect('edit_funder');
      const editPayload = {
        startDate,
        endDate: String(qs('edit_endDate')?.value || '').trim(),
        status: priorStatus,
        funderType: funder.funderType,
        funderId: funder.funderId,
        claimNumber: readClaimNumberSelectValue('edit_claimNumber'),
        reasonStart: String(qs('edit_reasonStart')?.value || '').trim(),
        sessionCountPolicy: 'all_non_na',
        sessionCapacityType: readSessionCapacityTypeFromSelect('edit_sessionCapacityType')
      };
      if (statusPayload.mode === 'open') {
        editPayload.status = nextOpenStatus;
      }
      if (hasTargetSessionCount('edit_targetSessionCount')) {
        editPayload.targetSessionCount = String(qs('edit_targetSessionCount')?.value || '').trim();
      } else {
        editPayload.targetSessionCount = '';
      }
      if (hasTargetHours('edit_targetHours')) {
        editPayload.targetHours = String(qs('edit_targetHours')?.value || '').trim();
      } else {
        editPayload.targetHours = '';
      }
      if (hasTargetSessionCount('edit_targetSessionCount') && hasTargetHours('edit_targetHours')) {
        await showMsg('Validation', 'warning', 'Set either a session target or an hour target, not both.');
        return;
      }
      const result = await requestJson(`/school/classes/api/enrollment-periods/${encodeURIComponent(periodId)}/edit`, 'POST', editPayload);
      if (!result) return;

      if (statusPayload.mode === 'close') {
        if (statusPayload.closeReason === 'withdrawn') {
          const closeResult = await requestJson(`/school/classes/api/enrollment-periods/${encodeURIComponent(periodId)}/close`, 'POST', {
            status: 'withdrawn',
            endDate: statusPayload.effectiveDate,
            reasonEnd: statusPayload.reason
          });
          if (!closeResult) return;
        } else {
          const applyResult = await requestJson(`/school/classes/api/enrollment-periods/${encodeURIComponent(periodId)}/status/apply`, 'POST', {
            targetStatus: statusPayload.closeReason,
            effectiveDate: statusPayload.effectiveDate,
            reason: statusPayload.reason
          });
          if (!applyResult) return;
        }
      }

      editModal?.hide();
      editModalCurrentRow = null;
      approvedEditCloseStatusPayload = null;
      await showMsg('Updated', 'success', statusPayload.mode === 'close'
        ? 'Enrollment status updated.'
        : (result.message || 'Enrollment period updated.'));
      await loadRows();
    } catch (error) {
      await showMsg('Update Failed', 'error', error.message || 'Unable to update enrollment period.');
    } finally {
      hideBusy();
    }
  }

