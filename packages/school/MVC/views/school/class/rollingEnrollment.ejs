  .attendance-report-modal .attendance-report-metric[data-tone="success"] .attendance-report-metric-icon {
    background: var(--bs-success-bg-subtle, #d1e7dd);
    color: var(--bs-success);
  }
  .attendance-report-modal .attendance-report-metric[data-tone="danger"] .attendance-report-metric-icon {
    background: var(--bs-danger-bg-subtle, #f8d7da);
    color: var(--bs-danger);
  }
  .attendance-report-modal .attendance-report-metric[data-tone="info"] .attendance-report-metric-icon {
    background: var(--bs-info-bg-subtle, #cff4fc);
    color: var(--bs-info-text-emphasis, #055160);
  }
  .attendance-report-modal .attendance-report-metric[data-tone="warning"] .attendance-report-metric-icon {
