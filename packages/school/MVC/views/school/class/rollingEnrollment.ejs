      const id = String(editBtn.dataset.claimId || '').trim();
      const entry = rollingClaimNumbers.find((row) => String(row.id) === id);
      if (entry) showRollingClaimEditor(entry);
      return;
    }
    if (deleteBtn) {
      const id = String(deleteBtn.dataset.claimId || '').trim();
      const entry = rollingClaimNumbers.find((row) => String(row.id) === id);
      const label = String(entry?.number || 'this claim number').trim();
      const confirmed = await showConfirm(`Remove claim number "${label}"?`, 'Remove Claim Number', { confirmClass: 'btn-danger' });
