<script>
(() => {
  const ORG_TODAY = <%- orgTodayJson %>;
  function orgTodayFallback() {
    if (ORG_TODAY) return ORG_TODAY;
    return (window.AppOrgDateTime && window.AppOrgDateTime.today) ? String(window.AppOrgDateTime.today) : '';
  }
  const classId = <%- classIdJson %>;
  const rollingClassData = <%- rollingClassDataJson %>;
  const classMaxCapacity = Number(rollingClassData?.maxCapacity || 0);
  const actionStateId = <%- actionStateIdJson %>;
  const cycleWindow = {
    startDate: <%- cycleStartDateJson %>,
    endDate: <%- cycleEndDateJson %>,
    isClosedForNewEnrollment: <%- isClosedForNewEnrollmentJson %>
  };
  const periodTableColspan = 11;
  const studentOptions = <%- studentOptionsJson %>;
  const funderOptions = <%- funderOptionsJson %>;
  const funderLabelById = new Map((Array.isArray(funderOptions) ? funderOptions : []).map((row) => [String(row.id || ''), String(row.label || row.id || '')]));
  const enrollmentProgramChoices = <%- enrollmentProgramChoicesJson %>;
  const canCreateProgramRegistrations = <%- canCreateProgramRegistrationsJson %>;
  const canCreatePriorSubjectCredits = <%- canCreatePriorSubjectCreditsJson %>;
  const canManageEnrollmentOffice = <%- canManageEnrollmentOfficeJson %>;
  const canEditStudentClb = <%- canEditStudentClbJson %>;
  const defaultTeacher = <%- defaultTeacherJson %>;
  const studentMap = new Map((Array.isArray(studentOptions) ? studentOptions : []).map((row) => [String(row.id || ''), row]));
  let periodRows = <%- initialRowsJson %>;

  function resolveFunderSelectionFromSelect(selectId) {
    const value = String(qs(selectId)?.value || 'self').trim() || 'self';
    if (!value || value.toLowerCase() === 'self') {
      return { funderId: 'self', funderType: 'self' };
    }
    return { funderId: value, funderType: 'funder' };
  }

  function setFunderSelectValue(selectId, periodRow) {
    const el = qs(selectId);
    if (!el) return;
    setFunderSelectElementValue(el, periodRow);
  }

  function setFunderSelectElementValue(selectEl, periodRow) {
    if (!selectEl) return;
    const funderId = String(periodRow?.funderId || '').trim();
    if (funderId && funderId.toLowerCase() !== 'self' && funderLabelById.has(funderId)) {
      selectEl.value = funderId;
      return;
    }
    selectEl.value = 'self';
  }

  function resolveFunderSelectionFromElement(selectEl) {
    const value = String(selectEl?.value || 'self').trim() || 'self';
    if (!value || value.toLowerCase() === 'self') {
      return { funderId: 'self', funderType: 'self' };
    }
    return { funderId: value, funderType: 'funder' };
  }

  function collectAttachedEnrollmentTransactionIds(periodRow) {
    const summary = (periodRow?.transactionSummary && typeof periodRow.transactionSummary === 'object')
      ? periodRow.transactionSummary
      : {};
    const ids = [];
    const seen = new Set();
    [
      ...(Array.isArray(summary.postedTransactionIds) ? summary.postedTransactionIds : []),
      ...(Array.isArray(summary.draftTransactionIds) ? summary.draftTransactionIds : []),
      ...(Array.isArray(summary.transactionIds) ? summary.transactionIds : [])
    ].forEach((value) => {
      const id = String(value || '').trim();
      if (!id || seen.has(id)) return;
      seen.add(id);
      ids.push(id);
    });
    return ids;
  }

  function enrollmentHasAttachedTransactions(periodRow) {
    return collectAttachedEnrollmentTransactionIds(periodRow).length > 0;
  }

  const EDIT_FUNDER_HELP_DEFAULT = 'Self Fund posts to the student account. Other funders post to the funder account with student detail.';
  const EDIT_FUNDER_HELP_LOCKED = 'Funder is locked because this enrollment already has financial transactions. Reverse/rollback or void those transactions first, then change funder (or create a new period).';

  function setEditFunderLocked(locked) {
    const el = qs('edit_funder');
    const help = qs('edit_funder_help');
    if (el) el.disabled = !!locked;
    if (help) help.textContent = locked ? EDIT_FUNDER_HELP_LOCKED : EDIT_FUNDER_HELP_DEFAULT;
  }

  function resolveFunderDisplayLabel(row) {
    if (row?.funderLabel) return String(row.funderLabel);
    const funderId = String(row?.funderId || '').trim();
    if (funderId && funderId.toLowerCase() !== 'self' && funderLabelById.has(funderId)) {
      return funderLabelById.get(funderId);
    }
    const funderType = String(row?.funderType || '').trim();
    if ((!funderId || funderId.toLowerCase() === 'self') && (!funderType || funderType.toLowerCase() === 'self')) {
      return 'Self Fund';
    }
    return [funderType, funderId].filter(Boolean).join(' / ') || 'Self Fund';
  }
  let pendingEnrollmentPayload = null;
  let pendingDraftTransactionItems = [];
  let manualRows = [];
  let chargeActionInProgress = false;
  let shortcutActionInProgress = false;
  let programShortcutStep = 'details';
  let programShortcutPreview = null;
  let draftReviewMode = 'create';
  let lastRollingEligibility = null;
  let rollingEnrollmentWorkspace = null;
  let lastAlignmentResult = null;
  let pendingPlannedNaSessionIds = [];
  let pendingUnmarkSessionIds = [];
  let pendingIncludedSessionIds = [];
  let pendingGapBatch = null;
  let pendingGapPreview = null;
  let pendingStagedSessions = [];
  let pendingEnrollmentCapSnapshot = null;
  let gapFormDraft = null;
  let gapFormDraftTimer = null;
  let alignmentDebounceTimer = null;
  let enrollWizardStep = 'form'; // form | unmarkSessions | addSessions | markNa | conflicts
  let enrollWizardPath = null; // null | 'oneOnOne' | 'planA' | 'planB'
  let enrollWizardSkippedAddSessions = false;
  let lastConflictReview = null;
  let conflictReviewHasConflicts = false;
  let groupEnrollmentStudents = [];
  let groupEnrollmentEditingIndex = -1;
  let groupEnrollmentLastResults = [];
  let groupEnrollmentResultRepairContext = null;
  let groupEnrollmentInProgress = false;

  const qs = (id) => document.getElementById(id);
  const tbody = qs('tbody_periods');

  function normalizeTargetSessionCountValue(value) {
    const parsed = Number.parseInt(String(value ?? '').trim(), 10);
    return Number.isFinite(parsed) && parsed > 0 ? parsed : 0;
  }

  function hasTargetSessionCount(inputId = 'inp_targetSessionCount') {
    return normalizeTargetSessionCountValue(qs(inputId)?.value) > 0;
  }

  function normalizeTargetHoursValue(value) {
    const parsed = Number.parseFloat(String(value ?? '').trim());
    if (!Number.isFinite(parsed) || parsed <= 0) return 0;
    const stepped = Math.round(parsed / 0.25) * 0.25;
    return Number(stepped.toFixed(2));
  }

  function hasTargetHours(inputId = 'inp_targetHours') {
    return normalizeTargetHoursValue(qs(inputId)?.value) > 0;
  }

  function readEnrollmentCapFields() {
    const sessionFromInput = hasTargetSessionCount()
      ? String(qs('inp_targetSessionCount')?.value || '').trim()
      : '';
    const hoursFromInput = hasTargetHours()
      ? String(qs('inp_targetHours')?.value || '').trim()
      : '';
    if (sessionFromInput || hoursFromInput) {
      pendingEnrollmentCapSnapshot = {
        targetSessionCount: sessionFromInput,
        targetHours: hoursFromInput
      };
    }
    const snapshot = pendingEnrollmentCapSnapshot && typeof pendingEnrollmentCapSnapshot === 'object'
      ? pendingEnrollmentCapSnapshot
      : null;
    return {
      targetSessionCount: sessionFromInput || String(snapshot?.targetSessionCount || '').trim(),
      targetHours: hoursFromInput || String(snapshot?.targetHours || '').trim()
    };
  }

  function hasEnrollmentCapFromSnapshot(sessionInputId = 'inp_targetSessionCount', hoursInputId = 'inp_targetHours') {
    const caps = readEnrollmentCapFields();
    return normalizeTargetSessionCountValue(caps.targetSessionCount) > 0
      || normalizeTargetHoursValue(caps.targetHours) > 0
      || hasTargetSessionCount(sessionInputId)
      || hasTargetHours(hoursInputId);
  }

  function hasEnrollmentCap(sessionInputId = 'inp_targetSessionCount', hoursInputId = 'inp_targetHours') {
    return hasEnrollmentCapFromSnapshot(sessionInputId, hoursInputId);
  }

  function formatHoursLabel(hours) {
    const value = normalizeTargetHoursValue(hours);
    if (!value) return '';
    return `${value} Hr${value === 1 ? '' : 's'}`;
  }

  function formatEnrollmentCapDisplay(row = {}, kind = 'target') {
    const targetHours = normalizeTargetHoursValue(row?.targetHours);
    const explicitSessionCount = normalizeTargetSessionCountValue(row?.targetSessionCount);
    const effectiveSessionCount = row?.effectiveTargetSessionCount === null || row?.effectiveTargetSessionCount === undefined
      ? (explicitSessionCount || null)
      : Number(row.effectiveTargetSessionCount || 0);
    const displaySessionCount = targetHours > 0
      ? (row?.allocatedSessionCount ?? effectiveSessionCount)
      : (explicitSessionCount || effectiveSessionCount);
    const consumedSessionCount = row?.consumedSessionCount === null || row?.consumedSessionCount === undefined
      ? null
      : Number(row.consumedSessionCount || 0);
    const remainingSessionCount = displaySessionCount !== null && consumedSessionCount !== null
      ? Math.max(0, Number(row?.remainingSessionCount ?? (displaySessionCount - consumedSessionCount)))
      : null;
    const effectiveHours = targetHours > 0 ? targetHours : null;
    const consumedHours = row?.consumedHours === null || row?.consumedHours === undefined
      ? null
      : Number(row.consumedHours || 0);
    const remainingHours = effectiveHours !== null && consumedHours !== null
      ? Math.max(0, Number(row?.remainingHours ?? normalizeTargetHoursValue(effectiveHours - consumedHours)))
      : null;
    const withHours = (sessions, hours) => {
      if (sessions === null || sessions === undefined) return '';
      const sessionLabel = `${sessions} Session${Number(sessions) === 1 ? '' : 's'}`;
      if (hours !== null && hours !== undefined && targetHours > 0) {
        return `${sessionLabel} (${formatHoursLabel(hours)})`;
      }
      return sessionLabel;
    };
    if (kind === 'target') {
      if (displaySessionCount === null && effectiveHours === null) return '';
      if (effectiveHours !== null && (displaySessionCount === null || displaySessionCount === undefined)) {
        return formatHoursLabel(effectiveHours);
      }
      return withHours(displaySessionCount, effectiveHours);
    }
    if (kind === 'consumed') {
      if (consumedSessionCount === null) return '';
      if (targetHours > 0 || consumedHours > 0) {
        return `${consumedSessionCount} (${formatHoursLabel(consumedHours)})`;
      }
      return String(consumedSessionCount);
    }
    if (kind === 'remaining') {
      if (remainingSessionCount === null) return '';
      if (targetHours > 0) return `${remainingSessionCount} (${formatHoursLabel(remainingHours)})`;
      return String(remainingSessionCount);
    }
    return '';
  }

