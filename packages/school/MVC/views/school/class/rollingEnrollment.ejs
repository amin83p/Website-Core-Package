  function resolvePeriodEndSortValue(row = {}, explicitTargetSessionCount = 0) {
    if (explicitTargetSessionCount > 0) return '9999-12-31';
    const endDate = String(row?.endDate || '').trim();
    return endDate || '9999-12-31';
