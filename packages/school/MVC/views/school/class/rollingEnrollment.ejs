<%
  const encClassId = encodeURIComponent(String(c.id || ''));
  const dashHref = typeof schoolSectionDashboardHref !== 'undefined' ? String(schoolSectionDashboardHref || '').trim() : '';
  const rollingHeaderManageBtns = [
    `<a href="/school/classes" class="btn btn-filled btn-secondary btn-md mb-2"><i class="bi bi-arrow-left me-1"></i> Classes</a>`,
    `<a href="${dashHref || '#'}" class="school-navigator-dashboard btn btn-filled btn-secondary btn-md mb-2"><i class="bi bi-speedometer2 me-1"></i> Dashboard</a>`
  ];
  const rollingManageBtns = [
    `<a href="/school/classes/edit/${encClassId}" class="btn btn-filled btn-primary btn-md mb-2"><i class="bi bi-pencil-square me-1"></i> Class Form</a>`,
    `<a href="/school/classes/${encClassId}/cycle-rollover" class="btn btn-filled btn-warning btn-md mb-2"><i class="bi bi-arrow-repeat me-1"></i> Cycle Rollover</a>`
  ];
  const rollingOptionalBtnsBeforePrint = [
    `<button type="button" id="btn_openAddEnrollmentModal" class="btn btn-filled btn-add btn-md me-2 mb-2"${isRolling && !isClosedForNewEnrollment ? '' : ' disabled'}><i class="bi bi-plus-circle me-1"></i>New Enrollment</button>`
  ];
%>

<div class="rolling-enrollment-page">
<%- include('partials/tablePages-start', {
  title: 'Rolling Enrollment',
  newUrl: '',
  user,
  tableName,
  btn_export: true,
  exportExcelUrl: `/school/classes/${encClassId}/rolling-enrollment/export.xlsx`,
  print,
  headerManageBtns: rollingHeaderManageBtns,
  belowHeadingInclude: 'school/class/rollingEnrollmentBelowHeading',
  manageBtns: rollingManageBtns,
  optionalBtnsBeforePrint: rollingOptionalBtnsBeforePrint
}) %>

<div class="card border-0 shadow-sm mb-3">
  <div class="card-header bg-white d-flex align-items-center justify-content-between py-2 px-3">
    <div class="fw-bold text-dark"><i class="bi bi-funnel me-2"></i>Filter Enrollment Periods</div>
    <button
      id="rollingFilterToggleBtn"
      type="button"
      class="btn btn-outline-secondary btn-sm px-2"
      data-bs-toggle="collapse"
      data-bs-target="#rollingFilterCollapse"
      aria-expanded="<%= hasRollingFiltersAppliedFlag ? 'true' : 'false' %>"
      aria-controls="rollingFilterCollapse"
      aria-label="<%= hasRollingFiltersAppliedFlag ? 'Close filters' : 'Open filters' %>">
      <i id="rollingFilterToggleIcon" class="bi <%= hasRollingFiltersAppliedFlag ? 'bi-chevron-up' : 'bi-chevron-down' %>"></i>
    </button>
  </div>
  <div class="collapse<%= hasRollingFiltersAppliedFlag ? ' show' : '' %>" id="rollingFilterCollapse">
    <form class="card-body p-3" method="get" action="<%= rollingFilterAction %>">
      <div class="row g-3 align-items-end">
        <div class="col-lg-3 col-md-6">
          <label class="form-label" for="rollingEnrollmentGroupFilter">Enrollment group</label>
          <select class="form-select size-md" id="rollingEnrollmentGroupFilter" name="enrollmentGroup">
            <% rollingEnrollmentGroupOptions.forEach((option) => { %>
              <option value="<%= option.value %>" <%= String(rollingFilters.enrollmentGroup || 'all') === option.value ? 'selected' : '' %>><%= option.label %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-lg-2 col-md-6">
          <label class="form-label" for="rollingPeriodStatusFilter">Period status</label>
          <select class="form-select size-md" id="rollingPeriodStatusFilter" name="periodStatus">
            <option value="" <%= !rollingFilters.periodStatus ? 'selected' : '' %>>All statuses</option>
            <% rollingPeriodStatusOptions.forEach((value) => { %>
              <option value="<%= value %>" <%= String(rollingFilters.periodStatus || '') === value ? 'selected' : '' %>><%= String(value).replace(/_/g, ' ').replace(/\b\w/g, (ch) => ch.toUpperCase()) %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-lg-3 col-md-6">
          <label class="form-label" for="rollingFunderFilter">Funder</label>
          <select class="form-select size-md" id="rollingFunderFilter" name="funderId">
            <option value="" <%= !rollingFilters.funderId ? 'selected' : '' %>>All funders</option>
            <option value="self" <%= String(rollingFilters.funderId || '') === 'self' ? 'selected' : '' %>>Self-funded</option>
            <% rollingFunderOptions.forEach((option) => { %>
              <option value="<%= option.id %>" <%= String(rollingFilters.funderId || '') === String(option.id) ? 'selected' : '' %>><%= option.label %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-lg-2 col-md-6">
          <label class="form-label" for="rollingTargetTypeFilter">Target type</label>
          <select class="form-select size-md" id="rollingTargetTypeFilter" name="targetType">
            <% rollingTargetTypeOptions.forEach((option) => { %>
              <option value="<%= option.value %>" <%= String(rollingFilters.targetType || 'all') === option.value ? 'selected' : '' %>><%= option.label %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-12 d-flex justify-content-lg-end gap-2 pt-2">
          <a href="<%= rollingFilterAction %>" class="btn btn-outline-secondary btn-md" id="rollingFilterResetLink">Reset</a>
          <button type="submit" class="btn btn-filled btn-primary btn-md">
            <i class="bi bi-funnel me-1"></i> Apply
          </button>
        </div>
      </div>
    </form>
  </div>
</div>

<%- include('partials/tablePages-search', {
  placeholder: 'Search enrollment periods...',
  fields: []
}) %>

  <% if (!isRolling) { %>
    <div class="alert alert-warning border shadow-sm mb-3">
      This class is currently <b>Term-Based</b>. Switch Registration Mode to <b>Rolling</b> in Class Form before managing enrollment periods here.
    </div>
  <% } else if (isClosedForNewEnrollment) { %>
    <div class="alert alert-danger border shadow-sm mb-3">
      This cycle is <b>closed for new enrollment</b>. You can still edit existing enrollment periods, but new enrollments and draft approvals are blocked.
      <% if (nextCycleClassId) { %>
        <a href="/school/classes/<%= encodeURIComponent(nextCycleClassId) %>/rolling-enrollment" class="alert-link ms-1">Open next cycle<%= nextCycleClassTitle ? `: ${nextCycleClassTitle}` : '' %></a>.
      <% } %>
    </div>
  <% } %>

  <div class="table-scroll-wrapper" data-floating-row-actions="true">
    <table class="table-responsive size-md" id="first-table">
      <thead>
        <tr>
          <th class="ps-4 draggable" data-column="student">Student / ID <span class="sort-icon"></span></th>
          <th class="draggable" data-column="startDate">Start Date <span class="sort-icon"></span></th>
          <th class="draggable" data-column="endDate">End Date <span class="sort-icon"></span></th>
          <th class="draggable text-center" data-column="target">Target <span class="sort-icon"></span></th>
          <th class="draggable text-center" data-column="consumed">Consumed <span class="sort-icon"></span></th>
          <th class="draggable text-center" data-column="remaining">Remaining <span class="sort-icon"></span></th>
          <th class="draggable" data-column="completion">Completion <span class="sort-icon"></span></th>
          <th class="draggable text-center" data-column="status">Period Status <span class="sort-icon"></span></th>
          <th class="draggable" data-column="funder">Funder <span class="sort-icon"></span></th>
          <th class="text-end pe-4">Actions</th>
        </tr>
      </thead>
      <tbody id="tbody_periods"></tbody>
    </table>
  </div>

<%- include('partials/tablePages-end') %>
</div>

<div class="modal fade" id="addEnrollmentPeriodModal" tabindex="-1" aria-labelledby="addEnrollmentPeriodModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="addEnrollmentPeriodModalLabel"><i class="bi bi-person-plus me-1"></i>New Enrollment Period</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="enroll-wizard-guide d-none" id="enrollWizardStepIndicator" aria-hidden="true">
          <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
            <div class="fw-bold text-primary small">Enrollment wizard</div>
            <div class="d-flex align-items-center gap-2">
              <span class="badge bg-light text-dark border" id="enrollWizardStepBadge">Step 1 of 1</span>
              <span class="badge bg-primary-subtle text-primary border border-primary-subtle" id="enrollWizardProgressPct">0%</span>
            </div>
          </div>
          <div class="wizard-progress mb-3"><div class="wizard-progress-bar" id="enrollWizardProgressBar"></div></div>
          <div class="wizard-step-rail" id="enrollWizardStepPills"></div>
        </div>

        <div id="enrollWizardStepForm">
          <input type="hidden" id="inp_studentId">
          <div class="mb-2">
            <label class="form-label">Student *</label>
            <div class="input-group">
              <input type="text" id="inp_studentLabel" class="form-control bg-white" placeholder="Select student..." readonly>
              <button type="button" class="btn btn-outline-primary" id="btn_pickStudent"><i class="bi bi-person-vcard"></i></button>
            </div>
          </div>
          <div class="mb-2" id="wrap_enrollmentRegistration">
            <label class="form-label" id="lbl_enrollmentRegistration">Program registration</label>
            <div id="roll_enrollmentRegistrationPanel" class="form-control bg-light small py-2" style="min-height: 2.4rem;">
              <span class="text-muted">Select a student to verify program registration and prerequisites.</span>
            </div>
            <div class="form-text small text-muted" id="hint_enrollmentRegistration">
              The student must already be registered in a program that appears under this class’s allowed programs (and in the required term, if the class specifies one). Prerequisites are checked before enrollment is saved.
            </div>
          </div>
          <div class="row g-2 enroll-cap-inputs-row">
            <div class="col-lg-3 col-md-6">
              <label class="form-label">Start Date *</label>
              <input type="date" id="inp_startDate" class="form-control"<% if (cycleStartDate) { %> min="<%= cycleStartDate %>"<% } %><% if (cycleEndDate) { %> max="<%= cycleEndDate %>"<% } %>>
            </div>
            <div class="col-lg-3 col-md-6">
              <label class="form-label" id="lbl_endDate">End Date</label>
              <input type="date" id="inp_endDate" class="form-control"<% if (cycleStartDate) { %> min="<%= cycleStartDate %>"<% } %>>
            </div>
            <div class="col-lg-3 col-md-6" id="wrap_inp_targetSessionCount">
              <label class="form-label">Number of Sessions <span class="text-muted fw-normal">(optional)</span></label>
              <input type="number" id="inp_targetSessionCount" class="form-control" min="1" step="1" placeholder="e.g. 10">
            </div>
            <div class="col-lg-3 col-md-6" id="wrap_inp_targetHours">
              <label class="form-label">Number of Hours <span class="text-muted fw-normal">(optional)</span></label>
              <input type="number" id="inp_targetHours" class="form-control" min="0.25" step="0.25" placeholder="e.g. 20">
            </div>
          </div>
          <div class="row g-1 mt-1 enroll-cap-hints-row">
            <div class="col-lg-3 col-md-6 d-none d-lg-block"></div>
            <div class="col-lg-3 col-md-6">
              <div class="form-text compact-help mb-0" id="hint_endDateEnrollment">Used with start date when no session or hour target is set.</div>
            </div>
            <div class="col-lg-3 col-md-6">
              <div class="form-text compact-help mb-0">Count sessions until target is reached. Cannot be combined with hour target.</div>
            </div>
            <div class="col-lg-3 col-md-6">
              <div class="form-text compact-help mb-0">Allocate sessions by total hours. Cannot be combined with session target.</div>
            </div>
          </div>
          <div class="row g-1 mt-1">
            <div class="col-12">
              <div class="d-flex flex-wrap align-items-center gap-2">
                <div class="form-text compact-help mb-0" id="hint_sessionAlignment">Leave end date and both targets blank to enroll by date window only.</div>
                <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2 d-none" id="btn_viewEnrollmentSessions">Calendar</button>
                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 d-none" id="btn_viewEnrollmentSessionsList">List view</button>
              </div>
            </div>
          </div>
          <div id="formEnrollmentSessionsPanel" class="d-none mt-3">
            <div class="fw-semibold mb-2">Scheduled and staged sessions</div>
            <div class="table-responsive border rounded">
              <table class="table table-sm align-middle mb-0">
                <thead class="table-light">
                  <tr><th>Date</th><th>Time</th><th>Status</th><th>Countable</th><th class="text-end">Actions</th></tr>
                </thead>
                <tbody id="formEnrollmentSessionsTbody">
                  <tr><td colspan="5" class="text-center text-muted py-3">No sessions loaded.</td></tr>
                </tbody>
                <tfoot class="table-light">
                  <tr>
                    <td colspan="5" class="small py-2 text-secondary" id="formEnrollmentSessionsTotals">Staged: 0 session(s), 0 Hrs · Total: 0 session(s), 0 Hrs</td>
                  </tr>
                </tfoot>
              </table>
            </div>
          </div>
          <div class="row g-2 mt-2">
            <div class="col-md-6">
              <label class="form-label" for="inp_funder">Funder</label>
              <select id="inp_funder" class="form-select">
                <option value="self" selected>Self Fund</option>
                <% (Array.isArray(funderOptions) ? funderOptions : []).forEach((funder) => { %>
                <option value="<%= String(funder.id || '') %>"><%= String(funder.label || funder.id || '') %></option>
                <% }); %>
              </select>
              <div class="form-text compact-help">Self Fund posts to the student account. Other funders post to the funder account with student detail.</div>
            </div>
            <div class="col-md-4">
              <label class="form-label">Status</label>
              <select id="inp_status" class="form-select">
                <option value="active" selected>Active</option>
                <option value="to_be_confirmed">To be Confirmed</option>
                <option value="waiting_list">Waiting list</option>
              </select>
            </div>
          </div>
          <div class="mt-2">
