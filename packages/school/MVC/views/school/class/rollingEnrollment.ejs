    enrollmentAttendanceReportPeriodId = String(periodId || '').trim();
    enrollmentAttendanceReportPayload = null;
    const defaultDate = orgTodayFallback();
    if (qs('enrollmentAttendanceReportDate')) qs('enrollmentAttendanceReportDate').value = defaultDate;
    renderEnrollmentAttendanceReport({
      studentLabel: '-',
      period: {},
      reportDate: defaultDate,
      summary: {},
      shortcuts: {},
      naReasons: []
    });
    bootstrap.Modal.getOrCreateInstance(modalEl).show();
    await fetchEnrollmentAttendanceReport(enrollmentAttendanceReportPeriodId, defaultDate);
  }

