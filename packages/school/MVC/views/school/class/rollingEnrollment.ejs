  function bindKeyboardFlow() {
    const triggerAddOnEnterIds = [
      'inp_startDate',
      'inp_endDate',
      'inp_status',
      'inp_funder'
    ];
    triggerAddOnEnterIds.forEach((id) => {
      const el = qs(id);
      if (!el) return;
      el.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' || event.shiftKey || event.ctrlKey || event.altKey || event.metaKey) return;
        event.preventDefault();
        addButton?.click();
      });
    });

    qs('inp_reasonStart')?.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' && event.ctrlKey) {
        event.preventDefault();
        addButton?.click();
      }
    });

    qs('close_reasonEnd')?.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' && event.ctrlKey) {
        event.preventDefault();
        qs('btn_confirmClosePeriod')?.click();
      }
    });

    qs('reentry_reasonStart')?.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' && event.ctrlKey) {
        event.preventDefault();
        qs('btn_confirmReentry')?.click();
      }
    });

    document.addEventListener('keydown', (event) => {
      const key = String(event.key || '').toLowerCase();
      if (event.altKey && key === 's') {
        event.preventDefault();
        pickStudent();
        return;
      }
      if (event.altKey && key === 'a') {
        event.preventDefault();
        addButton?.click();
        return;
      }
      if (event.key === 'Escape') {
        if (addEnrollmentModalEl?.classList.contains('show')) addEnrollmentModal?.hide();
        if (closeModalEl?.classList.contains('show')) closeModal?.hide();
        if (reentryModalEl?.classList.contains('show')) reentryModal?.hide();
        if (editModalEl?.classList.contains('show')) editModal?.hide();
        if (chargeModalEl?.classList.contains('show')) chargeModal?.hide();
      }
    });

    closeModalEl?.addEventListener('shown.bs.modal', () => {
      qs('close_endDate')?.focus();
    });
    reentryModalEl?.addEventListener('shown.bs.modal', () => {
      qs('reentry_startDate')?.focus();
    });
    editModalEl?.addEventListener('shown.bs.modal', () => {
      qs('edit_startDate')?.focus();
    });
    chargeModalEl?.addEventListener('shown.bs.modal', () => {
      qs('btn_confirmChargeEnrollment')?.focus();
    });
    chargeModalEl?.addEventListener('hidden.bs.modal', () => {
      resetChargeModalState();
    });
  }

  async function submitEditPeriod() {
    const periodId = String(qs('edit_periodId')?.value || '').trim();
    const startDate = String(qs('edit_startDate')?.value || '').trim();
    const endDate = String(qs('edit_endDate')?.value || '').trim();
    if (!periodId || !startDate) {
      await showMsg('Missing Fields', 'warning', 'Period and Start Date are required.');
      return;
    }
    const cycleDateIssue = validateCycleEnrollmentDates(startDate, endDate);
    if (cycleDateIssue) {
      await showMsg('Date out of range', 'warning', cycleDateIssue);
      return;
    }
    const nextStatus = String(qs('edit_status')?.value || 'active').trim().toLowerCase();
    if (cycleWindow?.isClosedForNewEnrollment && nextStatus === 'active') {
      const row = (Array.isArray(periodRows) ? periodRows : []).find((item) => String(item?.id || '') === periodId);
      const priorStatus = String(row?.status || '').trim().toLowerCase();
      if (['draft', 'planned', 'to_be_confirmed', 'waiting_list', 'error'].includes(priorStatus)) {
        await showMsg('Cycle closed', 'warning', 'This cycle is closed for new enrollment. Pending periods cannot be approved to active.');
        return;
      }
    }
    try {
      showBusy('Saving enrollment period changes...');
      const row = (Array.isArray(periodRows) ? periodRows : []).find((item) => String(item?.id || '') === periodId);
      const funderLocked = enrollmentHasAttachedTransactions(row);
      const funder = funderLocked
        ? {
            funderId: String(row?.funderId || 'self').trim() || 'self',
            funderType: (!row?.funderId || String(row.funderId).trim().toLowerCase() === 'self')
              ? 'self'
              : (String(row?.funderType || 'funder').trim() || 'funder')
          }
        : resolveFunderSelectionFromSelect('edit_funder');
      const editPayload = {
        startDate,
        endDate: String(qs('edit_endDate')?.value || '').trim(),
        status: String(qs('edit_status')?.value || 'active').trim(),
        funderType: funder.funderType,
        funderId: funder.funderId,
        authorizationRef: '',
        reasonStart: String(qs('edit_reasonStart')?.value || '').trim(),
        sessionCountPolicy: 'all_non_na'
      };
      if (hasTargetSessionCount('edit_targetSessionCount')) {
        editPayload.targetSessionCount = String(qs('edit_targetSessionCount')?.value || '').trim();
      } else {
        editPayload.targetSessionCount = '';
      }
      if (hasTargetHours('edit_targetHours')) {
        editPayload.targetHours = String(qs('edit_targetHours')?.value || '').trim();
      } else {
        editPayload.targetHours = '';
      }
      if (hasTargetSessionCount('edit_targetSessionCount') && hasTargetHours('edit_targetHours')) {
        await showMsg('Validation', 'warning', 'Set either a session target or an hour target, not both.');
        return;
      }
      const result = await requestJson(`/school/classes/api/enrollment-periods/${encodeURIComponent(periodId)}/edit`, 'POST', editPayload);
      if (!result) return;
      editModal?.hide();
      await showMsg('Updated', 'success', result.message || 'Enrollment period updated.');
      await loadRows();
    } catch (error) {
      await showMsg('Update Failed', 'error', error.message || 'Unable to update enrollment period.');
    } finally {
      hideBusy();
    }
  }

  async function syncAcademicLedgerForPeriod(periodId) {
    const id = String(periodId || '').trim();
    if (!id) return;
    try {
      showBusy('Syncing academic ledger...');
      const result = await requestJson(`/school/classes/api/enrollment-periods/${encodeURIComponent(id)}/sync-academic-ledger`, 'POST', {});
      if (!result) return;
      const ledgerNote = academicLedgerHtmlNote(result.academicLedger);
      await showMsg('Academic ledger', 'success', (result.message || 'Academic ledger is up to date.') + ledgerNote);
      await loadRows();
    } catch (error) {
      await showMsg('Academic ledger sync', 'error', error.message || 'Sync failed.');
    } finally {
      hideBusy();
    }
  }

  async function removeOrRollbackPeriod(periodId) {
    const row = (Array.isArray(periodRows) ? periodRows : []).find((item) => String(item?.id || '') === String(periodId || ''));
    if (!row) return;
    const status = String(row?.status || '').trim().toLowerCase();
    const postedCount = Array.isArray(row?.transactionSummary?.postedTransactionIds)
      ? row.transactionSummary.postedTransactionIds.length
      : 0;
    const isRollback = status !== 'draft' && postedCount > 0;
    const actionLabel = isRollback ? 'Rollback Posted Enrollment' : 'Delete Draft Enrollment';
    const personLabel = String(row?.studentLabel || row?.studentId || periodId).trim();

    let confirmed = false;
    if (typeof window.showMessageModal === 'function') {
      const result = await window.showMessageModal({
        title: actionLabel,
        icon: isRollback ? 'warning' : 'question',
        message: isRollback
          ? `Rollback posted transactions for <b>${htmlEscape(personLabel)}</b>?`
          : `Delete draft enrollment for <b>${htmlEscape(personLabel)}</b> before posting?`,
        buttons: [
          { text: 'Cancel', class: 'btn-secondary' },
          { text: isRollback ? 'Rollback' : 'Delete', class: 'btn-danger' }
        ]
      });
      confirmed = result === (isRollback ? 'Rollback' : 'Delete');
    } else {
      confirmed = window.confirm(`${actionLabel} for ${personLabel}?`);
    }
    if (!confirmed) return;

    try {
      showBusy(isRollback ? 'Rolling back posted enrollment...' : 'Deleting draft enrollment...');
      const result = await requestJson(`/school/classes/api/enrollment-periods/${encodeURIComponent(periodId)}/remove`, 'POST', {});
      if (!result) return;
      await showMsg('Success', result.status === 'warning' ? 'warning' : 'success', result.message || 'Operation completed.');
      await loadRows();
    } catch (error) {
      await showMsg('Operation Failed', 'error', error.message || 'Unable to complete the operation.');
    } finally {
      hideBusy();
    }
  }

  function findWrapByPeriodId(periodId) {
    const want = String(periodId || '');
    const btns = document.querySelectorAll('.rolling-enrollment-page .rolling-row-actions-toggle');
    for (let i = 0; i < btns.length; i += 1) {
      const b = btns[i];
      if (String(b.getAttribute('data-period-id') || '') === want) {
        return b.closest('.rolling-row-actions-wrap');
      }
    }
    return null;
  }

  function dockRowActionsMenu(menu) {
    if (!menu || menu.parentElement !== document.body) return;
    const wrap = findWrapByPeriodId(menu.getAttribute('data-period-id'));
    if (wrap) wrap.appendChild(menu);
  }

  function resetFloatingMenuStyles(menu) {
    if (!menu) return;
    menu.classList.remove('rolling-row-actions-menu--floating');
    menu.style.left = '';
    menu.style.top = '';
    menu.style.right = '';
    menu.style.visibility = '';
    menu.style.position = '';
  }

  function placeFloatingRowMenu(menu, wrap) {
    if (!menu || !wrap) return;
    const rect = wrap.getBoundingClientRect();
    const zoomRaw = Number.parseFloat(document.body?.dataset?.appZoom || '');
    const zoom = Number.isFinite(zoomRaw) && zoomRaw > 0 ? zoomRaw : 1;
    const viewportWidth = window.innerWidth / zoom;
    const viewportHeight = window.innerHeight / zoom;
    const rectTop = rect.top / zoom;
    const rectRight = rect.right / zoom;
    const rectBottom = rect.bottom / zoom;
    menu.classList.add('rolling-row-actions-menu--floating');
    menu.style.visibility = 'hidden';
    menu.style.position = 'fixed';
    menu.style.left = '0';
    menu.style.top = '0';
    const mw = Math.max(menu.offsetWidth || 0, 148);
    const mh = menu.offsetHeight || 0;
    let left = rectRight - mw;
    left = Math.max(8, Math.min(left, viewportWidth - mw - 8));
    const gap = 4;
    let top = rectBottom + gap;
    if (mh > 0 && top + mh > viewportHeight - 8) {
      top = Math.max(8, rectTop - mh - gap);
    }
    if (mh > 0 && top + mh > viewportHeight - 8) {
      top = Math.max(8, viewportHeight - mh - 8);
    }
    if (mw > 0 && left + mw > viewportWidth - 8) {
      left = Math.max(8, viewportWidth - mw - 8);
    }
    menu.style.left = `${Math.round(left)}px`;
    menu.style.top = `${Math.round(top)}px`;
    menu.style.visibility = '';
  }

  function repositionOpenRowActionMenu() {
    const menu = document.querySelector('.rolling-row-actions-menu.rolling-row-actions-menu--floating:not(.d-none)');
    if (!menu) return;
    const wrap = findWrapByPeriodId(menu.getAttribute('data-period-id'));
    if (wrap) placeFloatingRowMenu(menu, wrap);
  }

  function closeAllActionMenus() {
    document.querySelectorAll('.rolling-row-actions-menu').forEach((menu) => {
      menu.classList.add('d-none');
      resetFloatingMenuStyles(menu);
      dockRowActionsMenu(menu);
    });
  }

  window.addEventListener('scroll', repositionOpenRowActionMenu, true);
  window.addEventListener('resize', repositionOpenRowActionMenu);
  document.querySelector('.rolling-enrollment-page .table-scroll-wrapper')?.addEventListener('scroll', repositionOpenRowActionMenu, { passive: true });

  document.addEventListener('click', (event) => {
    const toggleBtn = event.target.closest('.rolling-row-actions-toggle');
    if (toggleBtn) {
      const periodId = String(toggleBtn.getAttribute('data-period-id') || '').trim();
      const targetMenu = Array.from(document.querySelectorAll('.rolling-row-actions-menu'))
        .find((menu) => String(menu.getAttribute('data-period-id') || '').trim() === periodId);
      const willOpen = targetMenu ? targetMenu.classList.contains('d-none') : false;
      closeAllActionMenus();
      if (targetMenu && willOpen) {
        const wrap = toggleBtn.closest('.rolling-row-actions-wrap');
        targetMenu.classList.remove('d-none');
        document.body.appendChild(targetMenu);
        placeFloatingRowMenu(targetMenu, wrap);
        requestAnimationFrame(() => {
          requestAnimationFrame(repositionOpenRowActionMenu);
        });
      }
      return;
    }

    const programShortcutBtn = event.target.closest('#btn_openProgramRegistrationShortcut');
    if (programShortcutBtn) {
      event.preventDefault();
      openProgramRegistrationShortcutModal();
      return;
    }

    const studentConflictBtn = event.target.closest('#btn_openStudentConflictModal');
    if (studentConflictBtn) {
      event.preventDefault();
      openStudentConflictModal();
      return;
    }

    const priorCreditRepairBtn = event.target.closest('#btn_openPriorCreditRepair');
    if (priorCreditRepairBtn) {
      event.preventDefault();
      openPriorCreditRepairModal();
      return;
    }

    const editBtn = event.target.closest('.btn-row-edit');
    if (editBtn) {
      closeAllActionMenus();
      openEditModal(editBtn.getAttribute('data-period-id'));
      return;
    }

    const closeBtn = event.target.closest('.btn-row-close');
    if (closeBtn) {
      closeAllActionMenus();
      openCloseModal(closeBtn.getAttribute('data-period-id'));
      return;
    }

    const archiveBtn = event.target.closest('.btn-row-archive');
    if (archiveBtn) {
      closeAllActionMenus();
      openCloseModal(archiveBtn.getAttribute('data-period-id'), 'archived');
      return;
    }

    const reviewBtn = event.target.closest('.btn-row-review-draft');
    if (reviewBtn) {
      closeAllActionMenus();
      openDraftReviewModal(reviewBtn.getAttribute('data-period-id'));
      return;
    }

    const syncLedgerBtn = event.target.closest('.btn-row-sync-ledger');
    if (syncLedgerBtn) {
      closeAllActionMenus();
      syncAcademicLedgerForPeriod(syncLedgerBtn.getAttribute('data-period-id'));
      return;
    }

    const removeBtn = event.target.closest('.btn-row-remove');
    if (removeBtn) {
      closeAllActionMenus();
      removeOrRollbackPeriod(removeBtn.getAttribute('data-period-id'));
      return;
    }

    const reentryBtn = event.target.closest('.btn-row-reentry');
    if (reentryBtn) {
      closeAllActionMenus();
      openReentryModal(reentryBtn.getAttribute('data-period-id'));
      return;
    }

    if (!event.target.closest('.rolling-row-actions-wrap') && !event.target.closest('.rolling-row-actions-menu')) {
      closeAllActionMenus();
    }
  });

  qs('btn_openAddEnrollmentModal')?.addEventListener('click', openAddEnrollmentModal);
  qs('btn_pickStudent')?.addEventListener('click', pickStudent);
  qs('btn_addPeriod')?.addEventListener('click', addPeriod);
  qs('btn_enrollWizardBack')?.addEventListener('click', goEnrollmentWizardBack);
  qs('btn_gapOpenCalendarPicker')?.addEventListener('click', openEnrollmentSessionCalendarModal);
  qs('btn_shortcutPreview')?.addEventListener('click', previewProgramRegistrationShortcut);
  qs('btn_shortcutBack')?.addEventListener('click', returnToProgramRegistrationShortcutDetails);
  qs('btn_shortcutSaveDraft')?.addEventListener('click', saveProgramRegistrationShortcutDraft);
  qs('btn_shortcutApprove')?.addEventListener('click', approveProgramRegistrationShortcutDraft);
  qs('btn_shortcutRetry')?.addEventListener('click', retryProgramRegistrationShortcutEligibility);
  qs('btn_priorRepairSave')?.addEventListener('click', savePriorCreditRepair);
  qs('btn_priorRepairRetry')?.addEventListener('click', refreshRollingEligibility);
  qs('btn_priorRepairSelectAll')?.addEventListener('click', () => {
    document.querySelectorAll('.prior-repair-subject').forEach((input) => { input.checked = true; });
  });
  qs('btn_priorRepairClearAll')?.addEventListener('click', () => {
    document.querySelectorAll('.prior-repair-subject').forEach((input) => { input.checked = false; });
  });
  qs('inp_startDate')?.addEventListener('blur', handleEnrollmentDateBlur);
  qs('inp_endDate')?.addEventListener('blur', handleEnrollmentDateBlur);
  qs('inp_targetSessionCount')?.addEventListener('input', (event) => {
    if (event?.target) event.target.dataset.userEdited = '1';
    readEnrollmentCapFields();
    pendingPlannedNaSessionIds = [];
    pendingIncludedSessionIds = [];
    applyEnrollmentCapMutualExclusion('inp_targetSessionCount');
    if (alignmentDebounceTimer) clearTimeout(alignmentDebounceTimer);
    alignmentDebounceTimer = setTimeout(() => {
      alignmentDebounceTimer = null;
      runAlignmentRefresh({ showSpinner: false });
    }, 300);
  });
  qs('inp_targetHours')?.addEventListener('input', () => {
    readEnrollmentCapFields();
    pendingPlannedNaSessionIds = [];
    pendingIncludedSessionIds = [];
    applyEnrollmentCapMutualExclusion('inp_targetHours');
    if (alignmentDebounceTimer) clearTimeout(alignmentDebounceTimer);
    alignmentDebounceTimer = setTimeout(() => {
      alignmentDebounceTimer = null;
      runAlignmentRefresh({ showSpinner: false });
    }, 300);
  });
  qs('edit_targetSessionCount')?.addEventListener('input', () => {
    applyEnrollmentCapMutualExclusion('edit_targetSessionCount');
  });
  qs('edit_targetHours')?.addEventListener('input', () => {
    applyEnrollmentCapMutualExclusion('edit_targetHours');
  });
  qs('gap_batchEnd')?.addEventListener('change', updateGapCycleExtendWarning);
  qs('gap_batchStart')?.addEventListener('change', updateGapCycleExtendWarning);
  qs('btn_viewEnrollmentSessions')?.addEventListener('click', openEnrollmentSessionCalendarModal);
  qs('btn_viewEnrollmentSessionsList')?.addEventListener('click', openEnrollmentSessionListModal);
  qs('btn_openNaCalendarPicker')?.addEventListener('click', openEnrollmentSessionCalendarModal);
  qs('btn_gapPickTeacher')?.addEventListener('click', pickGapTeacher);
  qs('btn_gapAppendSessions')?.addEventListener('click', appendGapBatchSessions);
  qs('btn_gapClearStaged')?.addEventListener('click', async () => {
    clearPendingGapBatch({ clearFormDraft: true });
