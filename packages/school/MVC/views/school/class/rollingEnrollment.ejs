  function hideBootstrapModalAndWait(modalEl) {
    if (!modalEl) return Promise.resolve();
    if (!modalEl.classList.contains('show')) return Promise.resolve();
    const isEnrollmentModal = modalEl === addEnrollmentModalEl;
    if (isEnrollmentModal) enrollmentModalProgrammaticDismiss = true;
    if (bootstrapApi?.Modal) {
      const instance = bootstrapApi.Modal.getInstance(modalEl)
        || (typeof bootstrapApi.Modal.getOrCreateInstance === 'function'
          ? bootstrapApi.Modal.getOrCreateInstance(modalEl)
          : null);
      if (instance) {
        return new Promise((resolve) => {
          let settled = false;
          const finish = () => {
            if (settled) return;
            settled = true;
            if (isEnrollmentModal) enrollmentModalProgrammaticDismiss = false;
            resolve();
          };
          modalEl.addEventListener('hidden.bs.modal', finish, { once: true });
          modalEl.addEventListener('hidePrevented.bs.modal', () => {
            forceCloseModalElement(modalEl);
            finish();
          }, { once: true });
          instance.hide();
          window.setTimeout(() => {
            if (modalEl.classList.contains('show')) {
              forceCloseModalElement(modalEl);
            }
            finish();
          }, 0);
        });
      }
    }
    forceCloseModalElement(modalEl);
    return Promise.resolve();
  }

