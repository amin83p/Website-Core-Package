  function validateEnrollmentDatesAfterLeavingField(changedInput) {
    const startInput = qs('inp_startDate');
    const endInput = qs('inp_endDate');
    const startDate = String(startInput?.value || '').trim();
    const endDate = String(endInput?.value || '').trim();
    const changedLabel = changedInput?.id === 'inp_endDate' ? 'end date' : 'start date';
    const inputIssue = getEnrollmentDateInputIssue(changedInput, changedLabel);
    if (inputIssue) return { message: inputIssue, input: changedInput };

    const cycleDateIssue = validateCycleEnrollmentDates(startDate);
    if (cycleDateIssue) return { message: cycleDateIssue, input: startInput };
    if (startDate && endDate && endDate < startDate) {
      return { message: 'Enrollment end date cannot be before the enrollment start date.', input: endInput };
    }
    return { message: '', input: null };
  }

