  function getEnrollmentDateInputIssue(input, label) {
    if (!input?.validity || input.validity.valid) return '';
    const safeLabel = String(label || 'date').toLowerCase();
    if (input.validity.badInput) return `Enter a valid ${safeLabel}.`;
    if (input.validity.rangeUnderflow || input.validity.rangeOverflow) {
      return `Enter a ${safeLabel} within the allowed date range.`;
    }
    return `Enter a valid ${safeLabel}.`;
  }

  function setEnrollmentDateValidationState(invalidInput) {
    [qs('inp_startDate'), qs('inp_endDate')].filter(Boolean).forEach((input) => {
      const isInvalid = input === invalidInput;
      input.classList.toggle('is-invalid', isInvalid);
      if (isInvalid) input.setAttribute('aria-invalid', 'true');
      else input.removeAttribute('aria-invalid');
    });
  }

  function focusInvalidEnrollmentDateInput(input) {
    if (!input) return;
    // The message modal restores focus as it finishes closing. Wait until that
