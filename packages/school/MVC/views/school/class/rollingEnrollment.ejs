  function focusInvalidEnrollmentDateInput(input) {
    if (!input) return;
    // The message modal restores focus as it finishes closing. Wait until that
    // restoration is complete, then put the user back in the invalid field.
    window.setTimeout(() => {
      if (input.isConnected && !input.disabled) input.focus();
