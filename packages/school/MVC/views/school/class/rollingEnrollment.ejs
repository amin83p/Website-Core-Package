  function isOneOnOneSessionCapacityEnrollment(selectId = 'inp_sessionCapacityType') {
    if (isRollingCapacityOneClass()) return true;
    return readSessionCapacityTypeFromSelect(selectId) === 'one_on_one';
  }

  function resolveAnticipatedFinishDateClient(alignment = lastAlignmentResult) {
    if (!alignment || !isGroupSessionCapacityEnrollment()) return null;
    const countable = getCountableSessionsFromAlignment(alignment);
    const sessionTarget = hasTargetSessionCount()
      ? normalizeTargetSessionCountValue(qs('inp_targetSessionCount')?.value)
      : 0;
    const hourTarget = hasTargetHours()
      ? normalizeTargetHoursValue(qs('inp_targetHours')?.value)
      : 0;
    if (!sessionTarget && !hourTarget) return null;

    const rows = countable
      .map((row) => ({
        date: String(row?.date || '').trim(),
        durationHours: resolveSessionRowDurationHours(row)
      }))
      .filter((row) => row.date)
      .sort((a, b) => a.date.localeCompare(b.date));

    if (sessionTarget > 0) {
      if (rows.length < sessionTarget) return null;
      return rows[sessionTarget - 1].date;
    }

    let accumulated = 0;
    let lastDate = null;
    for (const row of rows) {
      accumulated = normalizeTargetHoursValue(accumulated + row.durationHours);
      lastDate = row.date;
      if (accumulated >= hourTarget) return lastDate;
    }
    return null;
  }

  function updateAnticipatedFinishHint(alignment = lastAlignmentResult) {
    const sessionHint = qs('hint_inp_targetSessionCount_finish');
    const hoursHint = qs('hint_inp_targetHours_finish');
    const hideBoth = () => {
      sessionHint?.classList.add('d-none');
      hoursHint?.classList.add('d-none');
    };
    if (!isGroupSessionCapacityEnrollment() || !alignment) {
      hideBoth();
      return;
    }
    const finishDate = resolveAnticipatedFinishDateClient(alignment);
    const label = finishDate ? `Anticipated finish: ${formatSessionDateWithDay(finishDate)}` : '';
    if (hasTargetSessionCount() && sessionHint) {
      if (finishDate) {
        sessionHint.textContent = label;
        sessionHint.classList.remove('d-none');
      } else {
        sessionHint.classList.add('d-none');
      }
      hoursHint?.classList.add('d-none');
      return;
    }
    if (hasTargetHours() && hoursHint) {
      if (finishDate) {
        hoursHint.textContent = label;
        hoursHint.classList.remove('d-none');
      } else {
        hoursHint.classList.add('d-none');
      }
      sessionHint?.classList.add('d-none');
      return;
    }
    hideBoth();
  }

