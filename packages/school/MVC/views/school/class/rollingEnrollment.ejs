            <dt class="col-sm-4 text-muted">Student</dt>
            <dd class="col-sm-8 mb-2" id="shortcut_reviewStudent">-</dd>
            <dt class="col-sm-4 text-muted">Program</dt>
            <dd class="col-sm-8 mb-2" id="shortcut_reviewProgram">-</dd>
            <dt class="col-sm-4 text-muted">Registration Date</dt>
            <dd class="col-sm-8 mb-0" id="shortcut_reviewDate">-</dd>
          </dl>
          <div class="fw-semibold small mb-1">Fee and validation preview</div>
          <div id="shortcut_previewPanel" class="border rounded bg-light p-2 small text-muted">Choose a program and preview the registration.</div>
        </section>
        <section id="shortcut_stepDraft" class="d-none" aria-live="polite">
          <div class="alert alert-info mb-3">The registration draft has been saved. Review it, then approve and finalize the registration.</div>
          <div class="fw-semibold small mb-1">Draft registration</div>
          <div id="shortcut_draftPanel" class="border rounded bg-light p-2 small text-muted">No draft registration has been saved.</div>
        </section>
        <section id="shortcut_stepFinalized" class="d-none" aria-live="polite">
          <div class="alert alert-light border small text-muted mb-3">Registration finalized. Use <strong>Retry Enrollment Eligibility</strong> when you are ready to continue Rolling Enrollment.</div>
          <div id="shortcut_finalizePanel" class="border rounded bg-light p-2 small text-muted">Program registration finalized.</div>
        </section>
      </div>
      <div class="modal-footer flex-wrap gap-2">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
        <button type="button" class="btn btn-outline-secondary btn-sm d-none" id="btn_shortcutBack"><i class="bi bi-arrow-left me-1"></i>Back to Details</button>
        <button type="button" class="btn btn-primary btn-sm" id="btn_shortcutPreview"><i class="bi bi-eye me-1"></i>Preview Registration</button>
        <button type="button" class="btn btn-primary btn-sm d-none" id="btn_shortcutSaveDraft"><i class="bi bi-save me-1"></i>Save Draft &amp; Continue</button>
        <button type="button" class="btn btn-success btn-sm d-none" id="btn_shortcutApprove" disabled><i class="bi bi-check2-circle me-1"></i>Approve &amp; Finalize</button>
        <button type="button" class="btn btn-outline-success btn-sm d-none" id="btn_shortcutRetry"><i class="bi bi-arrow-clockwise me-1"></i>Retry Enrollment Eligibility</button>
      </div>
    </div>
  </div>
</div>

