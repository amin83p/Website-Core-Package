  let moveSourcePeriodRow = null;
  let approvedEditCloseStatusPayload = null;
  let editModalCurrentRow = null;
  let approvedOnHoldPayload = null;
  let onHoldModalCurrentRow = null;
  const OPEN_EDITABLE_ENROLLMENT_STATUSES = ['active', 'to_be_confirmed', 'waiting_list'];
  const ON_HOLD_ELIGIBLE_STATUSES = ['active', 'to_be_confirmed', 'waiting_list', 'planned'];

  function formatResolvedRegistrationLabel(resolved = {}) {
    const label = String(resolved?.label || '').trim();
    const regDate = String(resolved?.registrationDate || '').trim();
    if (!label) return '';
    if (!regDate) return htmlEscape(label);
    return htmlEscape(`${label} (${regDate})`);
  }

  function setRollingRegistrationPanelHtml(html) {
    const panel = qs('roll_enrollmentRegistrationPanel');
    if (panel) panel.innerHTML = html;
  }

  function isMissingProgramRegistrationMessage(message) {
    const text = String(message || '').toLowerCase();
    return text.includes('no active program registration') || text.includes('register the student in a program listed under this class');
  }

  function isStudentConflictMessage(message) {
    const text = String(message || '').toLowerCase();
    return text.includes('scheduling conflicts detected with the student\'s existing schedule');
  }

  function renderStudentConflictHtml(message) {
    const issue = formatRichServerMessageHtml(message || 'Scheduling conflicts detected with the student\'s existing schedule.');
    const conflicts = lastRollingEligibility?.prerequisite?.conflicts || [];
    const choiceText = conflicts.length === 1
      ? '1 session conflict detected.'
      : conflicts.length + ' session conflicts detected.';
    return (
      '<div class="text-danger small mt-1">' + issue + '</div>' +
      '<div class="d-flex flex-wrap align-items-center gap-2 mt-1">' +
        '<button type="button" class="btn btn-sm btn-danger" id="btn_openStudentConflictModal">' +
          '<i class="bi bi-calendar-x me-1"></i>View Conflicts' +
        '</button>' +
        '<span class="small text-muted">' + htmlEscape(choiceText) + '</span>' +
      '</div>'
    );
  }

  function isMissingTermRegistrationMessage(message) {
    const text = String(message || '').toLowerCase();
    return text.includes('required term registration is missing') || text.includes('register the student in the required term');
  }

  function renderTermRegistrationShortcutPanel(message) {
    const student = getSelectedShortcutStudent();
    const params = new URLSearchParams();
    if (student.id) params.set('studentId', student.id);
    params.set('returnTo', window.location.pathname);
    setRollingRegistrationPanelHtml(
      '<div class="text-danger small mb-2">' + formatRichServerMessageHtml(message || 'Required term registration is missing.') + '</div>' +
      '<a class="btn btn-sm btn-outline-primary" target="_blank" rel="noopener" href="/school/programs/register-terms-batch-wizard?' + htmlEscape(params.toString()) + '">' +
        '<i class="bi bi-box-arrow-up-right me-1"></i>Go To Term Registration' +
      '</a>' +
      '<span class="small text-muted ms-2">Finalize the term registration, then click Retry Enrollment here.</span>'
    );
  }

  function getSelectedShortcutStudent() {
    const studentId = String(qs('inp_studentId')?.value || '').trim();
    const typedLabel = String(qs('inp_studentLabel')?.value || '').trim();
    const student = studentMap.get(studentId) || {};
    return {
      id: studentId,
      label: typedLabel || String(student.label || student.name || studentId || '').trim()
    };
  }

  function getShortcutStudentFromContext() {
    const ctx = groupEnrollmentResultRepairContext;
    if (ctx?.entry?.id) {
      return {
        id: String(ctx.entry.id || '').trim(),
        label: String(ctx.entry.label || ctx.entry.id || '').trim()
      };
    }
    return getSelectedShortcutStudent();
  }

  function getShortcutRegistrationDate() {
    const ctx = groupEnrollmentResultRepairContext;
    if (ctx?.entry?.startDate) return String(ctx.entry.startDate || '').trim();
    return String(qs('inp_startDate')?.value || '').trim() || orgTodayFallback();
  }

  function isCapacityWarningText(value) {
    return String(value || '').trim().toLowerCase().includes('enrollment is at capacity');
  }

  function renderClassCapacityWarningPanel(capacity) {
    if (isRollingCapacityOneClass()) return '';
    const max = Number(capacity?.max || 0);
    const enrolled = Number(capacity?.enrolled || 0);
    if (!(capacity?.isAtCapacity === true && max > 0)) return '';
    const message = 'Enrollment is at capacity: ' + enrolled + ' of ' + max + ' open enrollment slot(s) are already used for this class. Increase Max Student Capacity to enroll more students.';
    return [
      '<div class="d-flex flex-wrap align-items-center gap-2 mt-1">',
      '<span class="text-warning small">' + htmlEscape(message) + '</span>',
      '<a class="btn btn-sm btn-outline-warning" href="/school/classes/edit/' + encodeURIComponent(classId) + '#inp_capacity" target="_blank" rel="noopener">',
      '<i class="bi bi-pencil-square me-1"></i>Edit Capacity',
      '</a>',
      '</div>'
    ].join('');
  }

  function renderProgramRegistrationShortcutPanel(message) {
    const issue = formatRichServerMessageHtml(message || 'This student needs an approved program registration before Rolling Enrollment can continue.');
    if (!canCreateProgramRegistrations) {
      setRollingRegistrationPanelHtml(
        '<div class="text-danger small mb-2">' + issue + '</div>' +
        '<div class="alert alert-warning border py-2 mb-0 small">You need Program Registration create access to register and finalize the student from here.</div>'
      );
      return;
    }
    const choices = Array.isArray(enrollmentProgramChoices) ? enrollmentProgramChoices : [];
    const choiceText = choices.length === 1
      ? 'The class has 1 allowed program available for this shortcut.'
      : 'The class has ' + choices.length + ' allowed programs available for this shortcut.';
    setRollingRegistrationPanelHtml(
      '<div class="text-danger small mb-2">' + issue + '</div>' +
      '<div class="d-flex flex-wrap align-items-center gap-2">' +
        '<button type="button" class="btn btn-sm btn-primary" id="btn_openProgramRegistrationShortcut">' +
          '<i class="bi bi-journal-plus me-1"></i>Register Student In Program' +
        '</button>' +
        '<span class="small text-muted">' + htmlEscape(choiceText) + '</span>' +
      '</div>'
    );
  }

  function renderClbPlacementInsightButtonHtml(clbPlacement) {
    const clb = (clbPlacement && typeof clbPlacement === 'object') ? clbPlacement : {};
    if (!clb.hasInsight) return '';
    return '<div class="mt-2">'
      + '<button type="button" class="btn btn-sm btn-outline-secondary" id="btn_openClbPlacementInsight">'
      + '<i class="bi bi-info-circle me-1"></i>CLB &amp; prerequisite details'
      + '</button>'
      + '</div>';
  }

  function populateClbPlacementInsightModal(clbPlacement, options = {}) {
    const clb = (clbPlacement && typeof clbPlacement === 'object') ? clbPlacement : {};
    const eligible = options.eligible === true;
    const student = getSelectedShortcutStudent();
    const resolved = lastRollingEligibility?.resolved || {};
    const skillLabels = {
      listening: 'Listening',
      speaking: 'Speaking',
      reading: 'Reading',
      writing: 'Writing'
    };

    if (qs('clbInsight_studentLabel')) {
      qs('clbInsight_studentLabel').value = student.label || student.id || '';
    }
    if (qs('clbInsight_programLabel')) {
      qs('clbInsight_programLabel').value = String(resolved.label || resolved.programId || '').trim();
    }

    const currentBox = qs('clbInsight_currentClb');
    if (currentBox) {
      if (!clb.currentClb) {
        currentBox.innerHTML = '<div class="text-muted">No Current CLB recorded.</div>';
      } else {
        const current = clb.currentClb.current || {};
        const bySkill = clb.currentClb.normalizedBySkill || {};
        const rows = ['listening', 'speaking', 'reading', 'writing'].map((skill) => {
          const raw = String(current[skill] || '').trim() || '—';
          const norm = bySkill[skill] !== undefined && bySkill[skill] !== null ? String(bySkill[skill]) : '—';
          return '<tr><td class="fw-semibold">' + htmlEscape(skillLabels[skill]) + '</td>'
            + '<td>' + htmlEscape(raw) + '</td>'
            + '<td class="text-muted">' + htmlEscape(norm !== '—' ? '→ ' + norm : '—') + '</td></tr>';
        }).join('');
        const levels = Array.isArray(clb.currentClb.normalizedLevels) ? clb.currentClb.normalizedLevels.join(', ') : '';
        const recordedAt = String(clb.currentClb.recordedAt || '').trim();
        currentBox.innerHTML = '<div class="mb-2">'
          + '<div><span class="fw-semibold">Recorded:</span> ' + htmlEscape(recordedAt || '—') + '</div>'
          + (levels ? '<div><span class="fw-semibold">Normalized levels:</span> ' + htmlEscape(levels) + '</div>' : '')
          + '</div>'
          + '<table class="table table-sm table-bordered mb-0 bg-white"><thead><tr>'
          + '<th>Skill</th><th>Current</th><th>Normalized</th></tr></thead><tbody>' + rows + '</tbody></table>';
      }
    }

    const classSubjectsBox = qs('clbInsight_classSubjects');
    if (classSubjectsBox) {
      const classSubjects = Array.isArray(clb.classSubjects) ? clb.classSubjects : [];
      if (!classSubjects.length) {
        classSubjectsBox.innerHTML = '<div class="text-muted">No CLB-configured subjects on this class.</div>';
      } else {
        classSubjectsBox.innerHTML = classSubjects.map((row) => {
          const label = [row.code, row.title].filter(Boolean).join(' — ') || row.id;
          const clbPart = row.clbLevel !== null && row.clbLevel !== undefined
            ? 'CLB ' + row.clbLevel
            : 'No CLB level';
          const matchPart = row.clbLevel !== null
            ? (row.matchesStudentLevels
              ? '<span class="badge bg-success-subtle text-success border">Matches student levels</span>'
              : '<span class="badge bg-light text-secondary border">Outside student levels</span>')
            : '';
          return '<div class="border rounded bg-white p-2 mb-2">'
            + '<div class="fw-semibold">' + htmlEscape(label) + '</div>'
            + '<div class="text-muted">' + htmlEscape(clbPart) + '</div>'
            + (matchPart ? '<div class="mt-1">' + matchPart + '</div>' : '')
            + '</div>';
        }).join('');
      }
    }

    const summaryBox = qs('clbInsight_summary');
    if (summaryBox) {
      const summary = String(clb.qualificationSummary || '').trim();
      summaryBox.textContent = summary
        || (eligible
          ? 'Prerequisites for this class are satisfied for the selected start date.'
          : 'Review prerequisite requirements and CLB alignment.');
    }
  }

  async function openClbPlacementInsightModal() {
    const clb = lastRollingEligibility?.clbPlacement || {};
    if (!clb.hasInsight) {
      await showMsg('CLB Details', 'info', 'No CLB or prerequisite insight is available for this eligibility result.');
      return;
    }
    populateClbPlacementInsightModal(clb, { eligible: lastRollingEligibility?.eligible === true });
    clbPlacementInsightModal?.show();
  }

  function getPriorRepairFromEligibility(eligibility = {}) {
    const prereq = eligibility?.prerequisite || {};
    return {
      missingSubjects: Array.isArray(prereq.missingSubjects) ? prereq.missingSubjects : [],
      programId: String(prereq.repairProgramId || eligibility?.resolved?.programId || '').trim(),
      programLabel: String(eligibility?.resolved?.label || prereq.repairProgramId || eligibility?.resolved?.programId || '').trim()
    };
  }

  function getPriorRepairPrerequisite() {
    return getPriorRepairFromEligibility(lastRollingEligibility);
  }

  function isAdvisoryPrerequisiteEnforcement(prereq = {}) {
    return String(prereq.enforcementMode || 'advisory').trim().toLowerCase() === 'advisory';
  }

  function isGroupPrerequisiteRepairable(prereqPayload = {}) {
    const prereq = prereqPayload.prerequisite || {};
    const missingSubjects = Array.isArray(prereq.missingSubjects) ? prereq.missingSubjects : [];
    if (!missingSubjects.length) return false;
    if (!canCreatePriorSubjectCredits || prereq.canCreatePriorCredits === false) return false;
    const issues = Array.isArray(prereq.issues) ? prereq.issues : [];
    if (issues.some(isStudentConflictMessage)) return false;
    if (issues.some(isMissingProgramRegistrationMessage)) return false;
    if (issues.some(isMissingTermRegistrationMessage)) return false;
    if (prereqPayload.eligible === true) {
      return isAdvisoryPrerequisiteEnforcement(prereq);
    }
    return true;
  }

  function classifyGroupEnrollmentFailure(prereq, errorMsg) {
    const issues = Array.isArray(prereq?.prerequisite?.issues) ? prereq.prerequisite.issues : [];
    const msg = String(errorMsg || '');
    if (issues.some(isMissingProgramRegistrationMessage) || isMissingProgramRegistrationMessage(msg)) return 'missing_program';
    if (issues.some(isMissingTermRegistrationMessage) || isMissingTermRegistrationMessage(msg)) return 'missing_term';
    if (issues.some(isStudentConflictMessage) || isStudentConflictMessage(msg)) return 'schedule_conflict';
    if (isGroupPrerequisiteRepairable(prereq)) return 'missing_subjects';
    return 'other';
  }

  function snapshotGroupEnrollmentEntry(entry = {}) {
    return {
      id: String(entry.id || '').trim(),
      label: String(entry.label || entry.id || '').trim(),
      startDate: String(entry.startDate || '').trim(),
      endDate: String(entry.endDate || '').trim(),
      status: String(entry.status || 'active').trim(),
      funderType: String(entry.funderType || 'self').trim(),
      funderId: String(entry.funderId || 'self').trim(),
      claimNumber: String(entry.claimNumber || '').trim(),
      reasonStart: String(entry.reasonStart || '').trim(),
      targetSessionCount: String(entry.targetSessionCount || '').trim(),
      targetHours: String(entry.targetHours || '').trim(),
      sessionCapacityType: normalizeSessionCapacityTypeValue(entry.sessionCapacityType),
      autoResolveSubjects: entry.autoResolveSubjects === true
    };
  }

  function buildGroupEnrollmentFailureResult(entry, prereq, errorMsg) {
    const label = String(entry?.label || entry?.id || '').trim();
    const issues = Array.isArray(prereq?.prerequisite?.issues) ? prereq.prerequisite.issues : [];
    const msg = errorMsg
      || (issues.length ? issues.join('; ') : String(prereq?.message || 'Enrollment failed.'));
    return {
      studentId: entry.id,
      label,
      ok: false,
      error: msg,
      failureKind: classifyGroupEnrollmentFailure(prereq, msg),
      prereq,
      entry: snapshotGroupEnrollmentEntry(entry)
    };
  }

  function syncPriorRepairModalGroupModeUi(options = {}) {
    const opts = typeof options === 'boolean' ? { groupMode: options } : (options || {});
    const isGroupMode = opts.groupMode === true;
    const isResultsMode = opts.groupResultsMode === true;
    const groupAlert = qs('priorRepair_groupAlert');
    const defaultAlert = qs('priorRepair_defaultAlert');
    const skipBtn = qs('btn_priorRepairSkipStudent');
    const closeBtn = qs('btn_priorRepairClose');
    const retryLabel = qs('priorRepair_retryLabel');
    if (groupAlert) groupAlert.classList.toggle('d-none', !isGroupMode);
    if (defaultAlert) defaultAlert.classList.toggle('d-none', isGroupMode);
    if (skipBtn) skipBtn.classList.toggle('d-none', !isGroupMode || isResultsMode);
    if (closeBtn) closeBtn.classList.toggle('d-none', isGroupMode);
    if (retryLabel) {
      retryLabel.textContent = isResultsMode
        ? 'Complete enrollment'
        : (isGroupMode ? 'Retry Enrollment' : 'Retry Eligibility');
    }
  }

  function populatePriorCreditRepairModal(student = {}, repair = {}, options = {}) {
    const evidenceDefault = options.groupResultsMode
      ? 'Added from Group Enrollment results repair'
      : (options.groupMode
        ? 'Added from Group Enrollment prerequisite repair'
        : 'Added from Rolling Enrollment prerequisite repair');
    if (qs('priorRepair_studentLabel')) qs('priorRepair_studentLabel').value = student.label || student.id || '';
    if (qs('priorRepair_programLabel')) qs('priorRepair_programLabel').value = repair.programLabel || repair.programId || '';
    if (qs('priorRepair_source')) qs('priorRepair_source').value = 'manual_waiver';
    if (qs('priorRepair_evidenceNote')) qs('priorRepair_evidenceNote').value = evidenceDefault;
    renderPriorRepairSubjectList(repair.missingSubjects);
    syncPriorRepairModalGroupModeUi({
      groupMode: options.groupMode === true,
      groupResultsMode: options.groupResultsMode === true
    });
  }

  async function refreshGroupEnrollmentResultPrereq(resultIndex) {
    const result = groupEnrollmentLastResults[resultIndex];
    if (!result?.entry?.id) return;
    const settings = groupEnrollmentSettingsFromEntry(result.entry);
    const prereq = await fetchGroupStudentPrerequisites(result.entry.id, settings.startDate);
    if (!prereq) return;
    groupEnrollmentLastResults[resultIndex] = {
      ...result,
      prereq,
      failureKind: classifyGroupEnrollmentFailure(prereq, result.error)
    };
    renderGroupEnrollmentResultRow(resultIndex);
    syncGroupEnrollmentResultsChrome();
  }

  function renderPriorCreditRepairPanel(message, options = {}) {
    const repair = getPriorRepairPrerequisite();
    const advisory = options.advisory === true || isAdvisoryPrerequisiteEnforcement(lastRollingEligibility?.prerequisite);
    const prereqWarnings = Array.isArray(lastRollingEligibility?.prerequisite?.warnings)
      ? lastRollingEligibility.prerequisite.warnings
      : [];
    const issue = prereqWarnings.length
      ? prereqWarnings.map((item) => formatRichServerMessageHtml(item)).join('<br>')
      : ((Array.isArray(lastRollingEligibility?.prerequisite?.issues) && lastRollingEligibility.prerequisite.issues.length)
        ? lastRollingEligibility.prerequisite.issues.map((item) => formatRichServerMessageHtml(item)).join('<br>')
        : formatRichServerMessageHtml(message || (advisory
          ? 'Prerequisite warnings were found for this class. Enrollment is allowed, but prior credits may be needed.'
          : 'Prerequisites are not satisfied for this class.')));
    const alertClass = advisory ? 'text-warning' : 'text-danger';
    if (!repair.missingSubjects.length) {
      setRollingRegistrationPanelHtml(
        '<div class="' + alertClass + ' small">' + issue + '</div>'
        + renderClbPlacementInsightButtonHtml(lastRollingEligibility?.clbPlacement)
      );
      return;
    }
    if (!canCreatePriorSubjectCredits || lastRollingEligibility?.prerequisite?.canCreatePriorCredits === false) {
      setRollingRegistrationPanelHtml(
        '<div class="' + alertClass + ' small mb-2">' + issue + '</div>' +
        '<div class="alert alert-warning border py-2 mb-0 small">You need Prior Subject Credits create access to add prerequisite credits from here.</div>'
        + renderClbPlacementInsightButtonHtml(lastRollingEligibility?.clbPlacement)
      );
      return;
    }
    setRollingRegistrationPanelHtml(
      '<div class="' + alertClass + ' small mb-2">' + issue + '</div>' +
      '<div class="d-flex flex-wrap align-items-center gap-2">' +
        '<button type="button" class="btn btn-sm btn-warning" id="btn_openPriorCreditRepair">' +
          '<i class="bi bi-mortarboard me-1"></i>Fix Prerequisites / Add Prior Credits' +
        '</button>' +
        (function () {
          const clb = lastRollingEligibility?.clbPlacement || {};
          const canApply = clb.canApplyPlacement === true
            && canCreatePriorSubjectCredits
            && lastRollingEligibility?.prerequisite?.canCreatePriorCredits !== false;
          if (!canApply) return '';
          return '<button type="button" class="btn btn-sm btn-primary" id="btn_applyClbPlacementCredits">' +
            '<i class="bi bi-lightning-charge me-1"></i>Apply CLB Placement Credits' +
          '</button>';
        })() +
        '<span class="small text-muted">' + htmlEscape(String(repair.missingSubjects.length)) + ' suggested prerequisite credit' + (repair.missingSubjects.length === 1 ? '' : 's') + '.</span>' +
      '</div>'
      + renderClbPlacementInsightButtonHtml(lastRollingEligibility?.clbPlacement)
    );
  }

  async function applyClbPlacementCredits() {
    if (shortcutActionInProgress) return;
    const student = getSelectedShortcutStudent();
    const repair = getPriorRepairPrerequisite();
    const clb = lastRollingEligibility?.clbPlacement || {};
    if (!student.id || !repair.programId) {
      await showMsg('Missing Context', 'warning', 'Student and program are required before applying CLB placement credits.');
      return;
    }
    if (!clb.canApplyPlacement) {
      await showMsg('CLB Placement', 'info', 'No CLB placement credits are available for the current eligibility result.');
      return;
    }
    shortcutActionInProgress = true;
    try {
      showBusy('Applying CLB placement prior credits...');
      const startDate = String(qs('inp_startDate')?.value || '').trim();
      const result = await requestJson(
        '/school/classes/api/' + encodeURIComponent(classId) + '/rolling-prior-subject-credits/apply-placement',
        'POST',
        {
          studentId: student.id,
          studentIds: [student.id],
          programId: repair.programId,
          startDate
        }
      );
      if (!result) return;
      const errorList = Array.isArray(result.errors) ? result.errors : [];
      const createdCount = Number(result.createdCount || 0);
      const skippedCount = Number(result.skippedDuplicateCount || 0);
      const placementLevels = Array.isArray(result.placement?.normalizedLevels)
        ? result.placement.normalizedLevels.join(', ')
        : '';
      const statusIcon = errorList.length ? 'warning' : 'success';
      const message = [
        `Applied CLB placement for levels ${placementLevels || 'n/a'}.`,
        `Created ${createdCount} prior subject credit${createdCount === 1 ? '' : 's'}.`,
        skippedCount ? `Skipped ${skippedCount} duplicate credit${skippedCount === 1 ? '' : 's'}.` : '',
        errorList.length ? errorList.map((row) => `${row.subjectId || 'Subject'}: ${row.message || 'Save failed.'}`).join('<br>') : ''
      ].filter(Boolean).join('<br>');
      await showMsg('CLB Placement Credits', statusIcon, message || 'CLB placement prior credits were applied.');
      await refreshRollingEligibility();
    } catch (error) {
      await showMsg('CLB Placement Failed', 'error', error?.message || 'Unable to apply CLB placement credits.');
    } finally {
      hideBusy();
      shortcutActionInProgress = false;
    }
  }

  function renderPriorRepairSubjectList(subjects) {
    const box = qs('priorRepair_subjectList');
    if (!box) return;
    const list = Array.isArray(subjects) ? subjects : [];
    if (!list.length) {
      box.innerHTML = '<div class="text-muted">No missing prerequisite subjects were found in the latest eligibility result.</div>';
      return;
    }
    box.innerHTML = list.map((subject, index) => {
      const id = String(subject?.id || '').trim();
      return ''
        + '<label class="d-flex align-items-start gap-2 border rounded bg-white p-2 mb-2">'
        +   '<input type="checkbox" class="form-check-input mt-1 prior-repair-subject" value="' + htmlEscape(id) + '" checked>'
        +   '<span class="flex-grow-1">'
        +     '<span class="fw-semibold d-block">' + htmlEscape(subject?.label || id) + '</span>'
        +     '<span class="small text-muted">' + htmlEscape(subject?.reason || 'Required prerequisite') + '</span>'
        +   '</span>'
        + '</label>';
    }).join('');
  }

  async function openPriorCreditRepairModal() {
    groupEnrollmentResultRepairContext = null;
    const student = getSelectedShortcutStudent();
    const repair = getPriorRepairPrerequisite();
    if (!student.id) {
      await showMsg('Select Student', 'warning', 'Select a student first.');
      return;
    }
    if (!repair.programId) {
      await showMsg('Program Required', 'warning', 'Resolve the program registration before adding prior subject credits.');
      return;
    }
    if (!repair.missingSubjects.length) {
      await showMsg('No Suggestions', 'info', 'No missing prerequisite subjects were found in the latest eligibility result.');
      return;
    }
    populatePriorCreditRepairModal(student, repair, { groupMode: false });
    if (priorCreditRepairModalEl && bootstrapApi?.Modal) {
      bootstrapApi.Modal.getOrCreateInstance(priorCreditRepairModalEl, { backdrop: true, keyboard: true });
    }
    priorCreditRepairModal?.show();
  }

  function openStudentConflictModal() {
    const student = getSelectedShortcutStudent();
    const conflicts = lastRollingEligibility?.prerequisite?.conflicts || [];
    const tbody = qs('studentConflictTbody');
    if (!tbody) return;
    
    if (!conflicts.length) {
      tbody.innerHTML = '<tr><td colspan="3" class="text-center text-muted">No conflicts found.</td></tr>';
    } else {
      tbody.innerHTML = conflicts.map(function(c) {
        return '<tr>' +
          '<td>' + htmlEscape(c.date || '') + '</td>' +
          '<td>' + htmlEscape(c.conflictClass || '') + '</td>' +
          '<td>' + htmlEscape(c.existTime || '') + '</td>' +
          '</tr>';
      }).join('');
    }
    
    const viewBtn = qs('btn_viewStudentSchedule');
    if (viewBtn && student.id) {
      const personId = lastRollingEligibility?.prerequisite?.conflictStudentPersonId || student.id;
      const personName = lastRollingEligibility?.prerequisite?.conflictStudentLabel || student.label || '';
      const startDate = qs('inp_startDate')?.value || '';
      const params = new URLSearchParams();
      params.set('personId', personId);
      params.set('personName', personName);
      if (startDate) params.set('date', startDate);
      viewBtn.href = '/school/schedules/viewer?' + params.toString();
    }
    
    const modalEl = qs('studentConflictModal');
    if (modalEl) {
      const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
      modal.show();
    }
  }

  function getSelectedPriorRepairSubjectIds() {
    return Array.from(document.querySelectorAll('.prior-repair-subject:checked'))
      .map((input) => String(input.value || '').trim())
      .filter(Boolean);
  }

  async function savePriorCreditRepair() {
    const resultCtx = groupEnrollmentResultRepairContext;
    if (!resultCtx && shortcutActionInProgress) return;
    const student = resultCtx
      ? { id: resultCtx.entry.id, label: resultCtx.entry.label || resultCtx.entry.id }
      : getSelectedShortcutStudent();
    const repair = resultCtx
      ? getPriorRepairFromEligibility(resultCtx.prereq)
      : getPriorRepairPrerequisite();
    const subjectIds = getSelectedPriorRepairSubjectIds();
    if (!student.id || !repair.programId) {
      await showMsg('Missing Context', 'warning', 'Student and program are required before adding prior credits.');
      return;
    }
    if (!subjectIds.length) {
      await showMsg('Select Subjects', 'warning', 'Select at least one suggested prerequisite subject.');
      return;
    }
    if (!resultCtx) shortcutActionInProgress = true;
    try {
      showBusy('Saving prior subject credits...');
      const result = await requestJson('/school/classes/api/' + encodeURIComponent(classId) + '/rolling-prior-subject-credits/batch', 'POST', {
        studentId: student.id,
        studentIds: [student.id],
        programId: repair.programId,
        subjectIds,
        source: String(qs('priorRepair_source')?.value || 'manual_waiver').trim(),
        evidenceNote: String(qs('priorRepair_evidenceNote')?.value || '').trim()
      });
      if (!result) return;
      const errorList = Array.isArray(result.errors) ? result.errors : [];
      const createdCount = Number(result.createdCount || 0);
      const skippedCount = Number(result.skippedDuplicateCount || 0);
      const statusIcon = errorList.length ? 'warning' : 'success';
      const message = [
        `Created ${createdCount} prior subject credit${createdCount === 1 ? '' : 's'}.`,
        skippedCount ? `Skipped ${skippedCount} duplicate credit${skippedCount === 1 ? '' : 's'}.` : '',
        errorList.length ? errorList.map((row) => `${row.subjectId || 'Subject'}: ${row.message || 'Save failed.'}`).join('<br>') : ''
      ].filter(Boolean).join('<br>');
      await showMsg('Prior Credits Saved', statusIcon, message || 'Prior subject credits were saved.');
      if (resultCtx) {
        const repairSubjects = getPriorRepairFromEligibility(resultCtx.prereq);
        renderPriorRepairSubjectList(repairSubjects.missingSubjects);
        await refreshGroupEnrollmentResultPrereq(resultCtx.resultIndex);
        syncPriorRepairModalGroupModeUi(false);
        groupEnrollmentResultRepairContext = null;
        if (priorCreditRepairModalEl && bootstrapApi?.Modal) {
          bootstrapApi.Modal.getOrCreateInstance(priorCreditRepairModalEl, { backdrop: true, keyboard: true });
        }
        priorCreditRepairModal?.hide();
      } else {
        await refreshRollingEligibility();
      }
    } catch (error) {
      await showMsg('Prior Credits Failed', 'error', error.message || 'Unable to save prior subject credits.');
    } finally {
      if (!resultCtx) shortcutActionInProgress = false;
      hideBusy();
    }
  }

  async function handlePriorRepairRetry() {
    const ctx = groupEnrollmentResultRepairContext;
    if (ctx) {
      syncPriorRepairModalGroupModeUi(false);
      groupEnrollmentResultRepairContext = null;
      if (priorCreditRepairModalEl && bootstrapApi?.Modal) {
        bootstrapApi.Modal.getOrCreateInstance(priorCreditRepairModalEl, { backdrop: true, keyboard: true });
      }
      priorCreditRepairModal?.hide();
      await retryGroupEnrollmentResult(ctx.resultIndex);
      return;
    }
    await refreshRollingEligibility();
  }

  function renderShortcutPreviewHtml(rows, message) {
    const list = Array.isArray(rows) ? rows : [];
    if (!list.length) {
      return '<div class="text-muted">' + htmlEscape(message || 'No preview rows returned.') + '</div>';
    }
    return list.map(function (row) {
      const issues = Array.isArray(row?.issues) ? row.issues : [];
      const status = String(row?.status || '').trim().toLowerCase();
      const badge = status === 'ready' || status === 'draft' || status === 'success'
        ? 'bg-success'
        : (status === 'warning' ? 'bg-warning text-dark' : 'bg-danger');
      const issueClass = status === 'warning' ? 'text-warning-emphasis' : 'text-danger';
      return ''
        + '<div class="border rounded p-2 bg-white mb-2">'
        +   '<div class="d-flex justify-content-between gap-2">'
        +     '<div class="fw-semibold">' + htmlEscape(row?.studentName || row?.studentId || 'Student') + '</div>'
        +     '<span class="badge ' + badge + '">' + htmlEscape(status || '-') + '</span>'
        +   '</div>'
        +   '<div class="small text-muted">Fee Category: ' + htmlEscape(row?.feeCategory || '-') + ' | Account: <span class="font-monospace">' + htmlEscape(row?.studentAccountId || '-') + '</span></div>'
        +   '<div class="small text-muted">Total Fee: <span class="fw-semibold">' + htmlEscape(Number(row?.totalAmount || 0).toFixed(2)) + '</span> | Transactions: <span class="fw-semibold">' + htmlEscape(row?.transactionCount || 0) + '</span></div>'
        +   (row?.registrationId ? '<div class="small text-muted">Draft Registration: <span class="font-monospace">' + htmlEscape(row.registrationId) + '</span></div>' : '')
        +   (issues.length ? '<div class="' + issueClass + ' small mt-1">' + issues.map((issue) => formatRichServerMessageHtml(issue)).join('<br>') + '</div>' : '')
        +   (row?.message && !issues.length ? '<div class="small mt-1">' + formatRichServerMessageHtml(row.message) + '</div>' : '')
        + '</div>';
    }).join('');
  }

  function setProgramRegistrationShortcutHint(message) {
    const feedback = qs('shortcut_stepFeedback');
    if (!feedback) return;
    feedback.className = 'alert alert-light border small text-muted';
    feedback.textContent = String(message || '');
  }

  function shortcutOutcomeIcon(style) {
    if (style === 'success') return 'success';
    if (style === 'danger') return 'error';
    if (style === 'warning') return 'warning';
    return 'info';
  }

  async function notifyProgramRegistrationShortcutOutcome(style, message, title = 'Register Student In Program') {
    const text = String(message || '').trim();
    if (!text) return;
    await showMsg(title, shortcutOutcomeIcon(style), text);
  }

  function isProgramRegistrationShortcutPreviewReady(rowsOverride = null) {
    const rows = Array.isArray(rowsOverride)
      ? rowsOverride
      : (Array.isArray(programShortcutPreview?.rows) ? programShortcutPreview.rows : []);
    const status = String(rows[0]?.status || '').trim().toLowerCase();
    return rows.length === 1 && ['ready', 'warning'].includes(status);
  }

  function setProgramRegistrationShortcutStep(step) {
    const nextStep = ['details', 'preview', 'draft', 'finalized'].includes(step) ? step : 'details';
    programShortcutStep = nextStep;
    const copy = {
      details: { number: 'Step 1 of 4', label: 'Registration details' },
      preview: { number: 'Step 2 of 4', label: 'Review preview' },
      draft: { number: 'Step 3 of 4', label: 'Review draft' },
      finalized: { number: 'Step 4 of 4', label: 'Registration finalized' }
    }[nextStep];
    const isDetails = nextStep === 'details';
    const isPreview = nextStep === 'preview';
    const isDraft = nextStep === 'draft';
    const isFinalized = nextStep === 'finalized';
    qs('shortcut_stepNumber').textContent = copy.number;
    qs('shortcut_stepLabel').textContent = copy.label;
    qs('shortcut_stepDetails')?.classList.toggle('d-none', !isDetails);
    qs('shortcut_stepPreview')?.classList.toggle('d-none', !isPreview);
    qs('shortcut_stepDraft')?.classList.toggle('d-none', !isDraft);
    qs('shortcut_stepFinalized')?.classList.toggle('d-none', !isFinalized);
    qs('btn_shortcutBack')?.classList.toggle('d-none', !isPreview);
    qs('btn_shortcutPreview')?.classList.toggle('d-none', !isDetails);
    qs('btn_shortcutSaveDraft')?.classList.toggle('d-none', !isPreview);
    qs('btn_shortcutApprove')?.classList.toggle('d-none', !isDraft);
    qs('btn_shortcutRetry')?.classList.toggle('d-none', !isFinalized);
    if (qs('btn_shortcutSaveDraft')) qs('btn_shortcutSaveDraft').disabled = !isProgramRegistrationShortcutPreviewReady();
    if (qs('btn_shortcutApprove')) {
      qs('btn_shortcutApprove').disabled = !String(qs('shortcut_registrationId')?.value || '').trim();
    }
  }

  function renderProgramRegistrationShortcutReview(payload) {
    const selectedOption = qs('shortcut_programId')?.selectedOptions?.[0];
    if (qs('shortcut_reviewStudent')) qs('shortcut_reviewStudent').textContent = String(qs('shortcut_studentLabel')?.value || payload?.studentIds?.[0] || '-');
    if (qs('shortcut_reviewProgram')) qs('shortcut_reviewProgram').textContent = String(selectedOption?.textContent || payload?.programId || '-').trim();
    if (qs('shortcut_reviewDate')) qs('shortcut_reviewDate').textContent = String(payload?.effectiveDate || '-');
  }

  function resetProgramRegistrationShortcutPreview() {
    programShortcutPreview = null;
    if (qs('shortcut_previewPanel')) qs('shortcut_previewPanel').innerHTML = 'Choose a program and preview the registration.';
  }

  function resetProgramRegistrationShortcutModal() {
    const student = getShortcutStudentFromContext();
    programShortcutPreview = null;
    if (qs('shortcut_registrationId')) qs('shortcut_registrationId').value = '';
    if (qs('shortcut_studentLabel')) qs('shortcut_studentLabel').value = student.label || student.id || '';
    if (qs('shortcut_registrationDate')) {
      qs('shortcut_registrationDate').value = getShortcutRegistrationDate();
    }
    if (qs('shortcut_externalReference')) qs('shortcut_externalReference').value = '';
    if (qs('shortcut_note')) qs('shortcut_note').value = 'Created from Rolling Enrollment shortcut';
    const select = qs('shortcut_programId');
    if (select) {
      const options = (Array.isArray(enrollmentProgramChoices) ? enrollmentProgramChoices : []).map(function (choice) {
        return '<option value="' + htmlEscape(String(choice?.programId || '')) + '">' + htmlEscape(String(choice?.label || choice?.programId || 'Program')) + '</option>';
      });
      select.innerHTML = options.length ? options.join('') : '<option value="">No allowed programs</option>';
      select.disabled = options.length === 0;
    }
    resetProgramRegistrationShortcutPreview();
    if (qs('shortcut_draftPanel')) qs('shortcut_draftPanel').innerHTML = 'No draft registration has been saved.';
    if (qs('shortcut_finalizePanel')) qs('shortcut_finalizePanel').innerHTML = 'Program registration finalized.';
    setProgramRegistrationShortcutStep('details');
    setProgramRegistrationShortcutHint('Enter the registration details, then preview fees and validation before saving a draft.');
  }

  function getProgramShortcutPayload() {
    const student = getShortcutStudentFromContext();
    return {
      classId,
      programId: String(qs('shortcut_programId')?.value || '').trim(),
      studentIds: [student.id],
      effectiveDate: String(qs('shortcut_registrationDate')?.value || '').trim(),
      externalReference: String(qs('shortcut_externalReference')?.value || '').trim(),
      note: String(qs('shortcut_note')?.value || '').trim()
    };
  }

  async function openProgramRegistrationShortcutModal() {
    if (!canCreateProgramRegistrations) {
      await showMsg('Access Required', 'warning', 'You need Program Registration create access to register and finalize the student from here.');
      return;
    }
    groupEnrollmentResultRepairContext = null;
    const student = getSelectedShortcutStudent();
    if (!student.id) {
      await showMsg('Select Student', 'warning', 'Select a student first.');
      return;
    }
    resetProgramRegistrationShortcutModal();
    programShortcutModal?.show();
  }

  async function openGroupResultProgramRegistration(resultIndex) {
    const result = groupEnrollmentLastResults[resultIndex];
    if (!result?.entry?.id) return;
    if (!canCreateProgramRegistrations) {
      await showMsg('Access Required', 'warning', 'You need Program Registration create access to register and finalize the student from here.');
      return;
    }
    groupEnrollmentResultRepairContext = {
      resultIndex,
      entry: result.entry,
      prereq: result.prereq,
      mode: 'program'
    };
    resetProgramRegistrationShortcutModal();
    programShortcutModal?.show();
  }

  async function previewProgramRegistrationShortcut() {
    if (shortcutActionInProgress) return;
    const payload = getProgramShortcutPayload();
    if (!payload.programId || !payload.studentIds[0] || !payload.effectiveDate) {
      await showMsg('Missing Fields', 'warning', 'Student, allowed program, and registration date are required.');
      return;
    }
    const regDateIssue = validateCycleRegistrationDate(payload.effectiveDate);
    if (regDateIssue) {
      await showMsg('Date out of range', 'warning', regDateIssue);
      return;
    }
    shortcutActionInProgress = true;
    try {
      showBusy('Previewing program registration...');
      const result = await requestJson('/school/classes/api/' + encodeURIComponent(classId) + '/rolling-program-registration/preview', 'POST', payload);
      if (!result) return;
      const rows = Array.isArray(result.preview) ? result.preview : (Array.isArray(result.previews) ? result.previews : []);
      if (qs('shortcut_previewPanel')) qs('shortcut_previewPanel').innerHTML = renderShortcutPreviewHtml(rows, result.message);
      const readyFromFreshRows = isProgramRegistrationShortcutPreviewReady(rows);
      const firstStatus = String(rows[0]?.status || '').trim().toLowerCase();
      // Always store and advance so fee/validation details are visible on Step 2.
      programShortcutPreview = { payload, rows };
      renderProgramRegistrationShortcutReview(payload);
      setProgramRegistrationShortcutStep('preview');
      if (!readyFromFreshRows) {
        const issues = Array.isArray(rows[0]?.issues) ? rows[0].issues : [];
        const detail = issues.length
          ? issues.join(' ')
          : (String(rows[0]?.message || result.message || '').trim() || 'Preview validation failed.');
        await notifyProgramRegistrationShortcutOutcome(
          'warning',
          detail + ' Return to details, make corrections, and preview again.'
        );
        return;
      }
      const previewHasWarning = firstStatus === 'warning';
      await notifyProgramRegistrationShortcutOutcome(
        previewHasWarning ? 'warning' : 'success',
        previewHasWarning
          ? 'Review the warning, then save the registration draft to continue. The academic registration will still be recorded.'
          : 'Review the preview, then save the registration draft to continue.'
      );
    } catch (error) {
      resetProgramRegistrationShortcutPreview();
      await notifyProgramRegistrationShortcutOutcome('danger', error.message || 'Unable to preview program registration.', 'Preview failed');
    } finally {
      shortcutActionInProgress = false;
      hideBusy();
    }
  }

  async function saveProgramRegistrationShortcutDraft() {
    if (shortcutActionInProgress || programShortcutStep !== 'preview') return;
    const payload = programShortcutPreview?.payload;
    if (!payload || !isProgramRegistrationShortcutPreviewReady()) {
      await notifyProgramRegistrationShortcutOutcome('warning', 'Preview a valid registration before saving the draft.');
      return;
    }
    shortcutActionInProgress = true;
    try {
      showBusy('Saving program registration draft...');
      const result = await requestJson(
        '/school/classes/api/' + encodeURIComponent(classId) + '/rolling-program-registration/apply',
        'POST',
        payload,
        { allowErrorResult: true }
      );
      if (!result) return;
      const draft = (Array.isArray(result.results) ? result.results : []).find((row) => String(row?.status || '').toLowerCase() === 'draft');
      if (draft?.registrationId && qs('shortcut_registrationId')) {
        qs('shortcut_registrationId').value = String(draft.registrationId);
      }
      if (qs('shortcut_previewPanel')) qs('shortcut_previewPanel').innerHTML = renderShortcutPreviewHtml(result.results, result.message);
      if (qs('shortcut_draftPanel')) qs('shortcut_draftPanel').innerHTML = renderShortcutPreviewHtml(result.results, result.message);
      if (String(result.status || '').toLowerCase() === 'error') {
        await notifyProgramRegistrationShortcutOutcome('danger', result.message || 'Unable to save program registration draft.', 'Save draft failed');
        return;
      }
      if (!draft?.registrationId) {
        await notifyProgramRegistrationShortcutOutcome('warning', result.message || 'The draft was not created. Review the result and try again.');
        return;
      }
      setProgramRegistrationShortcutStep('draft');
      await notifyProgramRegistrationShortcutOutcome('success', result.message || 'Draft saved. Approve and finalize the registration to continue.', 'Draft saved');
    } catch (error) {
      await notifyProgramRegistrationShortcutOutcome('danger', error.message || 'Unable to save program registration draft.', 'Save draft failed');
    } finally {
      shortcutActionInProgress = false;
      hideBusy();
    }
  }

  async function approveProgramRegistrationShortcutDraft() {
    if (shortcutActionInProgress || programShortcutStep !== 'draft') return;
    const registrationId = String(qs('shortcut_registrationId')?.value || '').trim();
    if (!registrationId) {
      await notifyProgramRegistrationShortcutOutcome('warning', 'Save the draft before approving and finalizing it.');
      return;
    }
    shortcutActionInProgress = true;
    try {
      showBusy('Approving program registration...');
      const result = await requestJson('/school/classes/api/' + encodeURIComponent(classId) + '/rolling-program-registration/approve/' + encodeURIComponent(registrationId), 'POST', {
        note: String(qs('shortcut_note')?.value || 'Approved from Rolling Enrollment shortcut').trim()
      });
      if (!result) return;
      if (qs('shortcut_finalizePanel')) {
        qs('shortcut_finalizePanel').innerHTML = '<div class="fw-semibold">' + htmlEscape(String(qs('shortcut_studentLabel')?.value || 'Student')) + '</div>'
          + '<div class="small mt-1">' + htmlEscape(result.message || 'Program registration finalized.') + '</div>'
          + '<div class="small text-muted mt-1">Registration: <span class="font-monospace">' + htmlEscape(registrationId) + '</span></div>';
      }
      setProgramRegistrationShortcutStep('finalized');
      await notifyProgramRegistrationShortcutOutcome(
        'success',
        result.message || 'Program registration finalized. Retry eligibility when you are ready.',
        'Registration finalized'
      );
    } catch (error) {
      await notifyProgramRegistrationShortcutOutcome('danger', error.message || 'Unable to approve program registration.', 'Finalize failed');
    } finally {
      shortcutActionInProgress = false;
      hideBusy();
    }
  }

  function returnToProgramRegistrationShortcutDetails() {
    if (shortcutActionInProgress || programShortcutStep !== 'preview') return;
    resetProgramRegistrationShortcutPreview();
    setProgramRegistrationShortcutStep('details');
    setProgramRegistrationShortcutHint('Update the details if needed, then preview the registration again before saving a draft.');
  }

  async function retryProgramRegistrationShortcutEligibility() {
    if (shortcutActionInProgress || programShortcutStep !== 'finalized') return;
    const resultCtx = groupEnrollmentResultRepairContext;
    shortcutActionInProgress = true;
    try {
      if (resultCtx) {
        showBusy('Refreshing prerequisites...');
        await refreshGroupEnrollmentResultPrereq(resultCtx.resultIndex);
        groupEnrollmentResultRepairContext = null;
        programShortcutModal?.hide();
        await hideBootstrapModalAndWait(programShortcutModalEl);
        cleanupRollingModalLayer();
        await notifyProgramRegistrationShortcutOutcome(
          'success',
          'Program registration finalized. Review the updated result row, then complete enrollment when ready.',
          'Prerequisites refreshed'
        );
        return;
      }
      showBusy('Refreshing Rolling Enrollment eligibility...');
      await refreshRollingEligibility();
      programShortcutModal?.hide();
      await hideBootstrapModalAndWait(programShortcutModalEl);
      cleanupRollingModalLayer();
      await notifyProgramRegistrationShortcutOutcome(
        'success',
        'Eligibility was refreshed. Review the Program registration section, then continue Rolling Enrollment.',
        'Eligibility refreshed'
      );
    } finally {
      shortcutActionInProgress = false;
      hideBusy();
    }
  }

  function mergeRollingPrerequisiteSlice(baseEligibility = {}, prereqPayload = {}) {
    const base = baseEligibility && typeof baseEligibility === 'object' ? { ...baseEligibility } : {};
    const prereq = prereqPayload?.prerequisite || {};
    const conflictIssues = (base.prerequisite?.issues || []).filter(isStudentConflictMessage);
    const merged = {
      ...base,
      eligible: prereqPayload.eligible === true && !conflictIssues.length,
      message: prereqPayload.message || base.message || '',
      resolved: prereqPayload.resolved || base.resolved || null,
      prerequisite: {
        ...(prereqPayload.prerequisite || {}),
        issues: [...(prereq.issues || []), ...conflictIssues],
        conflicts: base.prerequisite?.conflicts || null,
        conflictStudentPersonId: base.prerequisite?.conflictStudentPersonId || null,
        conflictStudentLabel: base.prerequisite?.conflictStudentLabel || null
      }
    };
    if (conflictIssues.length) merged.eligible = false;
    return merged;
  }

  function mergeRollingConflictSlice(baseEligibility = {}, conflictSlice = {}) {
    const base = baseEligibility && typeof baseEligibility === 'object' ? { ...baseEligibility } : {};
    const prereq = { ...(base.prerequisite || {}) };
    const otherIssues = (prereq.issues || []).filter((msg) => !isStudentConflictMessage(msg));
    if (conflictSlice?.hasConflicts) {
      prereq.issues = [
        ...otherIssues,
        conflictSlice.message || 'Scheduling conflicts detected with the student\'s existing schedule.'
      ];
      prereq.status = 'error';
      prereq.conflicts = conflictSlice.conflicts || null;
      prereq.conflictStudentPersonId = conflictSlice.conflictStudentPersonId || null;
      prereq.conflictStudentLabel = conflictSlice.conflictStudentLabel || null;
      return {
        ...base,
        eligible: false,
        prerequisite: prereq
      };
    }
    prereq.issues = otherIssues;
    prereq.conflicts = null;
    prereq.conflictStudentPersonId = null;
    prereq.conflictStudentLabel = null;
    const missingSubjects = Array.isArray(prereq.missingSubjects) ? prereq.missingSubjects : [];
    const advisoryPrereq = isAdvisoryPrerequisiteEnforcement(prereq);
    const prereqBlocked = prereq.status === 'error'
      || (prereq.issues || []).length > 0
      || (!advisoryPrereq && missingSubjects.length > 0);
    return {
      ...base,
      eligible: !prereqBlocked,
      prerequisite: prereq
    };
  }

  async function refreshRollingPrerequisites() {
    const sid = String(qs('inp_studentId')?.value || '').trim();
    if (!sid) return;
    const startDate = String(qs('inp_startDate')?.value || '').trim();
    try {
      const result = await requestJson(
        `/school/classes/api/${encodeURIComponent(classId)}/rolling-enrollment-prerequisites`,
        'POST',
        { studentId: sid, startDate }
      );
      const payload = result?.data;
      if (!payload) return;
      const merged = mergeRollingPrerequisiteSlice(lastRollingEligibility, payload);
      applyRollingEligibilityPayload(merged);
      if (rollingEnrollmentWorkspace) rollingEnrollmentWorkspace.eligibility = merged;
    } catch (err) {
      const message = err?.message || 'Prerequisite check failed.';
      setRollingRegistrationPanelHtml('<div class="text-danger small">' + formatRichServerMessageHtml(message) + '</div>');
    }
  }

  async function refreshRollingScheduleConflicts() {
    const sid = String(qs('inp_studentId')?.value || '').trim();
    const startDate = String(qs('inp_startDate')?.value || '').trim();
    if (!sid || !startDate) return;
    const endDate = String(qs('inp_endDate')?.value || '').trim();
    try {
      const body = {
        studentId: sid,
        startDate,
        endDate,
        pendingStagedSessions: pendingStagedSessions.map((row) => ({ ...row }))
      };
      if (rollingEnrollmentWorkspace?.sessions) {
        body.persistedSessions = rollingEnrollmentWorkspace.sessions;
      }
      const result = await requestJson(
        `/school/classes/api/${encodeURIComponent(classId)}/rolling-enrollment-conflicts`,
        'POST',
        body
      );
      const conflictSlice = result?.data;
      if (!conflictSlice) return;
      const merged = mergeRollingConflictSlice(lastRollingEligibility, conflictSlice);
      applyRollingEligibilityPayload(merged);
      if (rollingEnrollmentWorkspace) rollingEnrollmentWorkspace.eligibility = merged;
    } catch (err) {
      const message = err?.message || 'Conflict check failed.';
      setRollingRegistrationPanelHtml('<div class="text-danger small">' + formatRichServerMessageHtml(message) + '</div>');
    }
  }

  async function refreshRollingEligibilityOnDateChange(changedInputId = '') {
    if (changedInputId === 'inp_startDate') {
      await refreshRollingPrerequisites();
    }
    await refreshRollingScheduleConflicts();
  }

  function applyRollingEligibilityPayload(data) {
    const panel = qs('roll_enrollmentRegistrationPanel');
    if (!panel) return;
    if (!data) {
      setRollingRegistrationPanelHtml('<span class="text-danger">Unable to check eligibility.</span>');
      return;
    }
    lastRollingEligibility = data;
    if (data.prerequisite && !data.resolved) {
      const conflictIssue = (data.prerequisite.issues || []).find(isStudentConflictMessage);
      const otherIssues = (data.prerequisite.issues || []).filter(msg => !isStudentConflictMessage(msg));
      const issuesHtml = otherIssues.map((t) => formatRichServerMessageHtml(t)).join('<br>');
      const msg = issuesHtml || formatRichServerMessageHtml(data.message || 'Not eligible for this class.');
      const rawIssueMessage = data.message || (data.prerequisite.issues || []).join(' ');
      if (isMissingTermRegistrationMessage(rawIssueMessage)) {
        renderTermRegistrationShortcutPanel(rawIssueMessage);
        return;
      }
      if (isMissingProgramRegistrationMessage(rawIssueMessage)) {
        renderProgramRegistrationShortcutPanel(rawIssueMessage);
        return;
      }
      let inner = '';
      if (msg) inner += '<div class="text-danger small">' + msg + '</div>';
      if (conflictIssue) inner += renderStudentConflictHtml(conflictIssue);
      setRollingRegistrationPanelHtml(inner);
      return;
    }
    if (data.resolved && data.prerequisite) {
      const ok = data.eligible === true;
      const conflictIssue = (data.prerequisite.issues || []).find(isStudentConflictMessage);
      const otherIssues = (data.prerequisite.issues || []).filter(msg => !isStudentConflictMessage(msg));
      const issuesHtml = otherIssues.map((t) => formatRichServerMessageHtml(t)).join('<br>');

      const capacityWarningHtml = renderClassCapacityWarningPanel(data.prerequisite.capacity || {});
      const otherWarnings = (data.prerequisite.warnings || [])
        .filter((text) => !isCapacityWarningText(text))
        .map((t) => formatRichServerMessageHtml(t))
        .join('<br>');
      const missingSubjects = Array.isArray(data.prerequisite.missingSubjects) ? data.prerequisite.missingSubjects : [];
      const advisoryPrereq = isAdvisoryPrerequisiteEnforcement(data.prerequisite);
      if (!ok && missingSubjects.length) {
        renderPriorCreditRepairPanel(data.message || (data.prerequisite.issues || []).join(' '), { advisory: advisoryPrereq });
        return;
      }
      let inner = '<div class="fw-semibold text-dark">' + formatResolvedRegistrationLabel(data.resolved) + '</div>';
      if (issuesHtml) inner += '<div class="text-danger small mt-1">' + issuesHtml + '</div>';
      if (conflictIssue) inner += renderStudentConflictHtml(conflictIssue);
      if (capacityWarningHtml) inner += capacityWarningHtml;
      if (otherWarnings) inner += '<div class="text-warning small mt-1">' + otherWarnings + '</div>';
      if (ok && missingSubjects.length && advisoryPrereq) {
        inner += '<div class="d-flex flex-wrap align-items-center gap-2 mt-2">'
          + '<button type="button" class="btn btn-sm btn-outline-warning" id="btn_openPriorCreditRepair">'
          + '<i class="bi bi-mortarboard me-1"></i>Review Prerequisite Credits'
          + '</button>'
          + '<span class="small text-muted">' + htmlEscape(String(missingSubjects.length)) + ' suggested prerequisite credit'
          + (missingSubjects.length === 1 ? '' : 's') + '.</span>'
          + '</div>';
      }
      if (ok && !issuesHtml && !conflictIssue && !otherWarnings && !(missingSubjects.length && advisoryPrereq)) {
        inner += '<div class="text-success small mt-1">Prerequisites satisfied for this start date.</div>';
      }
      inner += renderClbPlacementInsightButtonHtml(data.clbPlacement);
      setRollingRegistrationPanelHtml(inner);
      return;
    }
    if (data.message) {
      if (isMissingTermRegistrationMessage(data.message)) {
        renderTermRegistrationShortcutPanel(data.message);
        return;
      }
      if (isMissingProgramRegistrationMessage(data.message)) {
        renderProgramRegistrationShortcutPanel(data.message);
        return;
      }
      setRollingRegistrationPanelHtml('<div class="text-danger small">' + formatRichServerMessageHtml(data.message) + '</div>');
    }
  }

  async function loadRollingEnrollmentWorkspace(studentId) {
    const panel = qs('roll_enrollmentRegistrationPanel');
    const sid = String(studentId || qs('inp_studentId')?.value || '').trim();
    lastRollingEligibility = null;
    rollingEnrollmentWorkspace = null;
    if (!panel) return;
    if (!sid) {
      setRollingRegistrationPanelHtml('<span class="text-muted">Select a student to verify program registration and prerequisites.</span>');
      return;
    }
    setRollingRegistrationPanelHtml('<span class="text-muted"><span class="spinner-border spinner-border-sm me-1" role="status"></span>Loading enrollment workspace…</span>');
    try {
      const result = await requestJson(
        `/school/classes/api/${encodeURIComponent(classId)}/rolling-enrollment-workspace`,
        'POST',
        { studentId: sid }
      );
      const workspace = result?.data;
      if (!workspace) {
        setRollingRegistrationPanelHtml('<span class="text-danger">Unable to load enrollment workspace.</span>');
        return;
      }
      rollingEnrollmentWorkspace = workspace;
      if (workspace.eligibility) {
        applyRollingEligibilityPayload(workspace.eligibility);
      } else {
        setRollingRegistrationPanelHtml('<span class="text-danger">Unable to check eligibility.</span>');
      }
    } catch (err) {
      rollingEnrollmentWorkspace = null;
      lastRollingEligibility = null;
      const message = err?.message || 'Workspace load failed.';
      if (isMissingTermRegistrationMessage(message)) {
        renderTermRegistrationShortcutPanel(message);
        return;
      }
      if (isMissingProgramRegistrationMessage(message)) {
        renderProgramRegistrationShortcutPanel(message);
        return;
      }
      setRollingRegistrationPanelHtml('<div class="text-danger small">' + formatRichServerMessageHtml(message) + '</div>');
    }
  }

  async function refreshRollingEligibility() {
    const panel = qs('roll_enrollmentRegistrationPanel');
    const sid = String(qs('inp_studentId')?.value || '').trim();
    const startDate = String(qs('inp_startDate')?.value || '').trim();
    const endDate = String(qs('inp_endDate')?.value || '').trim();
    if (!panel) return;
    if (!sid) {
      lastRollingEligibility = null;
      setRollingRegistrationPanelHtml('<span class="text-muted">Select a student to verify program registration and prerequisites.</span>');
      return;
    }
    setRollingRegistrationPanelHtml('<span class="text-muted"><span class="spinner-border spinner-border-sm me-1" role="status"></span>Checking registration…</span>');
    try {
      let url = '/school/classes/api/' + encodeURIComponent(classId) + '/rolling-eligibility?studentId=' + encodeURIComponent(sid);
      if (startDate) url += '&startDate=' + encodeURIComponent(startDate);
      if (endDate) url += '&endDate=' + encodeURIComponent(endDate);
      const data = await requestJson(url, 'GET');
      applyRollingEligibilityPayload(data);
      if (rollingEnrollmentWorkspace && data) {
        rollingEnrollmentWorkspace.eligibility = data;
      }
    } catch (err) {
      lastRollingEligibility = null;
      const message = err?.message || 'Check failed.';
      if (isMissingTermRegistrationMessage(message)) {
        renderTermRegistrationShortcutPanel(message);
        return;
      }
      if (isMissingProgramRegistrationMessage(message)) {
        renderProgramRegistrationShortcutPanel(message);
        return;
      }
      setRollingRegistrationPanelHtml('<div class="text-danger small">' + formatRichServerMessageHtml(message) + '</div>');
    }
  }

