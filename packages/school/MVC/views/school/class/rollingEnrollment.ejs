  async function openAccountPickerForManual(targetPrefix) {
    if (typeof window.GenericPicker === 'undefined' || !window.GenericPicker || !window.GenericPicker.open) {
      await showMsg('Picker Unavailable', 'warning', 'Account picker is not available on this page.');
      return;
    }
    window.GenericPicker.open(window.GenericPickerPresets.account({
      title: 'Select Posting Account',
      icon: 'bi-wallet2',
      placeholder: 'Search active + postable accounts...',
      apiEndpoint: '/school/accounts?allowPost=true&status=active',
      onSelect: async function (item) {
        if (!item) return;
        const isActive = String(item.status || '').trim().toLowerCase() === 'active';
        if (!item.allowPost || !isActive) {
          await showMsg('Invalid Account', 'warning', 'Only Active + Postable accounts can be selected.');
          return;
        }
        const idField = qs('inp_manual' + targetPrefix + 'AccountId');
        const labelField = qs('inp_manual' + targetPrefix + 'AccountLabel');
        if (idField) idField.value = String(item.id || '').trim();
        if (labelField) labelField.value = formatAccountLabel(item);
      }
    }));
