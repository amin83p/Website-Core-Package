  function oneDayAfter(dateText) {
    const raw = String(dateText || '').trim();
    if (!raw || !/^\d{4}-\d{2}-\d{2}$/.test(raw)) return '';
    const d = new Date(raw + 'T00:00:00');
    if (Number.isNaN(d.getTime())) return '';
    d.setDate(d.getDate() + 1);
    return d.toISOString().slice(0, 10);
  }

  function htmlEscape(value) {
    return String(value == null ? '' : value)
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#39;');
  }

  function messageUsesRenderableHtml(value = '') {
    const text = String(value || '');
    if (!text) return false;
    if (/<[a-z][\s\S]*?>/i.test(text)) return true;
    return /&lt;(br|b|strong|i|em|ul|ol|li|p|a)\b/i.test(text);
  }

  function formatRichServerMessageHtml(value = '') {
    const raw = String(value ?? '');
    if (!raw) return '';
    if (/<[a-z][\s\S]*?>/i.test(raw)) return raw;
    return raw
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/&lt;b&gt;/gi, '<b>')
      .replace(/&lt;\/b&gt;/gi, '</b>')
      .replace(/&lt;strong&gt;/gi, '<strong>')
      .replace(/&lt;\/strong&gt;/gi, '</strong>')
      .replace(/&lt;i&gt;/gi, '<i>')
      .replace(/&lt;\/i&gt;/gi, '</i>')
      .replace(/&lt;em&gt;/gi, '<em>')
      .replace(/&lt;\/em&gt;/gi, '</em>')
      .replace(/&lt;ul&gt;/gi, '<ul>')
      .replace(/&lt;\/ul&gt;/gi, '</ul>')
      .replace(/&lt;ol&gt;/gi, '<ol>')
      .replace(/&lt;\/ol&gt;/gi, '</ol>')
      .replace(/&lt;li&gt;/gi, '<li>')
      .replace(/&lt;\/li&gt;/gi, '</li>')
      .replace(/&lt;p&gt;/gi, '<p>')
      .replace(/&lt;\/p&gt;/gi, '</p>')
      .replace(/&lt;br\s*\/?&gt;/gi, '<br>');
  }

  function resolveMessageBodyHtml(message, options = {}) {
    if (options.html === false) return htmlEscape(String(message || ''));
    const useHtml = options.html === true || messageUsesRenderableHtml(message);
    return useHtml ? formatRichServerMessageHtml(message) : htmlEscape(String(message || ''));
  }

  let rollingBusyDepth = 0;
  let rollingBusyToken = null;
  let enrollmentModalBusy = false;
  let enrollmentModalDismissConfig = null;
  let enrollmentModalProgrammaticDismiss = false;

  function getEnrollmentModalBusyControls() {
    if (!addEnrollmentModalEl) return [];
    const footer = addEnrollmentModalEl.querySelector('.modal-footer');
    const headerClose = addEnrollmentModalEl.querySelector('.modal-header .btn-close');
    return [
      qs('btn_addPeriod'),
      qs('btn_enrollWizardBack'),
      headerClose,
      ...(footer ? Array.from(footer.querySelectorAll('[data-bs-dismiss="modal"]')) : [])
    ].filter(Boolean);
  }

  function beginEnrollmentModalWork(message = 'Please wait...') {
    if (enrollmentModalBusy) return false;
    enrollmentModalBusy = true;
    addEnrollmentModalEl?.classList.add('enrollment-modal-is-busy');
    getEnrollmentModalBusyControls().forEach((control) => {
      control.disabled = true;
    });

    if (addEnrollmentModalEl && bootstrapApi?.Modal) {
      const instance = bootstrapApi.Modal.getInstance(addEnrollmentModalEl)
        || (typeof bootstrapApi.Modal.getOrCreateInstance === 'function'
          ? bootstrapApi.Modal.getOrCreateInstance(addEnrollmentModalEl)
          : null);
      if (instance?._config) {
        enrollmentModalDismissConfig = {
          keyboard: instance._config.keyboard,
          backdrop: instance._config.backdrop
        };
        instance._config.keyboard = false;
        instance._config.backdrop = 'static';
      }
    }

    showBusy(message);
    return true;
  }

  function endEnrollmentModalWork() {
    if (!enrollmentModalBusy) return;
    enrollmentModalBusy = false;
    addEnrollmentModalEl?.classList.remove('enrollment-modal-is-busy');

    if (addEnrollmentModalEl && bootstrapApi?.Modal && enrollmentModalDismissConfig) {
      const instance = bootstrapApi.Modal.getInstance(addEnrollmentModalEl);
      if (instance?._config) {
        instance._config.keyboard = enrollmentModalDismissConfig.keyboard;
        instance._config.backdrop = enrollmentModalDismissConfig.backdrop;
      }
      enrollmentModalDismissConfig = null;
    }

    getEnrollmentModalBusyControls().forEach((control) => {
      control.disabled = false;
    });
    syncEnrollmentWizardPrimaryButton();
    hideBusy();
  }

  function showBusy(message = 'Please wait...') {
    const isNewOverlay = !rollingBusyToken;
    if (isNewOverlay) rollingBusyDepth += 1;
    if (typeof window.showLoading === 'function') {
      if (!rollingBusyToken) {
        rollingBusyToken = window.showLoading({
          title: 'Working...',
          note: String(message || 'Please wait...'),
          operation: 'Rolling Enrollment'
        });
      } else if (typeof window.updateLoading === 'function') {
        window.updateLoading({
          note: String(message || 'Please wait...'),
          operation: 'Rolling Enrollment'
        });
      }
    }
  }

  function hideBusy() {
    rollingBusyDepth = Math.max(0, rollingBusyDepth - 1);
    if (rollingBusyDepth > 0) return;

    try {
      if (typeof window.hideLoading === 'function') {
        if (rollingBusyToken) window.hideLoading(rollingBusyToken);
        else window.hideLoading();
      }
    } catch (_) {}
    rollingBusyToken = null;
  }

  function plainTextFromHtml(value = '') {
    return String(value || '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
  }

  async function showMsg(title, icon, message, options = {}) {
    // Busy overlay is z-index 20050; message modal must appear on top.
    while (rollingBusyDepth > 0) hideBusy();
    const body = resolveMessageBodyHtml(message, options);
    if (typeof window.showMessageModal === 'function') {
      const modalOptions = {
        title,
        icon,
        message: body
      };
      if (Array.isArray(options.buttons) && options.buttons.length) {
        modalOptions.buttons = options.buttons;
      }
      if (options.size) modalOptions.size = options.size;
      await window.showMessageModal(modalOptions);
      return;
    }
    const plain = options.html ? plainTextFromHtml(message) : String(message || '');
    if (typeof window.alert === 'function') {
      window.alert(plain || title);
      return;
    }
    console.log(title + ': ' + (plain || title));
  }

  async function showConfirm(message, title = 'Confirm', options = {}) {
    while (rollingBusyDepth > 0) hideBusy();
    const cancelText = String(options.cancelText || 'Cancel').trim() || 'Cancel';
    const confirmText = String(options.confirmText || 'Confirm').trim() || 'Confirm';
    const icon = String(options.icon || 'warning').trim() || 'warning';
    const body = resolveMessageBodyHtml(message, options);
    if (typeof window.showMessageModal === 'function') {
      const result = await window.showMessageModal({
        title,
        icon,
        message: body,
        size: options.size || 'md',
        buttons: [
          { text: cancelText, class: String(options.cancelClass || 'btn-secondary').trim() || 'btn-secondary' },
          { text: confirmText, class: String(options.confirmClass || (icon === 'warning' ? 'btn-warning' : 'btn-primary')).trim() || 'btn-primary' }
        ]
      });
      return result === confirmText || result === true;
    }
    const plain = options.html ? plainTextFromHtml(message) : String(message || '');
    if (typeof window.confirm === 'function') {
      return window.confirm(plain || title);
    }
    return false;
  }

  /** @param {object|null|undefined} al */
  function academicLedgerHtmlNote(al) {
    if (!al || typeof al !== 'object') return '';
    if (al.status === 'posted') {
      return '<p class="small text-muted mb-0 mt-2">' + htmlEscape(al.message || 'Recorded on academic ledger.') + '</p>';
    }
    if (al.status === 'already_synced') {
      return '<p class="small text-muted mb-0 mt-2">' + htmlEscape(al.message || '') + '</p>';
    }
    if (al.status === 'skipped_no_program' || al.status === 'skipped_program_not_found' || al.status === 'skipped_missing_context' || al.status === 'error') {
      return '<p class="small mb-0 mt-2"><span class="text-warning-emphasis fw-semibold">Academic ledger:</span> '
        + htmlEscape(al.message || 'Not updated.')
        + ' Use <strong>Sync academic ledger</strong> in the row menu after setting <strong>Allowed program terms</strong> on the class.</p>';
    }
    return '';
  }

  function collectEnrollmentPayloadFromForm() {
    const funder = resolveFunderSelectionFromSelect('inp_funder');
    const caps = readEnrollmentCapFields();
    const payload = {
      classId,
      studentId: String(qs('inp_studentId')?.value || '').trim(),
      startDate: String(qs('inp_startDate')?.value || '').trim(),
      endDate: String(qs('inp_endDate')?.value || '').trim(),
      status: String(qs('inp_status')?.value || 'active').trim(),
      funderType: funder.funderType,
      funderId: funder.funderId,
      claimNumber: readClaimNumberSelectValue('inp_claimNumber'),
      reasonStart: String(qs('inp_reasonStart')?.value || '').trim(),
      sessionCountPolicy: 'all_non_na',
      sessionCapacityType: readSessionCapacityTypeFromSelect('inp_sessionCapacityType'),
      plannedNotApplicableSessionIds: []
    };
    if (normalizeTargetSessionCountValue(caps.targetSessionCount) > 0) {
      payload.targetSessionCount = caps.targetSessionCount;
    }
    if (normalizeTargetHoursValue(caps.targetHours) > 0) {
      payload.targetHours = caps.targetHours;
    }
    if (pendingStagedSessions.length) {
      payload.pendingStagedSessions = pendingStagedSessions.map((row) => ({ ...row }));
    }
    if (pendingGapBatch) {
      payload.pendingGapBatch = { ...pendingGapBatch };
    }
    if (pendingGapBatch?.extendCycleEndDate === true) {
      payload.extendCycleEndDate = true;
    }
    if (pendingPlannedNaSessionIds.length) {
      payload.plannedNotApplicableSessionIds = pendingPlannedNaSessionIds.slice();
    }
    if (pendingUnmarkSessionIds.length) {
      payload.unmarkSessionIds = filterSelectableUnmarkSessionIds(pendingUnmarkSessionIds);
    }
    return payload;
  }

  function inferEnrollmentModeFromForm() {
    const caps = readEnrollmentCapFields();
    if (normalizeTargetHoursValue(caps.targetHours) > 0) return 'hour_cap';
    if (normalizeTargetSessionCountValue(caps.targetSessionCount) > 0) return 'session_cap';
    return 'date_window';
  }

  function buildRollingEnrollmentEnginePayload() {
    const base = collectEnrollmentPayloadFromForm();
    const enginePayload = {
      classId: base.classId,
      students: [{
        studentId: base.studentId,
        ...(pendingUnmarkSessionIds.length ? { unmarkSessionIds: filterSelectableUnmarkSessionIds(pendingUnmarkSessionIds) } : {})
      }],
      enrollmentMode: inferEnrollmentModeFromForm(),
      startDate: base.startDate,
      endDate: base.endDate,
      status: base.status,
      funderType: base.funderType,
      funderId: base.funderId,
      claimNumber: base.claimNumber,
      reasonStart: base.reasonStart,
      sessionCountPolicy: base.sessionCountPolicy,
      sessionCapacityType: base.sessionCapacityType,
      sessionsToCreate: pendingStagedSessions.map((row) => ({ ...row })),
      extendCycleEndDate: base.extendCycleEndDate === true || pendingGapBatch?.extendCycleEndDate === true
    };
    if (base.targetSessionCount) enginePayload.targetSessionCount = base.targetSessionCount;
    if (base.targetHours) enginePayload.targetHours = base.targetHours;
    if (pendingPlannedNaSessionIds.length) {
      enginePayload.plannedNotApplicableSessionIds = pendingPlannedNaSessionIds.slice();
    }
    if (pendingUnmarkSessionIds.length) {
      enginePayload.unmarkSessionIds = filterSelectableUnmarkSessionIds(pendingUnmarkSessionIds);
    }
    if (pendingGapBatch && !enginePayload.sessionsToCreate.length) {
      enginePayload.pendingGapBatch = { ...pendingGapBatch };
    }
    return enginePayload;
  }

  function buildAlignmentRequestBody(overrides = {}) {
    const payload = collectEnrollmentPayloadFromForm();
    const body = {
      classId,
      studentId: payload.studentId,
      startDate: String(overrides.startDate ?? payload.startDate ?? '').trim(),
      endDate: String(overrides.endDate ?? payload.endDate ?? '').trim(),
      targetSessionCount: String(overrides.targetSessionCount ?? payload.targetSessionCount ?? '').trim(),
      targetHours: String(overrides.targetHours ?? payload.targetHours ?? '').trim()
    };
    if (pendingStagedSessions.length) {
      body.pendingStagedSessions = pendingStagedSessions.map((row) => ({ ...row }));
    } else if (pendingGapBatch) {
      body.pendingGapBatch = { ...pendingGapBatch };
    }
    if (pendingGapBatch?.extendCycleEndDate === true) {
      body.extendCycleEndDate = true;
    }
    return body;
  }

  function sessionScheduleKeyClient(session = {}) {
    return [
      String(session?.date || '').trim(),
      normalizeGapTimeForInput(session?.startTime || session?.start || ''),
      normalizeGapTimeForInput(session?.endTime || session?.end || '')
    ].join('|');
  }

  function getStagedSessionIdSet() {
    return new Set(
      (Array.isArray(pendingStagedSessions) ? pendingStagedSessions : [])
        .map((row) => String(row?.sessionId || '').trim())
        .filter(Boolean)
    );
  }

  function formatSessionDateWithDay(dateStr) {
    const raw = String(dateStr || '').trim();
    if (!/^\d{4}-\d{2}-\d{2}$/.test(raw)) return raw || '-';
    const d = new Date(`${raw}T12:00:00`);
    if (Number.isNaN(d.getTime())) return raw;
    const dayNames = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    return `${dayNames[d.getDay()]}, ${raw}`;
  }

  function normalizeGapTimeForInput(value) {
    const raw = String(value ?? '').trim();
    if (!raw) return '';
    const hhmm = raw.match(/^(\d{1,2}):(\d{2})$/);
    if (hhmm) {
      const hour = Math.max(0, Math.min(23, Number(hhmm[1]) || 0));
      const minute = Math.max(0, Math.min(59, Number(hhmm[2]) || 0));
      return `${String(hour).padStart(2, '0')}:${String(minute).padStart(2, '0')}`;
    }
    const ampm = raw.match(/^(\d{1,2}):(\d{2})\s*(AM|PM)$/i);
    if (ampm) {
      let hour = Number(ampm[1]) || 0;
      const minute = Math.max(0, Math.min(59, Number(ampm[2]) || 0));
      const meridiem = String(ampm[3] || '').toUpperCase();
      if (meridiem === 'PM' && hour < 12) hour += 12;
      if (meridiem === 'AM' && hour === 12) hour = 0;
      hour = Math.max(0, Math.min(23, hour));
      return `${String(hour).padStart(2, '0')}:${String(minute).padStart(2, '0')}`;
    }
    const partial = raw.match(/^(\d{1,2}):(\d{2})/);
    if (partial) {
      const hour = Math.max(0, Math.min(23, Number(partial[1]) || 0));
      const minute = Math.max(0, Math.min(59, Number(partial[2]) || 0));
      return `${String(hour).padStart(2, '0')}:${String(minute).padStart(2, '0')}`;
    }
    return '';
  }

  function computeDurationHoursFromTimesClient(startTime, endTime) {
    const start = normalizeGapTimeForInput(startTime);
    const end = normalizeGapTimeForInput(endTime);
    if (!start || !end) return 0;
    const [sh, sm] = start.split(':').map(Number);
    const [eh, em] = end.split(':').map(Number);
    const hours = (eh + em / 60) - (sh + sm / 60);
    return hours > 0 ? normalizeTargetHoursValue(hours) : 0;
  }

  function resolveSessionRowDurationHours(row = {}) {
    const stored = Number(row?.durationHours);
    if (Number.isFinite(stored) && stored > 0) return normalizeTargetHoursValue(stored);
    return computeDurationHoursFromTimesClient(row.startTime, row.endTime);
  }

  function readGapBatchDaysOfWeek() {
    const checked = Array.from(document.querySelectorAll('#enrollWizardStepAddSessions .gap-day-cb:checked'))
      .map((input) => Number(input.value))
      .filter((value) => Number.isFinite(value));
    if (checked.length) return checked;
    const draftDays = Array.isArray(gapFormDraft?.daysOfWeek) ? gapFormDraft.daysOfWeek : [];
    if (draftDays.length) return draftDays.map((value) => Number(value)).filter((value) => Number.isFinite(value));
    const batchDays = Array.isArray(pendingGapBatch?.daysOfWeek) ? pendingGapBatch.daysOfWeek : [];
    if (batchDays.length) return batchDays.map((value) => Number(value)).filter((value) => Number.isFinite(value));
    return [];
  }

  function readGapBatchField(inputId, draftKey, batchKey) {
    const domValue = String(qs(inputId)?.value || '').trim();
    if (domValue) return domValue;
    if (gapFormDraft && gapFormDraft[draftKey]) return String(gapFormDraft[draftKey]).trim();
    if (pendingGapBatch && pendingGapBatch[batchKey]) return String(pendingGapBatch[batchKey]).trim();
    return '';
  }

  function flushGapFormDraftCapture() {
    if (gapFormDraftTimer) {
      clearTimeout(gapFormDraftTimer);
      gapFormDraftTimer = null;
    }
    captureGapFormDraft();
  }

  function listMissingGapBatchFields(body = {}) {
    const missing = [];
    if (!body.startDate) missing.push('start date');
    if (!body.endDate) missing.push('end date');
    if (!Array.isArray(body.daysOfWeek) || !body.daysOfWeek.length) missing.push('at least one weekday');
    if (!body.startTime) missing.push('start time');
    if (!body.endTime) missing.push('end time');
    return missing;
  }

  function isStagedSessionRow(row = {}) {
    if (row?.isStaged === true) return true;
    const id = String(row?.sessionId || '').trim();
    if (id && getStagedSessionIdSet().has(id)) return true;
    if (!pendingStagedSessions.length) return false;
    const key = sessionScheduleKeyClient(row);
    return pendingStagedSessions.some((session) => sessionScheduleKeyClient(session) === key);
  }

  function updateSessionTableFooter(sessions = [], totalsId = 'gapSessionsTotals') {
    const totalsEl = qs(totalsId);
    if (!totalsEl) return;
    const rows = Array.isArray(sessions) ? sessions : [];
    const stagedRows = rows.filter((row) => isStagedSessionRow(row));
    const stagedCount = stagedRows.length;
    const stagedHours = normalizeTargetHoursValue(
      stagedRows.reduce((sum, row) => sum + resolveSessionRowDurationHours(row), 0)
    );
    const totalCount = rows.length;
    const totalHours = normalizeTargetHoursValue(
      rows.reduce((sum, row) => sum + resolveSessionRowDurationHours(row), 0)
    );
    const stagedHourLabel = stagedHours === 1 ? 'Hr' : 'Hrs';
    const totalHourLabel = totalHours === 1 ? 'Hr' : 'Hrs';
    totalsEl.textContent = `Staged: ${stagedCount} session(s), ${stagedHours} ${stagedHourLabel} · Total: ${totalCount} session(s), ${totalHours} ${totalHourLabel}`;
  }

  function updateGapSessionTableFooter(sessions = []) {
    updateSessionTableFooter(sessions, 'gapSessionsTotals');
  }

  function renderFormStepSessionTable() {
    const panel = qs('formEnrollmentSessionsPanel');
    if (!panel) return;
    panel.classList.add('d-none');
  }

  function normalizeSessionRowForDisplay(row = {}) {
    const date = String(row?.date || row?.sessionDate || row?.startDate || '').trim();
    const startTime = normalizeGapTimeForInput(row?.startTime || row?.start || '');
    const endTime = normalizeGapTimeForInput(row?.endTime || row?.end || '');
    return {
      ...row,
      date,
      startTime,
      endTime,
      status: String(row?.status || 'scheduled').trim().toLowerCase() || 'scheduled',
      countable: row?.countable === true
    };
  }

  function resolveSessionRosterCount(row = {}) {
    const direct = Number(row?.rosterCount);
    if (Number.isFinite(direct) && direct >= 0) return direct;
    const sessionId = String(row?.sessionId || row?.id || '').trim();
    if (sessionId && Array.isArray(rollingEnrollmentWorkspace?.sessions)) {
      const match = rollingEnrollmentWorkspace.sessions.find((session) => (
        String(session?.sessionId || session?.id || '').trim() === sessionId
      ));
      if (match) {
        const fromWorkspace = Number(match?.rosterCount);
        if (Number.isFinite(fromWorkspace) && fromWorkspace >= 0) return fromWorkspace;
        if (Array.isArray(match?.roster)) return match.roster.length;
      }
    }
    return 0;
  }

  function isUnmarkSelectableSessionRow(row = {}) {
    if (!isOneOnOneSessionCapacityEnrollment()) return true;
    return resolveSessionRosterCount(row) === 0;
  }

  function enrichUnmarkSessionRow(row = {}) {
    const normalized = normalizeSessionRowForDisplay(row);
    const rosterCount = resolveSessionRosterCount(normalized);
    const unmarkSelectable = isUnmarkSelectableSessionRow(normalized);
    return {
      ...normalized,
      rosterCount,
      unmarkSelectable,
      unmarkOccupiedLabel: unmarkSelectable ? '' : 'Student enrolled'
    };
  }

  function filterSelectableUnmarkSessionIds(sessionIds = []) {
    const selectableIds = new Set(
      buildUnmarkSessionRows(lastAlignmentResult)
        .filter((row) => row.unmarkSelectable !== false)
        .map((row) => String(row?.sessionId || '').trim())
        .filter(Boolean)
    );
    return (Array.isArray(sessionIds) ? sessionIds : [])
      .map((id) => String(id || '').trim())
      .filter((id) => selectableIds.has(id));
  }

  function applyUnmarkSelectableRules(pickerData) {
    if (!pickerData || typeof pickerData !== 'object') return pickerData;
    if (!isOneOnOneSessionCapacityEnrollment()) return pickerData;
    const patchEvents = (events) => (Array.isArray(events) ? events : []).map((event) => {
      const rosterCount = resolveSessionRosterCount(event);
      const outOfWindow = String(event?.excludeReason || '').trim() === 'out_of_window';
      const occupied = rosterCount > 0;
      const selectable = !outOfWindow && !occupied;
      let excludeReason = '';
      if (outOfWindow) excludeReason = 'out_of_window';
      else if (occupied) excludeReason = 'Student already enrolled';
      return {
        ...event,
        rosterCount,
        selectable,
        excludeReason
      };
    });
    const allEvents = patchEvents(pickerData.allEvents);
    const events = patchEvents(pickerData.events);
    const selectableSessionIds = allEvents
      .filter((row) => row.selectable && row.sessionId)
      .map((row) => row.sessionId);
    return {
      ...pickerData,
      allEvents,
      events,
      selectableSessionIds
    };
  }

  function formatSessionStatusCell(row = {}, staged = false) {
    if (staged) {
      return '<span class="badge bg-warning-subtle text-warning-emphasis border">Staged</span>';
    }
    const status = String(row?.status || 'scheduled').trim().toLowerCase() || 'scheduled';
    const label = status.replace(/_/g, ' ').replace(/\b\w/g, (ch) => ch.toUpperCase());
    return `<span class="badge bg-secondary-subtle text-secondary border">${htmlEscape(label)}</span>`;
  }

  function formatSessionTimeCell(row = {}) {
    const startTime = normalizeGapTimeForInput(row?.startTime || row?.start || '');
    const endTime = normalizeGapTimeForInput(row?.endTime || row?.end || '');
    const label = [startTime, endTime].filter(Boolean).join(' - ');
    return label || '-';
  }

  function buildGapModalSessionRows() {
    const stagedIds = getStagedSessionIdSet();
    const stagedKeys = new Set(
      (Array.isArray(pendingStagedSessions) ? pendingStagedSessions : []).map((row) => sessionScheduleKeyClient(row))
    );
    const baseRows = (Array.isArray(lastAlignmentResult?.sessions) ? lastAlignmentResult.sessions : [])
      .filter((row) => {
        const id = String(row?.sessionId || '').trim();
        if (id && stagedIds.has(id)) return false;
        if (stagedKeys.has(sessionScheduleKeyClient(row))) return false;
        return true;
      });
    const stagedRows = (Array.isArray(pendingStagedSessions) ? pendingStagedSessions : []).map((row) => ({
      sessionId: row.sessionId,
      date: row.date,
      startTime: row.startTime,
      endTime: row.endTime,
      durationHours: row.durationHours,
      status: row.status || 'scheduled',
      countable: true,
      isStaged: true
    }));
    return [...baseRows, ...stagedRows].sort((a, b) => {
      const keyA = `${a.date || ''}|${a.startTime || ''}|${a.endTime || ''}`;
      const keyB = `${b.date || ''}|${b.startTime || ''}|${b.endTime || ''}`;
      return keyA.localeCompare(keyB);
    });
  }

  function clearPendingGapBatch({ clearFormDraft = true } = {}) {
    pendingGapBatch = null;
    pendingGapPreview = null;
    pendingStagedSessions = [];
    if (clearFormDraft) gapFormDraft = null;
    updateGapStagedBadge();
    renderGapSessionTable();
  }

  function captureGapFormDraft() {
    gapFormDraft = {
      startDate: String(qs('gap_batchStart')?.value || '').trim(),
      endDate: String(qs('gap_batchEnd')?.value || '').trim(),
      startTime: normalizeGapTimeForInput(qs('gap_batchStartTime')?.value),
      endTime: normalizeGapTimeForInput(qs('gap_batchEndTime')?.value),
      daysOfWeek: readGapBatchDaysOfWeek(),
      teacherId: String(qs('gap_teacherId')?.value || '').trim(),
      teacherName: String(qs('gap_teacherName')?.value || '').trim(),
      room: String(qs('gap_room')?.value || '').trim(),
      exceptions: String(qs('gap_exceptions')?.value || '').trim(),
      skipHolidays: Boolean(qs('gap_skipHolidays')?.checked)
    };
  }

  function applyGapFormDraft(draft = {}) {
    if (!draft || typeof draft !== 'object') return;
    if (qs('gap_batchStart')) qs('gap_batchStart').value = String(draft.startDate || '').trim();
    if (qs('gap_batchEnd')) qs('gap_batchEnd').value = String(draft.endDate || '').trim();
    if (qs('gap_batchStartTime')) qs('gap_batchStartTime').value = normalizeGapTimeForInput(draft.startTime);
    if (qs('gap_batchEndTime')) qs('gap_batchEndTime').value = normalizeGapTimeForInput(draft.endTime);
    if (qs('gap_room')) qs('gap_room').value = String(draft.room || '').trim();
    if (qs('gap_teacherId')) qs('gap_teacherId').value = String(draft.teacherId || '').trim();
    if (qs('gap_teacherName')) qs('gap_teacherName').value = String(draft.teacherName || '').trim();
    if (qs('gap_exceptions')) qs('gap_exceptions').value = String(draft.exceptions || '').trim();
    if (qs('gap_skipHolidays')) qs('gap_skipHolidays').checked = draft.skipHolidays === true;
    const selected = new Set((Array.isArray(draft.daysOfWeek) ? draft.daysOfWeek : []).map((row) => String(row)));
    document.querySelectorAll('#enrollWizardStepAddSessions .gap-day-cb').forEach((input) => {
      input.checked = selected.has(String(input.value));
    });
    updateGapCycleExtendWarning();
  }

  function scheduleGapFormDraftCapture() {
    if (gapFormDraftTimer) clearTimeout(gapFormDraftTimer);
    gapFormDraftTimer = setTimeout(() => {
      gapFormDraftTimer = null;
      captureGapFormDraft();
    }, 200);
  }

  function appendUniqueStagedSessions(proposed = []) {
    const rows = Array.isArray(proposed) ? proposed : [];
    if (!rows.length) return 0;
    const existingKeys = new Set((pendingStagedSessions || []).map((row) => sessionScheduleKeyClient(row)));
    const existingIds = getStagedSessionIdSet();
    let added = 0;
    rows.forEach((row) => {
      const key = sessionScheduleKeyClient(row);
      const id = String(row?.sessionId || '').trim();
      if (existingKeys.has(key) || (id && existingIds.has(id))) return;
      pendingStagedSessions.push({ ...row });
      existingKeys.add(key);
      if (id) {
        existingIds.add(id);
        if (!pendingIncludedSessionIds.includes(id)) pendingIncludedSessionIds.push(id);
      }
      added += 1;
    });
    pendingGapPreview = {
      createdCount: pendingStagedSessions.length,
      proposedSessions: pendingStagedSessions.slice()
    };
    return added;
  }

  async function refreshAlignmentWithStagedSessions() {
    const alignment = await fetchEnrollmentSessionAlignment(buildAlignmentRequestBody());
    if (alignment) {
      lastAlignmentResult = alignment;
      updateSessionCountHint(alignment);
      if (enrollWizardStep === 'addSessions' && hasEnrollmentCap()) {
        renderEnrollCapReviewContext(alignment);
      }
      if (hasTargetSessionCount() && alignment.alignmentStatus !== 'insufficient_sessions') {
        const targetInput = qs('inp_targetSessionCount');
        if (targetInput && !String(targetInput.dataset.userEdited || '').trim()) {
          targetInput.value = String(alignment.availableCount || '');
        }
      }
    }
    renderGapSessionTable();
    updateGapStagedBadge();
    renderFormStepSessionTable();
    syncEnrollmentWizardPrimaryButton();
    return alignment;
  }

  async function removeStagedSession(sessionId) {
    const id = String(sessionId || '').trim();
    if (!id) return;
    pendingIncludedSessionIds = pendingIncludedSessionIds.filter((row) => String(row || '').trim() !== id);
    pendingStagedSessions = (Array.isArray(pendingStagedSessions) ? pendingStagedSessions : [])
      .filter((row) => String(row?.sessionId || '').trim() !== id);
    if (!pendingStagedSessions.length) {
      pendingGapBatch = null;
      pendingGapPreview = null;
    } else {
      pendingGapPreview = {
        createdCount: pendingStagedSessions.length,
        proposedSessions: pendingStagedSessions.slice()
      };
    }
    updateGapStagedBadge();
    await refreshAlignmentWithStagedSessions();
    syncEnrollmentWizardPrimaryButton();
  }

  function syncPendingStagedSessionsFromCalendar(sessionsToCreate) {
    pendingStagedSessions = sessionsToCreate.map((row) => ({ ...row }));
    if (pendingStagedSessions.length) {
      pendingGapPreview = {
        createdCount: pendingStagedSessions.length,
        proposedSessions: pendingStagedSessions.slice()
      };
    } else if (!pendingGapBatch) {
      pendingGapPreview = null;
    }
    updateGapStagedBadge();
    refreshEnrollmentSessionViews();
  }

  function updateGapStagedBadge() {
    const badge = qs('gapStagedBadge');
    const titleEl = qs('gapStagedBadgeTitle');
    const clearBtn = qs('btn_gapClearStaged');
    const count = Number(
      pendingStagedSessions.length
      || pendingGapPreview?.createdCount
      || pendingGapPreview?.proposedSessions?.length
      || 0
    );
    if (!badge) return;
    if (!count) {
      setGapStepNotice(badge, { visible: false });
      clearBtn?.classList.add('d-none');
      return;
    }
    const stagedHours = normalizeTargetHoursValue(
      (Array.isArray(pendingStagedSessions) ? pendingStagedSessions : [])
        .reduce((sum, row) => sum + resolveSessionRowDurationHours(row), 0)
    );
    const hourSuffix = stagedHours === 1 ? 'Hr' : 'Hrs';
    const title = `${count} staged session(s)`;
    const detail = `${count} session(s) staged (${stagedHours} ${hourSuffix}, not saved yet). They will be added to the class schedule when enrollment completes successfully.`;
    setGapStepNotice(badge, { title, detail, visible: true, tone: 'primary' });
    if (titleEl) titleEl.textContent = title;
    clearBtn?.classList.remove('d-none');
    updateGapSessionsCollapseMeta();
  }

  async function showSessionConflictModal(conflicts = []) {
    const rows = Array.isArray(conflicts) ? conflicts : [];
    if (!rows.length) return false;
    let msg = `<b>Found ${rows.length} scheduling conflict(s)!</b><br><br><ul class="text-start mb-0">`;
    rows.slice(0, 5).forEach((c) => {
      msg += `<li><b>${htmlEscape(c.date || '')}</b>: ${htmlEscape(c.teacherName || '')} overlaps <i>${htmlEscape(c.conflictClass || '')}</i> (${htmlEscape(c.existTime || '')})</li>`;
    });
    if (rows.length > 5) msg += `<li>...and ${rows.length - 5} more.</li>`;
    msg += '</ul><br>Resolve conflicts before staging sessions or enrolling.';
    await showMsg('Scheduling Conflicts', 'error', msg, {
      html: true,
      buttons: [{ text: 'OK', class: 'btn-primary', value: true }]
    });
    return true;
  }

  function buildGapBatchBody() {
    const daysOfWeek = readGapBatchDaysOfWeek();
    const startDate = readGapBatchField('gap_batchStart', 'startDate', 'startDate');
    const endDate = readGapBatchField('gap_batchEnd', 'endDate', 'endDate');
    const startTime = normalizeGapTimeForInput(readGapBatchField('gap_batchStartTime', 'startTime', 'startTime'));
    const endTime = normalizeGapTimeForInput(readGapBatchField('gap_batchEndTime', 'endTime', 'endTime'));
    return {
      ...buildAlignmentRequestBody(),
      startDate,
      endDate,
      startTime,
      endTime,
      daysOfWeek,
      skipExistingDates: true,
      teacherId: readGapBatchField('gap_teacherId', 'teacherId', 'teacherId'),
      teacherName: readGapBatchField('gap_teacherName', 'teacherName', 'teacherName'),
      room: readGapBatchField('gap_room', 'room', 'room')
    };
  }

  async function fetchEnrollmentSessionAlignment(body = {}) {
    if (canUseLocalAlignment()) {
      return evaluateLocalEnrollmentAlignment(body);
    }
    const result = await requestJson(`/school/classes/api/${encodeURIComponent(classId)}/enrollment-session-alignment`, 'POST', body);
    return result?.data || null;
  }

  function canUseLocalAlignment() {
    return Boolean(
      rollingEnrollmentWorkspace
      && window.RollingEnrollmentAlignmentClient
      && (!pendingGapBatch || pendingStagedSessions.length > 0)
    );
  }

  function evaluateLocalEnrollmentAlignment(body = {}) {
    return window.RollingEnrollmentAlignmentClient.buildAlignmentPayload({
      workspace: rollingEnrollmentWorkspace,
      startDate: body.startDate,
      endDate: body.endDate,
      targetSessionCount: body.targetSessionCount,
      targetHours: body.targetHours,
      pendingStagedSessions,
      pendingGapBatch
    });
  }

  function updateViewSessionsButton(alignment) {
    const btn = qs('btn_viewEnrollmentSessions');
    const listBtn = qs('btn_viewEnrollmentSessionsList');
    if (!btn) return;
    if (hasEnrollmentCap() && enrollWizardStep === 'form') {
      btn.classList.add('d-none');
      listBtn?.classList.add('d-none');
      return;
    }
    const endDate = String(qs('inp_endDate')?.value || '').trim();
    const capSet = hasEnrollmentCap();
    const previewRows = buildGapModalSessionRows();
    let show = false;
    if (capSet && (pendingStagedSessions.length > 0 || previewRows.length > 0)) {
      show = true;
    } else {
      const count = Number(alignment?.availableCount || 0);
      const sessions = Array.isArray(alignment?.sessions) ? alignment.sessions : [];
      show = Boolean(capSet && count > 0 && sessions.length);
    }
    btn.classList.toggle('d-none', !show);
    if (listBtn) listBtn.classList.toggle('d-none', !show);
  }

  async function buildEnrollmentPickerBundleFromWorkspace(payload = {}) {
    if (!rollingEnrollmentWorkspace) return null;
    const body = {
      classId,
      studentId: payload.studentId,
      startDate: payload.startDate,
      endDate: payload.endDate,
      viewPreset: 'week',
      anchorDate: payload.startDate,
      selectedSessionIds: getEnrollmentPickerSelectedIds(),
      persistedSessions: rollingEnrollmentWorkspace.sessions || [],
      statusMap: rollingEnrollmentWorkspace.statusMap || {},
      pendingStagedSessions: pendingStagedSessions.map((row) => ({ ...row }))
    };
    if (hasTargetSessionCount()) body.targetSessionCount = Number(qs('inp_targetSessionCount')?.value || 0);
    if (hasTargetHours()) body.targetHours = Number(qs('inp_targetHours')?.value || 0);
    const result = await requestJson(
      `/school/classes/api/${encodeURIComponent(classId)}/enrollment-session-picker`,
      'POST',
      body
    );
    return result?.data || null;
  }

  async function openEnrollmentSessionCalendarModal() {
    if (!window.SessionEnrollmentCalendarModal || !window.SessionCalendarCore) {
      openEnrollmentSessionListModal();
      return;
    }
    const payload = collectEnrollmentPayloadFromForm();
    const studentName = String(qs('inp_studentLabel')?.value || '').trim();
    const classTitle = String(document.querySelector('.page-title, h1, h2')?.textContent || '').trim();
    let prefetchedPickerData = null;
    if (rollingEnrollmentWorkspace) {
      try {
        prefetchedPickerData = await buildEnrollmentPickerBundleFromWorkspace(payload);
      } catch (err) {
        console.error(err);
      }
    }
    window.SessionEnrollmentCalendarModal.open({
      classId,
      studentId: payload.studentId,
      studentLabel: studentName,
      classLabel: classTitle,
      startDate: payload.startDate,
      endDate: payload.endDate,
      cycleEndDate: String(cycleWindow?.endDate || '').trim(),
      targetSessionCount: hasTargetSessionCount() ? Number(qs('inp_targetSessionCount')?.value || 0) : 0,
      targetHours: hasTargetHours() ? Number(qs('inp_targetHours')?.value || 0) : 0,
      selectedSessionIds: getEnrollmentPickerSelectedIds(),
      sessionsToCreate: pendingStagedSessions.map((row) => ({ ...row })),
      scheduleDefaults: rollingEnrollmentWorkspace?.scheduleDefaults || lastAlignmentResult?.scheduleDefaults || {},
      persistedSessions: rollingEnrollmentWorkspace?.sessions || [],
      statusMap: rollingEnrollmentWorkspace?.statusMap || null,
      localPickerMode: Boolean(prefetchedPickerData),
      prefetchedPickerData,
      requestJson,
      onSelectionChange: ({ selectedSessionIds, sessionsToCreate }) => {
        if (Array.isArray(sessionsToCreate)) {
          syncPendingStagedSessionsFromCalendar(sessionsToCreate);
        }
        applyEnrollmentSelectionFromIds(selectedSessionIds, { refreshAlignment: false });
      },
      onSave: ({ selectedSessionIds, sessionsToCreate }) => {
        if (Array.isArray(sessionsToCreate)) {
          syncPendingStagedSessionsFromCalendar(sessionsToCreate);
        }
        applyEnrollmentSelectionFromIds(selectedSessionIds, { refreshAlignment: true });
      }
    });
  }

  function applyUnmarkSelectionFromIds(selectedSessionIds) {
    pendingUnmarkSessionIds = filterSelectableUnmarkSessionIds(
      Array.isArray(selectedSessionIds) ? selectedSessionIds : []
    );
    renderUnmarkSessionTable(buildUnmarkSessionRows(lastAlignmentResult), pendingUnmarkSessionIds);
  }

  function readSelectedUnmarkSessionIdsFromScope(scopeEl) {
    const root = scopeEl || qs('unmarkSessionsTbody') || document;
    return Array.from(root.querySelectorAll('.unmark-session-toggle.is-selected'))
      .map((btn) => String(btn.dataset?.sessionId || '').trim())
      .filter(Boolean);
  }

  function syncUnmarkSelectionFromScope(scopeEl) {
    applyUnmarkSelectionFromIds(readSelectedUnmarkSessionIdsFromScope(scopeEl));
  }

  function renderUnmarkSessionListModalTable() {
    const rows = buildUnmarkSessionRows(lastAlignmentResult);
    const selectedUnmarkIds = readSelectedUnmarkSessionIds().length
      ? readSelectedUnmarkSessionIds()
      : pendingUnmarkSessionIds.slice();
    renderSessionWindowTable(rows, 'unmarkSessionListTbody', {
      unmarkToggle: true,
      selectedUnmarkIds,
      footerTotalsId: 'unmarkSessionListTotals'
    });
  }

  function openUnmarkSessionListModal() {
    renderUnmarkSessionListModalTable();
    unmarkSessionListModal?.show();
  }

  function handleUnmarkSessionToggleClick(event, scopeEl) {
    const btn = event.target.closest('.unmark-session-toggle');
    if (!btn) return false;
    const row = btn.closest('tr');
    if (row?.classList.contains('unmark-session-row-occupied')) return false;
    const selected = btn.classList.toggle('is-selected');
    btn.classList.toggle('btn-success', selected);
    btn.classList.toggle('btn-outline-secondary', !selected);
    btn.textContent = selected ? 'Unmarked' : 'Unmark';
    if (row) row.classList.toggle('unmark-session-row-selected', selected);
    if (scopeEl) {
      syncUnmarkSelectionFromScope(scopeEl);
      if (unmarkSessionListModalEl?.classList.contains('show')) {
        renderUnmarkSessionListModalTable();
      }
    } else {
      pendingUnmarkSessionIds = readSelectedUnmarkSessionIdsFromScope(qs('unmarkSessionsTbody'));
      updateUnmarkSelectionCounter();
    }
    return true;
  }

  async function openUnmarkSessionCalendarModal() {
    if (!window.SessionEnrollmentCalendarModal || !window.SessionCalendarCore) {
      openUnmarkSessionListModal();
      return;
    }
    const payload = collectEnrollmentPayloadFromForm();
    const studentName = String(qs('inp_studentLabel')?.value || '').trim();
    const classTitle = String(document.querySelector('.page-title, h1, h2')?.textContent || '').trim();
    const selectedUnmarkIds = filterSelectableUnmarkSessionIds(
      readSelectedUnmarkSessionIds().length
        ? readSelectedUnmarkSessionIds()
        : pendingUnmarkSessionIds.slice()
    );
    let prefetchedPickerData = null;
    if (rollingEnrollmentWorkspace) {
      try {
        prefetchedPickerData = await buildEnrollmentPickerBundleFromWorkspace(payload);
        if (prefetchedPickerData) {
          prefetchedPickerData = applyUnmarkSelectableRules(prefetchedPickerData);
        }
      } catch (err) {
        console.error(err);
      }
    }
    window.SessionEnrollmentCalendarModal.open({
      classId,
      studentId: payload.studentId,
      studentLabel: studentName,
      classLabel: classTitle,
      startDate: payload.startDate,
      endDate: payload.endDate,
      cycleEndDate: String(cycleWindow?.endDate || '').trim(),
      targetSessionCount: hasTargetSessionCount() ? Number(qs('inp_targetSessionCount')?.value || 0) : 0,
      targetHours: hasTargetHours() ? Number(qs('inp_targetHours')?.value || 0) : 0,
      selectedSessionIds: selectedUnmarkIds,
      sessionsToCreate: [],
      scheduleDefaults: rollingEnrollmentWorkspace?.scheduleDefaults || lastAlignmentResult?.scheduleDefaults || {},
      persistedSessions: rollingEnrollmentWorkspace?.sessions || [],
      statusMap: rollingEnrollmentWorkspace?.statusMap || null,
      localPickerMode: Boolean(prefetchedPickerData),
      prefetchedPickerData,
      requestJson,
      onSelectionChange: ({ selectedSessionIds }) => {
        applyUnmarkSelectionFromIds(selectedSessionIds);
      },
      onSave: ({ selectedSessionIds }) => {
        applyUnmarkSelectionFromIds(selectedSessionIds);
      }
    });
  }

  function openEnrollmentSessionListModal() {
    const rows = buildGapModalSessionRows();
    renderSessionWindowTable(rows, 'enrollmentSessionListTbody', {
      showActions: pendingStagedSessions.length > 0,
      highlightStaged: true,
      footerTotalsId: 'enrollmentSessionListTotals'
    });
    enrollmentSessionListModal?.show();
  }

  function alignmentRequiresMarkNa(alignment = lastAlignmentResult) {
    return String(alignment?.alignmentStatus || '').trim() === 'overage_requires_na';
  }

  function resolveEnrollmentAlignmentNextStep(alignment = lastAlignmentResult) {
    if (pendingStagedSessions.length > 0) {
      return 'conflicts';
    }
    return 'proceed';
  }

  function goEnrollmentMarkNaStep(alignment, { skippedAddSessions = false } = {}) {
    enrollWizardPath = 'planA';
    enrollWizardSkippedAddSessions = skippedAddSessions === true;
    enrollWizardStep = 'markNa';
    prepareMarkNaStep(alignment);
    setEnrollmentWizardStepVisibility();
  }

  function syncEnrollmentWizardPathFromCap() {
    if (enrollWizardStep !== 'form') return;
    if (isOneOnOneSessionCapacityEnrollment()) {
      enrollWizardPath = 'oneOnOne';
      return;
    }
    enrollWizardPath = null;
  }

  function updateSessionCountHint(alignment) {
    const hint = qs('hint_sessionAlignment');
    if (!hint) return;
    const sessionTargetSet = hasTargetSessionCount();
    const hourTargetSet = hasTargetHours();
    const capSet = sessionTargetSet || hourTargetSet;
    if (capSet && enrollWizardStep === 'form') {
      hint.className = 'form-text compact-help text-muted mb-0';
      hint.textContent = isOneOnOneSessionCapacityEnrollment()
        ? 'Recorded attendance after the start date counts toward the cap. Use Next to pick sessions to unmark.'
        : 'Recorded attendance after the start date counts toward the cap.';
      updateAnticipatedFinishHint(alignment);
      updateViewSessionsButton(null);
      syncEnrollmentWizardPathFromCap();
      renderFormStepSessionTable();
      renderEnrollmentWizardStepIndicator();
      syncEnrollmentWizardPrimaryButton();
      return;
    }
    if (!alignment || alignment.alignmentStatus === 'no_end_date') {
      hint.className = 'form-text compact-help text-muted mb-0';
      hint.textContent = capSet
        ? 'Recorded attendance after the start date counts toward the target. End Date is not used when a session or hour target is set.'
        : 'Set an end date to see how many countable sessions fall in the enrollment window.';
      updateAnticipatedFinishHint(alignment);
      updateViewSessionsButton(lastAlignmentResult);
      syncEnrollmentWizardPathFromCap();
      renderFormStepSessionTable();
      renderEnrollmentWizardStepIndicator();
      syncEnrollmentWizardPrimaryButton();
      return;
    }
    if (hourTargetSet && alignment.alignmentStatus === 'insufficient_hours') {
      const target = Number(alignment.effectiveTargetHours || alignment.targetHours || normalizeTargetHoursValue(qs('inp_targetHours')?.value));
      const available = Number(alignment.availableHours || 0);
      const gap = Number(alignment.gapHours || Math.max(0, target - available));
      hint.className = 'form-text compact-help text-warning mb-0';
      hint.textContent = `Target is ${target} hr(s). Consumption is tracked from recorded attendance; only ${available} hr(s) are scheduled so far (${gap} hr gap). You can still enroll and add sessions later.`;
      updateAnticipatedFinishHint(alignment);
      updateViewSessionsButton(alignment);
      syncEnrollmentWizardPathFromCap();
      renderFormStepSessionTable();
      renderEnrollmentWizardStepIndicator();
      syncEnrollmentWizardPrimaryButton();
      return;
    }
    if (sessionTargetSet && alignment.alignmentStatus === 'insufficient_sessions') {
      const target = Number(alignment.targetSessionCount || alignment.effectiveTarget || 0);
      const available = Number(alignment.availableCount || 0);
      const gap = Number(alignment.gapCount || Math.max(0, target - available));
      hint.className = 'form-text compact-help text-warning mb-0';
      hint.textContent = `Target is ${target} session(s). Consumption is tracked from recorded attendance; only ${available} scheduled session(s) exist (${gap} gap). You can still enroll and add sessions later.`;
      updateAnticipatedFinishHint(alignment);
      updateViewSessionsButton(alignment);
      syncEnrollmentWizardPathFromCap();
      renderFormStepSessionTable();
      renderEnrollmentWizardStepIndicator();
      syncEnrollmentWizardPrimaryButton();
      return;
    }
    if (capSet && alignment.alignmentStatus === 'overage_requires_na') {
      if (hourTargetSet) {
        const target = Number(alignment.effectiveTargetHours || alignment.targetHours || normalizeTargetHoursValue(qs('inp_targetHours')?.value));
        const available = Number(alignment.availableHours || 0);
        const excess = Number(alignment.requiredNaHours || Math.max(0, available - target));
        hint.className = 'form-text compact-help text-warning mb-0';
        hint.textContent = isOneOnOneSessionCapacityEnrollment()
          ? `Target is ${target} hr(s) from the start date, but ${available} hr(s) are scheduled (${excess} hr over). Use Next to pick sessions to unmark.`
          : `Target is ${target} hr(s) from the start date, but ${available} hr(s) are scheduled (${excess} hr over).`;
      } else {
        const target = Number(alignment.targetSessionCount || alignment.effectiveTarget || 0);
        const available = Number(alignment.availableCount || 0);
        const excess = Number(alignment.requiredNaCount || Math.max(0, available - target));
        hint.className = 'form-text compact-help text-warning mb-0';
        hint.textContent = isOneOnOneSessionCapacityEnrollment()
          ? `Target is ${target} session(s) from the start date, but ${available} exist (${excess} over). Use Next to pick sessions to unmark.`
          : `Target is ${target} session(s) from the start date, but ${available} exist (${excess} over).`;
      }
      updateAnticipatedFinishHint(alignment);
      updateViewSessionsButton(alignment);
      syncEnrollmentWizardPathFromCap();
      renderFormStepSessionTable();
      renderEnrollmentWizardStepIndicator();
      syncEnrollmentWizardPrimaryButton();
      return;
    }
    const available = Number(alignment.availableCount || 0);
    const availableHours = Number(alignment.availableHours || 0);
    if (!capSet) {
      hint.className = 'form-text compact-help text-muted mb-0';
      hint.textContent = `${available} countable session(s) in this window.`;
      updateAnticipatedFinishHint(alignment);
      updateViewSessionsButton(alignment);
      renderFormStepSessionTable();
      syncEnrollmentWizardPrimaryButton();
      return;
    }
    if (hourTargetSet) {
      const target = Number(alignment.effectiveTargetHours || alignment.targetHours || normalizeTargetHoursValue(qs('inp_targetHours')?.value));
      hint.className = 'form-text compact-help text-success mb-0';
      hint.textContent = `Target: ${target} hr(s) across ${Number(alignment.allocatedSessionCount || 0)} allocated session(s) from the start date. N/A sessions do not count.`;
    } else {
      const target = Number(alignment.targetSessionCount || alignment.effectiveTarget || 0);
      hint.className = 'form-text compact-help text-success mb-0';
      hint.textContent = `Target: ${target || normalizeTargetSessionCountValue(qs('inp_targetSessionCount')?.value)} recorded attendance session(s) after the start date. N/A sessions do not count.`;
    }
    updateAnticipatedFinishHint(alignment);
    updateViewSessionsButton(alignment);
    syncEnrollmentWizardPathFromCap();
    renderFormStepSessionTable();
    renderEnrollmentWizardStepIndicator();
    syncEnrollmentWizardPrimaryButton();
  }

  function getEnrollmentWizardStepMeta() {
    if (enrollWizardPath === 'oneOnOne') {
      return [
        { id: 'form', label: 'Enrollment' },
        { id: 'unmarkSessions', label: 'Unmark Sessions' }
      ];
    }
    if (enrollWizardPath === 'planA') {
      const steps = [
        { id: 'form', label: 'Enrollment' },
        { id: 'addSessions', label: 'Review' },
        { id: 'conflicts', label: 'Conflicts' }
      ];
      return steps;
    }
    if (enrollWizardPath === 'planB') {
      return [
        { id: 'form', label: 'Enrollment' },
        { id: 'markNa', label: 'Mark N/A' }
      ];
    }
    return [{ id: 'form', label: 'Enrollment' }];
  }

  function renderEnrollmentWizardStepIndicator() {
    const host = qs('enrollWizardStepIndicator');
    const pillHost = qs('enrollWizardStepPills');
    if (!host || !pillHost) return;
    const steps = getEnrollmentWizardStepMeta();
    if (steps.length <= 1) {
      host.classList.add('d-none');
      host.setAttribute('aria-hidden', 'true');
      pillHost.innerHTML = '';
      return;
    }
    host.classList.remove('d-none');
    host.setAttribute('aria-hidden', 'false');
    const activeIdx = Math.max(0, steps.findIndex((row) => row.id === enrollWizardStep));
    const progress = ((activeIdx + 1) / steps.length) * 100;
    const badge = qs('enrollWizardStepBadge');
    const progressPct = qs('enrollWizardProgressPct');
    const progressBar = qs('enrollWizardProgressBar');
    if (badge) badge.textContent = `Step ${activeIdx + 1} of ${steps.length}`;
    if (progressPct) progressPct.textContent = `${Math.round(progress)}%`;
    if (progressBar) progressBar.style.width = `${progress.toFixed(2)}%`;
    pillHost.innerHTML = steps.map((step, idx) => {
      const stateClass = idx === activeIdx ? 'active' : (idx < activeIdx ? 'completed' : '');
      return `<button type="button" class="wizard-step-pill ${stateClass}" tabindex="-1" aria-disabled="true">${idx + 1}. ${htmlEscape(step.label)}</button>`;
    }).join('');
    if (window.WizardStepRail) window.WizardStepRail.sync(pillHost);
  }

  function setEnrollmentWizardStepVisibility() {
    qs('enrollWizardStepForm')?.classList.toggle('d-none', enrollWizardStep !== 'form');
    qs('enrollWizardStepAddSessions')?.classList.toggle('d-none', enrollWizardStep !== 'addSessions');
    qs('enrollWizardStepUnmarkSessions')?.classList.toggle('d-none', enrollWizardStep !== 'unmarkSessions');
    qs('enrollWizardStepMarkNa')?.classList.toggle('d-none', enrollWizardStep !== 'markNa');
    qs('enrollWizardStepConflicts')?.classList.toggle('d-none', enrollWizardStep !== 'conflicts');
    qs('btn_enrollWizardBack')?.classList.toggle('d-none', enrollWizardStep === 'form');
    renderEnrollmentWizardStepIndicator();
    syncEnrollmentWizardPrimaryButton();
  }

  function syncEnrollmentWizardPrimaryButton() {
    const btn = qs('btn_addPeriod');
    if (!btn) return;
    const iconPlus = '<i class="bi bi-plus-circle me-1"></i>';
    const iconNext = '<i class="bi bi-arrow-right me-1"></i>';
    if (enrollWizardStep === 'form') {
      const needsNext = isOneOnOneSessionCapacityEnrollment();
      btn.innerHTML = needsNext ? `${iconNext}Next` : `${iconPlus}Add Enrollment Period`;
      if (isRollingClass()) btn.disabled = false;
      return;
    }
    if (enrollWizardStep === 'unmarkSessions') {
      const selectedCount = readSelectedUnmarkSessionIds().length;
      btn.innerHTML = `${iconPlus}Add Enrollment Period`;
      btn.disabled = selectedCount < 1;
      return;
    }
    if (enrollWizardStep === 'addSessions') {
      btn.innerHTML = `${iconPlus}Add Enrollment Period`;
      btn.disabled = false;
      return;
    }
    if (enrollWizardStep === 'markNa') {
      const requiredHours = Number(lastAlignmentResult?.requiredNaHours || 0);
      const requiredSessions = Number(lastAlignmentResult?.requiredNaCount || 0);
      const selectedHours = readSelectedNaSessionHours();
      const selectedSessions = readSelectedNaSessionIds().length;
      const hourMode = requiredHours > 0;
      btn.innerHTML = `${iconPlus}Add Enrollment Period`;
      btn.disabled = hourMode
        ? (requiredHours <= 0 || selectedHours < requiredHours)
        : (requiredSessions <= 0 || selectedSessions !== requiredSessions);
      return;
    }
    if (enrollWizardStep === 'conflicts') {
      btn.innerHTML = `${iconPlus}Add Enrollment Period`;
      btn.disabled = conflictReviewHasConflicts === true;
    }
  }

  function isRollingClass() {
    return <%- isRollingJson %>;
  }

  function resetEnrollmentWizard() {
    enrollWizardStep = 'form';
    enrollWizardPath = null;
    enrollWizardSkippedAddSessions = false;
    pendingUnmarkSessionIds = [];
    lastConflictReview = null;
    conflictReviewHasConflicts = false;
    setEnrollmentWizardStepVisibility();
  }

  function renderEnrollCapReviewSummary() {
    const host = qs('enrollCapReviewSummaryBody');
    if (!host) return;
    const student = String(qs('inp_studentLabel')?.value || '').trim() || '—';
    const startDate = String(qs('inp_startDate')?.value || '').trim() || '—';
    const status = String(qs('inp_status')?.value || 'active').trim();
    const funderSelect = qs('inp_funder');
      const funderLabel = String(funderSelect?.options?.[funderSelect.selectedIndex]?.text || '').trim() || '—';
    const sessionCapacityLabel = formatSessionCapacityTypeLabel(readSessionCapacityTypeFromSelect('inp_sessionCapacityType'));
    const hourMode = hasTargetHours();
    const capType = hourMode ? 'Hour cap' : 'Session cap';
    const capValue = hourMode
      ? `${normalizeTargetHoursValue(qs('inp_targetHours')?.value)} hr`
      : `${normalizeTargetSessionCountValue(qs('inp_targetSessionCount')?.value)} session(s)`;
    host.innerHTML = `
      <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
        <div>
          <div class="text-uppercase small text-muted fw-semibold mb-1">Review enrollment</div>
          <h6 class="mb-0">${htmlEscape(student)}</h6>
        </div>
        <span class="badge text-bg-light border text-capitalize">${htmlEscape(status)}</span>
      </div>
      <div class="row g-2 small">
        <div class="col-sm-6 col-md-4"><span class="text-muted">Start date</span><div class="fw-semibold">${htmlEscape(startDate)}</div></div>
        <div class="col-sm-6 col-md-4"><span class="text-muted">${htmlEscape(capType)}</span><div class="fw-semibold">${htmlEscape(capValue)}</div></div>
        <div class="col-sm-6 col-md-4"><span class="text-muted">Funder</span><div class="fw-semibold">${htmlEscape(funderLabel)}</div></div>
        <div class="col-sm-6 col-md-4"><span class="text-muted">Session capacity</span><div class="fw-semibold">${htmlEscape(sessionCapacityLabel)}</div></div>
      </div>`;
  }

  function renderEnrollCapReviewContext(alignment = lastAlignmentResult) {
    const host = qs('enrollCapReviewContext');
    if (!host) return;
    const hourMode = hasTargetHours();
    const target = hourMode
      ? normalizeTargetHoursValue(qs('inp_targetHours')?.value)
      : normalizeTargetSessionCountValue(qs('inp_targetSessionCount')?.value);
    const capLabel = hourMode ? `${target} hour(s)` : `${target} session(s)`;
    const scheduled = hourMode
      ? Number(alignment?.availableHours || 0)
      : Number(alignment?.availableCount || 0);
    const scheduledLabel = hourMode
      ? `${scheduled} hr scheduled from the start date`
      : `${scheduled} session(s) scheduled from the start date`;
    const startDate = String(qs('inp_startDate')?.value || '').trim() || 'the start date';
    host.innerHTML = `<strong>Ongoing cap enrollment.</strong> Attendance recorded after <strong>${htmlEscape(startDate)}</strong> counts toward <strong>${htmlEscape(capLabel)}</strong>. You can finalize now without pre-selecting sessions. ${htmlEscape(scheduledLabel)} so far; consumption continues as the student attends.`;
  }

  function prepareEnrollmentReviewStep(alignment) {
    lastAlignmentResult = alignment || lastAlignmentResult;
    const summaryNotice = qs('gapSummaryNotice');
    if (summaryNotice) {
      setGapStepNotice(summaryNotice, { title: '', detail: '', visible: false, tone: 'info' });
    }
    renderEnrollCapReviewSummary();
    renderEnrollCapReviewContext(alignment);
    if (gapFormDraft) {
      applyGapFormDraft(gapFormDraft);
    } else {
      applyScheduleDefaultsToGapForm(alignment?.scheduleDefaults || {});
    }
    pendingIncludedSessionIds = [];
    pendingPlannedNaSessionIds = [];
    renderGapSessionTable();
    updateGapCycleExtendWarning();
    updateGapStagedBadge();
    updateGapSessionsCollapseMeta();
    updateEnrollmentPickCounter();
    initGapStepTooltips();
  }

  function prepareAddSessionsStep(alignment) {
    prepareEnrollmentReviewStep(alignment);
  }

  function buildUnmarkSessionRows(alignment = lastAlignmentResult) {
    const startDate = String(qs('inp_startDate')?.value || '').trim();
    const fromAlignment = (Array.isArray(alignment?.sessions) ? alignment.sessions : [])
      .filter((row) => row.inWindow !== false)
      .map((row) => enrichUnmarkSessionRow(row));
    if (fromAlignment.length) return fromAlignment;
    const workspaceSessions = Array.isArray(rollingEnrollmentWorkspace?.sessions)
      ? rollingEnrollmentWorkspace.sessions
      : [];
    return workspaceSessions
      .filter((row) => !startDate || String(row?.date || '').trim() >= startDate)
      .map((row) => enrichUnmarkSessionRow(row));
  }

  function prepareUnmarkSessionsStep(alignment) {
    lastAlignmentResult = alignment || lastAlignmentResult;
    const studentName = String(qs('inp_studentLabel')?.value || '').trim() || 'this student';
    const summary = qs('unmarkSummaryText');
    if (summary) {
      summary.textContent = `Choose empty sessions for ${studentName}. Sessions that already have a student enrolled are shown but cannot be selected. At least one empty session is required.`;
    }
    pendingUnmarkSessionIds = filterSelectableUnmarkSessionIds(
      pendingUnmarkSessionIds.length ? pendingUnmarkSessionIds.slice() : []
    );
    renderUnmarkSessionTable(buildUnmarkSessionRows(alignment), pendingUnmarkSessionIds);
  }

  function renderUnmarkSessionTable(sessions = [], selectedIds = []) {
    const rows = (Array.isArray(sessions) ? sessions : []).map((row) => enrichUnmarkSessionRow(row));
    const filteredSelectedIds = filterSelectableUnmarkSessionIds(selectedIds);
    renderSessionWindowTable(rows, 'unmarkSessionsTbody', {
      unmarkToggle: true,
      selectedUnmarkIds: filteredSelectedIds,
      footerTotalsId: 'unmarkSessionsTotals'
    });
    updateUnmarkSelectionCounter();
  }

  function readSelectedUnmarkSessionIds() {
    return readSelectedUnmarkSessionIdsFromScope(qs('unmarkSessionsTbody'));
  }

  function readSelectedUnmarkSessionHours() {
    let total = 0;
    (qs('unmarkSessionsTbody') || document).querySelectorAll('.unmark-session-toggle.is-selected').forEach((btn) => {
      total = normalizeTargetHoursValue(total + Number(btn.dataset?.hours || 0));
    });
    return total;
  }

  function updateUnmarkTableFooter() {
    const totalsEl = qs('unmarkSessionsTotals');
    if (!totalsEl) return;
    const selectedCount = readSelectedUnmarkSessionIds().length;
    const selectedHours = readSelectedUnmarkSessionHours();
    const hourLabel = selectedHours === 1 ? 'Hr' : 'Hrs';
    totalsEl.textContent = `Selected: ${selectedCount} session(s), ${selectedHours} ${hourLabel}`;
  }

  function updateUnmarkSelectionCounter() {
    const counter = qs('unmarkSelectionCounter');
    const selectedCount = readSelectedUnmarkSessionIds().length;
    if (counter) counter.textContent = `Selected ${selectedCount} session(s)`;
    updateUnmarkTableFooter();
    if (enrollWizardStep === 'unmarkSessions') syncEnrollmentWizardPrimaryButton();
  }

  function prepareMarkNaStep(alignment) {
    lastAlignmentResult = alignment || lastAlignmentResult;
    const requiredHours = Number(alignment?.requiredNaHours || 0);
    const requiredSessions = Number(alignment?.requiredNaCount || 0);
    const hourMode = requiredHours > 0;
    const targetHours = Number(alignment?.effectiveTargetHours || alignment?.targetHours || 0);
    const targetSessions = Number(alignment?.targetSessionCount || alignment?.effectiveTarget || 0);
    const availableHours = Number(alignment?.availableHours || 0);
    const available = Number(alignment?.availableCount || 0);
    const summary = qs('naSummaryText');
    if (summary) {
      if (hourMode) {
        summary.textContent = `This enrollment uses ${targetHours} hour(s), but ${availableHours} hour(s) of sessions exist in the window. Select sessions totaling at least ${requiredHours} hour(s) to mark N/A.`;
      } else {
        summary.textContent = `This enrollment uses ${targetSessions} session(s), but ${available} countable sessions exist in the window. Select exactly ${requiredSessions} session(s) to mark N/A (they will not count toward enrollment).`;
      }
    }
    const preselected = pendingPlannedNaSessionIds.length
      ? pendingPlannedNaSessionIds.slice()
      : [];
    renderNaSessionTable(alignment?.countableSessions || [], preselected);
  }

  function renderConflictReview(review = {}) {
    lastConflictReview = review || null;
    conflictReviewHasConflicts = review?.hasConflicts === true;
    const readyPanel = qs('conflictReviewReadyPanel');
    const conflictPanel = qs('conflictReviewConflictPanel');
    readyPanel?.classList.toggle('d-none', conflictReviewHasConflicts);
    conflictPanel?.classList.toggle('d-none', !conflictReviewHasConflicts);

    const host = qs('conflictReviewStudentsHost');
    const students = (Array.isArray(review?.students) ? review.students : [])
      .filter((student) => student?.hasConflicts === true);
    if (host) {
      if (!conflictReviewHasConflicts) {
        host.innerHTML = '';
      } else if (!students.length) {
        host.innerHTML = '';
      } else {
        host.innerHTML = students.map((student) => {
          const roleLabel = student.role === 'enrolling' ? 'Enrolling' : 'Enrolled';
          const windowLabel = `${student.windowStart || '?'} → ${student.windowEnd || 'Open'}`;
          const conflictSessions = (Array.isArray(student.sessions) ? student.sessions : [])
            .filter((session) => session?.hasConflict === true);
          const rows = conflictSessions.length
            ? conflictSessions.map((session) => `<tr class="conflict-session-row">
                <td>${htmlEscape(session.date || '-')}</td>
                <td>${htmlEscape([session.startTime, session.endTime].filter(Boolean).join(' - ') || '-')}</td>
                <td><span class="badge bg-danger-subtle text-danger border">Conflict</span> ${htmlEscape(session.conflictDetail || '')}</td>
              </tr>`).join('')
            : '<tr><td colspan="3" class="text-center text-muted py-2">No conflicting sessions found.</td></tr>';
          return `<div class="mb-3">
            <div class="fw-semibold mb-1">${htmlEscape(student.displayName || student.studentId || '')}
              <span class="badge bg-secondary-subtle text-secondary border ms-1">${roleLabel}</span>
              <span class="text-muted small ms-2">${htmlEscape(windowLabel)}</span>
            </div>
            <div class="table-responsive border rounded">
              <table class="table table-sm align-middle mb-0">
                <thead class="table-light"><tr><th>Date</th><th>Time</th><th>Conflict</th></tr></thead>
                <tbody>${rows}</tbody>
              </table>
            </div>
          </div>`;
        }).join('');
      }
    }

    const teacherSection = qs('conflictReviewTeacherSection');
    const teacherBody = qs('conflictReviewTeacherTbody');
    const teacherConflicts = Array.isArray(review?.teacherConflicts) ? review.teacherConflicts : [];
    teacherSection?.classList.toggle('d-none', !teacherConflicts.length);
    if (teacherBody && teacherConflicts.length) {
      teacherBody.innerHTML = teacherConflicts.map((row) => `<tr class="conflict-session-row">
          <td>${htmlEscape(row.date || '-')}</td>
          <td>${htmlEscape(row.teacherName || '-')}</td>
          <td>${htmlEscape(row.conflictClass || '-')}</td>
          <td>${htmlEscape(row.existTime || '-')}</td>
          <td>${htmlEscape(row.conflictType || '-')}</td>
        </tr>`).join('');
    } else if (teacherBody) {
      teacherBody.innerHTML = '';
    }
    syncEnrollmentWizardPrimaryButton();
  }

  async function loadConflictReviewStep() {
    if (!pendingStagedSessions.length) {
      await showMsg('Sessions required', 'warning', 'Stage the missing sessions before reviewing conflicts.');
      return false;
    }
    try {
      showBusy('Checking session conflicts...');
      const payload = collectEnrollmentPayloadFromForm();
      const result = await requestJson(
        `/school/classes/api/${encodeURIComponent(classId)}/sessions/enrollment-gap-conflict-review`,
        'POST',
        {
          studentId: payload.studentId,
          startDate: payload.startDate,
          endDate: payload.endDate,
          pendingStagedSessions: pendingStagedSessions.map((row) => ({ ...row })),
          pendingGapBatch: pendingGapBatch ? { ...pendingGapBatch } : undefined,
          teacherId: String(qs('gap_teacherId')?.value || pendingGapBatch?.teacherId || '').trim()
        }
      );
      if (!result) return false;
      renderConflictReview(result.data || {});
      return true;
    } catch (error) {
      await showMsg('Conflict Review Failed', 'error', error.message || 'Unable to review conflicts.');
      return false;
    } finally {
      hideBusy();
    }
  }

  async function goEnrollmentWizardBack() {
    if (enrollWizardStep === 'conflicts') {
      captureGapFormDraft();
      enrollWizardStep = 'addSessions';
      setEnrollmentWizardStepVisibility();
      return;
    }
    if (enrollWizardStep === 'unmarkSessions') {
      pendingUnmarkSessionIds = filterSelectableUnmarkSessionIds(readSelectedUnmarkSessionIds());
      enrollWizardStep = 'form';
      enrollWizardPath = 'oneOnOne';
      setEnrollmentWizardStepVisibility();
      await runAlignmentRefresh({ showSpinner: false });
      renderFormStepSessionTable();
      return;
    }
    if (enrollWizardStep === 'markNa') {
      pendingPlannedNaSessionIds = readSelectedNaSessionIds();
      enrollWizardStep = enrollWizardSkippedAddSessions ? 'form' : 'addSessions';
      enrollWizardSkippedAddSessions = false;
      setEnrollmentWizardStepVisibility();
      return;
    }
    if (enrollWizardStep === 'addSessions') {
      captureGapFormDraft();
      enrollWizardStep = 'form';
      enrollWizardPath = isOneOnOneSessionCapacityEnrollment() ? 'oneOnOne' : null;
      setEnrollmentWizardStepVisibility();
      await runAlignmentRefresh({ showSpinner: false });
      renderFormStepSessionTable();
    }
  }

  async function ensureEnrollmentSessionAlignment() {
    if (!hasEnrollmentCap()) {
      return { ok: true, alignment: lastAlignmentResult, nextStep: null };
    }
    if (hasTargetSessionCount() && hasTargetHours()) {
      await showMsg('Validation', 'warning', 'Set either a session target or an hour target, not both.');
      return { ok: false, alignment: lastAlignmentResult, nextStep: null };
    }
    const alignment = await refreshAlignmentWithStagedSessions() || lastAlignmentResult;
    const resolved = resolveEnrollmentAlignmentNextStep(alignment);
    const nextStep = resolved === 'proceed' ? null : resolved;
    return { ok: true, alignment, nextStep };
  }

  function applyScheduleDefaultsToGapForm(defaults = {}) {
    const startDate = String(qs('inp_startDate')?.value || '').trim();
    const endDate = String(qs('inp_endDate')?.value || '').trim();
    if (qs('gap_batchStart')) qs('gap_batchStart').value = startDate;
    if (qs('gap_batchEnd')) qs('gap_batchEnd').value = endDate;
    if (qs('gap_batchStartTime')) qs('gap_batchStartTime').value = normalizeGapTimeForInput(defaults.startTime || '');
    if (qs('gap_batchEndTime')) qs('gap_batchEndTime').value = normalizeGapTimeForInput(defaults.endTime || '');
    if (qs('gap_room')) qs('gap_room').value = String(defaults.room || '').trim();
    const selected = new Set((Array.isArray(defaults.daysOfWeek) ? defaults.daysOfWeek : []).map((row) => String(row)));
    if (selected.size) {
      document.querySelectorAll('#enrollWizardStepAddSessions .gap-day-cb').forEach((input) => {
        input.checked = selected.has(String(input.value));
      });
    }
    const teacherId = String(defaults.teacherId || defaultTeacher?.teacherId || '').trim();
    const teacherName = String(defaults.teacherName || defaultTeacher?.teacherName || '').trim();
    if (qs('gap_teacherId')) qs('gap_teacherId').value = teacherId;
    if (qs('gap_teacherName')) qs('gap_teacherName').value = teacherName;
    if (qs('gap_exceptions')) {
      const exceptionDates = Array.isArray(defaults.exceptionDates) ? defaults.exceptionDates : [];
      qs('gap_exceptions').value = exceptionDates.join(', ');
    }
    if (qs('gap_skipHolidays')) qs('gap_skipHolidays').checked = false;
    const holidayHint = qs('gap_holidayHint');
    if (holidayHint) {
      holidayHint.style.display = 'none';
      holidayHint.textContent = '';
    }
    updateGapCycleExtendWarning();
  }

  function renderSessionWindowTable(sessions = [], tbodyId = 'gapSessionsTbody', options = {}) {
    const tbodyEl = qs(tbodyId);
    if (!tbodyEl) return;
    const rows = Array.isArray(sessions) ? sessions.map((row) => normalizeSessionRowForDisplay(row)) : [];
    const naToggle = options.naToggle === true;
    const unmarkToggle = options.unmarkToggle === true;
    const enrollmentPick = options.enrollmentPick === true;
    const selectedNaIds = new Set(
      (Array.isArray(options.selectedNaIds) ? options.selectedNaIds : []).map((row) => String(row || '').trim()).filter(Boolean)
    );
    const selectedUnmarkIds = new Set(
      (Array.isArray(options.selectedUnmarkIds) ? options.selectedUnmarkIds : []).map((row) => String(row || '').trim()).filter(Boolean)
    );
    const selectedEnrollmentIds = new Set(
      (Array.isArray(options.selectedEnrollmentIds) ? options.selectedEnrollmentIds : []).map((row) => String(row || '').trim()).filter(Boolean)
    );
    const showActions = options.showActions === true || naToggle || unmarkToggle || enrollmentPick;
    const highlightStaged = options.highlightStaged === true || (options.showActions === true && !naToggle && !unmarkToggle && !enrollmentPick);
    const footerTotalsId = String(options.footerTotalsId || '').trim();
    const colSpan = showActions ? 5 : 4;
    if (!rows.length) {
      tbodyEl.innerHTML = `<tr><td colspan="${colSpan}" class="text-center text-muted py-3">No sessions in this enrollment window yet.</td></tr>`;
      if (footerTotalsId) {
        if (naToggle) updateNaTableFooter();
        else if (unmarkToggle) updateUnmarkTableFooter();
        else updateSessionTableFooter([], footerTotalsId);
      }
      return;
    }
    tbodyEl.innerHTML = rows.map((row) => {
      const sessionId = String(row.sessionId || '').trim();
      const hours = resolveSessionRowDurationHours(row);
      const staged = highlightStaged && isStagedSessionRow(row);
      const naSelected = naToggle && selectedNaIds.has(sessionId);
      const unmarkSelected = unmarkToggle && selectedUnmarkIds.has(sessionId);
      const unmarkOccupied = unmarkToggle && row.unmarkSelectable === false;
      const picked = enrollmentPick && selectedEnrollmentIds.has(sessionId);
      const rowClass = unmarkOccupied
        ? 'unmark-session-row-occupied'
        : (naSelected
        ? 'na-session-row-selected'
        : (unmarkSelected
          ? 'unmark-session-row-selected'
          : (picked ? 'enrollment-session-row-selected' : (staged ? 'gap-session-row-staged' : ''))));
      const countableBadge = row.countable
        ? '<span class="badge bg-success-subtle text-success border">Yes</span>'
        : `<span class="badge bg-secondary-subtle text-secondary border" title="${htmlEscape(row.excludeReason || '')}">No</span>`;
      const statusCell = unmarkOccupied
        ? '<span class="badge bg-secondary-subtle text-secondary border">Student enrolled</span>'
        : formatSessionStatusCell(row, staged);
      let actionsCell = '';
      if (enrollmentPick && row.countable && !staged) {
        const isPicked = selectedEnrollmentIds.has(sessionId);
        const btnClass = isPicked
          ? 'btn btn-sm btn-success enrollment-session-pick is-selected'
          : 'btn btn-sm btn-outline-secondary enrollment-session-pick';
        const btnLabel = isPicked ? 'Included' : 'Include';
        actionsCell = `<button type="button" class="${btnClass}" data-session-id="${htmlEscape(sessionId)}" data-hours="${hours}" title="Include this session in the enrollment">${btnLabel}</button>`;
      } else if (enrollmentPick && staged) {
        const isPicked = selectedEnrollmentIds.has(sessionId);
        const btnClass = isPicked
          ? 'btn btn-sm btn-success enrollment-session-pick is-selected'
          : 'btn btn-sm btn-outline-secondary enrollment-session-pick';
        const btnLabel = isPicked ? 'Included' : 'Include';
        actionsCell = `<button type="button" class="${btnClass}" data-session-id="${htmlEscape(sessionId)}" data-hours="${hours}" title="Include this staged session in the enrollment">${btnLabel}</button>`
          + ` <button type="button" class="btn btn-sm btn-outline-danger btn-remove-staged" data-session-id="${htmlEscape(sessionId)}" title="Remove staged session"><i class="bi bi-trash"></i></button>`;
      } else if (unmarkToggle) {
        if (row.unmarkSelectable === false) {
          actionsCell = '<span class="small text-muted">Occupied</span>';
        } else {
          const btnClass = unmarkSelected
            ? 'btn btn-sm btn-success unmark-session-toggle is-selected'
            : 'btn btn-sm btn-outline-secondary unmark-session-toggle';
          const btnLabel = unmarkSelected ? 'Unmarked' : 'Unmark';
          actionsCell = `<button type="button" class="${btnClass}" data-session-id="${htmlEscape(sessionId)}" data-hours="${hours}" title="Clear N/A and unmark attendance for this session">${btnLabel}</button>`;
        }
      } else if (naToggle) {
        const btnClass = naSelected
          ? 'btn btn-sm btn-success na-session-toggle is-selected'
          : 'btn btn-sm btn-outline-secondary na-session-toggle';
        const btnLabel = naSelected ? 'N/A' : 'Mark N/A';
        actionsCell = `<button type="button" class="${btnClass}" data-session-id="${htmlEscape(sessionId)}" data-hours="${hours}" title="Toggle N/A for this session">${btnLabel}</button>`;
      } else if (showActions && staged) {
        actionsCell = `<button type="button" class="btn btn-sm btn-outline-danger btn-remove-staged" data-session-id="${htmlEscape(sessionId)}" title="Remove staged session"><i class="bi bi-trash"></i></button>`;
      }
      const actionsTd = showActions
        ? `<td class="text-end">${actionsCell}</td>`
        : '';
      return `<tr class="${rowClass}">
        <td>${htmlEscape(formatSessionDateWithDay(row.date))}</td>
        <td>${htmlEscape(formatSessionTimeCell(row))}</td>
        <td>${statusCell}</td>
        <td>${countableBadge}</td>
        ${actionsTd}
      </tr>`;
    }).join('');
    if (footerTotalsId) {
      if (naToggle) updateNaTableFooter();
      else if (unmarkToggle) updateUnmarkTableFooter();
      else updateSessionTableFooter(rows, footerTotalsId);
      if (enrollmentPick) updateEnrollmentPickCounter();
    } else if (tbodyId === 'gapSessionsTbody') {
      updateGapSessionTableFooter(rows);
    }
  }

  function getCountableSessionsFromAlignment(alignment = lastAlignmentResult) {
    return Array.isArray(alignment?.countableSessions) ? alignment.countableSessions : [];
  }

  function getEnrollmentPickerSelectedIds() {
    const ids = new Set(
      (Array.isArray(pendingIncludedSessionIds) ? pendingIncludedSessionIds : [])
        .map((id) => String(id || '').trim())
        .filter(Boolean)
    );
    (Array.isArray(pendingStagedSessions) ? pendingStagedSessions : []).forEach((row) => {
      const id = String(row?.sessionId || '').trim();
      if (id) ids.add(id);
    });
    return Array.from(ids);
  }

  function refreshEnrollmentSessionViews() {
    if (enrollWizardStep === 'addSessions') {
      renderGapSessionTable();
    }
    syncPlannedNaFromIncludedSelection();
    updateEnrollmentPickCounter();
    syncEnrollmentWizardPrimaryButton();
  }

  function applyEnrollmentSelectionFromIds(selectedSessionIds, { refreshAlignment = false } = {}) {
    const selected = new Set(
      (Array.isArray(selectedSessionIds) ? selectedSessionIds : [])
        .map((id) => String(id || '').trim())
        .filter(Boolean)
    );
    pendingIncludedSessionIds = Array.from(selected);
    const stagedBefore = pendingStagedSessions.length;
    pendingStagedSessions = (Array.isArray(pendingStagedSessions) ? pendingStagedSessions : [])
      .filter((row) => selected.has(String(row?.sessionId || '').trim()));
    if (pendingStagedSessions.length !== stagedBefore) {
      if (!pendingStagedSessions.length) {
        pendingGapBatch = null;
        pendingGapPreview = null;
      } else {
        pendingGapPreview = {
          createdCount: pendingStagedSessions.length,
          proposedSessions: pendingStagedSessions.slice()
        };
      }
      updateGapStagedBadge();
    }
    refreshEnrollmentSessionViews();
    if (refreshAlignment) {
      refreshAlignmentWithStagedSessions().catch((err) => console.error(err));
    }
  }

  function buildDefaultIncludedSessionIds(alignment = lastAlignmentResult) {
    const countable = getCountableSessionsFromAlignment(alignment);
    const ids = countable.map((row) => String(row?.sessionId || '').trim()).filter(Boolean);
    const status = String(alignment?.alignmentStatus || '');
    if (status === 'overage_requires_na' && pendingPlannedNaSessionIds.length) {
      const naSet = new Set(pendingPlannedNaSessionIds.map(String));
      return ids.filter((id) => !naSet.has(id));
    }
    return ids.slice();
  }

  function readIncludedEnrollmentSessionIdsFromDom() {
    return Array.from(document.querySelectorAll('.enrollment-session-pick.is-selected'))
      .map((btn) => String(btn.dataset?.sessionId || '').trim())
      .filter(Boolean);
  }

  function readIncludedEnrollmentSessionIds() {
    const fromDom = readIncludedEnrollmentSessionIdsFromDom();
    if (document.querySelector('.enrollment-session-pick')) {
      pendingIncludedSessionIds = fromDom;
    }
    return pendingIncludedSessionIds.slice();
  }

  function syncPlannedNaFromIncludedSelection() {
    const countable = getCountableSessionsFromAlignment();
    const included = new Set(
      (Array.isArray(pendingIncludedSessionIds) ? pendingIncludedSessionIds : [])
        .map((id) => String(id || '').trim())
        .filter(Boolean)
    );
    pendingPlannedNaSessionIds = countable
      .map((row) => String(row?.sessionId || '').trim())
      .filter((id) => id && !included.has(id));
  }

  function readIncludedScheduledHours(countableSessions, includedIds) {
    const set = new Set(includedIds);
    let total = 0;
    (countableSessions || []).forEach((row) => {
      const id = String(row?.sessionId || '').trim();
      if (set.has(id)) total += resolveSessionRowDurationHours(row);
    });
    return normalizeTargetHoursValue(total);
  }

  function readStagedEnrollmentHours() {
    return normalizeTargetHoursValue(
      (pendingStagedSessions || []).reduce((sum, row) => sum + resolveSessionRowDurationHours(row), 0)
    );
  }

  function readIncludedEnrollmentSessionCount(countableSessions, includedIds) {
    const set = new Set(includedIds);
    return (countableSessions || []).filter((row) => set.has(String(row?.sessionId || '').trim())).length;
  }

  function canContinueFromAddSessionsStep() {
    if (hasEnrollmentCap()) return true;
    const alignment = lastAlignmentResult;
    if (!alignment) return false;
    const status = String(alignment.alignmentStatus || '');
    const countable = getCountableSessionsFromAlignment(alignment);
    const includedIds = readIncludedEnrollmentSessionIds();
    const targetHours = Number(alignment.effectiveTargetHours || alignment.targetHours || 0);
    const targetSessions = Number(alignment.effectiveTarget || alignment.targetSessionCount || 0);

    if (hasTargetHours() || targetHours > 0) {
      const target = targetHours || normalizeTargetHoursValue(qs('inp_targetHours')?.value);
      const includedHours = readIncludedScheduledHours(countable, includedIds);
      const totalHours = normalizeTargetHoursValue(includedHours + readStagedEnrollmentHours());
      if (status === 'overage_requires_na') return includedHours === target;
      if (status === 'insufficient_hours') return totalHours >= target;
      return totalHours >= target || status === 'ok';
    }

    const target = targetSessions || normalizeTargetSessionCountValue(qs('inp_targetSessionCount')?.value);
    const includedCount = readIncludedEnrollmentSessionCount(countable, includedIds);
    const totalCount = includedCount + pendingStagedSessions.length;
    if (status === 'overage_requires_na') return includedCount === target;
    if (status === 'insufficient_sessions') return totalCount >= target;
    return totalCount >= target || status === 'ok';
  }

  async function validateEnrollmentPickForContinue() {
    if (hasEnrollmentCap()) return true;
    const alignment = lastAlignmentResult;
    if (!alignment) return false;
    const status = String(alignment.alignmentStatus || '');
    const countable = getCountableSessionsFromAlignment(alignment);
    const includedIds = readIncludedEnrollmentSessionIds();
    syncPlannedNaFromIncludedSelection();

    if (hasTargetHours() || Number(alignment.effectiveTargetHours || alignment.targetHours || 0) > 0) {
      const target = Number(alignment.effectiveTargetHours || alignment.targetHours || normalizeTargetHoursValue(qs('inp_targetHours')?.value));
      const includedHours = readIncludedScheduledHours(countable, includedIds);
      const totalHours = normalizeTargetHoursValue(includedHours + readStagedEnrollmentHours());
      if (status === 'insufficient_hours' && totalHours < target) {
        await showMsg('Sessions required', 'warning', `Include or stage sessions totaling ${target} hr (currently ${totalHours} hr).`);
        return false;
      }
      if (status === 'overage_requires_na' && includedHours !== target) {
        await showMsg('Selection required', 'warning', `Include exactly ${target} hr from scheduled sessions (${includedHours} hr selected). Other scheduled sessions will be marked N/A.`);
        return false;
      }
      return true;
    }

    const target = Number(alignment.effectiveTarget || alignment.targetSessionCount || normalizeTargetSessionCountValue(qs('inp_targetSessionCount')?.value));
    const includedCount = readIncludedEnrollmentSessionCount(countable, includedIds);
    const totalCount = includedCount + pendingStagedSessions.length;
    if (status === 'insufficient_sessions' && totalCount < target) {
      await showMsg('Sessions required', 'warning', `Include or stage ${target} session(s) (currently ${totalCount}).`);
      return false;
    }
    if (status === 'overage_requires_na' && includedCount !== target) {
      await showMsg('Selection required', 'warning', `Include exactly ${target} scheduled session(s) (${includedCount} selected). Other scheduled sessions will be marked N/A.`);
      return false;
    }
    return true;
  }

  function updateEnrollmentPickCounter() {
    const counter = qs('gapEnrollmentPickCounter');
    const alignment = lastAlignmentResult;
    if (!counter || !alignment) return;
    const countable = getCountableSessionsFromAlignment(alignment);
    const includedIds = readIncludedEnrollmentSessionIds();
    if (hasTargetHours() || Number(alignment.effectiveTargetHours || alignment.targetHours || 0) > 0) {
      const includedHours = readIncludedScheduledHours(countable, includedIds);
      const stagedHours = readStagedEnrollmentHours();
      const parts = [];
      if (includedHours > 0) parts.push(`${includedHours} hr included`);
      if (stagedHours > 0) parts.push(`${stagedHours} hr staged`);
      counter.textContent = parts.length ? parts.join(' · ') : 'No sessions staged';
      return;
    }
    const includedCount = readIncludedEnrollmentSessionCount(countable, includedIds);
    const parts = [];
    if (includedCount > 0) parts.push(`${includedCount} included`);
    if (pendingStagedSessions.length > 0) parts.push(`${pendingStagedSessions.length} staged`);
    counter.textContent = parts.length ? `${parts.join(' · ')} session(s)` : 'No sessions staged';
  }

