  function setChargeModalMode(mode) {
    draftReviewMode = mode === 'review' ? 'review' : 'create';
    const createBtn = qs('btn_confirmChargeEnrollment');
    const saveBtn = qs('btn_saveDraftEnrollment');
    const approveBtn = qs('btn_approveDraftEnrollment');

    if (createBtn) {
      createBtn.style.display = draftReviewMode === 'create' ? '' : 'none';
    }
    if (saveBtn) {
      saveBtn.style.display = draftReviewMode === 'review' ? '' : 'none';
    }
    if (approveBtn) {
      approveBtn.style.display = draftReviewMode === 'review' ? '' : 'none';
