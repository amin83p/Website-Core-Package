  function normalizeSessionCapacityTypeValue(value) {
    const token = String(value || '').trim().toLowerCase().replace(/[\s-]+/g, '_');
    if (token === 'one_on_one' || token === '1_on_1' || token === 'oneonone') return 'one_on_one';
    return 'group';
  }

