  async function fetchEnrollmentAttendanceReport(periodId, reportDate = '') {
    const normalizedPeriodId = String(periodId || '').trim();
    if (!normalizedPeriodId) return null;
    setEnrollmentAttendanceReportLoading(true);
    const query = reportDate ? `?reportDate=${encodeURIComponent(String(reportDate).trim())}` : '';
    const result = await requestJson(`/school/classes/api/enrollment-periods/${encodeURIComponent(normalizedPeriodId)}/attendance-report${query}`);
    setEnrollmentAttendanceReportLoading(false);
    if (!result || result.status !== 'success') return null;
    enrollmentAttendanceReportPayload = result.data || {};
    renderEnrollmentAttendanceReport(enrollmentAttendanceReportPayload);
    return enrollmentAttendanceReportPayload;
  }

