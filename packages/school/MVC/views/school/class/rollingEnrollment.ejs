  async function loadRows() {
    const search = (typeof window !== 'undefined' && window.location && window.location.search)
      ? window.location.search
      : '';
    const result = await requestJson(`/school/classes/api/${encodeURIComponent(classId)}/enrollment-periods${search}`);
    if (!result) return;
    periodRows = Array.isArray(result.items) ? result.items : [];
    renderRows();
  }

  async function addPeriod() {
    if (enrollWizardStep === 'form') {
      readEnrollmentCapFields();
      if (!hasEnrollmentCap()) {
        await proceedWithEnrollmentAfterAlignment();
        return;
      }
      if (hasTargetSessionCount() && hasTargetHours()) {
        await showMsg('Validation', 'warning', 'Set either a session target or an hour target, not both.');
        return;
      }
      const alignmentGate = await ensureEnrollmentSessionAlignment();
      if (alignmentGate.nextStep === 'addSessions') {
        enrollWizardPath = 'planA';
        enrollWizardSkippedAddSessions = false;
        enrollWizardStep = 'addSessions';
        prepareAddSessionsStep(alignmentGate.alignment);
        setEnrollmentWizardStepVisibility();
        return;
      }
      if (alignmentGate.nextStep === 'markNa') {
        goEnrollmentMarkNaStep(alignmentGate.alignment, { skippedAddSessions: true });
        return;
      }
      if (alignmentGate.nextStep === 'conflicts') {
        enrollWizardPath = 'planA';
        const loaded = await loadConflictReviewStep();
        if (!loaded) return;
        enrollWizardStep = 'conflicts';
        setEnrollmentWizardStepVisibility();
        return;
      }
      if (!alignmentGate.ok) return;
      await proceedWithEnrollmentAfterAlignment();
      return;
    }

    if (enrollWizardStep === 'addSessions') {
      const alignment = await refreshAlignmentWithStagedSessions();
      if (!await validateEnrollmentPickForContinue()) {
        syncEnrollmentWizardPrimaryButton();
        return;
      }
      syncPlannedNaFromIncludedSelection();
      if (pendingStagedSessions.length) {
        const loaded = await loadConflictReviewStep();
        if (!loaded) return;
        enrollWizardStep = 'conflicts';
        setEnrollmentWizardStepVisibility();
        return;
      }
      await proceedWithEnrollmentAfterAlignment();
      return;
    }

    if (enrollWizardStep === 'markNa') {
      const requiredHours = Number(lastAlignmentResult?.requiredNaHours || 0);
      const requiredSessions = Number(lastAlignmentResult?.requiredNaCount || 0);
      const selectedHours = readSelectedNaSessionHours();
      const selectedSessions = readSelectedNaSessionIds();
      if (requiredHours > 0 && selectedHours < requiredHours) {
        await showMsg('Validation', 'warning', `Select sessions totaling at least ${requiredHours} hour(s) to mark N/A (selected ${selectedHours} hr).`);
        return;
      }
      if (requiredHours <= 0 && selectedSessions.length !== requiredSessions) {
        await showMsg('Validation', 'warning', `Select exactly ${requiredSessions} session(s) to mark N/A.`);
        return;
      }
      pendingPlannedNaSessionIds = selectedSessions.slice();
      if (pendingStagedSessions.length) {
        const loaded = await loadConflictReviewStep();
        if (!loaded) return;
        enrollWizardStep = 'conflicts';
        setEnrollmentWizardStepVisibility();
        return;
      }
      await proceedWithEnrollmentAfterAlignment();
      return;
    }

    if (enrollWizardStep === 'conflicts') {
      if (conflictReviewHasConflicts) {
        await showMsg('Conflicts remain', 'warning', 'Go Back to the add-sessions step and resolve conflicts before adding the enrollment period.');
        return;
      }
      await proceedWithEnrollmentAfterAlignment();
    }
  }

  function openCloseModal(periodId, targetStatus = 'completed') {
    const row = (Array.isArray(periodRows) ? periodRows : []).find((item) => String(item?.id || '') === String(periodId || ''));
    if (!row || !closeModal) return;
    approvedCloseStatusPayload = null;
    qs('close_periodId').value = String(row.id || '');
    qs('close_endDate').value = String(row.endDate || '').trim() || orgTodayFallback();
    qs('close_status').value = targetStatus;
    qs('close_reasonEnd').value = '';
    qs('btn_confirmClosePeriod').disabled = true;
    qs('close_statusPreview').className = 'alert alert-light border mt-3 mb-0';
    qs('close_statusPreview').textContent = 'Preview the financial effect before applying the status change.';
    closeModal.show();
  }

  function readCloseStatusPayload() {
    return {
      targetStatus: String(qs('close_status')?.value || 'completed').trim().toLowerCase(),
      effectiveDate: String(qs('close_endDate')?.value || '').trim(),
      reason: String(qs('close_reasonEnd')?.value || '').trim()
    };
  }

  async function previewClosePeriod() {
    const periodId = String(qs('close_periodId')?.value || '').trim();
    const payload = readCloseStatusPayload();
    if (!periodId || !payload.effectiveDate || !payload.reason) {
      await showMsg('Missing Fields', 'warning', 'Period, effective date, and reason are required.');
      return;
    }
    try {
      showBusy('Preparing status preview...');
      const result = await requestJson(`/school/classes/api/enrollment-periods/${encodeURIComponent(periodId)}/status/preview`, 'POST', payload);
      if (!result) return;
      approvedCloseStatusPayload = payload;
      qs('btn_confirmClosePeriod').disabled = false;
      const preview = result.preview || {};
      qs('close_statusPreview').className = 'alert alert-info mt-3 mb-0';
      qs('close_statusPreview').textContent = payload.targetStatus === 'cancelled'
        ? 'Cancellation will reverse ' + (preview.sourceTransactions || []).length +
          ' charge transaction(s), total ' + Number(preview.adjustmentTotal || 0).toFixed(2) +
          '. Payments will remain unchanged.'
        : (payload.targetStatus === 'archived'
          ? 'Archival will leave financial transactions unchanged.'
          : 'Completion will leave financial transactions unchanged.');
    } catch (error) {
      approvedCloseStatusPayload = null;
      qs('btn_confirmClosePeriod').disabled = true;
      qs('close_statusPreview').className = 'alert alert-light border mt-3 mb-0';
      qs('close_statusPreview').textContent = 'Preview the financial effect before applying the status change.';
      await showMsg('Preview failed', 'error', error.message || 'Unable to prepare status preview.');
    } finally {
      hideBusy();
    }
  }

  async function submitClosePeriod() {
    const periodId = String(qs('close_periodId')?.value || '').trim();
    const payload = readCloseStatusPayload();
    if (!approvedCloseStatusPayload || JSON.stringify(payload) !== JSON.stringify(approvedCloseStatusPayload)) {
      await showMsg('Preview Required', 'warning', 'Preview the current status, date, and reason before applying.');
      qs('btn_confirmClosePeriod').disabled = true;
      return;
    }
    try {
      showBusy('Applying status change...');
      const result = await requestJson(`/school/classes/api/enrollment-periods/${encodeURIComponent(periodId)}/status/apply`, 'POST', payload);
      if (!result) return;
      closeModal.hide();
      await showMsg('Status Updated', 'success', result.message || 'Enrollment status updated.');
      await loadRows();
    } catch (error) {
      await showMsg('Status Change Failed', 'error', error.message || 'Unable to update enrollment status.');
      qs('btn_confirmClosePeriod').disabled = false;
    } finally {
      hideBusy();
    }
  }

  function openReentryModal(periodId) {
