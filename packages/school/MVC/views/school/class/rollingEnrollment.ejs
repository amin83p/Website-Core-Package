  function collectGroupEnrollmentEntryFromEditRow(index) {
    const container = qs('groupEnrollmentStudentsTbody')?.querySelector(`[data-group-edit-row="${index}"]`);
    if (!container) return null;
    const funderSelect = container.querySelector('[data-group-edit-field="funder"]');
