  .attendance-report-modal .attendance-report-metric-label {
    font-size: 0.74rem;
    font-weight: 600;
    color: #6b7a89;
    line-height: 1.2;
  }
  .attendance-report-modal .attendance-report-metric-value {
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.15;
    color: #17324d;
  }
  .attendance-report-modal .attendance-report-metric-featured .attendance-report-metric-value {
    font-size: 1.75rem;
  }
  .attendance-report-modal .attendance-report-metric-sub {
    font-size: 0.72rem;
    color: #6b7a89;
    margin-top: 0.15rem;
  }
  .attendance-report-modal .attendance-report-metric-actions {
    margin-top: 0.2rem;
  }
  .attendance-report-modal .attendance-report-metric-excused {
