  qs('formEnrollmentSessionsTbody')?.addEventListener('click', handleStagedSessionTableClick);
  qs('enrollmentSessionListTbody')?.addEventListener('click', handleStagedSessionTableClick);
  qs('naSessionsTbody')?.addEventListener('click', (event) => {
    const btn = event.target.closest('.na-session-toggle');
    if (!btn) return;
    const selected = btn.classList.toggle('is-selected');
    btn.classList.toggle('btn-success', selected);
    btn.classList.toggle('btn-outline-secondary', !selected);
    btn.textContent = selected ? 'N/A' : 'Mark N/A';
    const row = btn.closest('tr');
    if (row) row.classList.toggle('na-session-row-selected', selected);
    updateNaSelectionCounter();
  });
  addEnrollmentModalEl?.addEventListener('hidden.bs.modal', () => {
    if (enrollWizardStep === 'addSessions' || pendingStagedSessions.length) captureGapFormDraft();
  });
  qs('btn_confirmClosePeriod')?.addEventListener('click', submitClosePeriod);
  qs('btn_previewClosePeriod')?.addEventListener('click', previewClosePeriod);
  qs('btn_confirmReentry')?.addEventListener('click', submitReentry);
  qs('btn_confirmEditPeriod')?.addEventListener('click', submitEditPeriod);
  qs('btn_confirmChargeEnrollment')?.addEventListener('click', submitChargeableEnrollment);
  qs('btn_saveDraftEnrollment')?.addEventListener('click', saveExistingDraftEnrollment);
  qs('btn_approveDraftEnrollment')?.addEventListener('click', approveDraftEnrollment);
  qs('btnPickManualDebit')?.addEventListener('click', () => openAccountPickerForManual('Debit'));
  qs('btnPickManualCredit')?.addEventListener('click', () => openAccountPickerForManual('Credit'));
  qs('btnClearManualDebit')?.addEventListener('click', () => clearManualAccount('Debit'));
  qs('btnClearManualCredit')?.addEventListener('click', () => clearManualAccount('Credit'));
  qs('btnAddManualRow')?.addEventListener('click', addManualRow);
  bindKeyboardFlow();

  const rollingFilterCollapse = document.getElementById('rollingFilterCollapse');
  const rollingFilterToggleIcon = document.getElementById('rollingFilterToggleIcon');
  rollingFilterCollapse?.addEventListener('show.bs.collapse', () => {
    rollingFilterToggleIcon?.classList.remove('bi-chevron-down');
    rollingFilterToggleIcon?.classList.add('bi-chevron-up');
  });
  rollingFilterCollapse?.addEventListener('hide.bs.collapse', () => {
    rollingFilterToggleIcon?.classList.remove('bi-chevron-up');
    rollingFilterToggleIcon?.classList.add('bi-chevron-down');
  });

  const gapSessionsWindowCollapse = document.getElementById('gapSessionsWindowCollapse');
  const gapBatchCollapse = document.getElementById('gapBatchCollapse');
  gapSessionsWindowCollapse?.addEventListener('show.bs.collapse', () => {
    qs('btn_gapSessionsCollapseToggle')?.setAttribute('aria-expanded', 'true');
  });
  gapSessionsWindowCollapse?.addEventListener('hide.bs.collapse', () => {
    qs('btn_gapSessionsCollapseToggle')?.setAttribute('aria-expanded', 'false');
  });
  gapBatchCollapse?.addEventListener('show.bs.collapse', () => {
    qs('btn_gapBatchCollapseToggle')?.setAttribute('aria-expanded', 'true');
  });
  gapBatchCollapse?.addEventListener('hide.bs.collapse', () => {
    qs('btn_gapBatchCollapseToggle')?.setAttribute('aria-expanded', 'false');
  });

  resetChargeModalState();
  applyTargetSessionCountUi();
  renderRows();
})();
</script>
