  function prefillGroupEnrollmentEntryForm(entry = {}) {
    if (qs('grp_startDate')) qs('grp_startDate').value = String(entry.startDate || '');
    if (qs('grp_endDate')) qs('grp_endDate').value = String(entry.endDate || '');
    if (qs('grp_targetSessionCount')) qs('grp_targetSessionCount').value = String(entry.targetSessionCount || '');
    if (qs('grp_targetHours')) qs('grp_targetHours').value = String(entry.targetHours || '');
    if (qs('grp_status')) qs('grp_status').value = String(entry.status || 'active');
    if (qs('grp_reasonStart')) qs('grp_reasonStart').value = String(entry.reasonStart || '');
    refreshClaimNumberSelect('grp_claimNumber', entry.id, String(entry.claimNumber || '').trim());
    setSessionCapacitySelectValue('grp_sessionCapacityType', entry.sessionCapacityType);
    if (qs('grp_autoResolveSubjects')) qs('grp_autoResolveSubjects').checked = entry.autoResolveSubjects === true;
    setFunderSelectValue('grp_funder', {
      funderId: String(entry.funderId || 'self'),
      funderType: String(entry.funderType || 'self')
    });
    applyGroupEnrollmentCapUi();
  }

  function collectGroupEnrollmentEntryFromForm() {
    const funder = resolveFunderSelectionFromSelect('grp_funder');
    return {
      id: String(qs('grp_studentId')?.value || '').trim(),
      label: String(qs('grp_studentLabel')?.value || '').trim(),
      startDate: String(qs('grp_startDate')?.value || '').trim(),
      endDate: String(qs('grp_endDate')?.value || '').trim(),
      status: String(qs('grp_status')?.value || 'active').trim(),
      funderType: funder.funderType,
      funderId: funder.funderId,
      claimNumber: readClaimNumberSelectValue('grp_claimNumber'),
      reasonStart: String(qs('grp_reasonStart')?.value || '').trim(),
      targetSessionCount: hasTargetSessionCount('grp_targetSessionCount')
        ? String(qs('grp_targetSessionCount')?.value || '').trim()
        : '',
      targetHours: hasTargetHours('grp_targetHours')
        ? String(qs('grp_targetHours')?.value || '').trim()
        : '',
      sessionCapacityType: readSessionCapacityTypeFromSelect('grp_sessionCapacityType'),
      autoResolveSubjects: qs('grp_autoResolveSubjects')?.checked === true
    };
  }

  function validateGroupEnrollmentEntry(entry = {}) {
    if (!String(entry.id || '').trim()) return 'Select a student.';
    if (!String(entry.startDate || '').trim()) return 'Start Date is required.';
    const sessionCount = normalizeTargetSessionCountValue(entry.targetSessionCount);
    const hours = normalizeTargetHoursValue(entry.targetHours);
    if (sessionCount > 0 && hours > 0) return 'Set either a session target or an hour target, not both.';
    const cycleIssue = validateCycleEnrollmentDates(entry.startDate);
    if (cycleIssue) return cycleIssue;
    return '';
  }

  async function addGroupEnrollmentEntry() {
    const entry = collectGroupEnrollmentEntryFromForm();
    const validationIssue = validateGroupEnrollmentEntry(entry);
    if (validationIssue) {
      await showMsg('Validation', 'warning', validationIssue);
      return;
    }
    if (groupEnrollmentStudents.some((row) => String(row.id) === String(entry.id))) {
      await showMsg('Duplicate student', 'warning', 'This student is already in the enrollment list.');
      return;
    }
    groupEnrollmentStudents.push({ ...entry });
    renderGroupEnrollmentStudents();
    prefillGroupEnrollmentEntryForm(entry);
    clearGroupEnrollmentEntryStudent();
    qs('grp_studentLabel')?.focus();
  }

  function clearGroupEnrollmentForm() {
    groupEnrollmentStudents = [];
    groupEnrollmentEditingIndex = -1;
    groupEnrollmentResultRepairContext = null;
    renderGroupEnrollmentStudents();
    clearGroupEnrollmentEntryStudent();
    if (qs('grp_startDate')) qs('grp_startDate').value = '';
    if (qs('grp_endDate')) qs('grp_endDate').value = '';
    if (qs('grp_targetSessionCount')) qs('grp_targetSessionCount').value = '';
    if (qs('grp_targetHours')) qs('grp_targetHours').value = '';
    if (qs('grp_status')) qs('grp_status').value = 'active';
    if (qs('grp_reasonStart')) qs('grp_reasonStart').value = '';
    populateClaimNumberSelectOptions(qs('grp_claimNumber'), [], '');
    if (qs('grp_autoResolveSubjects')) qs('grp_autoResolveSubjects').checked = false;
    setFunderSelectValue('grp_funder', { funderId: 'self', funderType: 'self' });
    setSessionCapacitySelectValue('grp_sessionCapacityType', 'group');
    applyGroupEnrollmentCapUi();
  }

  function inferGroupEnrollmentMode(settings = {}) {
    if (normalizeTargetHoursValue(settings.targetHours) > 0) return 'hour_cap';
    if (normalizeTargetSessionCountValue(settings.targetSessionCount) > 0) return 'session_cap';
    return 'date_window';
  }

  function validateGroupEnrollmentQueue() {
    if (!groupEnrollmentStudents.length) return 'Add at least one student to the enrollment list.';
    return '';
  }

  function buildGroupEnginePayload(studentId, settings = {}) {
    const enrollmentMode = inferGroupEnrollmentMode(settings);
    const payload = {
      classId,
      students: [{
        studentId: String(studentId || '').trim(),
        sessionCapacityType: normalizeSessionCapacityTypeValue(settings.sessionCapacityType)
      }],
      enrollmentMode,
      startDate: settings.startDate,
      endDate: settings.endDate,
      status: settings.status,
      funderType: settings.funderType,
      funderId: settings.funderId,
      claimNumber: settings.claimNumber,
      reasonStart: settings.reasonStart,
      sessionCountPolicy: 'all_non_na',
      sessionCapacityType: normalizeSessionCapacityTypeValue(settings.sessionCapacityType)
    };
    if (normalizeTargetSessionCountValue(settings.targetSessionCount) > 0) {
      payload.targetSessionCount = normalizeTargetSessionCountValue(settings.targetSessionCount);
    }
    if (normalizeTargetHoursValue(settings.targetHours) > 0) {
      payload.targetHours = normalizeTargetHoursValue(settings.targetHours);
    }
    return payload;
  }

  async function fetchGroupStudentPrerequisites(studentId, startDate) {
    const result = await requestJson(
      `/school/classes/api/${encodeURIComponent(classId)}/rolling-enrollment-prerequisites`,
      'POST',
      { studentId, startDate }
    );
    return result?.data || null;
  }

  function buildGroupResultTermRegistrationHref(entry = {}) {
    const params = new URLSearchParams();
    const studentId = String(entry.id || '').trim();
    if (studentId) params.set('studentId', studentId);
    params.set('returnTo', window.location.pathname);
    return '/school/programs/register-terms-batch-wizard?' + params.toString();
  }

  function buildGroupEnrollmentResultActionsHtml(result, index) {
    if (result?.ok) return '<span class="text-muted small">—</span>';
    const parts = [];
    const kind = String(result?.failureKind || 'other');
    if (kind === 'missing_program') {
      parts.push(
        '<button type="button" class="btn btn-sm btn-outline-primary btn-group-result-program-reg" data-result-index="' + String(index) + '">'
        + '<i class="bi bi-journal-plus me-1"></i>Resolve Program Reg</button>'
      );
    }
    if (kind === 'missing_subjects') {
      parts.push(
        '<button type="button" class="btn btn-sm btn-outline-warning btn-group-result-subjects" data-result-index="' + String(index) + '">'
        + '<i class="bi bi-mortarboard me-1"></i>Resolve Subjects</button>'
      );
    }
    if (kind === 'missing_term') {
      const href = buildGroupResultTermRegistrationHref(result.entry || {});
      parts.push(
        '<a class="btn btn-sm btn-outline-primary btn-group-result-term" target="_blank" rel="noopener" href="' + htmlEscape(href) + '">'
        + '<i class="bi bi-box-arrow-up-right me-1"></i>Resolve Term Reg</a>'
      );
    }
    if (kind === 'schedule_conflict') {
      parts.push(
        '<button type="button" class="btn btn-sm btn-outline-danger btn-group-result-conflicts" data-result-index="' + String(index) + '">'
        + '<i class="bi bi-calendar-x me-1"></i>View conflicts</button>'
      );
    }
    parts.push(
      '<button type="button" class="btn btn-sm btn-primary btn-group-result-complete" data-result-index="' + String(index) + '">'
      + '<i class="bi bi-check2-circle me-1"></i>Complete enrollment</button>'
    );
    return '<div class="d-flex flex-wrap gap-1">' + parts.join('') + '</div>';
  }

  function buildGroupEnrollmentResultRowHtml(result, index) {
    const statusBadge = result.ok
      ? '<span class="badge bg-success-subtle text-success border">Success</span>'
      : '<span class="badge bg-danger-subtle text-danger border">Failed</span>';
    let details = result.ok
      ? (result.period?.id ? `Period ${htmlEscape(String(result.period.id))}` : htmlEscape(String(result.message || 'Enrolled')))
      : htmlEscape(String(result.error || 'Enrollment failed.'));
    if (result.ok && String(result.mode || '').toLowerCase() === 'chargeable') {
      details += ' · Draft created';
    }
    return '<tr data-group-result-row="' + String(index) + '">'
      + '<td>' + htmlEscape(result.label || result.studentId || '') + '</td>'
      + '<td>' + statusBadge + '</td>'
      + '<td class="small">' + details + '</td>'
      + '<td class="small">' + buildGroupEnrollmentResultActionsHtml(result, index) + '</td>'
      + '</tr>';
  }

  function syncGroupEnrollmentResultsChrome() {
    const list = Array.isArray(groupEnrollmentLastResults) ? groupEnrollmentLastResults : [];
    const succeeded = list.filter((row) => row.ok).length;
    const failed = list.length - succeeded;
    const summary = qs('groupEnrollmentResultsSummary');
    if (summary) {
      if (!list.length) {
        summary.textContent = 'No results.';
      } else {
        let text = `${succeeded} succeeded, ${failed} failed (${list.length} total).`;
        if (failed > 0) text += ' Resolve issues below, then complete enrollment.';
        summary.textContent = text;
      }
    }
    const retryAllBtn = qs('btn_groupRetryAllFailed');
    if (retryAllBtn) {
      retryAllBtn.classList.toggle('d-none', failed === 0);
      retryAllBtn.disabled = groupEnrollmentInProgress;
    }
  }

  function renderGroupEnrollmentResultRow(resultIndex) {
    const tbody = qs('groupEnrollmentResultsTbody');
    const result = groupEnrollmentLastResults[resultIndex];
    if (!tbody || !result) return;
    const existing = tbody.querySelector('[data-group-result-row="' + String(resultIndex) + '"]');
    const html = buildGroupEnrollmentResultRowHtml(result, resultIndex);
    if (existing) {
      existing.outerHTML = html;
    }
  }

  function openGroupResultSubjectRepair(resultIndex) {
    const result = groupEnrollmentLastResults[resultIndex];
    if (!result?.entry?.id) return;
    const repair = getPriorRepairFromEligibility(result.prereq || {});
    if (!repair.missingSubjects.length) {
      showMsg('No Suggestions', 'info', 'No missing prerequisite subjects were found for this student.');
      return;
    }
    groupEnrollmentResultRepairContext = {
      resultIndex,
      entry: result.entry,
      prereq: result.prereq,
      mode: 'subjects'
    };
    populatePriorCreditRepairModal(
      { id: result.entry.id, label: result.entry.label || result.entry.id },
      repair,
      { groupMode: true, groupResultsMode: true }
    );
    if (priorCreditRepairModalEl && bootstrapApi?.Modal) {
      bootstrapApi.Modal.getOrCreateInstance(priorCreditRepairModalEl, { backdrop: true, keyboard: true });
    }
    priorCreditRepairModal?.show();
  }

  function openGroupResultConflictModal(resultIndex) {
    const result = groupEnrollmentLastResults[resultIndex];
    if (!result) return;
    const prereqRoot = result.prereq?.prerequisite || {};
    const conflicts = Array.isArray(prereqRoot.conflicts) ? prereqRoot.conflicts : [];
    const student = {
      id: String(result.entry?.id || result.studentId || '').trim(),
      label: String(result.entry?.label || result.label || '').trim()
    };
    const tbody = qs('studentConflictTbody');
    if (!tbody) return;
    if (!conflicts.length) {
      tbody.innerHTML = '<tr><td colspan="3" class="text-center text-muted">No conflicts found.</td></tr>';
    } else {
      tbody.innerHTML = conflicts.map(function (c) {
        return '<tr>'
          + '<td>' + htmlEscape(c.date || '') + '</td>'
          + '<td>' + htmlEscape(c.conflictClass || '') + '</td>'
          + '<td>' + htmlEscape(c.existTime || '') + '</td>'
          + '</tr>';
      }).join('');
    }
    const viewBtn = qs('btn_viewStudentSchedule');
    if (viewBtn && student.id) {
      const personId = prereqRoot.conflictStudentPersonId || student.id;
      const personName = prereqRoot.conflictStudentLabel || student.label || '';
      const startDate = String(result.entry?.startDate || '').trim();
      const params = new URLSearchParams();
      params.set('personId', personId);
      params.set('personName', personName);
      if (startDate) params.set('date', startDate);
      viewBtn.href = '/school/schedules/viewer?' + params.toString();
    }
    const modalEl = qs('studentConflictModal');
    if (modalEl) {
      const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
      modal.show();
    }
  }

  function renderGroupEnrollmentResults(results = []) {
    const tbody = qs('groupEnrollmentResultsTbody');
    if (!tbody) return;
    groupEnrollmentLastResults = Array.isArray(results) ? results.map((row) => ({ ...row })) : [];
    const list = groupEnrollmentLastResults;
    syncGroupEnrollmentResultsChrome();
    if (!list.length) {
      tbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted py-3">No results.</td></tr>';
      return;
    }
    tbody.innerHTML = list.map((row, index) => buildGroupEnrollmentResultRowHtml(row, index)).join('');
  }

  async function retryGroupEnrollmentResult(resultIndex) {
    const result = groupEnrollmentLastResults[resultIndex];
    if (!result?.entry?.id || groupEnrollmentInProgress) return;
    const entry = result.entry;
    const label = String(entry.label || entry.id || '').trim();
    groupEnrollmentInProgress = true;
    const retryAllBtn = qs('btn_groupRetryAllFailed');
    if (retryAllBtn) retryAllBtn.disabled = true;
    try {
      showBusy(`Completing enrollment for ${label}...`);
      const outcome = await runGroupEnrollmentForStudent(entry, resultIndex, groupEnrollmentLastResults.length);
      groupEnrollmentLastResults[resultIndex] = {
        ...groupEnrollmentLastResults[resultIndex],
        ...outcome,
        entry: snapshotGroupEnrollmentEntry(entry)
      };
      renderGroupEnrollmentResultRow(resultIndex);
      syncGroupEnrollmentResultsChrome();
      if (outcome.ok) {
        await loadRows();
      }
    } catch (error) {
      groupEnrollmentLastResults[resultIndex] = {
        ...groupEnrollmentLastResults[resultIndex],
        ok: false,
        error: error?.message || 'Enrollment failed.',
        failureKind: 'other',
        entry: snapshotGroupEnrollmentEntry(entry)
      };
      renderGroupEnrollmentResultRow(resultIndex);
      syncGroupEnrollmentResultsChrome();
    } finally {
      groupEnrollmentInProgress = false;
      syncGroupEnrollmentResultsChrome();
      hideBusy();
    }
  }

  async function retryAllFailedGroupEnrollments() {
    if (groupEnrollmentInProgress) return;
    const failedIndexes = groupEnrollmentLastResults
      .map((row, index) => (!row.ok ? index : -1))
      .filter((index) => index >= 0);
    if (!failedIndexes.length) return;
    groupEnrollmentInProgress = true;
    const retryAllBtn = qs('btn_groupRetryAllFailed');
    if (retryAllBtn) retryAllBtn.disabled = true;
    try {
      for (let i = 0; i < failedIndexes.length; i += 1) {
        const resultIndex = failedIndexes[i];
        const entry = groupEnrollmentLastResults[resultIndex]?.entry;
        if (!entry?.id) continue;
        const label = String(entry.label || entry.id || '').trim();
        showBusy(`Completing enrollment for ${label} (${i + 1}/${failedIndexes.length})...`);
        try {
          const outcome = await runGroupEnrollmentForStudent(entry, resultIndex, failedIndexes.length);
          groupEnrollmentLastResults[resultIndex] = {
            ...groupEnrollmentLastResults[resultIndex],
            ...outcome,
            entry: snapshotGroupEnrollmentEntry(entry)
          };
        } catch (error) {
          groupEnrollmentLastResults[resultIndex] = {
            ...groupEnrollmentLastResults[resultIndex],
            ok: false,
            error: error?.message || 'Enrollment failed.',
            failureKind: 'other',
            entry: snapshotGroupEnrollmentEntry(entry)
          };
        }
        renderGroupEnrollmentResultRow(resultIndex);
        syncGroupEnrollmentResultsChrome();
      }
      await loadRows();
    } finally {
      groupEnrollmentInProgress = false;
      syncGroupEnrollmentResultsChrome();
      hideBusy();
    }
  }

  async function runGroupEnrollmentForStudent(entry, index, total) {
    const label = String(entry?.label || entry?.id || '').trim();
    const progressLabel = `${label} (${index + 1}/${total})`;
    const settings = groupEnrollmentSettingsFromEntry(entry);
    const autoResolve = entry?.autoResolveSubjects === true;
    let prereq = await fetchGroupStudentPrerequisites(entry.id, settings.startDate);
    if (autoResolve && prereq?.clbPlacement?.canApplyPlacement && prereq?.resolved?.programId) {
      showBusy(`Applying CLB placement credits for ${progressLabel}...`);
      try {
        await requestJson(
          `/school/classes/api/${encodeURIComponent(classId)}/rolling-prior-subject-credits/apply-placement`,
          'POST',
          {
            studentId: entry.id,
            studentIds: [entry.id],
            programId: String(prereq.resolved.programId || '').trim(),
            startDate: settings.startDate
          }
        );
        prereq = await fetchGroupStudentPrerequisites(entry.id, settings.startDate);
      } catch (error) {
        return buildGroupEnrollmentFailureResult(entry, prereq, error?.message || 'CLB placement prior credits could not be applied.');
      }
    }
    if (!prereq || prereq.eligible !== true) {
      return buildGroupEnrollmentFailureResult(entry, prereq);
    }
    showBusy(`Enrolling ${progressLabel}...`);
    const enginePayload = buildGroupEnginePayload(entry.id, settings);
    const result = await requestJson(
      `/school/classes/api/${encodeURIComponent(classId)}/rolling-enrollment/execute`,
      'POST',
      enginePayload
    );
    if (!result) {
      return {
        studentId: entry.id,
        label,
        ok: false,
        error: 'Enrollment request failed.',
        failureKind: 'other',
        prereq,
        entry: snapshotGroupEnrollmentEntry(entry)
      };
    }
    const engineData = result.data && typeof result.data === 'object' ? result.data : {};
    const row = Array.isArray(engineData.results)
      ? engineData.results.find((resultRow) => String(resultRow?.studentId || '') === String(entry.id))
      : null;
    if (!row || row.ok !== true) {
      const execError = String(row?.error || result.message || 'Enrollment failed.');
      return {
        studentId: entry.id,
        label,
        ok: false,
        error: execError,
        failureKind: classifyGroupEnrollmentFailure(prereq, execError),
        prereq,
        entry: snapshotGroupEnrollmentEntry(entry)
      };
    }
    return {
      studentId: entry.id,
      label,
      ok: true,
      message: String(result.message || 'Enrollment completed.'),
      period: row.period || result.period || null,
      academicLedger: row.academicLedger || result.academicLedger || null,
      mode: String(row.mode || '').trim(),
      entry: snapshotGroupEnrollmentEntry(entry)
    };
  }

  async function runGroupEnrollment() {
    if (groupEnrollmentInProgress) return;
    const validationIssue = validateGroupEnrollmentQueue();
    if (validationIssue) {
      await showMsg('Validation', 'warning', validationIssue);
      return;
    }
    if (cycleWindow?.isClosedForNewEnrollment) {
      await showMsg('Cycle closed', 'warning', 'This cycle is closed for new enrollment.');
      return;
    }
    const students = groupEnrollmentStudents.slice();
    const results = [];
    groupEnrollmentInProgress = true;
    const completeBtn = qs('btn_completeGroupEnrollment');
    if (completeBtn) completeBtn.disabled = true;
    try {
      for (let i = 0; i < students.length; i += 1) {
        const entry = students[i];
        showBusy(`Checking prerequisites for ${entry.label || entry.id} (${i + 1}/${students.length})...`);
        try {
          const outcome = await runGroupEnrollmentForStudent(entry, i, students.length);
          results.push(outcome);
        } catch (error) {
          results.push({
            studentId: entry.id,
            label: entry.label || entry.id,
            ok: false,
            error: error?.message || 'Enrollment failed.',
            failureKind: 'other',
            prereq: null,
            entry: snapshotGroupEnrollmentEntry(entry)
          });
        }
      }
      groupEnrollmentModal?.hide();
      renderGroupEnrollmentResults(results);
      groupEnrollmentResultsModal?.show();
      await loadRows();
    } catch (error) {
      await showMsg('Group Enrollment Failed', 'error', error?.message || 'Unable to complete group enrollment.');
    } finally {
      groupEnrollmentInProgress = false;
      groupEnrollmentResultRepairContext = null;
      if (completeBtn) completeBtn.disabled = false;
      hideBusy();
    }
  }

  function sortRollingClbHistory(entries) {
    return [...(Array.isArray(entries) ? entries : [])].sort((a, b) => {
      const dateCmp = String(b?.recordedAt || '').localeCompare(String(a?.recordedAt || ''));
      if (dateCmp !== 0) return dateCmp;
      return String(b?.id || '').localeCompare(String(a?.id || ''));
    });
  }

  function createRollingClbEntryId(index = 0) {
    return `clb_${Date.now()}_${Number(index) || 0}_${Math.random().toString(36).slice(2, 8)}`;
  }

  function getRollingClbEditorInput(group, skill) {
    return qs(`inp_rolling_clb_${group}_${skill}`);
  }

  function getLatestRollingClbEntry(history = rollingClbLevelHistory) {
    const sorted = sortRollingClbHistory(history);
    return sorted[0] || null;
  }

  function formatRollingClbCell(value) {
    const text = String(value || '').trim();
    return text || '—';
  }

  function formatRollingClbDateLabel(value) {
    return formatRollingClbCell(value);
  }

  function rollingClbEntryHasValues(entry) {
    if (!entry || typeof entry !== 'object') return false;
    return ROLLING_CLB_VALUE_GROUPS.some((group) =>
      ROLLING_CLB_SKILLS.some((skill) => {
        const text = String(entry?.[group]?.[skill] || '').trim();
        return text && text !== '-';
      })
    );
  }

  function renderRollingClbSkillValueCell(value) {
    const text = String(value || '').trim();
    if (!text || text === '-') return '<span class="text-muted">—</span>';
    return htmlEscape(text);
  }

  function renderRollingClbPreviousEntryHeadsUp() {
    const panel = qs('rollingClb_previousEntryHeadsUp');
    if (!panel) return;
    const isNewEntry = !String(rollingClbEditingEntryId || '').trim();
    const latest = isNewEntry ? getLatestRollingClbEntry() : null;
    if (!isNewEntry || !latest || !rollingClbEntryHasValues(latest)) {
      panel.classList.add('d-none');
      panel.innerHTML = '';
      return;
    }
    const skillHeaders = ROLLING_CLB_SKILLS.map((skill) => {
      const label = skill.charAt(0).toUpperCase() + skill.slice(1);
      return `<th class="text-center">${htmlEscape(label)}</th>`;
    }).join('');
    const rowLabels = {
      goal: 'CLB Goal',
      current: 'Current CLB Level',
      result: 'CLB Result'
    };
    const rowsHtml = ROLLING_CLB_VALUE_GROUPS.map((group) => `
      <tr>
        <td class="rolling-clb-heads-up-row-label">${htmlEscape(rowLabels[group] || group)}</td>
        ${ROLLING_CLB_SKILLS.map((skill) => `
          <td class="text-center font-monospace">${renderRollingClbSkillValueCell(latest?.[group]?.[skill])}</td>
        `).join('')}
      </tr>
    `).join('');
    panel.classList.remove('d-none');
    panel.innerHTML = `
      <div class="rolling-clb-heads-up">
        <div class="rolling-clb-heads-up__header">
          <i class="bi bi-clock-history" aria-hidden="true"></i>
          <div>
            <div class="rolling-clb-heads-up__title">Previous CLB entry</div>
            <div class="rolling-clb-heads-up__subtitle">Use this as a reference when entering the new goal, current, and result levels.</div>
          </div>
        </div>
        <div class="rolling-clb-heads-up__dates">
          <span><strong>Goal / Current date:</strong> ${htmlEscape(formatRollingClbDateLabel(latest.recordedAt))}</span>
          <span><strong>Result date:</strong> ${htmlEscape(formatRollingClbDateLabel(latest.resultRecordedAt))}</span>
        </div>
        <div class="table-responsive">
          <table class="table table-sm table-bordered rolling-clb-heads-up__table mb-0">
            <thead class="table-light">
              <tr>
                <th>Row</th>
                ${skillHeaders}
              </tr>
            </thead>
            <tbody>${rowsHtml}</tbody>
          </table>
        </div>
        <div class="rolling-clb-heads-up__note">Current CLB level fields below are prefilled from the previous result where available.</div>
      </div>
    `;
  }

  function formatRollingClbSkillSummary(entry) {
    const parts = [];
    const labels = { goal: 'Goal', current: 'Current', result: 'Result' };
    ROLLING_CLB_VALUE_GROUPS.forEach((group) => {
      const values = ROLLING_CLB_SKILLS
        .map((skill) => String(entry?.[group]?.[skill] || '').trim())
        .filter(Boolean);
      if (values.length) parts.push(`${labels[group]}: ${values.join('/')}`);
    });
    return parts.join(' · ') || '—';
  }

  function syncRollingClbEditPermissions() {
    const editable = canEditStudentClb === true;
    qs('btn_rollingClbAddEntry')?.classList.toggle('d-none', !editable);
    qs('btn_rollingClbSaveEntry')?.classList.toggle('d-none', !editable);
    document.querySelectorAll('.rolling-clb-editor-input').forEach((input) => {
      input.readOnly = !editable;
      if (input.type === 'date') input.disabled = !editable;
    });
  }

  function showRollingClbListPanel() {
    qs('rollingClb_listPanel')?.classList.remove('d-none');
    qs('rollingClb_editorPanel')?.classList.add('d-none');
    rollingClbEditingEntryId = '';
    renderRollingClbPreviousEntryHeadsUp();
  }

  function clearRollingClbEditor() {
    const recordedAt = qs('inp_rolling_clbRecordedAt');
    const resultRecordedAt = qs('inp_rolling_clbResultRecordedAt');
    if (recordedAt) {
      recordedAt.value = (window.AppOrgDateTime && AppOrgDateTime.today)
        ? String(AppOrgDateTime.today)
        : String(orgToday || '');
    }
    if (resultRecordedAt) resultRecordedAt.value = '';
    ROLLING_CLB_VALUE_GROUPS.forEach((group) => {
      ROLLING_CLB_SKILLS.forEach((skill) => {
        const input = getRollingClbEditorInput(group, skill);
        if (input) input.value = '';
      });
      const firstSkillInput = getRollingClbEditorInput(group, ROLLING_CLB_SKILLS[0]);
      if (firstSkillInput) firstSkillInput.value = '-';
    });
  }

  function prefillRollingClbCurrentFromLatest() {
    const latest = getLatestRollingClbEntry();
    if (!latest) return;
    ROLLING_CLB_SKILLS.forEach((skill) => {
      const input = getRollingClbEditorInput('current', skill);
      const value = String(latest?.result?.[skill] || '').trim();
      if (input && value) input.value = value;
    });
  }

  function collectRollingClbEditorGroupsFromInputs() {
    const values = { goal: {}, current: {}, result: {} };
    ROLLING_CLB_VALUE_GROUPS.forEach((group) => {
      ROLLING_CLB_SKILLS.forEach((skill) => {
        values[group][skill] = String(getRollingClbEditorInput(group, skill)?.value || '').trim();
      });
    });
    return values;
  }

  function refreshRollingClbEditorWarnings() {
    const parser = window.ClbLevelValueParser;
    const alertEl = qs('rollingClb_entryWarnings');
    document.querySelectorAll('.rolling-clb-editor-input').forEach((input) => {
      input.classList.remove('clb-level-value-warning');
    });
    if (!parser || !alertEl) return;
    const context = {
      mode: rollingClbEditingEntryId ? 'edit' : 'new',
      previousEntry: rollingClbEditingEntryId ? null : getLatestRollingClbEntry()
    };
    const warnings = parser.evaluateClbEditorWarnings(collectRollingClbEditorGroupsFromInputs(), context);
    const list = Object.values(warnings);
    if (!list.length) {
      alertEl.classList.add('d-none');
      alertEl.innerHTML = '';
      return;
    }
    alertEl.classList.remove('d-none');
    alertEl.innerHTML = list.map((warning) => `<div>${formatRichServerMessageHtml(warning.message)}</div>`).join('');
    list.forEach((warning) => {
      const input = document.getElementById(parser.resolveClbEditorInputId(warning, 'rolling'));
      if (input) input.classList.add('clb-level-value-warning');
    });
  }

  function resetRollingClbEditorMode() {
    rollingClbEditingEntryId = '';
    const title = qs('rollingClb_editorTitle');
    const saveBtn = qs('btn_rollingClbSaveEntry');
    const removeBtn = qs('btn_rollingClbRemoveEntry');
    if (title) title.textContent = 'New CLB Entry';
    if (saveBtn) saveBtn.textContent = 'Save CLB Entry';
    if (removeBtn) removeBtn.classList.add('d-none');
  }

  function showRollingClbEditorPanel() {
    qs('rollingClb_listPanel')?.classList.add('d-none');
    qs('rollingClb_editorPanel')?.classList.remove('d-none');
    syncRollingClbEditPermissions();
  }

  function openRollingClbEditorForNewEntry() {
    resetRollingClbEditorMode();
    clearRollingClbEditor();
    prefillRollingClbCurrentFromLatest();
    showRollingClbEditorPanel();
    renderRollingClbPreviousEntryHeadsUp();
    refreshRollingClbEditorWarnings();
  }

  function openRollingClbEditorForEntry(entryId) {
    const entry = rollingClbLevelHistory.find((row) => String(row?.id || '') === String(entryId || ''));
    if (!entry) return;
    clearRollingClbEditor();
    rollingClbEditingEntryId = String(entry.id || '');
    const recordedAt = qs('inp_rolling_clbRecordedAt');
    const resultRecordedAt = qs('inp_rolling_clbResultRecordedAt');
    if (recordedAt) recordedAt.value = String(entry.recordedAt || '');
    if (resultRecordedAt) resultRecordedAt.value = String(entry.resultRecordedAt || '');
    ROLLING_CLB_VALUE_GROUPS.forEach((group) => {
      ROLLING_CLB_SKILLS.forEach((skill) => {
        const input = getRollingClbEditorInput(group, skill);
        if (input) input.value = String(entry?.[group]?.[skill] || '');
      });
    });
    const title = qs('rollingClb_editorTitle');
    const saveBtn = qs('btn_rollingClbSaveEntry');
    const removeBtn = qs('btn_rollingClbRemoveEntry');
    if (title) title.textContent = 'Edit CLB Entry';
    if (saveBtn) saveBtn.textContent = 'Update CLB Entry';
    if (removeBtn) removeBtn.classList.toggle('d-none', !canEditStudentClb);
    showRollingClbEditorPanel();
    renderRollingClbPreviousEntryHeadsUp();
    refreshRollingClbEditorWarnings();
  }

  function collectRollingClbEditorEntry() {
    const recordedAt = String(qs('inp_rolling_clbRecordedAt')?.value || '').trim();
    if (!recordedAt) throw new Error('Goal / Current date is required for a CLB entry.');
    const resultRecordedAt = String(qs('inp_rolling_clbResultRecordedAt')?.value || '').trim();
    const values = { goal: {}, current: {}, result: {} };
    ROLLING_CLB_VALUE_GROUPS.forEach((group) => {
      ROLLING_CLB_SKILLS.forEach((skill) => {
        values[group][skill] = String(getRollingClbEditorInput(group, skill)?.value || '').trim();
      });
    });
    const labels = { goal: 'CLB Goal', current: 'Current CLB Level', result: 'CLB Result' };
    ROLLING_CLB_VALUE_GROUPS.forEach((group) => {
      if (!ROLLING_CLB_SKILLS.some((skill) => values[group][skill])) {
        throw new Error(`Enter at least one value for ${labels[group]}.`);
      }
    });
    return {
      id: rollingClbEditingEntryId || createRollingClbEntryId(rollingClbLevelHistory.length),
      recordedAt,
      resultRecordedAt,
      goal: values.goal,
      current: values.current,
      result: values.result
    };
  }

  async function persistRollingClbHistory() {
    const studentId = String(rollingClbContext?.studentId || '').trim();
    if (!studentId) throw new Error('Student id is missing.');
    const result = await requestJson(
      `/school/students/api/${encodeURIComponent(studentId)}/clb-level-history`,
      'PUT',
      { clbLevelHistory: sortRollingClbHistory(rollingClbLevelHistory) }
    );
    if (!result) return false;
    rollingClbLevelHistory = Array.isArray(result.data?.clbLevelHistory)
      ? result.data.clbLevelHistory
      : rollingClbLevelHistory;
    if (result.data?.studentLabel) {
      rollingClbContext.studentLabel = String(result.data.studentLabel || '').trim();
      if (qs('rollingClb_studentLabel')) qs('rollingClb_studentLabel').value = rollingClbContext.studentLabel;
    }
    return true;
  }

  function renderRollingClbList() {
    const emptyEl = qs('rollingClb_historyEmpty');
    const wrapEl = qs('rollingClb_historyWrap');
    const tbody = qs('rollingClb_historyTbody');
    rollingClbLevelHistory = sortRollingClbHistory(rollingClbLevelHistory);
    syncRollingClbEditPermissions();
    if (!emptyEl || !wrapEl || !tbody) return;

    if (!rollingClbLevelHistory.length) {
      emptyEl.classList.remove('d-none');
      wrapEl.classList.add('d-none');
      tbody.innerHTML = '';
      return;
    }

    emptyEl.classList.add('d-none');
    wrapEl.classList.remove('d-none');
    tbody.innerHTML = rollingClbLevelHistory.map((entry) => {
      const entryId = htmlEscape(String(entry?.id || ''));
      return `
        <tr class="rolling-clb-history-row" data-entry-id="${entryId}" role="button" tabindex="0">
          <td class="fw-semibold">${htmlEscape(formatRollingClbCell(entry?.recordedAt))}</td>
          <td>${htmlEscape(formatRollingClbCell(entry?.resultRecordedAt))}</td>
          <td class="small">${htmlEscape(formatRollingClbSkillSummary(entry))}</td>
        </tr>
      `;
    }).join('');
  }

  async function saveRollingClbEntryFromEditor() {
    if (!canEditStudentClb) {
      await showMsg('CLB Entries', 'warning', 'You do not have permission to edit CLB entries.');
      return;
    }
    try {
      const entry = collectRollingClbEditorEntry();
      const wasEditing = Boolean(rollingClbEditingEntryId);
      if (rollingClbEditingEntryId) {
        const index = rollingClbLevelHistory.findIndex((row) => String(row?.id || '') === rollingClbEditingEntryId);
        if (index < 0) throw new Error('The CLB entry being edited is no longer available.');
        rollingClbLevelHistory[index] = entry;
      } else {
        rollingClbLevelHistory.push(entry);
      }
      showBusy('Saving CLB entry...');
      const saved = await persistRollingClbHistory();
      if (!saved) return;
      showRollingClbListPanel();
      renderRollingClbList();
      await showMsg('Success', 'success', wasEditing ? 'CLB entry updated.' : 'CLB entry added.');
    } catch (error) {
      await showMsg('CLB Entry', 'warning', error.message || 'Unable to save CLB entry.');
    } finally {
      hideBusy();
    }
  }

  async function removeRollingClbEntryFromEditor() {
    if (!canEditStudentClb || !rollingClbEditingEntryId) return;
    const confirmed = await showConfirm(
      'Remove this CLB entry from the student profile?',
      'Remove CLB Entry',
      { icon: 'warning', confirmText: 'Remove', confirmClass: 'btn-danger' }
    );
    if (!confirmed) return;
    rollingClbLevelHistory = rollingClbLevelHistory.filter((row) => String(row?.id || '') !== rollingClbEditingEntryId);
    try {
      showBusy('Removing CLB entry...');
      const saved = await persistRollingClbHistory();
      if (!saved) return;
      showRollingClbListPanel();
      renderRollingClbList();
      await showMsg('Success', 'success', 'CLB entry removed.');
    } catch (error) {
      await showMsg('CLB Entry', 'error', error.message || 'Unable to remove CLB entry.');
    } finally {
      hideBusy();
    }
  }

  function resolveStudentContactContext(studentId, fallbackLabel = '') {
    const sid = String(studentId || '').trim();
    const mapped = studentMap.get(sid)
      || [...studentMap.values()].find((item) => String(item?.id || '') === sid)
      || [...studentMap.values()].find((item) => String(item?.personId || '') === sid);
    const rowDisplay = resolveStudentRowDisplay({ studentId: sid, studentLabel: fallbackLabel });
    return {
      studentId: sid,
      studentLabel: String(mapped?.label || fallbackLabel || rowDisplay.label || sid).trim(),
      personId: String(mapped?.personId || '').trim()
    };
  }

  function syncRollingStudentContextMenuPermissions() {
    const editable = canEditStudentClb === true;
    ['rollingStudentContextMenuPhones', 'rollingStudentContextMenuAddresses', 'rollingStudentContextMenuClaimNumbers'].forEach((id) => {
      const btn = qs(id);
      if (!btn) return;
      btn.disabled = !editable;
      btn.classList.toggle('disabled', !editable);
    });
  }

  function hideRollingStudentContextMenu() {
    const menu = qs('rollingStudentContextMenu');
    if (!menu) return;
    menu.classList.add('d-none');
    menu.setAttribute('aria-hidden', 'true');
    rollingStudentContextState = null;
  }

  function showRollingStudentContextMenu(event, context) {
    const menu = qs('rollingStudentContextMenu');
    if (!menu || !context?.studentId) return;
    rollingStudentContextState = { ...context };
    syncRollingStudentContextMenuPermissions();
    if (menu.parentElement !== document.body) document.body.appendChild(menu);
    menu.classList.remove('d-none');
    menu.setAttribute('aria-hidden', 'false');
    menu.style.position = 'fixed';
    menu.style.zIndex = '1200';
    const menuWidth = menu.offsetWidth || 220;
    const menuHeight = menu.offsetHeight || 120;
    const left = Math.min(event.clientX, window.innerWidth - menuWidth - 8);
    const top = Math.min(event.clientY, window.innerHeight - menuHeight - 8);
    menu.style.left = `${Math.max(8, left)}px`;
    menu.style.top = `${Math.max(8, top)}px`;
  }

  function openRollingStudentPhonesModal(context) {
    hideRollingStudentContextMenu();
    if (!canEditStudentClb) {
      showMsg('Permission', 'warning', 'You do not have permission to manage student contact details.');
      return;
    }
    if (!context?.personId) {
      showMsg('Phone Numbers', 'warning', 'This student does not have a linked person profile.');
      return;
    }
    if (typeof window.SchoolPersonProfileModal?.open !== 'function') {
      showMsg('Unavailable', 'warning', 'Person profile editor is not loaded on this page.');
      return;
    }
    window.SchoolPersonProfileModal.open({
      personId: context.personId,
      linkType: 'student',
      linkId: context.studentId,
      focus: 'phones'
    });
  }

  function openRollingStudentAddressesModal(context) {
    hideRollingStudentContextMenu();
    if (!canEditStudentClb) {
      showMsg('Permission', 'warning', 'You do not have permission to manage student contact details.');
      return;
    }
    if (!context?.personId) {
      showMsg('Addresses', 'warning', 'This student does not have a linked person profile.');
      return;
    }
    if (typeof window.SchoolPersonProfileModal?.open !== 'function') {
      showMsg('Unavailable', 'warning', 'Person profile editor is not loaded on this page.');
      return;
    }
    window.SchoolPersonProfileModal.open({
      personId: context.personId,
      linkType: 'student',
      linkId: context.studentId,
      focus: 'addresses'
    });
  }

  function setRollingClaimAlert(message) {
    const alertEl = qs('rollingClaim_alert');
    if (!alertEl) return;
    const text = String(message || '').trim();
    if (!text) {
      alertEl.classList.add('d-none');
      alertEl.textContent = '';
      return;
    }
    alertEl.textContent = text;
    alertEl.classList.remove('d-none');
  }

  function formatClaimNumberOptionLabel(entry) {
    const number = String(entry?.number || '').trim();
    const label = String(entry?.label || '').trim();
    if (!number) return '';
    return label ? `${label} (${number})` : number;
  }

  function populateClaimNumberSelectOptions(selectEl, claimNumbers, selectedValue) {
    if (!selectEl) return;
    const selected = String(selectedValue || '').trim();
    const rows = Array.isArray(claimNumbers) ? claimNumbers : [];
    const numbers = rows.map((row) => String(row?.number || '').trim()).filter(Boolean);
    const uniqueNumbers = Array.from(new Set(numbers));
    const selectedInList = !selected || uniqueNumbers.includes(selected);
    const options = ['<option value="">— None —</option>'];
    uniqueNumbers.forEach((number) => {
      const entry = rows.find((row) => String(row?.number || '').trim() === number);
      const label = entry ? formatClaimNumberOptionLabel(entry) : number;
      options.push(`<option value="${htmlEscape(number)}"${selected === number ? ' selected' : ''}>${htmlEscape(label)}</option>`);
    });
    if (selected && !selectedInList) {
      options.push(`<option value="${htmlEscape(selected)}" selected>${htmlEscape(selected)} (not in profile)</option>`);
    }
    options.push(`<option value="${CLAIM_NUMBER_ADD_NEW}">+ Add New...</option>`);
    selectEl.innerHTML = options.join('');
    selectEl.dataset.previousValue = selected;
  }

  async function fetchStudentClaimNumbers(studentId) {
    const sid = String(studentId || '').trim();
    if (!sid) return [];
    const result = await requestJson(`/school/students/api/${encodeURIComponent(sid)}/claim-numbers`);
    return Array.isArray(result?.data?.claimNumbers) ? result.data.claimNumbers : [];
  }

  async function refreshClaimNumberSelect(selectElOrId, studentId, selectedValue) {
    const selectEl = typeof selectElOrId === 'string' ? qs(selectElOrId) : selectElOrId;
    if (!selectEl) return [];
    const sid = String(studentId || '').trim();
    if (!sid) {
      populateClaimNumberSelectOptions(selectEl, [], selectedValue);
      return [];
    }
    try {
      const claimNumbers = await fetchStudentClaimNumbers(sid);
      populateClaimNumberSelectOptions(selectEl, claimNumbers, selectedValue);
      return claimNumbers;
    } catch (_) {
      populateClaimNumberSelectOptions(selectEl, [], selectedValue);
      return [];
    }
  }

  function readClaimNumberSelectValue(selectElOrId) {
    const selectEl = typeof selectElOrId === 'string' ? qs(selectElOrId) : selectElOrId;
    const value = String(selectEl?.value || '').trim();
    if (!value || value === CLAIM_NUMBER_ADD_NEW) return '';
    return value;
  }

  async function handleClaimNumberSelectChange(selectElOrId, studentId, studentLabel) {
    const selectEl = typeof selectElOrId === 'string' ? qs(selectElOrId) : selectElOrId;
    if (!selectEl) return;
    const value = String(selectEl.value || '').trim();
    if (value !== CLAIM_NUMBER_ADD_NEW) {
      selectEl.dataset.previousValue = value;
      return;
    }
    const previous = String(selectEl.dataset.previousValue || '').trim();
    selectEl.value = previous;
    const sid = String(studentId || '').trim();
    if (!sid) {
      await showMsg('Claim Number', 'warning', 'Select a student first.');
      return;
    }
    await openRollingStudentClaimNumbersModal({
      studentId: sid,
      studentLabel,
      openEditorOnShow: true,
      onSaved: async (claimNumbers, preferredNumber) => {
        await refreshClaimNumberSelect(selectEl, sid, preferredNumber || previous);
      }
    });
  }

  function hideRollingClaimEditor() {
    rollingClaimEditingId = '';
    qs('rollingClaim_editorPanel')?.classList.add('d-none');
    setRollingClaimAlert('');
  }

  function showRollingClaimEditor(entry = null) {
    const panel = qs('rollingClaim_editorPanel');
    if (!panel) return;
    rollingClaimEditingId = String(entry?.id || '').trim();
    if (qs('rollingClaim_editorTitle')) {
      qs('rollingClaim_editorTitle').textContent = rollingClaimEditingId ? 'Edit Claim Number' : 'New Claim Number';
    }
    if (qs('rollingClaim_number')) qs('rollingClaim_number').value = String(entry?.number || '').trim();
    if (qs('rollingClaim_label')) qs('rollingClaim_label').value = String(entry?.label || '').trim();
    if (qs('rollingClaim_notes')) qs('rollingClaim_notes').value = String(entry?.notes || '').trim();
    if (qs('rollingClaim_isPrimary')) qs('rollingClaim_isPrimary').checked = entry ? entry.isPrimary === true : !rollingClaimNumbers.some((row) => row.isPrimary);
    panel.classList.remove('d-none');
    qs('rollingClaim_number')?.focus();
  }

  function renderRollingClaimList() {
    const emptyEl = qs('rollingClaim_empty');
    const wrapEl = qs('rollingClaim_listWrap');
    const tbody = qs('rollingClaim_tbody');
    if (!tbody || !emptyEl || !wrapEl) return;
    if (!rollingClaimNumbers.length) {
      emptyEl.classList.remove('d-none');
      wrapEl.classList.add('d-none');
      tbody.innerHTML = '';
      return;
    }
    emptyEl.classList.add('d-none');
    wrapEl.classList.remove('d-none');
    tbody.innerHTML = rollingClaimNumbers.map((entry) => {
      const id = String(entry?.id || '').trim();
      const number = String(entry?.number || '').trim();
      const label = String(entry?.label || '').trim();
      const primaryBadge = entry?.isPrimary ? '<span class="badge text-bg-primary-subtle text-primary-emphasis border">Primary</span>' : '<span class="text-muted">—</span>';
      return `
        <tr data-claim-id="${htmlEscape(id)}">
          <td class="font-monospace">${htmlEscape(number)}</td>
          <td>${label ? htmlEscape(label) : '<span class="text-muted">—</span>'}</td>
          <td class="text-center">${primaryBadge}</td>
          <td class="text-end">
            <button type="button" class="btn btn-sm btn-outline-secondary btn-rolling-claim-edit" data-claim-id="${htmlEscape(id)}"><i class="bi bi-pencil"></i></button>
            <button type="button" class="btn btn-sm btn-outline-danger btn-rolling-claim-delete" data-claim-id="${htmlEscape(id)}"><i class="bi bi-trash"></i></button>
          </td>
        </tr>
      `;
    }).join('');
  }

  function applyRollingClaimEditor() {
    const number = String(qs('rollingClaim_number')?.value || '').trim();
    if (!number) {
      setRollingClaimAlert('Claim number is required.');
      return;
    }
    const label = String(qs('rollingClaim_label')?.value || '').trim();
    const notes = String(qs('rollingClaim_notes')?.value || '').trim();
    const isPrimary = qs('rollingClaim_isPrimary')?.checked === true;
    const entry = {
      id: rollingClaimEditingId || `claim_${Date.now()}`,
      number,
      label,
      notes,
      isPrimary
    };
    if (rollingClaimEditingId) {
      rollingClaimNumbers = rollingClaimNumbers.map((row) => (
        String(row.id) === String(rollingClaimEditingId) ? { ...row, ...entry } : row
      ));
    } else {
      rollingClaimNumbers.push(entry);
    }
    if (isPrimary) {
      rollingClaimNumbers = rollingClaimNumbers.map((row) => ({
        ...row,
        isPrimary: String(row.id) === String(entry.id)
      }));
    }
    hideRollingClaimEditor();
    renderRollingClaimList();
  }

  async function saveRollingClaimNumbers(preferredNumber = '') {
    const studentId = String(rollingClaimContext.studentId || '').trim();
    if (!studentId) return null;
    try {
      showBusy('Saving claim numbers...');
      const result = await requestJson(
        `/school/students/api/${encodeURIComponent(studentId)}/claim-numbers`,
        'PUT',
        { claimNumbers: rollingClaimNumbers }
      );
      if (!result) return null;
      rollingClaimNumbers = Array.isArray(result.data?.claimNumbers) ? result.data.claimNumbers : rollingClaimNumbers;
      renderRollingClaimList();
      const chosen = String(preferredNumber || rollingClaimContext.selectAfterSave || '').trim()
        || String(rollingClaimNumbers.find((row) => row.isPrimary)?.number || rollingClaimNumbers[0]?.number || '').trim();
      if (typeof rollingClaimContext.onSaved === 'function') {
        await rollingClaimContext.onSaved(rollingClaimNumbers, chosen);
      }
      return chosen;
    } catch (error) {
      await showMsg('Claim Numbers', 'error', error.message || 'Unable to save claim numbers.');
      return null;
    } finally {
      hideBusy();
    }
  }

  async function openRollingStudentClaimNumbersModal(options = {}) {
    hideRollingStudentContextMenu();
    const studentId = String(options.studentId || '').trim();
    if (!studentId) return;
    if (!canEditStudentClb) {
      await showMsg('Permission', 'warning', 'You do not have permission to manage claim numbers.');
      return;
    }
    rollingClaimContext = {
      studentId,
      studentLabel: String(options.studentLabel || resolveStudentContactContext(studentId).studentLabel || studentId).trim(),
      onSaved: typeof options.onSaved === 'function' ? options.onSaved : null,
      selectAfterSave: String(options.selectAfterSave || '').trim()
    };
    rollingClaimNumbers = [];
    rollingClaimEditingId = '';
    hideRollingClaimEditor();
    setRollingClaimAlert('');
    if (qs('rollingClaim_studentLabel')) qs('rollingClaim_studentLabel').value = rollingClaimContext.studentLabel;
    if (qs('rollingClaim_studentId')) qs('rollingClaim_studentId').value = studentId;
    try {
      showBusy('Loading claim numbers...');
      const result = await requestJson(`/school/students/api/${encodeURIComponent(studentId)}/claim-numbers`);
      if (!result) return;
      rollingClaimNumbers = Array.isArray(result.data?.claimNumbers) ? result.data.claimNumbers : [];
      rollingClaimContext.studentLabel = String(result.data?.studentLabel || rollingClaimContext.studentLabel || studentId).trim();
      if (qs('rollingClaim_studentLabel')) qs('rollingClaim_studentLabel').value = rollingClaimContext.studentLabel;
      renderRollingClaimList();
      mountRollingModalToBody(rollingStudentClaimNumbersModalEl);
      rollingStudentClaimNumbersModal?.show();
      raiseRollingModalAboveStack(rollingStudentClaimNumbersModalEl);
      if (options.openEditorOnShow) showRollingClaimEditor(null);
    } catch (error) {
      await showMsg('Claim Numbers', 'error', error.message || 'Unable to load claim numbers.');
    } finally {
      hideBusy();
    }
  }

