  function readChargeModalDraftContext() {
    const funderFromSelect = resolveFunderSelectionFromSelect('inp_funder');
    const funderId = String(pendingEnrollmentPayload?.funderId || funderFromSelect.funderId || 'self').trim() || 'self';
    const funderType = (!funderId || funderId.toLowerCase() === 'self')
      ? 'self'
      : (String(pendingEnrollmentPayload?.funderType || funderFromSelect.funderType || 'funder').trim() || 'funder');
    return {
      periodId: String(qs('charge_draftPeriodId')?.value || '').trim(),
      startDate: String(qs('charge_startDate')?.value || '').trim(),
      endDate: String(qs('charge_endDate')?.value || '').trim(),
      status: String(qs('charge_status')?.value || 'draft').trim().toLowerCase() || 'draft',
      funderType: funderType === 'self' ? 'self' : 'funder',
      funderId: funderType === 'self' || !funderId ? 'self' : funderId,
      authorizationRef: '',
      reasonStart: String(qs('inp_reasonStart')?.value || pendingEnrollmentPayload?.reasonStart || '').trim(),
      targetSessionCount: String(pendingEnrollmentPayload?.targetSessionCount || '').trim(),
      targetHours: String(pendingEnrollmentPayload?.targetHours || '').trim(),
      sessionCountPolicy: String(pendingEnrollmentPayload?.sessionCountPolicy || 'all_non_na').trim() || 'all_non_na'
    };
