  function startGroupEnrollmentQueueEdit(index) {
    if (!Number.isFinite(index) || index < 0 || index >= groupEnrollmentStudents.length) return;
    groupEnrollmentEditingIndex = index;
    renderGroupEnrollmentStudents();
  }

  function cancelGroupEnrollmentQueueEdit() {
    groupEnrollmentEditingIndex = -1;
    renderGroupEnrollmentStudents();
  }

  async function saveGroupEnrollmentQueueRow(index) {
    const idx = Number(index);
    if (!Number.isFinite(idx) || idx < 0 || idx >= groupEnrollmentStudents.length) return;
    const current = groupEnrollmentStudents[idx];
    const partial = collectGroupEnrollmentEntryFromEditRow(idx);
    if (!partial) return;
    const entry = {
      ...partial,
      id: String(current.id || '').trim(),
      label: String(current.label || current.id || '').trim()
    };
    const validationIssue = validateGroupEnrollmentEntry(entry);
    if (validationIssue) {
      await showMsg('Validation', 'warning', validationIssue);
      return;
    }
    groupEnrollmentStudents[idx] = entry;
    groupEnrollmentEditingIndex = -1;
    renderGroupEnrollmentStudents();
  }

  function renderGroupEnrollmentStudents() {
    const tbody = qs('groupEnrollmentStudentsTbody');
    if (!tbody) return;
    if (!groupEnrollmentStudents.length) {
      groupEnrollmentEditingIndex = -1;
      tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-3">No students queued. Add a student above.</td></tr>';
      syncGroupEnrollmentCompleteButton();
      return;
    }
    if (groupEnrollmentEditingIndex >= groupEnrollmentStudents.length) {
      groupEnrollmentEditingIndex = -1;
    }
    tbody.innerHTML = groupEnrollmentStudents.map((row, index) => {
      const autoResolveLabel = row.autoResolveSubjects
        ? '<span class="badge bg-success-subtle text-success border">On</span>'
        : '<span class="text-muted small">Off</span>';
      const summaryRow = '<tr>'
        + '<td>' + htmlEscape(row.label || row.id) + '</td>'
        + '<td class="small">' + htmlEscape(String(row.startDate || '')) + '</td>'
        + '<td class="small">' + htmlEscape(formatGroupEnrollmentCapSummary(row)) + '</td>'
        + '<td class="small">' + htmlEscape(formatSessionCapacityTypeLabel(row.sessionCapacityType)) + '</td>'
        + '<td class="small">' + htmlEscape(resolveFunderDisplayLabel(row)) + '</td>'
        + '<td class="small">' + htmlEscape(formatPeriodStatusLabel(row.status || 'active')) + '</td>'
        + '<td>' + autoResolveLabel + '</td>'
        + '<td class="text-end">'
        + '<div class="d-inline-flex gap-1">'
        + '<button type="button" class="btn btn-outline-primary btn-sm py-0 px-2" data-group-student-edit="' + String(index) + '" aria-label="Edit student enrollment">'
        + '<i class="bi bi-pencil"></i>'
        + '</button>'
        + '<button type="button" class="btn btn-outline-danger btn-sm py-0 px-2" data-group-student-remove="' + String(index) + '" aria-label="Remove student">'
        + '<i class="bi bi-x-lg"></i>'
        + '</button>'
        + '</div>'
        + '</td>'
        + '</tr>';
      const editRow = groupEnrollmentEditingIndex === index
        ? buildGroupEnrollmentEditRowHtml(row, index)
        : '';
      return summaryRow + editRow;
    }).join('');
    tbody.querySelectorAll('[data-group-student-edit]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = Number(btn.getAttribute('data-group-student-edit'));
        startGroupEnrollmentQueueEdit(idx);
      });
    });
    tbody.querySelectorAll('[data-group-student-remove]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = Number(btn.getAttribute('data-group-student-remove'));
        if (!Number.isFinite(idx) || idx < 0 || idx >= groupEnrollmentStudents.length) return;
        if (groupEnrollmentEditingIndex === idx) {
          groupEnrollmentEditingIndex = -1;
        } else if (groupEnrollmentEditingIndex > idx) {
          groupEnrollmentEditingIndex -= 1;
        }
        groupEnrollmentStudents.splice(idx, 1);
        renderGroupEnrollmentStudents();
      });
    });
    tbody.querySelectorAll('[data-group-queue-save]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = Number(btn.getAttribute('data-group-queue-save'));
        saveGroupEnrollmentQueueRow(idx);
      });
    });
    tbody.querySelectorAll('[data-group-queue-cancel]').forEach((btn) => {
      btn.addEventListener('click', () => cancelGroupEnrollmentQueueEdit());
    });
    tbody.querySelectorAll('[data-group-edit-field="targetSessionCount"]').forEach((input) => {
      input.addEventListener('input', () => {
        const container = input.closest('[data-group-edit-row]');
        const idx = Number(container?.getAttribute('data-group-edit-row'));
        if (Number.isFinite(idx)) applyGroupQueueEditCapMutualExclusion(idx, 'targetSessionCount');
      });
    });
    tbody.querySelectorAll('[data-group-edit-field="targetHours"]').forEach((input) => {
      input.addEventListener('input', () => {
        const container = input.closest('[data-group-edit-row]');
        const idx = Number(container?.getAttribute('data-group-edit-row'));
        if (Number.isFinite(idx)) applyGroupQueueEditCapMutualExclusion(idx, 'targetHours');
      });
    });
    syncGroupEnrollmentCompleteButton();
  }

  function clearGroupEnrollmentEntryStudent() {
    if (qs('grp_studentId')) qs('grp_studentId').value = '';
    if (qs('grp_studentLabel')) qs('grp_studentLabel').value = '';
    populateClaimNumberSelectOptions(qs('grp_claimNumber'), [], '');
