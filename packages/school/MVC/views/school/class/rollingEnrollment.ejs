<div class="modal fade" id="groupEnrollmentModal" tabindex="-1" aria-labelledby="groupEnrollmentModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="groupEnrollmentModalLabel"><i class="bi bi-people-fill me-1"></i>Group Enrollment</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="border rounded bg-light-subtle p-3 mb-3">
          <div class="fw-semibold small text-primary mb-2">Add student to enrollment list</div>
          <input type="hidden" id="grp_studentId">
          <div class="mb-2">
            <label class="form-label" for="grp_studentLabel">Student *</label>
            <div class="input-group">
              <input type="text" id="grp_studentLabel" class="form-control bg-white" placeholder="Type at least 2 characters to search students..." autocomplete="off">
              <button type="button" class="btn btn-outline-primary" id="btn_pickGroupEntryStudent" aria-label="Pick student"><i class="bi bi-person-vcard"></i></button>
            </div>
          </div>
          <div class="row g-2 enroll-cap-inputs-row">
            <div class="col-lg-3 col-md-6">
              <label class="form-label" for="grp_startDate">Start Date *</label>
              <input type="date" id="grp_startDate" class="form-control"<% if (cycleStartDate) { %> min="<%= cycleStartDate %>"<% } %><% if (cycleEndDate) { %> max="<%= cycleEndDate %>"<% } %>>
            </div>
            <div class="col-lg-3 col-md-6">
              <label class="form-label" for="grp_endDate">End Date</label>
              <input type="date" id="grp_endDate" class="form-control"<% if (cycleStartDate) { %> min="<%= cycleStartDate %>"<% } %>>
            </div>
            <div class="col-lg-3 col-md-6">
              <label class="form-label" for="grp_targetSessionCount">Number of Sessions <span class="text-muted fw-normal">(optional)</span></label>
              <input type="number" id="grp_targetSessionCount" class="form-control" min="1" step="1" placeholder="e.g. 10">
            </div>
            <div class="col-lg-3 col-md-6">
              <label class="form-label" for="grp_targetHours">Number of Hours <span class="text-muted fw-normal">(optional)</span></label>
              <input type="number" id="grp_targetHours" class="form-control" min="0.25" step="0.25" placeholder="e.g. 20">
            </div>
          </div>
          <div class="row g-1 mt-1 enroll-cap-hints-row">
            <div class="col-lg-3 col-md-6 d-none d-lg-block"></div>
            <div class="col-lg-3 col-md-6">
              <div class="form-text compact-help mb-0" id="grp_hint_endDate">Used with start date when no session or hour target is set.</div>
            </div>
            <div class="col-lg-3 col-md-6">
              <div class="form-text compact-help mb-0">Count sessions until target is reached. Cannot be combined with hour target.</div>
            </div>
            <div class="col-lg-3 col-md-6">
              <div class="form-text compact-help mb-0">Allocate sessions by total hours. Cannot be combined with session target.</div>
            </div>
          </div>
          <div class="row g-2 mt-2 align-items-start enroll-meta-inputs-row">
            <div class="col-md-3">
              <label class="form-label" for="grp_funder">Funder</label>
              <select id="grp_funder" class="form-select">
                <option value="self" selected>Self Fund</option>
                <% (Array.isArray(funderOptions) ? funderOptions : []).forEach((funder) => { %>
                <option value="<%= String(funder.id || '') %>"><%= String(funder.label || funder.id || '') %></option>
                <% }); %>
              </select>
            </div>
            <div class="col-md-2">
              <label class="form-label" for="grp_status">Status</label>
              <select id="grp_status" class="form-select">
                <option value="active" selected>Active</option>
                <option value="to_be_confirmed">To be Confirmed</option>
                <option value="waiting_list">Waiting list</option>
              </select>
            </div>
            <div class="col-md-2">
              <label class="form-label" for="grp_sessionCapacityType">Session Capacity</label>
              <select id="grp_sessionCapacityType" class="form-select">
                <option value="group" selected>Group</option>
                <option value="one_on_one">1 On 1</option>
              </select>
            </div>
            <div class="col-md-2">
              <label class="form-label" for="grp_claimNumber">Claim Number</label>
              <select id="grp_claimNumber" class="form-select">
                <option value="">— None —</option>
                <option value="__add_new__">+ Add New...</option>
              </select>
            </div>
            <div class="col-md-3">
              <label class="form-label" for="grp_reasonStart">Reason Start</label>
              <textarea id="grp_reasonStart" class="form-control" rows="2" placeholder="Optional start note"></textarea>
            </div>
          </div>
          <div class="form-check mt-2">
            <input class="form-check-input" type="checkbox" value="1" id="grp_autoResolveSubjects">
            <label class="form-check-label" for="grp_autoResolveSubjects">Auto Resolve the Subjects</label>
          </div>
          <div class="form-text compact-help mb-2">When enabled, applies CLB placement prior credits for missing prerequisites covered by the student&apos;s Current CLB levels, then enrolls if prerequisites are satisfied.</div>
          <button type="button" class="btn btn-outline-primary btn-sm" id="btn_addGroupEnrollmentEntry">
            <i class="bi bi-plus-circle me-1"></i>Add to List
          </button>
        </div>
        <div class="mb-0">
          <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
            <label class="form-label mb-0">Queued students</label>
            <span class="small text-muted" id="groupEnrollmentQueueCount">0 students</span>
          </div>
          <div class="table-responsive border rounded">
            <table class="table table-sm align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Student</th>
                  <th>Start</th>
                  <th>Target</th>
                  <th>Capacity</th>
                  <th>Funder</th>
                  <th>Status</th>
                  <th>Auto Resolve</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody id="groupEnrollmentStudentsTbody">
                <tr><td colspan="8" class="text-center text-muted py-3">No students queued. Add a student above.</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-filled btn-primary btn-sm" id="btn_completeGroupEnrollment">
          <i class="bi bi-check2-circle me-1"></i>Complete Enrollment
        </button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="groupEnrollmentResultsModal" tabindex="-1" aria-labelledby="groupEnrollmentResultsModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
