  function normalizeMoveDateValue(value) {
    const token = String(value || '').trim();
    if (!token) return '';
    if (/^\d{4}-\d{2}-\d{2}$/.test(token)) return token;
    const parsed = new Date(token);
    if (Number.isNaN(parsed.getTime())) return '';
    return parsed.toISOString().slice(0, 10);
  }

  function resolveMoveSourceEndDate(row = {}) {
    const explicitEndDate = normalizeMoveDateValue(row?.endDate);
    if (explicitEndDate) return explicitEndDate;
    const completionDate = normalizeMoveDateValue(row?.sessionCompletion?.date || row?.completionDate);
    const hasEnrollmentTarget = normalizeTargetSessionCountValue(row?.targetSessionCount) > 0
      || normalizeTargetHoursValue(row?.targetHours) > 0;
    return hasEnrollmentTarget ? '' : completionDate;
  }

  function buildMoveCloseReason(targetClassTitle, userReason = '') {
    const target = String(targetClassTitle || '').trim();
    const reason = String(userReason || '').trim();
    if (target && reason) return `Moved to ${target}: ${reason}`;
    if (target) return `Moved to ${target}`;
    return reason;
  }

  function extractMoveCloseUserReason(value = '') {
    const reason = String(value || '').trim();
    const match = reason.match(/^Moved to [^:]+:\s*(.*)$/i);
    if (match) return String(match[1] || '').trim();
    if (/^Moved to /i.test(reason)) return '';
    return reason;
  }

  function inferMoveTargetEnrollmentMode(classItem = {}) {
    const hours = normalizeTargetHoursValue(classItem.defaultTargetHours || classItem.targetHours);
    const sessions = normalizeTargetSessionCountValue(classItem.defaultTargetSessionCount || classItem.targetSessionCount);
    if (hours > 0) return 'hour_cap';
    if (sessions > 0) return 'session_cap';
    return 'date_window';
  }

  function clearMoveTargetClassPicker() {
    moveTargetClassMeta = null;
    if (qs('move_targetClassId')) qs('move_targetClassId').value = '';
    if (qs('move_targetClassLabel')) qs('move_targetClassLabel').value = '';
    syncMoveTargetClassFields();
  }

  function syncMoveCloseReasonWithTarget(targetClassTitle) {
    const input = qs('move_close_reason');
    if (!input) return;
    input.value = buildMoveCloseReason(targetClassTitle, extractMoveCloseUserReason(input.value));
  }

  function readMoveEnrollmentPayload() {
    const funder = resolveFunderSelectionFromSelect('move_funder');
    const targetClassTitle = String(qs('move_targetClassLabel')?.value || '').trim();
    const userCloseReason = extractMoveCloseUserReason(qs('move_close_reason')?.value);
    const sessionCount = normalizeTargetSessionCountValue(qs('move_targetSessionCount')?.value);
    const targetHours = normalizeTargetHoursValue(qs('move_targetHours')?.value);
    return {
      close: {
        effectiveDate: String(qs('move_close_endDate')?.value || '').trim(),
        targetStatus: 'completed',
        reason: buildMoveCloseReason(targetClassTitle, userCloseReason)
      },
      target: {
        classId: String(qs('move_targetClassId')?.value || '').trim(),
        studentId: String(qs('move_studentId')?.value || '').trim(),
        startDate: String(qs('move_startDate')?.value || '').trim(),
        endDate: String(qs('move_endDate')?.value || '').trim(),
        targetSessionCount: sessionCount,
        targetHours,
        funder,
        reasonStart: String(qs('move_reasonStart')?.value || '').trim(),
        notes: String(qs('move_notes')?.value || '').trim(),
        status: String(qs('move_status')?.value || 'active').trim().toLowerCase() || 'active',
        sessionCapacityType: readSessionCapacityTypeFromSelect('move_sessionCapacityType'),
        claimNumber: readClaimNumberSelectValue('move_claimNumber'),
        sessionCountPolicy: String(moveSourcePeriodRow?.sessionCountPolicy || 'all_non_na').trim() || 'all_non_na'
      }
    };
  }

  function syncMoveTargetClassFields() {
    const meta = moveTargetClassMeta;
    const mode = String(meta?.enrollmentMode || 'date_window').trim().toLowerCase();
    const sessionWrap = qs('wrap_move_targetSessionCount');
    const hoursWrap = qs('wrap_move_targetHours');
    const hasTarget = Boolean(String(meta?.id || qs('move_targetClassId')?.value || '').trim());
    if (!hasTarget) {
      sessionWrap?.classList.add('d-none');
      hoursWrap?.classList.add('d-none');
      return;
    }
    if (mode === 'session_cap') {
      sessionWrap?.classList.remove('d-none');
      hoursWrap?.classList.add('d-none');
    } else if (mode === 'hour_cap') {
      sessionWrap?.classList.add('d-none');
      hoursWrap?.classList.remove('d-none');
    } else {
      sessionWrap?.classList.remove('d-none');
      hoursWrap?.classList.remove('d-none');
    }
    resetMovePreviewState();
  }

  async function syncMoveTargetClassFromPicker(item) {
    const nextId = String(item?.id || '').trim();
    const nextTitle = String(item?.title || item?.label || nextId).trim();
    const studentId = String(qs('move_studentId')?.value || '').trim();
    if (!nextId) return;
    if (nextId === String(classId || '').trim()) {
      clearMoveTargetClassPicker();
      await showMsg('Invalid Target', 'warning', 'Target class must be different from the current class.');
      return;
    }
    if (item?.isClosedForNewEnrollment === true || String(item?.isClosedForNewEnrollment || '').trim().toLowerCase() === 'true') {
      clearMoveTargetClassPicker();
      await showMsg('Target Closed', 'warning', 'That class cycle is closed for new enrollment.');
      return;
    }
    if (String(item?.registrationMode || '').trim().toLowerCase() !== 'rolling') {
      clearMoveTargetClassPicker();
      await showMsg('Invalid Target', 'warning', 'Target class must use rolling enrollment.');
      return;
    }
    qs('move_targetClassId').value = nextId;
    if (qs('move_targetClassLabel')) qs('move_targetClassLabel').value = nextTitle;
    moveTargetClassMeta = {
      id: nextId,
      title: nextTitle,
      enrollmentMode: inferMoveTargetEnrollmentMode(item),
      isChargeable: String(item?.billingMode || '').trim().toLowerCase() === 'chargeable'
    };
    syncMoveCloseReasonWithTarget(nextTitle);
    syncMoveTargetClassFields();
  }

  async function openMoveTargetClassPicker() {
    if (!window.GenericPicker || !window.GenericPickerPresets) {
      await showMsg('Picker Unavailable', 'warning', 'Class picker is not loaded on this page.');
      return;
    }
    if (isGenericPickerOpen()) return;
    const sourceClassId = String(classId || '').trim();
    GenericPicker.open(GenericPickerPresets.class({
      title: 'Select target class',
      icon: 'bi-book',
      placeholder: 'Search rolling classes...',
      searchFields: 'id,title,status,registrationMode,deliveryDepartmentName',
      context: (window.GenericPickerContexts && typeof window.GenericPickerContexts.activeOrganizationScope === 'function')
        ? window.GenericPickerContexts.activeOrganizationScope({ label: 'Active Organization' })
        : undefined,
      itemFilter: (item) => {
        const itemId = String(item?.id || '').trim();
        if (!itemId || itemId === sourceClassId) return false;
        return String(item?.registrationMode || '').trim().toLowerCase() === 'rolling';
      },
      onSelect: (item) => {
        syncMoveTargetClassFromPicker(item);
      }
    }));
  }

  async function openMoveEnrollmentModal(periodId) {
    const row = (Array.isArray(periodRows) ? periodRows : []).find((item) => String(item?.id || '') === String(periodId || ''));
    if (!row || !moveEnrollmentModal) return;
    resetMovePreviewState();
    moveSourcePeriodRow = row;
    const studentDisplay = resolveStudentRowDisplay(row);
    const sourceEndDate = resolveMoveSourceEndDate(row);
    const closeDateDefault = sourceEndDate || orgTodayFallback();
    const allowedStatuses = ['active', 'to_be_confirmed', 'waiting_list'];
    const rowStatus = String(row.status || '').trim().toLowerCase();
    qs('move_periodId').value = String(row.id || '');
    qs('move_studentId').value = String(row.studentId || '');
    qs('move_studentLabel').textContent = studentDisplay?.label || String(row.studentId || '');
    qs('move_sourceClassLabel').textContent = `Current class: ${String(rollingClassData?.title || classId || '').trim()}`;
    qs('move_sourcePeriodLabel').textContent = `Period ${String(row.startDate || '')}${row.endDate ? ' to ' + String(row.endDate) : ''} (${formatPeriodStatusLabel(row.status)})`;
    qs('move_close_endDate').value = closeDateDefault;
    qs('move_close_reason').value = '';
    qs('move_startDate').value = closeDateDefault;
    qs('move_endDate').value = sourceEndDate;
    const sessionCount = normalizeTargetSessionCountValue(row?.targetSessionCount);
    const hourCount = normalizeTargetHoursValue(row?.targetHours);
    qs('move_targetSessionCount').value = sessionCount > 0 ? String(sessionCount) : '';
    qs('move_targetHours').value = hourCount > 0 ? String(hourCount) : '';
    qs('move_reasonStart').value = `Moved from ${String(rollingClassData?.title || classId || '').trim()}.`;
    qs('move_notes').value = '';
    setFunderSelectValue('move_funder', {
      funderId: String(row?.funderId || 'self').trim() || 'self',
      funderType: String(row?.funderType || 'self').trim() || 'self'
    });
    if (qs('move_status')) {
      qs('move_status').value = allowedStatuses.includes(rowStatus) ? rowStatus : 'active';
    }
    setSessionCapacitySelectValue('move_sessionCapacityType', row?.sessionCapacityType || 'group');
    clearMoveTargetClassPicker();
    await refreshClaimNumberSelect('move_claimNumber', row.studentId, String(row?.claimNumber || '').trim());
    moveEnrollmentModal.show();
  }

  function formatMoveScheduleConflictLines(conflicts = []) {
    return (Array.isArray(conflicts) ? conflicts : []).slice(0, 5).map((row) => {
      const date = String(row?.date || '').trim();
      const conflictClass = String(row?.conflictClass || 'Class session').trim();
      const existTime = String(row?.existTime || '').trim();
      return `${date}: overlaps ${conflictClass}${existTime ? ` (${existTime})` : ''}`;
    });
  }

  function renderMovePreviewPanel(preview) {
    const panel = qs('move_previewPanel');
    if (!panel) return;
    const lines = Array.isArray(preview?.summaryLines) ? preview.summaryLines : [];
    const blockers = Array.isArray(preview?.blockers) ? preview.blockers : [];
    const warnings = Array.isArray(preview?.warnings) ? preview.warnings : [];
    const scheduleConflicts = Array.isArray(preview?.scheduleConflicts?.conflicts)
      ? preview.scheduleConflicts.conflicts
      : (Array.isArray(preview?.targetEnrollmentPreview?.scheduleConflicts?.conflicts)
        ? preview.targetEnrollmentPreview.scheduleConflicts.conflicts
        : []);
    const conflictLines = formatMoveScheduleConflictLines(scheduleConflicts);
    if (preview?.canApply) {
      panel.className = 'alert alert-info mb-0';
      panel.innerHTML = [
        '<div class="fw-semibold mb-1">Ready to apply</div>',
        ...lines.map((line) => `<div>${htmlEscape(line)}</div>`),
        warnings.length ? `<div class="small mt-2">${warnings.map((row) => formatRichServerMessageHtml(row.message || '')).join('<br>')}</div>` : ''
      ].join('');
      return;
    }
    panel.className = 'alert alert-warning mb-0';
    panel.innerHTML = [
      '<div class="fw-semibold mb-1">Preview blocked</div>',
      ...blockers.map((row) => `<div>${formatRichServerMessageHtml(row.message || 'Unable to preview move.')}</div>`),
      conflictLines.length ? `<div class="small mt-2">${conflictLines.map((line) => htmlEscape(line)).join('<br>')}</div>` : ''
    ].join('');
  }

  async function previewMoveEnrollmentAction() {
    const periodId = String(qs('move_periodId')?.value || '').trim();
    const payload = readMoveEnrollmentPayload();
    if (!periodId || !payload.close.effectiveDate || !payload.close.reason || !payload.target.classId || !payload.target.startDate || !payload.target.reasonStart) {
      await showMsg('Missing Fields', 'warning', 'Complete all required close and target enrollment fields before previewing.');
      return;
    }
    try {
      showBusy('Previewing enrollment move...');
      const result = await requestJson(`/school/classes/api/enrollment-periods/${encodeURIComponent(periodId)}/move/preview`, 'POST', payload);
      if (!result) return;
      const preview = result.preview || {};
      renderMovePreviewPanel(preview);
      if (preview.canApply) {
        approvedMovePayload = payload;
        approvedMovePreviewHash = String(preview.previewHash || '').trim();
        qs('btn_applyMoveEnrollment').disabled = !approvedMovePreviewHash;
      } else {
        resetMovePreviewState();
      }
    } catch (error) {
      resetMovePreviewState();
      renderMovePreviewPanel(error.preview || { canApply: false, blockers: [{ message: error.message || 'Unable to preview move.' }] });
      await showMsg('Preview failed', 'error', error.message || 'Unable to preview enrollment move.');
    } finally {
      hideBusy();
    }
  }

  async function applyMoveEnrollmentAction() {
    const periodId = String(qs('move_periodId')?.value || '').trim();
    const payload = readMoveEnrollmentPayload();
    if (!periodId) {
      await showMsg('Missing Period', 'warning', 'Enrollment period is required.');
      return;
    }
    if (!approvedMovePayload || !approvedMovePreviewHash || JSON.stringify(payload) !== JSON.stringify(approvedMovePayload)) {
      await showMsg('Preview Required', 'warning', 'Preview the current move details before applying.');
      resetMovePreviewState();
      return;
    }
    const confirmed = await showConfirm('Apply this enrollment move?', 'Move Enrollment', {
      confirmText: 'Apply Move',
      confirmClass: 'btn-primary'
    });
    if (!confirmed) return;
    try {
      showBusy('Applying enrollment move...');
      const result = await requestJson(`/school/classes/api/enrollment-periods/${encodeURIComponent(periodId)}/move/apply`, 'POST', {
        ...payload,
        previewHash: approvedMovePreviewHash
      });
      if (!result) return;
      moveEnrollmentModal.hide();
      await loadRows();
      if (result.requiresDraftReview && result.targetPeriod?.id) {
        await showMsg('Move Applied', 'success', result.message || 'Enrollment moved. Review draft charges for the new class enrollment.');
        openDraftReviewModal(result.targetPeriod.id);
        return;
      }
      await showMsg('Move Applied', 'success', result.message || 'Enrollment moved successfully.');
    } catch (error) {
      await showMsg('Move Failed', 'error', error.message || 'Unable to apply enrollment move.');
      resetMovePreviewState();
    } finally {
      hideBusy();
    }
  }

