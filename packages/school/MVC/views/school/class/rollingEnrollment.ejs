  function dockRowActionsMenu(menu) {
    if (!menu || menu.parentElement !== document.body) return;
    const wrap = findWrapByPeriodId(menu.getAttribute('data-period-id'));
    if (wrap) wrap.appendChild(menu);
  }

  function resetFloatingMenuStyles(menu) {
    if (!menu) return;
    menu.classList.remove('rolling-row-actions-menu--floating');
    menu.style.left = '';
    menu.style.top = '';
    menu.style.right = '';
    menu.style.visibility = '';
    menu.style.position = '';
  }

  function placeFloatingRowMenu(menu, wrap) {
    if (!menu || !wrap) return;
    const rect = wrap.getBoundingClientRect();
    const zoomRaw = Number.parseFloat(document.body?.dataset?.appZoom || '');
    const zoom = Number.isFinite(zoomRaw) && zoomRaw > 0 ? zoomRaw : 1;
    const viewportWidth = window.innerWidth / zoom;
    const viewportHeight = window.innerHeight / zoom;
    const rectTop = rect.top / zoom;
    const rectRight = rect.right / zoom;
    const rectBottom = rect.bottom / zoom;
    menu.classList.add('rolling-row-actions-menu--floating');
    menu.style.visibility = 'hidden';
    menu.style.position = 'fixed';
    menu.style.left = '0';
    menu.style.top = '0';
    const mw = Math.max(menu.offsetWidth || 0, 148);
    const mh = menu.offsetHeight || 0;
    let left = rectRight - mw;
    left = Math.max(8, Math.min(left, viewportWidth - mw - 8));
    const gap = 4;
    let top = rectBottom + gap;
    if (mh > 0 && top + mh > viewportHeight - 8) {
      top = Math.max(8, rectTop - mh - gap);
    }
    if (mh > 0 && top + mh > viewportHeight - 8) {
      top = Math.max(8, viewportHeight - mh - 8);
    }
    if (mw > 0 && left + mw > viewportWidth - 8) {
      left = Math.max(8, viewportWidth - mw - 8);
    }
    menu.style.left = `${Math.round(left)}px`;
    menu.style.top = `${Math.round(top)}px`;
    menu.style.visibility = '';
  }

  function repositionOpenRowActionMenu() {
    const menu = document.querySelector('.rolling-row-actions-menu.rolling-row-actions-menu--floating:not(.d-none)');
    if (!menu) return;
    const wrap = findWrapByPeriodId(menu.getAttribute('data-period-id'));
    if (wrap) placeFloatingRowMenu(menu, wrap);
  }

  function closeAllActionMenus() {
    document.querySelectorAll('.rolling-row-actions-menu').forEach((menu) => {
      menu.classList.add('d-none');
      resetFloatingMenuStyles(menu);
      dockRowActionsMenu(menu);
    });
  }

  window.addEventListener('scroll', repositionOpenRowActionMenu, true);
  window.addEventListener('resize', repositionOpenRowActionMenu);
  document.querySelector('.rolling-enrollment-page .table-scroll-wrapper')?.addEventListener('scroll', repositionOpenRowActionMenu, { passive: true });

  let enrollmentAttendanceReportPeriodId = '';
  let enrollmentAttendanceReportPayload = null;

  function formatAttendanceReportDisplayDate(iso) {
    const token = String(iso || '').trim();
    if (!token || token === '-') return '-';
    if (!/^\d{4}-\d{2}-\d{2}$/.test(token)) return token;
    const parts = token.split('-').map(Number);
    const dt = new Date(parts[0], parts[1] - 1, parts[2]);
    if (Number.isNaN(dt.getTime())) return token;
    return dt.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
  }

  function formatAttendanceReportMinutes(value) {
    const minutes = Number(value || 0);
    if (!Number.isFinite(minutes) || minutes <= 0) return '';
    return `${minutes} min total`;
  }

  function formatAttendanceReportMetricValue(count) {
    return String(Number(count || 0));
  }

  function formatAttendanceReportMetricSub(count, minutes) {
    const sessionCount = Number(count || 0);
    const minuteTotal = Number(minutes || 0);
    if (sessionCount <= 0 || minuteTotal <= 0) return '';
    return formatAttendanceReportMinutes(minuteTotal);
  }

  function setEnrollmentAttendanceReportLoading(isLoading) {
    qs('enrollmentAttendanceReportLoading')?.classList.toggle('d-none', !isLoading);
    if (isLoading) {
      qs('enrollmentAttendanceReportContent')?.classList.add('d-none');
      qs('enrollmentAttendanceReportEmpty')?.classList.add('d-none');
    }
  }

  function renderEnrollmentAttendanceReport(payload = {}) {
    const summary = payload?.summary && typeof payload.summary === 'object' ? payload.summary : {};
    const period = payload?.period && typeof payload.period === 'object' ? payload.period : {};
    const shortcuts = payload?.shortcuts && typeof payload.shortcuts === 'object' ? payload.shortcuts : {};
    const studentLabel = String(payload?.studentLabel || '').trim() || '-';
    const startDate = String(period.startDate || '').trim();
    const endDate = String(period.endDate || '').trim();
    const reportDate = String(payload?.reportDate || '').trim();

    const studentLabelEl = qs('enrollmentAttendanceReportStudentLabel');
    const startDateEl = qs('enrollmentAttendanceReportStartDate');
    const reportDateEl = qs('enrollmentAttendanceReportReportDate');
    const enrollmentMetaEl = qs('enrollmentAttendanceReportEnrollmentMeta');
    if (studentLabelEl) studentLabelEl.textContent = studentLabel;
    if (startDateEl) startDateEl.textContent = formatAttendanceReportDisplayDate(startDate || '-');
    if (reportDateEl) reportDateEl.textContent = formatAttendanceReportDisplayDate(reportDate || '-');
    if (enrollmentMetaEl) {
      if (endDate) {
        enrollmentMetaEl.textContent = `Enrollment ends ${formatAttendanceReportDisplayDate(endDate)}`;
      } else if (Number(shortcuts.targetSessionCount || 0) > 0) {
        enrollmentMetaEl.textContent = `Target: ${Number(shortcuts.targetSessionCount)} session${Number(shortcuts.targetSessionCount) === 1 ? '' : 's'}`;
      } else if (Number(shortcuts.targetHours || 0) > 0) {
        enrollmentMetaEl.textContent = `Target: ${Number(shortcuts.targetHours)} hour${Number(shortcuts.targetHours) === 1 ? '' : 's'}`;
      } else {
        enrollmentMetaEl.textContent = 'Open enrollment';
      }
    }
    if (qs('enrollmentAttendanceReportDate') && reportDate) {
      qs('enrollmentAttendanceReportDate').value = reportDate;
    }

    const endDateBtn = qs('btn_usePeriodEndDateAttendanceReport');
    const targetSessionsBadge = qs('badge_attendanceReportTargetSessions');
    const targetHoursBadge = qs('badge_attendanceReportTargetHours');
    if (endDateBtn) {
      endDateBtn.classList.toggle('d-none', !shortcuts.hasEndDate || !shortcuts.endDate);
      endDateBtn.dataset.endDate = String(shortcuts.endDate || '');
    }
    if (targetSessionsBadge) {
      const targetSessions = Number(shortcuts.targetSessionCount || 0);
      const showTargetSessions = !shortcuts.hasEndDate && targetSessions > 0;
      targetSessionsBadge.classList.toggle('d-none', !showTargetSessions);
      if (showTargetSessions) targetSessionsBadge.textContent = `Target: ${targetSessions} session${targetSessions === 1 ? '' : 's'}`;
    }
    if (targetHoursBadge) {
      const targetHours = Number(shortcuts.targetHours || 0);
      const showTargetHours = !shortcuts.hasEndDate && Number(shortcuts.targetSessionCount || 0) <= 0 && targetHours > 0;
      targetHoursBadge.classList.toggle('d-none', !showTargetHours);
      if (showTargetHours) targetHoursBadge.textContent = `Target: ${targetHours} hour${targetHours === 1 ? '' : 's'}`;
    }

    const totalSessions = Number(summary.totalSessionsToDate || 0);
    const unmarkedSessions = Number(summary.unmarkedSessions || 0);
    const hasSessions = totalSessions > 0 || Number(summary.notApplicableSessions || 0) > 0;
    qs('enrollmentAttendanceReportContent')?.classList.toggle('d-none', !hasSessions);
    qs('enrollmentAttendanceReportEmpty')?.classList.toggle('d-none', hasSessions);
    document.querySelector('.attendance-report-metric-unmarked')?.classList.toggle('d-none', unmarkedSessions <= 0);

    const setText = (id, value) => {
      const el = qs(id);
      if (el) el.textContent = String(value);
    };
    const setSub = (id, value) => {
      const el = qs(id);
      if (!el) return;
      const text = String(value || '').trim();
      el.textContent = text;
      el.classList.toggle('d-none', !text);
    };
    const setExcused = (wrapId, countId, subId, count, minutes) => {
      const wrapEl = qs(wrapId);
      const countEl = qs(countId);
      const excusedCount = Number(count || 0);
      if (countEl) countEl.textContent = formatAttendanceReportMetricValue(excusedCount);
      if (wrapEl) wrapEl.classList.toggle('d-none', excusedCount <= 0);
      const subText = formatAttendanceReportMetricSub(excusedCount, minutes);
      const subEl = qs(subId);
      if (subEl) {
        subEl.textContent = subText ? ` (${subText})` : '';
        subEl.classList.toggle('d-none', !subText);
      }
    };
    setText('attendanceReport_totalSessions', totalSessions);
    setText('attendanceReport_unmarked', unmarkedSessions);
    setText('attendanceReport_present', Number(summary.presentOnly || 0));
    setText('attendanceReport_absent', Number(summary.absent || 0));
    setText('attendanceReport_absentExcused', Number(summary.absentExcused || 0));
    setText('attendanceReport_late', formatAttendanceReportMetricValue(summary.lateSessions));
    setSub('attendanceReport_lateSub', formatAttendanceReportMetricSub(summary.lateSessions, summary.lateMinutes));
    setExcused('attendanceReport_lateExcusedWrap', 'attendanceReport_lateExcused', 'attendanceReport_lateExcusedSub', summary.lateExcusedSessions, summary.lateExcusedMinutes);
    setText('attendanceReport_earlyLeave', formatAttendanceReportMetricValue(summary.earlyLeaveSessions));
    setSub('attendanceReport_earlyLeaveSub', formatAttendanceReportMetricSub(summary.earlyLeaveSessions, summary.earlyLeaveMinutes));
    setExcused('attendanceReport_earlyLeaveExcusedWrap', 'attendanceReport_earlyLeaveExcused', 'attendanceReport_earlyLeaveExcusedSub', summary.earlyLeaveExcusedSessions, summary.earlyLeaveExcusedMinutes);
    setText('attendanceReport_acf', Number(summary.acf || 0));
    setText('attendanceReport_acfExcused', Number(summary.acfExcused || 0));
    setText('attendanceReport_na', Number(summary.notApplicableSessions || 0));

    const naReasons = Array.isArray(payload?.naReasons) ? payload.naReasons : [];
    const viewReasonsBtn = qs('btn_viewAttendanceReportNaReasons');
    if (viewReasonsBtn) {
      viewReasonsBtn.classList.toggle('d-none', naReasons.length === 0);
      viewReasonsBtn.disabled = naReasons.length === 0;
    }
  }

