<%- include('partials/tablePages-start', {
  title,
  newUrl,
  newLabel,
  user,
  tableName,
  btn_export: true,
  print,
  headerManageBtns: [
    '<a href="' + schoolSectionDashboardHref + '" class="school-navigator-dashboard btn btn-filled btn-secondary btn-md mb-2"><i class="bi bi-speedometer2 me-1"></i> School Dashboard</a>',
    '<a href="/dashboard/section-nav/SCHOOL_ACADEMIA" class="school-navigator-dashboard btn btn-filled btn-secondary btn-md mb-2"><i class="bi bi-backpack2 me-1"></i> School Academia</a>',
    '<a href="/school/classes" class="btn btn-filled btn-secondary btn-md mb-2"><i class="bi bi-easel-fill me-1"></i> Classes</a>'
  ]
}) %>

<%- include('partials/tablePages-search', {
  placeholder: 'Search class templates...',
  fields: [
    { name: 'status', label: 'Status', type: 'select', options: ['draft', 'active', 'archived'] }
  ]
}) %>

<div class="table-scroll-wrapper" data-floating-row-actions="true">
  <table class="table-responsive size-md" id="first-table">
    <thead>
      <tr>
        <th class="ps-4">Code / Name</th>
        <th>Title Pattern</th>
        <th class="text-center">Status</th>
        <th class="text-end pe-4">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (!data.length) { %>
        <tr><td colspan="4" class="text-center py-4 text-muted">No class definition templates found.</td></tr>
      <% } %>
      <% data.forEach(item => { %>
        <tr>
          <td class="ps-4">
            <div class="fw-bold text-primary"><%= item.code %></div>
            <div class="small text-dark"><%= item.name %></div>
            <div class="x-small text-muted font-monospace"><%= item.id %></div>
          </td>
          <td class="font-monospace small"><%= item.titlePattern || '-' %></td>
          <td class="text-center">
            <%
              let badge = 'bg-secondary';
              if (item.status === 'active') badge = 'bg-success';
              if (item.status === 'draft') badge = 'bg-warning text-dark';
              if (item.status === 'archived') badge = 'bg-danger';
            %>
            <span class="badge <%= badge %>"><%= (item.status || 'unknown').toUpperCase() %></span>
          </td>
          <td class="table-actions text-end pe-4">
            <div class="row-actions-wrap">
              <button
                type="button"
                class="btn btn-secondary btn-sm btn-row-actions-toggle"
                data-row-actions-id="<%= item.id %>"
                title="Template Actions">
                <i class="bi bi-three-dots-vertical"></i>
              </button>
              <div class="row-actions-menu d-none" data-row-actions-id="<%= item.id %>">
                <a href="/school/class-templates/edit/<%= item.id %>" class="btn btn-outline-primary btn-sm">
                  <i class="bi bi-pencil-square me-2"></i>Edit
                </a>
                <button class="btn btn-outline-danger btn-sm delete-btn" data-id="<%= item.id %>">
                  <i class="bi bi-trash me-2"></i>Delete
                </button>
              </div>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<span id="urlRef" data-id="school/class-templates" hidden></span>
<%- include('partials/pagination', { pagination, filters, baseUrlPath: 'school/class-templates' }) %>
<%- include('partials/tablePages-end') %>
