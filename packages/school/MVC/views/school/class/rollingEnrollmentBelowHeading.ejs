<%
  const rc = typeof classData !== 'undefined' ? (classData || {}) : {};
%>
<div class="d-flex flex-wrap align-items-center gap-2 mb-4">
  <button type="button" class="btn btn-outline-primary btn-sm" id="btn_openRollingClassPicker" title="Pick another rolling class">
    <i class="bi bi-book me-1"></i>Pick class
  </button>
  <span class="text-muted small">Switch to another rolling class</span>
</div>
<div class="mb-3">
  <div class="fs-5 fw-bold text-dark lh-sm"><%= rc.title || rc.id %></div>
  <% if (rc.title && rc.id) { %>
    <div class="font-monospace text-muted small mt-1"><%= rc.id %></div>
  <% } %>
</div>
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
  <span class="badge bg-light text-dark border ms-auto" id="lbl_periodCount">0 rows</span>
</div>
