<% const c = classData || {};
  const rows = Array.isArray(editorRows) ? editorRows : [];
  const sid = String(sessionId || '').trim();
  const classId = String(c.id || '').trim();
  const asid = (typeof actionStateId !== 'undefined' && actionStateId) ? actionStateId : '';
  const todayLabel = String(orgToday || '').trim();
  const encClassId = encodeURIComponent(classId);
  const backLabel = sid ? 'Back to session' : 'Back to class';
%>
<style>
  .attendance-order-row { transition: background-color 0.12s ease, box-shadow 0.12s ease; }
  .attendance-order-row:hover { background-color: #f8fafc; }
  .attendance-order-row.attendance-order-row-dragging {
    opacity: 0.92;
    background-color: #fff;
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.14);
  }
  .attendance-order-row.attendance-order-row-drop-target {
    outline: 2px dashed #0d6efd;
    outline-offset: -2px;
    background: #f0f6ff;
  }
  .attendance-order-drag-col { width: 2.75rem; vertical-align: middle; }
  .attendance-order-drag-handle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.4rem;
    border: 1px solid rgba(15, 23, 42, 0.1);
    background: #f8f9fa;
    color: #6c757d;
    cursor: grab;
    user-select: none;
    touch-action: none;
  }
  .attendance-order-drag-handle:hover {
    background: #eef2f7;
    border-color: rgba(13, 110, 253, 0.35);
    color: #0d6efd;
  }
  .attendance-order-drag-handle:active { cursor: grabbing; }
  .attendance-order-page-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: 0.5rem;
    margin-top: 1rem;
    margin-bottom: 0.5rem;
  }
</style>
<%
  function jsonForScript(value) {
    if (value === undefined) return 'undefined';
    const s = JSON.stringify(value);
    if (s === undefined) return 'null';
    return s.replace(/</g, '\\u003c').replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029').replace(/&/g, '\\u0026');
  }
  const manageBtns = [
    '<a href="' + backHref + '" class="btn btn-outline-secondary btn-md mb-2"><i class="bi bi-arrow-left me-1"></i> ' + backLabel + '</a>'
  ];
%>
<%- include('partials/tablePages-start', {
  title: typeof title !== 'undefined' ? title : 'Attendance Display Order',
  newUrl: '',
  user,
  tableName: typeof tableName !== 'undefined' ? tableName : 'School_AttendanceRosterOrder',
  btn_export: false,
  print: false,
  headerManageBtns: [],
  manageBtns
}) %>

<div class="alert alert-light border d-flex gap-3 align-items-start mb-3">
  <i class="bi bi-info-circle-fill text-primary fs-5"></i>
  <div>
    <div class="fw-semibold"><%= c.title || 'Class' %></div>
    <div class="small text-muted">
      Lists students with valid enrollment as of <strong><%= todayLabel || 'today' %></strong>.
      Saved order applies on the Manage Session attendance tab for all teachers.
      Drag by the grip handle to reorder, use arrows to fine-tune, or auto-sort then save.
    </div>
  </div>
</div>

<% if (rows.length) { %>
<div class="card border-0 shadow-sm mb-3">
  <div class="card-body py-2 px-3 d-flex flex-wrap align-items-center gap-2">
    <span class="small fw-semibold text-muted me-1">Auto sort:</span>
    <div class="btn-group btn-group-sm flex-wrap" role="group" aria-label="Auto sort attendance display order">
      <button type="button" class="btn btn-outline-secondary js-attendance-order-autosort" data-sort-key="enrollment">Enrollment</button>
      <button type="button" class="btn btn-outline-secondary js-attendance-order-autosort" data-sort-key="firstName">First name</button>
      <button type="button" class="btn btn-outline-secondary js-attendance-order-autosort" data-sort-key="lastName">Last name</button>
      <button type="button" class="btn btn-outline-secondary js-attendance-order-autosort" data-sort-key="dateOfBirth">Date of birth</button>
    </div>
  </div>
</div>
<% } %>

<form id="attendanceRosterOrderForm" method="post" action="/school/classes/<%= encClassId %>/attendance-roster-order">
  <input type="hidden" name="actionStateId" value="<%= asid %>">
  <% if (sid) { %><input type="hidden" name="sessionId" value="<%= sid %>"><% } %>
  <input type="hidden" name="personOrder" id="hid_personOrder" value="">

  <div class="table-scroll-wrapper" data-floating-row-actions="false">
    <table class="table-responsive size-md" id="first-table">
      <thead>
        <tr>
          <th class="text-center" data-column="drag" aria-label="Drag"></th>
          <th class="draggable ps-2" data-column="order" style="width: 3rem;">#</th>
          <th class="draggable" data-column="student">Student</th>
          <th class="text-end pe-4" data-column="actions" style="width: 7rem;">Move</th>
        </tr>
      </thead>
      <tbody id="attendanceOrderTbody">
        <% if (!rows.length) { %>
          <tr><td colspan="4" class="text-center py-5 text-muted">No students with valid enrollment for today.</td></tr>
        <% } else { %>
          <% rows.forEach((row, index) => { %>
            <tr class="attendance-order-row"
                data-personid="<%= row.personId %>"
                data-first-name="<%= (row.firstName || '').replace(/"/g, '&quot;') %>"
                data-last-name="<%= (row.lastName || '').replace(/"/g, '&quot;') %>"
                data-date-of-birth="<%= row.dateOfBirth || '' %>"
                data-enrollment-start="<%= row.enrollmentStartDate || '' %>">
              <td class="text-center attendance-order-drag-col ps-3">
                <span class="attendance-order-drag-handle" draggable="true" title="Drag to reorder" aria-label="Drag to reorder row <%= index + 1 %>"><i class="bi bi-grip-vertical" aria-hidden="true"></i></span>
              </td>
              <td class="ps-2 text-muted small attendance-order-index-cell">
                <span class="attendance-order-index"><%= index + 1 %></span>
              </td>
              <td>
                <div class="fw-semibold text-dark">
                  <%- include('school/partials/studentNameLink', { name: row.name, studentRecordId: row.studentRecordId, canOpenStudentProfile: typeof canOpenStudentProfile !== 'undefined' ? canOpenStudentProfile : false, linkClass: 'text-decoration-none' }) %>
                </div>
              </td>
              <td class="text-end pe-4">
                <div class="btn-group btn-group-sm">
                  <button type="button" class="btn btn-outline-secondary btn-order-up" title="Move up" <%= index === 0 ? 'disabled' : '' %>><i class="bi bi-arrow-up"></i></button>
                  <button type="button" class="btn btn-outline-secondary btn-order-down" title="Move down" <%= index === rows.length - 1 ? 'disabled' : '' %>><i class="bi bi-arrow-down"></i></button>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</form>

<form method="post" action="/school/classes/<%= encClassId %>/attendance-roster-order/reset" id="attendanceRosterOrderResetForm" class="d-none" aria-hidden="true">
  <input type="hidden" name="actionStateId" value="<%= asid %>">
  <% if (sid) { %><input type="hidden" name="sessionId" value="<%= sid %>"><% } %>
</form>

<div class="attendance-order-page-footer">
  <button type="submit" form="attendanceRosterOrderForm" class="btn btn-filled btn-primary btn-md" id="btnSaveAttendanceOrder">
    <i class="bi bi-check-lg me-1"></i> Save order
  </button>
  <% if (rows.length) { %>
  <button type="button" class="btn btn-outline-secondary btn-md" id="btnResetAttendanceOrderAlphabetical">
    <i class="bi bi-arrow-counterclockwise me-1"></i> Reset to alphabetical
  </button>
  <% } %>
</div>

<%- include('partials/tablePages-end') %>

<script>
(function () {
  const RESET_CONFIRM_LABEL = 'Reset to alphabetical';

  async function showAttendanceOrderMessage({ title, icon, message, buttons }) {
    if (typeof window.showMessageModal === 'function' && document.getElementById('messageModal')) {
      return window.showMessageModal({ title, icon, message, buttons: buttons || [{ text: 'OK', class: 'btn-primary' }] });
    }
    console.warn(`[${title}] ${message}`);
    return 'OK';
  }

  async function confirmAttendanceOrderAction(message, title = 'Confirm', confirmText = 'Confirm') {
    if (typeof window.showMessageModal === 'function' && document.getElementById('messageModal')) {
      const result = await window.showMessageModal({
        title,
        icon: 'warning',
        message,
        buttons: [
          { text: 'Cancel', class: 'btn-secondary' },
          { text: confirmText, class: 'btn-warning' }
        ]
      });
      return result === confirmText;
    }
    return false;
  }

  const resetForm = document.getElementById('attendanceRosterOrderResetForm');
  const resetBtn = document.getElementById('btnResetAttendanceOrderAlphabetical');
  if (resetBtn && resetForm) {
    resetBtn.addEventListener('click', async () => {
      const confirmed = await confirmAttendanceOrderAction(
        'Reset to alphabetical order on the attendance tab? This clears the saved class order.',
        'Reset display order?',
        RESET_CONFIRM_LABEL
      );
      if (confirmed) resetForm.requestSubmit();
    });
  }

  const tbody = document.getElementById('attendanceOrderTbody');
  const hid = document.getElementById('hid_personOrder');
  const form = document.getElementById('attendanceRosterOrderForm');
  if (!tbody) return;

  const nameCollator = new Intl.Collator(undefined, { sensitivity: 'base' });
  const sortSentinelDate = '9999-99-99';
  const sortSentinelText = '\uffff';
  let dragPersonId = '';
  let activeDragRow = null;

  function rosterRows() {
    return Array.from(tbody.querySelectorAll('.attendance-order-row'));
  }

  function currentPersonOrder() {
    return rosterRows()
      .map((row) => String(row.getAttribute('data-personid') || '').trim())
      .filter(Boolean);
  }

  function refreshOrderUi() {
    const rows = rosterRows();
    rows.forEach((row, index) => {
      const cell = row.querySelector('.attendance-order-index');
      if (cell) cell.textContent = String(index + 1);
      const up = row.querySelector('.btn-order-up');
      const down = row.querySelector('.btn-order-down');
      if (up) up.disabled = index === 0;
      if (down) down.disabled = index === rows.length - 1;
    });
    if (hid) hid.value = JSON.stringify(currentPersonOrder());
  }

  function applyAutoSort(sortKey) {
    const rows = rosterRows();
    if (!rows.length) return;
    rows.sort((a, b) => {
      if (sortKey === 'enrollment') {
        const av = a.getAttribute('data-enrollment-start') || sortSentinelDate;
        const bv = b.getAttribute('data-enrollment-start') || sortSentinelDate;
        const cmp = av.localeCompare(bv);
        if (cmp !== 0) return cmp;
      } else if (sortKey === 'firstName') {
        const av = a.getAttribute('data-first-name') || sortSentinelText;
        const bv = b.getAttribute('data-first-name') || sortSentinelText;
        const cmp = nameCollator.compare(av, bv);
        if (cmp !== 0) return cmp;
      } else if (sortKey === 'lastName') {
        const av = a.getAttribute('data-last-name') || sortSentinelText;
        const bv = b.getAttribute('data-last-name') || sortSentinelText;
        const cmp = nameCollator.compare(av, bv);
        if (cmp !== 0) return cmp;
      } else if (sortKey === 'dateOfBirth') {
        const av = a.getAttribute('data-date-of-birth') || sortSentinelDate;
        const bv = b.getAttribute('data-date-of-birth') || sortSentinelDate;
        const cmp = av.localeCompare(bv);
        if (cmp !== 0) return cmp;
      }
      const aId = String(a.getAttribute('data-personid') || '');
      const bId = String(b.getAttribute('data-personid') || '');
      return aId.localeCompare(bId);
    });
    rows.forEach((row) => tbody.appendChild(row));
    refreshOrderUi();
  }

  function clearDropTargetMarkers() {
    tbody.querySelectorAll('.attendance-order-row-drop-target').forEach((row) => {
      row.classList.remove('attendance-order-row-drop-target');
    });
  }

  function moveDraggedRowBeforeTarget(targetRow) {
    const dragRow = rosterRows().find((row) => String(row.getAttribute('data-personid') || '') === dragPersonId);
    if (!dragRow || !targetRow || dragRow === targetRow) return;
    tbody.insertBefore(dragRow, targetRow);
    refreshOrderUi();
  }

  tbody.addEventListener('dragstart', (event) => {
    const handle = event.target.closest('.attendance-order-drag-handle');
    if (!handle || !handle.hasAttribute('draggable')) {
      event.preventDefault();
      return;
    }
    const row = handle.closest('.attendance-order-row');
    if (!row) {
      event.preventDefault();
      return;
    }
    dragPersonId = String(row.getAttribute('data-personid') || '').trim();
    if (!dragPersonId) {
      event.preventDefault();
      return;
    }
    activeDragRow = row;
    row.classList.add('attendance-order-row-dragging');
    if (event.dataTransfer) {
      event.dataTransfer.effectAllowed = 'move';
      event.dataTransfer.setData('text/plain', dragPersonId);
      if (typeof event.dataTransfer.setDragImage === 'function') {
        event.dataTransfer.setDragImage(row, 24, 20);
      }
    }
  });

  tbody.addEventListener('dragend', (event) => {
    const row = activeDragRow || event.target.closest('.attendance-order-row');
    if (row) row.classList.remove('attendance-order-row-dragging');
    activeDragRow = null;
    dragPersonId = '';
    clearDropTargetMarkers();
  });

  tbody.addEventListener('dragover', (event) => {
    if (!dragPersonId) return;
    event.preventDefault();
    const row = event.target.closest('.attendance-order-row');
    clearDropTargetMarkers();
    if (row && String(row.getAttribute('data-personid') || '') !== dragPersonId) {
      row.classList.add('attendance-order-row-drop-target');
    }
    if (event.dataTransfer) event.dataTransfer.dropEffect = 'move';
  });

  tbody.addEventListener('dragleave', (event) => {
    const row = event.target.closest('.attendance-order-row');
    if (row) row.classList.remove('attendance-order-row-drop-target');
  });

  tbody.addEventListener('drop', (event) => {
    event.preventDefault();
    const targetRow = event.target.closest('.attendance-order-row');
    clearDropTargetMarkers();
    if (targetRow) moveDraggedRowBeforeTarget(targetRow);
    dragPersonId = '';
    activeDragRow = null;
  });

  tbody.addEventListener('click', (event) => {
    const up = event.target.closest('.btn-order-up');
    const down = event.target.closest('.btn-order-down');
    const row = (up || down)?.closest('.attendance-order-row');
    if (!row) return;
    if (up) {
      const prev = row.previousElementSibling;
      if (prev?.classList.contains('attendance-order-row')) tbody.insertBefore(row, prev);
    }
    if (down) {
      const next = row.nextElementSibling;
      if (next?.classList.contains('attendance-order-row')) tbody.insertBefore(next, row);
    }
    refreshOrderUi();
  });

  document.querySelectorAll('.js-attendance-order-autosort').forEach((btn) => {
    btn.addEventListener('click', () => {
      const sortKey = String(btn.getAttribute('data-sort-key') || '').trim();
      if (!sortKey) return;
      applyAutoSort(sortKey);
    });
  });

  form?.addEventListener('submit', async (event) => {
    refreshOrderUi();
    const personOrder = currentPersonOrder();
    if (!personOrder.length) {
      event.preventDefault();
      await showAttendanceOrderMessage({
        title: 'Nothing to save',
        icon: 'info',
        message: 'No students with valid enrollment for today. Add enrollments first, then set display order.'
      });
    }
  });
  refreshOrderUi();
})();
</script>
