<%- include('school/attendance/_attendanceMarkAppearance') %>

<%
  const dashHref = typeof schoolSectionDashboardHref === 'string' && schoolSectionDashboardHref
    ? schoolSectionDashboardHref
    : '/dashboard/section-nav/SCHOOL';
  const caps = (typeof scheduleCapabilities !== 'undefined' && scheduleCapabilities) ? scheduleCapabilities : {};
  const scheduleAccess = (typeof viewerScheduleAccess !== 'undefined' && viewerScheduleAccess) ? viewerScheduleAccess : {};
  const canDragCreateSessions = caps.canDragCreateSessions === true || scheduleAccess.canDragCreateSessions === true;
  const canLoadAllSchedules = caps.canLoadAllSchedules === true || scheduleAccess.canLoadAllSchedules === true;
  const canUseGlobalComparison = caps.canUseGlobalComparison === true || scheduleAccess.canUseGlobalComparison === true;
  const canDeleteClassSessions = caps.canDeleteClassSessions === true || scheduleAccess.canDeleteClassSessions === true;
  const canOpenRollingEnrollment = caps.canOpenRollingEnrollment === true || scheduleAccess.canOpenRollingEnrollment === true;
  const scheduleRoles = Array.isArray(scheduleAccess.availableRoles) ? scheduleAccess.availableRoles : [];
  const defaultRole = scheduleAccess.selectedRole || (scheduleRoles.length >= 1 ? scheduleRoles[0].key : '');
  const lockedPersonId = scheduleAccess.lockedPersonId || (typeof prefillId !== 'undefined' ? prefillId : '') || '';
  const lockedPersonName = scheduleAccess.lockedPersonName || (typeof prefillName !== 'undefined' ? prefillName : '') || '';
  const showCreateClassFromTemplateModal = typeof includeClassCreateFromTemplateModal !== 'undefined' && includeClassCreateFromTemplateModal === true;
%>

<link rel="stylesheet" href="/styles/schedule-viewer.css">
<link rel="stylesheet" href="/styles/session-calendar.css">
<link rel="stylesheet" href="/styles/schedule-viewer-admin.css">

<%- include('partials/tablePages-start', {
  title: 'Master Schedule Viewer',
  sectionsPageClass: 'schedule-viewer-page',
  newUrl: null,
  newLabel: null,
  user,
  tableName: null,
  btn_export: false,
  print: false,
  optionalBtnsBeforePrint: [
    '<button type="button" id="btn_printSchedule" class="btn btn-filled btn-edit btn-md me-2 mb-2" disabled title="Load a schedule first">🖨 Print</button>'
  ],
  headerManageBtns: [
    '<a href="' + dashHref + '" class="school-navigator-dashboard btn btn-filled btn-secondary btn-md mb-2"><i class="bi bi-speedometer2 me-1"></i> School Dashboard</a>',
    '<a href="/dashboard/section-nav/SCHOOL_ACADEMIA" class="school-navigator-dashboard btn btn-filled btn-secondary btn-md mb-2"><i class="bi bi-journal-bookmark me-1"></i> School Academia</a>'
  ],
  manageBtns: canUseGlobalComparison ? [
    '<a href="/school/schedules/global" class="btn btn-outline-primary btn-md mb-2"><i class="bi bi-layers me-1"></i> Global Comparison</a>',
    '<a href="/school/classes" class="btn btn-outline-secondary btn-md mb-2"><i class="bi bi-collection me-1"></i> Classes</a>'
  ] : []
}) %>

<div class="schedule-shell">
  <div class="card border-0 shadow-sm mb-3 schedule-filter-card" id="scheduleFilterCard">
    <div class="card-header bg-white d-flex align-items-center justify-content-between py-2 px-3">
      <div id="scheduleFilterTitleToggle" class="fw-bold text-dark schedule-filter-title-toggle" role="button" tabindex="0" aria-controls="scheduleFilterCollapse">
        <i class="bi bi-calendar3 me-2"></i>Filter Schedule
      </div>
      <button
        id="scheduleFilterToggleBtn"
        type="button"
        class="btn btn-outline-secondary btn-sm px-2 schedule-filter-toggle"
        data-bs-toggle="collapse"
        data-bs-target="#scheduleFilterCollapse"
        aria-expanded="false"
        aria-controls="scheduleFilterCollapse"
        aria-label="Open filters">
        <i id="scheduleFilterToggleIcon" class="bi bi-chevron-down"></i>
      </button>
    </div>
    <div class="schedule-filter-summary">
      <div class="schedule-filter-summary-admin">
        <div class="schedule-filter-field">
          <label for="sch_role">Role</label>
          <select id="sch_role" class="form-select schedule-filter-input">
            <option value="teacher" selected>Teacher</option>
            <option value="student">Student</option>
            <option value="staff">Staff</option>
            <option value="">All roles</option>
          </select>
        </div>
        <div class="schedule-filter-field schedule-filter-people">
          <label>People</label>
          <input type="hidden" id="sch_personId" value="<%= lockedPersonId %>">
          <input type="hidden" id="sch_personName" value="<%= lockedPersonName %>">
          <div class="schedule-people-actions">
            <button type="button" class="btn btn-outline-primary" id="btn_openPersonPicker" title="Select people">
              <i class="bi bi-people-fill me-1"></i>Select people
            </button>
            <button type="button" class="btn btn-outline-secondary px-3" id="btn_clearPerson" title="Clear people" aria-label="Clear people">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>
        </div>
        <div class="schedule-filter-field">
          <label for="sch_startDate">Start date</label>
          <input type="date" id="sch_startDate" class="form-control schedule-date-input">
        </div>
        <div class="schedule-filter-field">
          <label for="sch_endDate">End date</label>
          <input type="date" id="sch_endDate" class="form-control schedule-date-input">
        </div>
        <div class="schedule-filter-field schedule-filter-summary-action">
          <label class="d-none d-md-block" aria-hidden="true">&nbsp;</label>
          <button type="button" id="btn_loadSchedule" class="btn btn-primary w-100">
            <i class="bi bi-arrow-clockwise me-1"></i> Load tab
          </button>
        </div>
      </div>
    </div>
    <div class="collapse" id="scheduleFilterCollapse">
      <div class="card-body filter-panel p-3" id="scheduleFilterForm">
        <div class="schedule-filter-admin">
          <%- include('school/schedule/partials/personScheduleQuickRangeChips') %>
          <div class="schedule-filter-actions schedule-filter-actions--with-cases">
            <div class="schedule-cases-switch">
              <input class="form-check-input" type="checkbox" role="switch" id="sch_hasCases">
              <label class="form-check-label" for="sch_hasCases">With cases only</label>
            </div>
            <div class="schedule-filter-actions-buttons">
              <button type="button" id="btn_resetScheduleFilters" class="btn btn-outline-secondary">Reset</button>
              <button type="button" id="btn_loadAllSchedules" class="btn btn-outline-primary">
                <i class="bi bi-cloud-arrow-down me-1"></i> Load all
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('school/schedule/partials/personScheduleCalendarShell', { personScheduleIncludeAdminRail: true }) %>
</div>

<div class="modal fade" id="schedulePersonNoteModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header py-2 px-3">
        <h6 class="modal-title mb-0 fw-semibold" id="schedulePersonNoteModalTitle">Schedule note</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="small text-muted mb-2" id="schedulePersonNoteMeta"></p>
        <label class="form-label fw-semibold" for="schedulePersonNoteInput">Note</label>
        <textarea class="form-control" id="schedulePersonNoteInput" rows="8" maxlength="5000" placeholder="Scheduling notes for this person (visible to master schedule admins in your organization)."></textarea>
        <div class="form-text">Shared within your organization. Separate from Person Notes on the profile.</div>
      </div>
      <div class="modal-footer py-2 px-3">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary btn-sm" id="btn_schedulePersonNoteSave">Save</button>
      </div>
    </div>
  </div>
</div>

