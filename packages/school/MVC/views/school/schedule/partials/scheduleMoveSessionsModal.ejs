<div class="modal fade" id="scheduleMoveSessionsModal" tabindex="-1" aria-hidden="true" aria-labelledby="scheduleMoveSessionsModalTitle">
  <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="scheduleMoveSessionsModalTitle"><i class="bi bi-arrow-left-right me-1"></i>Move Sessions/Enrollments</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="d-flex flex-wrap gap-2 mb-3 small" id="scheduleMoveSessionsSteps" aria-label="Move steps">
          <span class="badge text-bg-primary" data-move-step-pill="class">1. Target class</span>
          <span class="badge text-bg-light border" data-move-step-pill="time">2. Start time</span>
          <span class="badge text-bg-light border" data-move-step-pill="enrollments">3. Enrollments</span>
        </div>

        <div data-move-step="class">
          <p class="small text-muted">Choose the class that should receive the selected sessions and their enrollments.</p>
          <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <button type="button" class="btn btn-outline-primary btn-sm" id="btn_scheduleMovePickClass">Choose class</button>
            <strong id="scheduleMoveTargetClassLabel">No class selected</strong>
          </div>
          <div class="small" id="scheduleMoveClassSummary"></div>
          <div class="alert alert-warning py-2 small d-none" id="scheduleMoveClassBlockers" role="alert"></div>
        </div>

        <div class="d-none" data-move-step="time">
          <p class="small text-muted mb-2">Each selected session keeps its date and length. This start time is used on the target class.</p>
          <label class="form-label" for="scheduleMoveStartTime">Start time</label>
          <input type="time" class="form-control form-control-sm mb-3" id="scheduleMoveStartTime" step="60">
          <div class="alert alert-warning py-2 small d-none" id="scheduleMoveTimeBlockers" role="alert"></div>
          <div class="alert alert-info py-2 small d-none" id="scheduleMoveTimeNotices" role="status"></div>
        </div>

        <div class="d-none" data-move-step="enrollments">
          <p class="small text-muted">Enrollments that cover the selected sessions. An enrollment that started before the first selected session is closed on the original class and opened on the target class. An enrollment that starts on that first session is updated onto the target class.</p>
          <div class="table-responsive border rounded">
            <table class="table table-sm align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Student</th>
                  <th>Action</th>
                  <th>Dates</th>
                </tr>
              </thead>
              <tbody id="scheduleMoveEnrollmentTbody"></tbody>
            </table>
          </div>
          <div class="alert alert-info py-2 small mt-3 d-none" id="scheduleMoveApplyNotices" role="status"></div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary btn-sm d-none" id="btn_scheduleMoveBack">Back</button>
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary btn-sm" id="btn_scheduleMoveNext">Next</button>
      </div>
    </div>
  </div>
</div>
