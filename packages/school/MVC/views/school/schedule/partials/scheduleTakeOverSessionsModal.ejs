<div class="modal fade" id="scheduleTakeOverSessionsModal" tabindex="-1" aria-hidden="true" aria-labelledby="scheduleTakeOverSessionsModalTitle">
  <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="scheduleTakeOverSessionsModalTitle"><i class="bi bi-person-check me-1"></i>Take Over</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="d-flex flex-wrap gap-2 mb-3 small" id="scheduleTakeOverSessionsSteps" aria-label="Take over steps">
          <span class="badge text-bg-primary" data-takeover-step-pill="teacher">1. Teacher</span>
          <span class="badge text-bg-light border" data-takeover-step-pill="review">2. Review</span>
        </div>

        <div data-takeover-step="teacher">
          <p class="small text-muted">Choose the teacher who will take over the selected sessions. Each session must have an enrollment and must not be completed. The teacher must be free at those times.</p>
          <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <button type="button" class="btn btn-outline-primary btn-sm" id="btn_scheduleTakeOverPickTeacher">Choose teacher</button>
            <strong id="scheduleTakeOverTeacherLabel">No teacher selected</strong>
          </div>
          <div class="alert alert-warning py-2 small d-none" id="scheduleTakeOverTeacherBlockers" role="alert"></div>
        </div>

        <div class="d-none" data-takeover-step="review">
          <p class="small text-muted">The chosen teacher becomes the main teacher. The previous teacher stays on the session as an unpaid co-teacher, so it remains on their schedule and is left off their timesheet.</p>
          <div class="table-responsive border rounded">
            <table class="table table-sm align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Session</th>
                  <th>Previous teacher</th>
                  <th>New teacher</th>
                </tr>
              </thead>
              <tbody id="scheduleTakeOverReviewTbody"></tbody>
            </table>
          </div>
          <div class="alert alert-warning py-2 small mt-3 d-none" id="scheduleTakeOverReviewBlockers" role="alert"></div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary btn-sm d-none" id="btn_scheduleTakeOverBack">Back</button>
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary btn-sm" id="btn_scheduleTakeOverNext">Next</button>
      </div>
    </div>
  </div>
</div>
