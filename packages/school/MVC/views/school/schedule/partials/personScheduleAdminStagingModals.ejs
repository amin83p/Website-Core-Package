<%
  const caps = (typeof scheduleCapabilities !== 'undefined' && scheduleCapabilities) ? scheduleCapabilities : {};
  const scheduleAccess = (typeof viewerScheduleAccess !== 'undefined' && viewerScheduleAccess) ? viewerScheduleAccess : {};
  const canDragCreateSessions = caps.canDragCreateSessions === true || scheduleAccess.canDragCreateSessions === true;
  const canDeleteClassSessions = caps.canDeleteClassSessions === true || scheduleAccess.canDeleteClassSessions === true;
%>
<% if (canDragCreateSessions) { %>
<%- include('school/partials/scheduleDraftSessionContextMenu') %>

<div class="modal fade" id="scheduleSessionBulkSelectModal" tabindex="-1" aria-hidden="true" aria-labelledby="scheduleSessionBulkSelectModalTitle">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg">
      <div class="modal-header">
        <h5 class="modal-title" id="scheduleSessionBulkSelectModalTitle">Select sessions</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="small text-muted mb-3" id="scheduleSessionBulkSelectHint"></p>
        <div class="mb-3">
          <div class="form-label mb-2">Select by</div>
          <div class="d-flex flex-wrap gap-3">
            <div class="form-check">
              <input class="form-check-input" type="radio" name="scheduleSessionBulkSelectMode" id="scheduleSessionBulkSelectModeCount" value="count" checked>
              <label class="form-check-label" for="scheduleSessionBulkSelectModeCount">Number of sessions</label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="scheduleSessionBulkSelectMode" id="scheduleSessionBulkSelectModeDate" value="date">
              <label class="form-check-label" for="scheduleSessionBulkSelectModeDate">Up to date</label>
            </div>
          </div>
        </div>
        <div class="mb-3">
          <div class="form-label mb-2">Weekdays</div>
          <div class="d-flex flex-wrap gap-1" id="scheduleSessionBulkSelectWeekdays" role="group" aria-label="Weekdays">
            <% ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].forEach((label, idx) => { %>
            <input type="checkbox" class="btn-check" id="scheduleSessionBulkSelectWeekday<%= idx %>" data-bulk-select-weekday="<%= idx %>" autocomplete="off" checked>
            <label class="btn btn-outline-secondary btn-sm" for="scheduleSessionBulkSelectWeekday<%= idx %>"><%= label %></label>
            <% }) %>
          </div>
        </div>
        <div class="row g-3">
          <div class="col-sm-6">
            <label class="form-label" for="scheduleSessionBulkSelectCount">Sessions</label>
            <input type="number" class="form-control form-control-sm" id="scheduleSessionBulkSelectCount" min="1" step="1" aria-label="Number of sessions to select">
          </div>
          <div class="col-sm-6">
            <label class="form-label" for="scheduleSessionBulkSelectStopDate">Up to date</label>
            <input type="date" class="form-control form-control-sm" id="scheduleSessionBulkSelectStopDate" aria-label="Stop date for selection" disabled>
          </div>
        </div>
        <p class="small text-muted mt-3 mb-0" id="scheduleSessionBulkSelectHelp">Use one option: enter a session count starting from the anchor session, or choose an end date. Only sessions on the selected weekdays are included, until that count is met or that date is reached. Start times must fall within the anchor session&rsquo;s start&ndash;end time.</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary btn-sm" id="btn_scheduleSessionBulkSelectApply">Apply</button>
      </div>
    </div>
  </div>
</div>

<%- include('school/partials/sessionEnrollmentCalendarModal') %>
<%- include('school/schedule/partials/scheduleSaveDraftWorkModal') %>

<div id="scheduleSavedBulkEditOverlay" class="session-enrollment-stage-overlay d-none" role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="scheduleSavedBulkEditOverlayTitle">
  <div class="session-enrollment-stage-backdrop" data-saved-bulk-edit-dismiss="1" aria-hidden="true"></div>
  <div class="session-enrollment-stage-panel card shadow">
    <div class="card-header py-2 d-flex align-items-start justify-content-between gap-2">
      <div>
        <h5 class="card-title mb-0" id="scheduleSavedBulkEditOverlayTitle">Edit Session(s)</h5>
        <div class="small text-muted" id="scheduleSavedBulkEditOverlayContext"></div>
      </div>
      <button type="button" class="btn-close" data-saved-bulk-edit-dismiss="1" aria-label="Close"></button>
    </div>
    <div class="card-body py-2">
      <div class="session-stage-section mb-3">
        <label class="session-stage-label small text-muted mb-1" for="scheduleSavedBulkEditDate">Date</label>
        <input type="date" class="form-control form-control-sm" id="scheduleSavedBulkEditDate" disabled readonly title="Each session keeps its own date.">
        <div class="small text-muted mt-1">Each selected session keeps its current date.</div>
      </div>
      <div class="session-stage-section mb-3">
        <label class="session-stage-label small text-muted mb-1" for="scheduleSavedBulkEditStartTime">Start time</label>
        <input type="time" class="form-control form-control-sm" id="scheduleSavedBulkEditStartTime" step="900">
      </div>
      <div class="session-stage-section mb-2">
        <div class="session-stage-label small text-muted mb-1">Duration</div>
        <div class="session-stage-btn-group d-flex flex-wrap gap-2" id="scheduleSavedBulkEditDurationGroup" role="group" aria-label="Session duration">
          <button type="button" class="btn btn-outline-secondary session-stage-chip" data-saved-bulk-edit-duration="0.5">30 Mins</button>
          <button type="button" class="btn btn-outline-secondary session-stage-chip active" data-saved-bulk-edit-duration="1">1 Hr</button>
          <button type="button" class="btn btn-outline-secondary session-stage-chip" data-saved-bulk-edit-duration="1.5">1:30 Hrs</button>
          <button type="button" class="btn btn-outline-secondary session-stage-chip" data-saved-bulk-edit-duration="2">2 Hrs</button>
          <button type="button" class="btn btn-outline-secondary session-stage-chip" data-saved-bulk-edit-duration="2.5">2:30 Hrs</button>
          <button type="button" class="btn btn-outline-secondary session-stage-chip" data-saved-bulk-edit-duration="3">3 Hrs</button>
        </div>
      </div>
      <div class="small text-danger d-none" id="scheduleSavedBulkEditError" role="alert"></div>
    </div>
    <div class="card-footer py-2 d-flex justify-content-end gap-2">
      <button type="button" class="btn btn-secondary btn-sm" data-saved-bulk-edit-dismiss="1">Cancel</button>
      <button type="button" class="btn btn-primary btn-sm" id="btn_scheduleSavedBulkEditApply">Apply</button>
    </div>
  </div>
</div>

<div class="modal fade" id="scheduleClassPickerModal" tabindex="-1" aria-hidden="true" aria-labelledby="scheduleClassPickerModalTitle">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable schedule-class-picker-dialog">
    <div class="modal-content schedule-class-picker-content">
      <div class="modal-header schedule-class-picker-header border-0 pb-0">
        <div class="pe-3">
          <h5 class="modal-title mb-1" id="scheduleClassPickerModalTitle">
            <i class="bi bi-easel-fill text-primary me-2" aria-hidden="true"></i>Select class
          </h5>
          <p class="small text-muted mb-0" id="scheduleClassPickerSubtitle">Choose a class to stage sessions for.</p>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body schedule-class-picker-body pt-3">
        <div class="schedule-class-picker-search-wrap mb-3">
          <i class="bi bi-search schedule-class-picker-search-icon" aria-hidden="true"></i>
          <input type="search" class="form-control schedule-class-picker-search" id="scheduleClassPickerSearch" placeholder="Search by title, code, program, or ID..." autocomplete="off">
        </div>
        <div id="scheduleClassPickerEmpty" class="d-none schedule-class-picker-empty text-center text-muted">
          <i class="bi bi-inbox fs-2 opacity-25 d-block mb-2" aria-hidden="true"></i>
          <div class="fw-semibold">No active classes found</div>
          <div class="small mt-1">This teacher has no active instructor classes in the current organization.</div>
        </div>
        <div id="scheduleClassPickerList" class="schedule-class-picker-list" role="listbox" aria-label="Classes"></div>
      </div>
    </div>
  </div>
</div>
<% } %>

<% if (canDeleteClassSessions) { %>
<div class="modal fade" id="scheduleBulkSessionDeleteModal" tabindex="-1" aria-hidden="true" aria-labelledby="scheduleBulkSessionDeleteModalTitle">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header bg-danger text-white">
        <h5 class="modal-title fw-bold" id="scheduleBulkSessionDeleteModalTitle"><i class="bi bi-trash me-2"></i>Delete Selected Sessions</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="scheduleBulkSessionDeleteModalBody"></div>
      <div class="modal-footer bg-light">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger d-none" id="btn_scheduleBulkSessionDeleteConfirm"><i class="bi bi-trash me-1"></i>Delete sessions</button>
      </div>
    </div>
  </div>
</div>
<% } %>
