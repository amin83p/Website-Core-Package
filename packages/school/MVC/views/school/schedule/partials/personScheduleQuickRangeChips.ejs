<div class="schedule-quick-dates">
  <span class="schedule-quick-dates-label">Quick range</span>
  <div class="schedule-range-group">
    <button type="button" class="btn btn-range range-chip schedule-range-chip" data-range="day">Today</button>
    <button type="button" class="btn btn-range range-chip schedule-range-chip" data-range="week">This week</button>
    <button type="button" class="btn btn-range range-chip schedule-range-chip" data-range="first15">First 15 days</button>
    <button type="button" class="btn btn-range range-chip schedule-range-chip" data-range="second15">Second 15 days</button>
    <button type="button" class="btn btn-range range-chip schedule-range-chip" data-range="month">This month</button>
    <button type="button" class="btn btn-range range-chip schedule-range-chip" data-range="season">Next 3 months</button>
    <button type="button" class="btn btn-range range-chip schedule-range-chip" data-range="year">This year</button>
  </div>
</div>
