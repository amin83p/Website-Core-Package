<div class="modal fade" id="scheduleMergeSessionsModal" tabindex="-1" aria-hidden="true" aria-labelledby="scheduleMergeSessionsModalTitle">
  <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="scheduleMergeSessionsModalTitle"><i class="bi bi-person-check me-1"></i>Merge Session/Take Over</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="d-flex flex-wrap gap-2 mb-3 small" id="scheduleMergeSessionsSteps" aria-label="Merge steps">
          <span class="badge text-bg-primary" data-merge-step-pill="teacher">1. Teacher</span>
          <span class="badge text-bg-light border" data-merge-step-pill="review">2. Review</span>
        </div>

        <div data-merge-step="teacher">
          <p class="small text-muted">Choose the teacher who will take over the selected sessions. Each selected session must fall inside its own session where that teacher is the main teacher.</p>
          <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <button type="button" class="btn btn-outline-primary btn-sm" id="btn_scheduleMergePickTeacher">Choose teacher</button>
            <strong id="scheduleMergeTeacherLabel">No teacher selected</strong>
          </div>
          <div class="alert alert-warning py-2 small d-none" id="scheduleMergeTeacherBlockers" role="alert"></div>
        </div>

        <div class="d-none" data-merge-step="review">
          <p class="small text-muted">Each selected session stays on its class. The chosen teacher becomes the main teacher, and the previous teacher stays on as an unpaid co-teacher.</p>
          <div class="table-responsive border rounded">
            <table class="table table-sm align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Selected session</th>
                  <th>Partner class</th>
                  <th>Partner time</th>
                </tr>
              </thead>
              <tbody id="scheduleMergeReviewTbody"></tbody>
            </table>
          </div>
          <div class="alert alert-warning py-2 small mt-3 d-none" id="scheduleMergeReviewBlockers" role="alert"></div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary btn-sm d-none" id="btn_scheduleMergeBack">Back</button>
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary btn-sm" id="btn_scheduleMergeNext">Next</button>
      </div>
    </div>
  </div>
</div>
