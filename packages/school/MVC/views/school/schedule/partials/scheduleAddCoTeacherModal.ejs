<div class="modal fade" id="scheduleAddCoTeacherModal" tabindex="-1" aria-hidden="true" aria-labelledby="scheduleAddCoTeacherModalTitle">
  <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="scheduleAddCoTeacherModalTitle"><i class="bi bi-people me-1"></i>Co-Teacher</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="d-flex flex-wrap gap-2 mb-3 small" id="scheduleAddCoTeacherSteps" aria-label="Co-teacher steps">
          <span class="badge text-bg-primary" data-co-teacher-step-pill="teacher">1. Teacher</span>
          <span class="badge text-bg-light border" data-co-teacher-step-pill="review">2. Review</span>
        </div>

        <div data-co-teacher-step="teacher">
          <div class="card border mb-3">
            <div class="card-header py-2 small fw-semibold bg-white">Current co-teachers</div>
            <div class="card-body p-0">
              <div id="scheduleAddCoTeacherExisting" class="small text-muted p-3">No co-teachers on the selected sessions.</div>
            </div>
          </div>

          <div class="card border">
            <div class="card-header py-2 small fw-semibold bg-white" id="scheduleAddCoTeacherFormTitle">Add or edit</div>
            <div class="card-body">
              <div class="row g-3 align-items-end">
                <div class="col-12">
                  <label class="form-label small mb-1">Teacher</label>
                  <div class="d-flex flex-wrap align-items-center gap-2">
                    <button type="button" class="btn btn-outline-primary btn-sm" id="btn_scheduleAddCoTeacherPick">Choose teacher</button>
                    <strong id="scheduleAddCoTeacherLabel">No teacher selected</strong>
                  </div>
                </div>
              </div>
              <div class="row g-3 align-items-end mt-1" id="scheduleAddCoTeacherPaymentFields">
                <div class="col-sm-4">
                  <label class="form-label small mb-1" for="scheduleAddCoTeacherPaid">Payment</label>
                  <select class="form-select form-select-sm" id="scheduleAddCoTeacherPaid">
                    <option value="paid" selected>Paid</option>
                    <option value="unpaid">Unpaid</option>
                  </select>
                </div>
                <div class="col-sm-4" id="scheduleAddCoTeacherHoursWrap">
                  <label class="form-label small mb-1" for="scheduleAddCoTeacherPaidHours">Paid hours</label>
                  <input type="number" class="form-control form-control-sm" id="scheduleAddCoTeacherPaidHours" step="0.25" min="0.5" placeholder="Session hours">
                </div>
                <div class="col-12">
                  <div class="form-text mb-0" id="scheduleAddCoTeacherHoursHelp">Leave paid hours blank to use the session duration. Paid hours must be from 0.5 up to that duration, and every selected session must be the same length. Unpaid co-teachers stay on the schedule and earn 0 timesheet hours.</div>
                </div>
              </div>
              <div class="alert alert-light border py-2 small mt-3 mb-0 d-none" id="scheduleAddCoTeacherRemoveNote" role="status">This co-teacher will be removed from every selected session.</div>
            </div>
          </div>
          <div class="alert alert-warning py-2 small mt-3 d-none" id="scheduleAddCoTeacherBlockers" role="alert"></div>
        </div>

        <div class="d-none" data-co-teacher-step="review">
          <p class="small text-muted mb-2" id="scheduleAddCoTeacherReviewLead">Review the co-teacher change for each selected session.</p>
          <div class="table-responsive border rounded">
            <table class="table table-sm align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Session</th>
                  <th>Change</th>
                  <th>Co-teacher</th>
                  <th>Payment</th>
                </tr>
              </thead>
              <tbody id="scheduleAddCoTeacherReviewTbody"></tbody>
            </table>
          </div>
          <div class="alert alert-warning py-2 small mt-3 d-none" id="scheduleAddCoTeacherReviewBlockers" role="alert"></div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary btn-sm d-none" id="btn_scheduleAddCoTeacherBack">Back</button>
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary btn-sm" id="btn_scheduleAddCoTeacherNext">Next</button>
      </div>
    </div>
  </div>
</div>
