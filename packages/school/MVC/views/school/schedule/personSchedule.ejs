          </div>
        </div>
        <span class="badge bg-light text-secondary border" id="viewModeIndicator">Ready</span>
      </div>
    </div>

    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2 py-2 px-3">
        <div class="d-flex gap-3 align-items-center flex-wrap small w-100" id="legendContainer"></div>
      </div>
      <div class="card-body p-2 p-md-3">
        <div id="visualDisplayArea" class="schedule-visual-area"></div>
      </div>
