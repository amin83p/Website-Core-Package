<%- include('school/attendance/_attendanceMarkAppearance') %>

<link rel="stylesheet" href="/styles/schedule-viewer.css">
<link rel="stylesheet" href="/styles/session-calendar.css">


<%
  const dashHref = typeof schoolSectionDashboardHref === 'string' && schoolSectionDashboardHref
    ? schoolSectionDashboardHref
    : '/dashboard/section-nav/SCHOOL';
  const caps = (typeof scheduleCapabilities !== 'undefined' && scheduleCapabilities) ? scheduleCapabilities : {};
  const scheduleAccess = (typeof viewerScheduleAccess !== 'undefined' && viewerScheduleAccess) ? viewerScheduleAccess : {};
  const canSelectAnyPerson = caps.canSelectAnyPerson === true || scheduleAccess.canSelectAnyPerson === true;
  const canDragCreateSessions = caps.canDragCreateSessions === true || scheduleAccess.canDragCreateSessions === true;
  const canLoadAllSchedules = caps.canLoadAllSchedules === true || scheduleAccess.canLoadAllSchedules === true;
  const canUseGlobalComparison = caps.canUseGlobalComparison === true || scheduleAccess.canUseGlobalComparison === true;
  const canDeleteClassSessions = caps.canDeleteClassSessions === true || scheduleAccess.canDeleteClassSessions === true;
  const canOpenRollingEnrollment = caps.canOpenRollingEnrollment === true || scheduleAccess.canOpenRollingEnrollment === true;
  const scheduleRoles = Array.isArray(scheduleAccess.availableRoles) ? scheduleAccess.availableRoles : [];
  const defaultRole = scheduleAccess.selectedRole || (scheduleRoles.length >= 1 ? scheduleRoles[0].key : '');
  const lockedPersonId = scheduleAccess.lockedPersonId || (typeof prefillId !== 'undefined' ? prefillId : '') || '';
  const lockedPersonName = scheduleAccess.lockedPersonName || (typeof prefillName !== 'undefined' ? prefillName : '') || '';
%>
<% if (canSelectAnyPerson || canDragCreateSessions) { %>
<link rel="stylesheet" href="/styles/schedule-viewer-admin.css">
<% } %>

<%- include('partials/tablePages-start', {
  title: 'Master Schedule Viewer',
  newUrl: null,
  newLabel: null,
  user,
  tableName: null,
  btn_export: false,
  print: false,
  optionalBtnsBeforePrint: [
    '<button type="button" id="btn_printSchedule" class="btn btn-filled btn-edit btn-md me-2 mb-2" disabled title="Load a schedule first">🖨 Print</button>'
  ],
  headerManageBtns: [
    '<a href="' + dashHref + '" class="school-navigator-dashboard btn btn-filled btn-secondary btn-md mb-2"><i class="bi bi-speedometer2 me-1"></i> School Dashboard</a>',
    '<a href="/dashboard/section-nav/SCHOOL_ACADEMIA" class="school-navigator-dashboard btn btn-filled btn-secondary btn-md mb-2"><i class="bi bi-journal-bookmark me-1"></i> School Academia</a>'
  ],
  manageBtns: canUseGlobalComparison ? [
    '<a href="/school/schedules/global" class="btn btn-outline-primary btn-md mb-2"><i class="bi bi-layers me-1"></i> Global Comparison</a>',
    '<a href="/school/classes" class="btn btn-outline-secondary btn-md mb-2"><i class="bi bi-collection me-1"></i> Classes</a>'
  ] : []
}) %>

<div class="schedule-shell">
  <% if (!canSelectAnyPerson) { %>
    <input type="hidden" id="sch_role" value="<%= defaultRole %>">
    <input type="hidden" id="sch_personId" value="<%= lockedPersonId %>">
    <input type="hidden" id="sch_personName" value="<%= lockedPersonName %>">
  <% } %>
  <div class="card border-0 shadow-sm mb-3 schedule-filter-card" id="scheduleFilterCard">
    <div class="card-header bg-white d-flex align-items-center justify-content-between py-2 px-3">
      <div id="scheduleFilterTitleToggle" class="fw-bold text-dark schedule-filter-title-toggle" role="button" tabindex="0" aria-controls="scheduleFilterCollapse">
        <i class="bi bi-calendar3 me-2"></i><%= canSelectAnyPerson ? 'Filter Schedule' : 'Choose dates' %>
      </div>
      <button
        id="scheduleFilterToggleBtn"
        type="button"
        class="btn btn-outline-secondary btn-sm px-2 schedule-filter-toggle"
        data-bs-toggle="collapse"
        data-bs-target="#scheduleFilterCollapse"
        aria-expanded="false"
        aria-controls="scheduleFilterCollapse"
        aria-label="Open filters">
        <i id="scheduleFilterToggleIcon" class="bi bi-chevron-down"></i>
      </button>
    </div>
    <div class="schedule-filter-summary">
      <% if (canSelectAnyPerson) { %>
      <div class="schedule-filter-summary-admin">
        <div class="schedule-filter-field">
          <label for="sch_role">Role</label>
          <select id="sch_role" class="form-select schedule-filter-input">
            <option value="teacher" selected>Teacher</option>
            <option value="student">Student</option>
            <option value="staff">Staff</option>
            <option value="">All roles</option>
          </select>
        </div>
        <div class="schedule-filter-field schedule-filter-people">
          <label>People</label>
          <input type="hidden" id="sch_personId" value="<%= lockedPersonId %>">
          <input type="hidden" id="sch_personName" value="<%= lockedPersonName %>">
          <div class="schedule-people-actions">
            <button type="button" class="btn btn-outline-primary" id="btn_openPersonPicker" title="Select people">
              <i class="bi bi-people-fill me-1"></i>Select people
            </button>
            <button type="button" class="btn btn-outline-secondary px-3" id="btn_clearPerson" title="Clear people" aria-label="Clear people">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>
        </div>
        <div class="schedule-filter-field">
          <label for="sch_startDate">Start date</label>
          <input type="date" id="sch_startDate" class="form-control schedule-date-input">
        </div>
        <div class="schedule-filter-field">
          <label for="sch_endDate">End date</label>
          <input type="date" id="sch_endDate" class="form-control schedule-date-input">
        </div>
        <div class="schedule-filter-field schedule-filter-summary-action">
          <label class="d-none d-md-block" aria-hidden="true">&nbsp;</label>
          <button type="button" id="btn_loadSchedule" class="btn btn-primary w-100">
            <i class="bi bi-arrow-clockwise me-1"></i> Load tab
          </button>
        </div>
      </div>
      <% } else { %>
      <div class="schedule-filter-summary-row">
        <div class="schedule-date-field">
          <label for="sch_startDate">Start date</label>
          <input type="date" id="sch_startDate" class="form-control schedule-date-input">
        </div>
        <div class="schedule-date-field">
          <label for="sch_endDate">End date</label>
          <input type="date" id="sch_endDate" class="form-control schedule-date-input">
        </div>
        <div class="schedule-date-action schedule-filter-summary-action">
          <label class="d-none d-md-block" aria-hidden="true">&nbsp;</label>
          <button type="button" id="btn_loadSchedule" class="btn btn-primary schedule-show-btn w-100">
            <i class="bi bi-arrow-clockwise me-1"></i> Show schedule
          </button>
        </div>
      </div>
      <% } %>
    </div>
    <div class="collapse" id="scheduleFilterCollapse">
      <div class="card-body filter-panel p-3" id="scheduleFilterForm">
        <% if (canSelectAnyPerson) { %>
        <div class="schedule-filter-admin">
          <div class="schedule-quick-dates">
            <span class="schedule-quick-dates-label">Quick range</span>
            <div class="schedule-range-group">
              <button type="button" class="btn btn-range range-chip schedule-range-chip" data-range="day">Today</button>
              <button type="button" class="btn btn-range range-chip schedule-range-chip" data-range="week">This week</button>
              <button type="button" class="btn btn-range range-chip schedule-range-chip" data-range="first15">First 15 days</button>
              <button type="button" class="btn btn-range range-chip schedule-range-chip" data-range="second15">Second 15 days</button>
              <button type="button" class="btn btn-range range-chip schedule-range-chip" data-range="month">This month</button>
              <button type="button" class="btn btn-range range-chip schedule-range-chip" data-range="season">Next 3 months</button>
              <button type="button" class="btn btn-range range-chip schedule-range-chip" data-range="year">This year</button>
            </div>
          </div>
          <div class="schedule-filter-actions schedule-filter-actions--with-cases">
            <div class="schedule-cases-switch">
              <input class="form-check-input" type="checkbox" role="switch" id="sch_hasCases">
              <label class="form-check-label" for="sch_hasCases">With cases only</label>
            </div>
            <div class="schedule-filter-actions-buttons">
              <button type="button" id="btn_resetScheduleFilters" class="btn btn-outline-secondary">Reset</button>
              <button type="button" id="btn_loadAllSchedules" class="btn btn-outline-primary">
                <i class="bi bi-cloud-arrow-down me-1"></i> Load all
              </button>
            </div>
          </div>
        </div>
        <% } else { %>
        <div class="schedule-date-panel">
          <div class="schedule-quick-dates">
            <span class="schedule-quick-dates-label">Quick range</span>
            <div class="schedule-range-group">
              <button type="button" class="btn btn-range range-chip schedule-range-chip" data-range="day">Today</button>
              <button type="button" class="btn btn-range range-chip schedule-range-chip" data-range="week">This week</button>
              <button type="button" class="btn btn-range range-chip schedule-range-chip" data-range="first15">First 15 days</button>
              <button type="button" class="btn btn-range range-chip schedule-range-chip" data-range="second15">Second 15 days</button>
              <button type="button" class="btn btn-range range-chip schedule-range-chip" data-range="month">This month</button>
              <button type="button" class="btn btn-range range-chip schedule-range-chip" data-range="season">Next 3 months</button>
              <button type="button" class="btn btn-range range-chip schedule-range-chip" data-range="year">This year</button>
            </div>
          </div>
        </div>
        <% } %>
      </div>
    </div>
  </div>

  <div class="schedule-person-tabs" id="schedulePersonTabs"></div>

  <div id="scheduleContainer" class="d-none">
    <div class="card border-0 shadow-sm">
      <div class="card-header schedule-viewbar-sticky bg-white border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="d-flex gap-3 align-items-center flex-wrap small w-100" id="legendContainer"></div>
      </div>
      <div class="card-body schedule-calendar-card-body">
        <div class="schedule-visual-layout">
          <% if (canSelectAnyPerson) { %>
          <aside id="scheduleAdminWeekRail" class="schedule-admin-week-rail d-none" aria-label="Enrollment actions">
            <div class="schedule-admin-week-rail-inner">
              <button type="button" class="btn btn-sm btn-outline-secondary schedule-view-icon-btn" data-schedule-admin-action="enroll-students" title="Enroll Students" aria-label="Enroll Students"><i class="bi bi-person-plus" aria-hidden="true"></i></button>
              <button type="button" class="btn btn-sm btn-outline-secondary schedule-view-icon-btn" data-schedule-admin-action="manage-enrollment" title="Manage Enrollment" aria-label="Manage Enrollment"><i class="bi bi-person-gear" aria-hidden="true"></i></button>
              <button type="button" class="btn btn-sm btn-outline-secondary schedule-view-icon-btn" data-schedule-admin-action="move-enrollments" title="Move Sessions/Enrollments" aria-label="Move Sessions/Enrollments"><i class="bi bi-arrow-left-right" aria-hidden="true"></i></button>
              <button type="button" class="btn btn-sm btn-outline-secondary schedule-view-icon-btn" data-schedule-admin-action="merge-sessions" title="Merge Sessions" aria-label="Merge Sessions"><i class="bi bi-intersect" aria-hidden="true"></i></button>
              <button type="button" class="btn btn-sm btn-outline-secondary schedule-view-icon-btn" data-schedule-admin-action="take-over-sessions" title="Take Over / Undo Take Over" aria-label="Take Over / Undo Take Over"><i class="bi bi-person-check" aria-hidden="true"></i></button>
              <button type="button" class="btn btn-sm btn-outline-secondary schedule-view-icon-btn" data-schedule-admin-action="add-co-teacher" title="Add Co-Teacher" aria-label="Add Co-Teacher"><i class="bi bi-people" aria-hidden="true"></i></button>
              <button type="button" class="btn btn-sm btn-outline-secondary schedule-view-icon-btn" data-schedule-admin-action="claim-numbers" title="Manage Claim Numbers" aria-label="Manage Claim Numbers"><i class="bi bi-card-checklist" aria-hidden="true"></i></button>
              <button type="button" class="btn btn-sm btn-outline-secondary schedule-view-icon-btn" data-schedule-admin-action="person-schedule-note" title="Schedule note" aria-label="Schedule note" aria-pressed="false"><i class="bi bi-journal-text" aria-hidden="true"></i></button>
            </div>
          </aside>
          <% } %>
          <div id="visualDisplayArea" class="schedule-visual-area"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="schedulePersonNoteModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header py-2 px-3">
        <h6 class="modal-title mb-0 fw-semibold" id="schedulePersonNoteModalTitle">Schedule note</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="small text-muted mb-2" id="schedulePersonNoteMeta"></p>
        <label class="form-label fw-semibold" for="schedulePersonNoteInput">Note</label>
        <textarea class="form-control" id="schedulePersonNoteInput" rows="8" maxlength="5000" placeholder="Scheduling notes for this person (visible to master schedule admins in your organization)."></textarea>
        <div class="form-text">Shared within your organization. Separate from Person Notes on the profile.</div>
      </div>
      <div class="modal-footer py-2 px-3">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary btn-sm" id="btn_schedulePersonNoteSave">Save</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="scheduleLegendModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header py-2 px-3">
        <h6 class="modal-title mb-0 fw-semibold"><i class="bi bi-info-circle me-1"></i>Schedule Legend</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div id="scheduleLegendModalBody" class="schedule-legend-modal-body"></div>
      </div>
    </div>
  </div>
</div>

<div id="scheduleSessionContextMenu" class="schedule-session-context-menu d-none" role="menu" aria-hidden="true">
  <div class="schedule-session-context-menu-header" id="scheduleSessionContextMenuHeader">
    <div class="schedule-session-context-menu-title-row">
      <button type="button" class="schedule-session-context-menu-title" id="scheduleSessionContextMenuTitle"></button>
    </div>
    <div class="schedule-session-context-header-tools">
      <% if (canOpenRollingEnrollment) { %>
      <button type="button" class="schedule-session-context-header-icon d-none" id="btn_scheduleSessionContextRollingEnrollment" role="menuitem" title="Rolling Enrollment (opens in new tab)" aria-label="Rolling Enrollment (opens in new tab)">
        <i class="bi bi-calendar-week" aria-hidden="true"></i>
      </button>
      <% } %>
      <button type="button" class="schedule-session-context-header-icon d-none" id="btn_scheduleSessionContextOpenSession" role="menuitem" title="Manage Session (opens in new tab)" aria-label="Manage Session (opens in new tab)">
        <i class="bi bi-easel2" aria-hidden="true"></i>
      </button>
      <button type="button" class="schedule-session-context-header-icon schedule-session-context-header-icon-info d-none" id="btn_scheduleSessionContextInfo" role="menuitem" title="Session info" aria-label="Session info">
        <i class="bi bi-info-circle" aria-hidden="true"></i>
      </button>
    </div>
    <div class="schedule-session-context-menu-meta" id="scheduleSessionContextMenuMeta"></div>
  </div>
  <div class="schedule-session-context-menu-actions">
    <% if (canDragCreateSessions) { %>
    <button type="button" class="schedule-session-context-action d-none" id="btn_scheduleSessionContextEdit" role="menuitem">
      <i class="bi bi-pencil-square" aria-hidden="true"></i>
      <span>Edit session</span>
    </button>
    <button type="button" class="schedule-session-context-action d-none" id="btn_scheduleSessionContextMove" role="menuitem">
      <i class="bi bi-arrows-move" aria-hidden="true"></i>
      <span>Move session</span>
    </button>
    <% } %>
    <button type="button" class="schedule-session-context-action" id="btn_scheduleSessionContextAttendance" role="menuitem">
      <i class="bi bi-clipboard2-check" aria-hidden="true"></i>
      <span>Attendance List</span>
    </button>
    <button type="button" class="schedule-session-context-action" id="btn_scheduleSessionContextEnrollment" role="menuitem">
      <i class="bi bi-people" aria-hidden="true"></i>
      <span>Enrollment List</span>
    </button>
    <% if (canSelectAnyPerson) { %>
    <button type="button" class="schedule-session-context-action d-none" id="btn_scheduleSessionContextSelect" role="menuitem">
      <i class="bi bi-check2-square" aria-hidden="true"></i>
      <span>Select</span>
    </button>
    <button type="button" class="schedule-session-context-action d-none" id="btn_scheduleSessionContextUndoTakeOver" role="menuitem">
      <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
      <span>Undo Take Over</span>
    </button>
    <% } %>
  </div>
  <% if (canDragCreateSessions || canDeleteClassSessions) { %>
  <div class="schedule-session-context-menu-divider d-none" id="scheduleSessionContextMenuBulkDivider"></div>
  <div class="schedule-session-context-menu-actions d-none" id="scheduleSessionContextMenuBulk">
    <% if (canDragCreateSessions) { %>
    <button type="button" class="schedule-session-context-action" id="btn_scheduleSessionContextEditSelected" role="menuitem">
      <i class="bi bi-pencil-square" aria-hidden="true"></i>
      <span>Edit Session(s)</span>
    </button>
    <% } %>
    <% if (canDeleteClassSessions) { %>
    <button type="button" class="schedule-session-context-action" id="btn_scheduleSessionContextDeleteSelected" role="menuitem">
      <i class="bi bi-trash3" aria-hidden="true"></i>
      <span>Delete selected</span>
    </button>
    <% } %>
  </div>
  <% } %>
  <div class="schedule-session-context-menu-divider"></div>
  <div class="schedule-session-context-menu-section-label">Session status</div>
  <div id="scheduleSessionContextStatusList" class="schedule-session-context-status-list"></div>
</div>

<% if (canDragCreateSessions) { %>
<%- include('school/partials/scheduleDraftSessionContextMenu') %>
<% } %>

<div class="modal fade" id="scheduleSessionBulkSelectModal" tabindex="-1" aria-hidden="true" aria-labelledby="scheduleSessionBulkSelectModalTitle">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg">
      <div class="modal-header">
        <h5 class="modal-title" id="scheduleSessionBulkSelectModalTitle">Select sessions</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="small text-muted mb-3" id="scheduleSessionBulkSelectHint"></p>
        <div class="mb-3">
          <div class="form-label mb-2">Select by</div>
          <div class="d-flex flex-wrap gap-3">
            <div class="form-check">
              <input class="form-check-input" type="radio" name="scheduleSessionBulkSelectMode" id="scheduleSessionBulkSelectModeCount" value="count" checked>
              <label class="form-check-label" for="scheduleSessionBulkSelectModeCount">Number of sessions</label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="scheduleSessionBulkSelectMode" id="scheduleSessionBulkSelectModeDate" value="date">
              <label class="form-check-label" for="scheduleSessionBulkSelectModeDate">Up to date</label>
            </div>
          </div>
        </div>
        <div class="mb-3">
          <div class="form-label mb-2">Weekdays</div>
          <div class="d-flex flex-wrap gap-1" id="scheduleSessionBulkSelectWeekdays" role="group" aria-label="Weekdays">
            <% ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].forEach((label, idx) => { %>
            <input type="checkbox" class="btn-check" id="scheduleSessionBulkSelectWeekday<%= idx %>" data-bulk-select-weekday="<%= idx %>" autocomplete="off" checked>
            <label class="btn btn-outline-secondary btn-sm" for="scheduleSessionBulkSelectWeekday<%= idx %>"><%= label %></label>
            <% }) %>
          </div>
        </div>
        <div class="row g-3">
          <div class="col-sm-6">
            <label class="form-label" for="scheduleSessionBulkSelectCount">Sessions</label>
            <input type="number" class="form-control form-control-sm" id="scheduleSessionBulkSelectCount" min="1" step="1" aria-label="Number of sessions to select">
          </div>
          <div class="col-sm-6">
            <label class="form-label" for="scheduleSessionBulkSelectStopDate">Up to date</label>
            <input type="date" class="form-control form-control-sm" id="scheduleSessionBulkSelectStopDate" aria-label="Stop date for selection" disabled>
          </div>
        </div>
        <p class="small text-muted mt-3 mb-0" id="scheduleSessionBulkSelectHelp">Use one option: enter a session count starting from the anchor session, or choose an end date. Only sessions on the selected weekdays are included, until that count is met or that date is reached. Start times must fall within the anchor session&rsquo;s start&ndash;end time.</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary btn-sm" id="btn_scheduleSessionBulkSelectApply">Apply</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="scheduleSessionContextInfoModal" tabindex="-1" aria-hidden="true" aria-labelledby="scheduleSessionContextInfoModalTitle">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content border-0 shadow-lg">
      <div class="modal-header">
        <div>
          <h5 class="modal-title" id="scheduleSessionContextInfoModalTitle">Session info</h5>
          <div class="small text-muted" id="scheduleSessionContextInfoModalSubtitle"></div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="scheduleSessionContextInfoModalBody"></div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="scheduleSessionAttendanceModal" tabindex="-1" aria-hidden="true" aria-labelledby="scheduleSessionAttendanceModalTitle">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
    <div class="modal-content border-0 shadow-lg">
      <div class="modal-header">
        <div>
          <h5 class="modal-title" id="scheduleSessionAttendanceModalTitle">Attendance List</h5>
          <div class="small text-muted" id="scheduleSessionAttendanceModalSubtitle"></div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-0" id="scheduleSessionAttendanceModalBody"></div>
      <div class="modal-footer flex-wrap gap-2">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
        <a href="#" class="btn btn-outline-primary" id="btn_scheduleSessionAttendanceOpenMatrix" target="_blank" rel="noopener">Open Attendance Matrix</a>
        <a href="#" class="btn btn-primary" id="btn_scheduleSessionAttendanceOpenSession" target="_blank" rel="noopener">Open Session</a>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="scheduleSessionEnrollmentModal" tabindex="-1" aria-hidden="true" aria-labelledby="scheduleSessionEnrollmentModalTitle">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
    <div class="modal-content border-0 shadow-lg">
      <div class="modal-header">
        <div>
          <h5 class="modal-title" id="scheduleSessionEnrollmentModalTitle">Enrollment List</h5>
          <div class="small text-muted" id="scheduleSessionEnrollmentModalSubtitle"></div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-0" id="scheduleSessionEnrollmentModalBody"></div>
      <div class="modal-footer flex-wrap gap-2 justify-content-between">
        <div class="small text-muted" id="scheduleSessionEnrollmentAsOfNote"></div>
        <div class="d-flex flex-wrap gap-2">
          <button type="button" class="btn btn-outline-secondary" id="btn_scheduleSessionEnrollmentRefreshCurrent" title="Refresh enrollment usage as of today">Update to today</button>
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
