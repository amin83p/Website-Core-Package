    async function promptDeleteSelectedDraftSessions(source = 'timeline') {
        const selectedIds = Array.from(getActiveDraftSelectionSet());
        if (!selectedIds.length) return;
        const ok = typeof uiConfirm === 'function'
            ? await uiConfirm(`Delete ${selectedIds.length} selected staged session(s)?`, 'Delete All')
            : confirm(`Delete ${selectedIds.length} selected staged session(s)?`);
        if (!ok) return;
        if (source === 'partialModal' && window.SessionEnrollmentCalendarModal?.deleteSelectedStagedSessions) {
            window.SessionEnrollmentCalendarModal.deleteSelectedStagedSessions(selectedIds);
            const person = activeSchedulePerson();
            if (person?.id) scheduleState.selectedDraftSessionIdsByPersonId[person.id] = new Set();
            updateScheduleDraftSelectedControls();
            return;
        }
        selectedIds.forEach((sessionId) => {
            deleteDraftSession(sessionId, { suppressRefresh: true });
        });
        const person = activeSchedulePerson();
        if (person?.id) {
            scheduleState.selectedDraftSessionIdsByPersonId[person.id] = new Set();
            recomputeDraftOverlaps(person.id);
            scheduleState.remoteUpdatePending = true;
        }
        refreshScheduleActiveView();
        syncPartialModalFromTimelineDrafts();
    }

