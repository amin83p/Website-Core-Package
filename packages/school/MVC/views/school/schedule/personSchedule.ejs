    function renderTimelineView(eventsByDate, container) {
        const scd = window.ScheduleCompletionDisplay;
        container.innerHTML = '';
        Object.keys(eventsByDate).sort().forEach(dateStr => {
            const dayEvents = eventsByDate[dateStr];
            const dateObj = new Date(dateStr + 'T00:00:00');
            const displayDate = dateObj.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });

            let tracks = [];
            const hasConflict = dayEvents.some((ev) => ev && ev.hasOverlap === true);

            dayEvents.forEach(ev => {
                const pos = calculatePosition(ev.start, ev.end);
                ev.pos = pos;

                let placed = false;
                for (let i = 0; i < tracks.length; i++) {
                    const lastEv = tracks[i][tracks[i].length - 1];
                    if (lastEv.pos.endMin <= pos.startMin) {
                        tracks[i].push(ev); ev.trackIndex = i; placed = true; break;
                    }
                }
                if (!placed) { tracks.push([ev]); ev.trackIndex = tracks.length - 1; }
            });

            const bodyHeight = Math.max(76, tracks.length * 64 + 14);
            let html = `
                <div class="timeline-container shadow-sm border ${hasConflict ? 'border-danger' : ''}">
                    <div class="timeline-header ${hasConflict ? 'conflict' : ''}">
                        <span>${escapeHtml(displayDate)}</span>
                        <span>${hasConflict ? '<i class="bi bi-exclamation-triangle-fill me-1"></i> Conflict Detected' : ''}</span>
                    </div>
                    <div class="timeline-body pb-3" style="height: ${bodyHeight}px;">
            `;
            
            dayEvents.forEach(ev => {
                const topPos = (ev.trackIndex * 62) + 7;
                const eventTitle = getEventTitle(ev);
                const cssClass = scheduleEventRoleClass(ev);
                const scan = scd ? scd.resolveScheduleCompletionScan(ev, sessionStatusMetaMap) : null;
                const blockClasses = scd
                    ? scd.buildScheduleBlockClasses(scan, `event-block ${cssClass} ${ev.hasOverlap ? 'border-danger border-2' : ''}`)
                    : `event-block ${cssClass} ${ev.hasOverlap ? 'border-danger border-2' : ''}`;
                const statusChip = scheduleStatusChip(ev, sessionStatusMetaMap, scan);
                const selectionKey = scheduleSessionSelectionKey(ev);
                const selectedClass = selectionKey && getActiveScheduleSelectionSet().has(selectionKey) ? ' is-session-selected' : '';
                const unselectableClass = selectionKey && !canSelectScheduleSession(ev) ? ' is-session-unselectable' : '';
                const selectionControl = scheduleSessionSelectHtml(ev);
                const makeupBadge = scd ? scd.buildMakeupRequiredBadge(ev, { compact: true }) : '';
                const detailsUrl = getEventDetailsUrl(ev);
                const encodedDetailsUrl = encodeURIComponent(detailsUrl);
                const caseBadge = buildSessionCaseBadgeHtml(ev?.caseSummary);
                const clickHandler = detailsUrl
                    ? `onclick="window.open(decodeURIComponent('${encodedDetailsUrl}'), '_blank')"`
                    : '';
                const tipLabel = buildScheduleEventTooltip(ev, sessionStatusMetaMap, scan);
                const tipStyle = scheduleStatusTipStyle(ev, sessionStatusMetaMap);
                const soloStudentHtml = scheduleSoloStudentHtml(ev);

                html += `
                        <div class="${blockClasses}${selectedClass}${unselectableClass}" 
                             style="left: ${ev.pos.left}%; width: ${ev.pos.width}%; top: ${topPos}px;"
                             data-schedule-session-key="${escapeHtml(selectionKey)}"
                             data-tip="${escapeHtml(tipLabel)}"
                             data-tip-bg="${escapeHtml(tipStyle.bg)}"
                             data-tip-fg="${escapeHtml(tipStyle.fg)}"
                             data-tip-border="${escapeHtml(tipStyle.border)}"
                             aria-label="${escapeHtml(tipLabel)}"
                             tabindex="0"
                             ${clickHandler}>
                             ${selectionControl}
                             ${statusChip}
                             <div class="schedule-event-title">${buildReportPriorityMarker(ev)} ${escapeHtml(eventTitle)}</div>
                             ${caseBadge ? `<div class="mt-1">${caseBadge}</div>` : ''}
                             <div class="event-meta x-small">
                                <span class="schedule-event-time text-truncate"><i class="bi bi-clock" aria-hidden="true"></i>${escapeHtml(ev.start || '-')} - ${escapeHtml(ev.end || '-')}</span>
                                ${makeupBadge}
                             </div>
                             ${soloStudentHtml}
                    </div>
                `;
            });

            html += `<div class="hour-markers">`;
            for (let h = TIMELINE_START_HOUR; h < TIMELINE_END_HOUR; h++) {
                let displayHour = h > 12 ? (h - 12) + 'p' : (h === 12 ? '12p' : h + 'a');
                html += `<div class="hour-marker"><span class="hour-label">${displayHour}</span></div>`;
            }
            html += `</div></div></div>`; 

            container.innerHTML += html;
        });
    }

    function renderVerticalTimelineView(eventsByDate, container) {
        const scd = window.ScheduleCompletionDisplay;
        const dates = Object.keys(eventsByDate || {}).sort();
        if (!dates.length) {
            container.innerHTML = `<div class="alert alert-light text-center border py-4 text-muted">No schedule items found in this range.</div>`;
