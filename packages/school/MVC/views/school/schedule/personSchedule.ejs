            event?.targetType,
            event?.status,
            event?.role,
            event?.roleLabel
        ].map((value) => String(value || '').trim().toLowerCase());
        return candidates.some((value) => value === 'leave_request' || value === 'approved_leave' || value === 'approved_leave_snapshot' || value === 'leave');
