    /* --- CALENDAR CSS (Monthly/Yearly View) --- */
    .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 3px; }
    .cal-day { aspect-ratio: 1/1; border: 1px solid #f8f9fa; border-radius: 4px; padding: 4px; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; transition: 0.2s; font-size: 0.85rem;}
