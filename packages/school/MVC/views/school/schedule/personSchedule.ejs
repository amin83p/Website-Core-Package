<div class="schedule-shell">
  <div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-white d-flex align-items-center justify-content-between py-2 px-3">
      <div class="fw-bold text-dark"><i class="bi bi-funnel me-2"></i>Filter Schedule</div>
      <button
        id="scheduleFilterToggleBtn"
        type="button"
        class="btn btn-outline-secondary btn-sm px-2"
        data-bs-toggle="collapse"
        data-bs-target="#scheduleFilterCollapse"
        aria-expanded="true"
        aria-controls="scheduleFilterCollapse"
        aria-label="Close filters">
        <i id="scheduleFilterToggleIcon" class="bi bi-chevron-up"></i>
      </button>
    </div>
    <div class="collapse show" id="scheduleFilterCollapse">
      <div class="card-body filter-panel p-3" id="scheduleFilterForm">
        <div class="schedule-toolbar-grid">
          <div class="schedule-toolbar-role">
            <label class="form-label fw-bold small mb-1" for="sch_role">Role</label>
            <select id="sch_role" class="form-select form-select-sm" <%= !canSelectAnyPerson && scheduleRoles.length <= 1 ? 'disabled' : '' %>>
              <% if (canSelectAnyPerson) { %>
                <option value="teacher" selected>Teacher</option>
                <option value="student">Student</option>
                <option value="staff">Staff</option>
                <option value="">All Roles</option>
              <% } else { %>
                <% if (!scheduleRoles.length) { %>
                  <option value="">No school role found</option>
                <% } %>
                <% scheduleRoles.forEach((role) => { %>
                  <option value="<%= role.key %>" <%= role.key === defaultRole ? 'selected' : '' %>><%= role.label %></option>
                <% }); %>
              <% } %>
            </select>
          </div>
          <div class="schedule-toolbar-people">
            <% if (canSelectAnyPerson) { %>
              <input type="hidden" id="sch_personId" value="<%= lockedPersonId %>">
              <input type="hidden" id="sch_personName" value="<%= lockedPersonName %>">
              <button type="button" class="btn btn-outline-primary btn-sm flex-fill" id="btn_openPersonPicker" title="Select people">
                <i class="bi bi-people-fill me-1"></i>Select People
              </button>
              <button type="button" class="btn btn-outline-secondary btn-sm" id="btn_clearPerson" title="Clear people">
                <i class="bi bi-x-lg"></i>
              </button>
            <% } else { %>
              <label class="form-label fw-bold small mb-1" for="sch_personName">Your Schedule Identity</label>
              <input type="hidden" id="sch_personId" value="<%= lockedPersonId %>">
              <input type="text" id="sch_personName" class="form-control form-control-sm bg-white" value="<%= lockedPersonName %>" readonly>
            <% } %>
          </div>
          <div class="schedule-toolbar-date-start">
            <label class="form-label fw-bold small mb-1" for="sch_startDate">Start Date</label>
            <input type="date" id="sch_startDate" class="form-control form-control-sm">
          </div>
          <div class="schedule-toolbar-date-end">
            <label class="form-label fw-bold small mb-1" for="sch_endDate">End Date</label>
            <input type="date" id="sch_endDate" class="form-control form-control-sm">
          </div>
          <div class="schedule-toolbar-cases">
            <label class="form-label fw-bold small mb-1" for="sch_hasCases">Cases</label>
            <div class="form-check form-switch pt-1">
              <input class="form-check-input" type="checkbox" role="switch" id="sch_hasCases">
              <label class="form-check-label small fw-semibold" for="sch_hasCases">With cases only</label>
            </div>
          </div>
          <div class="schedule-toolbar-shortcut">
            <button type="button" id="btn_openScheduleShortcuts" class="btn btn-outline-secondary btn-sm w-100">
              <i class="bi bi-calendar-range me-1"></i> Shortcut Dates
            </button>
          </div>
          <div class="schedule-toolbar-loads">
            <button type="button" id="btn_resetScheduleFilters" class="btn btn-outline-secondary btn-sm">Reset</button>
            <button type="button" id="btn_loadSchedule" class="btn btn-primary btn-sm flex-fill">
              <i class="bi bi-arrow-clockwise me-1"></i> Load Tab
            </button>
            <button type="button" id="btn_loadAllSchedules" class="btn btn-outline-primary btn-sm flex-fill">
              <i class="bi bi-cloud-arrow-down me-1"></i> Load All
            </button>
          </div>
        </div>

      </div>
    </div>
  </div>

  <div class="schedule-person-tabs" id="schedulePersonTabs"></div>

  <div id="scheduleContainer" class="d-none">
    <div class="card border-0 shadow-sm mb-3">
      <div class="card-body py-2 px-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
          <div class="text-muted small">Viewing</div>
          <div class="fw-bold text-primary m-0" id="scheduleTitle">Schedule</div>
          <div id="scheduleHoursSummary" class="schedule-hours-summary d-none">
