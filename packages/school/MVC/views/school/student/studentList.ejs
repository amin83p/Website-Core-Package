            <button type="button" class="btn btn-sm btn-outline-primary" id="mergeAdmissionsAddStudent"><i class="bi bi-ui-checks me-1"></i>Select students</button>
          </div>
          <div id="mergeAdmissionsSelectedList" class="list-group small text-muted">No students selected.</div>
        </div>
        <div class="mb-3" id="mergeAdmissionsMainWrap" hidden>
          <div class="fw-bold mb-2">Primary admission</div>
          <div id="mergeAdmissionsMainRadios" class="vstack gap-2"></div>
        </div>
        <div class="mb-3">
          <button type="button" class="btn btn-outline-secondary btn-sm" id="mergeAdmissionsPreviewBtn" disabled><i class="bi bi-search me-1"></i>Run impact preview</button>
        </div>
        <div id="mergeAdmissionsPreviewPanel" class="d-none">
