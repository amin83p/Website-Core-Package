<script>
function initializeChangeStudentSystemIdModal() {
  const modalEl = document.getElementById('changeStudentSystemIdModal');
  if (!modalEl) return;
  // Keep the modal outside page containers that establish their own stacking
  // context, otherwise Bootstrap's body-level backdrop can cover the dialog.
  if (modalEl.parentElement !== document.body) document.body.appendChild(modalEl);
  const modalApi = window.bootstrap && window.bootstrap.Modal;
  if (!modalApi) {
    console.error('[Students] Bootstrap Modal is unavailable; the Change System Record ID modal cannot be initialized.');
    return;
  }
  const modal = modalApi.getOrCreateInstance(modalEl);
  const alertEl = document.getElementById('changeSystemIdAlert');
  const currentEl = document.getElementById('changeSystemIdCurrent');
  const newEl = document.getElementById('changeSystemIdNew');
  const confirmationEl = document.getElementById('changeSystemIdConfirmation');
  const impactEl = document.getElementById('changeSystemIdImpact');
  const submitBtn = document.getElementById('changeSystemIdSubmit');
  let actionStateId = <%- JSON.stringify(actionStateId || '').replace(/</g, '\u003c') %>;

  function formatMessageMarkup(value) {
    return String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/&lt;b&gt;/gi, '<b>')
      .replace(/&lt;\/b&gt;/gi, '</b>')
      .replace(/&lt;br\s*\/?&gt;/gi, '<br>');
  }
  function isSecurityMessage(message) {
    return /security violation|session validation failed|action state token/i.test(String(message || ''));
  }
  async function showError(message, { useMessageModal = false } = {}) {
    alertEl.innerHTML = formatMessageMarkup(message || 'Unable to change the System Record ID.');
    alertEl.classList.remove('d-none');
    if (!useMessageModal || typeof window.showMessageModal !== 'function') return;
    const shouldRestore = modalEl.classList.contains('show');
    if (shouldRestore) {
      await new Promise((resolve) => {
        modalEl.addEventListener('hidden.bs.modal', resolve, { once: true });
        modal.hide();
      });
    }
    await window.showMessageModal({
      title: isSecurityMessage(message) ? 'Security Validation Failed' : 'Operation Failed',
      icon: 'error',
      message: formatMessageMarkup(message || 'Unable to change the System Record ID.'),
      buttons: [{ text: 'OK', class: 'btn-danger', value: true }]
    });
    if (shouldRestore) modal.show();
  }
  function clearError() { alertEl.classList.add('d-none'); alertEl.textContent = ''; }
  async function readJson(response) {
    const result = await response.json().catch(() => ({}));
    if (!response.ok || result.status === 'error') {
      const error = new Error(result.message || 'Request failed.');
      error.migrationId = result.migrationId || '';
      error.rollbackStatus = result.rollbackStatus || '';
      throw error;
    }
    return result;
  }
  function renderImpact(data) {
    const rows = Array.isArray(data?.collections) ? data.collections.filter((row) => Number(row.count) > 0) : [];
    impactEl.innerHTML = rows.length
      ? '<div class="list-group">' + rows.map((row) => '<div class="list-group-item d-flex justify-content-between"><span>' + String(row.label || row.key) + '</span><span class="badge bg-primary">' + Number(row.count || 0) + '</span></div>').join('') + '</div><div class="mt-2 fw-bold">Total references: ' + Number(data.totalUpdates || 0) + '</div>'
      : '<div class="text-muted">Only the student record will be updated.</div>';
  }
  const originalRenderImpact = renderImpact;
  renderImpact = function renderImpactWithMode(data) {
    originalRenderImpact(data);
    if (data?.transactionMode === 'compensating') {
      const notice = document.createElement('div');
      notice.className = 'alert alert-info py-2 mb-2';
      notice.textContent = 'Standalone MongoDB detected. The migration will use protected rollback mode.';
      impactEl.prepend(notice);
    }
  };
  document.querySelectorAll('.change-system-id-btn').forEach((button) => {
    button.addEventListener('click', async () => {
      clearError();
      currentEl.value = button.dataset.id || '';
      newEl.value = '';
      confirmationEl.value = '';
      document.getElementById('changeSystemIdStudentName').textContent = button.dataset.name || button.dataset.id || 'Student';
      impactEl.textContent = 'Loading impact preview...';
      submitBtn.disabled = true;
      modal.show();
      try {
        const result = await readJson(await fetch('/school/students/' + encodeURIComponent(currentEl.value) + '/system-id-impact', { headers: { Accept: 'application/json', 'X-Ajax-Request': 'true' } }));
        if (result.actionStateId) actionStateId = result.actionStateId;
        renderImpact(result.data);
        submitBtn.disabled = false;
      } catch (error) { await showError(error.message, { useMessageModal: true }); impactEl.textContent = 'Impact preview unavailable.'; }
    });
  });
  document.getElementById('changeSystemIdGenerate').addEventListener('click', async () => {
    clearError();
    try {
      const result = await readJson(await fetch('/school/students/' + encodeURIComponent(currentEl.value) + '/system-id-generate', { headers: { Accept: 'application/json', 'X-Ajax-Request': 'true' } }));
      if (result.actionStateId) actionStateId = result.actionStateId;
      newEl.value = result.data?.id || '';
      confirmationEl.value = '';
      newEl.focus();
    } catch (error) { await showError(error.message, { useMessageModal: true }); }
  });
  submitBtn.addEventListener('click', async () => {
    clearError();
    const newId = newEl.value.trim();
    const confirmationId = confirmationEl.value.trim();
    if (!newId || !/^[A-Za-z0-9_-]{1,40}$/.test(newId)) return showError('Enter a valid 1-40 character System Record ID using letters, numbers, underscores, or hyphens.');
    if (confirmationId !== newId) return showError('Confirmation must exactly match the replacement System Record ID.');
    submitBtn.disabled = true;
    const waitingToken = typeof window.showLoading === 'function'
      ? window.showLoading({ title: 'Changing Student System Record ID', message: 'Updating references and verifying the migration. Please wait...' })
      : null;
    try {
      const result = await readJson(await fetch('/school/students/' + encodeURIComponent(currentEl.value) + '/change-system-id', {
        method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json', 'X-Ajax-Request': 'true' },
        body: JSON.stringify({ newId, confirmationId, actionStateId })
      }));
      window.location.href = result.redirectTo || result.data?.redirectTo || '/school/students';
    } catch (error) {
      await showError(error.message, { useMessageModal: true });
      submitBtn.disabled = false;
    } finally {
      if (waitingToken && typeof window.hideLoading === 'function') window.hideLoading(waitingToken);
    }
  });
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initializeChangeStudentSystemIdModal, { once: true });
} else {
  initializeChangeStudentSystemIdModal();
}

<% if (typeof canMergeStudentAdmissions !== 'undefined' && canMergeStudentAdmissions) { %>
function initializeMergeStudentAdmissionsModal() {
  const openBtn = document.getElementById('btnMergeStudentAdmissions');
  const modalEl = document.getElementById('mergeStudentAdmissionsModal');
  if (!openBtn || !modalEl) return;
  if (modalEl.parentElement !== document.body) document.body.appendChild(modalEl);
  const readFirstEl = document.getElementById('mergeAdmissionsReadFirstModal');
  const previewModalEl = document.getElementById('mergeAdmissionsPreviewModal');
  if (readFirstEl && readFirstEl.parentElement !== document.body) document.body.appendChild(readFirstEl);
  if (previewModalEl && previewModalEl.parentElement !== document.body) document.body.appendChild(previewModalEl);
  const modalApi = window.bootstrap && window.bootstrap.Modal;
  if (!modalApi) return;
  const modal = modalApi.getOrCreateInstance(modalEl);
  const readFirstModal = readFirstEl ? modalApi.getOrCreateInstance(readFirstEl) : null;
  const previewResultModal = previewModalEl ? modalApi.getOrCreateInstance(previewModalEl) : null;
  if (previewModalEl) {
    previewModalEl.addEventListener('shown.bs.modal', () => {
      previewModalEl.style.zIndex = '1070';
      const backdrops = document.querySelectorAll('.modal-backdrop');
      const topBackdrop = backdrops[backdrops.length - 1];
      if (topBackdrop) topBackdrop.style.zIndex = '1065';
    });
    previewModalEl.addEventListener('hidden.bs.modal', () => {
      if (modalEl.classList.contains('show')) document.body.classList.add('modal-open');
    });
  }
  const readFirstBtn = document.getElementById('mergeAdmissionsMustRead');
  const readConfirmBtn = document.getElementById('mergeAdmissionsReadConfirm');
  const gateEl = document.getElementById('mergeAdmissionsGate');
  const workEl = document.getElementById('mergeAdmissionsWork');
  let operationAcknowledged = false;
  function setMergeLocked(locked) {
    operationAcknowledged = !locked;
    if (workEl) {
      workEl.classList.toggle('pe-none', locked);
      workEl.classList.toggle('opacity-50', locked);
    }
    if (gateEl) gateEl.classList.toggle('d-none', !locked);
  }
  if (readFirstBtn && readFirstModal) {
    readFirstBtn.addEventListener('click', () => {
      readFirstModal.show();
    });
  }
  if (readConfirmBtn && readFirstModal) {
    readConfirmBtn.addEventListener('click', () => {
      setMergeLocked(false);
      readFirstModal.hide();
    });
  }
  if (readFirstEl) {
    readFirstEl.addEventListener('shown.bs.modal', () => {
      readFirstEl.style.zIndex = '1065';
      const backdrops = document.querySelectorAll('.modal-backdrop');
      const topBackdrop = backdrops[backdrops.length - 1];
      if (topBackdrop) topBackdrop.style.zIndex = '1060';
    });
    readFirstEl.addEventListener('hidden.bs.modal', () => {
      if (modalEl.classList.contains('show')) document.body.classList.add('modal-open');
    });
  }
  const selected = new Map();
  let mainStudentId = '';
  let previewToken = '';
  let actionStateId = <%- JSON.stringify(actionStateId || '').replace(/</g, '\u003c') %>;
  const alertEl = document.getElementById('mergeAdmissionsAlert');
  const listEl = document.getElementById('mergeAdmissionsSelectedList');
  const mainWrap = document.getElementById('mergeAdmissionsMainWrap');
  const mainRadios = document.getElementById('mergeAdmissionsMainRadios');
  const previewBtn = document.getElementById('mergeAdmissionsPreviewBtn');
  const previewPanel = document.getElementById('mergeAdmissionsPreviewPanel');
  const impactEl = document.getElementById('mergeAdmissionsImpact');
  const blockersEl = document.getElementById('mergeAdmissionsBlockers');
  const warningsEl = document.getElementById('mergeAdmissionsWarnings');
  const submitBtn = document.getElementById('mergeAdmissionsSubmit');
  const confirmEl = document.getElementById('mergeAdmissionsConfirm');
  const confirmMainEl = document.getElementById('mergeAdmissionsConfirmMainId');

  function escapeHtml(value) {
    return String(value || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }
  function clearAlert() { alertEl.classList.add('d-none'); alertEl.textContent = ''; }
  function showAlert(message) {
    alertEl.textContent = String(message || 'Request failed.');
    alertEl.classList.remove('d-none');
  }
  async function readJson(response) {
    const result = await response.json().catch(() => ({}));
    if (!response.ok || result.status === 'error') throw new Error(result.message || 'Request failed.');
    return result;
  }
  function studentLabel(item) {
    const name = String(item?.name || '').trim() || `${item?.firstName || ''} ${item?.lastName || ''}`.trim();
    const id = String(item?.customStudentId || item?.id || '').trim();
    return name ? `${name} (${id})` : id;
  }
  function renderSelected() {
    if (!selected.size) {
      listEl.innerHTML = 'No students selected.';
      mainWrap.hidden = true;
      mainRadios.innerHTML = '';
      mainStudentId = '';
      previewBtn.disabled = true;
      submitBtn.disabled = true;
      return;
    }
    listEl.innerHTML = [...selected.values()].map((stu) => (
      `<div class="list-group-item d-flex justify-content-between align-items-center">`
      + `<span>${escapeHtml(studentLabel(stu))}</span>`
      + `<button type="button" class="btn btn-sm btn-outline-danger" data-remove-id="${escapeHtml(stu.id)}">Remove</button>`
      + `</div>`
    )).join('');
    listEl.querySelectorAll('[data-remove-id]').forEach((btn) => {
      btn.addEventListener('click', () => {
        selected.delete(btn.dataset.removeId);
        if (mainStudentId === btn.dataset.removeId) mainStudentId = '';
        previewToken = '';
        previewPanel.classList.add('d-none');
        renderSelected();
        renderMainRadios();
      });
    });
    renderMainRadios();
    previewBtn.disabled = selected.size < 2 || !mainStudentId;
  }
  function renderMainRadios() {
    if (selected.size < 2) {
      mainWrap.hidden = true;
      mainRadios.innerHTML = '';
      return;
    }
    mainWrap.hidden = false;
    const ids = [...selected.keys()];
    if (!mainStudentId || !selected.has(mainStudentId)) mainStudentId = ids[0];
    mainRadios.innerHTML = ids.map((id) => {
      const stu = selected.get(id);
      const checked = id === mainStudentId ? ' checked' : '';
      return `<label class="form-check border rounded p-2"><input class="form-check-input" type="radio" name="mergeMainStudent" value="${escapeHtml(id)}"${checked}><span class="form-check-label">${escapeHtml(studentLabel(stu))}</span></label>`;
    }).join('');
    mainRadios.querySelectorAll('input[name="mergeMainStudent"]').forEach((input) => {
      input.addEventListener('change', () => {
        mainStudentId = input.value;
        previewToken = '';
        previewPanel.classList.add('d-none');
        previewBtn.disabled = !mainStudentId;
        submitBtn.disabled = true;
      });
    });
    previewBtn.disabled = !mainStudentId;
  }
  function mergeIdList() {
    return [...selected.keys()];
  }
  function listItems(rows, emptyText) {
    const items = Array.isArray(rows) ? rows.filter(Boolean) : [];
    if (!items.length) return `<div class="text-muted">${escapeHtml(emptyText)}</div>`;
    return `<ul class="mb-0">${items.map((row) => `<li>${escapeHtml(row)}</li>`).join('')}</ul>`;
  }
  function renderPreviewModal(data, cols) {
    const body = document.getElementById('mergeAdmissionsPreviewModalBody');
    if (!body) return;
    const program = data.registrationPlan?.program || {};
    const periods = data.registrationPlan?.periods || {};
    const students = Array.isArray(data.students) ? data.students : [];
    const programLines = [
      ...(program.dateUpdates || []).map((row) => `Program ${row.programLabel || row.programId}: primary registration date becomes ${row.registrationDate || 'the oldest date'}.`),
      ...(program.adopts || []).map((row) => `Program ${row.programLabel || row.programId} is added to the primary admission with date ${row.registrationDate || 'the oldest date'}.`),
      ...(program.voids || []).map((row) => `The extra registration for program ${row.programLabel || row.programId} will be voided after enrollments move.`)
    ];
    const enrollmentLines = [
      ...(periods.moves || []).map((row) => `Class ${row.classLabel || row.classId}: enrollment moves to the primary admission.`),
      ...(periods.merges || []).map((row) => `Class ${row.classLabel || row.classId}: both enrollments are combined. The earlier start is kept.`)
    ];
    const conflictLines = Array.isArray(data.blockers) ? data.blockers : [];
    const warningLines = Array.isArray(data.warnings) ? data.warnings : [];
    body.innerHTML = `
      <p>${data.ready ? 'Nothing is blocking this merge. Review the summary, then go back and confirm.' : 'This merge cannot continue until the conflicts below are resolved.'}</p>
      <h6 class="fw-bold">Admissions</h6>
      ${listItems(students.map((row) => `${row.admissionLabel || row.name || row.studentId}${row.isMain ? ' — primary' : ''}`), 'No admissions.')}
      <h6 class="fw-bold mt-3">Program registrations</h6>
      ${listItems(programLines, 'No program registration changes.')}
      <h6 class="fw-bold mt-3">Class enrollments</h6>
      ${listItems(enrollmentLines, 'No class enrollment changes.')}
      <h6 class="fw-bold mt-3">Conflicts</h6>
      ${listItems(conflictLines, 'No conflicts.')}
      <h6 class="fw-bold mt-3">Notes</h6>
      ${listItems(warningLines, 'No extra notes.')}
      <h6 class="fw-bold mt-3">Other records</h6>
      ${cols.length ? `<ul class="mb-0">${cols.map((row) => `<li>${escapeHtml(row.label || row.key)}: ${Number(row.count || 0)}</li>`).join('')}</ul>` : '<div class="text-muted">No other counted records.</div>'}
    `;
  }
  document.getElementById('mergeAdmissionsAddStudent').addEventListener('click', () => {
    if (!window.GenericPicker || !window.GenericPickerPresets) {
      showAlert('Student picker is not available on this page.');
      return;
    }
    GenericPicker.open(GenericPickerPresets.student({
      title: 'Select admissions to merge',
      placeholder: 'Search students, then select one or more...',
      multiselect: true,
      selectedItems: [...selected.values()],
      context: (window.GenericPickerContexts && typeof window.GenericPickerContexts.activeOrganizationScope === 'function')
        ? window.GenericPickerContexts.activeOrganizationScope({ label: 'Active Organization' })
        : undefined,
      onSelect: (picked) => {
        const items = Array.isArray(picked) ? picked : (picked ? [picked] : []);
        selected.clear();
        items.forEach((item) => {
          const id = String(item?.id || '').trim();
          if (id) selected.set(id, item);
        });
        if (mainStudentId && !selected.has(mainStudentId)) mainStudentId = '';
        previewToken = '';
        previewPanel.classList.add('d-none');
        renderSelected();
      }
    }));
  });
  openBtn.addEventListener('click', () => {
    clearAlert();
    previewToken = '';
    previewPanel.classList.add('d-none');
    confirmEl.value = '';
    confirmMainEl.value = '';
    submitBtn.disabled = true;
    setMergeLocked(true);
    modal.show();
  });
  previewBtn.addEventListener('click', async () => {
    clearAlert();
    previewBtn.disabled = true;
    const waitingToken = typeof window.showLoading === 'function'
      ? window.showLoading({
        title: 'Reviewing the merge',
        message: 'Please wait...',
        operation: 'Starting the review',
        progress: 5
      })
      : null;
    const previewJobId = `merge-preview-${Date.now()}`;
    let progressTimer = 0;
    let previewProgressStopped = false;
    const readPreviewProgress = async () => {
      if (previewProgressStopped) return;
      try {
        const progressResponse = await fetch(`/school/students/api/merge-admissions/preview-progress?jobId=${encodeURIComponent(previewJobId)}`, {
          headers: { Accept: 'application/json', 'X-Ajax-Request': 'true' }
        });
        const progressResult = await progressResponse.json().catch(() => ({}));
        if (previewProgressStopped) return;
        const progressData = progressResult.data || {};
        if (typeof window.updateLoading === 'function') {
          window.updateLoading({
            title: 'Reviewing the merge',
            message: 'Please wait...',
            operation: progressData.operation || 'Reviewing the merge',
            progress: Number(progressData.progress || 0)
          });
        }
      } catch (_) {
        // The preview request still completes if a progress check fails.
      }
    };
    try {
      progressTimer = window.setInterval(readPreviewProgress, 400);
      const response = await fetch('/school/students/api/merge-admissions/preview', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json', 'X-Ajax-Request': 'true' },
        body: JSON.stringify({ mainStudentId, mergeStudentIds: mergeIdList(), actionStateId, previewJobId })
      });
      const result = await readJson(response);
      if (result.actionStateId) actionStateId = result.actionStateId;
      const data = result.data || {};
      previewToken = data.previewToken || '';
      const cols = Array.isArray(data.impacts?.collections) ? data.impacts.collections.filter((row) => Number(row.count) > 0) : [];
      renderPreviewModal(data, cols);
      previewProgressStopped = true;
      if (progressTimer) window.clearInterval(progressTimer);
      if (typeof window.updateLoading === 'function') {
        window.updateLoading({
          title: 'Reviewing the merge',
          message: 'Please wait...',
          operation: 'Preparing the summary',
          progress: 100
        });
      }
      if (waitingToken && typeof window.hideLoading === 'function') window.hideLoading(waitingToken);
      if (previewResultModal) previewResultModal.show();
      impactEl.innerHTML = cols.length
        ? `<div>References to repoint: ${Number(data.impacts?.studentTotal || 0) + Number(data.impacts?.personTotal || 0)} (${Number(data.impacts?.sessionTouchCount || 0)} session roster touches)</div>`
          + `<ul class="mb-0">${cols.map((row) => `<li>${escapeHtml(row.label || row.key)}: ${Number(row.count || 0)}</li>`).join('')}</ul>`
        : '<div>No counted references outside the student rows.</div>';
      if (Array.isArray(data.blockers) && data.blockers.length) {
        blockersEl.classList.remove('d-none');
        blockersEl.innerHTML = data.blockers.map((row) => `<div>${escapeHtml(row)}</div>`).join('');
        submitBtn.disabled = true;
      } else {
        blockersEl.classList.add('d-none');
        blockersEl.innerHTML = '';
        submitBtn.disabled = !data.ready;
      }
      if (Array.isArray(data.warnings) && data.warnings.length) {
        warningsEl.classList.remove('d-none');
        warningsEl.innerHTML = data.warnings.map((row) => `<div>${escapeHtml(row)}</div>`).join('');
      } else {
        warningsEl.classList.add('d-none');
        warningsEl.innerHTML = '';
      }
    } catch (error) {
      showAlert(error.message);
    } finally {
      previewProgressStopped = true;
      if (progressTimer) window.clearInterval(progressTimer);
      if (waitingToken && typeof window.hideLoading === 'function') window.hideLoading(waitingToken);
      previewBtn.disabled = selected.size < 2 || !mainStudentId;
    }
  });
  submitBtn.addEventListener('click', async () => {
    clearAlert();
    if (!operationAcknowledged) {
      showAlert('Read the operation steps and confirm before merging.');
      return;
    }
    if (String(confirmEl.value || '').trim().toUpperCase() !== 'MERGE') {
      showAlert('Type MERGE to confirm.');
      return;
    }
  if (String(confirmMainEl.value || '').trim() !== String(mainStudentId || '').trim()) {
      showAlert('Primary system record id must match the selected primary admission.');
      return;
    }
    submitBtn.disabled = true;
    const waitingToken = typeof window.showLoading === 'function'
      ? window.showLoading({ title: 'Merging admissions', message: 'Repointing references and verifying. Please wait...' })
      : null;
    try {
      const result = await readJson(await fetch('/school/students/api/merge-admissions/execute', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json', 'X-Ajax-Request': 'true' },
        body: JSON.stringify({
          mainStudentId,
          mergeStudentIds: mergeIdList(),
          previewToken,
          confirmation: confirmEl.value.trim(),
          confirmationMainStudentId: confirmMainEl.value.trim(),
          actionStateId
        })
      }));
      window.location.href = result.redirectTo || result.data?.redirectTo || '/school/students';
    } catch (error) {
      showAlert(error.message);
      submitBtn.disabled = false;
    } finally {
      if (waitingToken && typeof window.hideLoading === 'function') window.hideLoading(waitingToken);
    }
  });
}
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initializeMergeStudentAdmissionsModal, { once: true });
} else {
  initializeMergeStudentAdmissionsModal();
}
<% } %>
</script>
