          <input id="mergeAdmissionsConfirmMainId" class="form-control font-monospace" placeholder="Primary student system record id" autocomplete="off">
        </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger" id="mergeAdmissionsSubmit" disabled>Merge admissions</button>
      </div>
