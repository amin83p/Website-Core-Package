    } catch (error) {
      executeStopped = true;
      if (progressTimer) window.clearInterval(progressTimer);
      if (executeSummaryEl) executeSummaryEl.textContent = error.message || 'The merge failed.';
      if (executeCloseBtn) executeCloseBtn.disabled = false;
      showAlert(error.message);
      submitBtn.disabled = false;
    }
  });
}
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initializeMergeStudentAdmissionsModal, { once: true });
} else {
  initializeMergeStudentAdmissionsModal();
}
<% } %>
</script>
