<style>
  #studentImportPreviewTable th, #studentImportPreviewTable td {
    vertical-align: middle;
  }
  .duplicate-warning {
    color: #856404;
    background-color: #fff3cd;
    border-color: #ffeeba;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.8em;
    display: inline-block;
    margin-top: 4px;
  }
</style>

<div class="modal fade" id="studentImportModal" tabindex="-100" aria-labelledby="studentImportModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false"
  data-can-create-program-registrations="<%= typeof canCreateProgramRegistrations !== 'undefined' && canCreateProgramRegistrations ? '1' : '0' %>">
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; overflow: hidden;">

      <div class="modal-header border-bottom-0 pb-0 bg-white">
        <h5 class="modal-title fw-bold text-primary" id="studentImportModalLabel">
            <i class="bi bi-person-plus-fill me-2"></i>Import Students
        </h5>
        <button type="button" class="btn-close close-on-complete" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body pt-2">
        <form id="studentImportForm" enctype="multipart/form-data">
          
          <!-- Step 1: Upload -->
          <div id="studentImportSetupContent">
            <div class="alert alert-light border shadow-sm d-flex align-items-center p-3 mb-4 rounded-3">
              <div class="rounded-circle bg-success-subtle text-success d-flex align-items-center justify-content-center me-3" 
                   style="width: 48px; height: 48px; min-width: 48px;">
                <i class="bi bi-file-earmark-spreadsheet fs-4"></i>
              </div>
              <div>
                <div class="small text-muted text-uppercase fw-bold" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                    Step 1
                </div>
                <div class="fw-bold fs-5 text-dark">Upload CSV File</div>
              </div>
            </div>

            <div class="mb-4">
              <label for="studentImportFile" class="form-label fw-bold text-secondary small text-uppercase">Select File</label>
              <div class="input-group input-group-lg">
                  <input class="form-control" type="file" id="studentImportFile" name="importFile" accept=".csv" required>
              </div>
              <div class="form-text text-muted fst-italic ps-1">
                  Supported format: .csv
              </div>
            </div>
          </div>

          <!-- Step 2: Preview -->
          <div id="studentImportPreviewContent" style="display:none;">
            <div class="alert alert-light border shadow-sm d-flex align-items-center p-3 mb-4 rounded-3">
              <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center me-3" 
                   style="width: 48px; height: 48px; min-width: 48px;">
                <i class="bi bi-list-check fs-4"></i>
              </div>
              <div>
                <div class="small text-muted text-uppercase fw-bold" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                    Step 2
                </div>
                <div class="fw-bold fs-5 text-dark">Review & Select Students</div>
              </div>
            </div>

            <div class="table-responsive border rounded" style="max-height: 400px;">
              <table class="table table-sm table-hover mb-0" id="studentImportPreviewTable">
                <thead class="table-light sticky-top">
                  <tr>
                    <th style="width: 40px;" class="text-center">
                      <input class="form-check-input" type="checkbox" id="studentImportSelectAll" checked>
                    </th>
                    <th>Name</th>
                    <th>Gender</th>
                    <th>Email</th>
                    <th>CLB Current</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody id="studentImportPreviewBody">
                  <!-- Rows will be populated here -->
                </tbody>
              </table>
            </div>
            <div class="mt-2 text-end small text-muted">
              <span id="studentImportSelectedCount">0</span> students selected
            </div>
          </div>

          <!-- Step 3: Programs -->
          <div id="studentImportProgramsContent" style="display:none;">
            <div class="alert alert-light border shadow-sm d-flex align-items-center p-3 mb-4 rounded-3">
              <div class="rounded-circle bg-info-subtle text-info d-flex align-items-center justify-content-center me-3"
                   style="width: 48px; height: 48px; min-width: 48px;">
                <i class="bi bi-journal-bookmark-fill fs-4"></i>
              </div>
              <div>
                <div class="small text-muted text-uppercase fw-bold" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                    Step 3
                </div>
                <div class="fw-bold fs-5 text-dark">Program Registrations</div>
              </div>
            </div>

            <div class="alert alert-light border shadow-sm mb-4">
              <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div>
                  <h6 class="fw-bold mb-1"><i class="bi bi-journal-bookmark-fill me-2"></i>Optional Program Registrations</h6>
                  <p class="small text-muted mb-0">Selected programs will be registered for every imported student. Zero-fee programs finalize automatically; programs with fees are saved as drafts for review. Registration dates must be on or after each student's admission date.</p>
                </div>
                <button type="button" class="btn btn-primary btn-sm fw-bold" id="studentImportBtnAddProgram">
                  <i class="bi bi-plus-circle me-1"></i>Add Program
                </button>
              </div>
            </div>

            <div class="card border-0 shadow-sm">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                  <div>
                    <div class="fw-bold">Programs to Register</div>
                    <div class="small text-muted">Skip this step by continuing without adding programs.</div>
                  </div>
                  <span class="badge bg-light text-dark border" id="studentImportProgramCountBadge">0 selected</span>
                </div>
                <div class="table-responsive">
                  <table class="table table-sm align-middle mb-0">
                    <thead class="table-light">
                      <tr>
                        <th style="min-width: 260px;">Program</th>
                        <th style="width: 170px;">Registration Date</th>
                        <th style="min-width: 190px;">External Reference</th>
                        <th style="min-width: 260px;">Note</th>
                        <th class="text-end" style="width: 80px;">Actions</th>
                      </tr>
                    </thead>
                    <tbody id="studentImportProgramTbody">
                      <tr><td colspan="5" class="text-center text-muted py-4">No program registrations selected.</td></tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>

          <!-- Step 4: Results -->
          <div id="studentImportResultContent" style="display:none;">
            <div class="alert alert-light border shadow-sm d-flex align-items-center p-3 mb-4 rounded-3">
              <div class="rounded-circle bg-success-subtle text-success d-flex align-items-center justify-content-center me-3" 
                   style="width: 48px; height: 48px; min-width: 48px;">
                <i class="bi bi-check-circle fs-4"></i>
              </div>
              <div>
                <div class="small text-muted text-uppercase fw-bold" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                    Step 4
                </div>
                <div class="fw-bold fs-5 text-dark">Import Results</div>
              </div>
            </div>

            <div class="table-responsive border rounded" style="max-height: 400px;">
              <table class="table table-sm table-hover mb-0">
                <thead class="table-light sticky-top">
                  <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Programs</th>
                    <th>Result</th>
                  </tr>
                </thead>
                <tbody id="studentImportResultBody">
                  <!-- Results will be populated here -->
                </tbody>
              </table>
            </div>
          </div>

        </form>
      </div>

      <div class="modal-footer bg-light border-top-0 py-3">
        <button type="button" class="btn btn-secondary btn-sm rounded-pill px-4 close-on-complete" data-bs-dismiss="modal" id="studentImportCloseBtn">Close</button>
        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-4" id="studentImportBackBtn" style="display:none;">Back</button>
        <button type="button" class="btn btn-primary btn-sm rounded-pill px-4 shadow-sm" id="studentImportPreviewBtn">Preview Import</button>
        <button type="button" class="btn btn-primary btn-sm rounded-pill px-4 shadow-sm" id="studentImportContinueBtn" style="display:none;">Continue</button>
        <button type="button" class="btn btn-success btn-sm rounded-pill px-4 shadow-sm" id="studentImportProcessBtn" style="display:none;">Import Selected</button>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const modalEl = document.getElementById('studentImportModal');
  if (!modalEl) return;

  const modal = new bootstrap.Modal(modalEl);
  const openBtn = document.getElementById('openBatchModalBtn');
  const canCreateProgramRegistrations = modalEl.dataset.canCreateProgramRegistrations === '1';

  const setupContent = document.getElementById('studentImportSetupContent');
  const previewContent = document.getElementById('studentImportPreviewContent');
  const programsContent = document.getElementById('studentImportProgramsContent');
  const resultContent = document.getElementById('studentImportResultContent');

  const previewBtn = document.getElementById('studentImportPreviewBtn');
  const backBtn = document.getElementById('studentImportBackBtn');
  const continueBtn = document.getElementById('studentImportContinueBtn');
  const processBtn = document.getElementById('studentImportProcessBtn');
  const closeBtn = document.getElementById('studentImportCloseBtn');

  const fileInput = document.getElementById('studentImportFile');
  const previewBody = document.getElementById('studentImportPreviewBody');
  const selectAllCb = document.getElementById('studentImportSelectAll');
  const selectedCountEl = document.getElementById('studentImportSelectedCount');
  const resultBody = document.getElementById('studentImportResultBody');

  const btnAddProgram = document.getElementById('studentImportBtnAddProgram');
  const programTbody = document.getElementById('studentImportProgramTbody');
  const programCountBadge = document.getElementById('studentImportProgramCountBadge');

  let parsedRows = [];
  let defaultAdmissionDate = '';
  let selectedProgramRegistrations = [];
  let currentStep = 'setup';

  function safeHtml(s) {
    return String(s ?? '').replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  }

  function isDateOnly(value) {
    const token = String(value || '').trim();
    if (!/^\d{4}-\d{2}-\d{2}$/.test(token)) return false;
    const parsed = new Date(token + 'T00:00:00.000Z');
    return !Number.isNaN(parsed.getTime()) && parsed.toISOString().slice(0, 10) === token;
  }

  function showMessage(title, icon, message) {
    if (typeof window.showMessageModal === 'function') {
      window.showMessageModal({ title, icon, message, buttons: [{ text: 'OK', class: 'btn-primary' }] });
    } else {
      alert(message);
    }
  }

  if (openBtn) {
    openBtn.addEventListener('click', () => {
      resetModal();
      modal.show();
    });
  }

  function hideAllSteps() {
    setupContent.style.display = 'none';
    previewContent.style.display = 'none';
    programsContent.style.display = 'none';
    resultContent.style.display = 'none';
  }

  function showStep(step) {
    currentStep = step;
    hideAllSteps();
    previewBtn.style.display = 'none';
    backBtn.style.display = 'none';
    continueBtn.style.display = 'none';
    processBtn.style.display = 'none';

    if (step === 'setup') {
      setupContent.style.display = 'block';
      previewBtn.style.display = 'block';
    } else if (step === 'preview') {
      previewContent.style.display = 'block';
      backBtn.style.display = 'block';
      continueBtn.style.display = 'block';
    } else if (step === 'programs') {
      programsContent.style.display = 'block';
      backBtn.style.display = 'block';
      processBtn.style.display = 'block';
    } else if (step === 'results') {
      resultContent.style.display = 'block';
    }
  }

  function resetModal() {
    document.getElementById('studentImportForm').reset();
    showStep('setup');

    previewBtn.disabled = false;
    previewBtn.innerHTML = 'Preview Import';
    continueBtn.disabled = false;
    continueBtn.innerHTML = 'Continue';
    processBtn.disabled = false;
    processBtn.innerHTML = 'Import Selected';

    parsedRows = [];
    defaultAdmissionDate = '';
    selectedProgramRegistrations = [];
    previewBody.innerHTML = '';
    resultBody.innerHTML = '';
    renderProgramRegistrationSelections();
  }

  function resolveDefaultRegistrationDate() {
    if (isDateOnly(defaultAdmissionDate)) return defaultAdmissionDate;
    const selectedIndexes = Array.from(previewBody.querySelectorAll('.row-checkbox:checked'))
      .map(cb => parseInt(cb.dataset.index, 10));
    for (const idx of selectedIndexes) {
      const enrollmentDate = String(parsedRows[idx]?.data?.enrollmentDate || '').trim();
      if (isDateOnly(enrollmentDate)) return enrollmentDate;
    }
    return '';
  }

  function renderProgramRegistrationSelections() {
    if (!programTbody) return;
    if (!selectedProgramRegistrations.length) {
      programTbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-4">No program registrations selected.</td></tr>';
      if (programCountBadge) programCountBadge.textContent = '0 selected';
      return;
    }
    programTbody.innerHTML = selectedProgramRegistrations.map((row, index) => {
      const programLabel = row.programLabel || row.programId || 'Program';
      return [
        '<tr data-import-program-index="' + index + '">',
          '<td>',
            '<div class="fw-bold text-dark">' + safeHtml(programLabel) + '</div>',
            '<div class="small text-muted font-monospace">' + safeHtml(row.programId || '') + '</div>',
          '</td>',
          '<td><input type="date" class="form-control form-control-sm import-program-registration-date" value="' + safeHtml(row.registrationDate || '') + '" required></td>',
          '<td><input type="text" class="form-control form-control-sm import-program-registration-reference" value="' + safeHtml(row.externalReference || '') + '" maxlength="200" placeholder="Optional"></td>',
          '<td><input type="text" class="form-control form-control-sm import-program-registration-note" value="' + safeHtml(row.note || '') + '" maxlength="2000" placeholder="Optional note"></td>',
          '<td class="text-end"><button type="button" class="btn btn-outline-danger btn-sm" data-remove-import-program="' + index + '" aria-label="Remove program"><i class="bi bi-x-lg"></i></button></td>',
        '</tr>'
      ].join('');
    }).join('');
    if (programCountBadge) {
      programCountBadge.textContent = selectedProgramRegistrations.length + ' selected';
    }
  }

  function validateProgramRegistrationSelections() {
    if (!selectedProgramRegistrations.length) return '';
    for (let i = 0; i < selectedProgramRegistrations.length; i += 1) {
      const row = selectedProgramRegistrations[i];
      const registrationDate = String(row.registrationDate || '').trim();
      if (!isDateOnly(registrationDate)) {
        return 'Enter a valid Registration Date for each selected program.';
      }
    }
    const selectedIndexes = Array.from(previewBody.querySelectorAll('.row-checkbox:checked'))
      .map(cb => parseInt(cb.dataset.index, 10));
    for (const idx of selectedIndexes) {
      const enrollmentDate = String(parsedRows[idx]?.data?.enrollmentDate || '').trim();
      if (!isDateOnly(enrollmentDate)) {
        return 'Each selected student must have a valid admission date before program registrations can run.';
      }
      for (let i = 0; i < selectedProgramRegistrations.length; i += 1) {
        const registrationDate = String(selectedProgramRegistrations[i].registrationDate || '').trim();
        if (registrationDate < enrollmentDate) {
          return 'Each program Registration Date must be on or after every selected student\'s admission date.';
        }
      }
    }
    return '';
  }

  function updateSelectedCount() {
    const checked = previewBody.querySelectorAll('.row-checkbox:checked').length;
    selectedCountEl.textContent = checked;
    continueBtn.disabled = checked === 0;
  }

  selectAllCb.addEventListener('change', (e) => {
    const isChecked = e.target.checked;
    previewBody.querySelectorAll('.row-checkbox:not(:disabled)').forEach(cb => {
      cb.checked = isChecked;
    });
    updateSelectedCount();
  });

  backBtn.addEventListener('click', () => {
    if (currentStep === 'preview') {
      showStep('setup');
      previewBtn.disabled = false;
      previewBtn.innerHTML = 'Preview Import';
    } else if (currentStep === 'programs') {
      showStep('preview');
    }
  });

  previewBtn.addEventListener('click', async () => {
    if (!fileInput.files[0]) {
      showMessage('File Required', 'warning', 'Please select a file first.');
      return;
    }

    previewBtn.disabled = true;
    previewBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Loading...';

    const formData = new FormData();
    formData.append('importFile', fileInput.files[0]);

    try {
      const response = await fetch('/school/students/import/preview', {
        method: 'POST',
        body: formData
      });

      const result = await response.json();

      if (response.status === 403 && result.status === 'admin_required') {
        if (typeof window.requestProtectedAction === 'function') {
          window.requestProtectedAction(() => previewBtn.click());
        }
        previewBtn.disabled = false;
        previewBtn.innerHTML = 'Preview Import';
        return;
      }

      if (result.status === 'success') {
        parsedRows = result.rows;
        defaultAdmissionDate = String(result.defaultAdmissionDate || '').trim();
        renderPreview();
        showStep('preview');
      } else {
        showMessage('Error', 'error', result.message);
        previewBtn.disabled = false;
        previewBtn.innerHTML = 'Preview Import';
      }
    } catch (error) {
      showMessage('Network Error', 'error', error.message);
      previewBtn.disabled = false;
      previewBtn.innerHTML = 'Preview Import';
    }
  });

  function renderPreview() {
    previewBody.innerHTML = '';
    let validCount = 0;

    parsedRows.forEach((row, idx) => {
      const tr = document.createElement('tr');
      const hasError = !!row.error;
      const hasDuplicates = row.duplicates && row.duplicates.length > 0;
      const isChecked = !hasError && !hasDuplicates;
      if (isChecked) validCount++;

      let statusHtml = '';
      if (hasError) {
        statusHtml = `<span class="text-danger"><i class="bi bi-x-circle"></i> ${row.error}</span>`;
      } else if (hasDuplicates) {
        statusHtml = `<span class="text-success"><i class="bi bi-check-circle"></i> Valid</span><br>
                      <div class="duplicate-warning"><i class="bi bi-exclamation-triangle"></i> Potential Duplicate: ${row.duplicates[0].displayName} (${row.duplicates[0].email})</div>`;
      } else {
        statusHtml = `<span class="text-success"><i class="bi bi-check-circle"></i> Valid</span>`;
      }

      let clbDisplay = '';
      if (row.data && row.data.clbCurrent) {
        clbDisplay = typeof row.data.clbCurrent === 'string' ? row.data.clbCurrent : JSON.stringify(row.data.clbCurrent);
      }

      tr.innerHTML = `
        <td class="text-center">
          <input class="form-check-input row-checkbox" type="checkbox" data-index="${idx}" ${isChecked ? 'checked' : ''} ${hasError ? 'disabled' : ''}>
        </td>
        <td>${row.data ? (row.data.firstName + ' ' + row.data.lastName) : 'N/A'}</td>
        <td>${row.data ? row.data.gender : 'N/A'}</td>
        <td>${row.data ? row.data.email : 'N/A'}</td>
        <td><small>${clbDisplay}</small></td>
        <td>${statusHtml}</td>
      `;

      previewBody.appendChild(tr);
    });

    selectAllCb.checked = validCount === parsedRows.length && parsedRows.length > 0;
    updateSelectedCount();

    previewBody.querySelectorAll('.row-checkbox').forEach(cb => {
      cb.addEventListener('change', updateSelectedCount);
    });
  }

  continueBtn.addEventListener('click', () => {
    const selectedIndexes = Array.from(previewBody.querySelectorAll('.row-checkbox:checked'))
      .map(cb => parseInt(cb.dataset.index, 10));
    if (selectedIndexes.length === 0) return;

    selectedProgramRegistrations = selectedProgramRegistrations.map((row) => ({
      ...row,
      registrationDate: row.registrationDate || resolveDefaultRegistrationDate()
    }));
    renderProgramRegistrationSelections();
    showStep('programs');
  });

  if (btnAddProgram) {
    btnAddProgram.disabled = !canCreateProgramRegistrations;
    btnAddProgram.addEventListener('click', () => {
      if (!canCreateProgramRegistrations) {
        showMessage('Permission Required', 'warning', 'You do not have permission to create program registrations.');
        return;
      }
      if (typeof GenericPicker === 'undefined' || !GenericPicker.open || typeof GenericPickerPresets === 'undefined') {
        showMessage('Program Picker', 'warning', 'The program picker is not available on this page.');
        return;
      }
      GenericPicker.open(GenericPickerPresets.program({
        title: 'Select Program',
        onSelect: (item) => {
          const programId = String(item?.id || '').trim();
          if (!programId) return;
          if (selectedProgramRegistrations.some((row) => String(row.programId || '') === programId)) return;
          selectedProgramRegistrations.push({
            programId,
            programLabel: [String(item.code || programId), String(item.name || '')].filter(Boolean).join(' - '),
            registrationDate: resolveDefaultRegistrationDate(),
            externalReference: '',
            note: ''
          });
          renderProgramRegistrationSelections();
        }
      }));
    });
  }

  if (programTbody) {
    programTbody.addEventListener('input', (event) => {
      const rowEl = event.target.closest('tr[data-import-program-index]');
      if (!rowEl) return;
      const index = Number(rowEl.getAttribute('data-import-program-index'));
      if (!Number.isInteger(index) || !selectedProgramRegistrations[index]) return;
      if (event.target.classList.contains('import-program-registration-date')) {
        selectedProgramRegistrations[index].registrationDate = event.target.value || '';
      } else if (event.target.classList.contains('import-program-registration-reference')) {
        selectedProgramRegistrations[index].externalReference = event.target.value || '';
      } else if (event.target.classList.contains('import-program-registration-note')) {
        selectedProgramRegistrations[index].note = event.target.value || '';
      }
    });
    programTbody.addEventListener('click', (event) => {
      const btn = event.target.closest('button[data-remove-import-program]');
      if (!btn) return;
      const index = Number(btn.getAttribute('data-remove-import-program'));
      if (!Number.isInteger(index)) return;
      selectedProgramRegistrations.splice(index, 1);
      renderProgramRegistrationSelections();
    });
  }

  processBtn.addEventListener('click', async () => {
    const selectedIndexes = Array.from(previewBody.querySelectorAll('.row-checkbox:checked'))
      .map(cb => parseInt(cb.dataset.index, 10));
    if (selectedIndexes.length === 0) return;

    const programIssue = validateProgramRegistrationSelections();
    if (programIssue) {
      showMessage('Program Registration', 'warning', programIssue);
      return;
    }

    const rowsToProcess = selectedIndexes.map(idx => parsedRows[idx].data);
    const programPayload = selectedProgramRegistrations.map((row) => ({
      programId: String(row.programId || '').trim(),
      registrationDate: String(row.registrationDate || '').trim(),
      externalReference: String(row.externalReference || '').trim(),
      note: String(row.note || '').trim()
    }));

    processBtn.disabled = true;
    processBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Processing...';

    try {
      const response = await fetch('/school/students/import/process', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          rows: rowsToProcess,
          programRegistrationSelections: programPayload
        })
      });

      const result = await response.json();

      if (response.status === 403 && result.status === 'admin_required') {
        if (typeof window.requestProtectedAction === 'function') {
          window.requestProtectedAction(() => processBtn.click());
        }
        processBtn.disabled = false;
        processBtn.innerHTML = 'Import Selected';
        return;
      }

      if (result.status === 'success') {
        renderResults(result.results);
        showStep('results');
      } else {
        showMessage('Error', 'error', result.message);
        processBtn.disabled = false;
        processBtn.innerHTML = 'Import Selected';
      }
    } catch (error) {
      showMessage('Network Error', 'error', error.message);
      processBtn.disabled = false;
      processBtn.innerHTML = 'Import Selected';
    }
  });

  function formatProgramSummary(res) {
    const summary = res.programRegistrations;
    if (!summary || !selectedProgramRegistrations.length) return '—';
    const finalized = Number(summary.finalizedCount || 0);
    const draft = Number(summary.draftCount || 0);
    const errors = Number(summary.errorCount || 0);
    if (errors > 0) {
      return '<span class="text-warning">' + finalized + ' finalized, ' + draft + ' draft, ' + errors + ' failed</span>';
    }
    if (finalized || draft) {
      return finalized + ' finalized, ' + draft + ' draft';
    }
    return summary.message || '—';
  }

  function renderResults(results) {
    resultBody.innerHTML = '';

    results.forEach(res => {
      const tr = document.createElement('tr');

      let resultHtml = '';
      if (res.success) {
        if (res.partial) {
          resultHtml = '<span class="badge bg-warning text-dark">Partial</span>';
        } else {
          resultHtml = '<span class="badge bg-success">Success</span>';
        }
      } else {
        resultHtml = `<span class="badge bg-danger">Failed</span> <small class="text-danger">${safeHtml(res.error)}</small>`;
      }

      tr.innerHTML = `
        <td>${safeHtml(res.name || 'Unknown')}</td>
        <td>${safeHtml(res.email || 'N/A')}</td>
        <td><small>${formatProgramSummary(res)}</small></td>
        <td>${resultHtml}</td>
      `;

      resultBody.appendChild(tr);
    });
  }

  modalEl.addEventListener('hidden.bs.modal', () => {
    if (currentStep === 'results') {
      window.location.reload();
    }
  });
});
</script>
