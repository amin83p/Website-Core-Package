  async function openLateSubmission(personId, personName) {
    if (!CAN_ALLOW_LATE_SUBMISSION) {
      await showMessage({ title: 'Access Required', icon: 'warning', message: 'UPDATE access is required to open timesheet submission after the deadline.' });
      return;
    }
    const normalizedPersonId = String(personId || '').trim();
    const row = loadedRows.find((entry) => String(entry?.personId || '').trim() === normalizedPersonId);
    if (!row || row.canOpenLateSubmission !== true) {
      await showMessage({ title: 'Unavailable', icon: 'warning', message: 'This timesheet is not eligible for late submission.' });
      return;
    }
    const periodId = String(loadedPeriod?.id || periodSelect?.value || '').trim();
    if (!periodId) {
      await showMessage({ title: 'Timesheet Management', icon: 'warning', message: 'Please load a timesheet period first.' });
      return;
    }
    const ok = await confirmAction({
      title: 'Open Timesheet submission',
      message: 'Allow ' + (personName || normalizedPersonId) + ' to submit this timesheet once after the deadline?',
      confirmText: 'Allow Once',
      cancelText: 'Cancel',
      icon: 'warning',
      confirmBtnClass: 'btn-primary'
    });
    if (!ok) return;
    try {
      const params = new URLSearchParams();
      params.set('teacherId', normalizedPersonId);
      if (actionStateId) params.set('actionStateId', actionStateId);
      const res = await fetch('/school/timesheets/editor/' + encodeURIComponent(periodId) + '/allow-late-submission?' + params.toString(), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-AJAX-Request': 'true' },
        body: JSON.stringify({ actionStateId })
      });
      const result = await res.json();
      const guarded = typeof window.applyGuardedApiResult === 'function'
        ? await window.applyGuardedApiResult(result, { busyTitle: 'Request In Progress', replayTitle: 'Request Already Processed' })
        : { stop: false };
      if (guarded.stop) return;
      if (result.status !== 'success') throw new Error(result.message || 'Request failed.');
      if (result.actionStateId) actionStateId = String(result.actionStateId);
      await showMessage({ title: 'Late Submission Allowed', icon: 'success', message: result.message || 'Done.' });
      await loadRoster();
    } catch (error) {
      await showMessage({ title: 'Error', icon: 'error', message: error.message || String(error) });
    }
  }

