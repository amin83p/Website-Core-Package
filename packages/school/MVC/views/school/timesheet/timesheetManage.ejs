  async function fetchJson(url) {
    const res = await fetch(url, {
      method: 'GET',
      headers: { 'Accept': 'application/json', 'X-AJAX-Request': 'true' }
    });
    const payload = await res.json();
    if (!res.ok || payload.status !== 'success') throw new Error(payload.message || 'Request failed.');
    return payload;
  }

  function formatPeriodDeadline(period) {
    const date = period && period.submissionDeadline ? String(period.submissionDeadline) : '-';
    const time = period && period.submissionDeadlineTime ? String(period.submissionDeadlineTime) : '23:59';
    return date === '-' ? '-' : date + ' ' + time;
  }

  function formatPeriodPickerLabel(period) {
    if (!period) return '';
    const name = period.name || period.title || period.id || 'Timesheet Period';
    const windowLabel = period.periodWindowLabel || [period.startDate, period.endDate].filter(Boolean).join(' to ');
    const status = period.status ? String(period.status).toUpperCase() : '';
    return [name, windowLabel, status].filter(Boolean).join(' | ');
  }

  function renderPeriodPickerRow(item) {
    const name = escapeHtml(item?.name || item?.title || item?.id || 'Timesheet Period');
    const id = escapeHtml(item?.id || '');
    const windowLabel = escapeHtml(item?.periodWindowLabel || [item?.startDate, item?.endDate].filter(Boolean).join(' to ') || 'No date window');
    const deadline = escapeHtml(item?.deadlineLabel || formatPeriodDeadline(item));
    const status = escapeHtml(String(item?.status || '').toUpperCase() || 'STATUS N/D');
    return `
      <div class="d-flex justify-content-between align-items-center w-100 gap-3">
        <div>
          <div class="fw-bold text-dark">${name}</div>
          <div class="small text-muted">${windowLabel}</div>
          <div class="small text-danger">Deadline: ${deadline}</div>
        </div>
        <div class="text-end">
          <span class="badge bg-light text-secondary border">${status}</span>
          ${id ? `<div class="small text-muted font-monospace mt-1">${id}</div>` : ''}
        </div>
      </div>
    `;
  }

  function resetLoadedRoster(message) {
    loadedRows = [];
    loadedPeriod = null;
    clearSelection();
    if (personSearch) personSearch.value = '';
    rosterCount.textContent = 'No period loaded yet.';
    tbody.innerHTML = '<tr><td colspan="' + TABLE_COLSPAN + '" class="text-center py-5 text-muted">' + (message || 'Click <b>Load Timesheets</b> to load this period.') + '</td></tr>';
  }

  function setSelectedPeriod(period) {
    const id = String(period?.id || '').trim();
    if (!id) return;
    periodSelect.value = id;
    if (periodDisplay) periodDisplay.value = formatPeriodPickerLabel(period);
    const deadline = formatPeriodDeadline(period);
    periodMeta.innerHTML = '<b>' + escapeHtml(period.name || period.title || id) + '</b> | ' +
      escapeHtml(period.periodWindowLabel || [period.startDate, period.endDate].filter(Boolean).join(' to ')) +
      (deadline !== '-' ? ' | Deadline: <b class="text-danger">' + escapeHtml(deadline) + '</b>' : '');
    resetLoadedRoster('Click <b>Load Timesheets</b> to load this period.');
  }

  async function loadRoster() {
    const periodId = String(periodSelect.value || '').trim();
    if (!periodId) {
      await showMessage({ title: 'Timesheet Management', icon: 'warning', message: 'Please select a timesheet period first.' });
      return;
    }

    const original = btnLoad.innerHTML;
    btnLoad.disabled = true;
    btnLoad.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Loading...';
    tbody.innerHTML = '<tr><td colspan="' + TABLE_COLSPAN + '" class="text-center py-5 text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Loading eligible timesheets...</td></tr>';

    try {
      const rosterParams = new URLSearchParams({ periodId });
      const requestedStatus = String(timesheetStatusFilter?.value || '').trim();
      if (requestedStatus) rosterParams.set('timesheetStatus', requestedStatus);
      const payload = await fetchJson('/school/timesheets/manage/api/roster?' + rosterParams.toString());
      loadedRows = Array.isArray(payload.rows) ? payload.rows : [];
      loadedPeriod = payload.period || null;
      clearSelection();
      if (loadedPeriod) {
        periodMeta.innerHTML = '<b>' + escapeHtml(loadedPeriod.name || loadedPeriod.id) + '</b> | ' +
          escapeHtml(loadedPeriod.startDate || '') + ' to ' + escapeHtml(loadedPeriod.endDate || '') +
          ' | Deadline: <b class="text-danger">' + escapeHtml(formatPeriodDeadline(loadedPeriod)) + '</b>';
      }
      renderRows();
    } catch (error) {
      loadedRows = [];
      loadedPeriod = null;
      tbody.innerHTML = '<tr><td colspan="' + TABLE_COLSPAN + '" class="text-center py-5 text-danger">' + escapeHtml(error.message || String(error)) + '</td></tr>';
      await showMessage({ title: 'Load Failed', icon: 'error', message: escapeHtml(error.message || String(error)) });
    } finally {
      btnLoad.disabled = false;
      btnLoad.innerHTML = original;
    }
  }

