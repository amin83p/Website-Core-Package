<script>
(function () {
  const CAN_PRINT_MANAGED_TIMESHEETS = <%= (typeof canPrintManagedTimesheets !== 'undefined' && canPrintManagedTimesheets) ? 'true' : 'false' %>;
  const TIMESHEET_MANAGE_PRINT_ACTION = '/school/timesheets/manage/print';
  const HAS_PRINT_SELECTION = CAN_PRINT_MANAGED_TIMESHEETS;
  const TABLE_COLSPAN = HAS_PRINT_SELECTION ? 7 : 6;

  const periodSelect = document.getElementById('periodSelect');
  const periodDisplay = document.getElementById('periodDisplay');
  const btnPickPeriod = document.getElementById('btnPickPeriod');
  const btnClearPeriod = document.getElementById('btnClearPeriod');
  const btnLoad = document.getElementById('btnLoadRoster');
  const btnClear = document.getElementById('btnClearRoster');
  const btnPrintSelected = document.getElementById('btnPrintSelectedTimesheets');
  const selectAllVisible = document.getElementById('timesheetSelectAllVisible');
  const personSearch = document.getElementById('personSearch');
  const timesheetStatusFilter = document.getElementById('timesheetStatusFilter');
  const tbody = document.getElementById('timesheetRosterBody');
  const rosterCount = document.getElementById('rosterCount');
  const periodMeta = document.getElementById('periodMeta');
  const summaryModalEl = document.getElementById('departmentSummaryModal');
  const summarySubtitle = document.getElementById('departmentSummarySubtitle');
  const summaryContent = document.getElementById('departmentSummaryContent');
  let loadedRows = [];
  let loadedPeriod = null;
  const selectedPersonIds = new Set();

  function escapeHtml(value) {
    return String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function showMessage(options) {
    if (typeof window.showMessageModal === 'function') return window.showMessageModal(options);
    if (options && options.message) alert(String(options.message).replace(/<[^>]+>/g, ' '));
    return Promise.resolve();
  }

  function statusBadge(status) {
    const normalized = String(status || 'not_started').toLowerCase();
    const map = {
      not_started: ['#6c757d', 'Not Started', 'secondary'],
      draft: ['#0dcaf0', 'Draft', 'info'],
      submitted: ['#0d6efd', 'Submitted', 'primary'],
      processed: ['#198754', 'Processed', 'success']
    };
    const meta = map[normalized] || ['#6c757d', normalized.replace(/_/g, ' '), 'secondary'];
    return '<span class="badge bg-' + meta[2] + '"><span class="timesheet-status-dot bg-white bg-opacity-75 me-1"></span>' + escapeHtml(meta[1].toUpperCase()) + '</span>';
  }

  function rolePills(roles) {
    const list = Array.isArray(roles) ? roles : [];
    if (!list.length) return '<span class="text-muted">-</span>';
    return list.map((role) => {
      const label = String(role || '').toUpperCase();
      const klass = role === 'teacher' ? 'bg-primary' : 'bg-success';
      return '<span class="badge ' + klass + ' timesheet-role-pill me-1">' + escapeHtml(label) + '</span>';
    }).join('');
  }

  function isPrintableRow(row) {
    const status = String(row?.status || 'not_started').toLowerCase();
    return status === 'submitted' || status === 'processed';
  }

  function getVisibleRows() {
    const term = String(personSearch?.value || '').trim().toLowerCase();
    return loadedRows.filter((row) => {
      if (!term) return true;
      const haystack = [
        row.personId,
        row.name,
        row.email,
        row.departmentHint,
        row.status,
        ...(Array.isArray(row.roles) ? row.roles : [])
      ].join(' ').toLowerCase();
      return haystack.includes(term);
    });
  }

  function clearSelection() {
    selectedPersonIds.clear();
    updateSelectionUi();
  }

  function updateSelectionUi() {
    if (btnPrintSelected) {
      const count = selectedPersonIds.size;
      btnPrintSelected.textContent = '🖨 Print';
      btnPrintSelected.disabled = count === 0 || !loadedPeriod;
      btnPrintSelected.title = count > 0
        ? 'Print ' + count + ' selected timesheet' + (count === 1 ? '' : 's')
        : 'Select submitted or processed timesheets to print';
    }
    if (!HAS_PRINT_SELECTION || !tbody) return;
    const visiblePrintable = getVisibleRows().filter(isPrintableRow);
    const visiblePrintableIds = visiblePrintable.map((row) => String(row.personId || '').trim()).filter(Boolean);
    const selectedVisibleCount = visiblePrintableIds.filter((id) => selectedPersonIds.has(id)).length;
    tbody.querySelectorAll('.timesheet-print-select').forEach((input) => {
      const personId = String(input.dataset.personId || '').trim();
      input.checked = selectedPersonIds.has(personId);
    });
    if (selectAllVisible) {
      selectAllVisible.disabled = visiblePrintableIds.length === 0;
      selectAllVisible.checked = visiblePrintableIds.length > 0 && selectedVisibleCount === visiblePrintableIds.length;
      selectAllVisible.indeterminate = selectedVisibleCount > 0 && selectedVisibleCount < visiblePrintableIds.length;
    }
  }

  function renderSelectionCell(row) {
    if (!HAS_PRINT_SELECTION) return '';
    const personId = String(row.personId || '').trim();
    if (!isPrintableRow(row)) {
      const status = String(row.status || 'not_started').toLowerCase();
      const reason = status === 'draft'
        ? 'Draft timesheets cannot be printed.'
        : 'Only submitted or processed timesheets can be printed.';
      return '<td class="text-center"><input type="checkbox" class="form-check-input" disabled title="' + escapeHtml(reason) + '" aria-label="Not printable"></td>';
    }
    return '<td class="text-center"><input type="checkbox" class="form-check-input timesheet-print-select" data-person-id="' + escapeHtml(personId) + '" aria-label="Select timesheet for ' + escapeHtml(row.name || personId) + '"></td>';
