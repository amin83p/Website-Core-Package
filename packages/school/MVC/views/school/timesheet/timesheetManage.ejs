            ${Number(row.revisionCount || 0) > 0 ? `<div class="small text-muted mt-1" title="${escapeHtml(row.lastReopenNote || '')}"><i class="bi bi-arrow-repeat me-1"></i>${Number(row.revisionCount)} revision${Number(row.revisionCount) === 1 ? '' : 's'}</div>` : ''}
