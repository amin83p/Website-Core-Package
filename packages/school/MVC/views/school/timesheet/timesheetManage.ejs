<%
  const timesheetManageOptionalBtnsBeforePrint = [];
  if (typeof canImportTimesheets !== 'undefined' && canImportTimesheets) {
    timesheetManageOptionalBtnsBeforePrint.push('<button type="button" id="btnOpenTimesheetBulkImport" class="btn btn-filled btn-add btn-md me-2 mb-2">📦 Import</button>');
  }
  if (typeof canPrintManagedTimesheets !== 'undefined' && canPrintManagedTimesheets) {
    timesheetManageOptionalBtnsBeforePrint.push('<button type="button" id="btnPrintSelectedTimesheets" class="btn btn-filled btn-edit btn-md me-2 mb-2" disabled title="Select submitted or processed timesheets to print">🖨 Print</button>');
  }
%>
<%- include('partials/tablePages-start', {
  title,
  newUrl,
  newLabel,
  user,
  tableName,
