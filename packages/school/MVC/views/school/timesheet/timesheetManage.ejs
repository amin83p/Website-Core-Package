  function formatImportHours(value) {
    const num = Number(value);
    if (!Number.isFinite(num)) return '—';
    return num.toFixed(2);
  }

  function formatImportDateLong(dateToken) {
    const token = String(dateToken || '').trim();
    if (!/^\d{4}-\d{2}-\d{2}$/.test(token)) return token || 'Unknown date';
    const parsed = new Date(token + 'T12:00:00');
    if (Number.isNaN(parsed.getTime())) return token;
    return parsed.toLocaleDateString('en-US', {
      weekday: 'long',
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    });
  }

  function formatImportDateShort(dateToken) {
    const token = String(dateToken || '').trim();
    if (!/^\d{4}-\d{2}-\d{2}$/.test(token)) return token || '';
    const parsed = new Date(token + 'T12:00:00');
    if (Number.isNaN(parsed.getTime())) return token;
    return parsed.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
  }

  function formatImportPeriodRange(startDate, endDate) {
    if (!startDate || !endDate) return 'Unavailable';
    return formatImportDateShort(startDate) + ' → ' + formatImportDateShort(endDate);
  }

  function formatImportPeriodTabLabel(dateToken) {
    const token = String(dateToken || '').trim();
    if (!/^\d{4}-\d{2}-\d{2}$/.test(token)) return token || '—';
    const parsed = new Date(token + 'T12:00:00');
    if (Number.isNaN(parsed.getTime())) return token;
    const month = parsed.toLocaleDateString('en-US', { month: 'short' });
    const day = String(parsed.getDate()).padStart(2, '0');
    return month + ' ' + day;
  }

  function groupImportRowsByDate(rows) {
    const groups = [];
    const map = new Map();
    (Array.isArray(rows) ? rows : []).forEach((row) => {
      const date = String(row?.date || '').trim() || 'Unknown';
      if (!map.has(date)) {
        const group = { date, dayOfWeek: row?.dayOfWeek || '', rows: [] };
        map.set(date, group);
        groups.push(group);
      }
      const group = map.get(date);
      if (!group.dayOfWeek && row?.dayOfWeek) group.dayOfWeek = row.dayOfWeek;
      group.rows.push(row);
    });
    return groups;
  }

  function renderImportMatchPill(result) {
    const matched = result?.matchedPeriod;
    const status = String(matched?.matchStatus || result?.matchStatus || 'none').toLowerCase();
    if (!matched?.id) {
      return '<span class="ts-import-match-pill none"><i class="bi bi-x-circle"></i> No matching period</span>';
    }
    const label = escapeHtml(matched.name || matched.id);
    const id = escapeHtml(matched.id);
    const icon = status === 'exact' ? 'bi-check-circle' : 'bi-exclamation-circle';
    return '<span class="ts-import-match-pill ' + escapeHtml(status) + '"><i class="bi ' + icon + '"></i> '
      + label + ' <span class="fw-normal opacity-75">(' + id + ')</span></span>';
  }

  function renderImportSummaryCard(result) {
    const personName = escapeHtml(importCompilePayload?.personName || importCompilePayload?.personId || '—');
    const personId = escapeHtml(importCompilePayload?.personId || '');
    const year = escapeHtml(importCompilePayload?.year || '—');
    const startDate = result?.sourcePeriod?.startDate || '';
    const endDate = result?.sourcePeriod?.endDate || '';
    const employeeFromFile = escapeHtml(result?.employeeNameFromFile || '—');
    const templateId = escapeHtml(result?.templateId || '—');
    const stats = result?.stats || {};
    const rowCount = Number(stats.rowCount || (result?.rows || []).length || 0);
    const totalHours = formatImportHours(stats.totalHours || 0);
    const dayCount = groupImportRowsByDate(result?.rows || []).length;
    const matched = result?.matchedPeriod;
    const appPeriodLabel = matched?.id
      ? escapeHtml((matched.name || matched.id) + ' · ' + (matched.startDate || '?') + ' to ' + (matched.endDate || '?'))
      : 'No match found';

    return ''
      + '<div class="ts-import-summary-grid">'
      + '<div class="ts-import-summary-item">'
      + '<div class="ts-import-summary-label">Selected Teacher</div>'
      + '<div class="ts-import-summary-value">' + personName + '</div>'
      + '<div class="ts-import-summary-sub font-monospace">' + personId + '</div>'
      + '</div>'
      + '<div class="ts-import-summary-item">'
      + '<div class="ts-import-summary-label">Import Year</div>'
      + '<div class="ts-import-summary-value">' + year + '</div>'
      + '<div class="ts-import-summary-sub">Used for period matching</div>'
      + '</div>'
      + '<div class="ts-import-summary-item ts-import-summary-item-wide">'
      + '<div class="ts-import-summary-label">Excel Timesheet Period</div>'
      + '<div class="ts-import-summary-value">' + escapeHtml(formatImportPeriodRange(startDate, endDate)) + '</div>'
      + '<div class="ts-import-summary-sub">' + escapeHtml(startDate && endDate ? startDate + ' to ' + endDate : '') + '</div>'
      + '</div>'
      + '<div class="ts-import-summary-item ts-import-summary-item-wide">'
      + '<div class="ts-import-summary-label">Matched App Period</div>'
      + '<div class="ts-import-summary-value">' + renderImportMatchPill(result) + '</div>'
      + '<div class="ts-import-summary-sub">' + appPeriodLabel + '</div>'
      + '</div>'
      + '<div class="ts-import-summary-item">'
      + '<div class="ts-import-summary-label">Employee in File</div>'
      + '<div class="ts-import-summary-value">' + employeeFromFile + '</div>'
      + '<div class="ts-import-summary-sub">Informational only</div>'
      + '</div>'
      + '<div class="ts-import-summary-item">'
      + '<div class="ts-import-summary-label">Compiled Totals</div>'
      + '<div class="ts-import-summary-value">' + totalHours + ' hrs</div>'
      + '<div class="ts-import-summary-sub">' + rowCount + ' row' + (rowCount === 1 ? '' : 's') + ' · ' + dayCount + ' day' + (dayCount === 1 ? '' : 's') + '</div>'
      + '</div>'
      + '<div class="ts-import-summary-item">'
      + '<div class="ts-import-summary-label">Template</div>'
      + '<div class="ts-import-summary-value">' + templateId + '</div>'
      + '<div class="ts-import-summary-sub">Legacy workbook format</div>'
      + '</div>'
      + '</div>';
  }

  function renderImportDayGroups(rows) {
    const groups = groupImportRowsByDate(rows);
    if (!groups.length) {
      return '<div class="ts-import-empty"><i class="bi bi-inbox fs-3 d-block mb-2"></i>No billable rows found.</div>';
    }

    const hasDayColumn = groups.some((group) => String(group.dayOfWeek || '').trim());
    const colCount = hasDayColumn ? 7 : 6;

    const bodyHtml = groups.map((group, groupIndex) => {
      const bandClass = groupIndex % 2 === 0 ? 'ts-import-band-even' : 'ts-import-band-odd';
      const dayHours = group.rows.reduce((sum, row) => sum + (Number(row.hours) || 0), 0);
      const rowSpan = group.rows.length + 1;
      const dateMain = escapeHtml(formatImportDateShort(group.date));
      const dateLong = escapeHtml(formatImportDateLong(group.date));
      const dayLabel = escapeHtml(group.dayOfWeek || '—');

      const dataRows = group.rows.map((row, rowIndex) => {
        const dateCells = rowIndex === 0
          ? '<td class="date-cell" rowspan="' + rowSpan + '">' + dateMain
            + '<span class="date-sub">' + dateLong + '</span></td>'
            + (hasDayColumn
              ? '<td class="day-cell" rowspan="' + rowSpan + '">' + dayLabel + '</td>'
              : '')
          : '';

        return ''
          + '<tr class="' + bandClass + (rowIndex === 0 ? ' ts-import-day-start' : '') + '">'
          + dateCells
          + '<td class="class-cell">' + escapeHtml(row.className || '—') + '</td>'
          + '<td class="text-end hours-cell">' + formatImportHours(row.hours) + '</td>'
          + '<td>' + (row.studentName ? escapeHtml(row.studentName) : '<span class="text-muted">—</span>') + '</td>'
          + '<td class="text-end">' + (row.optionalHours == null ? '<span class="text-muted">—</span>' : formatImportHours(row.optionalHours)) + '</td>'
          + '<td class="comment-cell">' + (row.comment ? escapeHtml(row.comment) : '<span class="text-muted">—</span>') + '</td>'
          + '</tr>';
      }).join('');

      const totalRow = ''
        + '<tr class="ts-import-day-total ' + bandClass + '">'
        + '<td class="day-total-label">Day total · ' + group.rows.length + ' entr' + (group.rows.length === 1 ? 'y' : 'ies') + '</td>'
        + '<td class="text-end day-total-hours">' + formatImportHours(dayHours) + ' hrs</td>'
        + '<td colspan="3"></td>'
        + '</tr>';

      const gapRow = groupIndex < groups.length - 1
        ? '<tr class="ts-import-day-gap"><td colspan="' + colCount + '"></td></tr>'
        : '';

      return dataRows + totalRow + gapRow;
    }).join('');

    const dayHeader = hasDayColumn ? '<th>Day</th>' : '';

    return ''
      + '<div class="table-responsive ts-import-ledger-wrap">'
      + '<table class="table table-sm ts-import-ledger-table mb-0">'
      + '<thead><tr>'
      + '<th>Date</th>' + dayHeader
      + '<th>Class</th><th class="text-end">Hours</th><th>Student</th><th class="text-end">Optional</th><th>Comment</th>'
      + '</tr></thead><tbody>' + bodyHtml + '</tbody></table>'
      + '</div>';
  }

  function resolveImportResultPeriodKey(result) {
    const startDate = String(result?.sourcePeriod?.startDate || '').trim();
    const endDate = String(result?.sourcePeriod?.endDate || '').trim();
    if (startDate && endDate) return { startDate, endDate };
    return { startDate: '9999-12-31', endDate: '9999-12-31' };
  }

  function sortImportCompileResults(results) {
    return [...(Array.isArray(results) ? results : [])].sort((a, b) => {
      const aKey = resolveImportResultPeriodKey(a);
      const bKey = resolveImportResultPeriodKey(b);
      if (aKey.startDate !== bKey.startDate) return aKey.startDate.localeCompare(bKey.startDate);
      if (aKey.endDate !== bKey.endDate) return aKey.endDate.localeCompare(bKey.endDate);
      return String(a?.fileName || '').localeCompare(String(b?.fileName || ''));
    });
  }

  function renderImportFileNav(results, index) {
    if (!importReviewFileNav) return;
    const total = results.length;
    const result = results[index] || {};
    importReviewFileNav.classList.toggle('d-none', total <= 0);
    if (importReviewFileIndicator) {
      importReviewFileIndicator.textContent = total > 1
        ? ('Period ' + (index + 1) + ' of ' + total)
        : 'Compiled period';
    }
    if (importReviewFileName) {
      const startDate = String(result?.sourcePeriod?.startDate || '').trim();
      const endDate = String(result?.sourcePeriod?.endDate || '').trim();
      const periodLabel = (startDate && endDate)
        ? formatImportPeriodRange(startDate, endDate)
        : String(result?.fileName || 'timesheet.xlsx');
      const fileName = String(result?.fileName || 'timesheet.xlsx');
      importReviewFileName.innerHTML = (startDate && endDate)
        ? escapeHtml(periodLabel) + '<div class="ts-import-summary-sub">' + escapeHtml(fileName) + '</div>'
        : escapeHtml(fileName);
    }
    if (importReviewPeriodTabs && total > 1) {
      importReviewPeriodTabs.innerHTML = results.map((item, tabIndex) => {
        const isActive = tabIndex === index;
        const isError = String(item?.status || '').toLowerCase() === 'error';
        const startDate = String(item?.sourcePeriod?.startDate || '').trim();
        const endDate = String(item?.sourcePeriod?.endDate || '').trim();
        const label = startDate
          ? formatImportPeriodTabLabel(startDate)
          : String(item?.fileName || ('Period ' + (tabIndex + 1)));
        const tabTitle = (startDate && endDate)
          ? (formatImportPeriodRange(startDate, endDate) + ' · ' + String(item?.fileName || ''))
          : String(item?.fileName || ('Period ' + (tabIndex + 1)));
        const btnClass = isActive
          ? 'btn btn-sm btn-primary'
          : (isError ? 'btn btn-sm btn-outline-danger' : 'btn btn-sm btn-outline-secondary');
        return '<button type="button" class="' + btnClass + '" data-import-review-index="' + tabIndex + '" title="' + escapeHtml(tabTitle) + '">' + escapeHtml(label) + '</button>';
      }).join('');
    } else if (importReviewPeriodTabs) {
      importReviewPeriodTabs.innerHTML = '';
    }
  }

  function renderMatchedPeriodBadge(result) {
    return renderImportMatchPill(result);
  }

  function renderImportPeriodMatchWarningDetails(result) {
    const details = result?.matchDetails;
    if (!details) return '';
    const headline = details.kind === 'contained'
      ? 'Excel period falls inside this app period but dates do not match exactly.'
      : 'Excel period partially overlaps this app period.';
    const appIdentity = details.appPeriodName && details.appPeriodId && details.appPeriodName !== details.appPeriodId
      ? escapeHtml(details.appPeriodName) + ' <span class="font-monospace opacity-75">(' + escapeHtml(details.appPeriodId) + ')</span>'
      : escapeHtml(details.appPeriodName || details.appPeriodId || 'Unknown period');
    const boundaryHtml = (Array.isArray(details.boundaryNotes) ? details.boundaryNotes : [])
      .map((note) => '<li>' + escapeHtml(note) + '</li>').join('');
    const overlapHtml = details.kind === 'overlap' && details.overlapStart && details.overlapEnd
      ? '<div class="ts-import-period-warn-row"><span class="ts-import-period-warn-label">Shared overlap</span>'
        + '<span class="ts-import-period-warn-value">' + escapeHtml(formatImportPeriodRange(details.overlapStart, details.overlapEnd)) + '</span>'
        + '<div class="ts-import-period-warn-sub">' + escapeHtml(details.overlapStart + ' to ' + details.overlapEnd) + '</div></div>'
      : '';

    return ''
      + '<li class="ts-import-period-warn-item">'
      + '<div class="fw-semibold">' + escapeHtml(headline) + '</div>'
      + '<div class="ts-import-period-warn-detail">'
      + '<div class="ts-import-period-warn-row"><span class="ts-import-period-warn-label">Excel period</span>'
      + '<span class="ts-import-period-warn-value">' + escapeHtml(formatImportPeriodRange(details.excelStart, details.excelEnd)) + '</span>'
      + '<div class="ts-import-period-warn-sub">' + escapeHtml(details.excelStart + ' to ' + details.excelEnd) + '</div></div>'
      + '<div class="ts-import-period-warn-row"><span class="ts-import-period-warn-label">App period</span>'
      + '<span class="ts-import-period-warn-value">' + appIdentity + '</span>'
      + '<div class="ts-import-period-warn-sub">' + escapeHtml(details.appStart + ' to ' + details.appEnd) + '</div></div>'
      + overlapHtml
      + (boundaryHtml ? '<ul class="ts-import-period-warn-notes mb-0 ps-3">' + boundaryHtml + '</ul>' : '')
      + '</div></li>';
  }

  function renderImportReviewWarnings(result) {
    const warnings = Array.isArray(result?.warnings) ? result.warnings : [];
    const matchNote = String(result?.matchNote || '').trim();
    const parts = [];
    if (result?.matchDetails) {
      parts.push(renderImportPeriodMatchWarningDetails(result));
    }
    warnings.forEach((msg) => {
      const text = String(msg || '').trim();
      if (!text) return;
      if (result?.matchDetails && text === matchNote) return;
      parts.push('<li>' + escapeHtml(text) + '</li>');
    });
    return parts.join('');
  }

  function renderImportReviewCurrent() {
    const results = Array.isArray(importCompilePayload?.results) ? importCompilePayload.results : [];
    if (!results.length) return;
    if (importReviewIndex < 0) importReviewIndex = 0;
    if (importReviewIndex >= results.length) importReviewIndex = results.length - 1;
    const result = results[importReviewIndex];

    renderImportFileNav(results, importReviewIndex);
    if (importReviewSummary) {
      importReviewSummary.innerHTML = renderImportSummaryCard(result);
      importReviewSummary.classList.toggle('d-none', false);
    }

    const isError = String(result?.status || '').toLowerCase() === 'error';
    if (importReviewErrorPanel) importReviewErrorPanel.classList.toggle('d-none', !isError);
    if (importReviewWarningsPanel) importReviewWarningsPanel.classList.toggle('d-none', isError || !(result?.warnings || []).length);
    if (importReviewTableWrap) importReviewTableWrap.classList.toggle('d-none', isError);
    if (importReviewStats) importReviewStats.classList.toggle('d-none', isError);

    if (isError) {
      const messages = result?.error?.messages || [result?.error?.title || 'The file could not be compiled.'];
      importReviewErrorList.innerHTML = messages.map((msg) => '<li>' + escapeHtml(msg) + '</li>').join('');
      importReviewWarningsList.innerHTML = '';
      importReviewTableWrap.innerHTML = '';
      importReviewStats.innerHTML = '';
    } else {
      importReviewErrorList.innerHTML = '';
      importReviewWarningsList.innerHTML = renderImportReviewWarnings(result);
      const rows = Array.isArray(result?.rows) ? result.rows : [];
      importReviewTableWrap.innerHTML = renderImportDayGroups(rows);
      const stats = result?.stats || {};
      const groups = groupImportRowsByDate(rows);
      importReviewStats.innerHTML = ''
        + '<div><strong>Rows:</strong> ' + Number(stats.rowCount || rows.length || 0) + '</div>'
        + '<div><strong>Days:</strong> ' + groups.length + '</div>'
        + '<div><strong>Total hours:</strong> ' + formatImportHours(stats.totalHours || 0) + '</div>'
        + '<div><strong>Template:</strong> ' + escapeHtml(result?.templateId || '—') + '</div>';
    }

    if (importReviewPrevBtn) importReviewPrevBtn.disabled = importReviewNavBusy || importReviewIndex <= 0;
    if (importReviewNextBtn) importReviewNextBtn.disabled = importReviewNavBusy || importReviewIndex >= results.length - 1;
    updateImportReviewConfirmButton();
    if (importReviewPeriodTabs) {
      importReviewPeriodTabs.querySelectorAll('[data-import-review-index]').forEach((btn) => {
        btn.disabled = importReviewNavBusy;
      });
    }
  }

  function cleanId(value) {
    return String(value || '').trim();
  }

  function importResultsReadyForApply(results = []) {
    return (Array.isArray(results) ? results : []).some((row) => (
      String(row?.status || '').toLowerCase() === 'ok' && cleanId(row?.matchedPeriod?.id)
    ));
  }

  function updateImportReviewConfirmButton() {
    if (!btnConfirmTimesheetImport) return;
    const results = Array.isArray(importCompilePayload?.results) ? importCompilePayload.results : [];
    btnConfirmTimesheetImport.disabled = importApplyInProgress
      || importReviewNavBusy
      || !importResultsReadyForApply(results);
  }

  function beginImportExecutionLoading(note) {
    if (typeof window.showLoading !== 'function') return null;
    return window.showLoading({
      title: 'Running Import Execution',
      note: note || 'Creating work sessions, assembling timesheet, and processing...',
      operation: 'Timesheet Import Execution'
    });
  }

  function renderImportExecutionStepCell(step) {
    const status = String(step?.status || 'pending').toLowerCase();
    const summary = String(step?.summary || '').trim();
    const error = String(step?.error || '').trim();
    if (status === 'running') {
      return '<div class="ts-import-exec-status is-running"><span class="spinner-border spinner-border-sm me-1"></span>Running...</div>';
    }
    if (status === 'success') {
      return '<div class="ts-import-exec-status is-success"><i class="bi bi-check-circle me-1"></i>' + escapeHtml(summary || 'Done') + '</div>';
    }
    if (status === 'error') {
      return '<div class="ts-import-exec-status is-error"><i class="bi bi-x-circle me-1"></i>' + escapeHtml(error || summary || 'Failed') + '</div>';
    }
    return '<div class="ts-import-exec-status is-pending text-muted">Pending</div>';
  }

  function resolveImportExecutionPersonRole(personId) {
    const targetPersonId = cleanId(personId);
    const selected = cleanId(importExecutionPersonRoleByPersonId[targetPersonId]);
    if (selected) return selected;
    const needs = Array.isArray(importExecutionPlan?.needsRoleSelection) ? importExecutionPlan.needsRoleSelection : [];
    const match = needs.find((row) => idsEqual(row.personId, targetPersonId));
    if (match && match.roles?.length === 1) return cleanId(match.roles[0]);
    return cleanId(importExecutionPlan?.defaultPersonRole || '');
  }

  function importExecutionRoleReady(personId) {
    const targetPersonId = cleanId(personId);
    const needs = Array.isArray(importExecutionPlan?.needsRoleSelection) ? importExecutionPlan.needsRoleSelection : [];
    const match = needs.find((row) => idsEqual(row.personId, targetPersonId));
    if (!match || !Array.isArray(match.roles) || match.roles.length <= 1) return true;
    return Boolean(resolveImportExecutionPersonRole(targetPersonId));
  }

  function renderImportExecutionAlerts() {
    if (!importExecutionAlerts) return;
    const needs = Array.isArray(importExecutionPlan?.needsRoleSelection) ? importExecutionPlan.needsRoleSelection : [];
    if (!needs.length) {
      importExecutionAlerts.innerHTML = '';
      return;
    }
    const pending = needs.filter((row) => !importExecutionRoleReady(row.personId));
    if (!pending.length) {
      importExecutionAlerts.innerHTML = '<div class="alert alert-success border-0 shadow-sm py-2">Payroll roles are set for all people in this import.</div>';
      return;
    }
    const lines = pending.map((row) => (
      '<li><b>' + escapeHtml(row.personName || row.personId) + '</b> needs a payroll role before Perform.</li>'
    )).join('');
    importExecutionAlerts.innerHTML = '<div class="alert alert-warning border-0 shadow-sm py-2"><div class="fw-semibold mb-1">Role selection required</div><ul class="mb-0 ps-3 small">' + lines + '</ul></div>';
  }

  function renderImportExecutionTable() {
    if (!importExecutionTableBody) return;
    importExecutionTableBody.innerHTML = (Array.isArray(importExecutionRows) ? importExecutionRows : []).map((row, index) => {
      const steps = row.steps || {};
      const canPerform = !importExecutionInProgress
        && String(row.overallStatus || 'pending') === 'pending'
        && importExecutionRoleReady(row.personId);
      return ''
        + '<tr data-import-exec-index="' + index + '">'
        + '<td>' + escapeHtml(row.fileName || '—') + '</td>'
        + '<td>' + escapeHtml(row.personName || row.personId || '—') + '</td>'
        + '<td>' + escapeHtml(row.periodName || row.periodId || '—') + '</td>'
        + '<td>' + renderImportExecutionStepCell(steps.workSessions) + '</td>'
        + '<td>' + renderImportExecutionStepCell(steps.timesheet) + '</td>'
        + '<td>' + renderImportExecutionStepCell(steps.processed) + '</td>'
        + '<td class="text-end">'
        + '<button type="button" class="btn btn-sm btn-primary" data-import-exec-perform="' + index + '"'
        + (canPerform ? '' : ' disabled')
        + '><i class="bi bi-play-fill me-1"></i>Perform</button>'
        + '</td>'
        + '</tr>';
    }).join('');
    if (btnPerformAllImportExecutions) {
      const pendingCount = (importExecutionRows || []).filter((row) => String(row.overallStatus || 'pending') === 'pending').length;
      btnPerformAllImportExecutions.disabled = importExecutionInProgress || !pendingCount
        || !(importExecutionRows || []).every((row) => String(row.overallStatus || 'pending') !== 'pending' || importExecutionRoleReady(row.personId));
    }
    renderImportExecutionAlerts();
  }

  function promptImportExecutionRole(personRow) {
    return new Promise((resolve) => {
      if (!importRoleModalEl || !importExecutionPersonRole) {
        resolve('');
        return;
      }
      const roles = Array.isArray(personRow?.roles) ? personRow.roles : ['teacher', 'staff'];
      importExecutionPersonRole.innerHTML = roles.map((role) => (
        '<option value="' + escapeHtml(role) + '">' + escapeHtml(role.charAt(0).toUpperCase() + role.slice(1)) + '</option>'
      )).join('');
      const existing = resolveImportExecutionPersonRole(personRow?.personId);
      importExecutionPersonRole.value = existing || personRow?.defaultRole || roles[0] || 'teacher';
      if (importRolePromptText) {
        importRolePromptText.textContent = 'Which payroll role should this import use for '
          + String(personRow?.personName || personRow?.personId || 'this person')
          + '?';
      }
      importExecutionRoleResolver = resolve;
      ensureModalOnBody(importRoleModalEl)?.show();
    });
  }

  async function ensureImportExecutionRoles() {
    const needs = Array.isArray(importExecutionPlan?.needsRoleSelection) ? importExecutionPlan.needsRoleSelection : [];
    for (const row of needs) {
      if (importExecutionRoleReady(row.personId)) continue;
      // eslint-disable-next-line no-await-in-loop
      await promptImportExecutionRole(row);
      if (!importExecutionRoleReady(row.personId)) {
        throw new Error('Payroll role selection is required before performing the import.');
      }
    }
  }

  async function performImportExecutionRow(rowIndex) {
    const row = importExecutionRows[rowIndex];
    if (!row || importExecutionInProgress || String(row.overallStatus || 'pending') !== 'pending') return null;
    if (!importExecutionRoleReady(row.personId)) {
      await ensureImportExecutionRoles();
    }
    const personRole = resolveImportExecutionPersonRole(row.personId);
    row.steps = {
      workSessions: { status: 'running', summary: '', error: '' },
      timesheet: { status: 'pending', summary: '', error: '' },
      processed: { status: 'pending', summary: '', error: '' }
    };
    renderImportExecutionTable();

    const loadingToken = beginImportExecutionLoading('Running import steps for ' + (row.fileName || row.periodName || 'selected file') + '...');
    try {
      const res = await fetch('/school/timesheets/manage/api/import/execution/perform', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
          'X-AJAX-Request': 'true'
        },
        body: JSON.stringify({
          personId: row.personId,
          periodId: row.periodId,
          personRole,
          batchId: row.batchId,
          compileResult: row.compileResult,
          actionStateId
        })
      });
      const payload = await res.json();
      const guarded = typeof window.applyGuardedApiResult === 'function'
        ? await window.applyGuardedApiResult(payload, { busyTitle: 'Import Execution In Progress', replayTitle: 'Import Execution Already Processed' })
        : { stop: false };
      if (guarded.stop) return null;
      if (!res.ok || payload.status === 'error') {
        row.steps = payload.steps || row.steps;
        row.overallStatus = 'error';
        row.errorMessage = payload.message || 'Import execution failed.';
        throw new Error(payload.message || 'Import execution failed.');
      }
      applyActionStateFromResult(payload);
      row.steps = payload.steps || row.steps;
      row.overallStatus = 'success';
      row.timesheetId = payload.timesheetId || '';
      return payload;
    } catch (error) {
      if (String(row.overallStatus || '') !== 'success') row.overallStatus = 'error';
      row.errorMessage = error.message || String(error);
      throw error;
    } finally {
      endImportApplyLoading(loadingToken);
      renderImportExecutionTable();
    }
  }

  async function performAllImportExecutions() {
    if (importExecutionInProgress) return;
    importExecutionInProgress = true;
    renderImportExecutionTable();
    try {
      await ensureImportExecutionRoles();
      for (let index = 0; index < importExecutionRows.length; index += 1) {
        if (String(importExecutionRows[index]?.overallStatus || 'pending') !== 'pending') continue;
        // eslint-disable-next-line no-await-in-loop
        await performImportExecutionRow(index);
      }
    } finally {
      importExecutionInProgress = false;
      renderImportExecutionTable();
    }
  }

  async function openImportExecutionModal() {
    if (!CAN_IMPORT_TIMESHEETS || importApplyInProgress || !importCompilePayload) return;
    const personId = cleanId(importCompilePayload.personId);
    const results = Array.isArray(importCompilePayload.results) ? importCompilePayload.results : [];
    if (!personId || !importResultsReadyForApply(results)) {
      await showMessage({
        title: 'Import Excel',
        icon: 'warning',
        message: 'No compiled files matched an app timesheet period for import.',
        buttons: [{ text: 'OK', class: 'btn-primary' }]
      });
      return;
    }

    const isSinglePeriod = importMode === 'singlePeriod';
    const periodId = isSinglePeriod
      ? cleanId(importTargetPeriod?.id || loadedPeriod?.id || periodSelect?.value || '')
      : '';

    if (isSinglePeriod && !periodId) {
      await showMessage({
        title: 'Import Excel',
        icon: 'warning',
        message: 'Load a timesheet period before importing.'
      });
      return;
    }

    if (!isSinglePeriod) {
      const mismatch = buildImportMismatchSummary(results, importCompilePayload.personName || personId);
      if (mismatch.blocking) {
        const lines = mismatch.issues
          .filter((issue) => issue.blocking)
          .map((issue) => '<li><b>' + escapeHtml(issue.fileName) + ':</b> ' + escapeHtml(issue.message) + '</li>')
          .join('');
        await showMessage({
          title: 'Import Blocked',
          icon: 'error',
          message: 'Some files cannot be imported:<ul class="mb-0 ps-3 mt-2">' + lines + '</ul>',
          buttons: [{ text: 'OK', class: 'btn-danger' }]
        });
        return;
      }
      if (mismatch.hasIssues) {
        const lines = mismatch.issues
          .map((issue) => '<li><b>' + escapeHtml(issue.fileName) + ':</b> ' + escapeHtml(issue.message) + '</li>')
          .join('');
        const mismatchConfirmed = await uiConfirm(
          'Review these differences before importing:<ul class="mb-0 ps-3 mt-2 text-start">' + lines + '</ul>',
          'Confirm Import Mismatches'
        );
        if (!mismatchConfirmed) return;
      }
    }

    const existingTimesheetRows = loadedRows.filter((row) => idsEqual(row.personId, personId) && cleanId(row.timesheetId));
    const replaceMessage = isSinglePeriod
      ? (existingTimesheetRows.length
        ? 'A timesheet already exists for this period. Import will be skipped unless you delete or clear the existing timesheet first. Continue?'
        : 'Run the 3-step import execution for the loaded timesheet period?')
      : (existingTimesheetRows.length
        ? 'Some matched periods already have timesheets and will be skipped. Continue importing into periods without an existing timesheet?'
        : 'Run the 3-step import execution for matched period(s) that do not already have a timesheet?');
    const confirmed = await uiConfirm(replaceMessage, 'Confirm Import');
    if (!confirmed) return;

    importApplyInProgress = true;
    updateImportReviewConfirmButton();
    const loadingToken = beginImportExecutionLoading('Preparing import execution plan...');
    try {
      const res = await fetch('/school/timesheets/manage/api/import/execution/plan', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
          'X-AJAX-Request': 'true'
        },
        body: JSON.stringify({
          personId,
          periodId,
          results,
          actionStateId
        })
      });
      const payload = await res.json();
      if (!res.ok || payload.status !== 'success') {
        throw new Error(payload.message || 'Import execution plan failed.');
      }
      applyActionStateFromResult(payload);
      importExecutionPlan = payload;
      importExecutionRows = (Array.isArray(payload.rows) ? payload.rows : []).map((row) => ({
        ...row,
        overallStatus: 'pending',
        steps: {
          workSessions: { status: 'pending', summary: '', error: '' },
          timesheet: { status: 'pending', summary: '', error: '' },
          processed: { status: 'pending', summary: '', error: '' }
        }
      }));
      if (!importExecutionRows.length) {
        const skipped = Array.isArray(payload.skipped) ? payload.skipped : [];
        const skipLines = skipped.map((row) => '<li>' + escapeHtml(row.message || row.fileName || 'Skipped') + '</li>').join('');
        await showMessage({
          title: 'Import Execution',
          icon: 'warning',
          message: 'No files are ready to execute.'
            + (skipLines ? '<ul class="mb-0 ps-3 mt-2">' + skipLines + '</ul>' : '')
        });
        return;
      }
      if (cleanId(payload.defaultPersonRole)) {
        importExecutionPersonRoleByPersonId[personId] = cleanId(payload.defaultPersonRole);
      }
      await hideBootstrapModalAndWait(importReviewModalEl);
      renderImportExecutionTable();
      ensureModalOnBody(importExecutionModalEl)?.show();
      await ensureImportExecutionRoles();
      renderImportExecutionTable();
    } catch (error) {
      await showMessage({
        title: 'Import Execution Error',
        icon: 'error',
        message: escapeHtml(error.message || String(error)),
        buttons: [{ text: 'OK', class: 'btn-danger' }]
      });
    } finally {
      endImportApplyLoading(loadingToken);
      importApplyInProgress = false;
      updateImportReviewConfirmButton();
    }
  }

  async function applyLegacyImport() {
    return openImportExecutionModal();
  }

  async function deleteLegacyImport(personId, personName, sourceFileName) {
    if (!CAN_IMPORT_TIMESHEETS) return;
    const targetPersonId = cleanId(personId);
    const periodId = cleanId(loadedPeriod?.id || periodSelect?.value || '');
    if (!targetPersonId || !periodId) {
      await showMessage({ title: 'Delete Imported File', icon: 'warning', message: 'Load a timesheet period before deleting an imported timesheet.' });
      return;
    }
    const label = cleanId(sourceFileName) || 'imported file';
    const confirmed = await uiConfirm(
      'Remove imported timesheet rows from <b>' + escapeHtml(personName || targetPersonId) + '</b> for this period?<br><span class="small text-muted">Source: ' + escapeHtml(label) + '</span>',
      'Delete imported file?'
    );
    if (!confirmed) return;

    const loadingToken = beginLegacyDeleteLoading();
    try {
      const params = new URLSearchParams({ personId: targetPersonId, periodId });
      if (actionStateId) params.set('actionStateId', actionStateId);
      const res = await fetch('/school/timesheets/manage/api/import/legacy?' + params.toString(), {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json', 'X-AJAX-Request': 'true' },
        body: JSON.stringify({ actionStateId })
      });
      const payload = await res.json();
      if (!res.ok || payload.status !== 'success') {
        throw new Error(payload.message || 'Delete request failed.');
      }
      applyActionStateFromResult(payload);
      await loadRoster();
      await showMessage({
        title: 'Imported Timesheet Removed',
        icon: 'success',
        message: escapeHtml(payload.message || 'Imported timesheet rows were removed.')
      });
    } catch (error) {
      await showMessage({ title: 'Delete Error', icon: 'error', message: escapeHtml(error.message || String(error)) });
    } finally {
      endLegacyDeleteLoading(loadingToken);
    }
  }

  function idsEqual(left, right) {
    return cleanId(left).toLowerCase() === cleanId(right).toLowerCase();
  }

  function setImportReviewNavBusy(busy) {
    importReviewNavBusy = busy;
    const total = Array.isArray(importCompilePayload?.results) ? importCompilePayload.results.length : 0;
    if (importReviewPrevBtn) {
      importReviewPrevBtn.disabled = busy || importReviewIndex <= 0;
      importReviewPrevBtn.innerHTML = busy
        ? '<span class="spinner-border spinner-border-sm me-1"></span> Loading...'
        : importReviewPrevBtnHtml;
    }
    if (importReviewNextBtn) {
      importReviewNextBtn.disabled = busy || importReviewIndex >= total - 1;
      importReviewNextBtn.innerHTML = busy
        ? '<span class="spinner-border spinner-border-sm me-1"></span> Loading...'
        : importReviewNextBtnHtml;
    }
    if (importReviewPeriodTabs) {
      importReviewPeriodTabs.querySelectorAll('[data-import-review-index]').forEach((btn) => {
        btn.disabled = busy;
      });
    }
    updateImportReviewConfirmButton();
  }

  function scheduleImportReviewRender() {
    setImportReviewNavBusy(true);
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        renderImportReviewCurrent();
        setImportReviewNavBusy(false);
      });
    });
  }

  function navigateImportReview(nextIndex) {
    if (importReviewNavBusy) return;
    const total = Array.isArray(importCompilePayload?.results) ? importCompilePayload.results.length : 0;
    if (!Number.isFinite(nextIndex) || nextIndex < 0 || nextIndex >= total) return;
    importReviewIndex = nextIndex;
    scheduleImportReviewRender();
  }

  function openImportReviewModal(payload) {
    if (payload && Array.isArray(payload.results)) {
      payload = { ...payload, results: sortImportCompileResults(payload.results) };
    }
    importCompilePayload = payload || null;
    importReviewIndex = 0;
    const modal = ensureModalOnBody(importReviewModalEl);
    if (modal) modal.show();
    scheduleImportReviewRender();
  }

  async function compileTimesheetImport() {
    if (importCompileInProgress) return;
    const isSinglePeriod = importMode === 'singlePeriod';
    const personId = String(importTeacherId?.value || '').trim();
    const year = isSinglePeriod
      ? resolveImportYearFromPeriod(importTargetPeriod || loadedPeriod)
      : String(importYear?.value || '').trim();
    const files = Array.from(importExcelFiles?.files || []);
    const expectedPeriodId = isSinglePeriod
      ? cleanId(importTargetPeriod?.id || loadedPeriod?.id || periodSelect?.value || '')
      : '';

    if (!personId) {
      await showMessage({ title: 'Import Excel', icon: 'warning', message: 'Please select a teacher or staff member.' });
      return;
    }
    if (!/^\d{4}$/.test(year)) {
      await showMessage({ title: 'Import Excel', icon: 'warning', message: 'Please choose a valid year.' });
      return;
    }
    if (!files.length) {
      await showMessage({ title: 'Import Excel', icon: 'warning', message: 'Please attach at least one .xlsx file.' });
      return;
    }
    if (isSinglePeriod && files.length !== 1) {
      await showMessage({ title: 'Import Excel', icon: 'warning', message: 'Row import accepts exactly one Excel file.' });
      return;
    }
    if (isSinglePeriod && !expectedPeriodId) {
      await showMessage({ title: 'Import Excel', icon: 'warning', message: 'Load a timesheet period before importing.' });
      return;
    }

    const formData = new FormData();
    formData.append('personId', personId);
    formData.append('year', year);
    if (expectedPeriodId) formData.append('expectedPeriodId', expectedPeriodId);
    files.forEach((file) => formData.append('files', file));

    const originalHtml = btnCompileTimesheetImport?.innerHTML || '';
    importCompileInProgress = true;
    if (btnCompileTimesheetImport) {
      btnCompileTimesheetImport.disabled = true;
      btnCompileTimesheetImport.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Compiling...';
    }

    try {
      const res = await fetch('/school/timesheets/manage/api/import/compile', {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'X-AJAX-Request': 'true' },
        body: formData
      });
      const payload = await res.json();
      if (!res.ok || payload.status !== 'success') {
        throw new Error(payload.message || 'Compile request failed.');
      }
      importMode = expectedPeriodId ? 'singlePeriod' : 'bulk';
      if (expectedPeriodId) importTargetPeriod = loadedPeriod || importTargetPeriod;
      const setupModal = ensureModalOnBody(importSetupModalEl);
      if (setupModal) setupModal.hide();
      openImportReviewModal(payload);
    } catch (error) {
      await showMessage({ title: 'Import Compile Error', icon: 'error', message: escapeHtml(error.message || String(error)) });
    } finally {
      importCompileInProgress = false;
      if (btnCompileTimesheetImport) {
        btnCompileTimesheetImport.disabled = false;
        btnCompileTimesheetImport.innerHTML = originalHtml;
      }
    }
  }

  populateImportYearOptions();
  btnOpenTimesheetBulkImport?.addEventListener('click', () => openBulkImportSetupModal());
  btnConfirmTimesheetImport?.addEventListener('click', () => { void openImportExecutionModal(); });
  btnPerformAllImportExecutions?.addEventListener('click', () => { void performAllImportExecutions(); });
  importExecutionTableBody?.addEventListener('click', (event) => {
    const btn = event.target.closest('[data-import-exec-perform]');
    if (!btn || btn.disabled || importExecutionInProgress) return;
    const rowIndex = Number(btn.getAttribute('data-import-exec-perform'));
    importExecutionInProgress = true;
    renderImportExecutionTable();
    performImportExecutionRow(rowIndex)
      .then(async (payload) => {
        if (payload && loadedPeriod?.id) await loadRoster();
        if (payload) {
          await showImportApplyResultMessage(payload, payload.periodId, payload.personId);
        }
      })
      .catch(async (error) => {
        await showMessage({
          title: 'Import Execution Error',
          icon: 'error',
          message: escapeHtml(error.message || String(error)),
          buttons: [{ text: 'OK', class: 'btn-danger' }]
        });
      })
      .finally(() => {
        importExecutionInProgress = false;
        renderImportExecutionTable();
      });
  });
  btnConfirmImportExecutionRole?.addEventListener('click', () => {
    const needs = Array.isArray(importExecutionPlan?.needsRoleSelection) ? importExecutionPlan.needsRoleSelection : [];
    const pending = needs.find((row) => !importExecutionRoleReady(row.personId));
    const personId = cleanId(pending?.personId || importCompilePayload?.personId);
    const role = cleanId(importExecutionPersonRole?.value || '');
    if (personId && role) importExecutionPersonRoleByPersonId[personId] = role;
    if (importRoleModalEl) bootstrap.Modal.getOrCreateInstance(importRoleModalEl).hide();
    if (typeof importExecutionRoleResolver === 'function') {
      importExecutionRoleResolver(role);
      importExecutionRoleResolver = null;
    }
    renderImportExecutionTable();
  });
  importExecutionModalEl?.addEventListener('hidden.bs.modal', () => {
    const hasPending = (importExecutionRows || []).some((row) => String(row.overallStatus || 'pending') === 'pending');
    if (!hasPending) {
      importCompilePayload = null;
      importExecutionPlan = null;
      importExecutionRows = [];
    }
  });
  btnPickImportTeacher?.addEventListener('click', async () => {
    if (importMode === 'singlePeriod') return;
    if (!window.GenericPicker || !window.GenericPickerPresets) {
      await showMessage({ title: 'Teacher Picker', icon: 'warning', message: 'The person picker is not available on this page. Please refresh and try again.' });
      return;
    }
    window.GenericPicker.open(window.GenericPickerPresets.person({
      title: 'Select Teacher/Staff for Import',
      apiEndpoint: '/school/timesheets/api/eligible-persons',
      placeholder: 'Search teacher or staff...',
      onSelect: (item) => setImportTeacher(item)
    }));
  });
  btnClearImportTeacher?.addEventListener('click', () => {
    if (importMode === 'singlePeriod') return;
    clearImportTeacher();
  });
  importExcelFiles?.addEventListener('change', renderImportFileList);
  btnCompileTimesheetImport?.addEventListener('click', () => { void compileTimesheetImport(); });
  importReviewPrevBtn?.addEventListener('click', () => {
    if (importReviewIndex > 0) navigateImportReview(importReviewIndex - 1);
  });
  importReviewNextBtn?.addEventListener('click', () => {
    const total = Array.isArray(importCompilePayload?.results) ? importCompilePayload.results.length : 0;
    if (importReviewIndex < total - 1) navigateImportReview(importReviewIndex + 1);
  });
  importReviewFileNav?.addEventListener('click', (event) => {
    const btn = event.target.closest('[data-import-review-index]');
    if (!btn || btn.disabled) return;
    const nextIndex = Number(btn.getAttribute('data-import-review-index'));
    navigateImportReview(nextIndex);
  });
})();
</script>
