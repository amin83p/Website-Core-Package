<style>
  .timesheet-role-pill {
    letter-spacing: .02em;
  }
  .timesheet-status-dot {
    width: .65rem;
    height: .65rem;
    border-radius: 999px;
    display: inline-block;
  }

  #timesheetImportReviewModal .modal-content {
    border-radius: 14px;
    overflow: hidden;
  }
  #timesheetImportReviewModal .modal-header {
    background: linear-gradient(135deg, #f8fafc 0%, #eef2ff 100%);
    border-bottom: 1px solid #e2e8f0;
    padding: 1rem 1.25rem;
  }
  #timesheetImportExecutionModal {
    z-index: 1065;
  }
  #timesheetImportExecutionModal .modal-content,
  #timesheetImportRoleModal .modal-content {
    border-radius: 14px;
    overflow: hidden;
  }
  #timesheetImportExecutionModal .modal-header {
    background: linear-gradient(135deg, #f0fdf4 0%, #eef2ff 100%);
    border-bottom: 1px solid #e2e8f0;
  }
  .ts-import-exec-status {
    font-size: .78rem;
    line-height: 1.35;
  }
  .ts-import-exec-status.is-pending { color: #64748b; }
  .ts-import-exec-status.is-running { color: #0d6efd; }
  .ts-import-exec-status.is-success { color: #198754; }
  .ts-import-exec-status.is-error { color: #dc3545; }
  #timesheetImportSetupModal .modal-content {
    border-radius: 14px;
  }

  .ts-import-summary {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1rem 1.1rem;
    margin-bottom: 1rem;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
  }
  .ts-import-summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: .75rem;
  }
  .ts-import-summary-item {
    background: #f8fafc;
    border: 1px solid #e8edf3;
    border-radius: 10px;
    padding: .65rem .8rem;
    min-height: 4.5rem;
  }
  .ts-import-summary-item.ts-import-summary-item-wide {
    grid-column: span 2;
  }
  @media (max-width: 640px) {
    .ts-import-summary-item.ts-import-summary-item-wide {
      grid-column: span 1;
    }
  }
  .ts-import-summary-label {
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: #64748b;
    margin-bottom: .2rem;
  }
  .ts-import-summary-value {
    font-size: .92rem;
    font-weight: 600;
    color: #0f172a;
    line-height: 1.35;
    word-break: break-word;
  }
  .ts-import-summary-sub {
    font-size: .78rem;
    color: #64748b;
    margin-top: .15rem;
  }
  .ts-import-file-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: .5rem;
    margin-bottom: 1rem;
    padding: .55rem .75rem;
    background: #f1f5f9;
    border-radius: 10px;
    border: 1px solid #e2e8f0;
  }
  .ts-import-file-nav .file-name {
    font-weight: 600;
    color: #1e293b;
    font-size: .9rem;
  }
  .ts-import-file-nav .file-counter {
    font-size: .78rem;
    color: #64748b;
    font-weight: 600;
    letter-spacing: .02em;
    text-transform: uppercase;
  }
  .ts-import-period-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: .35rem;
  }
  .ts-import-file-nav .file-name .ts-import-summary-sub {
    font-weight: 400;
  }
  .ts-import-match-pill {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    font-size: .78rem;
    font-weight: 600;
    padding: .2rem .55rem;
    border-radius: 999px;
    border: 1px solid transparent;
  }
  .ts-import-match-pill.exact {
    background: #dcfce7;
    color: #166534;
    border-color: #86efac;
  }
  .ts-import-match-pill.partial {
    background: #fef9c3;
    color: #854d0e;
    border-color: #fde047;
  }
  .ts-import-match-pill.none {
    background: #fee2e2;
    color: #991b1b;
    border-color: #fca5a5;
  }
  .ts-import-period-warn-item {
    margin-bottom: .35rem;
  }
  .ts-import-period-warn-detail {
    margin-top: .55rem;
    padding: .65rem .75rem;
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(133, 77, 14, 0.18);
    border-radius: 10px;
  }
  .ts-import-period-warn-row + .ts-import-period-warn-row {
    margin-top: .55rem;
    padding-top: .55rem;
    border-top: 1px dashed rgba(133, 77, 14, 0.18);
  }
  .ts-import-period-warn-label {
    display: block;
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: #92400e;
    margin-bottom: .15rem;
  }
  .ts-import-period-warn-value {
    display: block;
    font-size: .88rem;
    font-weight: 600;
    color: #78350f;
    line-height: 1.35;
  }
  .ts-import-period-warn-sub {
    font-size: .76rem;
    color: #92400e;
    margin-top: .1rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }
  .ts-import-period-warn-notes {
    margin-top: .55rem;
    font-size: .82rem;
    color: #78350f;
  }
  .ts-import-ledger-wrap {
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
  }
  .ts-import-ledger-table {
    margin: 0;
    font-size: .86rem;
  }
  .ts-import-ledger-table thead th {
    background: #f1f5f9;
    color: #475569;
    font-size: .72rem;
    text-transform: uppercase;
    letter-spacing: .03em;
    font-weight: 700;
    border-bottom: 1px solid #dbe3ee;
    white-space: nowrap;
    padding: .65rem .75rem;
  }
  .ts-import-ledger-table tbody td {
    vertical-align: middle;
    border-color: #e8edf3;
    padding: .55rem .75rem;
  }
  .ts-import-ledger-table tbody tr.ts-import-band-even > td {
    background: #ffffff;
  }
  .ts-import-ledger-table tbody tr.ts-import-band-odd > td {
    background: #f8fafc;
  }
  .ts-import-ledger-table tbody tr.ts-import-band-even > td.date-cell,
  .ts-import-ledger-table tbody tr.ts-import-band-odd > td.date-cell,
  .ts-import-ledger-table tbody tr.ts-import-band-even > td.day-cell,
  .ts-import-ledger-table tbody tr.ts-import-band-odd > td.day-cell {
    background: #eff6ff;
    border-right: 1px solid #dbeafe;
  }
  .ts-import-ledger-table .date-cell {
    font-weight: 700;
    color: #1e3a8a;
    min-width: 9.5rem;
    line-height: 1.3;
  }
  .ts-import-ledger-table .date-cell .date-sub {
    display: block;
    font-size: .74rem;
    font-weight: 600;
    color: #64748b;
    margin-top: .1rem;
  }
  .ts-import-ledger-table .day-cell {
    font-weight: 600;
    color: #334155;
    white-space: nowrap;
  }
  .ts-import-ledger-table .class-cell {
    font-weight: 600;
    color: #0f172a;
  }
  .ts-import-ledger-table .hours-cell {
    font-weight: 700;
    color: #0f766e;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .ts-import-ledger-table .comment-cell {
    color: #475569;
    max-width: 240px;
    white-space: pre-wrap;
  }
  .ts-import-ledger-table tr.ts-import-day-total > td {
    border-top: 1px solid #cbd5e1;
    font-weight: 700;
  }
  .ts-import-ledger-table tr.ts-import-day-total .day-total-label {
    color: #475569;
    font-size: .78rem;
    text-transform: uppercase;
    letter-spacing: .03em;
  }
  .ts-import-ledger-table tr.ts-import-day-total .day-total-hours {
    color: #0f766e;
    font-variant-numeric: tabular-nums;
  }
  .ts-import-ledger-table tr.ts-import-day-gap > td {
    padding: 0;
    height: .35rem;
    background: #e2e8f0 !important;
    border: 0;
  }
  .ts-import-stats-bar {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    margin-top: .25rem;
    padding: .7rem .85rem;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    font-size: .84rem;
    color: #334155;
  }
  .ts-import-stats-bar strong {
    color: #0f172a;
  }
  .ts-import-empty {
    text-align: center;
    color: #64748b;
    padding: 2rem 1rem;
    border: 1px dashed #cbd5e1;
    border-radius: 12px;
    background: #f8fafc;
  }
</style>

<div class="d-flex align-items-end flex-wrap gap-3 mb-4 p-3 bg-light border rounded shadow-sm">
  <div style="min-width: 320px; max-width: 540px; flex: 1 1 360px;">
    <label for="periodDisplay" class="form-label fw-bold small mb-1">
      <i class="bi bi-calendar-week me-1"></i> Timesheet Period
    </label>
    <div class="input-group shadow-sm">
      <input type="hidden" id="periodSelect" value="">
      <input type="text" id="periodDisplay" class="form-control size-md bg-white border-secondary" placeholder="Select a timesheet period..." readonly>
      <button type="button" id="btnPickPeriod" class="btn btn-primary btn-filled" title="Select Timesheet Period">
        <i class="bi bi-search"></i>
      </button>
      <button type="button" id="btnClearPeriod" class="btn btn-outline-secondary border-secondary" title="Clear Period">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>
  </div>
  <div style="min-width: 220px; flex: 0 1 240px;">
    <label for="timesheetStatusFilter" class="form-label fw-bold small mb-1">
      <i class="bi bi-funnel me-1"></i> Timesheet Status
    </label>
    <select id="timesheetStatusFilter" class="form-select size-md border-secondary shadow-sm">
      <option value="">All statuses</option>
      <option value="not_started">Not Started</option>
      <option value="draft">Draft</option>
      <option value="submitted">Submitted</option>
      <option value="processed">Processed</option>
    </select>
  </div>
  <div style="min-width: 260px; flex: 1 1 260px;">
    <label for="personSearch" class="form-label fw-bold small mb-1">
      <i class="bi bi-search me-1"></i> Search Loaded Rows
    </label>
    <input type="search" id="personSearch" class="form-control size-md border-secondary shadow-sm" placeholder="Search name, id, role, status...">
  </div>
  <div class="d-flex flex-wrap gap-2">
    <button type="button" id="btnLoadRoster" class="btn btn-success btn-filled btn-md">
      <i class="bi bi-cloud-download me-1"></i> Load Timesheets
    </button>
    <button type="button" id="btnClearRoster" class="btn btn-outline-secondary btn-md">
      <i class="bi bi-x-circle me-1"></i> Clear
    </button>
  </div>
  <div id="periodMeta" class="small text-muted w-100">
    Pick a timesheet period, then load the active teacher/staff roster for your active organization.
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-header bg-white d-flex flex-wrap align-items-center justify-content-between gap-2">
    <div>
      <h5 class="mb-0 fw-bold"><i class="bi bi-people-fill me-2 text-primary"></i> Period Timesheets</h5>
      <div class="small text-muted" id="rosterCount">No period loaded yet.</div>
    </div>
    <div class="small text-muted">Rows are scoped to the active organization.</div>
  </div>
  <div class="table-responsive table-scroll-wrapper" data-floating-row-actions="true">
    <table class="table table-hover align-middle mb-0" id="timesheetManageTable">
      <thead class="table-light">
        <tr>
          <% if (typeof canPrintManagedTimesheets !== 'undefined' && canPrintManagedTimesheets) { %>
            <th class="text-center" style="width: 2.5rem;">
              <input type="checkbox" id="timesheetSelectAllVisible" class="form-check-input" title="Select all visible printable timesheets" aria-label="Select all visible printable timesheets">
            </th>
          <% } %>
          <th class="ps-4">Person</th>
          <th>Roles</th>
          <th>Department/Profile</th>
          <th class="text-center">Timesheet Status</th>
          <th class="text-end">Total Hours</th>
          <th class="text-end pe-4">Actions</th>
        </tr>
      </thead>
      <tbody id="timesheetRosterBody">
        <tr>
          <td colspan="<%= (typeof canPrintManagedTimesheets !== 'undefined' && canPrintManagedTimesheets) ? 7 : 6 %>" class="text-center py-5 text-muted">
            <i class="bi bi-calendar2-check fs-1 d-block mb-2"></i>
            Select a period and click <b>Load Timesheets</b>.
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<div class="modal fade" id="timesheetImportSetupModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg" style="border-radius:14px;">
      <div class="modal-header" style="background:linear-gradient(135deg,#f8fafc 0%,#eef2ff 100%);border-bottom:1px solid #e2e8f0;">
        <div>
          <h5 class="modal-title fw-bold" id="importSetupModalTitle"><i class="bi bi-file-earmark-spreadsheet me-2 text-primary"></i> Import Legacy Timesheets</h5>
          <div class="small text-muted" id="importSetupModalSubtitle">Upload one or more Excel files for a selected teacher and year.</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3 d-none" id="importPeriodFieldWrap">
          <label class="form-label fw-bold small mb-1">Timesheet Period</label>
          <input type="text" id="importPeriodDisplay" class="form-control" readonly>
        </div>
        <div class="mb-3" id="importTeacherFieldWrap">
          <label class="form-label fw-bold small mb-1">Teacher / Staff</label>
          <div class="input-group">
            <input type="hidden" id="importTeacherId" value="">
            <input type="text" id="importTeacherDisplay" class="form-control" placeholder="Select teacher or staff..." readonly>
            <button type="button" id="btnPickImportTeacher" class="btn btn-primary"><i class="bi bi-search"></i></button>
            <button type="button" id="btnClearImportTeacher" class="btn btn-outline-secondary" title="Clear teacher"><i class="bi bi-x-lg"></i></button>
          </div>
        </div>
        <div class="mb-3" id="importYearFieldWrap">
          <label for="importYear" class="form-label fw-bold small mb-1">Year</label>
          <select id="importYear" class="form-select"></select>
        </div>
        <div class="mb-2">
          <label for="importExcelFiles" class="form-label fw-bold small mb-1" id="importExcelFilesLabel">Excel Files</label>
          <input type="file" id="importExcelFiles" class="form-control" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet">
          <div class="form-text" id="importExcelFilesHelp">Supported format: .xlsx (Equilibrium School legacy timesheet template).</div>
        </div>
        <ul id="importFileList" class="list-group list-group-flush small"></ul>
      </div>
      <div class="modal-footer bg-light">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" id="btnCompileTimesheetImport" class="btn btn-primary">
          <i class="bi bi-gear-wide-connected me-1"></i> Compile
        </button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="timesheetImportReviewModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content border-0 shadow-lg">
      <div class="modal-header">
        <div class="w-100">
          <h5 class="modal-title fw-bold mb-0"><i class="bi bi-clipboard-data me-2 text-primary"></i> Import Compile Report</h5>
          <div class="small text-muted mt-1">Review compiled legacy timesheet rows before import.</div>
        </div>
        <button type="button" class="btn-close ms-2" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body bg-light-subtle" style="background:#f8fafc;">
        <div id="importReviewFileNav" class="ts-import-file-nav d-none">
          <div class="w-100">
            <div>
              <div class="file-counter" id="importReviewFileIndicator"></div>
              <div class="file-name" id="importReviewFileName"></div>
            </div>
            <div id="importReviewPeriodTabs" class="ts-import-period-tabs mt-2"></div>
          </div>
        </div>
        <div id="importReviewSummary" class="ts-import-summary"></div>
        <div id="importReviewErrorPanel" class="alert alert-danger border-0 shadow-sm d-none">
          <div class="fw-bold"><i class="bi bi-exclamation-octagon me-1"></i> Error</div>
          <ul id="importReviewErrorList" class="mb-0 ps-3 mt-2"></ul>
        </div>
        <div id="importReviewWarningsPanel" class="alert alert-warning border-0 shadow-sm d-none">
          <div class="fw-bold"><i class="bi bi-exclamation-triangle me-1"></i> Warnings</div>
          <ul id="importReviewWarningsList" class="mb-0 ps-3 mt-2"></ul>
        </div>
        <div id="importReviewTableWrap"></div>
        <div id="importReviewStats" class="ts-import-stats-bar d-none"></div>
      </div>
      <div class="modal-footer bg-white border-top d-flex justify-content-between">
        <div class="btn-group">
          <button type="button" id="importReviewPrevBtn" class="btn btn-outline-secondary"><i class="bi bi-chevron-left"></i> Back</button>
          <button type="button" id="importReviewNextBtn" class="btn btn-outline-secondary">Next <i class="bi bi-chevron-right"></i></button>
        </div>
        <div class="d-flex gap-2">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <% if (typeof canImportTimesheets !== 'undefined' && canImportTimesheets) { %>
          <button type="button" id="btnConfirmTimesheetImport" class="btn btn-primary">
            <i class="bi bi-check2-circle me-1"></i> Confirm Import
          </button>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="timesheetImportRoleModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" style="z-index: 1070;">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg">
      <div class="modal-header">
        <h5 class="modal-title fw-bold"><i class="bi bi-person-badge me-2 text-primary"></i> Payroll Role</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="small text-muted mb-3" id="importRolePromptText">Which payroll role should this import use?</p>
        <label class="form-label fw-semibold" for="importExecutionPersonRole">Role</label>
        <select id="importExecutionPersonRole" class="form-select">
          <option value="teacher">Teacher</option>
          <option value="staff">Staff</option>
        </select>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" id="btnConfirmImportExecutionRole" class="btn btn-primary">Save Role</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="timesheetImportExecutionModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content border-0 shadow-lg">
      <div class="modal-header">
        <div class="w-100">
          <h5 class="modal-title fw-bold mb-0"><i class="bi bi-play-circle me-2 text-success"></i> Import Execution</h5>
          <div class="small text-muted mt-1">Create activity work sessions, assemble the full timesheet, then mark it processed.</div>
        </div>
        <button type="button" class="btn-close ms-2" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body bg-light-subtle" style="background:#f8fafc;">
        <div id="importExecutionAlerts"></div>
        <div class="table-responsive">
          <table class="table table-sm align-middle bg-white border rounded-3 overflow-hidden mb-0">
            <thead class="table-light">
              <tr>
                <th>File</th>
                <th>Person</th>
                <th>Period</th>
                <th>Creating Work Sessions</th>
                <th>Creating the timesheet</th>
                <th>Making the timesheet processed</th>
                <th class="text-end">Action</th>
              </tr>
            </thead>
            <tbody id="importExecutionTableBody"></tbody>
          </table>
        </div>
      </div>
      <div class="modal-footer bg-white border-top d-flex justify-content-between">
        <button type="button" id="btnPerformAllImportExecutions" class="btn btn-outline-primary">
          <i class="bi bi-collection-play me-1"></i> Perform All
        </button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="departmentSummaryModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-light">
        <div>
          <h5 class="modal-title fw-bold"><i class="bi bi-diagram-3 me-2 text-primary"></i> Department Hours Summary</h5>
          <div class="small text-muted" id="departmentSummarySubtitle"></div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="departmentSummaryContent" class="table-responsive"></div>
      </div>
      <div class="modal-footer bg-light">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<span id="urlRef" data-id="school/timesheets/manage" hidden></span>
<%- include('partials/tablePages-end') %>
<%- include('partials/modal_GenericPicker', { user }) %>
<script src="/scripts/timesheetDepartmentHoursView.js"></script>

<script>
(function () {
  const CAN_PRINT_MANAGED_TIMESHEETS = <%= (typeof canPrintManagedTimesheets !== 'undefined' && canPrintManagedTimesheets) ? 'true' : 'false' %>;
  const CAN_ALLOW_LATE_SUBMISSION = <%= (typeof canAllowLateSubmission !== 'undefined' && canAllowLateSubmission) ? 'true' : 'false' %>;
  const CAN_IMPORT_TIMESHEETS = <%= (typeof canImportTimesheets !== 'undefined' && canImportTimesheets) ? 'true' : 'false' %>;
  let actionStateId = '<%= (typeof actionStateId !== 'undefined' && actionStateId) ? actionStateId : '' %>';
  const TIMESHEET_MANAGE_PRINT_ACTION = '/school/timesheets/manage/print';
  const HAS_PRINT_SELECTION = CAN_PRINT_MANAGED_TIMESHEETS;
  const TABLE_COLSPAN = HAS_PRINT_SELECTION ? 7 : 6;

  const periodSelect = document.getElementById('periodSelect');
  const periodDisplay = document.getElementById('periodDisplay');
  const btnPickPeriod = document.getElementById('btnPickPeriod');
  const btnClearPeriod = document.getElementById('btnClearPeriod');
  const btnLoad = document.getElementById('btnLoadRoster');
  const btnClear = document.getElementById('btnClearRoster');
  const btnPrintSelected = document.getElementById('btnPrintSelectedTimesheets');
  const selectAllVisible = document.getElementById('timesheetSelectAllVisible');
  const personSearch = document.getElementById('personSearch');
  const timesheetStatusFilter = document.getElementById('timesheetStatusFilter');
  const tbody = document.getElementById('timesheetRosterBody');
  const rosterCount = document.getElementById('rosterCount');
  const periodMeta = document.getElementById('periodMeta');
  const summaryModalEl = document.getElementById('departmentSummaryModal');
  const summarySubtitle = document.getElementById('departmentSummarySubtitle');
  const summaryContent = document.getElementById('departmentSummaryContent');
  let loadedRows = [];
  let loadedPeriod = null;
  const selectedPersonIds = new Set();

  function escapeHtml(value) {
    return String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function showMessage(options) {
    if (typeof window.showMessageModal === 'function') return window.showMessageModal(options);
    if (options && options.message) alert(String(options.message).replace(/<[^>]+>/g, ' '));
    return Promise.resolve();
  }

  async function uiConfirm(message, title = 'Confirm') {
    try {
      if (typeof window.showMessageModal === 'function') {
        const res = await window.showMessageModal({
          title,
          icon: 'warning',
          message,
          size: 'md',
          buttons: [
            { text: 'No', class: 'btn-secondary btn-md' },
            { text: 'Yes', class: 'btn-primary btn-md' }
          ]
        });
        return res === 'Yes';
      }
    } catch (e) { /* fall back */ }
    return confirm(String(message || '').replace(/<[^>]+>/g, ' '));
  }

  function hideBootstrapModalAndWait(modalEl) {
    if (!modalEl || !window.bootstrap?.Modal) return Promise.resolve();
    const instance = window.bootstrap.Modal.getInstance(modalEl)
      || window.bootstrap.Modal.getOrCreateInstance(modalEl);
    if (!instance || !modalEl.classList.contains('show')) return Promise.resolve();
    return new Promise((resolve) => {
      modalEl.addEventListener('hidden.bs.modal', () => resolve(), { once: true });
      instance.hide();
    });
  }

  function buildTimesheetEditorUrl(periodId, personId) {
    const pid = cleanId(periodId);
    const tid = cleanId(personId);
    if (!pid || !tid) return '';
    return '/school/timesheets/editor/' + encodeURIComponent(pid) + '?teacherId=' + encodeURIComponent(tid);
  }

  function resolveImportedEditorTarget(payload, fallbackPeriodId, fallbackPersonId) {
    const link = Array.isArray(payload?.editorLinks) ? payload.editorLinks[0] : null;
    if (link?.url) {
      return {
        periodId: cleanId(link.periodId),
        personId: cleanId(link.personId),
        url: String(link.url).trim()
      };
    }
    const applied = Array.isArray(payload?.applied) ? payload.applied[0] : null;
    const periodId = cleanId(applied?.periodId || fallbackPeriodId);
    const personId = cleanId(fallbackPersonId);
    return {
      periodId,
      personId,
      url: buildTimesheetEditorUrl(periodId, personId)
    };
  }

  function renderImportSkippedSummary(skipped) {
    const rows = Array.isArray(skipped) ? skipped : [];
    if (!rows.length) return '';
    const lines = rows.map((row) => (
      '<li><b>' + escapeHtml(row.periodName || row.periodId || 'Period') + ':</b> '
      + escapeHtml(row.message || 'A timesheet already exists for this period.')
      + '</li>'
    )).join('');
    return '<ul class="mb-0 ps-3 mt-2 text-start">' + lines + '</ul>';
  }

  function renderImportRollbackSummary(rolledBack) {
    const rows = Array.isArray(rolledBack) ? rolledBack : [];
    if (!rows.length) return '';
    const lines = rows.map((row) => (
      '<li>' + escapeHtml(row.periodId || 'Period') + ' (' + escapeHtml(row.timesheetId || 'timesheet') + ')</li>'
    )).join('');
    return '<div class="mt-2"><strong>Rolled back:</strong><ul class="mb-0 ps-3">' + lines + '</ul></div>';
  }

  async function showImportApplyResultMessage(payload, fallbackPeriodId, fallbackPersonId) {
    const responseStatus = String(payload?.status || 'success').toLowerCase();
    const skippedHtml = renderImportSkippedSummary(payload?.skipped);
    const summary = escapeHtml(payload?.message || 'Imported timesheet rows were saved.') + skippedHtml;

    if (responseStatus === 'partial') {
      await showMessage({
        title: 'Import Skipped',
        icon: 'warning',
        message: summary,
        buttons: [{ text: 'OK', class: 'btn-primary' }]
      });
      return;
    }

    const target = resolveImportedEditorTarget(payload, fallbackPeriodId, fallbackPersonId);
    const choice = await showMessage({
      title: 'Import Complete',
      icon: 'success',
      message: summary,
      buttons: target.url
        ? [
          { text: 'OK', class: 'btn-secondary' },
          { text: 'Open Timesheet', class: 'btn-primary' }
        ]
        : [{ text: 'OK', class: 'btn-primary' }]
    });
    if (choice === 'Open Timesheet' && target.url) {
      window.open(target.url, '_blank', 'noopener');
    }
  }

  async function showImportApplySuccessMessage(payload, fallbackPeriodId, fallbackPersonId) {
    return showImportApplyResultMessage(payload, fallbackPeriodId, fallbackPersonId);
  }

  function beginImportApplyLoading() {
    if (typeof window.showLoading !== 'function') return null;
    return window.showLoading({
      title: 'Importing Timesheet',
      note: 'Saving compiled rows...',
      operation: 'Timesheet Import'
    });
  }

  function endImportApplyLoading(token) {
    if (typeof window.hideLoading !== 'function') return;
    if (token) window.hideLoading(token);
    else window.hideLoading({ force: true });
  }

  function beginLegacyDeleteLoading() {
    if (typeof window.showLoading !== 'function') return null;
    return window.showLoading({
      title: 'Removing Imported Timesheet',
      note: 'Clearing imported rows and linked activity data...',
      operation: 'Timesheet Import Delete'
    });
  }

  function endLegacyDeleteLoading(token) {
    if (typeof window.hideLoading !== 'function') return;
    if (token) window.hideLoading(token);
    else window.hideLoading({ force: true });
  }

  function applyActionStateFromResult(result) {
    if (result?.actionStateId) actionStateId = String(result.actionStateId);
  }

  function statusBadge(status) {
    const normalized = String(status || 'not_started').toLowerCase();
    const map = {
      not_started: ['#6c757d', 'Not Started', 'secondary'],
      draft: ['#0dcaf0', 'Draft', 'info'],
      submitted: ['#0d6efd', 'Submitted', 'primary'],
      processed: ['#198754', 'Processed', 'success']
    };
    const meta = map[normalized] || ['#6c757d', normalized.replace(/_/g, ' '), 'secondary'];
    return '<span class="badge bg-' + meta[2] + '"><span class="timesheet-status-dot bg-white bg-opacity-75 me-1"></span>' + escapeHtml(meta[1].toUpperCase()) + '</span>';
  }

  function rolePills(roles) {
    const list = Array.isArray(roles) ? roles : [];
    if (!list.length) return '<span class="text-muted">-</span>';
    return list.map((role) => {
      const label = String(role || '').toUpperCase();
      const klass = role === 'teacher' ? 'bg-primary' : 'bg-success';
      return '<span class="badge ' + klass + ' timesheet-role-pill me-1">' + escapeHtml(label) + '</span>';
    }).join('');
  }

  function isPrintableRow(row) {
    const status = String(row?.status || 'not_started').toLowerCase();
    return status === 'submitted' || status === 'processed';
  }

  function isTimesheetManageRowActionTarget(node) {
    if (!node) return false;
    if (tbody?.contains(node)) return true;
    const menu = node.closest?.('body > .row-actions-menu[data-row-actions-id^="timesheet-manage-"]');
    return Boolean(menu);
  }

  function handleTimesheetManageRowActionClick(event) {
    if (!isTimesheetManageRowActionTarget(event.target)) return;

    const printBtn = event.target.closest('[data-print-person]');
    if (printBtn) {
      event.preventDefault();
      void openRowPrintPreview(printBtn.getAttribute('data-print-person'));
      return;
    }
    const lateSubmissionBtn = event.target.closest('[data-late-submission-person]');
    if (lateSubmissionBtn) {
      event.preventDefault();
      void openLateSubmission(
        lateSubmissionBtn.getAttribute('data-late-submission-person'),
        lateSubmissionBtn.getAttribute('data-late-submission-name') || ''
      );
      return;
    }
    const importBtn = event.target.closest('[data-import-person]');
    if (importBtn) {
      event.preventDefault();
      openRowImportSetupModal({
        personId: importBtn.getAttribute('data-import-person'),
        name: importBtn.getAttribute('data-import-person-name') || ''
      });
      return;
    }
    const deleteImportBtn = event.target.closest('[data-delete-import-person]');
    if (deleteImportBtn) {
      event.preventDefault();
      void deleteLegacyImport(
        deleteImportBtn.getAttribute('data-delete-import-person'),
        deleteImportBtn.getAttribute('data-delete-import-name') || '',
        deleteImportBtn.getAttribute('data-delete-import-file') || ''
      );
      return;
    }
    const btn = event.target.closest('[data-summary-person]');
    if (!btn) return;
    event.preventDefault();
    loadSummary(btn.getAttribute('data-summary-person'));
  }

  function renderActionMenu(row) {
    const personId = String(row?.personId || '').trim();
    const menuId = 'timesheet-manage-' + personId;
    const showLateSubmission = CAN_ALLOW_LATE_SUBMISSION && row?.canOpenLateSubmission === true;
    const showPrint = CAN_PRINT_MANAGED_TIMESHEETS && isPrintableRow(row);
    const showDeleteImport = CAN_IMPORT_TIMESHEETS && row?.hasLegacyImport === true;
    const menuItems = [
      '<a href="' + escapeHtml(row.openUrl) + '" class="btn btn-outline-primary btn-sm" target="_blank" rel="noopener">',
      '<i class="bi bi-box-arrow-up-right me-2"></i>Open Timesheet',
      '</a>',
      '<button type="button" class="btn btn-outline-secondary btn-sm mt-1" data-summary-person="' + escapeHtml(personId) + '">',
      '<i class="bi bi-diagram-3 me-2"></i>Department Summary',
      '</button>'
    ];
    if (CAN_IMPORT_TIMESHEETS) {
      menuItems.push(
        '<button type="button" class="btn btn-outline-primary btn-sm mt-1" data-import-person="' + escapeHtml(personId) + '" data-import-person-name="' + escapeHtml(row.name || personId) + '">',
        '<i class="bi bi-file-earmark-spreadsheet me-2"></i>Import Excel',
        '</button>'
      );
    }
    if (showDeleteImport) {
      menuItems.push(
        '<button type="button" class="btn btn-outline-danger btn-sm mt-1" data-delete-import-person="' + escapeHtml(personId) + '" data-delete-import-name="' + escapeHtml(row.name || personId) + '" data-delete-import-file="' + escapeHtml(row.legacyImportFileName || 'imported file') + '">',
        '<i class="bi bi-trash me-2"></i>Delete imported file',
        '</button>'
      );
    }
    if (showLateSubmission) {
      menuItems.push(
        '<button type="button" class="btn btn-outline-warning btn-sm mt-1" data-late-submission-person="' + escapeHtml(personId) + '" data-late-submission-name="' + escapeHtml(row.name || personId) + '">',
        '<i class="bi bi-unlock me-2"></i>Open Timesheet submission',
        '</button>'
      );
    }
    if (showPrint) {
      menuItems.push(
        '<button type="button" class="btn btn-outline-secondary btn-sm mt-1" data-print-person="' + escapeHtml(personId) + '">',
        '<i class="bi bi-printer me-2"></i>Print',
        '</button>'
      );
    }
    return [
      '<div class="row-actions-wrap">',
      '<button type="button" class="btn btn-secondary btn-sm btn-row-actions-toggle" data-row-actions-id="' + escapeHtml(menuId) + '" title="Timesheet actions">',
      '<i class="bi bi-three-dots-vertical"></i>',
      '</button>',
      '<div class="row-actions-menu d-none" data-row-actions-id="' + escapeHtml(menuId) + '">',
      menuItems.join(''),
      '</div>',
      '</div>'
    ].join('');
  }

  function getVisibleRows() {
    const term = String(personSearch?.value || '').trim().toLowerCase();
    return loadedRows.filter((row) => {
      if (!term) return true;
      const haystack = [
        row.personId,
        row.name,
        row.email,
        row.departmentHint,
        row.status,
        ...(Array.isArray(row.roles) ? row.roles : [])
      ].join(' ').toLowerCase();
      return haystack.includes(term);
    });
  }

  function clearSelection() {
    selectedPersonIds.clear();
    updateSelectionUi();
  }

  function updateSelectionUi() {
    if (btnPrintSelected) {
      const count = selectedPersonIds.size;
      btnPrintSelected.textContent = '🖨 Print';
      btnPrintSelected.disabled = count === 0 || !loadedPeriod;
      btnPrintSelected.title = count > 0
        ? 'Print ' + count + ' selected timesheet' + (count === 1 ? '' : 's')
        : 'Select submitted or processed timesheets to print';
    }
    if (!HAS_PRINT_SELECTION || !tbody) return;
    const visiblePrintable = getVisibleRows().filter(isPrintableRow);
    const visiblePrintableIds = visiblePrintable.map((row) => String(row.personId || '').trim()).filter(Boolean);
    const selectedVisibleCount = visiblePrintableIds.filter((id) => selectedPersonIds.has(id)).length;
    tbody.querySelectorAll('.timesheet-print-select').forEach((input) => {
      const personId = String(input.dataset.personId || '').trim();
      input.checked = selectedPersonIds.has(personId);
    });
    if (selectAllVisible) {
      selectAllVisible.disabled = visiblePrintableIds.length === 0;
      selectAllVisible.checked = visiblePrintableIds.length > 0 && selectedVisibleCount === visiblePrintableIds.length;
      selectAllVisible.indeterminate = selectedVisibleCount > 0 && selectedVisibleCount < visiblePrintableIds.length;
    }
  }

  function renderSelectionCell(row) {
    if (!HAS_PRINT_SELECTION) return '';
    const personId = String(row.personId || '').trim();
    if (!isPrintableRow(row)) {
      const status = String(row.status || 'not_started').toLowerCase();
      const reason = status === 'draft'
        ? 'Draft timesheets cannot be printed.'
        : 'Only submitted or processed timesheets can be printed.';
      return '<td class="text-center"><input type="checkbox" class="form-check-input" disabled title="' + escapeHtml(reason) + '" aria-label="Not printable"></td>';
    }
    return '<td class="text-center"><input type="checkbox" class="form-check-input timesheet-print-select" data-person-id="' + escapeHtml(personId) + '" aria-label="Select timesheet for ' + escapeHtml(row.name || personId) + '"></td>';
  }

  function renderRows() {
    const rows = getVisibleRows();

    rosterCount.textContent = loadedPeriod
      ? `${rows.length} of ${loadedRows.length} eligible person(s) shown for ${loadedPeriod.name || loadedPeriod.id}.`
      : 'No period loaded yet.';

    if (!rows.length) {
      tbody.innerHTML = '<tr><td colspan="' + TABLE_COLSPAN + '" class="text-center py-5 text-muted">No matching teacher/staff timesheets found.</td></tr>';
      updateSelectionUi();
      return;
    }

    tbody.innerHTML = rows.map((row) => {
      const hours = Number(row.totalHours || 0).toFixed(2);
      return `
        <tr>
          ${renderSelectionCell(row)}
          <td class="ps-4">
            <div class="fw-bold text-dark">${escapeHtml(row.name || row.personId)}</div>
            <div class="small text-muted font-monospace">${escapeHtml(row.personId)}</div>
            ${row.email ? `<div class="small text-muted">${escapeHtml(row.email)}</div>` : ''}
          </td>
          <td>${rolePills(row.roles)}</td>
          <td class="small text-muted">${escapeHtml(row.departmentHint || '-')}</td>
          <td class="text-center">
            ${statusBadge(row.status)}
            ${row.status === 'submitted' && row.managerApproved ? '<div><span class="badge bg-success mt-1">MANAGER APPROVED</span></div>' : ''}
            ${Number(row.reconciliationCount || 0) > 0 ? `<div class="small text-primary mt-1" title="Deadline-window sessions will be reconciled in the next timesheet."><i class="bi bi-arrow-repeat me-1"></i>${Number(row.reconciliationCount)} reconciliation session${Number(row.reconciliationCount) === 1 ? '' : 's'} · ${Number(row.provisionalCount || 0)} provisional (${Number(row.provisionalHours || 0).toFixed(2)} hrs)</div>` : ''}
            ${Number(row.openMakeupChainCount || 0) > 0 ? `<div class="small text-warning-emphasis mt-1" title="Confirmed open make-up obligations will carry forward for later review."><i class="bi bi-diagram-3 me-1"></i>${Number(row.openMakeupChainCount)} open make-up chain${Number(row.openMakeupChainCount) === 1 ? '' : 's'} · ${Number(row.openMakeupNodeCount || 0)} open obligation${Number(row.openMakeupNodeCount) === 1 ? '' : 's'}</div>` : ''}
            ${Number(row.revisionCount || 0) > 0 ? `<div class="small text-muted mt-1" title="${escapeHtml(row.lastReopenNote || '')}"><i class="bi bi-arrow-repeat me-1"></i>${Number(row.revisionCount)} revision${Number(row.revisionCount) === 1 ? '' : 's'}</div>` : ''}
          </td>
          <td class="text-end fw-bold text-success">${hours} Hrs</td>
          <td class="table-actions text-end pe-4">
            ${renderActionMenu(row)}
          </td>
        </tr>
      `;
    }).join('');
    updateSelectionUi();
  }

  async function fetchJson(url) {
    const res = await fetch(url, {
      method: 'GET',
      headers: { 'Accept': 'application/json', 'X-AJAX-Request': 'true' }
    });
    const payload = await res.json();
    if (!res.ok || payload.status !== 'success') throw new Error(payload.message || 'Request failed.');
    return payload;
  }

  function formatPeriodDeadline(period) {
    const date = period && period.submissionDeadline ? String(period.submissionDeadline) : '-';
    const time = period && period.submissionDeadlineTime ? String(period.submissionDeadlineTime) : '23:59';
    return date === '-' ? '-' : date + ' ' + time;
  }

  function formatPeriodPickerLabel(period) {
    if (!period) return '';
    const name = period.name || period.title || period.id || 'Timesheet Period';
    const windowLabel = period.periodWindowLabel || [period.startDate, period.endDate].filter(Boolean).join(' to ');
    const status = period.status ? String(period.status).toUpperCase() : '';
    return [name, windowLabel, status].filter(Boolean).join(' | ');
  }

  function renderPeriodPickerRow(item) {
    const name = escapeHtml(item?.name || item?.title || item?.id || 'Timesheet Period');
    const id = escapeHtml(item?.id || '');
    const windowLabel = escapeHtml(item?.periodWindowLabel || [item?.startDate, item?.endDate].filter(Boolean).join(' to ') || 'No date window');
    const deadline = escapeHtml(item?.deadlineLabel || formatPeriodDeadline(item));
    const status = escapeHtml(String(item?.status || '').toUpperCase() || 'STATUS N/D');
    return `
      <div class="d-flex justify-content-between align-items-center w-100 gap-3">
        <div>
          <div class="fw-bold text-dark">${name}</div>
          <div class="small text-muted">${windowLabel}</div>
          <div class="small text-danger">Deadline: ${deadline}</div>
        </div>
        <div class="text-end">
          <span class="badge bg-light text-secondary border">${status}</span>
          ${id ? `<div class="small text-muted font-monospace mt-1">${id}</div>` : ''}
        </div>
      </div>
    `;
  }

  function resetLoadedRoster(message) {
    loadedRows = [];
    loadedPeriod = null;
    clearSelection();
    if (personSearch) personSearch.value = '';
    rosterCount.textContent = 'No period loaded yet.';
    tbody.innerHTML = '<tr><td colspan="' + TABLE_COLSPAN + '" class="text-center py-5 text-muted">' + (message || 'Click <b>Load Timesheets</b> to load this period.') + '</td></tr>';
  }

  function setSelectedPeriod(period) {
    const id = String(period?.id || '').trim();
    if (!id) return;
    periodSelect.value = id;
    if (periodDisplay) periodDisplay.value = formatPeriodPickerLabel(period);
    const deadline = formatPeriodDeadline(period);
    periodMeta.innerHTML = '<b>' + escapeHtml(period.name || period.title || id) + '</b> | ' +
      escapeHtml(period.periodWindowLabel || [period.startDate, period.endDate].filter(Boolean).join(' to ')) +
      (deadline !== '-' ? ' | Deadline: <b class="text-danger">' + escapeHtml(deadline) + '</b>' : '');
    void loadRoster();
  }

  async function loadRoster() {
    const periodId = String(periodSelect.value || '').trim();
    if (!periodId) {
      await showMessage({ title: 'Timesheet Management', icon: 'warning', message: 'Please select a timesheet period first.' });
      return;
    }

    const original = btnLoad.innerHTML;
    btnLoad.disabled = true;
    btnLoad.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Loading...';
    tbody.innerHTML = '<tr><td colspan="' + TABLE_COLSPAN + '" class="text-center py-5 text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Loading eligible timesheets...</td></tr>';

    try {
      const rosterParams = new URLSearchParams({ periodId });
      const requestedStatus = String(timesheetStatusFilter?.value || '').trim();
      if (requestedStatus) rosterParams.set('timesheetStatus', requestedStatus);
      const payload = await fetchJson('/school/timesheets/manage/api/roster?' + rosterParams.toString());
      loadedRows = Array.isArray(payload.rows) ? payload.rows : [];
      loadedPeriod = payload.period || null;
      clearSelection();
      if (loadedPeriod) {
        periodMeta.innerHTML = '<b>' + escapeHtml(loadedPeriod.name || loadedPeriod.id) + '</b> | ' +
          escapeHtml(loadedPeriod.startDate || '') + ' to ' + escapeHtml(loadedPeriod.endDate || '') +
          ' | Deadline: <b class="text-danger">' + escapeHtml(formatPeriodDeadline(loadedPeriod)) + '</b>';
      }
      renderRows();
    } catch (error) {
      loadedRows = [];
      loadedPeriod = null;
      tbody.innerHTML = '<tr><td colspan="' + TABLE_COLSPAN + '" class="text-center py-5 text-danger">' + escapeHtml(error.message || String(error)) + '</td></tr>';
      await showMessage({ title: 'Load Failed', icon: 'error', message: escapeHtml(error.message || String(error)) });
    } finally {
      btnLoad.disabled = false;
      btnLoad.innerHTML = original;
    }
  }

  function renderSummary(payload) {
    const rows = Array.isArray(payload.rows) ? payload.rows : [];
    const totals = payload.totals || {};
    const roleTotals = Array.isArray(payload.roleTotals) ? payload.roleTotals : [];
    const warnings = Array.isArray(payload.payrollWarnings) ? payload.payrollWarnings : [];
    summarySubtitle.textContent = `${payload.person?.name || payload.person?.id || ''} | ${payload.period?.name || payload.period?.id || ''}`;

    if (!rows.length) {
      summaryContent.innerHTML = '<div class="text-center text-muted py-4">No payable hours were found for this period/person.</div>';
      return;
    }

    const departmentHoursHtml = (typeof window.TimesheetDepartmentHoursView !== 'undefined'
      && typeof window.TimesheetDepartmentHoursView.renderTable === 'function')
