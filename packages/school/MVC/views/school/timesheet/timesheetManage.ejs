  function renderImportFileList() {
    if (!importFileList || !importExcelFiles) return;
    const files = Array.from(importExcelFiles.files || []);
    if (!files.length) {
      importFileList.innerHTML = '<li class="list-group-item text-muted">No files selected.</li>';
      return;
    }
    importFileList.innerHTML = files.map((file) => (
      '<li class="list-group-item d-flex justify-content-between align-items-center">'
