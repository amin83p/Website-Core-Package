  async function loadSummary(personId) {
    const periodId = String(periodSelect.value || '').trim();
    if (!periodId || !personId) return;
    summarySubtitle.textContent = 'Loading...';
    summaryContent.innerHTML = '<div class="text-center py-5 text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Loading department totals...</div>';
    new bootstrap.Modal(summaryModalEl).show();

    try {
      const payload = await fetchJson('/school/timesheets/manage/api/department-summary?periodId=' + encodeURIComponent(periodId) + '&personId=' + encodeURIComponent(personId));
      renderSummary(payload);
    } catch (error) {
      summaryContent.innerHTML = '<div class="text-center py-5 text-danger">' + escapeHtml(error.message || String(error)) + '</div>';
    }
  }

  async function openSelectedTimesheetPrintPreview(printSettings = null, printReviewType = null) {
    if (!CAN_PRINT_MANAGED_TIMESHEETS) {
      await showMessage({ title: 'Print Access Required', icon: 'warning', message: 'EXPORT access is required to print timesheets.' });
      return;
    }
    const periodId = String(loadedPeriod?.id || periodSelect?.value || '').trim();
    if (!periodId) {
      await showMessage({ title: 'Timesheet Management', icon: 'warning', message: 'Please load a timesheet period first.' });
      return;
    }
    const personIds = Array.from(selectedPersonIds).filter(Boolean);
    if (!personIds.length) {
      await showMessage({ title: 'Timesheet Management', icon: 'warning', message: 'Select at least one submitted or processed timesheet to print.' });
      return;
    }

    if (!printReviewType && window.AppPrintManager?.openTimesheetReviewTypeChooser) {
      const selectedReviewType = await window.AppPrintManager.openTimesheetReviewTypeChooser();
      if (!selectedReviewType) return;
      return openSelectedTimesheetPrintPreview(printSettings, selectedReviewType);
    }

    if (!printSettings && window.AppPrintManager?.openSettings) {
      window.AppPrintManager.openSettings({
        mode: 'timesheet-management',
        defaults: {
          orgName: window.AppPrintManager?.resolveActiveOrgName ? window.AppPrintManager.resolveActiveOrgName() : '',
          orientation: 'portrait',
          density: 'compact'
        },
        onConfirm: (settings) => {
          void openSelectedTimesheetPrintPreview({ ...settings, printReviewType: printReviewType || 'managerial' }, printReviewType || 'managerial');
        }
      });
      return;
    }

    const effectiveReviewType = printReviewType
      || printSettings?.printReviewType
      || 'managerial';
    const mergedPrintSettings = {
      ...(printSettings || {}),
      printReviewType: effectiveReviewType
    };

    const printWindow = window.open('', '_blank', 'height=720,width=1100');
    if (!printWindow) {
      await showMessage({ title: 'Popup Blocked', icon: 'warning', message: 'Allow pop-ups for this site to open the timesheet print preview.' });
      return;
    }

    try { printWindow.opener = null; } catch (_) { /* ignore */ }

    printWindow.document.open();
    printWindow.document.write('<!doctype html><html><head><meta charset="utf-8"><title>Preparing Timesheets</title></head><body style="font:14px Segoe UI,Arial,sans-serif;padding:24px">Preparing timesheet print preview…</body></html>');
    printWindow.document.close();

    try {
      const params = new URLSearchParams();
      params.set('periodId', periodId);
      personIds.forEach((personId) => params.append('personIds', personId));
      if (window.AppPrintManager?.appendSettingsToSearchParams) {
        window.AppPrintManager.appendSettingsToSearchParams(params, mergedPrintSettings);
      }
      const response = await fetch(TIMESHEET_MANAGE_PRINT_ACTION, {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
          'Accept': 'text/html',
          'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8'
        },
        body: params.toString()
      });
      const html = await response.text();
      if (!response.ok) {
        const parsed = new DOMParser().parseFromString(html, 'text/html');
        const detail = String(parsed.querySelector('.alert-danger, .error-message, main')?.textContent || '').trim();
        throw new Error(detail || 'The timesheet print preview could not be prepared.');
      }

      try {
        printWindow.history.replaceState({}, '', location.pathname + '?print=1&view=timesheets');
      } catch (_) { /* ignore */ }

      printWindow.document.open();
      printWindow.document.write(html);
      printWindow.document.close();
      printWindow.focus();
      window.setTimeout(() => {
        try { printWindow.print(); } catch (_) { /* ignore */ }
      }, 250);
    } catch (error) {
      try { printWindow.close(); } catch (_) { /* ignore */ }
      await showMessage({ title: 'Print Error', icon: 'error', message: escapeHtml(error.message || String(error)) });
    }
  }

