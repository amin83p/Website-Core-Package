  function resolveImportYearFromPeriod(period) {
    const startDate = String(period?.startDate || '').trim();
    const endDate = String(period?.endDate || '').trim();
    const token = (/^\d{4}/.test(startDate) && startDate) || (/^\d{4}/.test(endDate) && endDate) || '';
    return token ? token.slice(0, 4) : String(new Date().getFullYear());
  }

