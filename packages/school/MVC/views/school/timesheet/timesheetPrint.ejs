<%
  const context = printContext || {};
  const documents = Array.isArray(context.documents) ? context.documents : [];
  const period = context.period || {};
  const printBrand = (typeof appBrand !== 'undefined' && appBrand && typeof appBrand === 'object') ? appBrand : {};
  const printLogoUrl = printBrand.logoUrl || '/uploads/GLOBAL/logo/Logo1.png';
  const printLogoAlt = `${printBrand.appName || printBrand.ownerDisplayName || context.organizationName || 'Website'} Logo`;
  const rawPrintSettings = (typeof printSettings !== 'undefined' && printSettings && typeof printSettings === 'object') ? printSettings : {};
  const printOrientation = String(rawPrintSettings.orientation || '').trim().toLowerCase() === 'portrait' ? 'portrait' : 'landscape';
  const printDensity = String(rawPrintSettings.density || '').trim().toLowerCase() === 'normal' ? 'normal' : 'compact';
  const printIncludeOrg = rawPrintSettings.includeOrg !== false;
  const printOrgName = printIncludeOrg ? String(rawPrintSettings.orgName || context.organizationName || '').trim() : '';
  const printIncludeHeaderNote = rawPrintSettings.includeHeaderNote === true;
  const printHeaderNote = printIncludeHeaderNote ? String(rawPrintSettings.headerNote || '').trim() : '';
  const printRequestedByLabel = String(rawPrintSettings.requestedByLabel || context.printedByName || '').trim();
%>
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title || 'Timesheet Print' %></title>
  <style id="print-page-orientation-css">@page { margin: 10mm; size: <%= printOrientation %>; }</style>
  <style>
    :root {
      color-scheme: light;
      --ink: #172033;
      --muted: #5f6b7a;
      --line: #cfd7e3;
      --soft: #f4f7fb;
      --blue: #174ea6;
      --green: #176b3a;
      --amber: #8a5a00;
      --red: #9f2430;
      --optional: #075985;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body {
      color: var(--ink);
      font-family: "Segoe UI", Arial, sans-serif;
      font-size: 11px;
      line-height: 1.35;
    }
    body.print-density-normal { font-size: 11px; line-height: 1.35; }
    .screen-actions {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 10px;
    }
    .screen-actions-label { color: var(--muted); font-weight: 700; }
    .screen-actions button {
      padding: 6px 12px;
      cursor: pointer;
      font: inherit;
      border: 1px solid #adb5bd;
      background: #fff;
      border-radius: 4px;
    }
    .screen-actions button.is-active { background: var(--blue); border-color: var(--blue); color: #fff; }
    .screen-actions-hint { margin: -4px 0 10px; color: var(--muted); font-size: 11px; }
    .print-sheet {
      break-after: page;
      page-break-after: always;
    }
    .print-sheet:last-child { break-after: auto; page-break-after: auto; }
    .identity-block { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; margin-bottom: 10px; }
    .identity-copy { min-width: 0; flex: 1 1 auto; }
    .print-logo { display: block; flex: 0 0 auto; width: auto; height: 58px; max-width: 180px; object-fit: contain; object-position: right top; }
    .print-note { margin: 0 0 8px; border: 1px solid var(--line); background: var(--soft); padding: 6px 8px; color: var(--muted); white-space: pre-wrap; }
    .organization-name { margin: 0 0 2px; color: var(--ink); font-size: 19px; font-weight: 800; line-height: 1.1; }
    .document-name { color: var(--blue); font-size: 15px; font-weight: 800; }
    .person-name { color: var(--blue); font-size: 16px; font-weight: 700; }
    .period-name { margin-top: 3px; color: var(--muted); font-size: 11px; font-weight: 700; }
    .badge {
      display: inline-block;
      border: 1px solid currentColor;
      border-radius: 999px;
      padding: 2px 7px;
      font-size: 8.5px;
      font-weight: 700;
      line-height: 1.25;
      letter-spacing: .02em;
      white-space: nowrap;
      vertical-align: middle;
    }
    .one-on-one-badge { margin-left: 5px; color: #5b21b6; background: #f5f0ff; }
    .optional-badge { margin-left: 5px; color: var(--optional); background: #eaf7ff; }
    .role-badge { margin-left: 5px; color: #46505d; background: #f5f6f8; }
    .reconciliation-badge { display: block; width: fit-content; margin: 3px auto 0; color: #084298; background: #cfe2ff; }
    .provisional-row td { box-shadow: inset 3px 0 0 #0d6efd; }
    .reconciliation-summary { margin-top: 4px; padding: 4px 6px; color: #084298; background: #eef5ff; border: 1px solid #b6d4fe; font-size: 9px; }
    table { width: 100%; border-collapse: collapse; table-layout: fixed; }
    thead { display: table-header-group; }
    tfoot { display: table-footer-group; }
    tr { break-inside: avoid; page-break-inside: avoid; }
    th, td { border: 1px solid var(--line); padding: 5px 6px; vertical-align: middle; overflow-wrap: anywhere; }
    th { background: #eaf0f7; font-size: 8.5px; letter-spacing: .035em; text-align: left; text-transform: uppercase; }
    tbody tr:nth-child(even) > td { background: #fafbfd; }
    .col-date { width: 11%; }
    .col-description { width: 23%; }
    .col-student { width: 15%; }
    .col-hours { width: 16%; }
    .col-status { width: 13%; text-align: center; }
    .col-comment { width: 22%; }
    .date-day { font-size: 11px; font-weight: 700; }
    .date-value { color: var(--muted); font-size: 10px; font-weight: 700; }
    .holiday-label { margin-top: 3px; color: var(--red); font-size: 8.5px; font-weight: 700; }
    .primary-label { font-weight: 800; }
    .secondary-label, .cell-muted { margin-top: 2px; color: var(--muted); font-size: 9px; }
    .hours-value { color: var(--green); font-size: 12px; font-weight: 800; }
    .hours-value.is-struck { color: var(--muted); text-decoration: line-through; }
    .payable-note { margin-top: 2px; color: var(--amber); font-size: 8.5px; font-weight: 700; }
    .time-label { margin-top: 2px; color: var(--muted); font-size: 9px; }
    .empty-row { color: var(--muted); font-style: italic; }
    .total-row td { background: #eef7f1 !important; font-weight: 800; }
    .total-label { text-align: right; }
    .total-hours { color: var(--green); font-size: 12px; text-align: center; }
    .department-section { margin-top: 8px; }
    .department-heading { margin: 0 0 4px; font-size: 13px; }
    .department-table { table-layout: auto; width: auto; max-width: 100%; }
    .department-table th,
    .department-table td { text-align: center; white-space: nowrap; }
    .department-name-row th {
      background: #eaf0f7;
      font-size: 9px;
      font-weight: 800;
      letter-spacing: normal;
      text-transform: none;
    }
    .department-hours-row td { color: var(--green); font-weight: 800; }
    .department-metric-label { text-align: left; font-weight: 700; background: #f8fafc !important; }
    .department-total-col { background: #eef7f1 !important; }
    .optional-row td { background: #eef9ff !important; color: var(--optional); font-weight: 700; }
    @media print {
      html, body { width: auto; min-width: 0; max-width: none; }
      body { margin: 0; print-color-adjust: exact; -webkit-print-color-adjust: exact; }
      .no-print { display: none !important; }
      .print-sheet { width: auto; min-width: 0; max-width: none; margin: 0; padding: 0; }
      .timesheet-table { width: 100%; max-width: none; }
      /* Compact defaults keep a normal timesheet and its department summary
         together on one printed page. Browser Scale remains fully available. */
      body { font-size: 8px; line-height: 1.15; }
      .identity-block { gap: 8px; margin-bottom: 4px; }
      .print-logo { height: 42px; max-width: 140px; }
      .organization-name { font-size: 14px; }
      .document-name { font-size: 11px; }
      .person-name { font-size: 10px; }
      .period-name { margin-top: 1px; font-size: 8px; }
      th, td { padding: 2px 3px; }
      th { font-size: 7px; }
      .badge { padding: 1px 4px; font-size: 6.5px; }
      .date-day, .date-value { font-size: 8px; }
      .holiday-label, .secondary-label, .cell-muted, .payable-note, .time-label { margin-top: 1px; font-size: 7px; }
      .hours-value, .total-hours { font-size: 9px; }
      .department-section { margin-top: 5px; }
      .department-heading { margin-bottom: 2px; font-size: 10px; }
      body.print-density-normal { font-size: 10px; line-height: 1.28; }
      body.print-density-normal .print-logo { height: 52px; max-width: 165px; }
      body.print-density-normal .organization-name { font-size: 17px; }
      body.print-density-normal .document-name { font-size: 13px; }
      body.print-density-normal .person-name { font-size: 14px; }
      body.print-density-normal th, body.print-density-normal td { padding: 4px 5px; }
    }
    @media screen {
      body { background: #e9ecef; padding: 16px; }
      .print-sheet {
        width: 100%;
        margin: 0 0 16px;
        padding: 14px 16px;
        background: #fff;
        box-shadow: 0 1px 6px rgba(0,0,0,.12);
      }
    }
    @media (max-width: 800px) {
      .print-sheet { padding: 12px; }
    }
  </style>
</head>
<body class="print-density-<%= printDensity %>" data-print-orientation="<%= printOrientation %>">
  <div class="screen-actions no-print">
    <span class="screen-actions-label">Orientation:</span>
    <button type="button" data-print-orientation="landscape" class="<%= printOrientation === 'landscape' ? 'is-active' : '' %>" aria-pressed="<%= printOrientation === 'landscape' ? 'true' : 'false' %>">Landscape</button>
    <button type="button" data-print-orientation="portrait" class="<%= printOrientation === 'portrait' ? 'is-active' : '' %>" aria-pressed="<%= printOrientation === 'portrait' ? 'true' : 'false' %>">Portrait</button>
    <button type="button" onclick="window.print()">Print</button>
    <button type="button" onclick="window.close()">Close</button>
  </div>
  <p class="screen-actions-hint no-print">Change orientation here, then click Print. Browser Scale (%) still applies in the print dialog.</p>

  <% documents.forEach((document) => { %>
    <section class="print-sheet">
      <div class="identity-block">
        <div class="identity-copy">
          <% if (printOrgName) { %><h1 class="organization-name"><%= printOrgName %></h1><% } %>
          <div class="document-name">Timesheet</div>
          <div class="person-name"><%= document.person.name %></div>
          <div class="period-name"><%= period.name %></div>
          <% if (printRequestedByLabel) { %><div class="period-name">Requested by: <%= printRequestedByLabel %></div><% } %>
          <% if (document.reconciliationEntryCount > 0) { %>
            <div class="reconciliation-summary">
              Deadline-window reconciliation: <strong><%= document.provisionalEntryCount %></strong> provisional session(s),
              <strong><%= Number(document.provisionalHours || 0).toFixed(2) %> hrs</strong>; all
              <strong><%= document.reconciliationEntryCount %></strong> window session(s) will be checked in the next timesheet.
            </div>
          <% } %>
          <% if (document.openMakeupChainCount > 0) { %>
            <div class="reconciliation-summary">
              Open make-up reconciliation: <strong><%= document.openMakeupChainCount %></strong> confirmed chain(s),
              <strong><%= document.openMakeupNodeCount %></strong> open session or scheduling obligation(s). These will be checked in a later timesheet.
            </div>
          <% } %>
        </div>
        <img class="print-logo" src="<%= printLogoUrl %>" alt="<%= printLogoAlt %>" onerror="this.style.display='none'">
      </div>
      <% if (printHeaderNote) { %><div class="print-note"><%= printHeaderNote %></div><% } %>

      <table class="timesheet-table">
        <thead>
          <tr>
            <th class="col-date">Date</th>
            <th class="col-description">Class / Description</th>
            <th class="col-student">Student Name</th>
            <th class="col-hours">Hours / Time</th>
            <th class="col-status">Status</th>
            <th class="col-comment">Comment</th>
          </tr>
        </thead>
        <tbody>
          <% document.days.forEach((day) => { %>
            <% if (!day.entries.length) { %>
              <tr>
                <td>
                  <div class="date-day"><%= day.dayName %></div>
                  <div class="date-value"><%= day.dateLabel %></div>
                  <% if (day.holidayName) { %><div class="holiday-label"><%= day.holidayName %></div><% } %>
                </td>
                <td colspan="2" class="empty-row"><%= day.holidayName ? `Holiday: ${day.holidayName}` : 'No sessions logged.' %></td>
                <td><span class="hours-value">0.00 hrs</span></td>
                <td></td>
                <td></td>
              </tr>
            <% } else { %>
              <% day.entries.forEach((entry, entryIndex) => { %>
                <tr class="<%= entry.isProvisional ? 'provisional-row' : '' %>">
                  <% if (entryIndex === 0) { %>
                    <td rowspan="<%= day.entries.length %>">
                      <div class="date-day"><%= day.dayName %></div>
                      <div class="date-value"><%= day.dateLabel %></div>
                      <% if (day.holidayName) { %><div class="holiday-label"><%= day.holidayName %></div><% } %>
                    </td>
                  <% } %>
                  <td>
                    <div>
                      <span class="primary-label"><%= entry.primaryLabel %></span>
                      <% if (entry.isOneOnOne) { %><span class="badge one-on-one-badge">One on One</span><% } %>
                      <% if (entry.roleLabel) { %><span class="badge role-badge"><%= entry.roleLabel %></span><% } %>
                    </div>
                    <% if (entry.secondaryLabel) { %><div class="secondary-label"><%= entry.secondaryLabel %></div><% } %>
                  </td>
                  <td>
                    <div><%= entry.studentName || '—' %></div>
                    <% if (entry.attendanceLabel) { %><div class="cell-muted"><%= entry.attendanceLabel %></div><% } %>
                  </td>
                  <td>
                    <div>
                      <span class="hours-value<%= entry.hoursIsStruck ? ' is-struck' : '' %>"><%= entry.hoursLabel %></span>
                      <% if (entry.showOptionalBadge) { %><span class="badge optional-badge">Optional</span><% } %>
                    </div>
                    <% if (entry.payableNote) { %><div class="payable-note"><%= entry.payableNote %></div><% } %>
                    <div class="time-label"><%= entry.timeLabel %></div>
                  </td>
                  <td class="col-status">
                    <span class="badge"><%= entry.statusLabel %></span>
                    <% if (entry.showReconciliationBadge) { %><span class="badge reconciliation-badge">Reconciliation</span><% } %>
                  </td>
                  <td><%= entry.commentLabel %></td>
                </tr>
              <% }); %>
            <% } %>
          <% }); %>
        </tbody>
        <tfoot>
          <tr class="total-row">
            <td colspan="3" class="total-label">Total Payable Hours</td>
            <td class="total-hours"><%= document.payableTotalHours.toFixed(2) %> hrs</td>
            <td colspan="2"></td>
          </tr>
        </tfoot>
      </table>

      <section class="department-section">
        <h2 class="department-heading">Hours by Department</h2>
        <% const departmentRows = Array.isArray(document.departmentTotals?.rows) ? document.departmentTotals.rows : []; %>
        <% const departmentSummaryTotals = document.departmentTotals?.totals || {
          groupHours: 0,
          oneOnOneHours: 0,
          oneOnOneOptionalHours: 0,
          groupPendingHours: 0,
          oneOnOnePendingHours: 0,
          totalHours: 0
        }; %>
        <% const showDepartmentOptionalRow = Number(departmentSummaryTotals.oneOnOneOptionalHours || 0) > 0; %>
        <table class="department-table">
          <% if (!departmentRows.length) { %>
            <tbody>
              <tr><td class="empty-row">No department hours yet.</td></tr>
            </tbody>
          <% } else { %>
            <tbody>
              <tr class="department-name-row">
                <th scope="col" class="department-metric-label"></th>
                <% departmentRows.forEach((row) => { %>
                  <th scope="col"><%= row.departmentName %></th>
                <% }); %>
                <th scope="col" class="department-total-col">Total</th>
              </tr>
              <tr class="department-hours-row">
                <th scope="row" class="department-metric-label">Group</th>
                <% departmentRows.forEach((row) => { %>
                  <td><%= row.groupHours.toFixed(2) %></td>
                <% }); %>
                <td class="department-total-col"><%= departmentSummaryTotals.groupHours.toFixed(2) %></td>
              </tr>
              <tr class="department-hours-row">
                <th scope="row" class="department-metric-label">One-on-One</th>
                <% departmentRows.forEach((row) => { %>
                  <td><%= row.oneOnOneHours.toFixed(2) %></td>
                <% }); %>
                <td class="department-total-col"><%= departmentSummaryTotals.oneOnOneHours.toFixed(2) %></td>
              </tr>
              <% if (showDepartmentOptionalRow) { %>
                <tr class="department-optional-row optional-row">
                  <th scope="row" class="department-metric-label">Optional (1:1)</th>
                  <% departmentRows.forEach((row) => { %>
                    <td><%= Number(row.oneOnOneOptionalHours || 0) > 0 ? row.oneOnOneOptionalHours.toFixed(2) : '—' %></td>
                  <% }); %>
                  <td class="department-total-col"><%= departmentSummaryTotals.oneOnOneOptionalHours.toFixed(2) %></td>
                </tr>
              <% } %>
              <tr class="total-row">
                <th scope="row" class="department-metric-label">Total</th>
                <% departmentRows.forEach((row) => { %>
                  <td><%= row.totalHours.toFixed(2) %></td>
                <% }); %>
                <td class="department-total-col"><%= departmentSummaryTotals.totalHours.toFixed(2) %></td>
              </tr>
            </tbody>
          <% } %>
        </table>
      </section>

    </section>
  <% }); %>

  <script>
  (function() {
    function normalizeOrientation(value) {
      return String(value || 'landscape').trim().toLowerCase() === 'portrait' ? 'portrait' : 'landscape';
    }

    function buildPageCss(orientation) {
      return '@page { margin: 10mm; size: ' + normalizeOrientation(orientation) + '; }';
    }

    function applyPrintOrientation(orientation) {
      var mode = normalizeOrientation(orientation);
      var styleEl = document.getElementById('print-page-orientation-css');
      if (styleEl) styleEl.textContent = buildPageCss(mode);
      document.body.dataset.printOrientation = mode;
      document.querySelectorAll('[data-print-orientation]').forEach(function(btn) {
        var active = btn.getAttribute('data-print-orientation') === mode;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
    }

    document.querySelectorAll('[data-print-orientation]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        applyPrintOrientation(btn.getAttribute('data-print-orientation'));
      });
    });

    applyPrintOrientation('<%= printOrientation %>');
    window.applyPrintOrientation = applyPrintOrientation;
  })();
  </script>
</body>
</html>
