<script>
    const P_START = "<%= period.startDate %>";
    const P_END = "<%= period.endDate %>";
    const ORG_TIMEZONE = <%- JSON.stringify(typeof orgTimeZone !== 'undefined' ? orgTimeZone : '') %>;
    const ORG_TODAY = <%- JSON.stringify(typeof orgToday !== 'undefined' ? orgToday : '') %>;
    const LIVE_SESSIONS = <%- JSON.stringify(liveSessions || []) %>;
    const HOLIDAYS = <%- JSON.stringify(holidays || []) %>;
    const TIMESHEET_ENTRIES = <%- JSON.stringify(timesheet.entries || []) %>;
    const SNAPSHOT_ENTRIES = <%- JSON.stringify((timesheet.submissionSnapshot && timesheet.submissionSnapshot.entries) || []) %>;
    const USE_FROZEN_SNAPSHOT = <%= (typeof useFrozenSnapshot !== 'undefined' && useFrozenSnapshot) ? 'true' : 'false' %>;
    const MANUAL_ACTIVITIES = <%- JSON.stringify(manualActivities || []) %>;
    const INCOMPLETE_SESSIONS = <%- JSON.stringify(incompleteSessions || []) %>;
    const SESSION_STATUS_META = <%- JSON.stringify(sessionStatusMeta || []) %>;
    const IS_READONLY = <%= isEditorLocked %>;
    const IS_ADMIN = <%= isAdmin %>;
    const CAN_MANAGER_REVIEW = <%= (typeof canSendBack !== 'undefined' && canSendBack) ? 'true' : 'false' %>;
    const IS_SUBMISSION_DEADLINE_PASSED = <%= isSubmissionDeadlinePassedFlag ? 'true' : 'false' %>;
    const ALLOW_LATE_SUBMISSION = <%= allowLateSubmissionFlag ? 'true' : 'false' %>;
    const SHOW_PRIOR_ADJUSTMENT_REVIEW = <%= showPriorAdjustmentReview ? 'true' : 'false' %>;
    const PERIOD_ID = "<%= period.id %>";
    const TARGET_TEACHER_ID = "<%= targetTeacherId %>";
    const CAN_PRINT_TIMESHEET = <%= canPrintFlag ? 'true' : 'false' %>;
    const TIMESHEET_PRINT_MODE = <%- JSON.stringify(printMode) %>;
    const TIMESHEET_PRINT_ACTION = <%- JSON.stringify(printAction) %>;
    const MAX_DAILY_HOURS = <%= maxDailyHours || 24 %>;
    const MAX_SESSION_HOURS = <%= maxSessionHours || 12 %>;
    const PAYROLL_ROLES = <%- JSON.stringify(typeof payrollRoles !== 'undefined' ? payrollRoles : []) %>;
    const PAYROLL_DEFAULT_ROLE = "<%= typeof payrollDefaultRole !== 'undefined' ? payrollDefaultRole : 'teacher' %>";
    const PAYROLL_WARNINGS = <%- JSON.stringify(typeof payrollWarnings !== 'undefined' ? payrollWarnings : []) %>;
    let actionStateId = '<%= (typeof actionStateId !== 'undefined' && actionStateId) ? actionStateId : '' %>';

    const liveSessionById = new Map();
    const liveDepartmentByClassId = new Map();
    (Array.isArray(LIVE_SESSIONS) ? LIVE_SESSIONS : []).forEach((ls) => {
        const sessionId = String(ls?.sessionId || '').trim();
        if (sessionId) liveSessionById.set(sessionId, ls);
        const classId = String(ls?.classId || '').trim();
        const deptName = String(ls?.deliveryDepartmentName || ls?.departmentName || '').trim();
        const deptId = String(ls?.deliveryDepartmentId || ls?.departmentId || '').trim();
        const deptCode = String(ls?.deliveryDepartmentCode || ls?.departmentCode || '').trim();
        if (classId && (deptName || deptId || deptCode) && !liveDepartmentByClassId.has(classId)) {
            liveDepartmentByClassId.set(classId, {
                deliveryDepartmentId: deptId,
                deliveryDepartmentName: deptName || deptId,
                deliveryDepartmentCode: deptCode,
                isOneOnOne: ls?.isOneOnOne === true,
                singleStudentId: String(ls?.singleStudentId || '').trim(),
                singleStudentPersonId: String(ls?.singleStudentPersonId || '').trim(),
                singleStudentName: String(ls?.singleStudentName || '').trim()
            });
        }
    });

    function buildMutationQuery() {
        const params = new URLSearchParams();
        if (TARGET_TEACHER_ID) params.set('teacherId', TARGET_TEACHER_ID);
        if (actionStateId) params.set('actionStateId', actionStateId);
        const query = params.toString();
        return query ? `?${query}` : '';
    }

    function buildManualEntryScheduleUrl(dateStr) {
        const date = String(dateStr || '').trim();
        if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) return '';
        if (IS_ADMIN && TARGET_TEACHER_ID) {
            const params = new URLSearchParams();
            params.set('personId', TARGET_TEACHER_ID);
            params.set('startDate', date);
            params.set('endDate', date);
            return `/school/schedules/viewer?${params.toString()}`;
        }
        const params = new URLSearchParams();
        params.set('anchorDate', date);
        params.set('period', 'day');
        return `/school/schedules/my?${params.toString()}`;
    }

    (function initTimesheetDeadlineStatusChip() {
        const chip = document.getElementById('tsDeadlineStatusChip');
        if (!chip) return;

        const status = String(chip.getAttribute('data-status') || 'draft').toLowerCase();
        const managerApproved = String(chip.getAttribute('data-manager-approved') || '').toLowerCase() === 'true';
        const deadlineAt = String(chip.getAttribute('data-deadline-at') || '').trim();
        const deadlineMs = deadlineAt ? Date.parse(deadlineAt) : NaN;
        let timerId = null;

        function pad2(value) {
            return String(Math.max(0, value)).padStart(2, '0');
        }

        function formatCountdown(remainingMs) {
            const totalSec = Math.max(0, Math.floor(remainingMs / 1000));
            const days = Math.floor(totalSec / 86400);
            const hours = Math.floor((totalSec % 86400) / 3600);
            const minutes = Math.floor((totalSec % 3600) / 60);
            const seconds = totalSec % 60;
            return `${pad2(days)}:${pad2(hours)}:${pad2(minutes)}:${pad2(seconds)}`;
        }

        function clearTimer() {
            if (timerId !== null) {
                clearInterval(timerId);
                timerId = null;
            }
        }

        function showStamp(label, stampClass) {
            clearTimer();
            chip.className = `ts-deadline-chip is-visible is-stamp ${stampClass}`;
            chip.textContent = label;
            chip.setAttribute('aria-label', label);
        }

        function showTimer(text) {
            chip.className = 'ts-deadline-chip is-visible is-timer';
            chip.textContent = text;
            chip.setAttribute('aria-label', `Time left to submit: ${text}`);
        }

        if (status === 'processed') {
            showStamp('PROCESSED', 'ts-stamp-processed');
            return;
        }
        if (status === 'submitted' && managerApproved) {
            showStamp('APPROVED', 'ts-stamp-approved');
            return;
        }
        if (status === 'submitted') {
            showStamp('SUBMITTED', 'ts-stamp-submitted');
            return;
        }

        // Draft (or unknown): countdown while before deadline, else deadline-passed stamp
        if (!Number.isFinite(deadlineMs)) {
            return;
        }

        function tick() {
            const remaining = deadlineMs - Date.now();
            if (remaining <= 0) {
                showStamp('DEADLINE PASSED', 'ts-stamp-deadline-passed');
                return;
            }
            showTimer(formatCountdown(remaining));
        }

        tick();
        if (deadlineMs > Date.now()) {
            timerId = setInterval(tick, 1000);
            window.addEventListener('pagehide', clearTimer, { once: true });
        }
    })();
</script>

<script>
function resolveManualActivityVisibilityScope() {
    const typeSelect = document.getElementById('man_type');
    const selected = typeSelect?.selectedOptions?.[0] || null;
    const activityId = String(typeSelect?.value || '').trim();
    if (!activityId) return '';
    const fromOption = String(selected?.dataset?.visibilityScope || '').trim().toLowerCase();
    if (fromOption === 'individual' || fromOption === 'school') return fromOption;
    const fromList = (Array.isArray(typeof MANUAL_ACTIVITIES !== 'undefined' ? MANUAL_ACTIVITIES : [])
        ? MANUAL_ACTIVITIES
        : []).find((row) => String(row?.id || '').trim() === activityId);
    const fromMap = String(fromList?.visibilityScope || '').trim().toLowerCase();
    return fromMap === 'individual' ? 'individual' : 'school';
}

function clearManualWorkSessionPicker() {
    const idInput = document.getElementById('man_activityEntryId');
    const labelInput = document.getElementById('man_activityEntryLabel');
    if (idInput) idInput.value = '';
    if (labelInput) labelInput.value = '';
}

function toggleManualType() {
    const type = document.getElementById('man_type').value;
    const classPickerWrap = document.getElementById('div_man_classPicker');
    const workSessionWrap = document.getElementById('div_man_workSessionPicker');
    const classIdInput = document.getElementById('man_classId');
    const classNameInput = document.getElementById('man_className');
    const classButton = document.getElementById('btnPickClass');
    const startInput = document.getElementById('man_startTime');
    const endInput = document.getElementById('man_endTime');
    const hoursInput = document.getElementById('man_hours');
    const descWrap = document.getElementById('div_man_desc');
    const descInput = document.getElementById('man_desc');
    const usingActivity = Boolean(String(type || '').trim());
    const visibilityScope = resolveManualActivityVisibilityScope();
    const isPublicActivity = usingActivity && visibilityScope !== 'individual';
    const isIndividualActivity = usingActivity && visibilityScope === 'individual';
    const existingClassId = String(classIdInput?.value || '').trim();
    const showFrozenClassRow = !usingActivity && Boolean(existingClassId);

    if (workSessionWrap) workSessionWrap.classList.toggle('d-none', !isPublicActivity);
    if (!isPublicActivity) {
        clearManualWorkSessionPicker();
        if (workSessionWrap) delete workSessionWrap.dataset.activityId;
    } else {
        const prevActivityId = String(workSessionWrap?.dataset?.activityId || '');
        if (prevActivityId && prevActivityId !== String(type || '').trim()) {
            clearManualWorkSessionPicker();
        }
        if (workSessionWrap) workSessionWrap.dataset.activityId = String(type || '').trim();
    }

    document.getElementById('div_man_desc').classList.remove('d-none');
    if (descWrap) {
        const descLabel = descWrap.querySelector('label');
        if (descLabel) {
            descLabel.textContent = isPublicActivity ? 'Description' : 'Description *';
        }
    }
    if (descInput) {
        descInput.placeholder = isPublicActivity
            ? 'Filled from the selected work session (optional notes go below)'
            : (isIndividualActivity
                ? 'Short description for the suggested work session...'
                : 'e.g. Extra prep, admin work, meeting...');
        descInput.readOnly = isPublicActivity;
    }

    if (classPickerWrap) {
        classPickerWrap.classList.toggle('d-none', !showFrozenClassRow);
        classPickerWrap.classList.add('opacity-50');
    }
    if (classNameInput) {
        classNameInput.disabled = true;
        classNameInput.placeholder = 'Class manuals are frozen';
    }
    if (classButton) classButton.disabled = true;
    if (startInput) {
        startInput.disabled = isPublicActivity || showFrozenClassRow;
        startInput.readOnly = isPublicActivity || showFrozenClassRow;
    }
    if (endInput) {
        endInput.disabled = isPublicActivity || showFrozenClassRow;
        endInput.readOnly = isPublicActivity || showFrozenClassRow;
    }
    const usesTimedEntry = usingActivity || showFrozenClassRow;
    if (hoursInput) {
        hoursInput.readOnly = usesTimedEntry || isPublicActivity || showFrozenClassRow;
        hoursInput.placeholder = usesTimedEntry ? 'Calculated from start/end time' : 'e.g. 1.5';
    }
    if (usingActivity) {
        if (classIdInput) classIdInput.value = '';
        if (classNameInput) classNameInput.value = '';
    }
    if (typeof window.updateManualComputedHoursFromTimes === 'function') {
        window.updateManualComputedHoursFromTimes();
    }
}

document.addEventListener('DOMContentLoaded', () => {

    // Prefer MessageModal; fallback only if modal isn't present
    async function confirmAction({ title, message, confirmText = 'Confirm', cancelText = 'Cancel', icon = 'warning', confirmBtnClass = 'btn-danger' }) {
        if (typeof showMessageModal === 'function') {
            const ans = await showMessageModal({
                title,
                icon,
                message,
                buttons: [
                    { text: cancelText, class: 'btn-secondary' },
                    { text: confirmText, class: confirmBtnClass }
                ]
            });
            return ans === confirmText;
        }
        return confirm(message);
    }

    async function messageBox({ title, message, icon = 'info', okText = 'OK', okClass = 'btn-secondary' }) {
        if (typeof showMessageModal === 'function') {
            await showMessageModal({
                title,
                icon,
                message,
                buttons: [{ text: okText, class: okClass }]
            });
            return;
        }
        alert(message);
    }

    function showTimesheetWaitingModal({
        title = 'Please wait',
        note = 'Processing your request...',
        operation = ''
    } = {}) {
        if (typeof window.showLoading !== 'function') return null;
        return window.showLoading({ title, note, operation });
    }

    function hideTimesheetWaitingModal(token = null) {
        if (typeof window.hideLoading !== 'function') return;
        if (token) {
            window.hideLoading(token);
            return;
        }
        window.hideLoading();
    }

    function setManualSaveBusy(isBusy) {
        const manualSaveBtn = document.getElementById('btnSaveManualEntry');
        if (!manualSaveBtn) return;
        manualSaveBtn.disabled = isBusy === true;
    }

    function resolveManualPersonRole() {
        if (!Array.isArray(PAYROLL_ROLES) || PAYROLL_ROLES.length <= 1) {
            return PAYROLL_DEFAULT_ROLE || 'teacher';
        }
        const selected = String(document.getElementById('man_personRole')?.value || '').trim().toLowerCase();
        return PAYROLL_ROLES.includes(selected) ? selected : '';
    }

    function payrollRoleBadge(personRole) {
        if (!Array.isArray(PAYROLL_ROLES) || PAYROLL_ROLES.length <= 1) return '';
        const role = String(personRole || PAYROLL_DEFAULT_ROLE || 'teacher').trim().toLowerCase();
        const klass = role === 'staff' ? 'bg-success' : 'bg-primary';
        const label = role ? role.charAt(0).toUpperCase() + role.slice(1) : 'Role';
        return `<span class="badge ${klass} ms-1">${label}</span>`;
    }

    function coTeacherBadge(entry) {
        if (!entry?.isCoTeacherSession) return '';
        const label = String(entry.coTeacherRoleLabel || 'Co-Teacher').trim() || 'Co-Teacher';
        return `<span class="badge bg-info-subtle text-info-emphasis border border-info-subtle ms-1">${escapeHtml(label)}</span>`;
    }

    const manualActivityMap = new Map((Array.isArray(MANUAL_ACTIVITIES) ? MANUAL_ACTIVITIES : [])
        .map((row) => [String(row?.id || '').trim(), row])
        .filter(([id]) => Boolean(id)));

    function normalizeClock(value) {
        const raw = String(value || '').trim();
        const match = raw.match(/^(\d{1,2}):(\d{2})$/);
        if (!match) return '';
        const h = Number(match[1]);
        const m = Number(match[2]);
        if (!Number.isInteger(h) || !Number.isInteger(m) || h < 0 || h > 23 || m < 0 || m > 59) return '';
        return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`;
    }

    function timesheetClockSortValue(value) {
        const normalized = normalizeClock(value);
        if (!normalized) return Number.POSITIVE_INFINITY;
        const [hours, minutes] = normalized.split(':').map(Number);
        return (hours * 60) + minutes;
    }

    function sortTimesheetEntriesBySchedule(entries = []) {
        return entries
            .map((entry, originalIndex) => ({ entry, originalIndex }))
            .sort((left, right) => {
                const leftStart = timesheetClockSortValue(left.entry?.startTime);
                const rightStart = timesheetClockSortValue(right.entry?.startTime);
                const leftHasStart = Number.isFinite(leftStart);
                const rightHasStart = Number.isFinite(rightStart);
                if (leftHasStart !== rightHasStart) return leftHasStart ? -1 : 1;
                if (!leftHasStart) return left.originalIndex - right.originalIndex;
                if (leftStart !== rightStart) return leftStart - rightStart;

                const leftEnd = timesheetClockSortValue(left.entry?.endTime);
                const rightEnd = timesheetClockSortValue(right.entry?.endTime);
                const leftHasEnd = Number.isFinite(leftEnd);
                const rightHasEnd = Number.isFinite(rightEnd);
                if (leftHasEnd !== rightHasEnd) return leftHasEnd ? -1 : 1;
                if (leftHasEnd && leftEnd !== rightEnd) return leftEnd - rightEnd;
                return left.originalIndex - right.originalIndex;
            })
            .map(({ entry }) => entry);
    }

    function calculateHoursFromRange(startTime, endTime) {
        const start = normalizeClock(startTime);
        const end = normalizeClock(endTime);
        if (!start || !end) return 0;
        const [startH, startM] = start.split(':').map(Number);
        const [endH, endM] = end.split(':').map(Number);
        const startMinutes = (startH * 60) + startM;
        const endMinutes = (endH * 60) + endM;
        if (endMinutes <= startMinutes) return 0;
        return Number(((endMinutes - startMinutes) / 60).toFixed(2));
    }

    function hasTimeOverlap(startA, endA, startB, endB) {
        const aStart = normalizeClock(startA);
        const aEnd = normalizeClock(endA);
        const bStart = normalizeClock(startB);
        const bEnd = normalizeClock(endB);
        if (!aStart || !aEnd || !bStart || !bEnd) return false;
        const [ash, asm] = aStart.split(':').map(Number);
        const [aeh, aem] = aEnd.split(':').map(Number);
        const [bsh, bsm] = bStart.split(':').map(Number);
        const [beh, bem] = bEnd.split(':').map(Number);
        const aStartMin = (ash * 60) + asm;
        const aEndMin = (aeh * 60) + aem;
        const bStartMin = (bsh * 60) + bsm;
        const bEndMin = (beh * 60) + bem;
        if (aEndMin <= aStartMin || bEndMin <= bStartMin) return false;
        return aStartMin < bEndMin && aEndMin > bStartMin;
    }

    // Normalize holidays into Map(dateStr -> holidayObj)
    function toYMD(value) {
        if (!value) return null;
        if (typeof value === 'string') {
            if (/^\d{4}-\d{2}-\d{2}$/.test(value)) return value;
            const d = new Date(value);
            if (!isNaN(d)) return d.toISOString().slice(0, 10);
            return null;
        }
        const d = new Date(value);
        if (!isNaN(d)) return d.toISOString().slice(0, 10);
        return null;
    }

    const holidayMap = new Map();
    (HOLIDAYS || []).forEach(h => {
        const dt =
            toYMD(h.date) ||
            toYMD(h.holidayDate) ||
            toYMD(h.startDate) ||
            toYMD(h.day) ||
            toYMD(h.dt) ||
            null;
        if (dt) holidayMap.set(dt, h);
    });

    const normalizeStatusCode = (value) => String(value || '').trim().toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '') || 'scheduled';
    const statusMetaMap = new Map(
        (Array.isArray(SESSION_STATUS_META) ? SESSION_STATUS_META : [])
            .map((row) => [normalizeStatusCode(row?.code), row])
            .filter(([code]) => Boolean(code))
    );
    const resolveStatusMeta = (statusCode) => statusMetaMap.get(normalizeStatusCode(statusCode)) || null;
    const resolveStatusLabel = (statusCode) => {
        const normalized = normalizeStatusCode(statusCode);
        const meta = resolveStatusMeta(normalized);
        if (meta?.label) return String(meta.label);
        return normalized.replace(/_/g, ' ').replace(/\b\w/g, (ch) => ch.toUpperCase());
    };
    const resolveEntryHours = (entry) => {
        if (!entry || entry.isDeleted) return 0;
        const approvalStatus = String(entry.approvalStatus || '').trim().toLowerCase();
        const excluded = entry.excludeFromTotals === true || ['pending_approval', 'rejected', 'unpaid'].includes(approvalStatus);
        if (excluded) return 0;
        if (entry.isManual) return Number(parseFloat(entry.durationHours) || parseFloat(entry.hours) || 0);
        const formulaHours = Number(entry.timesheetHours);
        if (Number.isFinite(formulaHours)) return Number(formulaHours.toFixed(2));
        return Number(parseFloat(entry.durationHours) || parseFloat(entry.hours) || 0);
    };
    const resolveRequestedHours = (entry) => {
        if (!entry || entry.isDeleted) return 0;
        if (entry.isManual) {
            return Number(parseFloat(entry.requestedHours ?? entry.durationHours ?? entry.hours) || 0);
        }
        return resolveEntryHours(entry);
    };
    const isPendingApprovalEntry = (entry) => String(entry?.approvalStatus || '').trim().toLowerCase() === 'pending_approval';
    const isRejectedApprovalEntry = (entry) => String(entry?.approvalStatus || '').trim().toLowerCase() === 'rejected';
    const isUnpaidApprovalEntry = (entry) => String(entry?.approvalStatus || '').trim().toLowerCase() === 'unpaid';
    const isFinalAutoStatus = (entry) => {
        if (!entry || entry.isManual) return true;
        if (entry.isPriorPeriodAdjustment === true) return true;
        if (entry.isReportReflection === true) return true;
        if (entry.isSchoolActivity === true || String(entry?.sessionId || '').startsWith('act-')) return true;
        if (entry.isFinalStatus === true) return true;
        if (entry.isFinalStatus === false) return false;
        return normalizeStatusCode(entry.status) === 'completed';
    };
    const STATUS_ICON_BY_CODE = {
        scheduled: 'bi-calendar2-event-fill',
        completed: 'bi-check-circle-fill',
        cancelled: 'bi-x-octagon-fill',
        holiday: 'bi-balloon-fill',
        missed_informed24: 'bi-clock-history',
        pending_approval: 'bi-hourglass-split',
        manual: 'bi-person-fill'
    };
    const resolveStatusIcon = (statusCode, { warn = false } = {}) => {
        if (warn) return 'bi-exclamation-triangle-fill';
        return STATUS_ICON_BY_CODE[normalizeStatusCode(statusCode)] || 'bi-circle-fill';
    };
    const buildStatusChipHtml = ({ icon, label, colorBg, colorText, colorBorder }) => {
        const tip = escapeHtml(label);
        return `<span class="ts-status-chip ts-tooltip-trigger" style="background:${escapeHtml(colorBg)};color:${escapeHtml(colorText)};border-color:${escapeHtml(colorBorder)};" data-tip="${tip}" data-tip-bg="${escapeHtml(colorBg)}" data-tip-fg="${escapeHtml(colorText)}" data-tip-border="${escapeHtml(colorBorder)}" aria-label="${tip}" tabindex="0"><i class="bi ${escapeHtml(icon)}" aria-hidden="true"></i></span>`;
    };
    const buildStatusBadgeHtml = (entry) => {
        if (entry?.isPriorPeriodAdjustment === true) {
            return buildStatusChipHtml({
                icon: 'bi-arrow-left-right',
                label: 'Prior Period Adjustment',
                colorBg: '#fff3cd',
                colorText: '#664d03',
                colorBorder: '#ffc107'
            });
        }
        if (entry?.isManual) {
            if (isPendingApprovalEntry(entry)) {
                return buildStatusChipHtml({
                    icon: 'bi-hourglass-split',
                    label: 'Pending Approval',
                    colorBg: '#fff3cd',
                    colorText: '#664d03',
                    colorBorder: '#ffc107'
                });
            }
            if (isRejectedApprovalEntry(entry)) {
                return buildStatusChipHtml({
                    icon: 'bi-x-circle-fill',
                    label: 'Rejected',
                    colorBg: '#f8d7da',
                    colorText: '#842029',
                    colorBorder: '#dc3545'
                });
            }
            if (String(entry?.approvalStatus || '').toLowerCase() === 'approved' && entry?.activityPaid === true) {
                return buildStatusChipHtml({
                    icon: 'bi-check-circle-fill',
                    label: 'Approved Manual Row',
                    colorBg: '#d1e7dd',
                    colorText: '#0f5132',
                    colorBorder: '#198754'
                });
            }
            if (entry?.activityId && entry?.activityPaid === false) {
                return buildStatusChipHtml({
                    icon: 'bi-slash-circle',
                    label: 'Unpaid Activity',
                    colorBg: '#e2e3e5',
                    colorText: '#41464b',
                    colorBorder: '#adb5bd'
                });
            }
            return buildStatusChipHtml({
                icon: 'bi-person-fill',
                label: 'Manual',
                colorBg: '#cff4fc',
                colorText: '#055160',
                colorBorder: '#0dcaf0'
            });
        }
        if (entry?.isReportReflection === true) {
            return buildStatusChipHtml({
                icon: 'bi-file-earmark-text-fill',
                label: 'Report task',
                colorBg: '#e2e3e5',
                colorText: '#41464b',
                colorBorder: '#adb5bd'
            });
        }
        const normalized = normalizeStatusCode(entry?.status);
        const statusMeta = resolveStatusMeta(normalized);
        const statusLabel = resolveStatusLabel(normalized);
        const colorBg = statusMeta?.colorBg || '#fff3cd';
        const colorText = statusMeta?.colorText || '#664d03';
        const colorBorder = statusMeta?.colorBorder || '#ffe69c';
        const warn = !isFinalAutoStatus(entry);
        const statusChip = buildStatusChipHtml({
            icon: resolveStatusIcon(normalized, { warn }),
            label: statusLabel,
            colorBg,
            colorText,
            colorBorder
        });
        if (entry?.reconciliationRequired !== true) return statusChip;

        const reconciliationLabel = entry?.isProvisional === true
            ? 'Reconciliation. This session is provisional; its hours use the current status formula and will be reconciled in the next timesheet.'
            : 'Reconciliation. This deadline-window session will be reviewed in the next timesheet.';
        const reconciliationChip = buildStatusChipHtml({
            icon: 'bi-arrow-repeat',
            label: reconciliationLabel,
            colorBg: '#cfe2ff',
            colorText: '#084298',
            colorBorder: '#0d6efd'
        });
        return `${statusChip}${reconciliationChip}`;
    };

