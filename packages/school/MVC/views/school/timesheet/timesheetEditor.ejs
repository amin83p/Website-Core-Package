                    document.getElementById('man_startTime').value = normalizeClock(item?.startTime || '');
                    document.getElementById('man_endTime').value = normalizeClock(item?.endTime || '');
                    const hours = Number(parseFloat(item?.durationHours ?? item?.hours) || calculateHoursFromRange(
                        document.getElementById('man_startTime').value,
                        document.getElementById('man_endTime').value
                    ) || 0);
                    document.getElementById('man_hours').value = hours > 0 ? hours.toFixed(2) : '';
