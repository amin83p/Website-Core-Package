                placeholder: 'Type aaa to list all, or search by date/name...',
                renderer: function (item) {
                    function esc(value) {
                        return String(value ?? '').replace(/[&<>"']/g, function (character) {
                            return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[character];
                        });
                    }
                    const dateLabel = String(item?.date || '').trim() || '—';
                    const startTime = String(item?.startTime || '').trim();
                    const endTime = String(item?.endTime || '').trim();
                    const timeLabel = startTime && endTime ? (startTime + ' – ' + endTime) : (startTime || endTime || '—');
                    const sessionName = String(item?.sessionName || item?.name || item?.title || item?.entryId || 'Work session').trim();
                    return ''
                        + '<div class="w-100">'
                        +   '<div class="fw-bold text-dark">' + esc(dateLabel) + '</div>'
                        +   '<div class="text-muted small">' + esc(timeLabel) + '</div>'
                        +   '<div class="mt-1 text-break">' + esc(sessionName) + '</div>'
