    function formatSignedHours(value) {
        const n = Number(value);
        if (!Number.isFinite(n)) return '0.00';
        return (n > 0 ? '+' : '') + n.toFixed(2);
    }

    function mergeAppliedAdjustmentEntries(savedEntries) {
        const nonAdjustment = activeEntries.filter((entry) => entry.isPriorPeriodAdjustment !== true);
        const adjustmentRows = (Array.isArray(savedEntries) ? savedEntries : [])
            .filter((entry) => entry?.isPriorPeriodAdjustment === true)
            .map((entry) => ({
                ...entry,
                isManual: true,
                durationHours: entry.hours
            }));
        activeEntries = [...nonAdjustment, ...adjustmentRows];
        deletedAutoSessionIds = deletedAutoSessionIds.filter((id) => !adjustmentRows.some((row) => row.sessionId === id));
        isEdited = true;
        renderTable();
    }

    async function submitPriorReviewAcknowledgement() {
        const applyRes = await fetch(`/school/timesheets/editor/${PERIOD_ID}/apply-prior-adjustments${buildMutationQuery()}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-AJAX-Request': 'true' },
            body: JSON.stringify({ actionStateId })
        });
        const applyResult = await applyRes.json();
        if (applyResult.status !== 'success') throw new Error(applyResult.message || 'Failed to complete prior-period review.');
        if (applyResult.actionStateId) actionStateId = String(applyResult.actionStateId);
        if (Array.isArray(applyResult.entries) && applyResult.entries.length > 0) {
            mergeAppliedAdjustmentEntries(applyResult.entries);
        }
        return applyResult;
    }

    async function loadPriorAdjustmentsReview() {
        if (!SHOW_PRIOR_ADJUSTMENT_REVIEW || IS_READONLY) return;

        const loadingToken = showTimesheetWaitingModal({
            title: 'Loading Review',
            note: 'Checking prior-period adjustments for this timesheet...',
            operation: 'Prior-period review'
        });
        try {
            const res = await fetch(`/school/timesheets/editor/${PERIOD_ID}/prior-adjustments${buildMutationQuery()}`, {
                headers: { 'X-AJAX-Request': 'true' }
            });
            const result = await res.json();
            if (result.status !== 'success' || !result.needsReview) {
                return;
            }

            const priorName = result.priorPeriod?.name || 'the previous period';
            const priorRange = result.priorPeriod
                ? `${result.priorPeriod.startDate || ''} to ${result.priorPeriod.endDate || ''}`
                : '';
            const adjustments = Array.isArray(result.adjustments) ? result.adjustments : [];
            const unresolved = Array.isArray(result.unresolved) ? result.unresolved : [];
            const reconciliationResults = Array.isArray(result.reconciliationResults) ? result.reconciliationResults : [];
            const resolvedNoChange = reconciliationResults.filter((row) => row?.state === 'resolved' && Math.abs(Number(row?.adjustmentHours || 0)) < 0.005);
            const hasAdjustments = adjustments.length > 0;
            const hasUnresolved = unresolved.length > 0;
            const awaitingPriorProcessing = result.reconciliationState === 'awaiting_prior_processing';
            const summary = result.priorReviewSummary || {};

            const intro = document.getElementById('priorAdjustmentIntro');
            if (intro) {
                if (awaitingPriorProcessing) {
                    intro.textContent = `The prior timesheet for "${priorName}" must be payroll processed before its deadline-window sessions can be reconciled. Current submission remains blocked until then.`;
                } else if (hasUnresolved) {
                    intro.textContent = `${unresolved.length} prior-period session(s) are still non-final. Finalize them using the links below, then reopen this review.`;
                } else if (hasAdjustments) {
                    intro.textContent = `Finalized differences were detected for "${priorName}". Review the signed adjustments below before continuing.`;
                } else {
                    intro.textContent = `We reviewed the deadline-window sessions from "${priorName}" (${priorRange}). No hour adjustment is required.`;
                }
            }

            const summaryEl = document.getElementById('priorAdjustmentSummary');
            if (summaryEl) {
                summaryEl.classList.remove('d-none');
                summaryEl.innerHTML = `
                    <div><strong>Prior period:</strong> ${priorName} (${priorRange})</div>
                    <div class="small text-muted mt-1">Submitted entries: ${Number(summary.entryCount || 0)} | Snapshot hours: ${Number(summary.totalSnapshotHours || 0).toFixed(2)}</div>
                    <div class="small mt-1">Deadline-window sessions: <strong>${Number(summary.reconciliationCount || 0)}</strong> (${Number(summary.reconciliationHours || 0).toFixed(2)} hrs) | Provisional: <strong>${Number(summary.provisionalCount || 0)}</strong> (${Number(summary.provisionalHours || 0).toFixed(2)} hrs) | Unresolved: <strong>${Number(summary.unresolvedCount || 0)}</strong> | No-change resolutions: <strong>${Number(summary.resolvedNoChangeCount || 0)}</strong></div>
                `;
            }

            const tableWrap = document.getElementById('priorAdjustmentTableWrap');
            const tbodyPrior = document.getElementById('priorAdjustmentTableBody');
            const applyBtn = document.getElementById('btnPriorAdjustmentApply');
            const continueBtn = document.getElementById('btnPriorAdjustmentContinue');

            const resolvedRows = adjustments.map((adj) => `
                <tr>
                    <td>${escapeHtml(adj.sourceSessionDate || '-')}</td>
                    <td>${escapeHtml(adj.className || '-')}</td>
                    <td>${escapeHtml(adj.changeSummary || adj.comment || '-')}</td>
                    <td class="text-end">${Number(adj.snapshotHours ?? adj.baselineHours ?? 0).toFixed(2)}</td>
                    <td class="text-end">${Number(adj.currentHours || 0).toFixed(2)}</td>
                    <td class="text-end fw-bold ${Number(adj.deltaHours) < 0 ? 'text-danger' : 'text-success'}">${formatSignedHours(adj.deltaHours)}</td>
                </tr>
            `);
            const unresolvedRows = unresolved.map((row) => `
                <tr class="table-warning">
                    <td>${escapeHtml(row.sourceSessionDate || '-')}</td>
                    <td>${escapeHtml(row.className || '-')}</td>
                    <td>${escapeHtml(row.changeSummary || 'Session is still non-final.')}${row.manageUrl ? ` <a href="${escapeHtml(row.manageUrl)}" target="_blank" rel="noopener">Open session</a>` : ''}</td>
                    <td class="text-end">${Number(row.baselineHours || 0).toFixed(2)}</td>
                    <td class="text-end text-muted">Pending</td>
                    <td class="text-end text-muted">-</td>
                </tr>
            `);
            const noChangeRows = resolvedNoChange.map((row) => `
                <tr class="table-success">
                    <td>${escapeHtml(row.sourceSessionDate || '-')}</td>
                    <td>${escapeHtml(row.className || '-')}</td>
                    <td>Resolved with no payable-hour difference (${escapeHtml(row.currentStatus || row.baselineStatus || 'final')}).</td>
                    <td class="text-end">${Number(row.baselineHours || 0).toFixed(2)}</td>
                    <td class="text-end">${Number(row.currentHours || 0).toFixed(2)}</td>
                    <td class="text-end fw-bold text-muted">0.00</td>
                </tr>
            `);

            if (!awaitingPriorProcessing && (resolvedRows.length || unresolvedRows.length || noChangeRows.length)) {
                if (tableWrap) tableWrap.classList.remove('d-none');
                if (tbodyPrior) tbodyPrior.innerHTML = [...unresolvedRows, ...resolvedRows, ...noChangeRows].join('');
            } else {
                if (tableWrap) tableWrap.classList.add('d-none');
                if (tbodyPrior) tbodyPrior.innerHTML = '';
            }

            if (awaitingPriorProcessing || hasUnresolved) {
                if (applyBtn) applyBtn.classList.add('d-none');
                if (continueBtn) continueBtn.classList.add('d-none');
            } else if (hasAdjustments) {
                if (applyBtn) applyBtn.classList.remove('d-none');
                if (continueBtn) continueBtn.classList.add('d-none');
            } else {
                if (applyBtn) applyBtn.classList.add('d-none');
                if (continueBtn) continueBtn.classList.remove('d-none');
            }

            if (typeof bootstrap === 'undefined' || !bootstrap.Modal) {
                console.error('Bootstrap modal is unavailable; cannot show prior-period review.');
                return;
            }

            const modalEl = document.getElementById('priorAdjustmentModal');
            const modal = new bootstrap.Modal(modalEl);

            document.getElementById('btnPriorAdjustmentLater').onclick = () => modal.hide();

            const runAcknowledgement = async (buttonEl, successTitle) => {
                buttonEl.disabled = true;
                const loadingToken = showTimesheetWaitingModal({
                    title: successTitle || 'Processing Review',
                    note: 'Please wait while prior-period adjustments are applied...',
                    operation: 'Prior-period acknowledgement'
                });
                try {
                    const applyResult = await submitPriorReviewAcknowledgement();
                    modal.hide();
                    hideTimesheetWaitingModal(loadingToken);
                    await messageBox({
                        title: successTitle,
                        icon: 'success',
                        message: applyResult.message || 'Prior-period review completed.',
                        okText: 'OK',
                        okClass: 'btn-success'
                    });
                } catch (error) {
                    await messageBox({ title: 'Error', icon: 'error', message: error.message });
                } finally {
                    hideTimesheetWaitingModal(loadingToken);
                    buttonEl.disabled = false;
                }
            };

            if (applyBtn) {
                applyBtn.onclick = () => runAcknowledgement(applyBtn, 'Adjustments Applied');
            }
            if (continueBtn) {
                continueBtn.onclick = () => runAcknowledgement(continueBtn, 'Review Complete');
            }

            modal.show();
        } catch (error) {
            console.error('Failed to load prior-period adjustments', error);
        } finally {
            hideTimesheetWaitingModal(loadingToken);
        }
    }

    async function showIncompleteSessionWarningOnLoad() {
        const rows = Array.isArray(INCOMPLETE_SESSIONS) ? INCOMPLETE_SESSIONS : [];
        if (!rows.length) return;
        const classCount = rows.filter((row) => String(row?.sessionType || 'class') === 'class').length;
        const activityCount = rows.filter((row) => row?.sessionType === 'activity').length;
        const breakdownParts = [];
        if (classCount) breakdownParts.push(`<strong>${classCount}</strong> class`);
        if (activityCount) breakdownParts.push(`<strong>${activityCount}</strong> activity work`);
        const breakdownText = breakdownParts.length
            ? ` (${breakdownParts.join(', ')} session${rows.length === 1 ? '' : 's'})`
            : '';
        const summaryHtml = `
            <p class="mb-2">You have <strong>${rows.length}</strong> incomplete session(s) in this period${breakdownText}.</p>
            <p class="mb-2">Finalize class session statuses and complete activity work sessions before submission.</p>
            <p class="small text-muted mb-0">Use the collapsible <strong>Incomplete Sessions</strong> panel below for the full list.</p>`;
        if (typeof showMessageModal === 'function') {
            await showMessageModal({
                title: 'Incomplete Sessions Detected',
                icon: 'warning',
                message: summaryHtml,
                buttons: [{ text: 'OK', class: 'btn-warning' }]
            });
            return;
        }
        await messageBox({
            title: 'Incomplete Sessions Detected',
            icon: 'warning',
            message: `You have ${rows.length} incomplete session(s) in this period. Review the list below before submitting.`
        });
    }

    function normalizeIncompleteStatusCode(value) {
        return String(value || '').trim().toLowerCase().replace(/[\s-]+/g, '_');
    }

    function getIncompleteSessionStatusMeta(statusCode) {
        const code = normalizeIncompleteStatusCode(statusCode);
        return (Array.isArray(SESSION_STATUS_META) ? SESSION_STATUS_META : [])
            .find((row) => normalizeIncompleteStatusCode(row?.code) === code) || null;
    }

    function resolveIncompleteRowClass(dateStr) {
        if (holidayMap.get(dateStr) || isWeekendDate(dateStr)) return 'incomplete-row-holiday';
        const dayIndex = dateDayIndexMap.get(dateStr) ?? 0;
        return `incomplete-row-day-${Math.abs(dayIndex) % 2}`;
    }

    function buildIncompleteStatusBadge(row) {
        const label = row?.statusLabel || row?.status || 'In progress';
        if (row?.sessionType === 'activity') {
            const isPendingCompletion = String(row?.evaluationType || '').toLowerCase() === 'completion'
                || String(label).toLowerCase().includes('pending');
            const bg = isPendingCompletion ? '#fff3cd' : '#f8f9fa';
            const border = isPendingCompletion ? '#ffc107' : '#dee2e6';
            return `<span class="badge border text-dark" style="background-color:${escapeHtml(bg)};border-color:${escapeHtml(border)} !important;">${escapeHtml(label)}</span>`;
        }
        const meta = getIncompleteSessionStatusMeta(row?.status);
        const bg = meta?.colorBg || '#fff3cd';
        const border = meta?.colorBorder || '#ffc107';
        return `<span class="badge border text-dark" style="background-color:${escapeHtml(bg)};border-color:${escapeHtml(border)} !important;">${escapeHtml(label)}</span>`;
    }

    function buildIncompleteSessionManagerHref(row) {
        if (row?.sessionType === 'activity') {
            const activityId = String(row?.activityId || '').trim();
            const entryId = String(row?.activityEntryId || '').trim();
            if (!activityId || !entryId) return '';
            return `/school/activities/${encodeURIComponent(activityId)}/work-sessions/${encodeURIComponent(entryId)}/manage`;
        }
        const classId = String(row?.classId || '').trim();
        const sessionId = String(row?.sessionId || '').trim();
        if (!classId || !sessionId) return '';
        return `/school/classes/${encodeURIComponent(classId)}/sessions/${encodeURIComponent(sessionId)}`;
    }

    function buildIncompleteSessionActionButton(row) {
        const href = buildIncompleteSessionManagerHref(row);
        if (!href) {
            return '<span class="text-muted small">Unavailable</span>';
        }
        const isActivity = row?.sessionType === 'activity';
        const label = isActivity ? 'Manage Work Session' : 'Manage Session';
        const title = isActivity
            ? 'Open activity work session management in a new tab'
            : 'Open Manage Session in a new tab';
        return `<a href="${escapeHtml(href)}" class="btn btn-sm btn-outline-primary fw-semibold" target="_blank" rel="noopener noreferrer" title="${escapeHtml(title)}"><i class="bi bi-box-arrow-up-right me-1"></i>${escapeHtml(label)}</a>`;
    }

    function buildIncompleteSessionsTableBodyHtml(rows) {
        return rows.map((row, index) => {
            const dateStr = row?.date || '';
            const dayName = dateStr
                ? formatTimesheetDateLabel(dateStr, { weekday: 'long' })
                : '';
            const shortDateLabel = dateStr
                ? formatTimesheetDateLabel(dateStr, { weekday: 'short', month: 'short', day: 'numeric' })
                : '-';
            const timeLabel = row?.startTime && row?.endTime
                ? `${row.startTime} - ${row.endTime}`
                : 'Time not set';
            const rowClass = resolveIncompleteRowClass(dateStr);
            const hol = holidayMap.get(dateStr);
            const holidayNote = hol
                ? `<div class="small text-danger fw-semibold mt-1"><i class="bi bi-calendar-x me-1"></i>${escapeHtml(holidayName(hol))}</div>`
                : '';
            const isActivity = row?.sessionType === 'activity';
            const typeBadge = isActivity
                ? '<span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-1">Activity</span>'
                : '';
            const subtitle = isActivity
                ? `<div class="small text-muted font-monospace">${escapeHtml(row?.activityEntryId || row?.sessionId || '')}</div>`
                : `<div class="small text-muted font-monospace">${escapeHtml(row?.sessionId || '')}</div>`;
            return `
                <tr class="${rowClass}">
                    <td class="ps-4 fw-semibold">
                        <div class="ts-date-label">${escapeHtml(shortDateLabel)}</div>
                        <div class="small text-muted">${escapeHtml(dayName)}</div>
                        ${holidayNote}
                    </td>
                    <td>
                        <div class="fw-bold text-dark">${escapeHtml(row?.className || row?.classId || 'Session')}${typeBadge}</div>
                        ${subtitle}
                    </td>
                    <td><i class="bi bi-clock me-1 text-muted"></i>${escapeHtml(timeLabel)}</td>
                    <td>${buildIncompleteStatusBadge(row)}</td>
                    <td class="text-center pe-3">${buildIncompleteSessionActionButton(row)}</td>
                </tr>`;
        }).join('');
    }

    function renderIncompleteSessionsPanel() {
        const rows = Array.isArray(INCOMPLETE_SESSIONS) ? INCOMPLETE_SESSIONS : [];
        const panel = document.getElementById('incompleteSessionsPanel');
        const tbody = document.getElementById('incompleteSessionsBody');
        const countEl = document.getElementById('incompleteSessionsCount');
        const toggleBtn = document.getElementById('incompleteSessionsToggle');
        if (!panel || !tbody) return;
        if (!rows.length) {
            panel.classList.add('d-none');
            return;
        }
        panel.classList.remove('d-none');
        if (countEl) countEl.textContent = String(rows.length);
        tbody.innerHTML = buildIncompleteSessionsTableBodyHtml(rows);
        if (toggleBtn) {
            toggleBtn.classList.add('collapsed');
            toggleBtn.setAttribute('aria-expanded', 'false');
        }
    }

    const incompleteSessionsCollapse = document.getElementById('incompleteSessionsCollapse');
    const incompleteSessionsToggle = document.getElementById('incompleteSessionsToggle');
    if (incompleteSessionsCollapse && incompleteSessionsToggle) {
        incompleteSessionsCollapse.addEventListener('show.bs.collapse', () => {
            incompleteSessionsToggle.classList.remove('collapsed');
            incompleteSessionsToggle.setAttribute('aria-expanded', 'true');
        });
        incompleteSessionsCollapse.addEventListener('hide.bs.collapse', () => {
            incompleteSessionsToggle.classList.add('collapsed');
            incompleteSessionsToggle.setAttribute('aria-expanded', 'false');
        });
    }

    renderIncompleteSessionsPanel();
    renderTable();
    showIncompleteSessionWarningOnLoad();
    loadPriorAdjustmentsReview();
});
</script>
