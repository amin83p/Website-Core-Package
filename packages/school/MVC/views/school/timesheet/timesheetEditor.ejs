    function resolveDisplayEntry(entry) {
        const sessionId = String(entry?.sessionId || '').trim();
        const liveSession = sessionId ? liveSessionById.get(sessionId) : null;
        const classId = String(entry?.classId || liveSession?.classId || '').trim();
        const liveClass = classId ? liveDepartmentByClassId.get(classId) : null;
        return {
            ...(liveClass || {}),
            ...(liveSession || {}),
            ...(entry || {})
        };
    }

    function isTimesheetActivityEntry(entry) {
        const sessionId = String(entry?.sessionId || '').trim().toLowerCase();
        return entry?.isSchoolActivity === true
            || Boolean(String(entry?.activityId || '').trim())
            || sessionId.startsWith('act-');
    }

    function buildTimesheetEntryManagerHref(entry) {
        if (!entry || entry.isPriorPeriodAdjustment === true || entry.isReportReflection === true) return '';

        const sessionId = String(entry.sessionId || '').trim();
        if (sessionId.toLowerCase().startsWith('rptref-') || sessionId.toLowerCase().startsWith('adj-')) return '';

        const activityId = String(entry.activityId || '').trim();
        const activityEntryId = String(entry.activityEntryId || '').trim();
        if (activityId && activityEntryId) {
            return `/school/activities/${encodeURIComponent(activityId)}/work-sessions/${encodeURIComponent(activityEntryId)}/manage`;
        }
        if (isTimesheetActivityEntry(entry)) return '';

        const classId = String(entry.classId || '').trim();
        const managedSessionId = entry.isManual === true
            ? String(entry.materializedSessionId || '').trim()
            : sessionId;
        const normalizedManagedId = managedSessionId.toLowerCase();
        if (!classId || !managedSessionId
            || normalizedManagedId.startsWith('act-')
            || normalizedManagedId.startsWith('rptref-')
            || normalizedManagedId.startsWith('adj-')) {
            return '';
        }
        return `/school/classes/${encodeURIComponent(classId)}/sessions/${encodeURIComponent(managedSessionId)}`;
    }

    function normalizeTooltipDetailValue(value) {
        return String(value || '').replace(/\s+/g, ' ').trim();
    }

    function formatTooltipDetailLabel(value) {
        const normalized = normalizeTooltipDetailValue(value).replace(/[_-]+/g, ' ');
        return normalized.replace(/\b\w/g, (ch) => ch.toUpperCase());
    }

    function resolveTimesheetEntryStatusLabel(entry) {
        if (entry?.isPriorPeriodAdjustment === true) return 'Prior Period Adjustment';
        if (entry?.isReportReflection === true) return 'Report Task';
        if (entry?.isManual === true) {
            if (isPendingApprovalEntry(entry)) return 'Pending Approval';
            if (isRejectedApprovalEntry(entry)) return 'Rejected';
            if (isUnpaidApprovalEntry(entry)) return 'Unpaid';
            if (String(entry?.approvalStatus || '').trim().toLowerCase() === 'approved') return 'Approved';
            return 'Manual';
        }
        const status = normalizeTooltipDetailValue(entry?.status);
        return status ? resolveStatusLabel(status) : '';
    }

    function buildTimesheetEntryTooltip(entry) {
        const isActivity = isTimesheetActivityEntry(entry);
        const name = normalizeTooltipDetailValue(isActivity
            ? (entry?.activityName || entry?.className || entry?.description)
            : (entry?.className || entry?.description));
        const departmentCode = normalizeTooltipDetailValue(entry?.deliveryDepartmentCode || entry?.departmentCode);
        const departmentName = normalizeTooltipDetailValue(
            entry?.deliveryDepartmentName || entry?.departmentName || entry?.deliveryDepartmentId || entry?.departmentId
        );
        const department = Array.from(new Set([departmentCode, departmentName].filter(Boolean))).join(' · ');
        const category = normalizeTooltipDetailValue(entry?.categoryName || entry?.categoryId);
        const date = normalizeTooltipDetailValue(entry?.date);
        const startTime = normalizeTooltipDetailValue(entry?.startTime);
        const endTime = normalizeTooltipDetailValue(entry?.endTime);
        const time = startTime ? `${startTime}${endTime ? ` – ${endTime}` : ''}` : '';
        const studentName = normalizeTooltipDetailValue(entry?.singleStudentName);
        const attendance = normalizeTooltipDetailValue(entry?.singleStudentAttendance);
        const status = resolveTimesheetEntryStatusLabel(entry);
        const room = normalizeTooltipDetailValue(entry?.room || entry?.roomName || entry?.location);
        const roleParts = [entry?.personRole, entry?.isCoTeacherSession ? entry?.coTeacherRoleLabel : '']
            .map(formatTooltipDetailLabel)
            .filter(Boolean);
        const role = Array.from(new Set(roleParts)).join(' · ');
        const details = [];
        const addDetail = (label, value) => {
            const cleaned = normalizeTooltipDetailValue(value);
            if (cleaned) details.push(`${label}: ${cleaned}`);
        };

        addDetail(isActivity ? 'Activity' : 'Class', name);
        addDetail('Department', department);
        if (isActivity) addDetail('Category', category);
        addDetail('Date', date ? formatTimesheetDateLabel(date) : '');
        addDetail('Time', time);
        if (!isActivity) {
            addDetail('Student', studentName);
            addDetail('Attendance', attendance ? formatTooltipDetailLabel(attendance) : '');
        }
        addDetail('Status', status);
        addDetail('Room', room);
        addDetail('Role', role);
        return details.join('\n');
    }

    function buildClassDescriptionCellHtml(entry) {
        const departmentCode = String(entry?.deliveryDepartmentCode || entry?.departmentCode || '').trim();
        const fallback = String(
            entry?.description
            || entry?.className
            || entry?.activityName
            || entry?.classId
            || ''
        ).trim();
        const oneOnOneBadge = entry?.isOneOnOne === true
            ? '<span class="badge rounded-pill ts-one-on-one-badge">One on One</span>'
            : '';
        const primaryContent = departmentCode
            ? `<span class="ts-department-code">${escapeHtml(departmentCode)}</span>${oneOnOneBadge}`
            : `<span class="ts-class-fallback">${escapeHtml(fallback)}</span>`;
        const href = buildTimesheetEntryManagerHref(entry);
        const tooltip = href ? buildTimesheetEntryTooltip(entry) : '';
        const managerLabel = isTimesheetActivityEntry(entry) ? 'Open Manage Work Session' : 'Open Manage Session';
        const primary = href
            ? `<a href="${escapeHtml(href)}" class="ts-class-primary-link ts-tooltip-trigger" target="_blank" rel="noopener noreferrer" data-tip="${escapeHtml(tooltip)}" data-tip-variant="details" data-tip-bg="#0f172a" data-tip-fg="#ffffff" data-tip-border="#334155" aria-label="${escapeHtml(`${managerLabel}: ${fallback || departmentCode}`)}">${primaryContent}</a>`
            : primaryContent;
        return `<div class="ts-class-primary">${primary}${payrollRoleBadge(entry?.personRole)}${coTeacherBadge(entry)}</div>`;
    }

    function buildOptionalBadgeHtml(entry) {
        if (entry?.showOptionalBadge !== true) return '';
        return '<span class="badge rounded-pill ts-optional-badge" title="One-on-one class was not held; badge is informational only.">Optional</span>';
    }

    function buildHoursTimeCellHtml(entry, hours, requestedHours) {
        const optionalBadge = buildOptionalBadgeHtml(entry);
        let hoursHtml = '';
        if (isPendingApprovalEntry(entry)) {
            hoursHtml = `<div class="ts-hours-line"><span class="ts-hours-value text-muted text-decoration-line-through">${requestedHours.toFixed(2)}</span><span class="ts-hours-unit">hrs</span>${optionalBadge}</div><div class="small text-warning fw-semibold">0.00 hrs payable (pending)</div>`;
        } else if (isRejectedApprovalEntry(entry)) {
            hoursHtml = `<div class="ts-hours-line"><span class="ts-hours-value text-muted text-decoration-line-through">${requestedHours.toFixed(2)}</span><span class="ts-hours-unit">hrs</span>${optionalBadge}</div><div class="small text-danger fw-semibold">0.00 hrs payable (rejected)</div>`;
        } else if (isUnpaidApprovalEntry(entry)) {
            hoursHtml = `<div class="ts-hours-line"><span class="ts-hours-value text-muted text-decoration-line-through">${requestedHours.toFixed(2)}</span><span class="ts-hours-unit">hrs</span>${optionalBadge}</div><div class="small text-secondary fw-semibold">0.00 hrs payable (unpaid)</div>`;
        } else {
            const valueClass = Number(hours) < 0 ? 'text-danger' : 'text-success';
            hoursHtml = `<div class="ts-hours-line"><span class="ts-hours-value ${valueClass}">${Number(hours || 0).toFixed(2)}</span><span class="ts-hours-unit">hrs</span>${optionalBadge}</div>`;
        }

        let timeHtml = '';
        if (entry?.isPriorPeriodAdjustment === true) {
            const referenceDate = String(entry?.adjustmentMeta?.sourceSessionDate || entry?.date || '').trim();
            timeHtml = `<div class="ts-time-label"><i class="bi bi-arrow-counterclockwise me-1"></i>Prior period correction${referenceDate ? `<div class="small mt-1">Ref: ${escapeHtml(referenceDate)}</div>` : ''}</div>`;
        } else {
            const startTime = String(entry?.startTime || '').trim();
            const endTime = String(entry?.endTime || '').trim();
            const timeRange = startTime
                ? `${escapeHtml(startTime)}${endTime ? ` – ${escapeHtml(endTime)}` : ''}`
                : 'Manual time';
            timeHtml = `<div class="ts-time-label"><i class="bi bi-clock me-1"></i>${timeRange}</div>`;
        }
        return `<div class="ts-hours-time-stack">${hoursHtml}${timeHtml}</div>`;
    }

    function resolveDepartmentLabel(entry) {
        const direct = String(
            entry?.deliveryDepartmentName
            || entry?.departmentName
            || entry?.deliveryDepartmentId
            || entry?.departmentId
            || ''
        ).trim();
        if (direct) return direct;

        const sessionId = String(entry?.sessionId || '').trim();
        const liveBySession = sessionId ? liveSessionById.get(sessionId) : null;
        const fromLiveSession = String(
            liveBySession?.deliveryDepartmentName
            || liveBySession?.departmentName
            || liveBySession?.deliveryDepartmentId
            || liveBySession?.departmentId
            || ''
        ).trim();
        if (fromLiveSession) return fromLiveSession;

        const classId = String(entry?.classId || liveBySession?.classId || '').trim();
        const fromClass = classId ? liveDepartmentByClassId.get(classId) : null;
        const fromLiveClass = String(
            fromClass?.deliveryDepartmentName
            || fromClass?.deliveryDepartmentId
            || ''
        ).trim();
        if (fromLiveClass) return fromLiveClass;

        const activityId = String(entry?.activityId || '').trim();
        const activity = activityId && typeof manualActivityMap !== 'undefined'
            ? manualActivityMap.get(activityId)
            : null;
        const fromActivity = String(
            activity?.departmentName
            || activity?.deliveryDepartmentName
            || activity?.departmentId
            || activity?.deliveryDepartmentId
            || ''
        ).trim();
        if (fromActivity) return fromActivity;

        return 'No Department';
    }

    function resolveOptionalReportingHours(entry) {
        if (entry?.showOptionalBadge !== true) return 0;

        const durationHours = Number.parseFloat(entry?.durationHours);
        if (Number.isFinite(durationHours) && durationHours > 0) {
            return Number(durationHours.toFixed(2));
        }

        const scheduledHours = calculateHoursFromRange(entry?.startTime, entry?.endTime);
        if (Number.isFinite(scheduledHours) && scheduledHours > 0) {
            return Number(scheduledHours.toFixed(2));
        }

        const fallbackHours = Number(resolveEntryHours(entry) || 0);
        return Number.isFinite(fallbackHours) && fallbackHours > 0
            ? Number(fallbackHours.toFixed(2))
            : 0;
    }

    function renderDepartmentTotals() {
        const totalsBody = document.getElementById('tsDepartmentTotalsBody');
        if (!totalsBody) return;
        const buckets = new Map();
        activeEntries.forEach((entry) => {
            if (entry?.isDeleted) return;
            const displayEntry = resolveDisplayEntry(entry);
            const sessionHours = Number(resolveEntryHours(entry) || 0);
            const pendingHours = isPendingApprovalEntry(entry) ? Number(resolveRequestedHours(entry) || 0) : 0;
            const optionalHours = resolveOptionalReportingHours(displayEntry);
            if ((!Number.isFinite(sessionHours) || sessionHours === 0)
                && (!Number.isFinite(pendingHours) || pendingHours === 0)
                && (!Number.isFinite(optionalHours) || optionalHours === 0)) {
                return;
            }
            const dept = resolveDepartmentLabel(displayEntry);
            const current = buckets.get(dept) || { sessionHours: 0, optionalHours: 0, pendingHours: 0 };
            current.sessionHours = Number((current.sessionHours + (Number.isFinite(sessionHours) ? sessionHours : 0)).toFixed(2));
            current.optionalHours = Number((current.optionalHours + optionalHours).toFixed(2));
            current.pendingHours = Number((current.pendingHours + (Number.isFinite(pendingHours) ? pendingHours : 0)).toFixed(2));
            buckets.set(dept, current);
        });
        const rows = Array.from(buckets.entries()).sort((a, b) => String(a[0]).localeCompare(String(b[0])));
        if (!rows.length) {
            totalsBody.innerHTML = '<tr><td colspan="4" class="text-center text-muted py-3">No department hours yet.</td></tr>';
            return;
        }
        let totalSession = 0;
        let totalOptional = 0;
        let totalPending = 0;
        const html = rows.map(([dept, hrs]) => {
            const sessionHours = Number(hrs.sessionHours || 0);
            const optionalHours = Number(hrs.optionalHours || 0);
            const pendingHours = Number(hrs.pendingHours || 0);
            const rowTotal = Number((sessionHours + pendingHours).toFixed(2));
            totalSession += sessionHours;
            totalOptional += optionalHours;
            totalPending += pendingHours;
            const optionalRow = `<tr class="table-info-subtle">
                <td colspan="3" class="ps-5 text-info-emphasis">
                    <i class="bi bi-arrow-return-right me-2" aria-hidden="true"></i><span class="fw-semibold">Optional Hours</span>
                    <span class="small text-muted ms-1">(scheduled duration, informational only)</span>
                </td>
                <td class="text-end pe-4 fw-bold text-info-emphasis">${optionalHours.toFixed(2)}</td>
            </tr>`;
            return `<tr>
                <td class="ps-4">${dept}</td>
                <td class="text-end pe-4 fw-semibold">${sessionHours.toFixed(2)}</td>
                <td class="text-end pe-4 fw-semibold">${pendingHours.toFixed(2)}</td>
                <td class="text-end pe-4 fw-semibold">${rowTotal.toFixed(2)}</td>
            </tr>${optionalRow}`;
        }).join('');
        const grandTotal = Number((totalSession + totalPending).toFixed(2));
        totalsBody.innerHTML = `${html}<tr class="table-light">
            <td class="ps-4 fw-bold">Total</td>
            <td class="text-end pe-4 fw-bold text-success">${totalSession.toFixed(2)}</td>
            <td class="text-end pe-4 fw-bold text-warning">${totalPending.toFixed(2)}</td>
            <td class="text-end pe-4 fw-bold text-success">${grandTotal.toFixed(2)}</td>
        </tr><tr class="table-info-subtle">
            <td colspan="3" class="ps-4 fw-bold text-info-emphasis">Total Optional Hours <span class="small fw-normal text-muted">(informational only)</span></td>
            <td class="text-end pe-4 fw-bold text-info-emphasis">${totalOptional.toFixed(2)}</td>
        </tr>`;
    }

    function renderTable() {
        tbody.innerHTML = '';
        grandTotalHours = 0;
        provisionalSessionCount = 0;
        provisionalHours = 0;
        reconciliationSessionCount = 0;
        reconciliationHours = 0;
        hasUncompletedSessions = Array.isArray(INCOMPLETE_SESSIONS) && INCOMPLETE_SESSIONS.length > 0;
        hasPendingApprovals = false;

        dates.forEach((dateStr) => {
            const { dayName, dayOfWeek } = dateKeyWeekday(dateStr);

            const hol = holidayMap.get(dateStr);
            const isHoliday = !!hol;
            const isWeekend = isWeekendDay(dayOfWeek);
            const bgClass = resolveBgClass(isHoliday, isWeekend, dateStr);

            const dayEntries = sortTimesheetEntriesBySchedule(
                activeEntries.filter(e => e.date === dateStr)
            );
            const dayRowSpan = Math.max(1, dayEntries.length);

            if (dayEntries.length === 0) {
                const dateCell = buildDateCellHtml(dateStr, dayName, isHoliday, hol);
                const zeroHoursCell = '<td class="ts-col-hours-time align-middle"><div class="ts-hours-line"><span class="ts-hours-value">0.00</span><span class="ts-hours-unit">hrs</span></div></td>';
                if (isHoliday) {
                    tbody.innerHTML += `<tr class="${bgClass} row-hover ts-day-group-end">
                        <td class="ps-4 align-middle border-end border-2" rowspan="${dayRowSpan}">${dateCell}</td>
                        <td colspan="2" class="align-middle text-danger fw-bold"><i class="bi bi-calendar-x-fill me-1"></i> Holiday: ${holidayName(hol)}</td>
                        ${zeroHoursCell}
                        <td class="ts-col-status"></td>
                        <td></td>
                        ${IS_READONLY ? '' : '<td class="ts-col-actions"></td>'}
                    </tr>`;
                } else {
                    tbody.innerHTML += `<tr class="${bgClass} row-hover ts-day-group-end">
                        <td class="ps-4 align-middle border-end border-2" rowspan="${dayRowSpan}">${dateCell}</td>
                        <td colspan="2" class="text-muted fst-italic align-middle">No sessions logged.</td>
                        ${zeroHoursCell}
                        <td class="ts-col-status"></td>
                        <td></td>
                        ${IS_READONLY ? '' : '<td class="ts-col-actions"></td>'}
                    </tr>`;
                }
            } else {
                dayEntries.forEach((ses, sIdx) => {
                    const displaySes = resolveDisplayEntry(ses);
                    const hrs = resolveEntryHours(ses);
                    grandTotalHours += hrs;
                    if (ses.reconciliationRequired === true) {
                        reconciliationSessionCount += 1;
                        reconciliationHours += Math.max(0, hrs);
                    }
                    if (ses.isProvisional === true) {
                        provisionalSessionCount += 1;
                        provisionalHours += hrs;
                    }

                    const statusBadge = buildStatusBadgeHtml(displaySes);
                    if (!ses.isManual && !ses.isPriorPeriodAdjustment && ses.isProvisional !== true && !isFinalAutoStatus(ses)) {
                        hasUncompletedSessions = true;
                    }
                    if (isPendingApprovalEntry(ses)) {
                        hasPendingApprovals = true;
                    }

                    const isPriorAdj = ses.isPriorPeriodAdjustment === true;
                    const isDayEnd = sIdx === dayEntries.length - 1;
                    const rowClass = [
                        bgClass,
                        'row-hover',
                        isPriorAdj ? 'row-prior-adjustment' : '',
                        ses.isProvisional === true ? 'row-provisional' : '',
                        isDayEnd ? 'ts-day-group-end' : ''
                    ].filter(Boolean).join(' ');

                    const commentInput = buildCommentCellHtml(ses);

                    let actBtns = '';
                    if (!IS_READONLY) {
                        if (ses.reconciliationRequired === true) {
                            actBtns = `<span class="text-muted small ts-tooltip-trigger" data-tip="Deadline-window sessions are required and cannot be removed from this timesheet." tabindex="0"><i class="bi bi-lock-fill"></i></span>`;
                        } else if (isPriorAdj) {
                            actBtns = `<span class="text-muted small"><i class="bi bi-lock-fill"></i></span>`;
                        } else if (ses.isManual) {
                            const reviewBtns = CAN_MANAGER_REVIEW && isPendingApprovalEntry(ses) && ses.activityPaid === true
                                ? `<button class="btn btn-sm btn-outline-success py-0 px-1 me-1" title="Approve paid manual row" onclick="decideManualRow('${ses.sessionId}', 'approved')"><i class="bi bi-check-lg"></i></button>
                                   <button class="btn btn-sm btn-outline-danger py-0 px-1 me-1" title="Reject paid manual row" onclick="decideManualRow('${ses.sessionId}', 'rejected')"><i class="bi bi-x-lg"></i></button>`
                                : '';
                            const copyBtn = isIndividualManualActivityRow(ses)
                                ? `<button class="btn btn-sm btn-outline-primary py-0 px-1 ms-1" title="Copy to other days" onclick="openCopyManualRowModal('${ses.sessionId}')"><i class="bi bi-copy"></i></button>`
                                : '';
                            actBtns = `${reviewBtns}<button class="btn btn-sm btn-outline-secondary py-0 px-1" title="Edit" onclick="openManualModal('${dateStr}', '${ses.sessionId}')"><i class="bi bi-pencil"></i></button>
                                       ${copyBtn}
                                       <button class="btn btn-sm btn-outline-danger py-0 px-1 ms-1" title="Remove" onclick="removeEntry('${ses.sessionId}')"><i class="bi bi-trash"></i></button>`;
                        } else {
                            actBtns = `<button class="btn btn-sm btn-outline-danger py-0 px-1" title="Remove Auto-Pulled Session" onclick="removeEntry('${ses.sessionId}')"><i class="bi bi-trash"></i></button>`;
                        }
                    }

                    const actHtml = IS_READONLY ? '' : `<td class="ts-col-actions"><div class="ts-action-stack">${actBtns}</div></td>`;
                    const dateCell = sIdx === 0
                        ? `<td class="ps-4 align-top border-end border-2" rowspan="${dayRowSpan}">
                            ${buildDateCellHtml(dateStr, dayName, isHoliday, hol)}
                           </td>`
                        : '';

                    const requestedHours = resolveRequestedHours(ses);
                    const hoursTimeHtml = buildHoursTimeCellHtml(displaySes, hrs, requestedHours);
                    const classMeta = displaySes.isManual && displaySes.activityName
                        ? `<div class="small text-muted"><i class="bi bi-list-check me-1"></i>${escapeHtml(displaySes.activityName)}${displaySes.activityPaid ? ' (paid)' : ' (unpaid)'}</div>`
                        : (displaySes.isManual && displaySes.deliveryDepartmentName
                            ? `<div class="small text-muted"><i class="bi bi-building me-1"></i>${escapeHtml(displaySes.deliveryDepartmentName)}</div>`
                            : '');

                    tbody.innerHTML += `
                        <tr class="${rowClass}">
                            ${dateCell}
                            <td>${buildClassDescriptionCellHtml(displaySes)}${classMeta}</td>
                            <td>${buildStudentNameCellHtml(displaySes)}</td>
                            <td class="ts-col-hours-time">${hoursTimeHtml}</td>
                            <td class="ts-col-status"><div class="ts-status-stack">${statusBadge}${buildMakeupSessionStatusHtml(displaySes)}</div></td>
                            <td>${commentInput}</td>
                            ${actHtml}
                        </tr>
                    `;
                });
            }
        });

        document.getElementById('lbl_grandTotal').innerText = grandTotalHours.toFixed(2);
        const provisionalSummary = document.getElementById('provisionalSessionsSummary');
        if (provisionalSummary) {
            if (reconciliationHours > 0) {
                const provisionalDetail = provisionalSessionCount > 0
                    ? `<strong>${provisionalSessionCount}</strong> provisional session(s), totaling <strong>${provisionalHours.toFixed(2)} hours</strong>, use their current status formula.`
                    : 'All qualifying sessions currently have final statuses.';
                provisionalSummary.classList.remove('d-none');
                provisionalSummary.innerHTML = `<span class="ts-reconciliation-note__icon" aria-hidden="true"><i class="bi bi-arrow-repeat"></i></span>
                    <div>
                        <div class="ts-notice-tile__eyebrow">Next-period review</div>
                        <div class="ts-reconciliation-note__title">Deadline-window reconciliation</div>
                        <div class="ts-reconciliation-note__body"><strong>${reconciliationHours.toFixed(2)} hours</strong> across <strong>${reconciliationSessionCount}</strong> deadline-window session(s) qualify for reconciliation. ${provisionalDetail} Finalized differences will be applied in the next timesheet.</div>
                    </div>`;
            } else {
                provisionalSummary.classList.add('d-none');
                provisionalSummary.innerHTML = '';
            }
        }
        renderDepartmentTotals();

        const btnSubmit = document.getElementById('btnSubmit');
        if (btnSubmit) {
            const blockedByDeadline = IS_SUBMISSION_DEADLINE_PASSED && !ALLOW_LATE_SUBMISSION;
            if (hasUncompletedSessions) {
                btnSubmit.disabled = true;
                btnSubmit.innerHTML = '<i class="bi bi-lock-fill me-1"></i> Finalize Session Statuses to Submit';
                btnSubmit.classList.replace('btn-primary', 'btn-secondary');
                btnSubmit.title = '';
            } else if (blockedByDeadline) {
                btnSubmit.disabled = true;
                btnSubmit.innerHTML = '<i class="bi bi-lock-fill me-1"></i> Deadline Passed';
                btnSubmit.classList.replace('btn-primary', 'btn-secondary');
                btnSubmit.title = 'Submission deadline has passed. A timesheet manager must allow late submission.';
            } else {
                btnSubmit.disabled = false;
                btnSubmit.innerHTML = 'Submit for Payroll';
                btnSubmit.classList.replace('btn-secondary', 'btn-primary');
                btnSubmit.title = '';
            }
        }

        const btnManagerApprove = document.getElementById('btnApproveTimesheet');
        if (btnManagerApprove) {
            btnManagerApprove.disabled = hasPendingApprovals;
            btnManagerApprove.title = hasPendingApprovals
                ? 'Approve or reject every pending paid manual row first.'
                : '';
        }

        if (isEdited) document.getElementById('badge_manualEdit').classList.remove('d-none');
    }

    tbody.addEventListener('click', (event) => {
        const trigger = event.target.closest('.ts-comment-trigger');
        if (!trigger) return;
        const sessionId = String(trigger.dataset.sesid || '').trim();
        if (sessionId) openTimesheetCommentModal(sessionId);
    });

    const timesheetCommentModalEl = document.getElementById('timesheetCommentModal');
    if (timesheetCommentModalEl) {
        timesheetCommentModalEl.addEventListener('hidden.bs.modal', () => {
            persistTimesheetCommentModal();
            releaseStrayModalShell();
        });
    }

    const entryTipEl = document.createElement('div');
    entryTipEl.id = 'tsEntryTip';
    entryTipEl.className = 'ts-entry-tip';
    entryTipEl.setAttribute('role', 'tooltip');
    entryTipEl.hidden = true;
    document.body.appendChild(entryTipEl);
    let activeTipTrigger = null;

    const hideEntryTip = () => {
        if (activeTipTrigger) activeTipTrigger.removeAttribute('aria-describedby');
        activeTipTrigger = null;
        entryTipEl.classList.remove('is-visible', 'is-details');
        entryTipEl.hidden = true;
    };
    const showEntryTip = (trigger) => {
        const label = String(trigger?.getAttribute('data-tip') || '').trim();
        if (!label) {
            hideEntryTip();
            return;
        }
        if (activeTipTrigger && activeTipTrigger !== trigger) {
            activeTipTrigger.removeAttribute('aria-describedby');
        }
        activeTipTrigger = trigger;
        trigger.setAttribute('aria-describedby', entryTipEl.id);
        const tipBg = trigger.getAttribute('data-tip-bg') || '#0f172a';
        const tipFg = trigger.getAttribute('data-tip-fg') || '#ffffff';
        const tipBorder = trigger.getAttribute('data-tip-border') || tipBg;
        entryTipEl.textContent = label;
        entryTipEl.style.background = tipBg;
        entryTipEl.style.color = tipFg;
        entryTipEl.style.borderColor = tipBorder;
        entryTipEl.style.setProperty('--ts-tip-arrow', tipBg);
        entryTipEl.classList.toggle('is-details', trigger.getAttribute('data-tip-variant') === 'details');
        entryTipEl.hidden = false;
        const rect = trigger.getBoundingClientRect();
        let left = rect.left + (rect.width / 2);
        const tipWidth = entryTipEl.offsetWidth || 120;
        const pad = 10;
        left = Math.max(pad + tipWidth / 2, Math.min(left, window.innerWidth - pad - tipWidth / 2));
        entryTipEl.style.left = `${left}px`;
        entryTipEl.style.top = `${Math.max(8, rect.top)}px`;
        entryTipEl.classList.add('is-visible');
    };

    tbody.addEventListener('pointerover', (event) => {
        const trigger = event.target.closest('.ts-tooltip-trigger');
        if (!trigger || !tbody.contains(trigger)) return;
        showEntryTip(trigger);
    });
    tbody.addEventListener('pointerout', (event) => {
        const trigger = event.target.closest('.ts-tooltip-trigger');
        if (!trigger) return;
        const next = event.relatedTarget;
        if (next && trigger.contains(next)) return;
        hideEntryTip();
    });
    tbody.addEventListener('focusin', (event) => {
        const trigger = event.target.closest('.ts-tooltip-trigger');
        if (trigger) showEntryTip(trigger);
    });
    tbody.addEventListener('focusout', (event) => {
        const trigger = event.target.closest('.ts-tooltip-trigger');
        if (!trigger) return;
        const next = event.relatedTarget;
        if (next && trigger.contains(next)) return;
        hideEntryTip();
    });
    window.addEventListener('scroll', hideEntryTip, true);
    window.addEventListener('resize', hideEntryTip);

    function isIndividualManualActivityRow(entry = {}) {
        if (!entry || entry.isManual !== true) return false;
        const activityId = String(entry.activityId || '').trim();
        if (!activityId || String(entry.classId || '').trim()) return false;
        const scope = String(entry.visibilityScope || '').trim().toLowerCase();
        if (scope === 'individual') return true;
        if (scope === 'school') return false;
        const meta = manualActivityMap.get(activityId);
        return String(meta?.visibilityScope || '').trim().toLowerCase() === 'individual';
    }

    function createManualSessionId() {
        return 'MAN_' + Date.now() + '_' + Math.floor(Math.random() * 1000);
    }

    function listPeriodDatesExcluding(sourceDate) {
        const source = String(sourceDate || '').trim();
        return (Array.isArray(dates) ? dates : []).filter((dateStr) => String(dateStr || '').trim() && String(dateStr) !== source);
    }

    async function isCopyTargetDayEligible(sourceEntry, targetDate) {
        const hrs = Number(resolveRequestedHours(sourceEntry) || 0);
        if (!Number.isFinite(hrs) || hrs <= 0) return false;
        const existingHours = activeEntries
            .filter((row) => String(row?.date || '') === String(targetDate || ''))
            .reduce((sum, row) => sum + resolveRequestedHours(row), 0);
        if (existingHours + hrs > MAX_DAILY_HOURS) return false;

        const proposedRow = {
            sessionId: `MAN_COPY_PREVIEW_${Date.now()}_${Math.floor(Math.random() * 1000)}`,
            date: targetDate,
            activityId: String(sourceEntry.activityId || '').trim(),
            activityName: String(sourceEntry.activityName || '').trim(),
            activityEntryId: '',
            visibilityScope: 'individual',
            className: String(sourceEntry.className || sourceEntry.description || sourceEntry.activityName || '').trim(),
            description: String(sourceEntry.description || sourceEntry.className || '').trim(),
            startTime: String(sourceEntry.startTime || '').trim(),
            endTime: String(sourceEntry.endTime || '').trim(),
            personRole: String(sourceEntry.personRole || PAYROLL_DEFAULT_ROLE || 'teacher').trim(),
            durationHours: hrs,
            requestedHours: hrs,
            isManual: true
        };
        try {
            const response = await fetch(`/school/timesheets/editor/${encodeURIComponent(PERIOD_ID)}/api/validate-manual-row${buildMutationQuery()}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    proposed: proposedRow,
                    draftEntries: activeEntries,
                    timesheetEntries: activeEntries,
                    editSessionId: ''
                })
            });
            const result = await response.json().catch(() => ({}));
            if (!response.ok) return false;
            if (result.status === 'warning' || (Array.isArray(result.conflicts) && result.conflicts.length)) return false;
            return result.status === 'success';
        } catch (_error) {
            return false;
        }
    }

    function syncCopyManualConfirmButton() {
        const btn = document.getElementById('btnConfirmCopyManualRow');
        const checked = document.querySelectorAll('#copyManualDaysList input.js-copy-day:checked');
        if (btn) btn.disabled = !checked.length;
    }

    window.openCopyManualRowModal = async function(sessionId) {
        const source = activeEntries.find((row) => String(row?.sessionId || '') === String(sessionId || ''));
        if (!source || !isIndividualManualActivityRow(source)) {
            await messageBox({
                title: 'Copy Not Available',
                icon: 'warning',
                message: 'Only individual activity manual rows can be copied to other days.'
            });
            return;
        }

        const sourceDate = String(source.date || '').trim();
        const candidateDates = listPeriodDatesExcluding(sourceDate);
        const listEl = document.getElementById('copyManualDaysList');
        const emptyEl = document.getElementById('copyManualDaysEmpty');
        const summaryEl = document.getElementById('copyManualRowSummary');
        const confirmBtn = document.getElementById('btnConfirmCopyManualRow');
        document.getElementById('copyManualSourceSessionId').value = String(sessionId || '');
        if (listEl) listEl.innerHTML = '<div class="text-muted small">Checking eligible days…</div>';
        if (emptyEl) emptyEl.classList.add('d-none');
        if (confirmBtn) confirmBtn.disabled = true;
        if (summaryEl) {
            summaryEl.textContent = `Copy “${source.className || source.activityName || 'manual row'}” (${source.startTime || ''}–${source.endTime || ''}) to other days without conflicts.`;
        }

        const modalEl = document.getElementById('copyManualRowModal');
        const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
        modal.show();

        const loadingToken = showTimesheetWaitingModal({
            title: 'Checking days',
            note: 'Finding eligible days without conflicts…',
            operation: 'copy_manual_probe'
        });
        const eligible = [];
        try {
            for (const dateStr of candidateDates) {
                // eslint-disable-next-line no-await-in-loop
                const ok = await isCopyTargetDayEligible(source, dateStr);
                if (ok) eligible.push(dateStr);
            }
        } finally {
            hideTimesheetWaitingModal(loadingToken);
        }

        if (!listEl) return;
        if (!eligible.length) {
            listEl.innerHTML = '';
            if (emptyEl) emptyEl.classList.remove('d-none');
            if (confirmBtn) confirmBtn.disabled = true;
            return;
        }
        if (emptyEl) emptyEl.classList.add('d-none');
        listEl.innerHTML = eligible.map((dateStr) => {
            const { dayName } = dateKeyWeekday(dateStr);
            const hol = holidayMap.get(dateStr);
            const labelExtra = hol ? ` · Holiday` : '';
            return `<label class="form-check border rounded px-3 py-2 mb-0">
                <input class="form-check-input js-copy-day" type="checkbox" value="${escapeHtml(dateStr)}">
                <span class="form-check-label ms-1">${escapeHtml(dateStr)} <span class="text-muted">(${escapeHtml(dayName)}${labelExtra})</span></span>
            </label>`;
        }).join('');
        listEl.querySelectorAll('input.js-copy-day').forEach((input) => {
            input.addEventListener('change', syncCopyManualConfirmButton);
        });
        syncCopyManualConfirmButton();
    };

    document.getElementById('btnConfirmCopyManualRow')?.addEventListener('click', async () => {
        const sourceId = String(document.getElementById('copyManualSourceSessionId')?.value || '').trim();
        const source = activeEntries.find((row) => String(row?.sessionId || '') === sourceId);
        if (!source || !isIndividualManualActivityRow(source)) {
            await messageBox({ title: 'Copy Failed', icon: 'error', message: 'Source individual manual row was not found.' });
            return;
        }
        const selectedDates = Array.from(document.querySelectorAll('#copyManualDaysList input.js-copy-day:checked'))
            .map((input) => String(input.value || '').trim())
            .filter(Boolean);
        if (!selectedDates.length) {
            await messageBox({ title: 'Select Days', icon: 'warning', message: 'Select at least one eligible day to copy onto.' });
            return;
        }

        const hrs = Number(resolveRequestedHours(source) || 0);
        const paid = source.activityPaid === true;
        const approvalStatus = paid ? 'pending_approval' : 'unpaid';
        const excludeFromTotals = true;
        let copied = 0;
        for (const dateStr of selectedDates) {
            // Re-check eligibility in case the table changed while the modal was open.
            // eslint-disable-next-line no-await-in-loop
            const stillOk = await isCopyTargetDayEligible(source, dateStr);
            if (!stillOk) continue;
            activeEntries.push({
                sessionId: createManualSessionId(),
                date: dateStr,
                className: String(source.className || source.description || source.activityName || '').trim(),
                classId: null,
                activityId: String(source.activityId || '').trim(),
                activityName: String(source.activityName || '').trim(),
                activityEntryId: '',
                visibilityScope: 'individual',
                activityPaid: paid,
                approvalStatus,
                excludeFromTotals,
                startTime: String(source.startTime || '').trim(),
                endTime: String(source.endTime || '').trim(),
                deliveryDepartmentId: String(source.deliveryDepartmentId || '').trim(),
                deliveryDepartmentName: String(source.deliveryDepartmentName || '').trim(),
                categoryName: String(source.categoryName || '').trim(),
                description: String(source.description || source.className || '').trim(),
                personRole: String(source.personRole || PAYROLL_DEFAULT_ROLE || 'teacher').trim(),
                requestedHours: hrs,
                hours: 0,
                durationHours: hrs,
                timesheetHours: 0,
                status: approvalStatus === 'pending_approval' ? 'pending_approval' : 'manual',
                comment: String(source.comment || '').trim(),
                isManual: true
            });
            copied += 1;
        }

        bootstrap.Modal.getOrCreateInstance(document.getElementById('copyManualRowModal')).hide();
        if (!copied) {
            await messageBox({
                title: 'Nothing Copied',
                icon: 'warning',
                message: 'None of the selected days remained eligible. Please try again.'
            });
            return;
        }
        isEdited = true;
        document.getElementById('badge_manualEdit')?.classList.remove('d-none');
        renderTable();
        await messageBox({
            title: 'Rows Copied',
            icon: 'success',
            message: `Copied to ${copied} day${copied === 1 ? '' : 's'}. Save draft or submit when ready.`
        });
    });

