                    <% } %>
                    <span class="badge bg-<%= timesheetStatus === 'submitted' ? 'warning text-dark' : (timesheetStatus === 'processed' ? 'primary' : 'secondary') %> text-uppercase"><%= timesheetStatus %></span>
                    <% if (timesheetStatus === 'submitted' && managerReviewApproved) { %>
                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Manager Approved</span>
                    <% } %>
                    <% if (timesheetStatus === 'draft' && timesheet.returnReason) { %>
                        <span class="badge bg-warning text-dark"><i class="bi bi-reply-fill me-1"></i>Returned for Revision</span>
                    <% } %>
                    <span id="badge_manualEdit" class="badge bg-warning text-dark shadow-sm <%= isManuallyEdited ? '' : 'd-none' %>">
                        <i class="bi bi-pencil-square me-1"></i> Manually Edited
                    </span>
                </div>
                <div class="ts-meta-line">
                    <div class="ts-meta-card ts-meta-card--period">
                        <span class="ts-meta-card__icon" aria-hidden="true"><i class="bi bi-calendar-range"></i></span>
                        <span class="ts-meta-card__content">
                            <span class="ts-meta-card__label">Period</span>
                            <span class="ts-meta-card__value">
                                <time datetime="<%= period.startDate %>"><%= period.startDate %></time>
                                <i class="bi bi-arrow-right mx-1 text-muted" aria-hidden="true"></i>
                                <time datetime="<%= period.endDate %>"><%= period.endDate %></time>
                            </span>
                        </span>
                    </div>
                    <div class="ts-meta-card ts-meta-card--deadline">
                        <span class="ts-meta-card__icon" aria-hidden="true"><i class="bi bi-alarm"></i></span>
                        <span class="ts-meta-card__content">
                            <span class="ts-meta-card__label">Submission Deadline</span>
                            <time class="ts-meta-card__value" datetime="<%= deadlineDate === '-' ? '' : deadlineLabel %>"><%= deadlineLabel %></time>
                        </span>
                    </div>
                    <% if (viewingOther) { %>
                        <span class="ts-viewing-other-note text-info fw-semibold small"><i class="bi bi-person-badge me-1"></i>Viewing another person's timesheet</span>
                    <% } %>
                </div>
            </div>
        </div>
        <div class="ts-page-header__aside">
            <div
                id="tsDeadlineStatusChip"
                class="ts-deadline-chip"
                role="status"
                aria-live="polite"
                data-deadline-at="<%= typeof submissionDeadlineAt !== 'undefined' ? String(submissionDeadlineAt || '') : '' %>"
                data-status="<%= timesheetStatus %>"
                data-manager-approved="<%= managerReviewApproved ? 'true' : 'false' %>"
            ></div>
            <a href="/school/timesheets/my-timesheets" class="btn btn-outline-secondary btn-sm flex-shrink-0"><i class="bi bi-arrow-left"></i> Back</a>
        </div>
    </div>

    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap">
        <div class="d-flex align-items-center flex-wrap">
            <button
                type="button"
                id="btnPrintTimesheet"
                class="btn btn-filled btn-edit btn-md me-2 mb-2"
                <% if (!canPrintFlag) { %>disabled aria-disabled="true"<% } %>
                title="<%= canPrintFlag ? 'Print this timesheet' : 'EXPORT access is required to print this timesheet.' %>"
            >🖨 Print</button>
        </div>
    </div>

    <% const reviewHistoryRows = Array.isArray(reviewHistory) ? reviewHistory : []; %>
    <section class="ts-notice-hub" aria-label="Timesheet guidance and review information">
        <div class="ts-notice-grid">
            <% if (timesheetStatus === 'draft' && timesheet.returnReason) { %>
                <article class="ts-notice-tile ts-notice-tile--revision">
                    <span class="ts-notice-tile__icon" aria-hidden="true"><i class="bi bi-reply-fill"></i></span>
                    <div class="ts-notice-tile__content">
                        <div class="ts-notice-tile__eyebrow">Action required</div>
                        <h2 class="ts-notice-tile__title">Returned for Revision</h2>
                        <div class="ts-notice-tile__reason"><%= timesheet.returnReason %></div>
                    </div>
                </article>
            <% } %>

            <% if (pageIsReadOnly) { %>
                <article class="ts-notice-tile ts-notice-tile--locked">
                    <span class="ts-notice-tile__icon" aria-hidden="true"><i class="bi bi-lock-fill"></i></span>
                    <div class="ts-notice-tile__content">
                        <div class="ts-notice-tile__eyebrow">Editing unavailable</div>
                        <h2 class="ts-notice-tile__title">Timesheet Locked</h2>
                        <div class="ts-notice-tile__body">This timesheet is marked as <strong><%= timesheet.status.toUpperCase() %></strong> and cannot be modified.</div>
                    </div>
                </article>
            <% } else { %>
                <article class="ts-notice-tile ts-notice-tile--instructions">
                    <span class="ts-notice-tile__icon" aria-hidden="true"><i class="bi bi-info-circle-fill"></i></span>
                    <div class="ts-notice-tile__content">
                        <div class="ts-notice-tile__eyebrow">Before you submit</div>
                        <h2 class="ts-notice-tile__title">Instructions</h2>
                        <div class="ts-notice-tile__body">
                            Review auto-pulled sessions and add manual entries only when required.
                            <div class="mt-1">Sessions before the deadline window must be final. Later non-final sessions are included provisionally and reconciled in the next timesheet.</div>
                        </div>
                    </div>
                </article>
            <% } %>

            <% if (reviewHistoryRows.length) { %>
                <button type="button" class="ts-notice-tile ts-notice-tile--history collapsed" data-bs-toggle="collapse" data-bs-target="#timesheetReviewHistoryCollapse" aria-expanded="false" aria-controls="timesheetReviewHistoryCollapse" id="timesheetReviewHistoryToggle">
                    <span class="ts-notice-tile__icon" aria-hidden="true"><i class="bi bi-clock-history"></i></span>
                    <span class="ts-notice-tile__content">
                        <span class="ts-notice-tile__eyebrow d-block">Audit trail</span>
                        <span class="ts-notice-tile__title">
                            Review History
                            <span class="badge bg-secondary-subtle text-secondary-emphasis border"><%= reviewHistoryRows.length %></span>
                        </span>
                        <span class="ts-notice-tile__body d-block">Open submission, return, approval, and processing events.</span>
                    </span>
                    <i class="bi bi-chevron-down review-history-chevron ts-notice-tile__chevron" aria-hidden="true"></i>
                </button>
            <% } %>
        </div>

        <% if (reviewHistoryRows.length) { %>
            <div id="timesheetReviewHistoryPanel">
                <div id="timesheetReviewHistoryCollapse" class="collapse ts-review-history-panel">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">When</th>
                                        <th>Event</th>
                                        <th>By</th>
                                        <th>Status</th>
                                        <th class="text-end">Hours</th>
                                        <th class="pe-4">Note</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% reviewHistoryRows.slice().reverse().forEach((row) => { %>
                                        <tr>
                                            <td class="ps-4 small text-muted"><%= row.at ? (typeof formatOrgDateTime === 'function' ? formatOrgDateTime(row.at) : row.at) : '-' %></td>
                                            <td><span class="badge bg-light text-dark border text-uppercase"><%= row.event || '-' %></span></td>
                                            <td class="small"><%= row.byName || row.by || '-' %></td>
                                            <td class="small text-muted"><%= row.statusBefore ? row.statusBefore + ' → ' + (row.statusAfter || '-') : (row.statusAfter || '-') %></td>
                                            <td class="text-end small fw-semibold"><%= Number(row.totalHours || 0).toFixed(2) %></td>
                                            <td class="pe-4 small"><%= row.note || '-' %></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        <% } %>
    </section>

    <% if (typeof payrollWarnings !== 'undefined' && Array.isArray(payrollWarnings) && payrollWarnings.length) { %>
        <div class="alert alert-warning border-warning shadow-sm mb-4">
            <div class="fw-bold mb-1"><i class="bi bi-exclamation-triangle-fill me-1"></i> Payroll setup warnings</div>
            <ul class="small mb-0 ps-3">
                <% payrollWarnings.forEach((warning) => { %>
                    <li><%= warning %></li>
                <% }); %>
            </ul>
        </div>
    <% } %>

    <div id="provisionalSessionsSummary" class="ts-reconciliation-note mb-4 d-none" role="status" aria-live="polite"></div>

    <div id="incompleteSessionsPanel" class="card border-warning shadow-sm mb-4 d-none">
        <button type="button" class="card-header bg-warning-subtle border-warning d-flex align-items-center justify-content-between py-3 w-100 text-start collapsed" data-bs-toggle="collapse" data-bs-target="#incompleteSessionsCollapse" aria-expanded="false" aria-controls="incompleteSessionsCollapse" id="incompleteSessionsToggle">
            <div class="fw-bold text-warning-emphasis">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                Incomplete Sessions Detected
                <span class="badge bg-warning text-dark ms-2" id="incompleteSessionsCount">0</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="small text-muted d-none d-md-inline">Expand to review class and activity work sessions, then refresh this timesheet.</span>
                <i class="bi bi-chevron-down incomplete-sessions-chevron" aria-hidden="true"></i>
            </div>
        </button>
        <div id="incompleteSessionsCollapse" class="collapse">
            <div class="card-body p-0 border-top border-warning">
                <div class="table-responsive">
                    <table class="table table-bordered align-middle mb-0 incomplete-sessions-table">
                        <thead class="table-warning">
                            <tr>
                                <th class="ps-4" style="width: 140px;">Date</th>
                                <th>Class / Activity</th>
                                <th style="width: 160px;">Time</th>
                                <th style="width: 150px;">Status</th>
                                <th class="text-center pe-4" style="width: 170px;">Action</th>
                            </tr>
                        </thead>
                        <tbody id="incompleteSessionsBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0" id="tsTable">
                    <thead class="table-light border-bottom">
                        <tr>
                            <th class="ps-4" style="width: 140px;">Date</th>
                            <th>Class / Description</th>
                            <th style="width: 160px;">Student Name</th>
                            <th class="ts-col-hours-time">Hours / Time</th>
                            <th class="ts-col-status"><span class="ts-column-header-center">Status</span></th>
                            <th style="min-width: 220px;">Comment</th>
                            <% if (!isEditorLocked) { %><th class="ts-col-actions"><span class="ts-column-header-center">Act</span></th><% } %>
                        </tr>
                    </thead>
                    <tbody id="tsBody">
                    </tbody>
                    <tfoot class="table-light border-top border-3">
                        <tr>
                            <td colspan="3" class="text-end fw-bold text-uppercase">Total Period Hours:</td>
                            <td class="ts-col-hours-time"><span class="ts-hours-value" id="lbl_grandTotal">0.00</span> <span class="ts-hours-unit">hrs</span></td>
                            <td colspan="2"></td>
                            <% if (!isEditorLocked) { %><td></td><% } %>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4" id="tsDepartmentTotals">
        <div class="card-header bg-light border-bottom py-3">
            <div class="fw-bold"><i class="bi bi-diagram-3 me-2 text-primary"></i>Hours by Department</div>
            <div class="small text-muted mt-1">Optional Hours show the scheduled duration of Optional sessions and do not affect payroll totals.</div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Department</th>
                            <th class="text-end pe-4" style="width: 140px;">Session Hours</th>
                            <th class="text-end pe-4" style="width: 140px;">Pending Hours</th>
                            <th class="text-end pe-4" style="width: 140px;">Total</th>
                        </tr>
                    </thead>
                    <tbody id="tsDepartmentTotalsBody">
                        <tr>
                            <td colspan="4" class="text-center text-muted py-3">No department hours yet.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <% if (!isEditorLocked || adminCanApprove || adminCanReopen || financeCanProcess || financeCanUnprocess || canAllowLateSubmissionFlag) { %>
        <div class="d-flex justify-content-end gap-2 border-top pt-3 flex-wrap">
            <% if (!isEditorLocked) { %>
                <button class="btn btn-light border fw-bold px-4" id="btnSaveDraft"><%= isReviewerEditing ? 'Save Review Changes' : 'Save Draft' %></button>
                <% if (!isReviewerEditing) { %>
                    <button
                        class="btn <%= submitBlockedByDeadline ? 'btn-secondary' : 'btn-primary' %> fw-bold px-4"
                        id="btnSubmit"
                        <%= submitBlockedByDeadline ? 'disabled' : '' %>
                        title="<%= submitBlockedByDeadline ? 'Submission deadline has passed. A timesheet manager must allow late submission.' : '' %>"
                    ><%= submitBlockedByDeadline ? 'Deadline Passed' : 'Submit for Payroll' %></button>
                <% } %>
            <% } %>
            <% if (canAllowLateSubmissionFlag) { %>
                <button class="btn btn-outline-primary fw-bold px-4" id="btnAllowLateSubmission"><i class="bi bi-unlock me-1"></i> Allow Late Submission</button>
            <% } %>
            <% if (adminCanApprove) { %>
                <button class="btn btn-success fw-bold px-4" id="btnApproveTimesheet"><i class="bi bi-check-circle me-1"></i> Manager Approve</button>
            <% } %>
            <% if (adminCanReopen) { %>
                <button class="btn btn-warning fw-bold px-4" id="btnReopenTimesheet"><i class="bi bi-reply-fill me-1"></i> Send Back for Revision</button>
            <% } %>
            <% if (financeCanProcess) { %>
                <button class="btn btn-primary fw-bold px-4" id="btnProcessTimesheet"><i class="bi bi-lock-fill me-1"></i> Process Timesheet</button>
            <% } %>
            <% if (financeCanUnprocess) { %>
                <button class="btn btn-outline-warning fw-bold px-4" id="btnUnprocessTimesheet"><i class="bi bi-unlock-fill me-1"></i> Reopen to Manager Approved</button>
            <% } %>
        </div>
        <% if (submitBlockedByDeadline && !canAllowLateSubmissionFlag) { %>
            <div class="text-end small text-danger mt-2">Submission deadline has passed. Ask a timesheet manager to allow late submission.</div>
        <% } else if (submitBlockedByDeadline && canAllowLateSubmissionFlag) { %>
            <div class="text-end small text-muted mt-2">Deadline has passed. Allow late submission so the author can submit once.</div>
        <% } else if (allowLateSubmissionFlag && isSubmissionDeadlinePassedFlag && !isReviewerEditing && !isEditorLocked) { %>
            <div class="text-end small text-success mt-2">Late submission is allowed for one submit.</div>
        <% } %>
    <% } %>
</div>

<div class="modal fade" id="manualEntryModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-light">
        <h5 class="modal-title fw-bold" id="modalTitle"><i class="bi bi-plus-circle me-2 text-primary"></i>Add Manual Entry</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
          <input type="hidden" id="man_date">
          <input type="hidden" id="man_editSessionId">
          
          <div class="mb-3">
              <label class="form-label fw-bold small text-muted">Selected Date</label>
              <div class="d-flex align-items-stretch gap-2">
                  <div id="man_date_display" class="form-control bg-light fw-bold flex-grow-1"></div>
                  <button type="button" class="btn btn-outline-primary text-nowrap" id="btnViewDaySchedule" title="Open schedule for this day in a new tab">
                      <i class="bi bi-calendar-week"></i><span class="d-none d-sm-inline ms-1">View Day</span>
                  </button>
              </div>
          </div>
          
          <div class="mb-3">
              <label class="form-label fw-bold">Activity Type *</label>
              <select id="man_type" class="form-select" onchange="toggleManualType()" required>
                  <option value="" disabled selected>Select activity…</option>
                  <% (manualActivities || []).forEach((activity) => { %>
                    <option
                      value="<%= activity.id || '' %>"
                      data-name="<%= activity.name || activity.id || '' %>"
                      data-paid="<%= activity.paid ? 'true' : 'false' %>"
                      data-category="<%= activity.categoryName || '' %>"
                      data-department="<%= activity.departmentName || '' %>"
                      data-visibility-scope="<%= activity.visibilityScope || 'school' %>">
                      <%= activity.name || activity.id || 'Activity' %><%= activity.visibilityScope === 'individual' ? ' (individual)' : '' %>
                    </option>
                  <% }) %>
              </select>
              <div class="form-text">Public activities require picking an existing work session. Individual activities suggest a new work session for approval. Manual class sessions are temporarily disabled.</div>
          </div>

          <div class="mb-3 <%= (typeof payrollRoles !== 'undefined' && payrollRoles.length > 1) ? '' : 'd-none' %>" id="div_man_payrollRole">
              <label class="form-label fw-bold">Payroll Role *</label>
              <select id="man_personRole" class="form-select">
                  <% (payrollRoles || []).forEach((role) => { %>
                    <option value="<%= role %>"><%= String(role).charAt(0).toUpperCase() + String(role).slice(1) %></option>
                  <% }) %>
              </select>
              <div class="form-text">Choose whether this work should be paid under your teacher or staff profile.</div>
          </div>

          <div class="mb-3 d-none" id="div_man_classPicker">
              <label class="form-label fw-bold">Select Class *</label>
              <div class="input-group">
                  <input type="hidden" id="man_classId">
                  <input type="text" id="man_className" class="form-control bg-white" placeholder="Class manuals are frozen" readonly>
                  <button type="button" class="btn btn-outline-primary" id="btnPickClass" disabled><i class="bi bi-search"></i></button>
              </div>
              <div class="form-text text-warning" id="man_classFrozenNotice">Manual class sessions are temporarily disabled pending further processing.</div>
          </div>

          <div class="mb-3 d-none" id="div_man_workSessionPicker">
              <label class="form-label fw-bold">Work Session *</label>
              <div class="input-group">
                  <input type="hidden" id="man_activityEntryId">
                  <input type="text" id="man_activityEntryLabel" class="form-control bg-white" placeholder="Choose a work session..." readonly>
                  <button type="button" class="btn btn-outline-primary" id="btnPickWorkSession"><i class="bi bi-search"></i></button>
              </div>
              <div class="form-text">Required for public activities. Date and hours are taken from the selected work session.</div>
          </div>
          
          <div class="mb-3" id="div_man_desc">
              <label class="form-label fw-bold">Description *</label>
              <input type="text" id="man_desc" class="form-control" placeholder="e.g. Extra prep, admin work, meeting...">
          </div>

          <div class="row g-2 mb-3" id="div_man_timeRange">
              <div class="col-6">
                  <label class="form-label fw-bold">Start Time *</label>
                  <input type="time" id="man_startTime" class="form-control">
              </div>
              <div class="col-6">
                  <label class="form-label fw-bold">End Time *</label>
                  <input type="time" id="man_endTime" class="form-control">
              </div>
              <div class="col-12">
                  <div class="form-text">For class or activity rows, total hours are calculated from start/end time and applied to the materialized session.</div>
              </div>
          </div>

          <div class="mb-3">
              <label class="form-label fw-bold">Total Hours *</label>
              <input type="number" id="man_hours" class="form-control" step="0.25" min="0" max="<%= maxSessionHours %>" placeholder="e.g. 1.5" required>
              <div class="form-text text-danger" id="man_hours_warning"></div>
          </div>
          
          <div class="mb-3">
              <label class="form-label fw-bold">Notes / Comments</label>
              <input type="text" id="man_comment" class="form-control" placeholder="Reason for manual entry...">
          </div>
      </div>
      <div class="modal-footer bg-light border-0">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary fw-bold" id="btnSaveManualEntry">Save Entry</button>
      </div>
    </div>
  </div>
</div>

<%- include('partials/modal_GenericPicker') %>

<div class="modal fade" id="reopenTimesheetModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-warning-subtle border-0">
        <h5 class="modal-title fw-bold"><i class="bi bi-reply-fill me-2"></i>Send Back for Revision</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p class="small text-muted mb-3">The timesheet will return to <strong>Draft</strong> so the author can edit and submit it again. The note will be shown to the author.</p>
        <label class="form-label fw-bold" for="reopenTimesheetNote">Revision instructions *</label>
        <textarea id="reopenTimesheetNote" class="form-control" rows="4" maxlength="2000" placeholder="Explain what the person should change before resubmitting..." required></textarea>
        <div class="form-text">This note is stored in the review history.</div>
      </div>
      <div class="modal-footer bg-light border-0">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-warning fw-bold" id="btnConfirmReopenTimesheet">Send Back to Draft</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="unprocessTimesheetModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-warning-subtle border-0">
        <h5 class="modal-title fw-bold"><i class="bi bi-unlock-fill me-2"></i>Reopen to Manager Approved</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p class="small text-muted mb-3">This undoes finance processing: materialized manual rows are reverted and source locks are cleared. The timesheet returns to <strong>Submitted</strong> with <strong>Manager Approved</strong> intact so it can be corrected and processed again.</p>
        <label class="form-label fw-bold" for="unprocessTimesheetNote">Reason for reopen *</label>
        <textarea id="unprocessTimesheetNote" class="form-control" rows="4" maxlength="2000" placeholder="Explain why this processed timesheet is being unlocked..." required></textarea>
        <div class="form-text">This note is stored in the review history.</div>
      </div>
      <div class="modal-footer bg-light border-0">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-outline-warning fw-bold" id="btnConfirmUnprocessTimesheet">Reopen Timesheet</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="manualRowRejectModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-danger-subtle border-0">
        <h5 class="modal-title fw-bold"><i class="bi bi-x-circle me-2"></i>Reject Manual Row</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="manualRowRejectEntryId">
        <label class="form-label fw-bold" for="manualRowRejectNote">Rejection reason *</label>
        <textarea id="manualRowRejectNote" class="form-control" rows="4" maxlength="2000" placeholder="Explain why this paid manual row was rejected..." required></textarea>
      </div>
      <div class="modal-footer bg-light border-0">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger fw-bold" id="btnConfirmManualRowReject">Reject Row</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="copyManualRowModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
