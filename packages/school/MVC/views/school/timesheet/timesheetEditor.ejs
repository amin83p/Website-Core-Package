  const deadlineLabel = deadlineDate === '-' ? '-' : `${deadlineDate} ${deadlineTime}`;
  const personDisplayName = typeof personName !== 'undefined' ? String(personName || '').trim() : '';
  const timesheetStatus = currentTimesheetStatus;
  const viewingOther = typeof viewingOtherPerson !== 'undefined' && viewingOtherPerson;
  const canPrintFlag = typeof canPrintTimesheet !== 'undefined' && canPrintTimesheet === true;
  const printMode = typeof timesheetPrintMode !== 'undefined' ? String(timesheetPrintMode || '') : '';
  const printAction = printMode === 'management'
    ? '/school/timesheets/manage/print'
    : `/school/timesheets/editor/${encodeURIComponent(String(period.id || ''))}/print`;
