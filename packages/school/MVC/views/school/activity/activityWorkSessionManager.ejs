    margin-bottom: 0.35rem;
    line-height: 1.2;
  }
  .activity-work-session-page .session-info-tile-value {
    font-size: 1.02rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.35;
    word-break: break-word;
  }
  .activity-work-session-page .session-info-tile-value-sm {
    font-size: 0.92rem;
    font-weight: 600;
  }
  .activity-work-session-page .session-info-tile-muted {
    color: #94a3b8;
    font-weight: 600;
  }

  .activity-work-session-page .work-session-admin-metadata {
    border: 1px solid #dbe3ef;
    border-radius: 10px;
    background: #fff;
    padding: 0.85rem;
    margin-bottom: 0.85rem;
  }
  .activity-work-session-page .work-session-admin-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
  }
  .activity-work-session-page .ws-derived-hours {
    font-weight: 700;
  }
</style>

<div class="sections-page session-manager-page activity-work-session-page">
  <div class="session-manager-page-header">
    <div class="session-manager-page-header-main">
      <h1 class="page-heading size-md m-0 text-start"><i class="bi bi-journal-check me-2 text-primary"></i>Manage Work Session</h1>
      <div class="session-manager-page-meta">
        <div class="session-manager-page-meta-class">
          <span class="session-manager-page-meta-class-title" title="<%= activityRow.title || 'Activity' %>"><%= activityRow.title || 'Activity' %></span>
        </div>
        <div class="session-manager-page-meta-when">
          <span class="session-manager-page-meta-when-item" id="workSessionPageMetaDate"><i class="bi bi-calendar3" aria-hidden="true"></i><%= entryRow.date || '-' %></span>
          <span class="session-manager-page-meta-when-item" id="workSessionPageMetaTime"><i class="bi bi-clock" aria-hidden="true"></i><%= entryRow.startTime || '-' %>–<%= entryRow.endTime || '-' %></span>
          <span class="session-manager-page-meta-when-item"><i class="bi bi-ui-checks" aria-hidden="true"></i><%= evaluationTypeLabel %></span>
        </div>
      </div>
    </div>
    <div class="session-manager-page-header-actions">
      <a href="<%= dashboardHref %>" class="school-navigator-dashboard btn btn-filled btn-secondary btn-md">
        <i class="bi bi-speedometer2 me-1"></i>Dashboard
      </a>
    </div>
  </div>

  <div class="session-manager-toolbar-row">
    <div class="session-manager-toolbar-actions">
      <div class="btn-group shadow-sm">
      <% if (prevSession && prevSession.manageUrl) { %>
        <a href="<%= prevSession.manageUrl %>" class="btn btn-outline-primary bg-grey btn-md" title="Previous work session"><i class="bi bi-chevron-left"></i></a>
      <% } else { %>
        <button type="button" class="btn btn-outline-secondary bg-light btn-md" disabled><i class="bi bi-chevron-left"></i></button>
      <% } %>
      <% if (nextSession && nextSession.manageUrl) { %>
        <a href="<%= nextSession.manageUrl %>" class="btn btn-outline-primary bg-grey btn-md" title="Next work session"><i class="bi bi-chevron-right"></i></a>
      <% } else { %>
        <button type="button" class="btn btn-outline-secondary bg-light btn-md" disabled><i class="bi bi-chevron-right"></i></button>
      <% } %>
    </div>
    <% if (canEditWorkSessionMetadata || editableAssigneeRows.length) { %>
      <button type="button" class="btn btn-primary btn-md btn-filled btn-save-session shadow-md" id="btnSaveWorkSession">
        <i class="bi bi-save me-1"></i>Save session
      </button>
    <% } %>
    <button type="button" class="btn btn-warning btn-md btn-filled btn-close-session" id="btnCloseWorkSessionManager"><i class="bi bi-x-lg me-1"></i>Close</button>
    </div>
  </div>

  <div class="card session-manager-info-card shadow-sm mb-3">
    <div class="session-info-header">
      <div
        class="session-info-details-toggle"
        id="btnToggleWorkSessionInfoDetails"
        role="button"
        tabindex="0"
        data-bs-toggle="collapse"
        data-bs-target="#workSessionInfoDetailsCollapse"
        aria-expanded="false"
        aria-controls="workSessionInfoDetailsCollapse">
        <div class="session-info-summary">
          <span class="session-info-summary-class text-muted">Session details</span>
        </div>
        <span class="session-info-expand-meta">
          <span class="session-info-expand-label">Details</span>
          <i class="bi bi-chevron-down session-info-expand-chevron" aria-hidden="true"></i>
        </span>
      </div>
      <div class="session-info-status-slot<%= workSessionStatusActionRequired ? '' : ' is-complete' %>" id="workSessionStatusSlot">
        <div class="session-info-status-slot-label">
          <span>Session status</span>
          <% if (workSessionStatusActionRequired) { %>
            <span class="badge bg-warning text-dark session-status-required-badge">Required</span>
          <% } %>
        </div>
        <button
          type="button"
          id="workSessionStatusButton"
          class="btn session-status-button<%= workSessionStatusActionRequired ? ' session-status-button--action-required' : '' %>"
          <%= (isCompletion && workSessionStatusActionRequired && pendingCompletionRows.length) ? '' : 'disabled' %>
          style="<%= !workSessionStatusActionRequired ? 'background-color:#d1e7dd;color:#0f5132;border-color:#badbcc;' : '' %>">
          <span id="workSessionStatusButtonLabel"><%= workSessionStatusLabel %></span>
          <i class="bi bi-pencil-square" aria-hidden="true"></i>
        </button>
      </div>
    </div>
    <div class="collapse" id="workSessionInfoDetailsCollapse">
      <div class="session-info-details-body">
        <% if (canEditWorkSessionMetadata) { %>
          <form method="POST" action="<%= manageUrl %>/metadata" id="frmWorkSessionMetadata" class="work-session-admin-metadata">
            <input type="hidden" name="actionStateId" value="<%= actionStateId || '' %>">
            <input type="hidden" name="assignees" id="workSessionMetadataAssignees" value="">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label fw-bold small" for="workSessionTitleInput">Title</label>
                <input type="text" class="form-control" id="workSessionTitleInput" name="title" maxlength="180" value="<%= entryRow.title || '' %>">
              </div>
              <div class="col-md-3">
                <label class="form-label fw-bold small" for="workSessionStatusInput">Status</label>
                <select class="form-select" id="workSessionStatusInput" name="status">
                  <option value="posted" <%= String(entryRow.status || 'posted').toLowerCase() === 'posted' ? 'selected' : '' %>>Posted</option>
                  <option value="cancelled" <%= String(entryRow.status || '').toLowerCase() === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                </select>
              </div>
              <div class="col-md-3">
                <label class="form-label fw-bold small" for="workSessionLocationInput">Location</label>
                <input type="text" class="form-control" id="workSessionLocationInput" name="location" maxlength="180" value="<%= entryRow.location || activityRow.location || '' %>">
              </div>
              <div class="col-md-3">
                <label class="form-label fw-bold small" for="workSessionDateInput">Date</label>
                <input type="date" class="form-control" id="workSessionDateInput" name="date" value="<%= entryRow.date || '' %>">
              </div>
              <div class="col-md-3">
                <label class="form-label fw-bold small" for="workSessionStartInput">Start Time</label>
                <input type="time" class="form-control js-work-session-time-input" id="workSessionStartInput" name="startTime" value="<%= entryRow.startTime || '' %>">
              </div>
              <div class="col-md-3">
                <label class="form-label fw-bold small" for="workSessionEndInput">End Time</label>
                <input type="time" class="form-control js-work-session-time-input" id="workSessionEndInput" name="endTime" value="<%= entryRow.endTime || '' %>">
              </div>
              <div class="col-md-3">
                <label class="form-label fw-bold small">Hour</label>
                <div class="form-control-plaintext ws-derived-hours" id="workSessionDerivedHours"><%= workSessionDurationLabel %> h</div>
              </div>
            </div>
          </form>
        <% } %>
        <div class="session-info-meta-grid">
          <div class="session-info-tile">
            <div class="session-info-tile-label">Assignees</div>
            <div class="session-info-tile-value session-info-tile-value-sm"><%= assigneeRows.length %> total · <%= readyCount %> ready for timesheet</div>
          </div>
          <div class="session-info-tile">
            <div class="session-info-tile-label">Payable</div>
            <div class="session-info-tile-value session-info-tile-value-sm"><%= activityRow.paid ? 'Yes' : 'No' %></div>
          </div>
        </div>
        <% if (entryRow.notes || activityRow.notes) { %>
          <div class="session-info-tile mt-2">
            <div class="session-info-tile-label">Notes</div>
            <div class="session-info-tile-value session-info-tile-value-sm"><%= entryRow.notes || activityRow.notes %></div>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <form method="POST" action="<%= manageUrl %>/complete" id="frmCompleteWorkSessionStatus" class="d-none">
    <input type="hidden" name="actionStateId" value="<%= actionStateId || '' %>">
    <input type="hidden" name="personId" id="completeWorkSessionPersonId" value="">
    <input type="hidden" name="status" id="completeWorkSessionStatus" value="attended">
    <input type="hidden" name="paidHours" id="completeWorkSessionPaidHours" value="<%= Number(entryRow.durationHours || 0).toFixed(2) %>">
    <input type="hidden" name="notes" id="completeWorkSessionNotes" value="">
  </form>

  <div class="session-manager-shell" id="workSessionManagerShell">
    <aside class="session-manager-sidebar" id="workSessionManagerSidebar" aria-label="Work session sections">
      <div class="session-manager-sidebar-head w-100">
        <span class="session-manager-nav-label small fw-bold text-secondary text-uppercase" style="letter-spacing:0.06em;">Sections</span>
        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill" id="btnToggleWorkSessionSidebar" title="Collapse sidebar" aria-expanded="true" aria-controls="workSessionManagerSidebar">
          <i class="bi bi-layout-sidebar-inset" id="workSessionSidebarToggleIcon"></i>
        </button>
      </div>
      <nav class="session-manager-sidebar-nav" role="tablist">
        <button type="button" class="session-manager-nav-item active" data-work-panel="session-detail" role="tab" aria-selected="true">
          <i class="bi bi-journal-text fs-5"></i><span class="session-manager-nav-label">Session Detail</span>
        </button>
      </nav>
    </aside>

    <main class="session-manager-main">
      <div class="session-panel active" id="work-panel-session-detail" role="tabpanel">
        <div class="row g-2 mb-3">
          <div class="col-6 col-md">
            <div class="session-summary-card h-100">
              <div class="session-summary-label">Assignees</div>
              <div class="session-summary-value"><%= visibleRows.length %></div>
            </div>
          </div>
          <div class="col-6 col-md">
            <div class="session-summary-card h-100">
              <div class="session-summary-label">Ready for timesheet</div>
              <div class="session-summary-value text-success"><%= readyCount %></div>
            </div>
          </div>
          <div class="col-6 col-md">
            <div class="session-summary-card h-100">
              <div class="session-summary-label"><%= isCompletion ? 'Completed' : 'Attended' %></div>
              <div class="session-summary-value <%= isCompletion ? 'text-primary' : 'text-success' %>"><%= isCompletion ? completionDoneCount : attendanceAttendedCount %></div>
            </div>
          </div>
          <% if (lockedCount > 0) { %>
            <div class="col-6 col-md">
              <div class="session-summary-card h-100">
                <div class="session-summary-label">Locked</div>
                <div class="session-summary-value text-secondary"><%= lockedCount %></div>
              </div>
            </div>
          <% } %>
        </div>

        <% if (evaluationTypeLocked) { %>
          <div class="alert alert-warning border-warning shadow-sm mb-3">
            <div class="fw-semibold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Evaluation type is locked</div>
            <div class="small mt-1">One or more assignee rows are tied to approved timesheets.</div>
          </div>
        <% } %>

        <% if (canEditWorkSessionMetadata) { %>
          <div class="work-session-admin-actions mb-3">
            <button type="button" class="btn btn-outline-primary btn-sm" id="btnAddWorkSessionAssignee">
              <i class="bi bi-person-plus me-1"></i>Add person
            </button>
          </div>
        <% } %>

        <div class="card border-0 shadow-sm mb-3" id="workSessionAssigneeStep">
          <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-start flex-wrap gap-2">
            <div>
              <h5 class="m-0 fw-bold text-primary"><i class="bi bi-people-fill me-2"></i>Assignees</h5>
              <div class="small text-muted mt-1"><%= isCompletion ? 'Set completion status per assignee, then save or use session status to complete.' : 'Set attendance per assignee, then use Save session.' %></div>
            </div>
            <% if (!isCompletion && editableAssigneeRows.length) { %>
              <div class="btn-group btn-group-sm" role="group" aria-label="Bulk attendance">
                <button type="button" class="btn btn-outline-success" id="btnWsAllAttended">All Attended</button>
                <button type="button" class="btn btn-outline-info" id="btnWsAllExcused">All Excused</button>
                <button type="button" class="btn btn-outline-danger" id="btnWsAllAbsent">All Absent</button>
                <button type="button" class="btn btn-outline-dark" id="btnWsResetAttendance" title="Reset attendance to attended">Reset</button>
              </div>
            <% } %>
          </div>
          <div class="card-body p-0">
            <div class="table-responsive" style="max-height: min(70vh, 700px); overflow-y: auto;">
              <table class="table table-hover align-middle mb-0" id="workSessionAssigneeTable">
                <thead class="table-light position-sticky top-0" style="z-index: 1;">
                  <tr>
                    <th class="attendance-order-col ps-3">#</th>
                    <th class="ps-2">Person</th>
                    <th class="ws-role-col">Role</th>
                    <% if (canEditWorkSessionMetadata && activityRow.paid) { %><th class="ws-payable-col">Payable</th><% } %>
                    <th class="text-end">Hours</th>
                    <th class="ws-status-col">Status</th>
                    <th class="ws-notes-col">Notes</th>
                  </tr>
                </thead>
                <tbody id="workSessionAssigneeTableBody">
                  <% let visibleAssigneeIndex = 0;
                  assigneeRows.forEach((assignee, idx) => {
                    const rowVisible = canManageAll || assignee.isSelf;
                    if (!rowVisible && !canManageAll) return;
                    visibleAssigneeIndex += 1;
                    const rowEditable = assignee.editable && (canManageAll || assignee.isSelf);
                    const isAssigneeCompleted = String(assignee.completionStatus || '').toLowerCase() === 'completed';
                    const assigneeRole = String(assignee.role || 'participant').toLowerCase();
                    const assigneeRoles = Array.from(new Set((Array.isArray(assignee.roles) && assignee.roles.length ? assignee.roles : [assigneeRole])
                      .map((role) => normalizeRoleForView(role))
                      .filter(Boolean)));
                    if (!assigneeRoles.includes(assigneeRole)) assigneeRoles.unshift(assigneeRole);
                    const rowKey = String(assignee.personId || ('row_' + idx)).replace(/[^A-Za-z0-9_-]/g, '_') + '_' + String(idx);
                    const rowDisabled = !rowEditable || assignee.locked;
                    const assigneeInfoTitle = buildAssigneeInfoTitle(assignee);
                  %>
                    <tr
                      class="roster-row work-session-assignee-form<%= assignee.locked ? ' is-locked' : '' %>"
                      data-personid="<%= assignee.personId %>"
                      data-person-id="<%= assignee.personId %>"
                      data-person-name="<%= assignee.personName || assignee.personId %>"
                      data-locked="<%= assignee.locked ? 'true' : 'false' %>"
                      data-role="<%= assigneeRole %>"
                      data-roles="<%= assigneeRoles.join(',') %>"
                      data-status="<%= String(assignee.status || 'attended').toLowerCase() %>"
                      data-paid="<%= assignee.paid !== false ? 'true' : 'false' %>"
                      data-notes="<%= assignee.notes || '' %>"
                      data-completion-status="<%= String(assignee.completionStatus || 'pending').toLowerCase() %>"
                      data-completed-at="<%= assignee.completedAt || '' %>"
                      data-ready-for-timesheet="<%= assignee.readyForTimesheet ? 'true' : 'false' %>">
                      <td class="attendance-order-cell text-muted small ps-3 align-middle">
                        <div class="attendance-order-stack">
                          <div class="attendance-order-head">
                            <span class="attendance-order-num"><%= visibleAssigneeIndex %></span>
                            <button
                              type="button"
                              class="btn btn-link btn-sm p-0 ws-assignee-info-btn"
                              data-bs-toggle="tooltip"
                              data-bs-placement="right"
                              title="<%= assigneeInfoTitle %>"
                              aria-label="<%= assigneeInfoTitle %>">
                              <i class="bi bi-info-circle text-primary"></i>
                            </button>
                          </div>
                          <% if (canEditWorkSessionMetadata && !assignee.locked) { %>
                            <button type="button" class="btn btn-outline-danger btn-sm py-0 px-1 js-remove-work-assignee" data-person-id="<%= assignee.personId %>" title="Remove person"><i class="bi bi-trash"></i></button>
                          <% } %>
                        </div>
                      </td>
                      <td class="ps-2 align-middle ws-person-col">
                        <div class="ws-person-name-line">
                          <span class="ws-person-name"><%= assignee.personName || assignee.personId %></span>
                          <span class="ws-person-id"><%= assignee.personId %></span>
                        </div>
                        <% if (isCompletion && rowEditable && !assignee.locked && isAssigneeCompleted) { %>
                          <form method="POST" action="<%= manageUrl %>/pending" class="mt-2 ws-assignee-pending-form" data-person-id="<%= assignee.personId %>">
                            <input type="hidden" name="actionStateId" value="<%= actionStateId || '' %>">
                            <input type="hidden" name="personId" value="<%= assignee.personId %>">
                            <input type="hidden" name="status" value="<%= assignee.status || 'attended' %>" class="ws-status-<%= assignee.personId %>" data-person-id="<%= assignee.personId %>">
                            <input type="hidden" name="paidHours" value="<%= Number(assignee.paidHours || entryRow.durationHours || 0).toFixed(2) %>" class="ws-paid-hours-<%= assignee.personId %>" data-person-id="<%= assignee.personId %>">
                            <input type="hidden" name="notes" value="<%= assignee.notes || '' %>" class="ws-notes-<%= assignee.personId %>" data-person-id="<%= assignee.personId %>">
                            <button type="submit" class="btn btn-outline-warning btn-sm btn-ws-pending py-0" data-person-id="<%= assignee.personId %>" data-person-name="<%= assignee.personName || assignee.personId %>">
                              <i class="bi bi-arrow-counterclockwise me-1"></i>Pending
                            </button>
                          </form>
                        <% } %>
                      </td>
                      <td class="ws-role-col align-middle">
                        <% if (canEditWorkSessionMetadata && rowEditable && !assignee.locked) { %>
                          <div class="btn-group-vertical btn-group-sm ws-role-radio-group" role="group" aria-label="Role for <%= assignee.personName || assignee.personId %>" data-roles="<%= assigneeRoles.join(',') %>">
                            <% assigneeRoles.forEach((role) => { %>
                              <input type="radio" class="btn-check ws-role-radio" id="role_<%= rowKey %>_<%= role %>" name="role_<%= rowKey %>" value="<%= role %>" data-person-id="<%= assignee.personId %>" <%= role === assigneeRole ? 'checked' : '' %>>
                              <label class="btn ws-role-label" for="role_<%= rowKey %>_<%= role %>"><%= roleLabelForView(role) %></label>
                            <% }) %>
                          </div>
                        <% } else { %>
                          <span class="badge bg-light text-dark border"><%= roleLabelForView(assignee.role || 'participant') %></span>
                        <% } %>
                      </td>
                      <% if (canEditWorkSessionMetadata && activityRow.paid) { %>
                        <td class="align-middle ws-payable-col">
                          <% if (rowEditable && !assignee.locked) { %>
                            <div class="form-check form-switch mb-0 d-inline-flex justify-content-center">
                              <input class="form-check-input ws-paid-input" type="checkbox" id="paid_<%= rowKey %>" data-person-id="<%= assignee.personId %>" aria-label="Payable for <%= assignee.personName || assignee.personId %>" <%= assignee.paid !== false ? 'checked' : '' %>>
                            </div>
                          <% } else { %>
                            <span class="small"><%= assignee.paid !== false ? 'Yes' : 'No' %></span>
                          <% } %>
                        </td>
                      <% } %>
                      <td class="text-end align-middle">
                        <span class="fw-semibold ws-derived-hours" data-person-id="<%= assignee.personId %>"><%= Number(entryRow.durationHours || 0).toFixed(2) %> h</span>
                      </td>
                      <td class="ws-status-col align-middle pe-2">
                        <% if (!isCompletion && rowEditable && !assignee.locked) { %>
                          <div class="btn-group btn-group-sm flex-wrap" role="group" aria-label="Attendance status for <%= assignee.personName || assignee.personId %>">
                            <input type="radio" class="btn-check ws-att-radio" data-person-id="<%= assignee.personId %>" name="att_<%= rowKey %>" id="attended_<%= rowKey %>" value="attended" <%= String(assignee.status || 'attended') === 'attended' ? 'checked' : '' %>>
                            <label class="btn att-label" for="attended_<%= rowKey %>" title="Attended"><i class="bi bi-check-lg me-1"></i>Attended</label>
                            <input type="radio" class="btn-check ws-att-radio" data-person-id="<%= assignee.personId %>" name="att_<%= rowKey %>" id="excused_<%= rowKey %>" value="excused" <%= String(assignee.status || '') === 'excused' ? 'checked' : '' %>>
                            <label class="btn att-label" for="excused_<%= rowKey %>" title="Excused"><i class="bi bi-envelope-paper me-1"></i>Excused</label>
                            <input type="radio" class="btn-check ws-att-radio" data-person-id="<%= assignee.personId %>" name="att_<%= rowKey %>" id="absent_<%= rowKey %>" value="absent" <%= String(assignee.status || '') === 'absent' ? 'checked' : '' %>>
                            <label class="btn att-label" for="absent_<%= rowKey %>" title="Absent"><i class="bi bi-x-lg me-1"></i>Absent</label>
                          </div>
                        <% } else if (isCompletion && canEditWorkSessionMetadata && rowEditable && !assignee.locked) { %>
                          <div class="btn-group-vertical btn-group-sm ws-completion-radio-group" role="group" aria-label="Completion status for <%= assignee.personName || assignee.personId %>">
                            <input type="radio" class="btn-check ws-completion-radio" data-person-id="<%= assignee.personId %>" name="completion_<%= rowKey %>" id="pending_<%= rowKey %>" value="pending" <%= isAssigneeCompleted ? '' : 'checked' %>>
                            <label class="btn ws-completion-label" for="pending_<%= rowKey %>">Pending</label>
                            <input type="radio" class="btn-check ws-completion-radio" data-person-id="<%= assignee.personId %>" name="completion_<%= rowKey %>" id="completed_<%= rowKey %>" value="completed" <%= isAssigneeCompleted ? 'checked' : '' %>>
                            <label class="btn ws-completion-label" for="completed_<%= rowKey %>">Completed</label>
                          </div>
                        <% } else { %>
                          <span class="badge bg-light text-dark border"><%= isCompletion ? (isAssigneeCompleted ? 'completed' : 'pending') : (assignee.status || 'pending') %></span>
                          <% if (isCompletion && rowEditable && !isAssigneeCompleted) { %>
                            <div class="form-text small text-muted mt-1">Use session status to complete.</div>
                          <% } %>
                        <% } %>
                      </td>
                      <td class="ws-notes-col align-middle">
                        <% if (rowEditable && !assignee.locked) { %>
                          <textarea class="form-control form-control-sm ws-notes-input" id="notes_<%= rowKey %>" data-person-id="<%= assignee.personId %>" rows="2" maxlength="500" placeholder="Notes"><%= assignee.notes || '' %></textarea>
                        <% } else { %>
                          <span class="small text-muted"><%= assignee.notes || '—' %></span>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                  <% if (!assigneeRows.length || visibleAssigneeIndex === 0) { %>
                    <tr><td colspan="<%= (canEditWorkSessionMetadata && activityRow.paid) ? 7 : 6 %>" class="text-center py-4 text-muted">No assignees on this work session.</td></tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <div id="workSessionAssigneeHiddenForms" class="d-none">
          <% assigneeRows.forEach((assignee, idx) => {
            const rowVisible = canManageAll || assignee.isSelf;
            if (!rowVisible && !canManageAll) return;
            const rowEditable = assignee.editable && (canManageAll || assignee.isSelf);
            const rowKey = String(assignee.personId || ('row_' + idx)).replace(/[^A-Za-z0-9_-]/g, '_') + '_' + String(idx);
          %>
            <% if (activityRow.paid) { %>
              <input type="hidden" class="ws-paid-hours-input" id="paidHours_<%= rowKey %>" data-person-id="<%= assignee.personId %>" value="<%= Number(entryRow.durationHours || 0).toFixed(2) %>">
            <% } %>
            <% if (rowEditable) { %>
              <form method="POST" action="<%= manageUrl %>/save" class="ws-assignee-save-form" data-person-id="<%= assignee.personId %>">
                <input type="hidden" name="actionStateId" value="<%= actionStateId || '' %>">
                <input type="hidden" name="personId" value="<%= assignee.personId %>">
                <input type="hidden" name="status" value="<%= assignee.status || 'attended' %>" class="ws-status-<%= assignee.personId %>" data-person-id="<%= assignee.personId %>">
                <input type="hidden" name="paidHours" value="<%= Number(assignee.paidHours || entryRow.durationHours || 0).toFixed(2) %>" class="ws-paid-hours-<%= assignee.personId %>" data-person-id="<%= assignee.personId %>">
                <input type="hidden" name="notes" value="<%= assignee.notes || '' %>" class="ws-notes-<%= assignee.personId %>" data-person-id="<%= assignee.personId %>">
              </form>
            <% } %>
          <% }) %>
        </div>
      </div>
    </main>
  </div>

  <% if (!canManageAll && assigneeRows.every((row) => !row.isSelf)) { %>
    <div class="alert alert-warning mt-3 border-warning shadow-sm">
      <div class="fw-semibold"><i class="bi bi-exclamation-circle me-1"></i>Not assigned</div>
      <div class="small mt-1">You are not assigned to this work session.</div>
    </div>
  <% } %>
</div>

<%- include('partials/modal') %>
<%- include('partials/modal_GenericPicker') %>

<script type="application/json" id="workSessionPageData"><%- JSON.stringify({
  eligibleAssigneePersons: Array.isArray(eligibleAssigneePersons) ? eligibleAssigneePersons : [],
  visibilityScope: visibilityScope || 'school'
}) %></script>

<script>
  (function () {
    const pageData = JSON.parse(document.getElementById('workSessionPageData').textContent || '{}');
    const eligibleAssigneePersons = Array.isArray(pageData.eligibleAssigneePersons) ? pageData.eligibleAssigneePersons : [];
    const visibilityScope = String(pageData.visibilityScope || 'school').trim().toLowerCase();
    const fallbackCloseHref = "<%= overviewManageUrl %>";
    const isCompletionMode = <%= isCompletion ? 'true' : 'false' %>;
    const canManageAllWorkSession = <%= canEditWorkSessionMetadata ? 'true' : 'false' %>;
    const activityPaid = <%= activityRow.paid ? 'true' : 'false' %>;
    let dynamicAssigneeIndex = 0;

    function resolveMessageModalFn() {
      if (typeof showMessageModal === 'function') return showMessageModal;
      if (typeof window !== 'undefined' && typeof window.showMessageModal === 'function') return window.showMessageModal;
      return null;
    }

    function resolveMessageBoxFn() {
      if (typeof messageBox === 'function') return messageBox;
      if (typeof window !== 'undefined' && typeof window.messageBox === 'function') return window.messageBox;
      return null;
    }

    async function showUiMessage(options) {
      try {
        const showMessageModalFn = resolveMessageModalFn();
        if (showMessageModalFn) return await showMessageModalFn(options || {});
        const messageBoxFn = resolveMessageBoxFn();
        if (messageBoxFn) return await messageBoxFn(options || {});
      } catch (error) { /* ignore and fall back */ }
      window.alert((options && options.message) ? options.message : 'Done');
      return false;
    }

    function escapeSelectorValue(value) {
      const text = String(value || '');
      if (window.CSS && typeof window.CSS.escape === 'function') return window.CSS.escape(text);
      return text.replace(/["\\]/g, '\\$&');
    }

    function escapeHtml(value) {
      return String(value === undefined || value === null ? '' : value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function calculateDurationHours(startTime, endTime) {
      if (!startTime || !endTime) return 0;
      const startParts = String(startTime).split(':').map(Number);
      const endParts = String(endTime).split(':').map(Number);
      if (startParts.length < 2 || endParts.length < 2) return 0;
      const start = (startParts[0] * 60) + startParts[1];
      const end = (endParts[0] * 60) + endParts[1];
      if (!Number.isFinite(start) || !Number.isFinite(end) || end <= start) return 0;
      return Number(((end - start) / 60).toFixed(2));
    }

    function normalizeRole(value) {
      return String(value || '').trim().toLowerCase().replace(/^school_/, '');
    }

    function normalizeRoleList(value) {
      const source = Array.isArray(value) ? value : String(value || '').split(',');
      const roles = [];
      source.forEach(function (item) {
        const role = normalizeRole(typeof item === 'string' ? item : (item?.key || item?.role || item?.name || item?.label));
        if (role && !roles.includes(role)) roles.push(role);
      });
      return roles;
    }

    function roleLabel(role) {
      const normalized = normalizeRole(role);
      if (normalized === 'teacher') return 'Teacher';
      if (normalized === 'staff') return 'Staff';
      if (normalized === 'student') return 'Student';
      return normalized ? normalized.charAt(0).toUpperCase() + normalized.slice(1) : 'Participant';
    }

    function pickDefaultRole(roles, preferred) {
      const normalizedRoles = normalizeRoleList(roles);
      const preferredRole = normalizeRole(preferred);
      if (preferredRole && normalizedRoles.includes(preferredRole)) return preferredRole;
      if (normalizedRoles.includes('teacher')) return 'teacher';
      if (normalizedRoles.includes('staff')) return 'staff';
      if (normalizedRoles.includes('student')) return 'student';
      return normalizedRoles[0] || preferredRole || 'participant';
    }

    const eligibleRolesByPersonId = new Map(
      eligibleAssigneePersons.map(function (person) {
        const personId = String(person?.personId || person?.id || '').trim();
        return [personId, normalizeRoleList(person?.roles || person?.matchedRole || person?.role)];
      }).filter(function (entry) { return entry[0]; })
    );

    function resolveAssigneeRoleList(item, personId) {
      const token = String(personId || item?.personId || item?.id || '').trim();
      const merged = [];
      [
        item?.roles,
        item?.availableRoles,
        item?.matchedRole,
        item?.role,
        token ? eligibleRolesByPersonId.get(token) : null
      ].forEach(function (source) {
        normalizeRoleList(source).forEach(function (role) {
          if (role && !merged.includes(role)) merged.push(role);
        });
      });
      return merged;
    }

    function buildRoleRadios(rowKey, personId, roles, selectedRole) {
      const safePersonId = escapeHtml(personId);
      const normalizedRoles = normalizeRoleList(roles);
      const selected = pickDefaultRole(normalizedRoles, selectedRole);
      const options = normalizedRoles.includes(selected) ? normalizedRoles : [selected].concat(normalizedRoles);
      return options.map((role) => {
        const safeRole = escapeHtml(role);
        const inputId = 'role_' + rowKey + '_' + safeRole;
        return [
          '<input type="radio" class="btn-check ws-role-radio" id="' + inputId + '" name="role_' + rowKey + '" value="' + safeRole + '" data-person-id="' + safePersonId + '"' + (role === selected ? ' checked' : '') + '>',
          '<label class="btn ws-role-label" for="' + inputId + '">' + escapeHtml(roleLabel(role)) + '</label>'
        ].join('');
      }).join('');
    }

    function buildCompletionRadios(rowKey, personId, selected) {
      const safePersonId = escapeHtml(personId);
      const normalized = String(selected || 'pending').toLowerCase() === 'completed' ? 'completed' : 'pending';
      return [
        '<input type="radio" class="btn-check ws-completion-radio" data-person-id="' + safePersonId + '" name="completion_' + rowKey + '" id="pending_' + rowKey + '" value="pending"' + (normalized === 'pending' ? ' checked' : '') + '>',
        '<label class="btn ws-completion-label" for="pending_' + rowKey + '">Pending</label>',
        '<input type="radio" class="btn-check ws-completion-radio" data-person-id="' + safePersonId + '" name="completion_' + rowKey + '" id="completed_' + rowKey + '" value="completed"' + (normalized === 'completed' ? ' checked' : '') + '>',
        '<label class="btn ws-completion-label" for="completed_' + rowKey + '">Completed</label>'
      ].join('');
    }

    function buildAssigneeInfoTitleFromRow(row) {
      if (!row) return '';
      const parts = [];
      const completion = String(row.getAttribute('data-completion-status') || 'pending').toLowerCase();
      const status = String(row.getAttribute('data-status') || 'attended').toLowerCase();
      const locked = row.getAttribute('data-locked') === 'true';
      const completedAt = String(row.getAttribute('data-completed-at') || '').trim();
      const readyForTimesheet = row.getAttribute('data-ready-for-timesheet') === 'true';
      if (isCompletionMode) {
        parts.push(completion === 'completed' ? 'Completed' : 'Pending');
        if (completion === 'completed' && completedAt) {
          parts.push('Completed ' + completedAt.slice(0, 10));
        }
      } else if (status === 'attended') {
        parts.push('Attendance recorded');
      } else if (status) {
        parts.push('Attendance: ' + status);
      } else {
        parts.push('Pending attendance');
      }
      if (locked) parts.push('Timesheet locked');
      if (readyForTimesheet) parts.push('Ready for timesheet');
      return parts.filter(Boolean).join(' · ');
    }

    function initAssigneeInfoTooltips(root) {
      if (!window.bootstrap || typeof window.bootstrap.Tooltip !== 'function') return;
      const scope = root || document;
      scope.querySelectorAll('.ws-assignee-info-btn[data-bs-toggle="tooltip"]').forEach((icon) => {
        const existing = window.bootstrap.Tooltip.getInstance(icon);
        if (existing) existing.dispose();
        new window.bootstrap.Tooltip(icon);
      });
    }

    function refreshAssigneeRowInfoIcons() {
      document.querySelectorAll('#workSessionAssigneeTableBody tr.roster-row').forEach((row) => {
        const icon = row.querySelector('.ws-assignee-info-btn');
        if (!icon) return;
        const title = buildAssigneeInfoTitleFromRow(row);
        icon.setAttribute('title', title);
        icon.setAttribute('aria-label', title);
        icon.setAttribute('data-bs-original-title', title);
      });
      initAssigneeInfoTooltips(document.getElementById('workSessionAssigneeTableBody'));
    }

    function refreshAssigneeRowNumbers() {
      document.querySelectorAll('#workSessionAssigneeTableBody tr.roster-row').forEach((row, index) => {
        const num = row.querySelector('.attendance-order-num');
        if (num) num.textContent = String(index + 1);
      });
      refreshAssigneeRowInfoIcons();
    }

    function clearAssigneeEmptyState() {
      const tbody = document.getElementById('workSessionAssigneeTableBody');
      if (!tbody) return;
      const emptyRow = tbody.querySelector('tr:not(.roster-row)');
      if (emptyRow) emptyRow.remove();
    }

    function ensureAssigneeEmptyState() {
      const tbody = document.getElementById('workSessionAssigneeTableBody');
      if (!tbody) return;
      if (tbody.querySelectorAll('tr.roster-row').length) return;
      const colSpan = (canManageAllWorkSession && activityPaid) ? 7 : 6;
      tbody.innerHTML = '<tr><td colspan="' + colSpan + '" class="text-center py-4 text-muted">No assignees on this work session.</td></tr>';
    }

    function applyBulkWsAttendance(value) {
      document.querySelectorAll('#workSessionAssigneeTableBody tr.roster-row:not(.is-locked) input.ws-att-radio').forEach((radio) => {
        if (radio.disabled || radio.value !== value) return;
        radio.checked = true;
        const personId = radio.getAttribute('data-person-id');
        if (personId) syncRowFields(personId);
      });
    }

    function currentDerivedHours() {
      const start = document.getElementById('workSessionStartInput')?.value || '<%= entryRow.startTime || '' %>';
      const end = document.getElementById('workSessionEndInput')?.value || '<%= entryRow.endTime || '' %>';
      return calculateDurationHours(start, end) || Number('<%= Number(entryRow.durationHours || 0).toFixed(2) %>') || 0;
    }

    function refreshDerivedHours() {
      const hours = currentDerivedHours();
      const label = hours.toFixed(2) + ' h';
      const sessionHours = document.getElementById('workSessionDerivedHours');
      if (sessionHours) sessionHours.textContent = label;
      document.querySelectorAll('.ws-derived-hours').forEach((node) => {
        node.textContent = label;
      });
      document.querySelectorAll('.ws-paid-hours-input').forEach((input) => {
        input.value = hours.toFixed(2);
      });
    }

    async function showUiConfirm(options) {
      const opts = { showCancel: true, ...(options || {}) };
      try {
        const showMessageModalFn = resolveMessageModalFn();
        if (showMessageModalFn) {
          const okText = String(opts.okText || 'Yes').trim() || 'Yes';
          const cancelText = String(opts.cancelText || 'No').trim() || 'No';
          const modalPayload = {
            title: opts.title || 'Confirm',
            message: opts.message || 'Are you sure?',
            type: opts.type || 'confirm',
            okText: okText,
            cancelText: cancelText,
            icon: opts.icon || 'warning',
            buttons: [
              { text: okText, class: opts.okClass || 'btn-primary' },
              { text: cancelText, class: opts.cancelClass || 'btn-secondary' }
            ]
          };
          const modalResult = await showMessageModalFn(modalPayload);
          const normalizedResult = typeof modalResult === 'string'
            ? modalResult.trim().toLowerCase()
            : modalResult;
          return normalizedResult === true || normalizedResult === okText.toLowerCase();
        }
        const messageBoxFn = resolveMessageBoxFn();
        if (messageBoxFn) return !!(await messageBoxFn(opts));
      } catch (error) { /* ignore and fall back */ }
      return window.confirm((opts && opts.message) ? opts.message : 'Are you sure?');
    }

    function syncRowFields(personId) {
      const safePersonId = escapeSelectorValue(personId);
      const personSelector = '[data-person-id="' + safePersonId + '"]';
      const status = document.querySelector('input.ws-att-radio' + personSelector + ':checked');
      const paidHours = document.querySelector('.ws-paid-hours-input' + personSelector);
      const notes = document.querySelector('.ws-notes-input' + personSelector);
      document.querySelectorAll('input[name="status"]' + personSelector).forEach((input) => {
        if (status) input.value = status.value;
        else if (isCompletionMode) input.value = input.value || 'attended';
      });
      document.querySelectorAll('input[name="paidHours"]' + personSelector).forEach((input) => {
        if (paidHours) input.value = paidHours.value;
      });
      document.querySelectorAll('input[name="notes"]' + personSelector).forEach((input) => {
        if (notes) input.value = notes.value;
      });
    }

    function collectAdminAssignees() {
      const hours = currentDerivedHours();
      return Array.from(document.querySelectorAll('.work-session-assignee-form[data-person-id]'))
        .map((row) => {
          const personId = String(row.getAttribute('data-person-id') || '').trim();
          if (!personId) return null;
          const safePersonId = escapeSelectorValue(personId);
          const personSelector = '[data-person-id="' + safePersonId + '"]';
          const roleGroup = row.querySelector('.ws-role-radio-group');
          const roleRadio = row.querySelector('.ws-role-radio' + personSelector + ':checked');
          const statusInput = row.querySelector('input.ws-att-radio' + personSelector + ':checked');
          const completionRadio = row.querySelector('.ws-completion-radio' + personSelector + ':checked');
          const paidInput = row.querySelector('.ws-paid-input' + personSelector);
          const notesInput = row.querySelector('.ws-notes-input' + personSelector);
          const roleList = normalizeRoleList(roleGroup?.getAttribute('data-roles') || row.getAttribute('data-roles') || row.getAttribute('data-role') || 'participant');
          const role = pickDefaultRole(roleList, roleRadio?.value || row.getAttribute('data-role') || 'participant');
          const paidFallback = String(row.getAttribute('data-paid') || 'true').toLowerCase() !== 'false';
          return {
            personId,
            personName: row.getAttribute('data-person-name') || personId,
            role,
            roles: roleList.includes(role) ? roleList : [role].concat(roleList),
            status: statusInput ? statusInput.value : (row.getAttribute('data-status') || 'attended'),
            paid: paidInput ? paidInput.checked : paidFallback,
            paidHours: Number(hours.toFixed(2)),
            notes: notesInput ? notesInput.value : (row.getAttribute('data-notes') || ''),
            completionStatus: completionRadio ? completionRadio.value : (row.getAttribute('data-completion-status') || 'pending')
          };
        })
        .filter(Boolean);
    }

    function normalizePickerPerson(item) {
      const personId = String(item?.personId || item?.id || item?.value || '').trim();
      if (!personId) return null;
      const personName = String(item?.displayName || item?.personName || item?.name || item?.label || [item?.firstName, item?.lastName].filter(Boolean).join(' ') || personId).trim();
      const roles = resolveAssigneeRoleList(item, personId);
      const role = pickDefaultRole(roles, item?.matchedRole || item?.role);
      return { personId, personName, role, roles: roles.length ? roles : [role] };
    }

    function buildAdminAssigneeRow(person) {
      const safePersonId = escapeHtml(person.personId);
      const safePersonName = escapeHtml(person.personName || person.personId);
      const safeRole = escapeHtml(person.role || 'participant');
      const roleList = normalizeRoleList(person.roles || person.role || 'participant');
      const safeRoleList = escapeHtml(roleList.join(','));
      const rowKey = 'dynamic_' + (++dynamicAssigneeIndex);
      const hours = currentDerivedHours().toFixed(2);
      const roleRadios = buildRoleRadios(rowKey, person.personId, roleList, person.role);
      const statusControls = isCompletionMode
        ? '<div class="btn-group-vertical btn-group-sm ws-completion-radio-group" role="group">' + buildCompletionRadios(rowKey, person.personId, 'pending') + '</div>'
        : [
          '<div class="btn-group btn-group-sm flex-wrap" role="group">',
          '<input type="radio" class="btn-check ws-att-radio" data-person-id="' + safePersonId + '" name="att_' + rowKey + '" id="attended_' + rowKey + '" value="attended" checked>',
          '<label class="btn att-label" for="attended_' + rowKey + '"><i class="bi bi-check-lg me-1"></i>Attended</label>',
          '<input type="radio" class="btn-check ws-att-radio" data-person-id="' + safePersonId + '" name="att_' + rowKey + '" id="excused_' + rowKey + '" value="excused">',
          '<label class="btn att-label" for="excused_' + rowKey + '"><i class="bi bi-envelope-paper me-1"></i>Excused</label>',
          '<input type="radio" class="btn-check ws-att-radio" data-person-id="' + safePersonId + '" name="att_' + rowKey + '" id="absent_' + rowKey + '" value="absent">',
          '<label class="btn att-label" for="absent_' + rowKey + '"><i class="bi bi-x-lg me-1"></i>Absent</label>',
          '</div>'
        ].join('');
      const payableCell = (canManageAllWorkSession && activityPaid)
        ? '<td class="align-middle ws-payable-col"><div class="form-check form-switch mb-0 d-inline-flex justify-content-center"><input class="form-check-input ws-paid-input" type="checkbox" id="paid_' + rowKey + '" data-person-id="' + safePersonId + '" aria-label="Payable for ' + safePersonName + '"' + (activityPaid ? ' checked' : '') + '></div></td>'
        : '';
      const paidHoursHidden = activityPaid
        ? '<input type="hidden" class="ws-paid-hours-input" id="paidHours_' + rowKey + '" data-person-id="' + safePersonId + '" value="' + hours + '">'
        : '';
      if (paidHoursHidden) {
        const hiddenContainer = document.getElementById('workSessionAssigneeHiddenForms');
        if (hiddenContainer) hiddenContainer.insertAdjacentHTML('beforeend', paidHoursHidden);
      }
      return [
        '<tr class="roster-row work-session-assignee-form" data-personid="' + safePersonId + '" data-person-id="' + safePersonId + '" data-person-name="' + safePersonName + '" data-locked="false" data-role="' + safeRole + '" data-roles="' + safeRoleList + '" data-status="attended" data-paid="' + (activityPaid ? 'true' : 'false') + '" data-notes="" data-completion-status="pending" data-completed-at="" data-ready-for-timesheet="false">',
        '<td class="attendance-order-cell text-muted small ps-3 align-middle">',
        '<div class="attendance-order-stack">',
        '<div class="attendance-order-head">',
        '<span class="attendance-order-num"></span>',
        '<button type="button" class="btn btn-link btn-sm p-0 ws-assignee-info-btn" data-bs-toggle="tooltip" data-bs-placement="right" title="' + escapeHtml(isCompletionMode ? 'Pending' : 'Attendance recorded') + '" aria-label="' + escapeHtml(isCompletionMode ? 'Pending' : 'Attendance recorded') + '"><i class="bi bi-info-circle text-primary"></i></button>',
        '</div>',
        '<button type="button" class="btn btn-outline-danger btn-sm py-0 px-1 js-remove-work-assignee" data-person-id="' + safePersonId + '" title="Remove person"><i class="bi bi-trash"></i></button>',
        '</div>',
        '</td>',
        '<td class="ps-2 align-middle ws-person-col">',
        '<div class="ws-person-name-line">',
        '<span class="ws-person-name">' + safePersonName + '</span>',
        '<span class="ws-person-id">' + safePersonId + '</span>',
        '</div>',
        '</td>',
        '<td class="ws-role-col align-middle"><div class="btn-group-vertical btn-group-sm ws-role-radio-group" role="group" data-roles="' + safeRoleList + '">' + roleRadios + '</div></td>',
        payableCell,
        '<td class="text-end align-middle"><span class="fw-semibold ws-derived-hours" data-person-id="' + safePersonId + '">' + hours + ' h</span></td>',
        '<td class="ws-status-col align-middle pe-2">' + statusControls + '</td>',
        '<td class="ws-notes-col align-middle"><textarea class="form-control form-control-sm ws-notes-input" id="notes_' + rowKey + '" data-person-id="' + safePersonId + '" rows="2" maxlength="500" placeholder="Notes"></textarea></td>',
        '</tr>'
      ].join('');
    }

    function syncCompleteWorkSessionForm(personId) {
      syncRowFields(personId);
      const safePersonId = escapeSelectorValue(personId);
      const personSelector = '[data-person-id="' + safePersonId + '"]';
      const statusSource = document.querySelector('input[name="status"]' + personSelector);
      const paidSource = document.querySelector('input[name="paidHours"]' + personSelector);
      const notesSource = document.querySelector('input[name="notes"]' + personSelector);
      const personInput = document.getElementById('completeWorkSessionPersonId');
      const statusInput = document.getElementById('completeWorkSessionStatus');
      const paidInput = document.getElementById('completeWorkSessionPaidHours');
      const notesInput = document.getElementById('completeWorkSessionNotes');
      if (personInput) personInput.value = personId || '';
      if (statusInput) statusInput.value = statusSource ? statusSource.value : 'attended';
      if (paidInput) paidInput.value = paidSource ? paidSource.value : '';
      if (notesInput) notesInput.value = notesSource ? notesSource.value : '';
    }


    const saveSessionBtn = document.getElementById('btnSaveWorkSession');
    if (saveSessionBtn) {
      saveSessionBtn.addEventListener('click', async function () {
        if (canManageAllWorkSession) {
          const metadataForm = document.getElementById('frmWorkSessionMetadata');
          if (!metadataForm) return;
          refreshDerivedHours();
          const assigneesInput = document.getElementById('workSessionMetadataAssignees');
          if (assigneesInput) assigneesInput.value = JSON.stringify(collectAdminAssignees());
          if (typeof window.showLoading === 'function') window.showLoading('Saving session...');
          try {
            const response = await fetch(metadataForm.action, {
              method: 'POST',
              body: new URLSearchParams(new FormData(metadataForm)),
              headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            const payload = await response.json().catch(() => ({}));
            if (!response.ok || payload.status === 'error') {
              throw new Error(payload.message || 'Save failed.');
            }
            window.location.reload();
          } catch (error) {
            if (typeof window.hideLoading === 'function') window.hideLoading();
            const message = error && error.message ? error.message : 'Save failed.';
            await showUiMessage({ title: 'Save failed', icon: 'error', message: message });
          }
          return;
        }
        const saveForms = Array.from(document.querySelectorAll('.ws-assignee-save-form[data-person-id]'))
          .filter((form) => String(form.getAttribute('data-person-id') || '').trim());
        if (!saveForms.length) return;
        if (typeof window.showLoading === 'function') window.showLoading('Saving session…');
        try {
          for (const form of saveForms) {
            const personId = form.getAttribute('data-person-id');
            if (personId) syncRowFields(personId);
            const response = await fetch(form.action, {
              method: 'POST',
              body: new URLSearchParams(new FormData(form)),
              headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            const payload = await response.json().catch(() => ({}));
            if (!response.ok || payload.status === 'error') {
              throw new Error(payload.message || 'Save failed.');
            }
          }
          window.location.reload();
        } catch (error) {
          if (typeof window.hideLoading === 'function') window.hideLoading();
          const message = error && error.message ? error.message : 'Save failed.';
          await showUiMessage({ title: 'Save failed', icon: 'error', message: message });
        }
      });
    }

    document.querySelectorAll('.js-work-session-time-input').forEach((input) => {
      input.addEventListener('change', refreshDerivedHours);
      input.addEventListener('input', refreshDerivedHours);
    });
    refreshDerivedHours();

    document.getElementById('btnWsAllAttended')?.addEventListener('click', () => applyBulkWsAttendance('attended'));
    document.getElementById('btnWsAllExcused')?.addEventListener('click', () => applyBulkWsAttendance('excused'));
    document.getElementById('btnWsAllAbsent')?.addEventListener('click', () => applyBulkWsAttendance('absent'));
    document.getElementById('btnWsResetAttendance')?.addEventListener('click', () => applyBulkWsAttendance('attended'));

    document.getElementById('workSessionAssigneeTableBody')?.addEventListener('change', function (event) {
      const target = event.target;
      if (!target || !target.classList) return;
      const row = target.closest('.work-session-assignee-form');
      if (!row) return;
      const personId = target.getAttribute('data-person-id') || row.getAttribute('data-person-id');
      if (target.classList.contains('ws-att-radio') && target.checked) {
        row.setAttribute('data-status', target.value);
        if (personId) syncRowFields(personId);
      }
      if (target.classList.contains('ws-completion-radio') && target.checked) {
        row.setAttribute('data-completion-status', target.value);
      }
      if (target.classList.contains('ws-role-radio') && target.checked) {
        row.setAttribute('data-role', target.value);
      }
      if (target.classList.contains('ws-notes-input') && personId) {
        row.setAttribute('data-notes', target.value || '');
        syncRowFields(personId);
      }
      if (target.classList.contains('ws-paid-input')) {
        row.setAttribute('data-paid', target.checked ? 'true' : 'false');
      }
      refreshAssigneeRowInfoIcons();
    });

    document.addEventListener('click', async function (event) {
      const removeButton = event.target.closest('.js-remove-work-assignee');
      if (!removeButton) return;
      event.preventDefault();
      const row = removeButton.closest('.work-session-assignee-form');
      const personName = row?.getAttribute('data-person-name') || 'this person';
      const personId = row?.getAttribute('data-person-id') || '';
      const confirmed = await showUiConfirm({
        title: 'Remove Person',
        icon: 'warning',
        okText: 'Remove',
        cancelText: 'Cancel',
        okClass: 'btn-danger',
        message: 'Remove ' + personName + ' from this work session?'
      });
      if (!confirmed) return;
      if (personId) {
        document.querySelectorAll('.ws-paid-hours-input[data-person-id="' + escapeSelectorValue(personId) + '"]').forEach((node) => node.remove());
      }
      row?.remove();
      refreshAssigneeRowNumbers();
      ensureAssigneeEmptyState();
    });

    const addAssigneeButton = document.getElementById('btnAddWorkSessionAssignee');
    if (addAssigneeButton) {
      addAssigneeButton.addEventListener('click', async function () {
        if (!window.GenericPicker || !window.GenericPickerPresets) {
          await showUiMessage({ title: 'Picker Unavailable', icon: 'error', message: 'Person picker is not available on this page.' });
          return;
        }
        const tbody = document.getElementById('workSessionAssigneeTableBody');
        const assignedIds = new Set(Array.from(tbody?.querySelectorAll('.work-session-assignee-form[data-person-id]') || [])
          .map((row) => String(row.getAttribute('data-person-id') || '').trim())
          .filter(Boolean));
        const pickerItems = eligibleAssigneePersons.filter(function (person) {
          const personId = String(person?.personId || person?.id || '').trim();
          return personId && !assignedIds.has(personId);
        });
        if (!pickerItems.length) {
          const emptyMessage = visibilityScope === 'individual'
            ? 'Add allowed persons at the activity level before assigning people to this work session.'
            : 'No eligible people remain for this work session based on activity scope and exclusions.';
          await showUiMessage({
            title: visibilityScope === 'individual' ? 'No Allowed Persons' : 'No Eligible People',
            icon: 'warning',
            message: emptyMessage,
            buttons: [{ text: 'OK', class: 'btn-warning' }]
          });
          return;
        }
        window.GenericPicker.open(window.GenericPickerPresets.person({
          title: 'Add Assigned People',
          placeholder: 'Search students, teachers, or staff...',
          multiselect: true,
          sourceMode: 'local',
          localItems: pickerItems,
          searchFields: 'id,personId,displayName,firstName,lastName,preferredName,title',
          limit: 5000,
          onSelect: function (items) {
            const selectedRows = Array.isArray(items) ? items : [items];
            if (!tbody) return;
            selectedRows.forEach((item) => {
              const person = normalizePickerPerson(item);
              if (!person) return;
              const exists = tbody.querySelector('.work-session-assignee-form[data-person-id="' + escapeSelectorValue(person.personId) + '"]');
              if (exists) return;
              clearAssigneeEmptyState();
              tbody.insertAdjacentHTML('beforeend', buildAdminAssigneeRow(person));
            });
            refreshAssigneeRowNumbers();
            refreshDerivedHours();
          }
        }));
      });
    }

    const completeForm = document.getElementById('frmCompleteWorkSessionStatus');
    const statusButton = document.getElementById('workSessionStatusButton');

    function getPendingCompletionTargets() {
      return Array.from(document.querySelectorAll('.work-session-assignee-form[data-person-id]'))
        .filter((row) => String(row.getAttribute('data-person-id') || '').trim())
        .filter((row) => String(row.getAttribute('data-completion-status') || '').toLowerCase() !== 'completed')
        .map((row) => ({
          personId: String(row.getAttribute('data-person-id') || '').trim(),
          personName: row.getAttribute('data-person-name') || 'this assignee'
        }));
    }

    async function postCompleteWorkSessionTarget(personId) {
      syncCompleteWorkSessionForm(personId);
      const response = await fetch(completeForm.action, {
        method: 'POST',
        body: new URLSearchParams(new FormData(completeForm)),
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
      });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok || payload.status === 'error') {
        throw new Error(payload.message || 'Complete failed.');
      }
      if (payload.actionStateId) {
        document.querySelectorAll('input[name="actionStateId"]').forEach((input) => {
          input.value = String(payload.actionStateId || '');
        });
      }
      return payload;
    }

    if (statusButton && completeForm && isCompletionMode) {
      statusButton.addEventListener('click', async function (event) {
        event.preventDefault();
        if (statusButton.disabled) return;
        const targets = getPendingCompletionTargets();
        if (!targets.length) {
          await showUiMessage({ title: 'Already Complete', icon: 'success', message: 'This work session is already complete.' });
          return;
        }
        const message = targets.length === 1
          ? 'Mark ' + targets[0].personName + ' complete for this work session?'
          : 'Mark ' + targets.length + ' assignees complete for this work session?';
        const confirmed = await showUiConfirm({
          title: 'Mark Complete',
          icon: 'warning',
          okText: 'Complete',
          cancelText: 'Cancel',
          okClass: 'btn-warning',
          message: message
        });
        if (!confirmed) return;
        if (typeof window.showLoading === 'function') window.showLoading('Completing...');
        try {
          for (const target of targets) {
            await postCompleteWorkSessionTarget(target.personId);
          }
          window.location.reload();
        } catch (error) {
          if (typeof window.hideLoading === 'function') window.hideLoading();
          const errorMessage = error && error.message ? error.message : 'Complete failed.';
          await showUiMessage({ title: 'Complete failed', icon: 'error', message: errorMessage });
        }
      });
    }

    document.querySelectorAll('.btn-ws-pending').forEach((button) => {
      button.addEventListener('click', async function (event) {
        event.preventDefault();
        const personId = button.getAttribute('data-person-id');
        const personName = button.getAttribute('data-person-name') || 'this assignee';
        const confirmed = await showUiConfirm({
          title: 'Set Back to Pending',
          icon: 'warning',
          okText: 'Set Pending',
          cancelText: 'Cancel',
          message: 'Move ' + personName + ' back to pending completion? This is useful when the assignment was completed by mistake.'
        });
        if (!confirmed) return;
        if (personId) syncRowFields(personId);
        if (typeof window.showLoading === 'function') window.showLoading('Updating...');
        button.closest('form')?.submit();
      });
    });

    function setActiveWorkPanel(panelId) {
      document.querySelectorAll('.session-manager-nav-item[data-work-panel]').forEach((btn) => {
        const isActive = btn.getAttribute('data-work-panel') === panelId;
        btn.classList.toggle('active', isActive);
        btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });
      document.querySelectorAll('.session-panel[id^="work-panel-"]').forEach((panel) => {
        panel.classList.toggle('active', panel.id === 'work-panel-' + panelId);
      });
    }

    document.querySelectorAll('.session-manager-nav-item[data-work-panel]').forEach((btn) => {
      btn.addEventListener('click', function () {
        const panelId = btn.getAttribute('data-work-panel');
        if (!panelId) return;
        setActiveWorkPanel(panelId);
      });
    });

    const sidebarEl = document.getElementById('workSessionManagerSidebar');
    const btnToggleSidebar = document.getElementById('btnToggleWorkSessionSidebar');
    const sidebarIcon = document.getElementById('workSessionSidebarToggleIcon');
    const SIDEBAR_KEY = 'workSessionManagerSidebarCollapsed';
    if (sidebarEl && btnToggleSidebar) {
      try {
        if (localStorage.getItem(SIDEBAR_KEY) === '1') {
          sidebarEl.classList.add('collapsed');
          btnToggleSidebar.setAttribute('aria-expanded', 'false');
          if (sidebarIcon) sidebarIcon.className = 'bi bi-layout-sidebar';
        }
      } catch (e) { /* ignore */ }
      btnToggleSidebar.addEventListener('click', function () {
        sidebarEl.classList.toggle('collapsed');
        const collapsed = sidebarEl.classList.contains('collapsed');
        btnToggleSidebar.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
        if (sidebarIcon) sidebarIcon.className = collapsed ? 'bi bi-layout-sidebar' : 'bi bi-layout-sidebar-inset';
        try { localStorage.setItem(SIDEBAR_KEY, collapsed ? '1' : '0'); } catch (e) { /* ignore */ }
      });
    }

    const closeBtn = document.getElementById('btnCloseWorkSessionManager');
    if (closeBtn) {
      closeBtn.addEventListener('click', function () {
        if (window.history.length > 1) window.history.back();
        else window.location.href = fallbackCloseHref;
      });
    }

    initAssigneeInfoTooltips(document.getElementById('workSessionAssigneeTableBody'));
  })();
</script>
