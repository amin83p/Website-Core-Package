<script>
let modalInstance = null;
let holidayYearModalInstance = null;
let holidayCopyYearModalInstance = null;
let holidayAiObservancesModalInstance = null;
let holidayAiUndoReviewModalInstance = null;
let holidayAiRunSession = null;
const holidayAiUndoReviewPayload = <%- JSON.stringify({
  year: String(currentYear || ''),
  batch: holidayAiUndo.batch || null,
  items: holidayAiUndoItems
}).replace(/</g, '\\u003c') %>;
const holidayAiClientAccess = <%- JSON.stringify({
  usageAllowed: holidayAiUsageAllowed,
  serviceAssignmentConfigured: holidayAiAssignmentOk,
  serviceAssignmentMessage: holidayAiAssignmentMsg || 'This AI service has no provider key or model assigned. Configure it under School AI Assist → Service assignments.'
}) %>;
const holidayYearCountByYear = <%- JSON.stringify(holidayYearCountMap || {}).replace(/</g, '\\u003c') %>;
const holidayCopyTargetYear = '<%= currentYear %>';
const DEFAULT_STAT_PAYABLE_TYPES = ['National Holiday', 'Observance Paid'];
const CULTURAL_OBSERVANCE_TYPE = 'Cultural Observance (School Open)';
let holidayYearData = <%- JSON.stringify(holidayYearRows || []).replace(/</g, '\\u003c') %>;
let holidayDaySession = null;
let suppressHolidayCloseGuard = false;
const selectedHolidayYear = Number('<%= currentYear %>') || Number('<%= String(orgToday || currentYear || "").slice(0, 4) %>');

function normalizeHolidayDateKey(dateKey) {
    const token = String(dateKey || '').trim();
    if (/^\d{4}-\d{2}-\d{2}/.test(token)) return token.slice(0, 10);
    return token;
}

function formatHolidayDateKey(dateKey, options = {}) {
    const token = normalizeHolidayDateKey(dateKey);
    if (!token) return '-';
    if (window.AppOrgDateTime && typeof window.AppOrgDateTime.formatDateKey === 'function') {
        return window.AppOrgDateTime.formatDateKey(token, options);
    }
    return token;
}

function monthLabel(year, monthIndex) {
    return formatHolidayDateKey(`${year}-${String(monthIndex + 1).padStart(2, '0')}-01`, { month: 'long' });
}

function holidayCountsAsSchoolOff(row) {
    if (row && row.countsAsSchoolOff === false) return false;
    const type = String(row?.type || '').trim();
    if (type === CULTURAL_OBSERVANCE_TYPE) return false;
    return true;
}

function buildHolidayLookup(rows) {
    const map = new Map();
    (Array.isArray(rows) ? rows : []).forEach((row) => {
        const date = String(row?.date || '').trim();
        if (!date) return;
        if (!map.has(date)) map.set(date, []);
        map.get(date).push({
            id: String(row?.id || '').trim(),
            title: String(row?.title || 'Off Day').trim(),
            notes: String(row?.notes || '').trim(),
            type: String(row?.type || '').trim(),
            countsAsSchoolOff: holidayCountsAsSchoolOff(row),
            statutoryHolidayPayable: row?.statutoryHolidayPayable
        });
    });
    return map;
}

function listHolidayRowsForDate(dateKey) {
    const key = normalizeHolidayDateKey(dateKey);
    if (holidayDaySession?.mode === 'daySession' && holidayDaySession.dateKey === key) {
        return [...(holidayDaySession.working || [])].sort((a, b) => String(a?.title || '').localeCompare(String(b?.title || '')));
    }
    return (Array.isArray(holidayYearData) ? holidayYearData : [])
        .filter((row) => normalizeHolidayDateKey(row?.date) === key)
        .sort((a, b) => String(a?.title || '').localeCompare(String(b?.title || '')));
}

function cloneOccasionRow(row) {
    const type = String(row?.type || 'Holiday').trim();
    return {
        id: String(row?.id || '').trim(),
        date: normalizeHolidayDateKey(row?.date),
        title: String(row?.title || '').trim(),
        type,
        notes: String(row?.notes || '').trim(),
        countsAsSchoolOff: row?.countsAsSchoolOff === false ? false : holidayCountsAsSchoolOff(row),
        statutoryHolidayPayable: row?.statutoryHolidayPayable === true
            ? true
            : (row?.statutoryHolidayPayable === false ? false : null)
    };
}

function cloneOccasionsForDate(dateKey) {
    return listHolidayRowsForDateFromYearDataOnly(dateKey).map(cloneOccasionRow);
}

function listHolidayRowsForDateFromYearDataOnly(dateKey) {
    const key = normalizeHolidayDateKey(dateKey);
    return (Array.isArray(holidayYearData) ? holidayYearData : [])
        .filter((row) => normalizeHolidayDateKey(row?.date) === key)
        .sort((a, b) => String(a?.title || '').localeCompare(String(b?.title || '')));
}

function occasionRowsEqual(a, b) {
    const normalize = (rows) => [...(rows || [])]
        .map(cloneOccasionRow)
        .sort((x, y) => String(x.id).localeCompare(String(y.id)));
    return JSON.stringify(normalize(a)) === JSON.stringify(normalize(b));
}

function isHolidayFormDirty() {
    const session = holidayDaySession;
    if (!session || session.mode !== 'daySession') return false;
    if (session.formVisible !== true) return false;
    const current = readOccasionFormFields();
    if (!session.formSnapshot) return Boolean(current.title || current.notes);
    return JSON.stringify(current) !== JSON.stringify(session.formSnapshot);
}

function isSessionDirty() {
    const session = holidayDaySession;
    if (!session || session.mode !== 'daySession') return false;
    if (isHolidayFormDirty()) return true;
    return !occasionRowsEqual(session.baseline, session.working);
}

function setHolidayModalFooterMode(mode) {
    const single = document.getElementById('holidayModalFooterSingle');
    const day = document.getElementById('holidayModalFooterDaySession');
    if (single) single.classList.toggle('d-none', mode !== 'singleAdd');
    if (day) day.classList.toggle('d-none', mode !== 'daySession');
}

function syncHolDateInputs(dateKey = '') {
    const key = normalizeHolidayDateKey(dateKey);
    const hidden = document.getElementById('hol_date');
    const visible = document.getElementById('hol_date_visible');
    if (hidden) hidden.value = key;
    if (visible) visible.value = key;
}

function readOccasionFormFields() {
    const visibleDate = document.getElementById('hol_date_visible');
    const hiddenDate = document.getElementById('hol_date');
    const dateWrapHidden = document.getElementById('hol_date_visible_wrap')?.classList.contains('d-none');
    const rawDate = (!dateWrapHidden && visibleDate?.value)
        ? visibleDate.value
        : (hiddenDate?.value || visibleDate?.value || '');
    return {
        id: String(document.getElementById('hol_id')?.value || '').trim(),
        date: normalizeHolidayDateKey(rawDate),
        title: String(document.getElementById('hol_title')?.value || '').trim(),
        type: document.getElementById('hol_type')?.value || 'National Holiday',
        notes: String(document.getElementById('hol_notes')?.value || '').trim(),
        countsAsSchoolOff: document.getElementById('hol_counts_as_off')?.checked !== false,
        statutoryHolidayPayable: document.getElementById('hol_statutory_payable')?.checked === true
    };
}

function captureFormSnapshot() {
    if (holidayDaySession) {
        holidayDaySession.formSnapshot = readOccasionFormFields();
        holidayDaySession.formVisible = true;
    }
}

function clearOccasionFormFieldsOnly() {
    document.getElementById('hol_id').value = '';
    document.getElementById('hol_title').value = '';
    document.getElementById('hol_type').value = 'National Holiday';
    document.getElementById('hol_notes').value = '';
    const offEl = document.getElementById('hol_counts_as_off');
    if (offEl) offEl.checked = true;
    const payableEl = document.getElementById('hol_statutory_payable');
    if (payableEl) payableEl.checked = DEFAULT_STAT_PAYABLE_TYPES.includes('National Holiday');
    if (holidayDaySession) {
        holidayDaySession.formEditKey = '';
        holidayDaySession.formSnapshot = null;
        holidayDaySession.formVisible = false;
    }
}

function hideOccasionFormPanel() {
    document.getElementById('holidayOccasionFormPanel')?.classList.add('d-none');
    document.getElementById('hol_title')?.removeAttribute('required');
    document.getElementById('hol_date_visible')?.removeAttribute('required');
    if (holidayDaySession) {
        holidayDaySession.formEditKey = '';
        holidayDaySession.formSnapshot = null;
        holidayDaySession.formVisible = false;
    }
}

function showOccasionFormPanel() {
    document.getElementById('holidayOccasionFormPanel')?.classList.remove('d-none');
    document.getElementById('hol_title')?.setAttribute('required', 'required');
    if (!holidayDaySession || holidayDaySession.mode === 'singleAdd') {
        document.getElementById('hol_date_visible')?.setAttribute('required', 'required');
    }
    if (holidayDaySession) holidayDaySession.formVisible = true;
    captureFormSnapshot();
}

function setOccasionFormDateFieldVisible(show) {
    const wrap = document.getElementById('hol_date_visible_wrap');
    if (wrap) wrap.classList.toggle('d-none', !show);
}

function resetHolidayDaySession() {
    holidayDaySession = null;
    setHolidayModalFooterMode('singleAdd');
    hideOccasionFormPanel();
}

function syncYearModalKeyboardLock(explicitEditOpen) {
    const yearEl = document.getElementById('holidayYearViewModal');
    if (!yearEl) return;
    const editEl = document.getElementById('holidayModal');
    const editOpen = typeof explicitEditOpen === 'boolean'
        ? explicitEditOpen
        : Boolean(editEl?.classList.contains('show'));
    const yearVisible = yearEl.classList.contains('show');
    const lockYearKeyboard = editOpen && yearVisible;
    yearEl.setAttribute('data-bs-keyboard', lockYearKeyboard ? 'false' : 'true');
    const bsYear = typeof bootstrap !== 'undefined' ? bootstrap.Modal.getInstance(yearEl) : null;
    if (bsYear?._config) {
        bsYear._config.keyboard = !lockYearKeyboard;
    }
}

function startSingleAddHolidayMode() {
    holidayDaySession = { mode: 'singleAdd' };
    setHolidayModalFooterMode('singleAdd');
    setOccasionFormDateFieldVisible(true);
    showOccasionFormPanel();
    document.getElementById('holidayDayOccasionsPanel')?.classList.add('d-none');
    clearHolidayFormForDate('');
    document.getElementById('holidayModalTitle').innerText = 'Add Holiday / Occasion';
}

function beginNewOccasionForm(dateKey) {
    const key = normalizeHolidayDateKey(dateKey || holidayDaySession?.dateKey || document.getElementById('hol_date')?.value || '');
    if (!key) return;
    syncHolDateInputs(key);
    clearOccasionFormFieldsOnly();
    setOccasionFormDateFieldVisible(false);
    document.getElementById('holidayModalTitle').innerText = `Add occasion · ${formatHolidayDateKey(key)}`;
    document.getElementById('holidayOccasionFormHeading').innerText = 'New occasion';
    showOccasionFormPanel();
    holidayDaySession.formEditKey = `temp-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`;
    captureFormSnapshot();
    document.getElementById('hol_title')?.focus();
}

function beginEditOccasionForm(row) {
    if (!row) return;
    const key = normalizeHolidayDateKey(row.date || holidayDaySession?.dateKey);
    syncHolDateInputs(key);
    document.getElementById('hol_id').value = String(row.id || '');
    document.getElementById('hol_title').value = row.title || '';
    document.getElementById('hol_type').value = row.type || 'National Holiday';
    document.getElementById('hol_notes').value = row.notes || '';
    const offEl = document.getElementById('hol_counts_as_off');
    if (offEl) offEl.checked = row.countsAsSchoolOff !== false;
    const payableEl = document.getElementById('hol_statutory_payable');
    if (payableEl) {
        if (row.statutoryHolidayPayable === true) payableEl.checked = true;
        else if (row.statutoryHolidayPayable === false) payableEl.checked = false;
        else payableEl.checked = DEFAULT_STAT_PAYABLE_TYPES.includes(row.type || '');
    }
    setOccasionFormDateFieldVisible(false);
    document.getElementById('holidayModalTitle').innerText = `Edit occasion · ${formatHolidayDateKey(key)}`;
    document.getElementById('holidayOccasionFormHeading').innerText = 'Edit occasion';
    if (holidayDaySession) holidayDaySession.formEditKey = String(row.id || '');
    showOccasionFormPanel();
    captureFormSnapshot();
}

function openHolidayDaySession(dateKey) {
    const key = normalizeHolidayDateKey(dateKey);
    if (!key) return;
    const baseline = cloneOccasionsForDate(key);
    holidayDaySession = {
        mode: 'daySession',
        dateKey: key,
        baseline: baseline.map((r) => ({ ...r })),
        working: baseline.map((r) => ({ ...r })),
        formEditKey: '',
        formSnapshot: null,
        formVisible: false,
        actionStateId: window.__holidayActionStateId || ''
    };
    setHolidayModalFooterMode('daySession');
    syncHolDateInputs(key);
    clearOccasionFormFieldsOnly();
    hideOccasionFormPanel();
    document.getElementById('holidayDayOccasionsPanel')?.classList.remove('d-none');
    document.getElementById('holidayModalTitle').innerText = `Occasions on ${formatHolidayDateKey(key)}`;
    renderHolidayDayOccasionsList(key);
    showHolidayEditModalStacked();
}

async function confirmDiscardHolidaySession() {
    if (!isSessionDirty()) return true;
  const choice = typeof showMessageModal === 'function'
        ? await showMessageModal({
            title: 'Discard unsaved changes?',
            icon: 'warning',
            message: 'You have unsaved occasion changes for this date. Close without saving?',
            buttons: [
                { text: 'Keep editing', class: 'btn-secondary' },
                { text: 'Discard', class: 'btn-danger' }
            ]
        })
        : confirm('Discard unsaved changes?');
    return choice === 'Discard' || choice === true;
}

async function requestCloseHolidayModal() {
    if (holidayDaySession?.mode === 'daySession') {
        if (isHolidayFormDirty()) {
            const leaveForm = await confirmDiscardHolidaySession();
            if (!leaveForm) return;
            hideOccasionFormPanel();
        }
        if (isSessionDirty()) {
            const discard = await confirmDiscardHolidaySession();
            if (!discard) return;
        }
    }
    suppressHolidayCloseGuard = true;
    resetHolidayDaySession();
    if (modalInstance) modalInstance.hide();
    suppressHolidayCloseGuard = false;
}

function applyOccasionToWorkingCopy() {
    const form = document.getElementById('holidayForm');
    if (!form.checkValidity()) {
        form.reportValidity();
        return;
    }
    if (!holidayDaySession || holidayDaySession.mode !== 'daySession') return;
    const fields = readOccasionFormFields();
    let editKey = String(holidayDaySession.formEditKey || fields.id || '').trim();
    if (!editKey) editKey = `temp-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`;
    const row = cloneOccasionRow({
        ...fields,
        id: editKey,
        date: holidayDaySession.dateKey
    });
    const idx = holidayDaySession.working.findIndex((item) => String(item.id) === editKey);
    if (idx >= 0) holidayDaySession.working[idx] = row;
    else holidayDaySession.working.push(row);
    hideOccasionFormPanel();
    document.getElementById('holidayModalTitle').innerText = `Occasions on ${formatHolidayDateKey(holidayDaySession.dateKey)}`;
    renderHolidayDayOccasionsList(holidayDaySession.dateKey);
}

async function persistDaySession() {
    if (!holidayDaySession || holidayDaySession.mode !== 'daySession') return;
    const { baseline, working, dateKey } = holidayDaySession;
    const actionStateId = holidayDaySession.actionStateId || '';
    const workingIds = new Set(working.map((r) => String(r.id)));
    const toDelete = baseline.filter((r) => !workingIds.has(String(r.id)) && !String(r.id).startsWith('temp-'));
    const toSave = [];

    working.forEach((row) => {
        const id = String(row.id || '');
        if (id.startsWith('temp-')) {
            toSave.push({ ...row, id: '' });
            return;
        }
        const prior = baseline.find((b) => String(b.id) === id);
        if (!prior || JSON.stringify(cloneOccasionRow(prior)) !== JSON.stringify(cloneOccasionRow(row))) {
            toSave.push({ ...row, id });
        }
    });

    const saveBtn = document.getElementById('btn_saveDaySession');
    const originalSaveHtml = saveBtn?.innerHTML;
    if (saveBtn) {
        saveBtn.disabled = true;
        saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Saving...';
    }

    try {
        for (const row of toDelete) {
            const delRes = await fetch('/school/holidays/delete/' + encodeURIComponent(row.id), {
                method: 'GET',
                headers: { Accept: 'application/json', 'X-AJAX-Request': 'true' },
                credentials: 'same-origin'
            });
            const delResult = await delRes.json().catch(() => ({}));
            if (!delRes.ok || delResult.status === 'error') {
                throw new Error(delResult.message || 'Delete failed.');
            }
            removeHolidayRowFromTable(row.id);
            removeHolidayFromYearData(row.id);
        }

        for (const row of toSave) {
            const payload = {
                id: row.id || '',
                date: dateKey,
                title: row.title,
                type: row.type,
                notes: row.notes,
                statutoryHolidayPayable: row.statutoryHolidayPayable === true,
                countsAsSchoolOff: row.countsAsSchoolOff !== false,
                actionStateId
            };
            const res = await fetch('/school/holidays/save', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-AJAX-Request': 'true' },
                body: JSON.stringify(payload)
            });
            const result = await res.json();
            const guarded = typeof window.applyGuardedApiResult === 'function'
                ? await window.applyGuardedApiResult(result, { busyTitle: 'Save In Progress', replayTitle: 'Save Already Processed' })
                : { stop: false };
            if (guarded.stop) return;
            if (result.status !== 'success') {
                throw new Error(result.message || 'Save failed.');
            }
            const savedHoliday = result.holiday && typeof result.holiday === 'object'
                ? result.holiday
                : { ...payload, id: payload.id || row.id };
            applyHolidaySaveToTable(savedHoliday, row.id);
        }

        if (typeof showMessageModal === 'function') {
            await showMessageModal({
                title: 'Saved',
                icon: 'success',
                message: 'Occasion changes were saved.',
                buttons: [{ text: 'OK', class: 'btn-success' }]
            });
        }

        suppressHolidayCloseGuard = true;
        resetHolidayDaySession();
        if (modalInstance) modalInstance.hide();
        suppressHolidayCloseGuard = false;
        if (document.getElementById('holidayYearViewModal')?.classList.contains('show')) {
            renderHolidayYearCalendar();
        }
    } catch (error) {
        console.error(error);
        if (typeof showMessageModal === 'function') {
            await showMessageModal({ title: 'Save failed', icon: 'error', message: error.message || 'Unable to save changes.', buttons: [{ text: 'OK', class: 'btn-danger' }] });
        } else {
            alert(error.message || 'Save failed.');
        }
    } finally {
        if (saveBtn) {
            saveBtn.disabled = false;
            saveBtn.innerHTML = originalSaveHtml || 'Save changes';
        }
    }
}

function removeHolidayRowFromTable(holidayId) {
    const tbody = getHolidayTableBody();
    const rowEl = tbody?.querySelector(`tr[data-holiday-id="${holidayId}"]`);
    if (rowEl) rowEl.remove();
    ensureHolidayEmptyStateRow(tbody);
}

function buildHolidayTooltipLabel(items) {
    return (Array.isArray(items) ? items : [])
        .map((item) => {
            const title = String(item?.title || 'Off Day').trim();
            const notes = String(item?.notes || '').trim();
            return notes ? `${title}: ${notes}` : title;
        })
        .filter(Boolean)
        .join(' | ');
}

function toDateKey(dateObj) {
    const y = dateObj.getFullYear();
    const m = String(dateObj.getMonth() + 1).padStart(2, '0');
    const d = String(dateObj.getDate()).padStart(2, '0');
    return `${y}-${m}-${d}`;
}

function computeHolidayYearSummary(holidayLookup) {
    const offDaySet = new Set();
    if (holidayLookup instanceof Map) {
        holidayLookup.forEach((items, dateKey) => {
            const key = String(dateKey || '').trim();
            if (!key.startsWith(`${selectedHolidayYear}-`)) return;
            const rows = Array.isArray(items) ? items : [];
            if (rows.some((item) => item?.countsAsSchoolOff !== false)) {
                offDaySet.add(key);
            }
        });
    }

    const typeCounts = new Map();
    (Array.isArray(holidayYearData) ? holidayYearData : []).forEach((row) => {
        const dateKey = String(row?.date || '').trim();
        if (!dateKey.startsWith(`${selectedHolidayYear}-`)) return;
        const type = String(row?.type || 'Other').trim() || 'Other';
        typeCounts.set(type, Number(typeCounts.get(type) || 0) + 1);
    });

    let totalDays = 0;
    let totalWeekendDays = 0;
    let totalMonThu = 0;
    let totalFridays = 0;
    let offOnWeekend = 0;
    let offOnMonThu = 0;
    let offOnFriday = 0;

    const start = new Date(selectedHolidayYear, 0, 1);
    const end = new Date(selectedHolidayYear, 11, 31);
    for (let cursor = new Date(start); cursor <= end; cursor.setDate(cursor.getDate() + 1)) {
        totalDays += 1;
        const dayOfWeek = cursor.getDay(); // Sun=0, Mon=1 ... Sat=6
        const dateKey = toDateKey(cursor);
        const isOffDay = offDaySet.has(dateKey);
        const isWeekend = dayOfWeek === 0 || dayOfWeek === 6;

        if (isWeekend) totalWeekendDays += 1;
        if (dayOfWeek >= 1 && dayOfWeek <= 4) totalMonThu += 1;
        if (dayOfWeek === 5) totalFridays += 1;

        if (isOffDay) {
            if (isWeekend) offOnWeekend += 1;
            else if (dayOfWeek >= 1 && dayOfWeek <= 4) offOnMonThu += 1;
            else if (dayOfWeek === 5) offOnFriday += 1;
        }
    }

    const totalSchoolOffDays = offDaySet.size;
    const offExcludingWeekend = Math.max(0, totalSchoolOffDays - offOnWeekend);
    const teacherWorkingDaysMonThu = Math.max(0, totalMonThu - offOnMonThu);
    const totalWeekdays = totalMonThu + totalFridays;
    const offOnWeekdays = offOnMonThu + offOnFriday;
    const weekdaysOpen = Math.max(0, totalWeekdays - offOnWeekdays);

    const topTypes = Array.from(typeCounts.entries())
        .sort((a, b) => b[1] - a[1] || String(a[0]).localeCompare(String(b[0])))
        .slice(0, 3)
        .map(([type, count]) => `${type}: ${count}`)
        .join(' | ');

    return {
        totalDays,
        totalWeekendDays,
        totalMonThu,
        totalFridays,
        totalSchoolOffDays,
        offExcludingWeekend,
        teacherWorkingDaysMonThu,
        offOnWeekend,
        offOnMonThu,
        offOnFriday,
        weekdaysOpen,
        topTypes
    };
}

function renderHolidayYearSummary(holidayLookup) {
    const reportEl = document.getElementById('holidayYearSummaryReport');
    if (!reportEl) return;
    const summary = computeHolidayYearSummary(holidayLookup);

    reportEl.innerHTML = `
      <div class="row g-2 small">
        <div class="col-12 col-md-6"><span class="fw-bold text-dark">Teachers Working Days:</span> Monday to Thursday excluding the off days: <span class="text-primary fw-bold">${summary.teacherWorkingDaysMonThu}</span></div>
        <div class="col-12 col-md-6"><span class="fw-bold text-dark">Total Saturday and Sundays:</span> <span class="fw-bold">${summary.totalWeekendDays}</span></div>
        <div class="col-12 col-md-6"><span class="fw-bold text-dark">Total days school is off:</span> <span class="fw-bold text-danger">${summary.totalSchoolOffDays}</span></div>
        <div class="col-12 col-md-6"><span class="fw-bold text-dark">Total Days school is off excluding saturdays and sundays:</span> <span class="fw-bold text-danger">${summary.offExcludingWeekend}</span></div>
        <div class="col-12 col-md-6"><span class="fw-bold text-dark">Total Fridays:</span> ${summary.totalFridays}</div>
        <div class="col-12 col-md-6"><span class="fw-bold text-dark">Weekdays school is open (Mon-Fri excluding off days):</span> ${summary.weekdaysOpen}</div>
        <div class="col-12 col-md-6"><span class="fw-bold text-dark">Off days on weekends:</span> ${summary.offOnWeekend}</div>
        <div class="col-12 col-md-6"><span class="fw-bold text-dark">Off days on teacher working days (Mon-Thu):</span> ${summary.offOnMonThu}</div>
        <div class="col-12"><span class="fw-bold text-dark">Most common off-day types:</span> ${summary.topTypes || 'N/A'}</div>
      </div>
    `;
}

function renderHolidayYearCalendar() {
    const container = document.getElementById('holidayYearCalendarGrid');
    if (!container) return;
    const holidayLookup = buildHolidayLookup(holidayYearData);

    if (typeof bootstrap !== 'undefined') {
        container.querySelectorAll('[data-bs-toggle="tooltip"]').forEach((el) => {
            const instance = bootstrap.Tooltip.getInstance(el);
            if (instance) instance.dispose();
        });
    }

    container.innerHTML = '';

    for (let monthIndex = 0; monthIndex < 12; monthIndex++) {
        const col = document.createElement('div');
        col.className = 'col-12 col-md-6 col-xl-4';

        const card = document.createElement('div');
        card.className = 'card border-0 shadow-sm h-100';

        const header = document.createElement('div');
        header.className = 'card-header bg-danger-subtle text-danger fw-bold py-2';
        header.textContent = monthLabel(selectedHolidayYear, monthIndex);
        card.appendChild(header);

        const body = document.createElement('div');
        body.className = 'card-body p-2';

        const table = document.createElement('table');
        table.className = 'table table-sm mb-0 align-middle text-center';

        const thead = document.createElement('thead');
        thead.innerHTML = '<tr class="small text-muted"><th>Su</th><th>Mo</th><th>Tu</th><th>We</th><th>Th</th><th>Fr</th><th>Sa</th></tr>';
        table.appendChild(thead);

        const tbody = document.createElement('tbody');
        const firstDayOfMonth = new Date(selectedHolidayYear, monthIndex, 1).getDay();
        const daysInMonth = new Date(selectedHolidayYear, monthIndex + 1, 0).getDate();
        let day = 1;

        for (let week = 0; week < 6; week++) {
            const row = document.createElement('tr');
            let renderedCell = false;

            for (let weekDay = 0; weekDay < 7; weekDay++) {
                const cell = document.createElement('td');
                cell.className = 'py-1 px-0';

                if ((week === 0 && weekDay < firstDayOfMonth) || day > daysInMonth) {
                    cell.innerHTML = '<span class="text-muted"> </span>';
                } else {
                    renderedCell = true;
                    const dateKey = `${selectedHolidayYear}-${String(monthIndex + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
                    const holidayItems = holidayLookup.get(dateKey) || [];
                    const hasOffDay = holidayItems.some((item) => item?.countsAsSchoolOff !== false);
                    const hasObservanceOnly = !hasOffDay && holidayItems.length > 0;

                    const dayEl = document.createElement('span');
                    dayEl.className = 'd-inline-flex align-items-center justify-content-center rounded-circle';
                    dayEl.style.width = '28px';
                    dayEl.style.height = '28px';
                    dayEl.textContent = String(day);
                    dayEl.setAttribute('role', 'button');
                    dayEl.setAttribute('tabindex', '0');
                    dayEl.style.cursor = 'pointer';
                    dayEl.dataset.holidayDate = dateKey;

                    if (hasOffDay) {
                        dayEl.classList.add('bg-danger', 'text-white', 'fw-bold');
                    } else if (hasObservanceOnly) {
                        dayEl.classList.add('bg-primary-subtle', 'text-primary', 'border', 'border-primary', 'fw-semibold');
                    } else if (weekDay === 0 || weekDay === 6) {
                        dayEl.classList.add('bg-warning', 'text-dark', 'fw-semibold');
                    } else {
                        dayEl.classList.add('text-dark');
                    }

                    if (holidayItems.length) {
                        dayEl.setAttribute('data-bs-toggle', 'tooltip');
                        dayEl.setAttribute('data-bs-placement', 'top');
                        dayEl.setAttribute('title', buildHolidayTooltipLabel(holidayItems));
                        if (holidayItems.length > 1) {
                            dayEl.setAttribute('aria-label', `${day} — ${holidayItems.length} occasions`);
                        }
                    }

                    const openDayEditor = () => openHolidayDaySession(dateKey);
                    dayEl.addEventListener('click', openDayEditor);
                    dayEl.addEventListener('keydown', (event) => {
                        if (event.key === 'Enter' || event.key === ' ') {
                            event.preventDefault();
                            openDayEditor();
                        }
                    });

                    cell.appendChild(dayEl);
                    day += 1;
                }

                row.appendChild(cell);
            }

            if (!renderedCell && day > daysInMonth) break;
            tbody.appendChild(row);
        }

        table.appendChild(tbody);
        body.appendChild(table);
        card.appendChild(body);
        col.appendChild(card);
        container.appendChild(col);
    }

    if (typeof bootstrap !== 'undefined') {
        container.querySelectorAll('[data-bs-toggle="tooltip"]').forEach((el) => {
            new bootstrap.Tooltip(el);
        });
    }

    renderHolidayYearSummary(holidayLookup);
}

function resetHolidayAiObservanceModalUi() {
    document.getElementById('holidayAiObservancesInputPanel')?.classList.remove('d-none');
    document.getElementById('holidayAiObservancesReviewPanel')?.classList.add('d-none');
    document.getElementById('btnHolidayAiApply')?.classList.add('d-none');
    document.getElementById('btnHolidayAiBackToInput')?.classList.add('d-none');
    document.getElementById('btnHolidayAiAnalyze')?.classList.remove('d-none');
    document.getElementById('holidayAiWarnings').innerHTML = '';
    document.getElementById('holidayAiOccasionSummaries').innerHTML = '';
    document.getElementById('holidayAiPreviewBody').innerHTML = '';
    holidayAiRunSession = null;
}

function showHolidayAiReview(result) {
    holidayAiRunSession = {
        previewItems: Array.isArray(result.previewItems) ? result.previewItems : [],
        occasionSummaries: Array.isArray(result.occasionSummaries) ? result.occasionSummaries : [],
        traceId: result.traceId || null,
        usageRecordId: result.usageRecordId || null,
        year: String(result.year || document.getElementById('holidayAiYear')?.value || '').trim(),
        occasionInput: String(document.getElementById('holidayAiOccasions')?.value || '').trim(),
        regionHint: String(document.getElementById('holidayAiRegionHint')?.value || '').trim(),
        meta: {
            requestedOccasions: (result.occasionSummaries || []).length,
            previewDays: (result.previewItems || []).length
        }
    };
    document.getElementById('holidayAiObservancesInputPanel')?.classList.add('d-none');
    document.getElementById('holidayAiObservancesReviewPanel')?.classList.remove('d-none');
    document.getElementById('btnHolidayAiAnalyze')?.classList.add('d-none');
    document.getElementById('btnHolidayAiApply')?.classList.remove('d-none');
    document.getElementById('btnHolidayAiBackToInput')?.classList.remove('d-none');
    const warnings = Array.isArray(result.warnings) ? result.warnings : [];
    document.getElementById('holidayAiWarnings').innerHTML = warnings.length
        ? warnings.map((w) => `<div>${escapeHolidayHtml(w)}</div>`).join('')
        : '';
    document.getElementById('holidayAiOccasionSummaries').innerHTML = (result.occasionSummaries || [])
        .map((row) => `${escapeHolidayHtml(row.name)}: ${escapeHolidayHtml(row.startDate)} – ${escapeHolidayHtml(row.endDate)} (${escapeHolidayHtml(row.confidence || '')})`)
        .join('<br>');
    const tbody = document.getElementById('holidayAiPreviewBody');
    if (!tbody) return;
    tbody.innerHTML = holidayAiRunSession.previewItems.map((row, idx) => {
        const dup = row.duplicate ? 'text-muted' : '';
        return `<tr class="${dup}" data-preview-index="${idx}">
          <td><input type="checkbox" class="form-check-input holiday-ai-preview-check" data-index="${idx}" ${row.selected !== false && !row.duplicate ? 'checked' : ''} ${row.duplicate ? 'disabled' : ''}></td>
          <td>${escapeHolidayHtml(formatHolidayTableDate(row.date))}</td>
          <td>${escapeHolidayHtml(row.title)}${row.duplicate ? ' <span class="badge bg-secondary">exists</span>' : ''}</td>
          <td><span class="badge bg-light text-dark border">${escapeHolidayHtml(row.confidence || '')}</span></td>
        </tr>`;
    }).join('');
    const selectAll = document.getElementById('holidayAiSelectAll');
    if (selectAll) selectAll.checked = true;
}

function collectHolidayAiPreviewSelection() {
    if (!holidayAiRunSession) return [];
    const checks = document.querySelectorAll('.holiday-ai-preview-check');
    const selectedIndexes = new Set();
    checks.forEach((el) => {
        if (el.checked) selectedIndexes.add(Number(el.getAttribute('data-index')));
    });
    return holidayAiRunSession.previewItems.map((row, idx) => ({
        ...row,
        selected: selectedIndexes.has(idx)
    }));
}

document.addEventListener('DOMContentLoaded', () => {
