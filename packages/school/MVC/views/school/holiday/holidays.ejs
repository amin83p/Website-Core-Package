                syncYearModalKeyboardLock();
                if (!suppressHolidayCloseGuard) resetHolidayDaySession();
            });
        }
    }

    const holidayTableBody = getHolidayTableBody();
    if (holidayTableBody) {
        holidayTableBody.addEventListener('click', (event) => {
            const dateCell = event.target.closest('.holiday-date-open[data-holiday-date]');
            if (!dateCell) return;
            event.preventDefault();
            openHolidayDaySession(dateCell.getAttribute('data-holiday-date'));
        });
        holidayTableBody.addEventListener('keydown', (event) => {
            if (event.key !== 'Enter' && event.key !== ' ') return;
            const dateCell = event.target.closest('.holiday-date-open[data-holiday-date]');
            if (!dateCell) return;
            event.preventDefault();
            openHolidayDaySession(dateCell.getAttribute('data-holiday-date'));
        });
    }

    const holDateVisible = document.getElementById('hol_date_visible');
    if (holDateVisible) {
        holDateVisible.addEventListener('change', () => syncHolDateInputs(holDateVisible.value));
    }

    function updateHolidayCopySourcePreview() {
        const selectEl = document.getElementById('holidayCopySourceYear');
        const previewEl = document.getElementById('holidayCopySourcePreview');
        if (!selectEl || !previewEl) return;
        const year = String(selectEl.value || '').trim();
        const count = year ? Number(holidayYearCountByYear[year] || 0) : 0;
        previewEl.textContent = year
            ? `${count} holiday${count === 1 ? '' : 's'} in ${year} will be considered for copy.`
            : '';
    }

    const holidayCopySourceSelect = document.getElementById('holidayCopySourceYear');
    if (holidayCopySourceSelect) {
        holidayCopySourceSelect.addEventListener('change', updateHolidayCopySourcePreview);
        updateHolidayCopySourcePreview();
    }

    const openCopyYearBtn = document.getElementById('btnOpenHolidayCopyYear');
    if (openCopyYearBtn) {
        openCopyYearBtn.addEventListener('click', () => {
            updateHolidayCopySourcePreview();
            if (holidayCopyYearModalInstance) holidayCopyYearModalInstance.show();
        });
    }

    const holidayCopySubmitBtn = document.getElementById('btn_holidayCopyYearSubmit');
    if (holidayCopySubmitBtn) {
        holidayCopySubmitBtn.addEventListener('click', async () => {
            const sourceYear = String(document.getElementById('holidayCopySourceYear')?.value || '').trim();
            const duplicateMode = document.querySelector('input[name="holidayCopyDuplicateMode"]:checked')?.value || 'skip';
            if (!sourceYear) {
                if (typeof showMessageModal === 'function') {
                    await showMessageModal({ title: 'Source year required', icon: 'warning', message: 'Select a source year to copy from.', buttons: [{ text: 'OK', class: 'btn-warning' }] });
                }
                return;
            }

            const originalText = holidayCopySubmitBtn.innerHTML;
            holidayCopySubmitBtn.disabled = true;
            holidayCopySubmitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Copying...';

            try {
                const res = await fetch('/school/holidays/copy-year', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-AJAX-Request': 'true' },
                    body: JSON.stringify({
                        sourceYear,
                        targetYear: holidayCopyTargetYear,
                        duplicateMode,
                        actionStateId
                    })
                });
                const result = await res.json();
                const guarded = typeof window.applyGuardedApiResult === 'function'
                    ? await window.applyGuardedApiResult(result, { busyTitle: 'Copy In Progress', replayTitle: 'Copy Already Processed' })
                    : { stop: false };
                if (guarded.stop) return;

                if (holidayCopyYearModalInstance) holidayCopyYearModalInstance.hide();

                const icon = result.status === 'success' ? 'success' : (result.status === 'warning' ? 'warning' : 'error');
                if (typeof showMessageModal === 'function') {
                    await showMessageModal({
                        title: result.status === 'success' ? 'Copy complete' : (result.status === 'warning' ? 'Copy finished with warnings' : 'Copy failed'),
                        icon,
                        message: result.message || 'Holiday copy finished.',
                        buttons: [{ text: 'OK', class: icon === 'success' ? 'btn-success' : (icon === 'warning' ? 'btn-warning' : 'btn-danger') }]
                    });
                    if (result.status === 'success' || result.status === 'warning') window.location.reload();
                } else {
                    alert(result.message || 'Holiday copy finished.');
                    if (result.status === 'success' || result.status === 'warning') window.location.reload();
                }
            } catch (error) {
                console.error(error);
                if (typeof showMessageModal === 'function') {
                    await showMessageModal({ title: 'System Error', icon: 'error', message: 'A network error occurred.', buttons: [{ text: 'Close', class: 'btn-secondary' }] });
                } else { alert('A network error occurred.'); }
            } finally {
                holidayCopySubmitBtn.disabled = false;
                holidayCopySubmitBtn.innerHTML = originalText;
            }
        });
    }

    const openHolidayAiBtn = document.getElementById('btnOpenHolidayAiObservances');
    if (openHolidayAiBtn) {
        openHolidayAiBtn.addEventListener('click', () => {
            resetHolidayAiObservanceModalUi();
            if (holidayAiObservancesModalInstance) holidayAiObservancesModalInstance.show();
        });
    }

    const holidayAiSelectAll = document.getElementById('holidayAiSelectAll');
    if (holidayAiSelectAll) {
        holidayAiSelectAll.addEventListener('change', () => {
            document.querySelectorAll('.holiday-ai-preview-check:not(:disabled)').forEach((el) => {
                el.checked = holidayAiSelectAll.checked;
            });
        });
    }

    const btnHolidayAiBack = document.getElementById('btnHolidayAiBackToInput');
    if (btnHolidayAiBack) {
        btnHolidayAiBack.addEventListener('click', () => resetHolidayAiObservanceModalUi());
    }

    const btnHolidayAiAnalyze = document.getElementById('btnHolidayAiAnalyze');
    if (btnHolidayAiAnalyze) {
        btnHolidayAiAnalyze.addEventListener('click', async () => {
            if (!holidayAiClientAccess.serviceAssignmentConfigured) {
                const assignmentMsg = holidayAiClientAccess.serviceAssignmentMessage
                    || 'Assign a provider key and model under School AI Assist → Service assignments.';
                if (typeof showMessageModal === 'function') {
                    await showMessageModal({
                        title: 'AI service not configured',
