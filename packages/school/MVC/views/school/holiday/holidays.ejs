    function escapeHolidayAiUndoHtml(value) {
        return String(value || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function renderHolidayAiUndoReview(items, batch) {
        const metaEl = document.getElementById('holidayAiUndoReviewMeta');
        const tbody = document.getElementById('holidayAiUndoReviewBody');
        const rows = Array.isArray(items) ? items : [];
        const onCalendar = rows.filter((row) => row.stillOnCalendar !== false).length;
        if (metaEl) {
            const occasion = batch && batch.occasionInput ? ` Occasions: <span class="text-dark">${escapeHolidayAiUndoHtml(batch.occasionInput)}</span>.` : '';
            const created = batch ? Number(batch.holidayCount || batch.stats?.created || rows.length) : rows.length;
            metaEl.innerHTML = `This import added <strong>${created}</strong> day(s); <strong>${onCalendar}</strong> still on the calendar.${occasion}`;
        }
        if (!tbody) return;
        if (!rows.length) {
            tbody.innerHTML = '<tr><td colspan="3" class="text-muted small p-3">No imported days are on record for this batch.</td></tr>';
            return;
        }
        tbody.innerHTML = rows.map((row) => {
            const statusBadge = row.stillOnCalendar !== false
                ? '<span class="badge bg-success-subtle text-success border border-success-subtle">On calendar</span>'
                : '<span class="badge bg-secondary">Already removed</span>';
            return `<tr>
              <td class="text-nowrap">${escapeHolidayAiUndoHtml(row.date || '—')}</td>
              <td>${escapeHolidayAiUndoHtml(row.title || '—')}</td>
              <td>${statusBadge}</td>
            </tr>`;
        }).join('');
        const rollbackBtn = document.getElementById('btnHolidayAiConfirmRollback');
        if (rollbackBtn) rollbackBtn.disabled = onCalendar === 0;
    }

    async function refreshHolidayAiUndoReview(year) {
        const res = await fetch(`/school/holidays/ai-observances/state?year=${encodeURIComponent(year)}`, {
            headers: { 'X-AJAX-Request': 'true' }
        });
        const result = await res.json();
        if (!res.ok || result.status === 'error') throw new Error(result.message || 'Could not load AI import review.');
        if (!result.undo?.canUndo) throw new Error('There is no AI import left to roll back for this year.');
        return result.undo;
    }

    async function openHolidayAiUndoReviewModal(year) {
        let payload = holidayAiUndoReviewPayload;
        try {
            const fresh = await refreshHolidayAiUndoReview(year || payload.year);
            payload = { year: year || payload.year, batch: fresh.batch, items: fresh.items || [] };
        } catch (_) {
            /* use server-rendered payload */
        }
        renderHolidayAiUndoReview(payload.items, payload.batch);
        if (holidayAiUndoReviewModalInstance) holidayAiUndoReviewModalInstance.show();
    }

    async function runHolidayAiUndo(year) {
        const confirmed = typeof showMessageModal === 'function'
            ? await showMessageModal({
                title: 'Roll back this AI import?',
                icon: 'warning',
                message: 'This removes holidays that are still on the calendar from the most recent AI cultural observances import for this year.',
                buttons: [{ text: 'Cancel', class: 'btn-secondary' }, { text: 'Roll back', class: 'btn-danger' }]
            })
            : confirm('Roll back this AI import?');
        if (confirmed !== 'Roll back' && confirmed !== true) return;
        const res = await fetch('/school/holidays/ai-observances/undo-last', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-AJAX-Request': 'true' },
            body: JSON.stringify({ year, actionStateId })
        });
        const result = await res.json();
        if (!res.ok || result.status === 'error') throw new Error(result.message || 'Undo failed.');
        if (typeof showMessageModal === 'function') {
            await showMessageModal({ title: 'Undone', icon: 'success', message: result.message || 'AI import undone.', buttons: [{ text: 'OK', class: 'btn-success' }] });
        }
        window.location.reload();
    }

    const btnHolidayAiReviewUndo = document.getElementById('btnHolidayAiReviewUndo');
    if (btnHolidayAiReviewUndo) {
        btnHolidayAiReviewUndo.addEventListener('click', () => {
            void openHolidayAiUndoReviewModal(btnHolidayAiReviewUndo.getAttribute('data-year') || holidayCopyTargetYear);
        });
    }

    const btnHolidayAiConfirmRollback = document.getElementById('btnHolidayAiConfirmRollback');
    if (btnHolidayAiConfirmRollback) {
        btnHolidayAiConfirmRollback.addEventListener('click', async () => {
            try {
                await runHolidayAiUndo(btnHolidayAiConfirmRollback.getAttribute('data-year') || holidayCopyTargetYear);
            } catch (error) {
                if (typeof showMessageModal === 'function') {
                    await showMessageModal({ title: 'Rollback failed', icon: 'error', message: error.message || 'Unable to roll back.', buttons: [{ text: 'OK', class: 'btn-danger' }] });
                } else alert(error.message || 'Rollback failed.');
            }
        });
    }

    // 2. Intercept the standard "Add" button from tablePages-start
    const newBtn = document.querySelector('a[href="/school/holidays/new"]');
    if (newBtn) {
        newBtn.addEventListener('click', (e) => {
            e.preventDefault();
            startSingleAddHolidayMode();
            showHolidayEditModalStacked();
        });
    }

    const openYearViewBtn = document.getElementById('btnOpenHolidayYearView');
    if (openYearViewBtn) {
        openYearViewBtn.addEventListener('click', () => {
            renderHolidayYearCalendar();
            if (holidayYearModalInstance) holidayYearModalInstance.show();
        });
    }

    const holTypeSelect = document.getElementById('hol_type');
    if (holTypeSelect) {
        holTypeSelect.addEventListener('change', () => {
            const payableEl = document.getElementById('hol_statutory_payable');
            if (payableEl) payableEl.checked = DEFAULT_STAT_PAYABLE_TYPES.includes(holTypeSelect.value);
            const offEl = document.getElementById('hol_counts_as_off');
            if (offEl) offEl.checked = holTypeSelect.value !== CULTURAL_OBSERVANCE_TYPE;
        });
    }

    const addAnotherOccasionBtn = document.getElementById('btn_holidayAddAnotherOccasion');
    if (addAnotherOccasionBtn) {
        addAnotherOccasionBtn.addEventListener('click', () => {
            const dateKey = normalizeHolidayDateKey(holidayDaySession?.dateKey || document.getElementById('hol_date')?.value || '');
            if (!dateKey) return;
            beginNewOccasionForm(dateKey);
        });
    }

    const applyOccasionBtn = document.getElementById('btn_applyOccasion');
    if (applyOccasionBtn) {
        applyOccasionBtn.addEventListener('click', () => applyOccasionToWorkingCopy());
    }

    const cancelOccasionFormBtn = document.getElementById('btn_cancelOccasionForm');
    if (cancelOccasionFormBtn) {
        cancelOccasionFormBtn.addEventListener('click', async () => {
            if (isHolidayFormDirty()) {
                const discard = await confirmDiscardHolidaySession();
                if (!discard) return;
            }
            hideOccasionFormPanel();
            const key = holidayDaySession?.dateKey;
            if (key) {
                document.getElementById('holidayModalTitle').innerText = `Occasions on ${formatHolidayDateKey(key)}`;
            }
        });
    }

    const closeDaySessionBtn = document.getElementById('btn_closeDaySession');
    if (closeDaySessionBtn) {
        closeDaySessionBtn.addEventListener('click', () => requestCloseHolidayModal());
    }

    const saveDaySessionBtn = document.getElementById('btn_saveDaySession');
    if (saveDaySessionBtn) {
        saveDaySessionBtn.addEventListener('click', () => {
            if (isHolidayFormDirty()) {
                applyOccasionToWorkingCopy();
            }
            persistDaySession();
        });
    }

    // 3. Save Logic (single-record toolbar add)
    document.getElementById('btn_saveHoliday').addEventListener('click', async () => {
        const form = document.getElementById('holidayForm');
        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }

        const fields = readOccasionFormFields();
        const previousHolidayId = String(fields.id || '').trim();
        const payload = {
            id: previousHolidayId,
            date: fields.date,
            title: fields.title,
            type: fields.type,
            notes: fields.notes,
            statutoryHolidayPayable: fields.statutoryHolidayPayable === true,
            countsAsSchoolOff: fields.countsAsSchoolOff !== false,
            actionStateId
        };

        const submitBtn = document.getElementById('btn_saveHoliday');
        const originalText = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Saving...';

        try {
            const res = await fetch('/school/holidays/save', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-AJAX-Request': 'true' },
                body: JSON.stringify(payload)
            });
            const result = await res.json();
            const guarded = typeof window.applyGuardedApiResult === 'function'
                ? await window.applyGuardedApiResult(result, { busyTitle: 'Save In Progress', replayTitle: 'Save Already Processed' })
                : { stop: false };
            if (guarded.stop) return;

            suppressHolidayCloseGuard = true;
            resetHolidayDaySession();
            if (modalInstance) modalInstance.hide();
            suppressHolidayCloseGuard = false;

            if (result.status === 'success') {
                const savedHoliday = result.holiday && typeof result.holiday === 'object'
                    ? result.holiday
                    : { ...payload, id: previousHolidayId || payload.id };
                applyHolidaySaveToTable(savedHoliday, previousHolidayId);
                if (document.getElementById('holidayYearViewModal')?.classList.contains('show')) {
                    renderHolidayYearCalendar();
                }
            }

            if (typeof showMessageModal === 'function') {
                await showMessageModal({
                    title: result.status === 'success' ? 'Success' : 'Error',
                    icon: result.status === 'success' ? 'success' : 'error',
                    message: result.message,
                    buttons: [{ text: 'OK', class: result.status === 'success' ? 'btn-success' : 'btn-danger' }]
                });
            } else {
                alert(result.message);
            }
        } catch (error) {
            console.error(error);
            if (typeof showMessageModal === 'function') {
                await showMessageModal({ title: 'System Error', icon: 'error', message: 'A network error occurred.', buttons: [{ text: 'Close', class: 'btn-secondary' }] });
            } else { alert('A network error occurred.'); }
        } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
        }
    });
});

// --- Helper Functions ---

function escapeHolidayHtml(value) {
    return String(value ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
}

function escapeHolidayJsString(value) {
    return String(value ?? '').replace(/\\/g, '\\\\').replace(/'/g, "\\'");
}

function holidayTypeBadgeClass(type) {
    const token = String(type || '');
    if (token === 'National Holiday') return 'bg-primary';
    if (token === 'Observance Paid') return 'bg-success';
    if (token === 'School Break') return 'bg-info text-dark';
    if (token === 'Weather Emergency') return 'bg-danger';
    return 'bg-secondary';
}

function holidayStatPayHtml(statutoryHolidayPayable) {
    if (statutoryHolidayPayable === true) {
        return '<span class="badge bg-success-subtle text-success border border-success">Payable</span>';
    }
    if (statutoryHolidayPayable === false) {
        return '<span class="badge bg-light text-muted border">Not payable</span>';
    }
    return '<span class="badge bg-secondary-subtle text-secondary border">By type</span>';
}

function formatHolidayTableDate(dateKey) {
    return formatHolidayDateKey(normalizeHolidayDateKey(dateKey), {
        weekday: 'short',
        month: 'short',
        day: 'numeric'
    });
}

function holidayBelongsToSelectedYear(dateKey) {
    const token = String(dateKey || '').trim();
    return token.startsWith(`${selectedHolidayYear}-`);
}

function syncHolidayYearDataEntry(holiday, { removeId = '' } = {}) {
    const id = String(holiday?.id || '').trim();
    const dropIds = new Set([String(removeId || '').trim(), id].filter(Boolean));
    holidayYearData = (Array.isArray(holidayYearData) ? holidayYearData : []).filter((row) => !dropIds.has(String(row?.id || '')));
    if (holiday && id && holidayBelongsToSelectedYear(holiday.date)) {
        holidayYearData.push({
            id,
            date: holiday.date,
            title: holiday.title,
            type: holiday.type,
            notes: holiday.notes,
            countsAsSchoolOff: holiday.countsAsSchoolOff,
            statutoryHolidayPayable: holiday.statutoryHolidayPayable
        });
    }
}

function removeHolidayFromYearData(holidayId) {
    const id = String(holidayId || '').trim();
    if (!id) return;
    holidayYearData = (Array.isArray(holidayYearData) ? holidayYearData : []).filter((row) => String(row?.id || '') !== id);
}

function renderHolidayDayOccasionsList(dateKey) {
    const panel = document.getElementById('holidayDayOccasionsPanel');
    const listEl = document.getElementById('holidayDayOccasionsList');
    const key = normalizeHolidayDateKey(dateKey);
    if (!panel || !listEl) return;
    if (!key) {
        panel.classList.add('d-none');
        listEl.innerHTML = '';
        return;
    }
    const rows = listHolidayRowsForDate(key);
    panel.classList.remove('d-none');
    if (!rows.length) {
        listEl.innerHTML = '<div class="list-group-item small text-muted py-2">No occasions yet for this date. Add one below.</div>';
        return;
    }
    listEl.innerHTML = rows.map((row) => {
        const id = escapeHolidayHtml(row.id);
        const title = escapeHolidayHtml(row.title);
        const type = escapeHolidayHtml(row.type || 'Holiday');
        const off = holidayCountsAsSchoolOff(row);
        const badge = off
            ? '<span class="badge bg-danger-subtle text-danger border">Off day</span>'
            : '<span class="badge bg-info-subtle text-info border">School open</span>';
        return `<div class="list-group-item d-flex flex-wrap align-items-center justify-content-between gap-2 py-2">
          <div class="small">
            <span class="fw-semibold text-primary">${title}</span>
            <span class="text-muted ms-1">· ${type}</span>
            <span class="ms-1">${badge}</span>
          </div>
          <div class="d-flex gap-1">
            <button type="button" class="btn btn-outline-secondary btn-sm" data-holiday-day-edit="${id}">Edit</button>
            <button type="button" class="btn btn-outline-danger btn-sm" data-holiday-day-delete="${id}">Delete</button>
          </div>
        </div>`;
    }).join('');

    const inDaySession = holidayDaySession?.mode === 'daySession' && holidayDaySession.dateKey === key;

    listEl.querySelectorAll('[data-holiday-day-edit]').forEach((btn) => {
        btn.addEventListener('click', () => {
            const editId = String(btn.getAttribute('data-holiday-day-edit') || '').trim();
            const match = rows.find((item) => String(item.id) === editId);
            if (!match) return;
            beginEditOccasionForm(match);
        });
    });

    listEl.querySelectorAll('[data-holiday-day-delete]').forEach((btn) => {
        btn.addEventListener('click', async () => {
            const deleteId = String(btn.getAttribute('data-holiday-day-delete') || '').trim();
            const match = rows.find((item) => String(item.id) === deleteId);
            if (!deleteId) return;
            const confirmed = typeof showMessageModal === 'function'
                ? await showMessageModal({
                    title: inDaySession ? 'Remove occasion' : 'Delete occasion',
                    icon: 'warning',
                    message: inDaySession
                        ? `Remove "${match?.title || 'this occasion'}" from this session?`
                        : `Delete "${match?.title || 'this occasion'}"?`,
                    buttons: [
                        { text: 'Cancel', class: 'btn-secondary' },
                        { text: inDaySession ? 'Remove' : 'Delete', class: 'btn-danger' }
                    ]
                })
                : confirm(inDaySession ? 'Remove this occasion from the session?' : 'Delete this occasion?');
            const ok = inDaySession ? (confirmed === 'Remove' || confirmed === true) : (confirmed === 'Delete' || confirmed === true);
            if (!ok) return;

            if (inDaySession) {
                holidayDaySession.working = (holidayDaySession.working || []).filter((item) => String(item.id) !== deleteId);
                if (String(holidayDaySession.formEditKey || '') === deleteId) {
                    hideOccasionFormPanel();
                    document.getElementById('holidayModalTitle').innerText = `Occasions on ${formatHolidayDateKey(key)}`;
                }
                renderHolidayDayOccasionsList(key);
                return;
            }

            try {
                const res = await fetch('/school/holidays/delete/' + encodeURIComponent(deleteId), {
                    method: 'GET',
                    headers: { Accept: 'application/json', 'X-AJAX-Request': 'true' },
                    credentials: 'same-origin'
                });
                const result = await res.json().catch(() => ({}));
                if (!res.ok || result.status === 'error') {
                    throw new Error(result.message || 'Delete failed.');
                }
                removeHolidayRowFromTable(deleteId);
                removeHolidayFromYearData(deleteId);
                renderHolidayDayOccasionsList(key);
                if (document.getElementById('holidayYearViewModal')?.classList.contains('show')) {
                    renderHolidayYearCalendar();
                }
            } catch (error) {
                if (typeof showMessageModal === 'function') {
                    await showMessageModal({ title: 'Delete failed', icon: 'error', message: error.message || 'Unable to delete.', buttons: [{ text: 'OK', class: 'btn-danger' }] });
                } else {
                    alert(error.message || 'Delete failed.');
                }
            }
        });
    });
}

function clearHolidayFormForDate(dateKey = '') {
    const key = normalizeHolidayDateKey(dateKey);
    syncHolDateInputs(key);
    clearOccasionFormFieldsOnly();
    setOccasionFormDateFieldVisible(true);
}

function showHolidayEditModalStacked() {
    const holidayModalEl = document.getElementById('holidayModal');
    const yearOpen = document.getElementById('holidayYearViewModal')?.classList.contains('show');
    if (holidayModalEl && yearOpen) {
        holidayModalEl.classList.add('holiday-modal-above-year');
        document.body.classList.add('holiday-edit-over-year');
        syncYearModalKeyboardLock(true);
    }
    if (modalInstance) modalInstance.show();
}

function openHolidayModalForDate(dateKey) {
    openHolidayDaySession(dateKey);
}

function buildHolidayTableRowHtml(item) {
    const id = String(item?.id || '').trim();
    const date = String(item?.date || '').trim();
    const title = String(item?.title || '').trim();
    const type = String(item?.type || 'Holiday').trim();
    const notes = String(item?.notes || '').trim();
    const payable = item?.statutoryHolidayPayable;
    const payableArg = payable === true ? 'true' : (payable === false ? 'false' : 'null');
    const offArg = holidayCountsAsSchoolOff(item) ? 'true' : 'false';
    const displayDate = formatHolidayTableDate(date);
    const openTag = holidayCountsAsSchoolOff(item) ? '' : '<span class="badge bg-info-subtle text-info border ms-1">School open</span>';
  const dateKey = normalizeHolidayDateKey(date);
  return `<tr data-holiday-id="${escapeHolidayHtml(id)}">
    <td class="ps-4 fw-bold text-dark holiday-date-open text-primary" style="cursor:pointer;" role="button" tabindex="0" data-holiday-date="${escapeHolidayHtml(dateKey)}" data-sort-value="${escapeHolidayHtml(date)}" title="Manage occasions on this date">${escapeHolidayHtml(displayDate)}</td>
    <td class="fw-bold text-primary">${escapeHolidayHtml(title)}</td>
    <td><span class="badge ${holidayTypeBadgeClass(type)}">${escapeHolidayHtml(type)}</span>${openTag}</td>
    <td>${holidayStatPayHtml(payable)}</td>
    <td class="text-muted small text-truncate" style="max-width: 250px;">${escapeHolidayHtml(notes || '-')}</td>
    <td class="table-actions text-end pe-4">
      <div class="row-actions-wrap">
        <button type="button" class="btn btn-secondary btn-sm btn-row-actions-toggle" data-row-actions-id="${escapeHolidayHtml(id)}" title="Holiday Actions">
          <i class="bi bi-three-dots-vertical"></i>
        </button>
        <div class="row-actions-menu d-none" data-row-actions-id="${escapeHolidayHtml(id)}">
          <button class="btn btn-outline-info btn-sm" onclick="openHolidayDaySession('${escapeHolidayJsString(dateKey)}')">
            <i class="bi bi-pencil-square me-2"></i>Edit day
          </button>
          <button class="btn btn-outline-danger btn-sm delete-btn" data-id="${escapeHolidayHtml(id)}">
            <i class="bi bi-trash me-2"></i>Delete
          </button>
        </div>
      </div>
    </td>
  </tr>`;
}

function getHolidayTableBody() {
    return document.querySelector('#first-table tbody');
}

function clearHolidayEmptyStateRow(tbody) {
    if (!tbody) return;
    const emptyRow = tbody.querySelector('tr:not([data-holiday-id])');
    if (emptyRow) emptyRow.remove();
}

function ensureHolidayEmptyStateRow(tbody) {
    if (!tbody) return;
    if (tbody.querySelector('[data-holiday-id]')) return;
    tbody.innerHTML = `<tr><td colspan="6" class="text-center py-5 text-muted">No holidays recorded for ${selectedHolidayYear}.</td></tr>`;
}

function applyHolidaySaveToTable(holiday, previousId = '') {
    const tbody = getHolidayTableBody();
    if (!tbody || !holiday) return;

    const id = String(holiday.id || previousId || '').trim();
    const inYear = holidayBelongsToSelectedYear(holiday.date);
    const priorId = String(previousId || id).trim();
    const existingRow = priorId
        ? Array.from(tbody.querySelectorAll('tr[data-holiday-id]')).find((row) => row.dataset.holidayId === priorId)
        : null;

    syncHolidayYearDataEntry(holiday, { removeId: priorId });

    if (!inYear) {
        if (existingRow) existingRow.remove();
        ensureHolidayEmptyStateRow(tbody);
        return;
    }

    const rowHtml = buildHolidayTableRowHtml({ ...holiday, id });
    if (existingRow) {
        existingRow.outerHTML = rowHtml;
    } else {
        clearHolidayEmptyStateRow(tbody);
        tbody.insertAdjacentHTML('beforeend', rowHtml);
    }
}

async function deleteHoliday(id, title) {
    // Delete handling is centralized in public/scripts/main.js.
}
</script>
