            if (!previewItems.length) {
                if (typeof showMessageModal === 'function') {
                    await showMessageModal({ title: 'Nothing selected', icon: 'warning', message: 'Select at least one day to add.', buttons: [{ text: 'OK', class: 'btn-warning' }] });
                }
                return;
            }
            const original = btnHolidayAiApply.innerHTML;
            btnHolidayAiApply.disabled = true;
            btnHolidayAiApply.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Adding...';
            try {
                const res = await fetch('/school/holidays/ai-observances/apply', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-AJAX-Request': 'true' },
                    body: JSON.stringify({
                        year: holidayAiRunSession.year,
                        previewItems,
                        occasionInput: holidayAiRunSession.occasionInput,
                        regionHint: holidayAiRunSession.regionHint,
                        traceId: holidayAiRunSession.traceId,
                        usageRecordId: holidayAiRunSession.usageRecordId,
                        meta: holidayAiRunSession.meta,
                        actionStateId
                    })
                });
                const result = await res.json();
                const guarded = typeof window.applyGuardedApiResult === 'function'
                    ? await window.applyGuardedApiResult(result, { busyTitle: 'Apply In Progress', replayTitle: 'Apply Already Processed' })
                    : { stop: false };
