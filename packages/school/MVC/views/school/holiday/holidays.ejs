<%
  const holidayYearRows = Array.isArray(yearHolidayData) ? yearHolidayData : [];
  const copySourceYears = (Array.isArray(holidayYearsWithData) ? holidayYearsWithData : [])
    .map((y) => String(y || '').trim())
    .filter((y) => /^\d{4}$/.test(y) && y !== String(currentYear));
  const holidayYearCountMap = holidayYearCounts && typeof holidayYearCounts === 'object' ? holidayYearCounts : {};
  const holidayAiAccess = (typeof holidayAiObservanceAccess !== 'undefined' && holidayAiObservanceAccess) ? holidayAiObservanceAccess : { allowed: false, message: '' };
  const holidayAiUsageAllowed = Boolean(holidayAiAccess.allowed);
  const holidayAiAssignmentOk = holidayAiAccess.serviceAssignmentConfigured !== false;
  const holidayAiAssignmentMsg = String(holidayAiAccess.serviceAssignmentMessage || '').trim();
  const holidayAiUndo = (typeof holidayAiUndoState !== 'undefined' && holidayAiUndoState) ? holidayAiUndoState : { canUndo: false, batch: null, items: [] };
  const holidayAiUndoItems = Array.isArray(holidayAiUndo.items) ? holidayAiUndo.items : [];
  const holidayOrgTimeZone = typeof orgTimeZone !== 'undefined' ? String(orgTimeZone || '').trim() : '';
%>

<%- include('partials/tablePages-start', {
  title: 'School Holidays & Off Days',
  newUrl: 'school/holidays', // We will intercept this URL via JS below to open the modal
  newLabel: 'Add Holiday',
  user: user,
  tableName: 'Holidays_List',
  btn_export: true,
  print: true,
  headerManageBtns: [
    '<a href="' + schoolSectionDashboardHref + '" class="school-navigator-dashboard btn btn-filled btn-secondary btn-md mb-2"><i class="bi bi-speedometer2 me-1"></i> School Dashboard</a>',
    '<a href="/dashboard/section-nav/SCHOOL_ACADEMIA" class="school-navigator-dashboard btn btn-filled btn-secondary btn-md mb-2"><i class="bi bi-backpack2 me-1"></i> School Academia</a>'
  ],
  manageBtns: [
  ]
}) %>

<%- include('partials/tablePages-search', {
  placeholder: 'Search holidays...',
  fields: [
      { name: 'type', label: 'Type', type: 'select', options: ['National Holiday','Observance Paid','School Break','Staff Development','Weather Emergency','Other'] }
  ]
}) %>

<div class="bg-light border rounded px-4 py-3 mb-4 d-flex align-items-center justify-content-between gap-3 flex-wrap">
    <div class="d-flex align-items-center gap-3">
      <label class="fw-bold mb-0 text-dark"><i class="bi bi-calendar-range me-2"></i>Select Year:</label>
      <form id="yearForm" action="/school/holidays" method="GET" class="m-0">
          <select name="year" class="form-select form-select-sm border-secondary w-auto fw-bold" onchange="document.getElementById('yearForm').submit();">
              <% const holidayYearOptions = Array.isArray(yearOptions) && yearOptions.length ? yearOptions : [String(currentYear)]; %>
              <% holidayYearOptions.forEach((y) => { %>
                  <option value="<%= y %>" <%= currentYear == y ? 'selected' : '' %>><%= y %></option>
              <% }) %>
          </select>
      </form>
    </div>
    <div class="d-flex align-items-center gap-2">
      <button
        type="button"
        class="btn btn-outline-primary btn-sm fw-bold"
        id="btnOpenHolidayCopyYear"
        <%= copySourceYears.length ? '' : 'disabled' %>
        title="<%= copySourceYears.length ? 'Copy holidays from another year' : 'No other years with holiday data' %>">
        <i class="bi bi-copy me-1"></i>Copy Year
      </button>
      <button type="button" class="btn btn-outline-danger btn-sm fw-bold" id="btnOpenHolidayYearView">
        <i class="bi bi-calendar3 me-1"></i>Year View
      </button>
      <button
        type="button"
        class="btn btn-outline-success btn-sm fw-bold"
        id="btnOpenHolidayAiObservances"
        <%= holidayAiUsageAllowed ? '' : 'disabled' %>
        title="<%= !holidayAiUsageAllowed ? (holidayAiAccess.message || 'AI not available') : (!holidayAiAssignmentOk && holidayAiAssignmentMsg ? holidayAiAssignmentMsg : 'Suggest cultural observance dates with AI') %>">
        <i class="bi bi-stars me-1"></i>AI cultural observances
      </button>
    </div>
</div>

<div class="alert alert-light border small text-muted mb-3 py-2">
  Each <strong>occasion</strong> is its own row. Use the same date for multiple labels (e.g. statutory off day plus a cultural observance).
  Choose <strong>Cultural Observance (School Open)</strong> or uncheck <strong>School closed / off day</strong> when classes still run.
</div>
<% if (holidayAiUndo && holidayAiUndo.canUndo && holidayAiUndo.batch) { %>
<div class="alert alert-info border d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3" id="holidayAiUndoBanner">
  <div class="small">
    Last <strong>AI cultural observances</strong> import added
    <strong><%= Number(holidayAiUndo.batch.holidayCount || holidayAiUndo.batch.stats?.created || 0) %></strong> day(s).
    <% if (holidayAiUndo.batch.occasionInput) { %> (<span class="text-muted"><%= holidayAiUndo.batch.occasionInput %></span>)<% } %>
  </div>
  <button type="button" class="btn btn-outline-primary btn-sm fw-bold" id="btnHolidayAiReviewUndo" data-year="<%= currentYear %>">
    <i class="bi bi-list-check me-1"></i>Review last AI import
  </button>
</div>
<% } %>

<div class="table-scroll-wrapper" data-floating-row-actions="true">
    <table class="table-responsive size-md" id="first-table">
        <thead>
            <tr>
                <th class="draggable ps-4" data-column="date" style="width: 150px;">Date</th>
                <th class="draggable" data-column="title">Holiday / Event Title</th>
                <th class="draggable" data-column="type" style="width: 200px;">Type</th>
                <th class="draggable" data-column="statutoryHolidayPayable" style="width: 140px;">Stat Pay</th>
                <th class="draggable" data-column="notes">Notes</th>
                <th class="text-end pe-4" style="width: 150px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            <% if (data.length === 0) { %>
                <tr><td colspan="6" class="text-center py-5 text-muted">No holidays recorded for <%= currentYear %>.</td></tr>
            <% } else { %>
                <% data.forEach(item => { 
                    const holidayDateKey = String(item.date || '').trim().slice(0, 10);
                    const displayDate = (typeof formatOrgDate === 'function')
                      ? formatOrgDate(holidayDateKey, { weekday: 'short', month: 'short', day: 'numeric' })
                      : holidayDateKey;
                %>
                <tr data-holiday-id="<%= item.id %>">
                    <td class="ps-4 fw-bold text-dark holiday-date-open text-primary" style="cursor:pointer;" role="button" tabindex="0" data-holiday-date="<%= holidayDateKey %>" data-sort-value="<%= item.date %>" title="Manage occasions on this date"><%= displayDate %></td>
                    <td class="fw-bold text-primary"><%= item.title %></td>
                    <td>
                        <% 
                           let badgeClass = 'bg-secondary';
                           if(item.type === 'National Holiday') badgeClass = 'bg-primary';
                           if(item.type === 'Observance Paid') badgeClass = 'bg-success';
                           if(item.type === 'School Break') badgeClass = 'bg-info text-dark';
                           if(item.type === 'Weather Emergency') badgeClass = 'bg-danger';
                        %>
                        <span class="badge <%= badgeClass %>"><%= item.type %></span>
                        <% if (item.countsAsSchoolOff === false) { %>
                          <span class="badge bg-info-subtle text-info border ms-1">School open</span>
                        <% } %>
                    </td>
                    <td>
                        <% if (item.statutoryHolidayPayable === true) { %>
                            <span class="badge bg-success-subtle text-success border border-success">Payable</span>
                        <% } else if (item.statutoryHolidayPayable === false) { %>
                            <span class="badge bg-light text-muted border">Not payable</span>
                        <% } else { %>
                            <span class="badge bg-secondary-subtle text-secondary border">By type</span>
                        <% } %>
                    </td>
                    <td class="text-muted small text-truncate" style="max-width: 250px;"><%= item.notes || '-' %></td>
                    <td class="table-actions text-end pe-4">
                        <div class="row-actions-wrap">
                          <button
                            type="button"
                            class="btn btn-secondary btn-sm btn-row-actions-toggle"
                            data-row-actions-id="<%= item.id %>"
                            title="Holiday Actions">
                            <i class="bi bi-three-dots-vertical"></i>
                          </button>
                          <div class="row-actions-menu d-none" data-row-actions-id="<%= item.id %>">
                            <button class="btn btn-outline-info btn-sm"
                                onclick="openHolidayDaySession('<%= item.date %>')">
                                <i class="bi bi-pencil-square me-2"></i>Edit day
                            </button>
                            <button class="btn btn-outline-danger btn-sm delete-btn" data-id="<%= item.id %>">
                                <i class="bi bi-trash me-2"></i>Delete
                            </button>
                          </div>
                        </div>
                    </td>
                </tr>
                <% }) %>
            <% } %>
        </tbody>
    </table>
</div>

<%- include('partials/tablePages-end') %>

