                if (holidayDaySession?.mode !== 'daySession' || !isSessionDirty()) return;
                event.preventDefault();
                requestCloseHolidayModal();
            });
            holidayModalEl.addEventListener('hidden.bs.modal', () => {
                holidayModalEl.classList.remove('holiday-modal-above-year');
                document.body.classList.remove('holiday-edit-over-year');
