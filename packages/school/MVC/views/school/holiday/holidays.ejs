                return;
            }
            const year = String(document.getElementById('holidayAiYear')?.value || '').trim();
            const occasions = String(document.getElementById('holidayAiOccasions')?.value || '').trim();
            const regionHint = String(document.getElementById('holidayAiRegionHint')?.value || '').trim();
            if (!occasions) {
                if (typeof showMessageModal === 'function') {
