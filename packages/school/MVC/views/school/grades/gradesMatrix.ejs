<script>
document.addEventListener('DOMContentLoaded', () => {
  function bindCollapseToggle(options = {}) {
    const collapseEl = document.getElementById(String(options.collapseId || ''));
    const buttonEl = document.getElementById(String(options.buttonId || ''));
    const iconEl = document.getElementById(String(options.iconId || ''));
    if (!collapseEl || !buttonEl || !iconEl) return;
    const setState = (open) => {
      iconEl.className = open ? 'bi bi-chevron-up' : 'bi bi-chevron-down';
      buttonEl.setAttribute('aria-expanded', open ? 'true' : 'false');
      buttonEl.setAttribute('aria-label', open ? 'Close filters' : 'Open filters');
    };
    setState(collapseEl.classList.contains('show'));
    collapseEl.addEventListener('shown.bs.collapse', () => setState(true));
    collapseEl.addEventListener('hidden.bs.collapse', () => setState(false));
  }
  bindCollapseToggle({
    collapseId: 'gmFilterCollapse',
    buttonId: 'gmFilterToggleBtn',
    iconId: 'gmFilterToggleIcon'
  });
  bindCollapseToggle({
    collapseId: 'gmEvalCollapse',
    buttonId: 'gmEvalToggleBtn',
    iconId: 'gmEvalToggleIcon'
  });

  const INITIAL = <%- JSON.stringify({
    classId: typeof initialClassId !== 'undefined' ? initialClassId : '',
    className: typeof initialClassName !== 'undefined' ? initialClassName : '',
    startDate: typeof initialStartDate !== 'undefined' ? initialStartDate : '',
    endDate: typeof initialEndDate !== 'undefined' ? initialEndDate : '',
    range: typeof initialRange !== 'undefined' ? initialRange : ''
  }).replace(/</g, '\\u003c').replace(/&/g, '\\u0026') %>;

  window.currentGradesMatrixData = null;
  let gmOpenCalcPersonId = '';
  let gmRollupRecalcTimer = null;

  function gmIncludedColumns(columns) {
    return (Array.isArray(columns) ? columns : []).filter((col) => col && col.includeInGradeCalculation !== false);
  }

  function gmWeightSum(columns) {
    return gmIncludedColumns(columns).reduce((sum, col) => {
      const w = Number(col?.weight);
      return sum + (Number.isFinite(w) && w > 0 ? w : 0);
    }, 0);
  }

  function gmRelativeWeightPercent(col, columns) {
    const w = Number(col?.weight);
    const sum = gmWeightSum(columns);
    if (!Number.isFinite(w) || w <= 0 || !sum) return null;
    return Math.round((w / sum) * 10000) / 100;
  }

  function setGmWeightDirty(dirty) {
    const data = window.currentGradesMatrixData;
    if (data) data.weightDirty = Boolean(dirty);
    const btn = document.getElementById('gm_btnSaveWeights');
    if (btn) btn.disabled = !dirty;
  }

  function updateGmEvalFormula(columns) {
    const el = document.getElementById('gm_evalFormula');
    if (!el) return;
    const sum = gmWeightSum(columns);
    const sumLabel = sum ? String(sum) : '0';
    el.innerHTML = [
      '<div class="mb-1"><strong>Reference formula</strong> (when all included activities apply to the student):</div>',
      `<div><code>W = ${gmEscapeAttr(sumLabel)}</code> (sum of activity weights in this period)</div>`,
      '<div><code>w&#8242;<sub>i</sub> = (w<sub>i</sub> / W) × 100%</code> (renormalized weight)</div>',
      '<div><code>Final = Σ (w&#8242;<sub>i</sub> × p<sub>i</sub>)</code> where <code>p<sub>i</sub></code> is activity %; absent/missing → 0%; N/A excluded per student.</div>'
    ].join('');
  }

  function buildGmEvalWeightRowHtml(col, columns) {
    const rel = gmRelativeWeightPercent(col, columns);
    const relText = rel == null ? '—' : formatGmPercent(rel);
    const excl = col.includeInGradeCalculation === false
      ? '<span class="badge bg-secondary">excl.</span>'
      : '';
    const disabled = col.includeInGradeCalculation === false ? 'disabled' : '';
    const weightVal = Number(col.weight) > 0 ? Number(col.weight) : '';
    return `<tr data-col-key="${gmEscapeAttr(col.colKey || '')}">
      <td class="fw-semibold">
        <span class="d-inline-flex align-items-center gap-1">
          <span>${gmEscapeAttr(col.label || 'Activity')}</span>
          ${col.colKey ? `<button type="button" class="btn btn-link btn-sm p-0 gm-col-info-btn" title="Activity details" data-col-key="${gmEscapeAttr(col.colKey)}"><i class="bi bi-info-circle text-primary"></i></button>` : ''}
        </span>
      </td>
      <td>${gmEscapeAttr(col.date || '—')}</td>
      <td>${gmEscapeAttr(col.kindLabel || col.kind || '—')}</td>
      <td><input type="number" class="form-control form-control-sm gm-eval-weight-input" min="0.01" step="0.01" value="${weightVal}" data-col-key="${gmEscapeAttr(col.colKey || '')}" ${disabled}></td>
      <td class="gm-eval-rel-weight">${relText}</td>
      <td>${excl}</td>
    </tr>`;
  }

  function renderGmEvalWeightsTable(columns, options = {}) {
    const tbody = document.getElementById('gm_evalWeightsBody');
    if (!tbody) return;
    const list = Array.isArray(columns) ? columns : [];
    if (!list.length) {
      tbody.innerHTML = '<tr><td colspan="6" class="text-muted">No activities in range.</td></tr>';
      updateGmEvalFormula([]);
      return;
    }
    if (options.append) {
      const existing = new Set(Array.from(tbody.querySelectorAll('tr[data-col-key]')).map((tr) => tr.getAttribute('data-col-key')));
      const rows = list.filter((col) => col?.colKey && !existing.has(col.colKey))
        .map((col) => buildGmEvalWeightRowHtml(col, list))
        .join('');
      if (rows) tbody.insertAdjacentHTML('beforeend', rows);
    } else {
      tbody.innerHTML = list.map((col) => buildGmEvalWeightRowHtml(col, list)).join('');
    }
    updateGmEvalFormula(list);
    setGmWeightDirty(list.some((col) => Number(col.weight) !== Number(col._savedWeight)));
  }

  function updateGmEvalWeightsRelativeCells(columns) {
    document.querySelectorAll('#gm_evalWeightsTable tbody tr[data-col-key]').forEach((tr) => {
      const key = tr.getAttribute('data-col-key');
      const col = (columns || []).find((c) => c.colKey === key);
      const relTd = tr.querySelector('.gm-eval-rel-weight');
      if (relTd && col) relTd.textContent = formatGmPercent(gmRelativeWeightPercent(col, columns));
    });
  }

  function updateGmColumnHeadWeights(columns) {
    const thead = document.getElementById('gm_thead');
    if (!thead || !thead.rows[1]) return;
    const heads = thead.rows[1].querySelectorAll('th.gm-col-head');
    (columns || []).forEach((col, idx) => {
      if (heads[idx]) heads[idx].innerHTML = renderGmColumnHeadHtml(col);
    });
  }

  function onGmWeightInputChange(colKey, value) {
    const data = window.currentGradesMatrixData;
    if (!data) return;
    const col = (data.columns || []).find((c) => String(c.colKey || '') === String(colKey || ''));
    if (!col || col.includeInGradeCalculation === false) return;
    const weight = Number(value);
    if (!Number.isFinite(weight) || weight <= 0) return;
    col.weight = weight;
    setGmWeightDirty((data.columns || []).some((c) => Number(c.weight) !== Number(c._savedWeight)));
    updateGmEvalFormula(data.columns);
    updateGmEvalWeightsRelativeCells(data.columns);
    updateGmColumnHeadWeights(data.columns);
    scheduleGmLiveRollupRecalc();
  }

  function scheduleGmLiveRollupRecalc() {
    clearTimeout(gmRollupRecalcTimer);
    gmRollupRecalcTimer = setTimeout(() => refreshGradesDisplayRollups(), 50);
  }

  async function saveGmActivityWeights() {
    const data = window.currentGradesMatrixData;
    if (!data?.classId || !data.weightDirty) return;
    const updates = (data.columns || [])
      .filter((col) => col && Number(col.weight) !== Number(col._savedWeight))
      .map((col) => ({
        sessionId: col.sessionId,
        kind: col.kind,
        itemId: col.itemId,
        weight: Number(col.weight)
      }));
    if (!updates.length) return;
    const btn = document.getElementById('gm_btnSaveWeights');
    const orig = btn ? btn.innerHTML : '';
    if (btn) {
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
    }
    try {
      const res = await fetch('/school/grades-matrix/api/save-activity-weights', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-AJAX-Request': 'true' },
        body: JSON.stringify({ classId: data.classId, updates })
      });
      const result = await res.json();
      if (result.status !== 'success') throw new Error(result.message || 'Save failed');
      (data.columns || []).forEach((col) => {
        col._savedWeight = Number(col.weight);
      });
      setGmWeightDirty(false);
      if (typeof showMessageModal === 'function') {
        showMessageModal({ title: 'Saved', icon: 'success', message: `Saved ${result.saved || updates.length} activity weight(s).`, buttons: [{ text: 'OK', class: 'btn-primary' }] });
      }
    } catch (e) {
      if (typeof showMessageModal === 'function') {
        showMessageModal({ title: 'Error', icon: 'error', message: e.message, buttons: [{ text: 'OK', class: 'btn-secondary' }] });
      } else {
        alert(e.message);
      }
    } finally {
      if (btn) {
        btn.innerHTML = orig;
        btn.disabled = !window.currentGradesMatrixData?.weightDirty;
      }
    }
  }

  function setGradesPrintEnabled(enabled) {
    const btn = document.getElementById('btn_printGradesMatrix');
    if (!btn) return;
    btn.disabled = !enabled;
    btn.title = enabled ? 'Print grades matrix for the loaded range' : 'Load the matrix first';
  }

  const toYmd = (d) => {
    if (!d) return '';
    const y = d.getFullYear();
    const m = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');
    return `${y}-${m}-${day}`;
  };
  const startOfLocalDay = (d) => new Date(d.getFullYear(), d.getMonth(), d.getDate());

  function setActiveRangeChip(range) {
    document.querySelectorAll('.gm-range.range-chip').forEach((btn) => {
      btn.classList.toggle('active', btn.getAttribute('data-range') === range);
    });
  }

  function setRange(range) {
    const today = new Date();
    let start; let end;
    if (range === 'today') {
      start = startOfLocalDay(today);
      end = new Date(start);
    } else if (range === 'twoWeeks') {
      const day = today.getDay() || 7;
      start = startOfLocalDay(today);
      start.setDate(today.getDate() - (day - 1));
      end = new Date(start);
      end.setDate(start.getDate() + 13);
    } else if (range === 'thisWeek') {
      const day = today.getDay() || 7;
      start = startOfLocalDay(today);
      start.setDate(today.getDate() - (day - 1));
      end = new Date(start);
      end.setDate(start.getDate() + 6);
    } else if (range === 'thisMonth') {
      start = new Date(today.getFullYear(), today.getMonth(), 1);
      end = new Date(today.getFullYear(), today.getMonth() + 1, 0);
    } else if (range === 'allTime') {
      document.getElementById('gm_startDate').value = '';
      document.getElementById('gm_endDate').value = '';
      setActiveRangeChip(range);
      return;
    } else return;
    document.getElementById('gm_startDate').value = toYmd(start);
    document.getElementById('gm_endDate').value = toYmd(end);
    setActiveRangeChip(range);
  }

  document.querySelectorAll('.gm-range').forEach((btn) => {
    btn.addEventListener('click', () => {
      setRange(btn.getAttribute('data-range'));
      if (document.getElementById('gm_classId').value) document.getElementById('gm_btnLoad').click();
    });
  });

  document.getElementById('gm_btnClearClass')?.addEventListener('click', () => {
    document.getElementById('gm_classId').value = '';
    document.getElementById('gm_className').value = '';
    document.getElementById('gm_results').classList.add('d-none');
    document.getElementById('gm_evalCard').classList.add('d-none');
    window.currentGradesMatrixData = null;
    setGradesPrintEnabled(false);
  });

  document.getElementById('gm_btnReset')?.addEventListener('click', () => {
    document.getElementById('gm_classId').value = '';
    document.getElementById('gm_className').value = '';
    document.getElementById('gm_startDate').value = '';
    document.getElementById('gm_endDate').value = '';
    document.getElementById('gm_results').classList.add('d-none');
    document.getElementById('gm_evalCard').classList.add('d-none');
    window.currentGradesMatrixData = null;
    setGradesPrintEnabled(false);
    setActiveRangeChip('');
  });

  if (INITIAL.classId) {
    document.getElementById('gm_classId').value = INITIAL.classId;
    document.getElementById('gm_className').value = INITIAL.className || '';
    document.getElementById('gm_startDate').value = INITIAL.startDate || '';
    document.getElementById('gm_endDate').value = INITIAL.endDate || '';
    if (INITIAL.range) setActiveRangeChip(INITIAL.range);
  }

  document.getElementById('gm_btnClassPicker').addEventListener('click', () => {
    if (!window.GenericPicker || !window.GenericPickerPresets) return;
    GenericPicker.open(GenericPickerPresets.class({
      title: 'Select class',
      icon: 'bi-book',
      onSelect: (item) => {
        document.getElementById('gm_classId').value = item.id;
        document.getElementById('gm_className').value = item.title || item.id;
        document.getElementById('gm_btnLoad').click();
      }
    }));
  });

  function gmEscapeAttr(value) {
    return String(value == null ? '' : value)
      .replace(/&/g, '&amp;')
      .replace(/"/g, '&quot;')
      .replace(/</g, '&lt;');
  }

  function formatGmColumnWeightLabel(col) {
    if (!col || typeof col !== 'object') return null;
    const kind = String(col.kind || '').trim().toLowerCase();
    const explicit = kind === 'gradebook' ? Number(col._explicitWeight) : NaN;
    if (kind === 'gradebook' && Number.isFinite(explicit) && explicit > 0) {
      return { text: `W ${explicit}%`, title: 'Percent of final grade' };
    }
    const weight = Number(col.weight);
    const total = Number(col.totalScore);
    const pts = Number.isFinite(weight) && weight > 0
      ? weight
      : (Number.isFinite(total) && total > 0 ? total : 0);
    if (!pts) return null;
    return { text: `${pts} pts`, title: 'Points used in category average weighting' };
  }

  function gmBuildSessionManageUrl(classId, sessionId) {
    const cid = String(classId || '').trim();
    const sid = String(sessionId || '').trim();
    if (!cid || !sid) return '';
    return `/school/classes/${encodeURIComponent(cid)}/sessions/${encodeURIComponent(sid)}`;
  }

  function gmFormatSessionTimeLabel(value) {
    const raw = String(value || '').trim();
    if (!raw) return '';
    const match = /^(\d{1,2}):(\d{2})(?::\d{2})?$/.exec(raw);
    if (!match) return raw;
    const hours = Number(match[1]);
    const minutes = match[2];
    if (!Number.isFinite(hours)) return raw;
    const suffix = hours >= 12 ? 'PM' : 'AM';
    const hour12 = ((hours + 11) % 12) + 1;
    return `${hour12}:${minutes} ${suffix}`;
  }

  function gmFormatWeightValue(col, weightValue) {
    const kind = String(col?.kind || '').trim().toLowerCase();
    const explicit = kind === 'gradebook' ? Number(col?._explicitWeight) : NaN;
    const weight = Number(weightValue);
    if (!Number.isFinite(weight) || weight <= 0) return '—';
    if (kind === 'gradebook' && Number.isFinite(explicit) && explicit > 0) {
      return `${weight}% of grade`;
    }
    return `${weight} pts`;
  }

  function renderGmColumnInfoButton(col) {
    const key = String(col?.colKey || '').trim();
    if (!key) return '';
    return `<button type="button" class="btn btn-link btn-sm p-0 gm-col-info-btn flex-shrink-0" title="Activity details" data-col-key="${gmEscapeAttr(key)}"><i class="bi bi-info-circle text-primary"></i></button>`;
  }

  function renderGmColumnHeadHtml(col) {
    const labelLine = `<div class="text-dark text-truncate fw-semibold" title="${gmEscapeAttr(col.label)}">${gmEscapeAttr(col.label)}</div>`;
    return `<div class="d-inline-flex align-items-center justify-content-center gap-1 w-100">${labelLine}${renderGmColumnInfoButton(col)}</div>`;
  }

  function gmActivityDetailTile(label, valueHtml) {
    return `<div class="gm-activity-tile"><div class="gm-activity-tile-label">${gmEscapeAttr(label)}</div><div class="gm-activity-tile-value">${valueHtml}</div></div>`;
  }

  function renderGmActivityModalBody(col, matrixData = {}) {
    if (!col) return '<p class="text-muted mb-0">Activity details are not available.</p>';
    const savedWeight = col._savedWeight != null ? Number(col._savedWeight) : Number(col.weight);
    const currentWeight = Number(col.weight);
    const weightChanged = Number.isFinite(savedWeight) && Number.isFinite(currentWeight) && savedWeight !== currentWeight;
    const relPct = gmRelativeWeightPercent(col, matrixData.columns || []);
    const sessionTime = gmFormatSessionTimeLabel(col.sessionStartTime);
    const kindLabel = String(col.kindLabel || col.kind || 'Activity');
    const parts = [];

    const metaBits = [
      gmFormatDisplayDate(col.date),
      sessionTime || null,
      col.totalScore != null && Number(col.totalScore) > 0 ? `${col.totalScore} pts` : null
    ].filter(Boolean);
    parts.push('<div class="gm-activity-summary">');
    parts.push('<div class="gm-activity-summary-top">');
    parts.push(`<div class="gm-activity-summary-title">${gmEscapeAttr(col.label || 'Activity')}</div>`);
    parts.push(`<span class="badge rounded-pill text-bg-primary">${gmEscapeAttr(kindLabel)}</span>`);
    parts.push('</div>');
    parts.push(`<div class="gm-activity-summary-meta">${gmEscapeAttr(metaBits.join(' · ') || '—')}</div>`);
    parts.push('</div>');

    parts.push('<section class="gm-activity-section"><h6 class="gm-activity-section-title">Weights & scoring</h6><div class="gm-activity-grid">');
    parts.push(gmActivityDetailTile('Saved weight', gmEscapeAttr(gmFormatWeightValue(col, savedWeight))));
    parts.push(gmActivityDetailTile('Current weight', `${gmEscapeAttr(gmFormatWeightValue(col, currentWeight))}${weightChanged ? ' <span class="badge bg-warning text-dark ms-1">edited</span>' : ''}`));
    parts.push(gmActivityDetailTile('Relative %', relPct == null ? '—' : gmEscapeAttr(formatGmPercent(relPct))));
    parts.push(gmActivityDetailTile('Grade calculation', col.includeInGradeCalculation === false
      ? '<span class="badge bg-secondary">Excluded</span>'
      : '<span class="badge bg-success">Included</span>'));
    if (col.sessionStatus) {
      parts.push(gmActivityDetailTile('Session status', gmEscapeAttr(col.sessionStatus)));
    }
    parts.push('</div></section>');

    if (Array.isArray(col.skills) && col.skills.length) {
      parts.push('<section class="gm-activity-section"><h6 class="gm-activity-section-title">Skills</h6><div class="gm-activity-skill-list">');
      col.skills.forEach((skill) => {
        parts.push(`<span class="badge bg-light text-dark border">${gmEscapeAttr(skill)}</span>`);
      });
      parts.push('</div></section>');
    }
    if (col.skillFocus) {
      parts.push(`<section class="gm-activity-section"><h6 class="gm-activity-section-title">Skill focus</h6><div class="gm-activity-tile-value">${gmEscapeAttr(col.skillFocus)}</div></section>`);
    }

    const content = String(col.activityContent || '').trim();
    parts.push('<section class="gm-activity-section"><h6 class="gm-activity-section-title">Activity content / instructions</h6>');
    parts.push(content
      ? `<div class="gm-activity-content-box">${gmEscapeAttr(content)}</div>`
      : '<p class="text-muted mb-0 fst-italic">No activity description.</p>');
    parts.push('</section>');

    const attachments = Array.isArray(col.attachments) ? col.attachments : [];
    parts.push('<section class="gm-activity-section mb-0"><h6 class="gm-activity-section-title">Attachments</h6>');
    if (attachments.length) {
      parts.push('<ul class="gm-activity-attachment-list">');
      attachments.forEach((file) => {
        const name = String(file?.name || 'Attachment');
        const url = String(file?.url || '').trim();
        if (!url) return;
        parts.push(`<li><a href="${gmEscapeAttr(url)}" target="_blank" rel="noopener"><i class="bi bi-paperclip"></i><span>${gmEscapeAttr(name)}</span></a></li>`);
      });
      parts.push('</ul>');
    } else {
      parts.push('<p class="text-muted mb-0 fst-italic">No attachments.</p>');
    }
    parts.push('</section>');

    return parts.join('');
  }

  function openGmActivityModal(colKey) {
    const data = window.currentGradesMatrixData;
    const key = String(colKey || '').trim();
    const col = (Array.isArray(data?.columns) ? data.columns : []).find((item) => String(item?.colKey || '') === key);
    const bodyEl = document.getElementById('gmActivityModalBody');
    const titleEl = document.getElementById('gmActivityModalTitle');
    const sessionLinkEl = document.getElementById('gmActivityModalSessionLink');
    if (!col || !bodyEl) return;
    if (titleEl) {
      titleEl.innerHTML = `<i class="bi bi-journal-text me-2"></i>${gmEscapeAttr(col.label || 'Activity')}`;
    }
    bodyEl.innerHTML = renderGmActivityModalBody(col, data);
    const sessionUrl = gmBuildSessionManageUrl(data?.classId, col.sessionId);
    if (sessionLinkEl) {
      if (sessionUrl) {
        sessionLinkEl.href = sessionUrl;
        sessionLinkEl.classList.remove('d-none');
      } else {
        sessionLinkEl.href = '#';
        sessionLinkEl.classList.add('d-none');
      }
    }
    if (gmActivityModalInstance) gmActivityModalInstance.show();
  }

  function renderGmCommentButton(cell, col, studentName) {
    if (!cell?.comment) return '';
    const activityLabel = String(col?.label || 'Activity');
    return `<button type="button" class="btn btn-link btn-sm p-0 ms-1 gm-comment-btn" title="View comment" data-student-name="${gmEscapeAttr(studentName)}" data-activity-label="${gmEscapeAttr(activityLabel)}" data-comment="${encodeURIComponent(cell.comment)}"><i class="bi bi-chat-left-text-fill text-primary"></i></button>`;
  }

  function renderCellHtml(c, col, studentName) {
    const commentBtn = renderGmCommentButton(c, col, studentName);
    if (!c) return commentBtn || '—';
    if (c.notApplicable || c.attendanceStatus === 'not_applicable') {
      return '<span class="text-muted small">N/A</span>';
    }
    if (c.absent) {
      const label = c.attendanceStatus === 'acf' ? 'ACF' : 'Absent';
      const wrapCls = c.effective ? 'gm-cell-effective' : 'gm-cell-excluded';
      return `<span class="text-muted small ${wrapCls}">${label}</span>`;
    }
    if (c.score == null || c.score === '') {
      if (c.effective) {
        return `<span class="gm-cell-effective text-muted small" title="Counts as 0% in period average">—</span>${commentBtn}`;
      }
      return commentBtn || '—';
    }
    const pct = c.percent != null ? `<span class="gm-pct small ms-1">${c.percent}%</span>` : '';
    const incl = c.includeInGradeCalculation !== false;
    const eff = !!c.effective;
    const wrapCls = eff ? 'gm-cell-effective' : 'gm-cell-excluded';
    const badge = !incl ? '<span class="badge bg-secondary ms-1" title="Excluded in session activity">excl.</span>' : '';
    return `<div class="${wrapCls} d-inline-flex align-items-center justify-content-center flex-wrap gap-1"><span class="gm-score">${c.score}</span>${pct}${badge}${commentBtn}</div>`;
  }

  function bandClass(band) {
    const b = Number(band) || 0;
    return `gm-band-${Math.abs(b) % 4}`;
  }

  /** Attendance / final % display — one decimal, trim trailing .0 */
  function formatGmPercent(val) {
    if (val == null || val === '' || Number.isNaN(Number(val))) return '—';
    const n = Number(val);
    const t = Math.round(n * 10) / 10;
    const s = t % 1 === 0 ? String(t) : t.toFixed(1);
    return `${s}%`;
  }

  function gmCalcStatusLabel(status) {
    const map = {
      scored: 'Scored',
      absent: 'Absent (0%)',
      missing: 'Missing (0%)',
      not_applicable: 'N/A'
    };
    return map[String(status || '').trim()] || String(status || '—');
  }

  function gmCalcStatusBadge(status) {
    const key = String(status || '').trim();
    const cls = {
      scored: 'text-bg-success',
      absent: 'text-bg-warning',
      missing: 'text-bg-secondary',
      not_applicable: 'text-bg-light text-dark border'
    }[key] || 'text-bg-secondary';
    return `<span class="badge gm-calc-status-badge ${cls}">${gmEscapeAttr(gmCalcStatusLabel(key))}</span>`;
  }

  function gmCalcStepSection(stepNum, title, bodyHtml) {
    return `<section class="gm-calc-step"><div class="gm-calc-step-head"><span class="gm-calc-step-num">${stepNum}</span><h6 class="gm-calc-step-title">${gmEscapeAttr(title)}</h6></div><div class="gm-calc-step-body">${bodyHtml}</div></section>`;
  }

  function renderGmGradeCalcButton(personId) {
    const id = String(personId || '').trim();
    if (!id) return '';
    return `<button type="button" class="btn btn-link btn-sm p-0 gm-calc-btn" title="View grade calculation" data-person-id="${gmEscapeAttr(id)}"><i class="bi bi-info-circle text-primary"></i></button>`;
  }

  function renderGmGradeCalcModalBody(breakdown, meta = {}) {
    if (!breakdown) {
      return '<p class="text-muted mb-0 fs-5">No calculation breakdown is available for this student.</p>';
    }
    const assignments = breakdown.assignments || {};
    const applicable = Array.isArray(assignments.applicableActivities) ? assignments.applicableActivities : [];
    const excluded = Array.isArray(assignments.excludedActivities) ? assignments.excludedActivities : [];
    const notApplicable = Array.isArray(assignments.notApplicableActivities) ? assignments.notApplicableActivities : [];
    const parts = [];

    const rangeParts = [meta.startDate, meta.endDate].filter(Boolean);
    const rangeLabel = rangeParts.length ? rangeParts.join(' to ') : 'Selected date range';
    parts.push(`<div class="gm-calc-summary"><div class="row g-3"><div class="col-md-6"><div class="gm-calc-summary-label">Student</div><div class="gm-calc-summary-value">${gmEscapeAttr(meta.studentName || '—')}</div></div><div class="col-md-6"><div class="gm-calc-summary-label">Period</div><div class="gm-calc-summary-value" style="font-size:1.05rem;">${gmEscapeAttr(rangeLabel)}</div>${meta.className ? `<div class="gm-calc-summary-meta">${gmEscapeAttr(meta.className)}</div>` : ''}</div></div></div>`);

    if (meta.hasMoreColumns) {
      parts.push('<div class="alert alert-warning py-3 mb-3">Breakdown covers loaded activities in this view; load all columns for the full period.</div>');
    }

    let step1Body = '';
    if (!applicable.length) {
      step1Body = '<p class="text-muted mb-0">No applicable activities in this period for this student.</p>';
    } else {
      step1Body += '<div class="table-responsive"><table class="table table-bordered gm-calc-table mb-0"><thead><tr><th>Activity</th><th>Date</th><th>Kind</th><th>Weight</th><th>Status</th><th>Score</th><th>Activity %</th></tr></thead><tbody>';
      applicable.forEach((row) => {
        const scoreText = row.score != null && row.totalScore
          ? `${row.score}/${row.totalScore}`
          : '—';
        step1Body += `<tr><td class="fw-semibold">${gmEscapeAttr(row.label)}</td><td>${gmEscapeAttr(row.date || '—')}</td><td>${gmEscapeAttr(row.kindLabel || row.kind || '—')}</td><td class="gm-calc-num">${row.originalWeight}</td><td>${gmCalcStatusBadge(row.status)}</td><td class="gm-calc-num">${gmEscapeAttr(scoreText)}</td><td class="gm-calc-num">${formatGmPercent(row.activityPercent)}</td></tr>`;
      });
      step1Body += '</tbody></table></div>';
    }
    if (notApplicable.length) {
      step1Body += '<div class="gm-calc-list-title">Not applicable for this student (excluded from weight sum)</div><ul class="gm-calc-list">';
      notApplicable.forEach((row) => {
        step1Body += `<li>${gmEscapeAttr(row.label)}${row.date ? ` (${gmEscapeAttr(row.date)})` : ''}</li>`;
      });
      step1Body += '</ul>';
    }
    if (excluded.length) {
      step1Body += '<div class="gm-calc-list-title">Excluded from grade calculation (activity setting)</div><ul class="gm-calc-list">';
      excluded.forEach((row) => {
        step1Body += `<li>${gmEscapeAttr(row.label)}${row.date ? ` (${gmEscapeAttr(row.date)})` : ''}</li>`;
      });
      step1Body += '</ul>';
    }
    parts.push(gmCalcStepSection(1, 'Applicable activities', step1Body));

    let step2Body = '';
    if (applicable.length) {
      const weightSum = Number(assignments.weightSum) || 0;
      const renormNote = assignments.renormalizedTo100
        ? `Activity weights sum to <strong>${weightSum}</strong> (not 100). Each weight is renormalized relative to this student's applicable total so contributions add up to 100%.`
        : `Activity weights sum to <strong>${weightSum}</strong>.`;
      step2Body += `<p class="gm-calc-step-note mb-3">${renormNote}</p>`;
      step2Body += '<div class="table-responsive"><table class="table table-bordered gm-calc-table mb-0"><thead><tr><th>Activity</th><th>Original weight</th><th>Normalized %</th></tr></thead><tbody>';
      applicable.forEach((row) => {
        step2Body += `<tr><td class="fw-semibold">${gmEscapeAttr(row.label)}</td><td class="gm-calc-num">${row.originalWeight}</td><td class="gm-calc-num">${formatGmPercent(row.normalizedWeightPercent)}</td></tr>`;
      });
      step2Body += '</tbody></table></div>';
    } else {
      step2Body = '<p class="text-muted mb-0">No weights to normalize.</p>';
    }
    parts.push(gmCalcStepSection(2, 'Renormalize weights', step2Body));

    let step3Body = '';
    if (applicable.length) {
      step3Body += '<p class="gm-calc-formula mb-3">Contribution = Activity % × Normalized weight</p>';
      step3Body += '<div class="table-responsive"><table class="table table-bordered gm-calc-table mb-0"><thead><tr><th>Activity</th><th>Activity %</th><th>Normalized weight</th><th>Contribution</th></tr></thead><tbody>';
      applicable.forEach((row) => {
        step3Body += `<tr><td class="fw-semibold">${gmEscapeAttr(row.label)}</td><td class="gm-calc-num">${formatGmPercent(row.activityPercent)}</td><td class="gm-calc-num">${formatGmPercent(row.normalizedWeightPercent)}</td><td class="gm-calc-num text-success">${formatGmPercent(row.contributionPercent)}</td></tr>`;
      });
      step3Body += '</tbody></table></div>';
    } else {
      step3Body = '<p class="text-muted mb-0">No activity contributions.</p>';
    }
    parts.push(gmCalcStepSection(3, 'Activity contributions', step3Body));

    parts.push(gmCalcStepSection(4, 'Final score', `<div class="gm-calc-total-box is-final"><span class="gm-calc-total-label">Final score (period-weighted)</span><span class="gm-calc-total">${formatGmPercent(assignments.assignmentsPercent)}</span></div>`));

    return parts.join('');
  }

  function openGmGradeCalcModal(personId) {
    gmOpenCalcPersonId = String(personId || '').trim();
    const data = window.currentGradesMatrixData;
    const row = (Array.isArray(data?.matrix) ? data.matrix : []).find((item) => String(item?.personId || '') === String(personId || ''));
    const bodyEl = document.getElementById('gmGradeCalcModalBody');
    const titleEl = document.getElementById('gmGradeCalcModalTitle');
    if (!row || !bodyEl) return;
    if (titleEl) {
      titleEl.innerHTML = `<i class="bi bi-calculator me-2"></i>Grade calculation — ${gmEscapeAttr(row.name || 'Student')}`;
    }
    bodyEl.innerHTML = renderGmGradeCalcModalBody(row.gradeCalculationBreakdown, {
      studentName: row.name,
      className: data?.className,
      startDate: document.getElementById('gm_startDate')?.value || '',
      endDate: document.getElementById('gm_endDate')?.value || '',
      hasMoreColumns: Boolean(gmMatrixWindowState.hasMoreColumns)
    });
    if (gmGradeCalcModalInstance) gmGradeCalcModalInstance.show();
  }

  let gmLoadSeq = 0;
  let gmLoadAbort = null;
  const GM_STUDENT_WINDOW = 50;
  const GM_COLUMN_WINDOW = 40;
  const gmMatrixWindowState = {
    loadedStudents: 0,
    loadedColumns: 0,
    hasMoreStudents: false,
    hasMoreColumns: false,
    loading: false
  };

  function buildGmColumnGroups(columns) {
    const groups = [];
    let i = 0;
    while (i < columns.length) {
      const col = columns[i];
      const d = col.date;
      const sessionId = String(col?.sessionId || '').trim();
      let j = i;
      while (
        j < columns.length
        && columns[j].date === d
        && String(columns[j]?.sessionId || '').trim() === sessionId
      ) j += 1;
      groups.push({
        date: d,
        sessionId,
        sessionStartTime: col?.sessionStartTime || '',
        start: i,
        len: j - i
      });
      i = j;
    }
    return groups;
  }

  function gmFormatDisplayDate(ymd) {
    const raw = String(ymd || '').trim();
    if (!/^\d{4}-\d{2}-\d{2}$/.test(raw)) return raw || '—';
    const d = new Date(`${raw}T00:00:00`);
    if (Number.isNaN(d.getTime())) return raw;
    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  }

  function gmFormatDateGroupLabel(group, columns) {
    const date = gmFormatDisplayDate(group?.date || columns?.[group?.start]?.date || '—');
    const timeLabel = gmFormatSessionTimeLabel(group?.sessionStartTime || columns?.[group?.start]?.sessionStartTime || '');
    return timeLabel ? `${date} · ${timeLabel}` : date;
  }

  function renderGmDateGroupHeaderHtml(group, columns, classId) {
    const label = gmFormatDateGroupLabel(group, columns);
    const sessionId = String(group?.sessionId || columns?.[group?.start]?.sessionId || '').trim();
    const url = gmBuildSessionManageUrl(classId, sessionId);
    if (!url) return gmEscapeAttr(label);
    return `<button type="button" class="btn btn-link btn-sm p-0 gm-date-session-btn" data-session-url="${gmEscapeAttr(url)}" title="Open session">${gmEscapeAttr(label)}</button>`;
  }

  function appendGmDateGroupHeader(trDate, group, columns, classId) {
    const th = document.createElement('th');
    th.colSpan = group.len;
    th.className = `gm-date-group ${bandClass(columns[group.start].dateBand)}`;
    th.innerHTML = renderGmDateGroupHeaderHtml(group, columns, classId);
    trDate.appendChild(th);
  }

  function mergeGradesMatrixPayload(existing, chunk, mergeMode) {
    if (mergeMode === 'columns') {
      return {
        ...existing,
        columns: [...(existing.columns || []), ...(chunk.columns || [])],
        matrix: (existing.matrix || []).map((row, index) => ({
          ...row,
          cells: [...(row.cells || []), ...((chunk.matrix?.[index]?.cells) || [])]
        })),
        window: chunk.window || existing.window
      };
    }
    if (mergeMode === 'students') {
      return {
        ...existing,
        matrix: [...(existing.matrix || []), ...(chunk.matrix || [])],
        window: chunk.window || existing.window
      };
    }
    return chunk;
  }

  function updateGradesRollupDom(matrixRows) {
    (matrixRows || []).forEach((row) => {
      const personId = String(row?.personId || '').trim();
      if (!personId) return;
      const tr = document.querySelector(`#gm_tbody tr[data-person-id="${CSS.escape(personId)}"]`);
      if (!tr) return;
      const finalTd = tr.querySelector('.gm-sticky-final');
      if (finalTd) {
        finalTd.innerHTML = row.finalPercent != null
          ? `<span class="fw-bold">${formatGmPercent(row.finalPercent)}</span>`
          : '—';
      }
    });
    const calcModalEl = document.getElementById('gmGradeCalcModal');
    if (gmOpenCalcPersonId && calcModalEl?.classList.contains('show')) {
      openGmGradeCalcModal(gmOpenCalcPersonId);
    }
  }

  async function refreshGradesDisplayRollups() {
    const data = window.currentGradesMatrixData;
    if (!data?.classId || !Array.isArray(data.matrix)) return;
    try {
      const res = await fetch('/school/grades-matrix/api/rollups', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-AJAX-Request': 'true' },
        body: JSON.stringify({
          classId: data.classId,
          startDate: document.getElementById('gm_startDate').value,
          endDate: document.getElementById('gm_endDate').value,
          columns: data.columns || [],
          students: data.matrix.map((row) => ({
            personId: row.personId,
            cells: row.cells || []
          }))
        })
      });
      const result = await res.json();
      if (result.status !== 'success') return;
      const rollups = result.rollups || {};
      data.matrix.forEach((row) => {
        const key = String(row.personId || '');
        const rollup = rollups[key];
        if (rollup) Object.assign(row, rollup);
      });
      updateGradesRollupDom(data.matrix);
    } catch (_) {}
  }

  function appendGmColumns(columns) {
    const thead = document.getElementById('gm_thead');
    if (!thead || !thead.rows.length || !columns.length) return;
    const trDate = thead.rows[0];
    const trCols = thead.rows[1];
    const classId = window.currentGradesMatrixData?.classId || document.getElementById('gm_classId')?.value || '';
    buildGmColumnGroups(columns).forEach((group) => {
      appendGmDateGroupHeader(trDate, group, columns, classId);
    });
    columns.forEach((col) => {
      const th = document.createElement('th');
      th.className = `gm-col-head text-center ${bandClass(col.dateBand)}`;
      th.innerHTML = renderGmColumnHeadHtml(col);
      trCols.appendChild(th);
    });
  }

  function appendGmStudentRow(row, columns) {
    const tbody = document.getElementById('gm_tbody');
    const tr = document.createElement('tr');
    tr.dataset.personId = String(row.personId || '');
    const fp = row.finalPercent != null ? `<span class="fw-bold">${formatGmPercent(row.finalPercent)}</span>` : '—';
    let html = `<td class="gm-sticky-final text-center small">${fp}</td><td class="gm-sticky-name ps-3">${typeof schoolRenderStudentNameHtml === 'function' ? schoolRenderStudentNameHtml(row.name, row.studentRecordId) : row.name}</td><td class="gm-sticky-calc">${renderGmGradeCalcButton(row.personId)}</td>`;
    row.cells.forEach((cell, idx) => {
      const col = columns[idx];
      html += `<td class="text-center small ${bandClass(col.dateBand)}">${renderCellHtml(cell, col, row.name)}</td>`;
    });
    tr.innerHTML = html;
    tbody.appendChild(tr);
  }

  async function loadGradesMatrixData(options = {}) {
    const classId = document.getElementById('gm_classId').value;
    const startDate = document.getElementById('gm_startDate').value;
    const endDate = document.getElementById('gm_endDate').value;
    const mergeMode = options.merge === 'columns' || options.merge === 'students' ? options.merge : null;
    if (!classId) return;
    if (gmMatrixWindowState.loading) return;

    if (!mergeMode) {
      if (gmLoadAbort) gmLoadAbort.abort();
      gmLoadAbort = new AbortController();
    }
    const seq = (gmLoadSeq += 1);
    const requestedClassId = classId;
    const thead = document.getElementById('gm_thead');
    const tbody = document.getElementById('gm_tbody');
    if (!mergeMode) {
      thead.innerHTML = '';
      tbody.innerHTML = '';
      document.getElementById('gm_results').classList.add('d-none');
    }

    const btn = document.getElementById('gm_btnLoad');
    const orig = btn.innerHTML;
    if (!mergeMode) {
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
    }
    gmMatrixWindowState.loading = true;

    try {
      const params = new URLSearchParams({
        classId,
        startDate,
        endDate,
        studentOffset: String(mergeMode === 'students' ? gmMatrixWindowState.loadedStudents : 0),
        studentLimit: String(mergeMode === 'columns'
          ? (gmMatrixWindowState.loadedStudents || GM_STUDENT_WINDOW)
          : GM_STUDENT_WINDOW),
        columnOffset: String(mergeMode === 'columns' ? gmMatrixWindowState.loadedColumns : 0),
        columnLimit: String(mergeMode === 'students'
          ? (gmMatrixWindowState.loadedColumns || GM_COLUMN_WINDOW)
          : GM_COLUMN_WINDOW)
      });
      const url = `/school/grades-matrix/api/data?${params.toString()}`;
      const res = await fetch(url, {
        headers: { 'X-AJAX-Request': 'true' },
        signal: mergeMode ? undefined : gmLoadAbort.signal,
        cache: 'no-store'
      });
      const chunk = await res.json();
      const guarded = typeof window.applyGuardedApiResult === 'function'
        ? await window.applyGuardedApiResult(chunk, { busyTitle: 'Load In Progress', replayTitle: 'Load Already Completed' })
        : { stop: false };
      if (guarded.stop) return;
      if (chunk.status !== 'success') throw new Error(chunk.message || 'Load failed');
      if (!mergeMode && seq !== gmLoadSeq) return;
      if (!mergeMode && String(chunk.classId || '') !== String(requestedClassId)) return;

      const result = mergeMode && window.currentGradesMatrixData
        ? mergeGradesMatrixPayload(window.currentGradesMatrixData, chunk, mergeMode)
        : chunk;
      const windowMeta = chunk.window || {};
      gmMatrixWindowState.hasMoreStudents = Boolean(windowMeta.hasMoreStudents);
      gmMatrixWindowState.hasMoreColumns = Boolean(windowMeta.hasMoreColumns);
      if (!mergeMode) {
        gmMatrixWindowState.loadedStudents = (chunk.matrix || []).length;
        gmMatrixWindowState.loadedColumns = (chunk.columns || []).length;
      } else if (mergeMode === 'columns') {
        gmMatrixWindowState.loadedColumns += (chunk.columns || []).length;
      } else if (mergeMode === 'students') {
        gmMatrixWindowState.loadedStudents += (chunk.matrix || []).length;
      }

      window.currentGradesMatrixData = result;
      setGradesPrintEnabled(true);

      const { columns, matrix, className } = result;
      document.getElementById('gm_classTitle').textContent = className || 'Class';
      document.getElementById('gm_evalCard').classList.remove('d-none');
      if (mergeMode === 'columns') {
        renderGmEvalWeightsTable(result.columns || [], { append: true });
      } else {
        renderGmEvalWeightsTable(columns || []);
      }

      if (mergeMode === 'columns') {
        appendGmColumns(chunk.columns || []);
        tbody.querySelectorAll('tr').forEach((rowEl, index) => {
          const studentRow = chunk.matrix?.[index];
          if (!studentRow) return;
          const cells = studentRow.cells || [];
          cells.forEach((cell, cellIdx) => {
            const col = chunk.columns?.[cellIdx];
            const td = document.createElement('td');
            td.className = `text-center small ${bandClass(col?.dateBand)}`;
            td.innerHTML = renderCellHtml(cell, col, studentRow.name);
            rowEl.appendChild(td);
          });
        });
        document.getElementById('gm_results').classList.remove('d-none');
        await refreshGradesDisplayRollups();
        return;
      }

      if (mergeMode === 'students') {
        (chunk.matrix || []).forEach((row) => appendGmStudentRow(row, chunk.columns || []));
        document.getElementById('gm_results').classList.remove('d-none');
        await refreshGradesDisplayRollups();
        return;
      }

      if (!columns || !columns.length) {
        thead.innerHTML = '<tr><th class="gm-sticky-final">Final</th><th class="gm-sticky-name">Student</th><th class="gm-sticky-calc" title="Grade calculation breakdown"><i class="bi bi-info-circle"></i></th><th>No graded items in this date range</th></tr>';
        matrix.forEach((row) => {
          const tr = document.createElement('tr');
          tr.dataset.personId = String(row.personId || '');
          const fp = formatGmPercent(row.finalPercent);
          tr.innerHTML = `<td class="gm-sticky-final text-center small">${fp}</td><td class="gm-sticky-name ps-3">${typeof schoolRenderStudentNameHtml === 'function' ? schoolRenderStudentNameHtml(row.name, row.studentRecordId) : row.name}</td><td class="gm-sticky-calc">${renderGmGradeCalcButton(row.personId)}</td><td class="text-muted">—</td>`;
          tbody.appendChild(tr);
        });
        document.getElementById('gm_results').classList.remove('d-none');
        return;
      }

      const groups = buildGmColumnGroups(columns);
      const trDate = document.createElement('tr');
      trDate.innerHTML = `<th class="gm-sticky-final gm-date-group" rowspan="2">Final</th>
        <th class="gm-sticky-name gm-date-group" rowspan="2">Student</th>
        <th class="gm-sticky-calc gm-date-group" rowspan="2" title="Grade calculation breakdown"><i class="bi bi-info-circle"></i></th>`;
      groups.forEach((g) => {
        appendGmDateGroupHeader(trDate, g, columns, result.classId || classId);
      });
      const trCols = document.createElement('tr');
      columns.forEach((col) => {
        const th = document.createElement('th');
        th.className = `gm-col-head text-center ${bandClass(col.dateBand)}`;
        th.innerHTML = renderGmColumnHeadHtml(col);
        trCols.appendChild(th);
      });
      thead.appendChild(trDate);
      thead.appendChild(trCols);

      matrix.forEach((row) => appendGmStudentRow(row, columns));

      document.getElementById('gm_results').classList.remove('d-none');
    } catch (e) {
      if (e && e.name === 'AbortError') return;
      if (!mergeMode) {
        window.currentGradesMatrixData = null;
        setGradesPrintEnabled(false);
      }
      if (typeof showMessageModal === 'function') {
        showMessageModal({ title: 'Error', icon: 'error', message: e.message, buttons: [{ text: 'OK', class: 'btn-secondary' }] });
      } else {
        alert(e.message);
      }
    } finally {
      gmMatrixWindowState.loading = false;
      if (!mergeMode) {
        btn.disabled = false;
        btn.innerHTML = orig;
      }
    }
  }

  document.querySelector('.gm-matrix')?.addEventListener('scroll', () => {
    const wrapper = document.querySelector('.gm-matrix');
    if (!wrapper || gmMatrixWindowState.loading || !window.currentGradesMatrixData) return;
    const nearBottom = wrapper.scrollTop + wrapper.clientHeight >= wrapper.scrollHeight - 100;
    const nearRight = wrapper.scrollLeft + wrapper.clientWidth >= wrapper.scrollWidth - 100;
    if (nearBottom && gmMatrixWindowState.hasMoreStudents) {
      loadGradesMatrixData({ merge: 'students' });
    } else if (nearRight && gmMatrixWindowState.hasMoreColumns) {
      loadGradesMatrixData({ merge: 'columns' });
    }
  });

  document.getElementById('gm_btnLoad')?.addEventListener('click', () => loadGradesMatrixData());
  document.getElementById('gm_btnSaveWeights')?.addEventListener('click', () => saveGmActivityWeights());
  document.getElementById('gm_evalWeightsTable')?.addEventListener('input', (event) => {
    const input = event.target.closest('.gm-eval-weight-input');
    if (!input) return;
    onGmWeightInputChange(input.getAttribute('data-col-key') || '', input.value);
  });

  let gmCommentModalInstance = null;
  let gmGradeCalcModalInstance = null;
  let gmActivityModalInstance = null;
  const gmCommentModalEl = document.getElementById('gmCommentModal');
  if (gmCommentModalEl && typeof bootstrap !== 'undefined') {
    gmCommentModalInstance = new bootstrap.Modal(gmCommentModalEl);
  }
  const gmGradeCalcModalEl = document.getElementById('gmGradeCalcModal');
  if (gmGradeCalcModalEl && typeof bootstrap !== 'undefined') {
    gmGradeCalcModalInstance = new bootstrap.Modal(gmGradeCalcModalEl);
  }
  const gmActivityModalEl = document.getElementById('gmActivityModal');
  if (gmActivityModalEl && typeof bootstrap !== 'undefined') {
    gmActivityModalInstance = new bootstrap.Modal(gmActivityModalEl);
  }

  document.getElementById('gm_evalWeightsTable')?.addEventListener('click', (event) => {
    const infoBtn = event.target.closest('.gm-col-info-btn');
    if (!infoBtn) return;
    event.preventDefault();
    openGmActivityModal(infoBtn.getAttribute('data-col-key') || '');
  });

  document.getElementById('gm_thead')?.addEventListener('click', (event) => {
    const dateBtn = event.target.closest('.gm-date-session-btn');
    if (dateBtn) {
      event.preventDefault();
      const url = String(dateBtn.getAttribute('data-session-url') || '').trim();
      if (url) window.open(url, '_blank', 'noopener');
      return;
    }
    const infoBtn = event.target.closest('.gm-col-info-btn');
    if (!infoBtn) return;
    event.preventDefault();
    openGmActivityModal(infoBtn.getAttribute('data-col-key') || '');
  });

  function gmOpenCommentModal({ studentName, activityLabel, comment }) {
    const nameEl = document.getElementById('gmCommentModalStudentName');
    const activityEl = document.getElementById('gmCommentModalActivityName');
    const textEl = document.getElementById('gmCommentModalText');
    if (nameEl) nameEl.textContent = String(studentName || '—');
    if (activityEl) activityEl.textContent = String(activityLabel || '—');
    if (textEl) textEl.value = String(comment || '');
    if (gmCommentModalInstance) gmCommentModalInstance.show();
  }

  document.getElementById('gm_tbody')?.addEventListener('click', (event) => {
    const calcBtn = event.target.closest('.gm-calc-btn');
    if (calcBtn) {
      event.preventDefault();
      openGmGradeCalcModal(calcBtn.getAttribute('data-person-id') || '');
      return;
    }
    const btn = event.target.closest('.gm-comment-btn');
    if (!btn) return;
    event.preventDefault();
    let comment = '';
    try {
      comment = decodeURIComponent(btn.getAttribute('data-comment') || '');
    } catch (_) {
      comment = btn.getAttribute('data-comment') || '';
    }
    gmOpenCommentModal({
      studentName: btn.getAttribute('data-student-name') || '',
      activityLabel: btn.getAttribute('data-activity-label') || '',
      comment
    });
  });

  // --- Grades Matrix Print ---
  function gmPrintEscapeHtml(value) {
    return String(value == null ? '' : value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function gmPrintFormatDateShort(ymd) {
    const raw = String(ymd || '').trim();
    if (!/^\d{4}-\d{2}-\d{2}$/.test(raw)) return raw || '—';
    const d = new Date(`${raw}T00:00:00`);
    if (Number.isNaN(d.getTime())) return raw;
    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  }

  function gmPrintFormatRangeLabel(startDate, endDate) {
    const start = String(startDate || '').trim();
    const end = String(endDate || '').trim();
    if (!start && !end) return 'All sessions';
    if (start && end) return `${gmPrintFormatDateShort(start)} – ${gmPrintFormatDateShort(end)}`;
    if (start) return `From ${gmPrintFormatDateShort(start)}`;
    return `Through ${gmPrintFormatDateShort(end)}`;
  }

  function gmPrintFormatPercent(val) {
    if (val == null || val === '' || Number.isNaN(Number(val))) return '—';
    const n = Number(val);
    const t = Math.round(n * 10) / 10;
    const s = t % 1 === 0 ? String(t) : t.toFixed(1);
    return `${s}%`;
  }

  function gmPrintTruncate(text, maxLen) {
    const s = String(text || '').trim();
    if (s.length <= maxLen) return s;
    return `${s.slice(0, Math.max(0, maxLen - 1))}…`;
  }

  function gmPrintCellText(cell, col) {
    if (!cell) return { text: '—', cls: 'st-empty' };
    if (cell.notApplicable || cell.attendanceStatus === 'not_applicable') {
      return { text: 'N/A', cls: 'st-absent' };
    }
    if (cell.absent) {
      const label = cell.attendanceStatus === 'acf' ? 'ACF' : 'Absent';
      let cls = 'st-absent';
      if (cell.effective) cls += ' st-eff';
      return { text: label, cls };
    }
    if (cell.score == null || cell.score === '') {
      if (cell.effective) return { text: '—', cls: 'st-empty st-eff' };
      return { text: '—', cls: 'st-empty' };
    }
    const total = Number(col?.totalScore) || 0;
    const score = cell.score;
    const pct = cell.percent != null ? `${cell.percent}%` : '';
    const scorePart = total > 0 ? `${score}/${total}` : String(score);
    const text = pct ? `${scorePart} · ${pct}` : scorePart;
    const excl = cell.includeInGradeCalculation === false;
    const eff = !!cell.effective;
    let cls = 'st-score';
    if (excl) cls += ' st-excl';
    else if (eff) cls += ' st-eff';
    return { text, cls };
  }

  function gmPrintBuildSummary(matrixData) {
    const students = Array.isArray(matrixData?.matrix) ? matrixData.matrix : [];
    const sessions = Array.isArray(matrixData?.sessions) ? matrixData.sessions : [];
    const columns = Array.isArray(matrixData?.columns) ? matrixData.columns : [];
    let finalSum = 0;
    let finalCount = 0;
    students.forEach((row) => {
      if (row?.finalPercent != null && Number.isFinite(Number(row.finalPercent))) {
        finalSum += Number(row.finalPercent);
        finalCount += 1;
      }
    });
    return {
      studentCount: students.length,
      sessionCount: sessions.length,
      columnCount: columns.length,
      avgFinal: finalCount ? Math.round((finalSum / finalCount) * 10) / 10 : null
    };
  }

  function buildGradesPrintDocument(matrixData, meta = {}) {
    const data = matrixData && typeof matrixData === 'object' ? matrixData : {};
    const columns = Array.isArray(data.columns) ? data.columns : [];
    const students = Array.isArray(data.matrix) ? data.matrix : [];
    const summary = gmPrintBuildSummary(data);
    const className = String(data.className || meta.className || 'Class').trim() || 'Class';
    const orgName = String(meta.orgName || '').trim();
    const rangeLabel = gmPrintFormatRangeLabel(meta.startDate, meta.endDate);
    const printedAt = meta.printedAt instanceof Date ? meta.printedAt : new Date();
    const printedAtLabel = printedAt.toLocaleString('en-US', {
      year: 'numeric', month: 'short', day: 'numeric',
      hour: 'numeric', minute: '2-digit'
    });
    const evaluation = data.evaluation || {};
    const passing = evaluation.passingScore != null ? `${evaluation.passingScore}%` : '—';
    const finalNote = 'Final % is the period-weighted assignments average (activity weights renormalized per student).';
    const fallbackSettings = {
      includeOrg: true,
      orgName,
      includeHeaderNote: false,
      headerNote: '',
      orientation: 'landscape',
      density: 'compact',
      requestedByLabel: '',
      logoUrl: ''
    };
    const settings = window.AppPrintManager?.normalizeSettings
      ? window.AppPrintManager.normalizeSettings({ ...fallbackSettings, ...(meta.printSettings || {}) })
      : fallbackSettings;
    const displayOrgName = settings.includeOrg ? String(settings.orgName || orgName || '').trim() : '';
    const logoUrl = String(settings.logoUrl || '').trim();
    const logoHtml = logoUrl
      ? `<img class="print-logo" src="${gmPrintEscapeHtml(logoUrl)}" alt="Organization logo" onerror="this.style.display='none'">`
      : '';
    const pageCss = window.PrintDocumentBuilder?.buildPageCss
      ? window.PrintDocumentBuilder.buildPageCss(settings.orientation)
      : `@page { margin: 10mm; size: ${settings.orientation === 'portrait' ? 'portrait' : 'landscape'}; }`;
    const previewControlsHtml = window.AppPrintManager?.buildPreviewControlsHtml
      ? window.AppPrintManager.buildPreviewControlsHtml(settings)
      : '<div class="screen-actions no-print"><button type="button" onclick="window.print()">Print</button><button type="button" onclick="window.close()">Close</button></div>';
    const printNoteHtml = window.AppPrintManager?.buildPrintNoteHtml
      ? window.AppPrintManager.buildPrintNoteHtml(settings)
      : '';
    const orientationScript = window.PrintDocumentBuilder?.buildPreviewOrientationScript
      ? window.PrintDocumentBuilder.buildPreviewOrientationScript({ orientation: settings.orientation, sourcePath: location.pathname, mode: 'grades-matrix' })
      : '';

    const groups = buildGmColumnGroups(columns);

    const dateHeaderCells = groups.map((g) => {
      const label = gmFormatDateGroupLabel(g, columns);
      return `<th class="day-group" colspan="${g.len}">${gmPrintEscapeHtml(label)}</th>`;
    }).join('');

    const activityHeaderCells = columns.map((col) => {
      const kind = String(col.kindLabel || '').trim();
      const label = gmPrintTruncate(col.label, 28);
      const excl = col.includeInGradeCalculation === false ? ' <span class="excl-tag">excl.</span>' : '';
      const weightInfo = formatGmColumnWeightLabel(col);
      const weightHtml = weightInfo
        ? `<div class="act-weight">${gmPrintEscapeHtml(weightInfo.text)}</div>`
        : '';
      return `<th class="act-col"><div class="act-kind">${gmPrintEscapeHtml(kind)}</div><div class="act-label">${gmPrintEscapeHtml(label)}${excl}</div>${weightHtml}</th>`;
    }).join('');

    const bodyRows = students.map((row, index) => {
      const name = String(row.name || 'Student');
      const fp = gmPrintFormatPercent(row.finalPercent);
      const cells = (Array.isArray(row.cells) ? row.cells : []).map((cell, idx) => {
        const col = columns[idx] || {};
        const rendered = gmPrintCellText(cell, col);
        return `<td class="gm-print-cell ${rendered.cls}">${gmPrintEscapeHtml(rendered.text)}</td>`;
      }).join('');
      const emptyCols = !columns.length
        ? '<td class="gm-print-cell st-empty">—</td>'
        : cells;
      return `<tr>
        <td class="num-col">${index + 1}</td>
        <td class="final-col">${gmPrintEscapeHtml(fp)}</td>
        <td class="name-col">${gmPrintEscapeHtml(name)}</td>
        ${emptyCols}
      </tr>`;
    }).join('');

    const emptyRow = !students.length
      ? `<tr><td colspan="${Math.max(3, columns.length + 3)}" class="empty-msg">No students found for this range.</td></tr>`
      : '';

    const avgFinalLabel = summary.avgFinal == null ? '—' : gmPrintFormatPercent(summary.avgFinal);

    return `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>${gmPrintEscapeHtml(`Grades Matrix — ${className}`)}</title>
  <style id="print-page-orientation-css">${pageCss}</style>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: "Segoe UI", Arial, sans-serif;
      font-size: 10px;
      color: #111;
      line-height: 1.25;
    }
    body.print-density-normal { font-size: 11px; line-height: 1.35; }
    .sheet { padding: 0; }
    .identity-block { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; margin-bottom: 8px; }
    .identity-copy { min-width: 0; flex: 1 1 auto; }
    .print-logo { display: block; flex: 0 0 auto; width: auto; height: 58px; max-width: 180px; object-fit: contain; object-position: right top; }
    .doc-header { margin-bottom: 8px; }
    .doc-header h1 {
      margin: 0 0 2px 0;
      font-size: 16px;
      font-weight: 700;
    }
    .org-name {
      font-size: 13px;
      font-weight: 700;
      margin: 0 0 4px 0;
    }
    .print-note {
      margin: 0 0 8px;
      border: 1px solid #cfd7e3;
      background: #f4f7fb;
      padding: 6px 8px;
      color: #333;
      white-space: pre-wrap;
    }
    .meta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 18px;
      color: #333;
      margin-bottom: 4px;
    }
    .meta-row span strong { font-weight: 600; }
    .eval-line {
      color: #444;
      margin-bottom: 6px;
      font-size: 9.5px;
    }
    .summary {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 14px;
      border: 1px solid #ccc;
      background: #f8f9fa;
      padding: 6px 8px;
      margin-bottom: 8px;
      border-radius: 2px;
    }
    .summary .stat { white-space: nowrap; }
    .summary .stat b { font-weight: 700; }
    .legend {
      margin: 0 0 8px 0;
      color: #444;
      font-size: 9.5px;
    }
    table.matrix {
      width: 100%;
      border-collapse: collapse;
      table-layout: auto;
    }
    table.matrix th,
    table.matrix td {
      border: 1px solid #bbb;
      padding: 3px 4px;
      vertical-align: middle;
    }
    table.matrix thead th {
      background: #eef1f4;
      font-weight: 700;
      text-align: center;
    }
    table.matrix thead { display: table-header-group; }
    table.matrix tbody tr { page-break-inside: avoid; }
    .num-col { width: 28px; text-align: center; color: #555; }
    .final-col { text-align: center; min-width: 52px; white-space: nowrap; color: #198754; font-weight: 700; }
    .name-col { text-align: left; min-width: 110px; max-width: 160px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .day-group { font-size: 9.5px; }
    .act-col { min-width: 56px; max-width: 90px; }
    .act-kind { font-size: 8px; color: #666; font-weight: 500; }
    .act-label { font-size: 9px; }
    .act-weight { font-size: 8px; color: #64748b; }
    .excl-tag { font-size: 7.5px; color: #6c757d; font-weight: 600; }
    .gm-print-cell {
      text-align: center;
      white-space: nowrap;
      font-size: 9px;
    }
    .st-score { font-weight: 600; }
    .st-eff { color: #0f5132; }
    .st-excl { color: #6c757d; font-weight: 500; }
    .st-absent { color: #842029; font-weight: 500; }
    .st-empty { color: #6c757d; }
    .empty-msg { text-align: center; color: #666; padding: 16px !important; }
    .doc-footer {
      margin-top: 10px;
      padding-top: 4px;
      border-top: 1px solid #ddd;
      color: #666;
      font-size: 9px;
      display: flex;
      justify-content: space-between;
      gap: 12px;
    }
    @media print {
      body { margin: 0; }
      .no-print { display: none !important; }
      a { color: inherit; text-decoration: none; }
    }
    @media screen {
      body { background: #e9ecef; padding: 16px; }
      .sheet {
        background: #fff;
        padding: 14px 16px;
        box-shadow: 0 1px 6px rgba(0,0,0,0.12);
        max-width: 100%;
      }
      .screen-actions {
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
      }
      .screen-actions-label { color: #333; font-weight: 600; }
      .screen-actions button {
        font: inherit;
        padding: 6px 12px;
        cursor: pointer;
        border: 1px solid #adb5bd;
        background: #fff;
        border-radius: 4px;
      }
      .screen-actions button.is-active { background: #174ea6; border-color: #174ea6; color: #fff; }
      .screen-actions-hint { margin: -4px 0 10px; color: #555; font-size: 11px; }
    }
  </style>
</head>
<body class="print-density-${settings.density}" data-print-orientation="${settings.orientation}">
  ${previewControlsHtml}
  <div class="sheet">
    <div class="identity-block">
      <div class="identity-copy">
        <header class="doc-header">
      ${displayOrgName ? `<div class="org-name">${gmPrintEscapeHtml(displayOrgName)}</div>` : ''}
      <h1>Grades Matrix</h1>
      <div class="meta-row">
        <span><strong>Class:</strong> ${gmPrintEscapeHtml(className)}</span>
        <span><strong>Range:</strong> ${gmPrintEscapeHtml(rangeLabel)}</span>
        <span><strong>Printed:</strong> ${gmPrintEscapeHtml(printedAtLabel)}</span>
        ${settings.requestedByLabel ? `<span><strong>Requested by:</strong> ${gmPrintEscapeHtml(settings.requestedByLabel)}</span>` : ''}
      </div>
      <div class="eval-line"><strong>Passing:</strong> ${gmPrintEscapeHtml(passing)} · ${gmPrintEscapeHtml(finalNote)}</div>
        </header>
      </div>
      ${logoHtml}
    </div>
    ${printNoteHtml}

    <div class="summary">
      <span class="stat"><b>${summary.studentCount}</b> students</span>
      <span class="stat"><b>${summary.sessionCount}</b> sessions</span>
      <span class="stat"><b>${summary.columnCount}</b> activities</span>
      <span class="stat">Avg Final <b>${gmPrintEscapeHtml(avgFinalLabel)}</b></span>
    </div>
    <div class="legend">Legend: score/total · percent% · excl. = scored but excluded from category average · Absent / ACF / N/A = no score due to attendance · — = no score</div>

    <table class="matrix">
      <thead>
        ${columns.length ? `<tr>
          <th class="num-col" rowspan="2">#</th>
          <th class="final-col" rowspan="2">Final %</th>
          <th class="name-col" rowspan="2">Student</th>
          ${dateHeaderCells}
        </tr>
        <tr>
          ${activityHeaderCells}
        </tr>` : `<tr>
          <th class="num-col">#</th>
          <th class="final-col">Final %</th>
          <th class="name-col">Student</th>
          <th>No graded items in this date range</th>
        </tr>`}
      </thead>
      <tbody>
        ${bodyRows || emptyRow}
      </tbody>
    </table>

    <footer class="doc-footer">
      <span>Generated from Grades Matrix</span>
      <span>${gmPrintEscapeHtml(className)} · ${gmPrintEscapeHtml(rangeLabel)}</span>
    </footer>
  </div>
  ${orientationScript}
</body>
</html>`;
  }

  function openGradesPrint() {
    if (!window.currentGradesMatrixData || window.currentGradesMatrixData.status !== 'success') {
      if (typeof showMessageModal === 'function') {
        showMessageModal({
          title: 'Nothing to print',
          icon: 'warning',
          message: 'Load a grades matrix for a class first.',
          buttons: [{ text: 'Close', class: 'btn-secondary' }]
        });
      } else {
        alert('Load a grades matrix for a class first.');
      }
      return;
    }

    const orgName = String(document.getElementById('activeOrgNameRef')?.getAttribute('data-name') || '').trim();
    const startDate = document.getElementById('gm_startDate')?.value || '';
    const endDate = document.getElementById('gm_endDate')?.value || '';
    const defaults = { orgName, orientation: 'landscape', density: 'compact' };
    const openPreview = (settings = defaults) => {
      const html = buildGradesPrintDocument(window.currentGradesMatrixData, {
        orgName,
        startDate,
        endDate,
        className: window.currentGradesMatrixData.className,
        printedAt: new Date(),
        printSettings: settings
      });
      const printWindow = window.AppPrintManager?.openHtmlPreview
        ? window.AppPrintManager.openHtmlPreview({
          title: 'Grades Matrix',
          html,
          settings,
          sourcePath: location.pathname,
          view: 'grades-matrix'
        })
        : null;
      if (!printWindow) {
        if (typeof showMessageModal === 'function') {
          showMessageModal({
            title: 'Popup blocked',
            icon: 'warning',
            message: 'Allow pop-ups for this site to open the print page.',
            buttons: [{ text: 'Close', class: 'btn-secondary' }]
          });
        } else {
          alert('Allow pop-ups for this site to open the print page.');
        }
      }
    };

    if (window.AppPrintManager?.openSettings) {
      window.AppPrintManager.openSettings({
        mode: 'grades-matrix',
        defaults,
        onConfirm: openPreview
      });
    } else {
      openPreview(defaults);
    }
  }

  document.getElementById('btn_printGradesMatrix')?.addEventListener('click', () => openGradesPrint());

  if (INITIAL.classId) {
    setTimeout(() => document.getElementById('gm_btnLoad').click(), 100);
  }
});
</script>
