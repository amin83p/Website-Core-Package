<%- include('partials/tablePages-start', {
  title,
  user,
  tableName,
  btn_export: true,
  print: true,
  headerManageBtns: [
    '<a href="/school/library/circulation" class="btn btn-filled btn-secondary btn-md mb-2"><i class="bi bi-arrow-left-right me-1"></i> Circulation Desk</a>',
    '<a href="/dashboard/section-nav/SCHOOL_LIBRARY" class="school-navigator-dashboard btn btn-filled btn-secondary btn-md mb-2"><i class="bi bi-book me-1"></i> School Library</a>'
  ],
  manageBtns: []
}) %>

<%- include('partials/tablePages-search', {
  placeholder: 'Search active loans...',
  fields: [
    { name: 'status', label: 'Status', type: 'select', options: ['active', 'overdue'] },
    { name: 'copyType', label: 'Type', type: 'select', options: ['physical', 'digital'] }
  ]
}) %>

<div class="table-scroll-wrapper">
  <table class="table-responsive size-md" id="first-table">
    <thead>
      <tr>
        <th class="ps-4">Loan</th>
        <th>Book</th>
        <th>Copy</th>
        <th>Patron</th>
        <th>Due</th>
        <th>Status</th>
        <th class="text-end pe-4">Type</th>
      </tr>
    </thead>
    <tbody>
      <% if (!data || data.length === 0) { %>
        <tr><td colspan="7" class="text-center py-5 text-muted">No active loans.</td></tr>
      <% } %>
      <% (data || []).forEach((item) => { %>
        <tr>
          <td class="ps-4 font-monospace"><%= item.id %></td>
          <td><%= item.bookTitle || item.bookId %></td>
          <td class="font-monospace"><%= item.copyCode || item.copyId %></td>
          <td class="font-monospace"><%= item.patronPersonId || item.personId %></td>
          <td><%= item.dueAt ? new Date(item.dueAt).toLocaleString() : '—' %></td>
          <td><span class="badge <%= item.status === 'overdue' ? 'bg-danger' : 'bg-warning text-dark' %>"><%= item.status %></span></td>
          <td class="text-end pe-4"><%= item.copyType %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('partials/tablePages-end') %>
