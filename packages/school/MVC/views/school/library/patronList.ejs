<%- include('partials/tablePages-start', {
  title,
  newHref: '/school/library/patrons/new',
  newLabel: 'Register Patron',
  user,
  tableName,
  btn_export: true,
  print: true,
  headerManageBtns: [
    '<a href="' + schoolSectionDashboardHref + '" class="school-navigator-dashboard btn btn-filled btn-secondary btn-md mb-2"><i class="bi bi-speedometer2 me-1"></i> School Dashboard</a>',
    '<a href="/dashboard/section-nav/SCHOOL_LIBRARY" class="school-navigator-dashboard btn btn-filled btn-secondary btn-md mb-2"><i class="bi bi-book me-1"></i> School Library</a>'
  ],
  manageBtns: []
}) %>

<%- include('partials/tablePages-search', {
  placeholder: 'Search patrons...',
  fields: [
    { name: 'patronRole', label: 'Role', type: 'select', options: ['student', 'teacher', 'staff'] },
    { name: 'status', label: 'Status', type: 'select', options: ['active', 'suspended', 'blocked'] }
  ]
}) %>

<div class="table-scroll-wrapper" data-floating-row-actions="true">
  <table class="table-responsive size-md" id="first-table">
    <thead>
      <tr>
        <th class="draggable ps-4">Patron</th>
        <th class="draggable">Role</th>
        <th class="draggable">Status</th>
        <th class="draggable">Active loans</th>
        <th class="draggable">Card #</th>
        <th class="text-end pe-4">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (!data || data.length === 0) { %>
        <tr><td colspan="6" class="text-center py-5 text-muted">No patrons found.</td></tr>
      <% } %>
      <% (data || []).forEach((item) => { %>
        <tr data-patron-row-id="<%= item.id %>">
          <td class="ps-4">
            <div class="fw-semibold"><%= item.displayName %></div>
            <div class="x-small text-muted font-monospace"><%= item.personId %></div>
          </td>
          <td><span class="badge bg-secondary"><%= item.patronRole %></span></td>
          <td><span class="badge <%= item.status === 'active' ? 'bg-success' : 'bg-danger' %>"><%= item.status %></span></td>
          <td><%= Number(item.activeLoanCount || 0) %></td>
          <td><%= item.libraryCardNumber || '—' %></td>
          <td class="table-actions text-end pe-4">
            <div class="row-actions-wrap">
              <button type="button" class="btn btn-secondary btn-sm btn-row-actions-toggle" data-row-actions-id="<%= item.id %>" title="Patron actions">
                <i class="bi bi-three-dots-vertical"></i>
              </button>
              <div class="row-actions-menu d-none" data-row-actions-id="<%= item.id %>">
                <a href="/school/library/patrons/edit/<%= item.id %>" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil-square me-2"></i>Edit</a>
                <button type="button" class="btn btn-outline-danger btn-sm delete-patron-btn" data-id="<%= item.id %>" data-label="<%= item.displayName || item.libraryCardNumber || item.id %>"><i class="bi bi-trash me-2"></i>Delete</button>
              </div>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('partials/tablePages-end') %>

<script>
(function () {
  function showPatronMessage(title, message, icon, buttons) {
    if (typeof window.showMessageModal === 'function') {
      return window.showMessageModal({
        title,
        icon,
        message,
        buttons: buttons || [{ text: 'OK', class: icon === 'error' ? 'btn-danger' : 'btn-primary' }]
      });
    }
    alert(String(message || '').replace(/<[^>]*>/g, ''));
    return Promise.resolve('OK');
  }

  function findPatronRow(id) {
    return Array.from(document.querySelectorAll('[data-patron-row-id]'))
      .find((row) => String(row.getAttribute('data-patron-row-id') || '') === String(id));
  }

  function ensureEmptyPatronState() {
    const tbody = document.querySelector('#first-table tbody');
    if (!tbody) return;
    if (tbody.querySelector('[data-patron-row-id]')) return;
    tbody.innerHTML = '<tr><td colspan="6" class="text-center py-5 text-muted">No patrons found.</td></tr>';
  }

  function removePatronRow(id) {
    const row = findPatronRow(id);
    if (!row) return;
    row.style.transition = 'opacity 0.2s ease, transform 0.2s ease';
    row.style.opacity = '0';
    row.style.transform = 'translateX(0.75rem)';
    setTimeout(() => {
      row.remove();
      ensureEmptyPatronState();
    }, 220);
  }

  async function deletePatron(button) {
    const id = String(button?.dataset?.id || '').trim();
    if (!id) return;
    const label = String(button?.dataset?.label || id).trim();
    const confirmed = await showPatronMessage(
      'Delete Patron?',
      'Delete <b>' + label + '</b>? This is only allowed when no library circulation history exists.',
      'warning',
      [
        { text: 'Cancel', class: 'btn-secondary' },
        { text: 'Delete', class: 'btn-danger' }
      ]
    );
    if (confirmed !== 'Delete') return;

    try {
      const response = await fetch('/school/library/patrons/delete/' + encodeURIComponent(id), {
        method: 'GET',
        headers: {
          Accept: 'application/json',
          'X-AJAX-Request': 'true'
        }
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok || result.status === 'error') {
        throw new Error(result.message || 'Unable to delete this patron.');
      }
      await showPatronMessage('Patron Deleted', result.message || 'Patron deleted successfully.', 'success', [{ text: 'OK', class: 'btn-success' }]);
      removePatronRow(id);
    } catch (error) {
      await showPatronMessage('Delete Failed', error.message || 'Unable to delete this patron.', 'error', [{ text: 'OK', class: 'btn-danger' }]);
    }
  }

  document.querySelectorAll('.delete-patron-btn').forEach((button) => {
    button.addEventListener('click', () => deletePatron(button));
  });
})();
</script>
