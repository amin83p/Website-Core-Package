<%
  const patronPickerRows = Array.isArray(patronPickerItems) ? patronPickerItems : [];
%>
<%- include('partials/tablePages-start', {
  title,
  user,
  btn_export: false,
  print: false,
  headingPrefixHtml: '<i class="bi bi-arrow-left-right text-primary fs-3"></i>',
  headerManageBtns: [
    '<a href="' + schoolSectionDashboardHref + '" class="school-navigator-dashboard btn btn-filled btn-secondary btn-md mb-2"><i class="bi bi-speedometer2 me-1"></i> School Dashboard</a>',
    '<a href="/dashboard/section-nav/SCHOOL_LIBRARY" class="school-navigator-dashboard btn btn-filled btn-secondary btn-md mb-2"><i class="bi bi-book me-1"></i> School Library</a>'
  ],
  manageBtns: [
    '<a href="/school/library/circulation/loans" class="btn btn-filled btn-primary btn-md mb-2"><i class="bi bi-list-check me-1"></i> Active Loans</a>',
    '<a href="/school/library/circulation/overdue" class="btn btn-filled btn-warning btn-md mb-2"><i class="bi bi-exclamation-triangle me-1"></i> Overdue</a>'
  ]
}) %>

<% if (includeModal) { %><%- include('partials/modal_GenericPicker', { user }) %><% } %>

<div class="row g-4">
  <div class="col-xl-4 col-lg-5">
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-white border-bottom fw-bold text-primary"><i class="bi bi-person-vcard me-2"></i>Patron</div>
      <div class="card-body">
        <input type="hidden" id="checkout_patronId">
        <input type="hidden" id="checkout_actionStateId" value="<%= actionStateId || '' %>">
        <div class="d-flex gap-2 flex-wrap mb-3">
          <button type="button" class="btn btn-filled btn-primary btn-md" id="deskPickPatron">
            <i class="bi bi-person-vcard me-1"></i> Pick Patron
          </button>
          <a href="/school/library/patrons/new" class="btn btn-filled btn-success btn-md">
            <i class="bi bi-person-plus me-1"></i> Register Patron
          </a>
        </div>
        <div id="checkoutPatronCard" class="border rounded-2 p-3 bg-light d-none">
          <div class="d-flex align-items-start gap-3">
            <div class="rounded bg-white border d-flex align-items-center justify-content-center text-primary" style="width: 44px; height: 44px; min-width: 44px;">
              <i class="bi bi-person-vcard fs-4"></i>
            </div>
            <div class="min-w-0">
              <div class="fw-bold text-dark" id="checkoutPatronName"></div>
              <div class="small text-muted" id="checkoutPatronMeta"></div>
              <div class="small font-monospace text-muted" id="checkoutPatronCardNumber"></div>
            </div>
          </div>
        </div>
        <div id="checkoutPatronLabel" class="small text-muted">No patron selected.</div>
      </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-white border-bottom fw-bold text-primary"><i class="bi bi-sliders me-2"></i>Active Policy</div>
      <div class="card-body">
        <div id="policyEmptyState" class="text-muted small">Pick a patron to see the active policy and borrowing allowance.</div>
        <div id="policyPanel" class="d-none">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <div class="fw-bold" id="policyRoleLabel"></div>
            <span class="badge text-bg-primary" id="policyModeBadge">Default</span>
          </div>
          <div class="row g-2 small mb-3">
            <div class="col-6"><span class="text-muted">Max loans</span><div class="fw-semibold" id="policyMaxLoans"></div></div>
            <div class="col-6"><span class="text-muted">Borrowing room</span><div class="fw-semibold" id="policyRemaining"></div></div>
            <div class="col-6"><span class="text-muted">Loan days</span><div class="fw-semibold" id="policyLoanDays"></div></div>
            <div class="col-6"><span class="text-muted">Renewals</span><div class="fw-semibold" id="policyRenewals"></div></div>
            <div class="col-12"><span class="text-muted">Digital access</span><div class="fw-semibold" id="policyDigital"></div></div>
          </div>
          <ul class="small mb-0 ps-3" id="policyAllowanceList"></ul>
        </div>
      </div>
    </div>

    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white border-bottom fw-bold text-primary"><i class="bi bi-box-arrow-in-left me-2"></i>Return / Renew</div>
      <div class="card-body">
        <div class="mb-3">
          <label class="form-label fw-bold" for="loanActionId">Loan id *</label>
          <input type="text" id="loanActionId" class="form-control size-md font-monospace" placeholder="LL-...">
        </div>
        <div class="d-flex gap-2 flex-wrap">
          <button type="button" class="btn btn-filled btn-success btn-md" id="btnReturn">
            <i class="bi bi-box-arrow-in-left me-1"></i> Return
          </button>
          <button type="button" class="btn btn-filled btn-secondary btn-md" id="btnRenew">Renew</button>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-8 col-lg-7">
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-white border-bottom d-flex align-items-center justify-content-between gap-2 flex-wrap">
        <div class="fw-bold text-primary"><i class="bi bi-journal-check me-2"></i>Borrowed Books</div>
        <button type="button" class="btn btn-outline-success btn-sm btn-filled" id="btnReturnSelected" disabled>
          <i class="bi bi-box-arrow-in-left me-1"></i> Return Selected
        </button>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-sm align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-3" style="width: 42px;">
                  <input type="checkbox" class="form-check-input" id="loanSelectAll" aria-label="Select all borrowed books">
                </th>
                <th class="ps-3">Book</th>
                <th>Loan ID</th>
                <th>Copy</th>
                <th>Status</th>
                <th>Due</th>
                <th>Renewals</th>
                <th class="text-end pe-3">Action</th>
              </tr>
            </thead>
            <tbody id="patronLoansBody">
              <tr><td colspan="8" class="text-center text-muted py-4">Pick a patron to see borrowed books.</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white border-bottom fw-bold text-primary"><i class="bi bi-upc-scan me-2"></i>Checkout Basket</div>
      <div class="card-body">
        <div class="row g-2 align-items-end mb-3">
          <div class="col-md-8">
            <label class="form-label fw-bold" for="copySearchTerm">Barcode or book name *</label>
            <input type="text" id="copySearchTerm" class="form-control size-md" placeholder="Scan barcode or type book title / ISBN">
          </div>
          <div class="col-md-4 d-grid">
            <button type="button" class="btn btn-filled btn-primary btn-md" id="btnSearchCopies">
              <i class="bi bi-search me-1"></i> Find Copies
            </button>
          </div>
        </div>

        <div class="table-responsive mb-3">
          <table class="table table-sm align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Found copy</th>
                <th>Type</th>
                <th>Status</th>
                <th class="text-end">Action</th>
              </tr>
            </thead>
            <tbody id="copySearchResultsBody">
              <tr><td colspan="4" class="text-center text-muted py-3">Search by barcode or book name to list available copies.</td></tr>
            </tbody>
          </table>
        </div>

        <div class="border rounded-2">
          <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom bg-light">
            <div class="fw-bold">Selected Items</div>
            <div class="small text-muted" id="basketCountLabel">0 selected</div>
          </div>
          <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
              <thead>
                <tr>
                  <th class="ps-3">Book</th>
                  <th>Copy</th>
                  <th>Type</th>
                  <th class="text-end pe-3">Action</th>
                </tr>
              </thead>
              <tbody id="checkoutBasketBody">
                <tr><td colspan="4" class="text-center text-muted py-3">No items selected.</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <div class="mt-3">
          <label class="form-label fw-bold" for="checkoutNotes">Checkout notes</label>
          <textarea id="checkoutNotes" class="form-control size-md" rows="2"></textarea>
        </div>
        <div class="d-flex justify-content-end mt-3">
          <button type="button" class="btn btn-filled btn-success btn-md" id="btnCheckout">
            <i class="bi bi-check2-circle me-1"></i> Complete Checkout
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/tablePages-end') %>

<script>
(function () {
  const patronPickerItems = <%- JSON.stringify(patronPickerRows).replace(/</g, '\\u003c') %>;
  const checkoutPatronLabel = document.getElementById('checkoutPatronLabel');
  const checkoutPatronCard = document.getElementById('checkoutPatronCard');
  const patronLoansBody = document.getElementById('patronLoansBody');
  const copySearchResultsBody = document.getElementById('copySearchResultsBody');
  const checkoutBasketBody = document.getElementById('checkoutBasketBody');
  const basketCountLabel = document.getElementById('basketCountLabel');
  const btnCheckout = document.getElementById('btnCheckout');
  const btnReturn = document.getElementById('btnReturn');
  const btnRenew = document.getElementById('btnRenew');
  const btnReturnSelected = document.getElementById('btnReturnSelected');
  const loanSelectAll = document.getElementById('loanSelectAll');

  const state = {
    patron: null,
    summary: null,
    searchResults: [],
    basket: [],
    selectedReturnLoanIds: new Set()
  };

  function showDeskMessage(options) {
    if (typeof window.showMessageModal === 'function') {
      return window.showMessageModal(options || {});
    }
    console.error('showMessageModal is unavailable for circulation desk messaging.', options || {});
    return Promise.resolve('OK');
  }

  function escapeHtml(value) {
    return String(value === undefined || value === null ? '' : value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function formatDate(value) {
    if (!value) return '';
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return String(value).slice(0, 10);
    return date.toLocaleDateString();
  }

  function dateInputValue(value) {
    const date = value ? new Date(value) : new Date();
    const validDate = Number.isNaN(date.getTime()) ? new Date() : date;
    const year = validDate.getFullYear();
    const month = String(validDate.getMonth() + 1).padStart(2, '0');
    const day = String(validDate.getDate()).padStart(2, '0');
    return year + '-' + month + '-' + day;
  }

  function dateInputToIso(value) {
    const raw = String(value || '').trim();
    if (!raw) return '';
    const date = new Date(raw + 'T23:59:00');
    if (Number.isNaN(date.getTime())) return '';
    return date.toISOString();
  }

  function addDaysDateInput(days) {
    const date = new Date();
    date.setDate(date.getDate() + Number(days || 0));
    return dateInputValue(date);
  }

  function renderBookCover(copy) {
    const url = String(copy?.coverPhotoUrl || copy?.coverPhoto?.url || '').trim();
    if (url) {
      return '<img src="' + escapeHtml(url) + '" alt="" class="rounded border bg-white" style="width: 40px; height: 54px; object-fit: cover;">';
    }
    return '<div class="rounded border bg-light text-muted d-flex align-items-center justify-content-center" style="width: 40px; height: 54px;"><i class="bi bi-book"></i></div>';
  }

  function policyDaysForCopy(copy) {
    const policy = state.summary?.policy || {};
    const isDigital = String(copy?.copyType || '').toLowerCase() === 'digital';
    return isDigital ? Number(policy.digitalAccessDays || 30) : Number(policy.loanPeriodDays || 14);
  }

  function buildCheckoutReviewItems() {
    const sharedNotes = String(document.getElementById('checkoutNotes')?.value || '').trim();
    return state.basket.map((copy) => {
      const loanDays = policyDaysForCopy(copy);
      const dueDate = addDaysDateInput(loanDays);
      const isDigital = String(copy?.copyType || '').toLowerCase() === 'digital';
      return {
        copy,
        copyId: copy.id,
        loanDays,
        dueDate,
        digitalAccessExpiresAt: isDigital ? dueDate : '',
        notes: sharedNotes
      };
    });
  }

  function renderCheckoutReviewModal(items) {
    const policy = state.summary?.policy || {};
    const allowance = state.summary?.allowance || {};
    const policyMode = allowance.overrideActive ? 'Override policy' : 'Default policy';
    const rows = items.map((item, index) => {
      const copy = item.copy || {};
      const isDigital = String(copy.copyType || '').toLowerCase() === 'digital';
      return `
        <div class="border rounded-2 p-3 mb-3" data-checkout-review-row="${index}">
          <div class="d-flex align-items-start gap-2 mb-3">
            ${renderBookCover(copy)}
            <div class="min-w-0">
              <div class="fw-bold">${escapeHtml(copy.bookTitle || copy.bookId || '')}</div>
              <div class="small text-muted font-monospace">${escapeHtml(copy.copyCode || copy.id || '')}</div>
              <div class="small text-muted">${escapeHtml(copy.copyType || '')} | ${escapeHtml(policyMode)} | ${Number(item.loanDays || 0)} day${Number(item.loanDays || 0) === 1 ? '' : 's'}</div>
            </div>
          </div>
          <input type="hidden" data-checkout-copy-id="${index}" value="${escapeHtml(copy.id || '')}">
          <div class="row g-2">
            <div class="col-md-4">
              <label class="form-label fw-bold small" for="checkoutDueAt_${index}">Return date *</label>
              <input type="date" class="form-control size-md" id="checkoutDueAt_${index}" data-checkout-due-at="${index}" value="${escapeHtml(item.dueDate || '')}">
            </div>
            <div class="col-md-4 ${isDigital ? '' : 'd-none'}">
              <label class="form-label fw-bold small" for="checkoutDigitalExpires_${index}">Digital access until</label>
              <input type="date" class="form-control size-md" id="checkoutDigitalExpires_${index}" data-checkout-digital-expires-at="${index}" value="${escapeHtml(item.digitalAccessExpiresAt || '')}">
            </div>
            <div class="${isDigital ? 'col-md-4' : 'col-md-8'}">
              <label class="form-label fw-bold small" for="checkoutItemNotes_${index}">Item notes</label>
              <input type="text" class="form-control size-md" id="checkoutItemNotes_${index}" data-checkout-item-notes="${index}" value="${escapeHtml(item.notes || '')}" maxlength="2000">
            </div>
          </div>
        </div>
      `;
    }).join('');
    return `
      <div class="text-start">
        <div class="small text-muted mb-3">
          Review each selected book before checkout. Dates are prefilled from the active ${escapeHtml(policyMode.toLowerCase())}, but you can adjust them for special conditions.
        </div>
        <div class="small mb-3">
          <span class="fw-bold">Policy:</span>
          ${escapeHtml(String(policy.patronRole || state.patron?.patronRole || 'Patron'))}
          | Physical: ${Number(policy.loanPeriodDays || 0)} days
          | Digital: ${Number(policy.digitalAccessDays || 0)} days
        </div>
        ${rows}
      </div>
    `;
  }

  function collectCheckoutReviewItems(items) {
    return items.map((item, index) => {
      const copyId = String(document.querySelector('[data-checkout-copy-id="' + index + '"]')?.value || '').trim();
      const dueDate = String(document.querySelector('[data-checkout-due-at="' + index + '"]')?.value || '').trim();
      const digitalDate = String(document.querySelector('[data-checkout-digital-expires-at="' + index + '"]')?.value || '').trim();
      const notes = String(document.querySelector('[data-checkout-item-notes="' + index + '"]')?.value || '').trim();
      return {
        copyId,
        dueAt: dateInputToIso(dueDate),
        digitalAccessExpiresAt: digitalDate ? dateInputToIso(digitalDate) : '',
        notes
      };
    });
  }

  async function confirmCheckoutDetails() {
    const items = buildCheckoutReviewItems();
    const choice = await showDeskMessage({
      title: 'Review Checkout Details',
      icon: 'info',
      size: 'lg',
      message: renderCheckoutReviewModal(items),
      buttons: [
        { text: 'Cancel', class: 'btn-secondary' },
        { text: 'Complete Checkout', class: 'btn-success' }
      ]
    });
    if (choice !== 'Complete Checkout') return null;
    const checkoutItems = collectCheckoutReviewItems(items);
    const missingDueDate = checkoutItems.some((item) => !item.copyId || !item.dueAt);
    if (missingDueDate) {
      await showDeskMessage({
        title: 'Return Date Required',
        icon: 'warning',
        message: 'Each selected book needs a valid return date before checkout.',
        buttons: [{ text: 'OK', class: 'btn-warning' }]
      });
      return confirmCheckoutDetails();
    }
    return checkoutItems;
  }

  function setButtonBusy(button, busy, busyHtml) {
    if (!button) return;
    if (busy) {
      if (!button.dataset.originalHtml) button.dataset.originalHtml = button.innerHTML;
      if (!button.dataset.originalDisabled) button.dataset.originalDisabled = button.disabled ? '1' : '0';
      button.disabled = true;
      button.innerHTML = busyHtml || '<span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span> Working...';
      return;
    }
    if (button.dataset.originalHtml) {
      button.innerHTML = button.dataset.originalHtml;
      delete button.dataset.originalHtml;
    }
    button.disabled = button.dataset.originalDisabled === '1';
    delete button.dataset.originalDisabled;
  }

  async function runWithWaiting(options, button, work) {
    const token = typeof window.showLoading === 'function'
      ? window.showLoading(options || { title: 'Please wait', note: 'Processing your request...' })
      : null;
    setButtonBusy(button, true);
    try {
      return await work();
    } finally {
      if (token && typeof window.hideLoading === 'function') window.hideLoading(token);
      else if (typeof window.hideLoading === 'function') window.hideLoading({ force: true });
      setButtonBusy(button, false);
    }
  }

  function pickerConfig(config) {
    return window.GenericPickerPresets?.normalizeConfig
      ? window.GenericPickerPresets.normalizeConfig(config)
      : config;
  }

  function actionStateId() {
    return document.getElementById('checkout_actionStateId')?.value
      || document.getElementById('actionStateIdRef')?.getAttribute('data-id')
      || '';
  }

  function selectedPatronId() {
    return String(document.getElementById('checkout_patronId')?.value || '').trim();
  }

  function remainingCapacityAfterBasket() {
    const allowance = state.summary?.allowance || {};
    if (allowance.remainingLoans === null || allowance.remainingLoans === undefined) return null;
    return Math.max(0, Number(allowance.remainingLoans || 0) - state.basket.length);
  }

  function canAddMoreItems() {
    const allowance = state.summary?.allowance || {};
    if (!allowance.canBorrow) return false;
    const remaining = remainingCapacityAfterBasket();
    return remaining === null || remaining > 0;
  }

  function setSelectedPatron(row) {
    const patronId = String(row?.patronId || row?.id || '').trim();
    document.getElementById('checkout_patronId').value = patronId;
    const name = String(row?.displayName || row?.name || row?.label || patronId).trim();
    const role = String(row?.patronRole || '').trim();
    const status = String(row?.status || '').trim();
    const card = String(row?.libraryCardNumber || row?.primaryCode || '').trim();
    document.getElementById('checkoutPatronName').textContent = name || 'Selected patron';
    document.getElementById('checkoutPatronMeta').textContent = [role, status, row?.email].filter(Boolean).join(' | ');
    document.getElementById('checkoutPatronCardNumber').textContent = card ? 'Card: ' + card : '';
    checkoutPatronCard?.classList.remove('d-none');
    checkoutPatronLabel.textContent = '';
    state.patron = row || null;
    state.basket = [];
    state.selectedReturnLoanIds = new Set();
    renderBasket();
    loadPatronWorkspace();
  }

  function openPatronPicker() {
    if (!window.GenericPicker || typeof window.GenericPicker.open !== 'function') {
      showDeskMessage({
        title: 'Picker Unavailable',
        icon: 'error',
        message: 'The patron picker could not be loaded.',
        buttons: [{ text: 'OK', class: 'btn-danger' }]
      });
      return;
    }
    window.GenericPicker.open(pickerConfig({
      sourceMode: 'local',
      localItems: patronPickerItems,
      title: 'Select Patron',
      icon: 'bi-person-vcard',
      placeholder: 'Search patrons by name, card, role, email, or person id...',
      searchFields: 'displayName,name,label,libraryCardNumber,patronRole,status,email,personId,primaryCode',
      limit: 20,
      onSelect: setSelectedPatron
    }));
  }

  function renderPolicy(summary) {
    const policy = summary?.policy || {};
    const allowance = summary?.allowance || {};
    document.getElementById('policyEmptyState')?.classList.add('d-none');
    document.getElementById('policyPanel')?.classList.remove('d-none');
    document.getElementById('policyRoleLabel').textContent = String(policy.patronRole || state.patron?.patronRole || 'Patron') + ' policy';
    const badge = document.getElementById('policyModeBadge');
    if (badge) {
      badge.textContent = allowance.overrideActive ? 'Override' : 'Default';
      badge.className = 'badge ' + (allowance.overrideActive ? 'text-bg-warning' : 'text-bg-primary');
    }
    document.getElementById('policyMaxLoans').textContent = allowance.maxLoans || 'No limit';
    document.getElementById('policyRemaining').textContent = allowance.remainingLoans === null ? 'No limit' : String(remainingCapacityAfterBasket());
    document.getElementById('policyLoanDays').textContent = String(policy.loanPeriodDays || 0);
    document.getElementById('policyRenewals').textContent = String(policy.maxRenewals || 0);
    document.getElementById('policyDigital').textContent = policy.allowDigitalDownload === false
      ? 'Not allowed'
      : String(policy.digitalAccessDays || 0) + ' days';
    const messages = Array.isArray(allowance.messages) ? allowance.messages : [];
    const overrideLine = allowance.overrideActive
      ? ['Override active', allowance.overrideValidFrom, allowance.overrideExpiresAt ? 'through ' + allowance.overrideExpiresAt : ''].filter(Boolean).join(' ')
      : '';
    document.getElementById('policyAllowanceList').innerHTML = [...messages, overrideLine]
      .filter(Boolean)
      .map((message) => '<li>' + escapeHtml(message) + '</li>')
      .join('');
  }

  function renderLoans(loans) {
    const rows = Array.isArray(loans) ? loans : [];
    state.selectedReturnLoanIds = new Set([...state.selectedReturnLoanIds].filter((loanId) => rows.some((loan) => String(loan.id) === String(loanId))));
    updateReturnSelectionControls();
    if (!rows.length) {
      patronLoansBody.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-4">No active borrowed books for this patron.</td></tr>';
      return;
    }
    patronLoansBody.innerHTML = rows.map((loan) => `
      <tr>
        <td class="ps-3">
          <input type="checkbox" class="form-check-input loan-return-check" data-loan-id="${escapeHtml(loan.id || '')}" ${state.selectedReturnLoanIds.has(String(loan.id || '')) ? 'checked' : ''} aria-label="Select loan ${escapeHtml(loan.id || '')}">
        </td>
        <td class="ps-3">
          <div class="d-flex align-items-center gap-2">
            ${renderBookCover(loan)}
            <div class="min-w-0">
              <div class="fw-semibold">${escapeHtml(loan.bookTitle || loan.bookId || '')}</div>
              <div class="x-small text-muted">${escapeHtml(loan.bookIsbn || '')}</div>
            </div>
          </div>
        </td>
        <td class="font-monospace">${escapeHtml(loan.id || '')}</td>
        <td class="font-monospace">${escapeHtml(loan.copyCode || loan.copyId || '')}</td>
        <td><span class="badge ${String(loan.status || '').toLowerCase() === 'overdue' ? 'text-bg-warning' : 'text-bg-primary'}">${escapeHtml(loan.status || '')}</span></td>
        <td>${escapeHtml(formatDate(loan.dueAt))}</td>
        <td>${Number(loan.renewalCount || 0)}</td>
        <td class="text-end pe-3">
          <button type="button" class="btn btn-outline-success btn-sm" data-return-loan-id="${escapeHtml(loan.id || '')}">
            <i class="bi bi-box-arrow-in-left me-1"></i> Return
          </button>
        </td>
      </tr>
    `).join('');
    document.querySelectorAll('.loan-return-check').forEach((checkbox) => {
      checkbox.addEventListener('change', () => {
        const loanId = String(checkbox.dataset.loanId || '').trim();
        if (!loanId) return;
        if (checkbox.checked) state.selectedReturnLoanIds.add(loanId);
        else state.selectedReturnLoanIds.delete(loanId);
        updateReturnSelectionControls();
      });
    });
    rows.forEach((loan) => {
      const button = document.querySelector('[data-return-loan-id="' + CSS.escape(String(loan.id || '')) + '"]');
      button?.addEventListener('click', () => confirmAndReturnLoans([loan], button));
    });
    updateReturnSelectionControls();
  }

  function updateReturnSelectionControls() {
    const count = state.selectedReturnLoanIds.size;
    if (btnReturnSelected) {
      btnReturnSelected.disabled = count === 0;
      btnReturnSelected.innerHTML = '<i class="bi bi-box-arrow-in-left me-1"></i> Return Selected' + (count ? ' (' + count + ')' : '');
    }
    if (loanSelectAll) {
      const loans = Array.isArray(state.summary?.loans) ? state.summary.loans : [];
      loanSelectAll.checked = loans.length > 0 && loans.every((loan) => state.selectedReturnLoanIds.has(String(loan.id || '')));
      loanSelectAll.indeterminate = count > 0 && !loanSelectAll.checked;
      loanSelectAll.disabled = loans.length === 0;
    }
  }

  async function loadPatronWorkspace() {
    const patronId = selectedPatronId();
    if (!patronId) return;
    patronLoansBody.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-4">Loading borrowed books...</td></tr>';
    try {
      const response = await fetch('/school/library/circulation/api/patrons/' + encodeURIComponent(patronId) + '/summary', {
        headers: { 'X-AJAX-Request': 'true', Accept: 'application/json' }
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok || data.status === 'error') throw new Error(data.message || 'Unable to load patron details.');
      state.summary = data;
      renderLoans(data.loans || []);
      renderPolicy(data);
      renderBasket();
    } catch (error) {
      patronLoansBody.innerHTML = '<tr><td colspan="8" class="text-center text-danger py-4">Unable to load borrowed books.</td></tr>';
      await showDeskMessage({
        title: 'Patron Details Failed',
        icon: 'error',
        message: error.message || 'Unable to load patron details.',
        buttons: [{ text: 'OK', class: 'btn-danger' }]
      });
    }
  }

  function renderSearchResults(copies) {
    const rows = Array.isArray(copies) ? copies : [];
    state.searchResults = rows;
    if (!rows.length) {
      copySearchResultsBody.innerHTML = '<tr><td colspan="4" class="text-center text-muted py-3">No available copies found.</td></tr>';
      return;
    }
    copySearchResultsBody.innerHTML = rows.map((copy) => {
      const inBasket = state.basket.some((row) => String(row.id) === String(copy.id));
      const disabled = canAddMoreItems() && !inBasket ? '' : 'disabled';
      const buttonText = inBasket ? 'Added' : 'Add';
      return `
        <tr>
          <td>
            <div class="d-flex align-items-center gap-2">
              ${renderBookCover(copy)}
              <div class="min-w-0">
                <div class="fw-semibold">${escapeHtml(copy.bookTitle || copy.bookId || '')}</div>
                <div class="x-small text-muted font-monospace">${escapeHtml(copy.copyCode || copy.id || '')}</div>
              </div>
            </div>
          </td>
          <td>${escapeHtml(copy.copyType || '')}</td>
          <td><span class="badge text-bg-success">${escapeHtml(copy.status || 'available')}</span></td>
          <td class="text-end">
            <button type="button" class="btn btn-outline-primary btn-sm" data-add-copy-id="${escapeHtml(copy.id)}" ${disabled}>${buttonText}</button>
          </td>
        </tr>
      `;
    }).join('');
    rows.forEach((copy) => {
      document.querySelector('[data-add-copy-id="' + CSS.escape(String(copy.id || '')) + '"]')?.addEventListener('click', () => addCopyToBasket(copy));
    });
  }

  async function searchCopies() {
    if (!selectedPatronId()) {
      await showDeskMessage({
        title: 'Patron Required',
        icon: 'warning',
        message: 'Pick a library patron before searching for copies.',
        buttons: [{ text: 'OK', class: 'btn-warning' }]
      });
      return;
    }
    if (!canAddMoreItems()) {
      await showDeskMessage({
        title: 'Borrowing Limit',
        icon: 'warning',
        message: 'This patron cannot borrow more items under the current policy/status.',
        buttons: [{ text: 'OK', class: 'btn-warning' }]
      });
      return;
    }
    const term = String(document.getElementById('copySearchTerm')?.value || '').trim();
    if (!term) {
      await showDeskMessage({
        title: 'Search Required',
        icon: 'warning',
        message: 'Scan a copy barcode or enter a book name.',
        buttons: [{ text: 'OK', class: 'btn-warning' }]
      });
      return;
    }
    copySearchResultsBody.innerHTML = '<tr><td colspan="4" class="text-center text-muted py-3">Searching...</td></tr>';
    try {
      const params = new URLSearchParams();
      params.set('q', term);
      params.set('exclude', state.basket.map((copy) => copy.id).join(','));
      const response = await fetch('/school/library/circulation/api/copies/search?' + params.toString(), {
        headers: { 'X-AJAX-Request': 'true', Accept: 'application/json' }
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok || data.status === 'error') throw new Error(data.message || 'Unable to search copies.');
      renderSearchResults(data.results || []);
    } catch (error) {
      copySearchResultsBody.innerHTML = '<tr><td colspan="4" class="text-center text-danger py-3">Search failed.</td></tr>';
      await showDeskMessage({
        title: 'Search Failed',
        icon: 'error',
        message: error.message || 'Unable to search copies.',
        buttons: [{ text: 'OK', class: 'btn-danger' }]
      });
    }
  }

  function addCopyToBasket(copy) {
    if (!copy?.id || state.basket.some((row) => String(row.id) === String(copy.id))) return;
    if (!canAddMoreItems()) {
      showDeskMessage({
        title: 'Borrowing Limit',
        icon: 'warning',
        message: "The basket already uses this patron's remaining borrowing room.",
        buttons: [{ text: 'OK', class: 'btn-warning' }]
      });
      return;
    }
    state.basket.push(copy);
    renderBasket();
    renderSearchResults(state.searchResults);
  }

  function removeBasketCopy(copyId) {
    state.basket = state.basket.filter((copy) => String(copy.id) !== String(copyId));
    renderBasket();
    renderSearchResults(state.searchResults);
  }

  function renderBasket() {
    basketCountLabel.textContent = state.basket.length + ' selected';
    if (!state.basket.length) {
      checkoutBasketBody.innerHTML = '<tr><td colspan="4" class="text-center text-muted py-3">No items selected.</td></tr>';
    } else {
      checkoutBasketBody.innerHTML = state.basket.map((copy) => `
        <tr>
          <td class="ps-3">
            <div class="d-flex align-items-center gap-2">
              ${renderBookCover(copy)}
              <div class="min-w-0">
                <div class="fw-semibold">${escapeHtml(copy.bookTitle || copy.bookId || '')}</div>
                <div class="x-small text-muted">${escapeHtml(copy.bookIsbn || '')}</div>
              </div>
            </div>
          </td>
          <td class="font-monospace">${escapeHtml(copy.copyCode || copy.id || '')}</td>
          <td>${escapeHtml(copy.copyType || '')}</td>
          <td class="text-end pe-3"><button type="button" class="btn btn-outline-danger btn-sm" data-remove-copy-id="${escapeHtml(copy.id)}">Remove</button></td>
        </tr>
      `).join('');
      state.basket.forEach((copy) => {
        document.querySelector('[data-remove-copy-id="' + CSS.escape(String(copy.id || '')) + '"]')?.addEventListener('click', () => removeBasketCopy(copy.id));
      });
    }
    if (state.summary) renderPolicy(state.summary);
  }

  async function guardedResult(result, titles) {
    if (typeof window.applyGuardedApiResult !== 'function') return result;
    const guarded = await window.applyGuardedApiResult(result, titles || {});
    if (guarded?.stop) return null;
    return guarded?.result || result;
  }

  function renderReturnPreview(loans) {
    const rows = Array.isArray(loans) ? loans : [];
    return '<div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>Book</th><th>Loan ID</th><th>Copy</th><th>Due</th></tr></thead><tbody>'
      + rows.map((loan) => `
        <tr>
          <td>
            <div class="d-flex align-items-center gap-2">
              ${renderBookCover(loan)}
              <div class="min-w-0">
                <div class="fw-semibold">${escapeHtml(loan.bookTitle || loan.bookId || '')}</div>
                <div class="x-small text-muted">${escapeHtml(loan.bookIsbn || '')}</div>
              </div>
            </div>
          </td>
          <td class="font-monospace">${escapeHtml(loan.id || '')}</td>
          <td class="font-monospace">${escapeHtml(loan.copyCode || loan.copyId || '')}</td>
          <td>${escapeHtml(formatDate(loan.dueAt))}</td>
        </tr>
      `).join('')
      + '</tbody></table></div>';
  }

  async function previewLoansByIds(loanIds) {
    const ids = (Array.isArray(loanIds) ? loanIds : [])
      .map((loanId) => String(loanId || '').trim())
      .filter(Boolean)
      .filter((loanId, index, arr) => arr.indexOf(loanId) === index);
    if (!ids.length) throw new Error('Loan id is required.');
    const firstId = ids[0];
    const params = new URLSearchParams();
    params.set('loanIds', ids.join(','));
    const response = await fetch('/school/library/circulation/api/loans/' + encodeURIComponent(firstId) + '/preview?' + params.toString(), {
      headers: { 'X-AJAX-Request': 'true', Accept: 'application/json' }
    });
    const data = await response.json().catch(() => ({}));
    if (!response.ok || data.status === 'error') throw new Error(data.message || 'Unable to load loan details.');
    return data.loans || [];
  }

  async function confirmAndReturnLoans(loansOrIds, button = btnReturn) {
    let loans = (Array.isArray(loansOrIds) ? loansOrIds : []).filter(Boolean);
    const hasPreviewRows = loans.every((loan) => loan && typeof loan === 'object' && loan.id);
    try {
      if (!hasPreviewRows) {
        loans = await runWithWaiting({
          title: 'Loading Loan Details',
          note: 'Finding the borrowed book before return confirmation...',
          operation: 'Loan preview'
        }, button, () => previewLoansByIds(loans));
      }
      if (!loans.length) throw new Error('Loan not found.');
      const choice = await showDeskMessage({
        title: loans.length === 1 ? 'Confirm Return' : 'Confirm Returns',
        icon: 'warning',
        size: 'lg',
        message: renderReturnPreview(loans),
        buttons: [
          { text: 'Cancel', class: 'btn-secondary' },
          { text: loans.length === 1 ? 'Return Book' : 'Return Books', class: 'btn-success' }
        ]
      });
      if (choice !== 'Return Book' && choice !== 'Return Books') return;
      await returnLoans(loans.map((loan) => loan.id), button);
    } catch (error) {
      await showDeskMessage({
        title: 'Return Failed',
        icon: 'error',
        message: error.message || 'Unable to return selected loans.',
        buttons: [{ text: 'OK', class: 'btn-danger' }]
      });
    }
  }

  async function returnLoans(loanIds, button = btnReturn) {
    await runWithWaiting({
      title: 'Recording Return',
      note: 'Updating the loan and making the copy available...',
      operation: 'Library return'
    }, button, async () => {
      const response = await fetch('/school/library/circulation/api/return', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-AJAX-Request': 'true' },
        body: JSON.stringify({ actionStateId: actionStateId(), loanIds })
      });
      let data = await response.json().catch(() => ({ status: 'error', message: 'Server returned an unexpected response.' }));
      data = await guardedResult(data, { busyTitle: 'Return In Progress', replayTitle: 'Return Already Completed' });
      if (!data) return;
      if (!response.ok || data.status !== 'success') throw new Error(data.message || 'Return failed.');
      await showDeskMessage({
        title: 'Return Recorded',
        icon: 'success',
        message: data.message || 'Return recorded.',
        buttons: [{ text: 'OK', class: 'btn-success' }]
      });
      state.selectedReturnLoanIds = new Set();
      if (selectedPatronId()) await loadPatronWorkspace();
    });
    updateReturnSelectionControls();
  }

  document.getElementById('deskPickPatron')?.addEventListener('click', openPatronPicker);
  document.getElementById('btnSearchCopies')?.addEventListener('click', searchCopies);
  document.getElementById('copySearchTerm')?.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') {
      event.preventDefault();
      searchCopies();
    }
  });

  loanSelectAll?.addEventListener('change', () => {
    const loans = Array.isArray(state.summary?.loans) ? state.summary.loans : [];
    state.selectedReturnLoanIds = loanSelectAll.checked
      ? new Set(loans.map((loan) => String(loan.id || '')).filter(Boolean))
      : new Set();
    renderLoans(loans);
  });
  btnReturnSelected?.addEventListener('click', () => {
    const loans = Array.isArray(state.summary?.loans) ? state.summary.loans : [];
    const selected = loans.filter((loan) => state.selectedReturnLoanIds.has(String(loan.id || '')));
    confirmAndReturnLoans(selected, btnReturnSelected);
  });

  btnCheckout?.addEventListener('click', async () => {
    const patronId = selectedPatronId();
    if (!patronId) {
      await showDeskMessage({
        title: 'Patron Required',
        icon: 'warning',
        message: 'Pick a library patron before checkout.',
        buttons: [{ text: 'OK', class: 'btn-warning' }]
      });
      return;
    }
    if (!state.basket.length) {
      await showDeskMessage({
        title: 'Basket Empty',
        icon: 'warning',
        message: 'Add at least one available copy to the checkout basket.',
        buttons: [{ text: 'OK', class: 'btn-warning' }]
      });
      return;
    }

    try {
      const checkoutItems = await confirmCheckoutDetails();
      if (!checkoutItems) return;
      const data = await runWithWaiting({
        title: 'Completing Checkout',
        note: 'Creating loan records and updating selected copies...',
        operation: 'Library checkout'
      }, btnCheckout, async () => {
      const response = await fetch('/school/library/circulation/api/checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-AJAX-Request': 'true' },
        body: JSON.stringify({
          actionStateId: actionStateId(),
          patronId,
          copyIds: state.basket.map((copy) => copy.id),
          checkoutItems,
          notes: document.getElementById('checkoutNotes').value
        })
      });
      let data = await response.json().catch(() => ({ status: 'error', message: 'Server returned an unexpected response.' }));
      data = await guardedResult(data, { busyTitle: 'Checkout In Progress', replayTitle: 'Checkout Already Completed' });
      if (!data) return;
      if (!response.ok || data.status !== 'success') throw new Error(data.message || 'Checkout failed.');
      return data;
      });
      if (!data) return;
      const loans = Array.isArray(data.loans) ? data.loans : (data.loan ? [data.loan] : []);
      document.getElementById('loanActionId').value = loans[loans.length - 1]?.id || '';
      await showDeskMessage({
        title: 'Checkout Complete',
        icon: 'success',
        message: data.message || 'Checkout complete.',
        buttons: [{ text: 'OK', class: 'btn-success' }]
      });
      state.basket = [];
      renderBasket();
      await loadPatronWorkspace();
    } catch (error) {
      await showDeskMessage({
        title: 'Checkout Failed',
        icon: 'error',
        message: error.message || 'Checkout failed.',
        buttons: [{ text: 'OK', class: 'btn-danger' }]
      });
      await loadPatronWorkspace();
    }
  });

  async function postLoanAction(path, title) {
    const loanId = document.getElementById('loanActionId').value.trim();
    if (!loanId) {
      await showDeskMessage({
        title: 'Loan Required',
        icon: 'warning',
        message: 'Enter a loan id first.',
        buttons: [{ text: 'OK', class: 'btn-warning' }]
      });
      return;
    }
    try {
      const response = await runWithWaiting({
        title: title,
        note: 'Updating the selected loan...',
        operation: 'Library circulation'
      }, btnRenew, () => fetch(path, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-AJAX-Request': 'true' },
        body: JSON.stringify({ actionStateId: actionStateId(), loanId })
      }));
      let data = await response.json().catch(() => ({ status: 'error', message: 'Server returned an unexpected response.' }));
      data = await guardedResult(data, { busyTitle: title + ' In Progress', replayTitle: title + ' Already Completed' });
      if (!data) return;
      if (!response.ok || data.status !== 'success') throw new Error(data.message || 'Action failed.');
      await showDeskMessage({
        title,
        icon: 'success',
        message: data.message || 'Done.',
        buttons: [{ text: 'OK', class: 'btn-success' }]
      });
      if (selectedPatronId()) await loadPatronWorkspace();
    } catch (error) {
      await showDeskMessage({
        title: title + ' Failed',
        icon: 'error',
        message: error.message || 'Action failed.',
        buttons: [{ text: 'OK', class: 'btn-danger' }]
      });
    }
  }

  btnReturn?.addEventListener('click', () => {
    const loanId = document.getElementById('loanActionId').value.trim();
    if (!loanId) {
      showDeskMessage({
        title: 'Loan Required',
        icon: 'warning',
        message: 'Enter a loan id first.',
        buttons: [{ text: 'OK', class: 'btn-warning' }]
      });
      return;
    }
    confirmAndReturnLoans([loanId], btnReturn);
  });
  btnRenew?.addEventListener('click', () => postLoanAction('/school/library/circulation/api/renew', 'Loan Renewed'));
})();
</script>
