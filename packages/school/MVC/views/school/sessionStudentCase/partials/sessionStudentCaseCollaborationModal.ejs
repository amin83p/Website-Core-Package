<div class="modal fade" id="studentCaseCollaborationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold"><i class="bi bi-people me-2"></i>Assignment &amp; sharing</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted mb-3">People listed here can access this case. Assign a primary handler or share with collaborators; recipients receive a chat message with a link to open the case.</p>
                <div class="mb-3">
                    <div class="fw-semibold small text-uppercase text-muted mb-1">Category reviewers</div>
                    <div id="studentCaseCollabRoutingList" class="small text-muted">—</div>
                </div>
                <div class="mb-3">
                    <div class="fw-semibold small text-uppercase text-muted mb-1">Primary assignee</div>
                    <div id="studentCaseCollabAssignedDetail" class="small">—</div>
                </div>
                <div class="mb-3">
                    <div class="fw-semibold small text-uppercase text-muted mb-1">Collaborators</div>
                    <ul id="studentCaseCollabCollaboratorsList" class="small mb-0 ps-3 student-case-collab-person-list"></ul>
                </div>
                <div id="studentCaseCollabActions" class="d-flex flex-wrap gap-2 d-none">
                    <button type="button" class="btn btn-outline-primary btn-sm" id="btnStudentCaseCollabAssign">
                        <i class="bi bi-person-check me-1"></i>Assign to…
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnStudentCaseCollabShare">
                        <i class="bi bi-share me-1"></i>Share with…
                    </button>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
