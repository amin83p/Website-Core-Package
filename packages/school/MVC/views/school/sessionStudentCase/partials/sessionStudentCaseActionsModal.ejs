<div class="modal fade" id="studentCaseActionsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold"><i class="bi bi-journal-text me-2"></i>Case activity</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted mb-3">Work logs and system updates for this case. Private entries are visible only to users with resolve access and the author.</p>
                <div id="studentCaseActionsTimeline" class="student-case-timeline student-case-timeline--full mb-4" role="list" aria-label="Full case activity history"></div>
                <div id="studentCaseActionsTimelineEmpty" class="student-case-timeline-empty small text-muted mb-4 d-none">No activity recorded yet.</div>
                <div id="studentCaseActionsCompose" class="student-case-compose border rounded p-3 d-none">
                    <div class="fw-semibold mb-2"><i class="bi bi-plus-circle me-1"></i>Add your action</div>
                    <label class="form-label small mb-1" for="studentCaseActionBody">What did you do?</label>
                    <textarea class="form-control mb-2" id="studentCaseActionBody" rows="4" maxlength="5000" placeholder="Describe the steps you took, calls made, follow-ups, or notes for the team."></textarea>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="studentCaseActionPrivate" value="1">
                        <label class="form-check-label small" for="studentCaseActionPrivate">
                            <span class="fw-semibold">Private</span> — only users with resolve access (and you) will see this entry in the timeline.
                        </label>
                    </div>
                    <label class="form-label small mb-1" for="studentCaseActionFile">Attachment (optional, max 2 MB)</label>
                    <input type="file" class="form-control form-control-sm mb-2" id="studentCaseActionFile" accept=".jpg,.jpeg,.png,.gif,.webp,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv,.zip">
                    <div class="form-check mb-2 d-none" id="studentCaseActionRemoveAttachmentWrap">
                        <input class="form-check-input" type="checkbox" id="studentCaseActionRemoveAttachment" value="1">
                        <label class="form-check-label small" for="studentCaseActionRemoveAttachment">Remove current attachment</label>
                    </div>
                    <input type="hidden" id="studentCaseActionEditId" value="">
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnStudentCaseActionClear">Clear</button>
                        <button type="button" class="btn btn-sm btn-primary" id="btnStudentCaseActionSave">
                            <i class="bi bi-check2-circle me-1"></i>Save action
                        </button>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
