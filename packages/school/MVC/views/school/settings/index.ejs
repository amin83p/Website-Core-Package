  canUpdate: canUpdateFlag,
  sessionNotificationEmailTokens,
  sessionNotificationEmailWrapperBuiltinMappings: typeof sessionNotificationEmailWrapperBuiltinMappings !== 'undefined' ? sessionNotificationEmailWrapperBuiltinMappings : [],
  sessionNotificationEmailContextSources: typeof sessionNotificationEmailContextSources !== 'undefined' ? sessionNotificationEmailContextSources : []
}) %>
<%- include('school/settings/partials/sessionNotificationTestEmailModal') %>
<script src="/scripts/htmlTemplateEditor.js"></script>
<script src="/scripts/sessionNotificationEmailBodyModal.js"></script>

<script>
(() => {
  const canUpdate = <%= canUpdateFlag ? 'true' : 'false' %>;
  let conductLevels = <%- conductLevelsJson %>;
  let attendanceItems = <%- attendanceItemsJson %>;
  let autosavePolicy = <%- autosavePolicyJson %>;
  const autosaveSections = <%- autosaveSectionsJson %>;
  let sessionAccessPolicy = <%- sessionAccessPolicyJson %>;
  const sessionNotificationEmailTokens = <%- sessionNotificationEmailTokensJson %>;
  const sessionNotificationEmailDefaultBody = <%- sessionNotificationEmailDefaultBodyJson %>;
  const sessionNotificationEmailWrapperBuiltinMappings = <%- sessionNotificationEmailWrapperBuiltinMappingsJson %>;
  const sessionNotificationEmailContextSources = <%- sessionNotificationEmailContextSourcesJson %>;
  let studentAttendanceReportPolicy = <%- studentAttendanceReportPolicyJson %>;
  let timesheetParametersPolicy = <%- timesheetParametersPolicyJson %>;
  const studentAttendanceReportOverallLabels = <%- studentAttendanceReportOverallLabelsJson %>;
  let sarReportTemplateCapabilities = <%- studentAttendanceReportTemplateCapabilitiesJson %>;
  let sarOverallTemplates = [];
  let attendanceThresholdsEnabled = <%= attendanceThresholdsEnabledFlag ? 'true' : 'false' %>;
  let rollupFormula = <%- rollupFormulaJson %>;
  let attendanceMarkAppearancePolicy = <%- attendanceMarkAppearancePolicyJson %>;
  const attendanceMarkCuratedIcons = <%- attendanceMarkCuratedIconsJson %>;
  const conductBody = document.getElementById('conductSettingsBody');
  const attendanceMarksBody = document.getElementById('attendanceMarksSettingsBody');
  const attendanceBody = document.getElementById('attendanceSettingsBody');
  const rollupGraceBody = document.getElementById('rollupGraceBody');
  const autosaveBody = document.getElementById('autosaveSettingsBody');
  const settingsWorkspace = document.getElementById('schoolSettingsWorkspace');
  const settingsSidebarToggle = document.getElementById('btnToggleSettingsSidebar');
  const settingsSidebarToggleIcon = document.getElementById('settingsSidebarToggleIcon');
  const settingsSidebarToggleText = document.getElementById('settingsSidebarToggleText');
  const settingsNavItems = [...document.querySelectorAll('[data-settings-target]')];
  const settingsPanels = [...document.querySelectorAll('.school-settings-panel')];
  const settingsSidebarStorageKey = 'schoolSettingsSidebarCollapsed';

  const escapeHtml = value => String(value ?? '').replace(/[&<>"']/g, character => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;'
  }[character]));

  function readSettingsHash() {
    try {
      return decodeURIComponent(String(window.location.hash || '').replace(/^#/, '').trim());
    } catch (_) {
      return '';
    }
  }

  function setActiveSettingsPanel(target, { updateHash = false, focusPanel = false } = {}) {
    const requested = String(target || '').trim();
    const nextPanel = settingsPanels.find(panel => panel.id === requested) || settingsPanels[0] || null;
    if (!nextPanel) return;

    settingsPanels.forEach(panel => {
      const active = panel === nextPanel;
      panel.classList.toggle('active', active);
      panel.hidden = !active;
    });
    settingsNavItems.forEach(item => {
      const active = item.dataset.settingsTarget === nextPanel.id;
      item.classList.toggle('active', active);
      item.setAttribute('aria-selected', active ? 'true' : 'false');
      item.tabIndex = active ? 0 : -1;
    });

    if (updateHash && readSettingsHash() !== nextPanel.id) {
      window.location.hash = nextPanel.id;
    }
    if (focusPanel) nextPanel.focus({ preventScroll: true });
  }

  function setSettingsSidebarCollapsed(collapsed, { remember = true } = {}) {
    if (!settingsWorkspace) return;
    const isCollapsed = collapsed === true;
    settingsWorkspace.classList.toggle('sidebar-collapsed', isCollapsed);
    settingsSidebarToggle?.setAttribute('aria-expanded', isCollapsed ? 'false' : 'true');
    const label = isCollapsed ? 'Expand settings sidebar' : 'Collapse settings sidebar';
    if (settingsSidebarToggle) settingsSidebarToggle.title = label;
    if (settingsSidebarToggleText) settingsSidebarToggleText.textContent = label;
    if (settingsSidebarToggleIcon) {
      settingsSidebarToggleIcon.className = isCollapsed
        ? 'bi bi-layout-sidebar'
        : 'bi bi-layout-sidebar-inset';
    }
    if (remember) {
      try {
        window.localStorage.setItem(settingsSidebarStorageKey, isCollapsed ? '1' : '0');
      } catch (_) {
        // Storage can be unavailable in privacy-restricted browsers.
      }
    }
  }

  settingsSidebarToggle?.addEventListener('click', () => {
    setSettingsSidebarCollapsed(!settingsWorkspace?.classList.contains('sidebar-collapsed'));
  });

  settingsNavItems.forEach((item, index) => {
    item.addEventListener('click', event => {
      event.preventDefault();
      const target = item.dataset.settingsTarget || '';
      setActiveSettingsPanel(target, { updateHash: true });
      if (window.matchMedia('(max-width: 767.98px)').matches) {
        setSettingsSidebarCollapsed(true);
        document.getElementById(target)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
    item.addEventListener('keydown', event => {
      if (!['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      let nextIndex = index;
      if (event.key === 'ArrowDown') nextIndex = (index + 1) % settingsNavItems.length;
      if (event.key === 'ArrowUp') nextIndex = (index - 1 + settingsNavItems.length) % settingsNavItems.length;
      if (event.key === 'Home') nextIndex = 0;
      if (event.key === 'End') nextIndex = settingsNavItems.length - 1;
      const nextItem = settingsNavItems[nextIndex];
      if (!nextItem) return;
      nextItem.focus();
      setActiveSettingsPanel(nextItem.dataset.settingsTarget, { updateHash: true });
    });
  });

  window.addEventListener('hashchange', () => setActiveSettingsPanel(readSettingsHash()));

  try {
    setSettingsSidebarCollapsed(window.localStorage.getItem(settingsSidebarStorageKey) === '1', { remember: false });
  } catch (_) {
    setSettingsSidebarCollapsed(false, { remember: false });
  }
  setActiveSettingsPanel(readSettingsHash());

  function setPanelError(id, message = '') {
    const element = document.getElementById(id);
    if (!element) return;
    element.textContent = String(message || '');
    element.classList.toggle('d-none', !message);
  }

  async function showSettingsMessage({ title = 'School Settings', message = '', icon = 'info', buttonClass = 'btn-primary' } = {}) {
    if (typeof window.showMessageModal === 'function' && document.getElementById('messageModal')) {
      return window.showMessageModal({
        title,
        icon,
        message: escapeHtml(message),
        buttons: [{ text: 'OK', class: buttonClass }]
      });
    }
    window.alert(String(message || title));
    return 'OK';
  }

  function renderConductLevels() {
    if (!conductBody) return;
    const disabled = canUpdate ? '' : 'disabled';
    conductBody.innerHTML = conductLevels.map((level, index) => `
      <tr data-level-index="${index}">
        <td class="fw-bold font-monospace">${escapeHtml(level.code)}</td>
        <td><input class="form-control form-control-sm js-conduct-label" maxlength="80" value="${escapeHtml(level.label || level.code)}" ${disabled} aria-label="${escapeHtml(level.code)} label"></td>
        <td><input class="form-control form-control-sm js-conduct-display" maxlength="8" value="${escapeHtml(level.displayCode || level.code)}" ${disabled} aria-label="${escapeHtml(level.code)} display code"></td>
        <td><input class="form-control form-control-sm js-conduct-min" type="number" min="0" max="100" step="0.5" value="${escapeHtml(level.minPercent)}" ${disabled} aria-label="${escapeHtml(level.code)} minimum percentage"></td>
        <td><input class="form-control form-control-sm js-conduct-max" type="number" min="0" max="100" step="0.5" value="${escapeHtml(level.maxPercent)}" ${disabled} aria-label="${escapeHtml(level.code)} maximum percentage"></td>
        <td><input class="form-control form-control-sm js-conduct-default" type="number" min="0" max="100" step="0.5" value="${escapeHtml(level.defaultPercent)}" ${disabled} aria-label="${escapeHtml(level.code)} default percentage"></td>
      </tr>
    `).join('') + `
      <tr class="table-light">
        <td class="fw-bold font-monospace">NA</td>
        <td>Not Available</td>
        <td>N/A</td>
        <td colspan="3" class="small text-muted">Fixed non-percentage option</td>
      </tr>
    `;
  }

  function collectConductLevels() {
    return [...conductBody.querySelectorAll('tr[data-level-index]')].map(row => {
      const index = Number(row.dataset.levelIndex);
      return {
        code: String(conductLevels[index]?.code || ''),
        label: row.querySelector('.js-conduct-label')?.value || '',
        displayCode: row.querySelector('.js-conduct-display')?.value || '',
        minPercent: row.querySelector('.js-conduct-min')?.value,
        maxPercent: row.querySelector('.js-conduct-max')?.value,
        defaultPercent: row.querySelector('.js-conduct-default')?.value
      };
    });
  }

  function getAttendanceMarksRows() {
    return Array.isArray(attendanceMarkAppearancePolicy?.marks)
      ? attendanceMarkAppearancePolicy.marks
      : [];
  }

  function syncAttendanceMarkColorInputs(row) {
    const colorInput = row.querySelector('.js-attendance-mark-color');
    const hexInput = row.querySelector('.js-attendance-mark-color-hex');
    if (!colorInput || !hexInput) return;
    const syncFromColor = () => {
      hexInput.value = String(colorInput.value || '').toUpperCase();
      refreshAttendanceMarkPreview(row);
    };
    const syncFromHex = () => {
      const token = String(hexInput.value || '').trim();
      if (/^#[0-9A-Fa-f]{6}$/.test(token)) {
        colorInput.value = token.toUpperCase();
        refreshAttendanceMarkPreview(row);
      }
    };
    colorInput.addEventListener('input', syncFromColor);
    hexInput.addEventListener('change', syncFromHex);
    row.querySelector('.js-attendance-mark-label')?.addEventListener('input', () => refreshAttendanceMarkPreview(row));
    row.querySelector('.js-attendance-mark-icon')?.addEventListener('input', () => refreshAttendanceMarkPreview(row));
  }

  function refreshAttendanceMarkPreview(row) {
    const preview = row.querySelector('.js-attendance-mark-preview');
    if (!preview) return;
    const key = String(row.dataset.markKey || '').trim();
    const icon = String(row.querySelector('.js-attendance-mark-icon')?.value || '').trim();
    const color = String(row.querySelector('.js-attendance-mark-color')?.value || '#000000').trim();
    if (key === 'timing_excuse_ring') {
      preview.innerHTML = `<span class="attendance-timing-excuse-icon attendance-timing-excuse-full d-inline-grid" style="width:1.35em;height:1.35em;border-color:${escapeHtml(color)}"><i class="bi bi-clock-fill" style="color:${escapeHtml(color)}"></i></span>`;
      return;
    }
  const ringClass = key === 'excused_absence'
      ? 'attendance-timing-excuse-full'
      : (key === 'late_excused'
        ? 'attendance-timing-excuse-left'
        : (key === 'early_leave_excused' ? 'attendance-timing-excuse-right' : ''));
    const iconHtml = icon ? `<i class="bi bi-${escapeHtml(icon)}" style="color:${escapeHtml(color)}"></i>` : '';
    preview.innerHTML = ringClass
      ? `<span class="attendance-timing-excuse-icon ${ringClass} d-inline-grid" style="width:1.35em;height:1.35em;"><span style="color:${escapeHtml(color)}">${iconHtml}</span></span>`
      : iconHtml;
  }

  function renderAttendanceMarks() {
    if (!attendanceMarksBody) return;
    const disabled = canUpdate ? '' : 'disabled';
    const marks = getAttendanceMarksRows();
    attendanceMarksBody.innerHTML = marks.map((mark, index) => {
      const key = String(mark.key || '').trim();
      const colorOnly = key === 'timing_excuse_ring';
      const color = String(mark.color || '#000000').trim();
      return `
        <tr data-mark-index="${index}" data-mark-key="${escapeHtml(key)}">
          <td class="fw-semibold font-monospace small">${escapeHtml(key)}</td>
          <td><input class="form-control form-control-sm js-attendance-mark-label" maxlength="80" value="${escapeHtml(mark.label || key)}" ${disabled} aria-label="${escapeHtml(key)} label"></td>
          <td>
            ${colorOnly
              ? '<span class="small text-muted">Color only</span>'
              : `<input class="form-control form-control-sm js-attendance-mark-icon" maxlength="64" list="attendanceMarkIconOptions" value="${escapeHtml(mark.icon || '')}" ${disabled} aria-label="${escapeHtml(key)} icon">`}
          </td>
          <td>
            <div class="d-flex align-items-center gap-2">
              <input class="form-control form-control-color js-attendance-mark-color p-1" type="color" value="${escapeHtml(color)}" ${disabled} aria-label="${escapeHtml(key)} color">
              <input class="form-control form-control-sm js-attendance-mark-color-hex font-monospace" maxlength="7" value="${escapeHtml(color)}" ${disabled} aria-label="${escapeHtml(key)} hex color">
            </div>
          </td>
          <td class="text-center js-attendance-mark-preview"></td>
        </tr>
      `;
    }).join('');
    attendanceMarksBody.querySelectorAll('tr[data-mark-index]').forEach((row) => {
      syncAttendanceMarkColorInputs(row);
      refreshAttendanceMarkPreview(row);
    });
  }

  function collectAttendanceMarks() {
    return [...attendanceMarksBody.querySelectorAll('tr[data-mark-index]')].map((row) => {
      const index = Number(row.dataset.markIndex);
      const key = String(getAttendanceMarksRows()[index]?.key || row.dataset.markKey || '').trim();
      const colorOnly = key === 'timing_excuse_ring';
      return {
        key,
        label: row.querySelector('.js-attendance-mark-label')?.value || '',
        icon: colorOnly ? '' : (row.querySelector('.js-attendance-mark-icon')?.value || ''),
        color: row.querySelector('.js-attendance-mark-color-hex')?.value
          || row.querySelector('.js-attendance-mark-color')?.value
          || ''
      };
    });
  }

  function normalizeAttendanceClientItems() {
    if (!attendanceItems.length) {
      attendanceItems = [{
        id: '',
        scheduledMinutes: 180,
        disqualifyLateMinutes: 30,
        disqualifyEarlyLeaveMinutes: 30,
        disqualifyCombinedMissedMinutes: null,
        isDefault: true
      }];
    }
    if (!attendanceItems.some(item => item.isDefault)) attendanceItems[0].isDefault = true;
  }

  function renderAttendanceItems() {
    if (!attendanceBody) return;
    normalizeAttendanceClientItems();
    const editorEnabled = canUpdate && attendanceThresholdsEnabled;
    const disabled = editorEnabled ? '' : 'disabled';
    attendanceBody.innerHTML = attendanceItems.map((item, index) => {
      const combinedOn = item.disqualifyCombinedMissedMinutes !== null
        && item.disqualifyCombinedMissedMinutes !== undefined
        && item.disqualifyCombinedMissedMinutes !== '';
      return `
        <tr data-attendance-index="${index}">
          <td><input class="form-control form-control-sm js-attendance-duration" type="number" min="1" max="1440" step="1" value="${escapeHtml(item.scheduledMinutes)}" ${disabled} aria-label="Scheduled duration minutes"></td>
          <td><input class="form-control form-control-sm js-attendance-late" type="number" min="0" max="1440" step="1" value="${escapeHtml(item.disqualifyLateMinutes)}" ${disabled} aria-label="Late threshold minutes"></td>
          <td><input class="form-control form-control-sm js-attendance-early" type="number" min="0" max="1440" step="1" value="${escapeHtml(item.disqualifyEarlyLeaveMinutes)}" ${disabled} aria-label="Early leave threshold minutes"></td>
          <td>
            <div class="d-flex align-items-center gap-2">
              <input class="form-check-input js-attendance-combined-on" type="checkbox" ${combinedOn ? 'checked' : ''} ${disabled} aria-label="Enable combined threshold">
              <input class="form-control form-control-sm js-attendance-combined" type="number" min="1" max="1440" step="1" value="${combinedOn ? escapeHtml(item.disqualifyCombinedMissedMinutes) : ''}" ${combinedOn && editorEnabled ? '' : 'disabled'} aria-label="Combined missed minutes threshold">
            </div>
          </td>
          <td class="text-center"><input class="form-check-input js-attendance-default" type="radio" name="attendanceDefaultItem" ${item.isDefault ? 'checked' : ''} ${disabled} aria-label="Use as default duration"></td>
          ${canUpdate ? `<td><button class="btn btn-outline-danger btn-sm js-remove-attendance-item" type="button" ${attendanceItems.length <= 1 || !editorEnabled ? 'disabled' : ''} aria-label="Remove duration"><i class="bi bi-trash"></i></button></td>` : ''}
        </tr>
      `;
    }).join('');

    attendanceBody.querySelectorAll('.js-attendance-combined-on').forEach(checkbox => {
      checkbox.addEventListener('change', () => {
        const input = checkbox.closest('td')?.querySelector('.js-attendance-combined');
        if (input) input.disabled = !editorEnabled || !checkbox.checked;
      });
    });
    attendanceBody.querySelectorAll('.js-remove-attendance-item').forEach(button => {
      button.addEventListener('click', () => {
        readAttendanceItems();
        const index = Number(button.closest('tr')?.dataset.attendanceIndex);
        if (!Number.isInteger(index) || attendanceItems.length <= 1) return;
        attendanceItems.splice(index, 1);
        normalizeAttendanceClientItems();
        renderAttendanceItems();
      });
    });
    refreshAttendanceThresholdState();
  }

  function refreshAttendanceThresholdState() {
    const toggle = document.getElementById('attendanceThresholdsEnabled');
    const label = document.getElementById('attendanceThresholdsEnabledLabel');
    const editor = document.getElementById('attendanceThresholdEditor');
    const addButton = document.getElementById('btnAddAttendanceDuration');
    if (toggle) toggle.checked = attendanceThresholdsEnabled;
    if (label) label.textContent = attendanceThresholdsEnabled ? 'On' : 'Off';
    editor?.classList.toggle('is-disabled', !attendanceThresholdsEnabled);
    if (addButton) addButton.disabled = !canUpdate || !attendanceThresholdsEnabled;
  }

  function readAttendanceItems() {
    attendanceItems = [...attendanceBody.querySelectorAll('tr[data-attendance-index]')].map((row, index) => {
      const combinedOn = row.querySelector('.js-attendance-combined-on')?.checked === true;
      const combinedValue = row.querySelector('.js-attendance-combined')?.value;
      return {
        id: String(attendanceItems[index]?.id || ''),
        scheduledMinutes: Number(row.querySelector('.js-attendance-duration')?.value || 0),
        disqualifyLateMinutes: Number(row.querySelector('.js-attendance-late')?.value || 0),
        disqualifyEarlyLeaveMinutes: Number(row.querySelector('.js-attendance-early')?.value || 0),
        disqualifyCombinedMissedMinutes: combinedOn && combinedValue !== '' ? Number(combinedValue) : null,
        useCombinedThreshold: combinedOn,
        isDefault: row.querySelector('.js-attendance-default')?.checked === true
      };
    });
    normalizeAttendanceClientItems();
    return attendanceItems;
  }

  async function postSettings(url, payload, button, errorId, { disableButton = true } = {}) {
    if (!canUpdate) return null;
    if (disableButton && button) button.disabled = true;
    setPanelError(errorId);
    try {
      const response = await fetch(url, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded',
          Accept: 'application/json',
          'X-AJAX-Request': 'true'
        },
        body: new URLSearchParams(payload).toString()
      });
      const result = await response.json().catch(() => null);
      if (!response.ok || !result || result.status !== 'success') {
        throw new Error(result?.message || 'Unable to save School Settings.');
      }
      return result;
    } catch (error) {
      const message = error?.message || 'Unable to save School Settings.';
      setPanelError(errorId, message);
      await showSettingsMessage({
        title: 'Settings Not Saved',
        message,
        icon: 'error',
        buttonClass: 'btn-danger'
      });
      return null;
    } finally {
      if (disableButton && button) button.disabled = false;
    }
  }

  document.getElementById('conductSettingsForm')?.addEventListener('submit', async event => {
    event.preventDefault();
    const button = document.getElementById('btnSaveConductSettings');
    if (!button) return;
    const result = await postSettings('/school/settings/conduct-rating-scale', {
      actionStateId: event.currentTarget.elements.actionStateId?.value || '',
      levels: JSON.stringify(collectConductLevels())
    }, button, 'conductSettingsError');
    if (!result) return;
    conductLevels = Array.isArray(result.policy?.levels) ? result.policy.levels : conductLevels;
    renderConductLevels();
  renderAttendanceMarks();
    await showSettingsMessage({ title: 'Settings Saved', message: result.message, icon: 'success' });
  });

  document.getElementById('attendanceMarksSettingsForm')?.addEventListener('submit', async event => {
    event.preventDefault();
    const button = document.getElementById('btnSaveAttendanceMarksSettings');
    if (!button) return;
    const result = await postSettings('/school/settings/attendance-marks', {
      actionStateId: event.currentTarget.elements.actionStateId?.value || '',
      marks: JSON.stringify(collectAttendanceMarks())
    }, button, 'attendanceMarksSettingsError');
    if (!result) return;
    attendanceMarkAppearancePolicy = result.policy && typeof result.policy === 'object'
      ? result.policy
      : attendanceMarkAppearancePolicy;
    renderAttendanceMarks();
    await showSettingsMessage({ title: 'Settings Saved', message: result.message, icon: 'success' });
  });

  document.getElementById('attendanceSettingsForm')?.addEventListener('submit', async event => {
    event.preventDefault();
    const button = document.getElementById('btnSaveAttendanceSettings');
    if (!button) return;
    const result = await postSettings('/school/settings/attendance-matrix', {
      actionStateId: event.currentTarget.elements.actionStateId?.value || '',
      thresholdsEnabled: String(attendanceThresholdsEnabled),
      items: JSON.stringify(readAttendanceItems())
    }, button, 'attendanceSettingsError');
    if (!result) return;
    attendanceThresholdsEnabled = result.thresholdsEnabled !== false;
    attendanceItems = Array.isArray(result.items) ? result.items : attendanceItems;
    renderAttendanceItems();
    renderRollupGraceItems();
    await showSettingsMessage({ title: 'Settings Saved', message: result.message, icon: 'success' });
  });

  document.getElementById('btnAddAttendanceDuration')?.addEventListener('click', () => {
    if (!attendanceThresholdsEnabled) return;
    readAttendanceItems();
    const usedDurations = new Set(attendanceItems.map(item => Number(item.scheduledMinutes)));
    let duration = 60;
    while (usedDurations.has(duration) && duration < 1440) duration += 30;
    attendanceItems.push({
      id: '',
      scheduledMinutes: Math.min(duration, 1440),
      disqualifyLateMinutes: 30,
      disqualifyEarlyLeaveMinutes: 30,
      disqualifyCombinedMissedMinutes: null,
      isDefault: false
    });
    renderAttendanceItems();
  });

  document.getElementById('attendanceThresholdsEnabled')?.addEventListener('change', event => {
    readAttendanceItems();
    attendanceThresholdsEnabled = event.currentTarget.checked === true;
    renderAttendanceItems();
  });

  function rollupFlag(value, fallback = false) {
    if (value === true || value === 1) return true;
    if (value === false || value === 0) return false;
    const token = String(value ?? '').trim().toLowerCase();
    if (['true', '1', 'on', 'yes'].includes(token)) return true;
    if (['false', '0', 'off', 'no'].includes(token)) return false;
    return fallback;
  }

  function syncRollupFormulaFromDom() {
    rollupFormula = {
      includeUnmarkedSessions: document.getElementById('includeUnmarkedSessions')?.checked === true,
      countUnmarkedAsAbsent: document.getElementById('countUnmarkedAsAbsent')?.checked === true,
      includeLateGrace: document.getElementById('includeLateGrace')?.checked === true,
      includeEarlyGrace: document.getElementById('includeEarlyGrace')?.checked === true,
      includeLateExcusedRule: document.getElementById('includeLateExcusedRule')?.checked === true,
      includeEarlyExcusedRule: document.getElementById('includeEarlyExcusedRule')?.checked === true,
      lateExcusedTreatment: String(document.getElementById('lateExcusedTreatment')?.value || 'reduce_credit'),
      earlyExcusedTreatment: String(document.getElementById('earlyExcusedTreatment')?.value || 'reduce_credit')
    };
    return rollupFormula;
  }

  function readRollupGraceItems() {
    if (!rollupGraceBody) return attendanceItems;
    return [...rollupGraceBody.querySelectorAll('tr[data-grace-index]')].map((row, index) => {
      const base = attendanceItems[index] || {};
      return {
        id: String(base.id || ''),
        scheduledMinutes: Number(base.scheduledMinutes) || 0,
        rollupLateGraceMinutes: Number(row.querySelector('.js-late-grace')?.value || 0),
        rollupEarlyLeaveGraceMinutes: Number(row.querySelector('.js-early-grace')?.value || 0),
        isDefault: base.isDefault === true
      };
    });
  }

  function refreshRollupFeatureCards() {
    const unmarkedOn = document.getElementById('includeUnmarkedSessions')?.checked === true;
    const lateGraceOn = document.getElementById('includeLateGrace')?.checked === true;
    const earlyGraceOn = document.getElementById('includeEarlyGrace')?.checked === true;
    const lateExcusedOn = document.getElementById('includeLateExcusedRule')?.checked === true;
    const earlyExcusedOn = document.getElementById('includeEarlyExcusedRule')?.checked === true;

    document.getElementById('cardUnmarked')?.classList.toggle('is-disabled', !unmarkedOn);
    const countUnmarked = document.getElementById('countUnmarkedAsAbsent');
    if (countUnmarked) countUnmarked.disabled = !canUpdate || !unmarkedOn;

    document.getElementById('cardLateGrace')?.classList.toggle('is-disabled', !lateGraceOn);
    document.getElementById('cardEarlyGrace')?.classList.toggle('is-disabled', !earlyGraceOn);

    document.getElementById('cardLateExcused')?.classList.toggle('is-disabled', !lateExcusedOn);
    const lateTreatment = document.getElementById('lateExcusedTreatment');
    if (lateTreatment) lateTreatment.disabled = !canUpdate || !lateExcusedOn;

    document.getElementById('cardEarlyExcused')?.classList.toggle('is-disabled', !earlyExcusedOn);
    const earlyTreatment = document.getElementById('earlyExcusedTreatment');
    if (earlyTreatment) earlyTreatment.disabled = !canUpdate || !earlyExcusedOn;

    rollupGraceBody?.querySelectorAll('.js-late-grace').forEach((input) => {
      input.disabled = !canUpdate || !lateGraceOn;
    });
    rollupGraceBody?.querySelectorAll('.js-early-grace').forEach((input) => {
      input.disabled = !canUpdate || !earlyGraceOn;
    });
  }

  function renderRollupFormulaControls() {
    const includeUnmarked = document.getElementById('includeUnmarkedSessions');
    const countUnmarked = document.getElementById('countUnmarkedAsAbsent');
    const includeLateGrace = document.getElementById('includeLateGrace');
    const includeEarlyGrace = document.getElementById('includeEarlyGrace');
    const includeLateExcused = document.getElementById('includeLateExcusedRule');
    const includeEarlyExcused = document.getElementById('includeEarlyExcusedRule');
    const lateTreatment = document.getElementById('lateExcusedTreatment');
    const earlyTreatment = document.getElementById('earlyExcusedTreatment');
    if (!includeUnmarked) return;

    includeUnmarked.checked = rollupFlag(rollupFormula.includeUnmarkedSessions, false);
    countUnmarked.checked = rollupFlag(rollupFormula.countUnmarkedAsAbsent, false);
    includeLateGrace.checked = rollupFlag(rollupFormula.includeLateGrace, true);
    includeEarlyGrace.checked = rollupFlag(rollupFormula.includeEarlyGrace, true);
    includeLateExcused.checked = rollupFlag(rollupFormula.includeLateExcusedRule, true);
    includeEarlyExcused.checked = rollupFlag(rollupFormula.includeEarlyExcusedRule, true);
    lateTreatment.value = rollupFormula.lateExcusedTreatment || 'reduce_credit';
    earlyTreatment.value = rollupFormula.earlyExcusedTreatment || 'reduce_credit';
    refreshRollupFeatureCards();
  }

  function renderRollupGraceItems() {
    if (!rollupGraceBody) return;
    normalizeAttendanceClientItems();
    if (!attendanceItems.length) {
      rollupGraceBody.innerHTML = '<tr><td colspan="3" class="text-muted small">No session durations configured. Add durations under Attendance Matrix Thresholds first.</td></tr>';
      return;
    }
    const disabled = canUpdate ? '' : 'disabled';
    rollupGraceBody.innerHTML = attendanceItems.map((item, index) => `
      <tr data-grace-index="${index}">
        <td class="fw-semibold">${escapeHtml(item.scheduledMinutes)}${item.isDefault ? ' <span class="badge bg-secondary-subtle text-secondary border">Default</span>' : ''}</td>
        <td><input class="form-control form-control-sm js-late-grace" type="number" min="0" max="1440" step="1" value="${escapeHtml(item.rollupLateGraceMinutes ?? 0)}" ${disabled} aria-label="Late grace minutes"></td>
        <td><input class="form-control form-control-sm js-early-grace" type="number" min="0" max="1440" step="1" value="${escapeHtml(item.rollupEarlyLeaveGraceMinutes ?? 0)}" ${disabled} aria-label="Early leave grace minutes"></td>
      </tr>
    `).join('');
    refreshRollupFeatureCards();
  }

  [
    'includeUnmarkedSessions', 'includeLateGrace', 'includeEarlyGrace',
    'includeLateExcusedRule', 'includeEarlyExcusedRule'
  ].forEach((id) => {
    document.getElementById(id)?.addEventListener('change', refreshRollupFeatureCards);
  });

  document.getElementById('rollupFormulaForm')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = document.getElementById('btnSaveRollupFormula');
    if (!button) return;
    const formula = syncRollupFormulaFromDom();
    const result = await postSettings('/school/settings/attendance-rollup', {
      actionStateId: event.currentTarget.elements.actionStateId?.value || '',
      includeUnmarkedSessions: String(formula.includeUnmarkedSessions),
      countUnmarkedAsAbsent: String(formula.countUnmarkedAsAbsent),
      includeLateGrace: String(formula.includeLateGrace),
      includeEarlyGrace: String(formula.includeEarlyGrace),
      includeLateExcusedRule: String(formula.includeLateExcusedRule),
      includeEarlyExcusedRule: String(formula.includeEarlyExcusedRule),
      lateExcusedTreatment: formula.lateExcusedTreatment,
      earlyExcusedTreatment: formula.earlyExcusedTreatment,
      graceItems: JSON.stringify(readRollupGraceItems())
    }, button, 'rollupSettingsError');
    if (!result) return;
    rollupFormula = result.rollupFormula && typeof result.rollupFormula === 'object'
      ? result.rollupFormula
      : rollupFormula;
    if (Array.isArray(result.graceItems)) {
      attendanceItems = result.graceItems;
    }
    renderRollupFormulaControls();
    renderRollupGraceItems();
    await showSettingsMessage({ title: 'Settings Saved', message: result.message, icon: 'success' });
  });

  function renderAutosaveSections() {
    if (!autosaveBody) return;
    const disabled = canUpdate ? '' : 'disabled';
    const sections = autosavePolicy?.sections && typeof autosavePolicy.sections === 'object'
      ? autosavePolicy.sections
      : {};
    autosaveBody.innerHTML = (autosaveSections || []).map((section) => {
      const row = sections[section.key] || {};
      const enabled = row.enabledByDefault === true;
      const minutes = row.defaultMinutes == null ? '' : String(row.defaultMinutes);
      return `
        <tr data-autosave-section="${escapeHtml(section.key)}">
          <td>
            <div class="fw-semibold">${escapeHtml(section.title || section.key)}</div>
            <div class="small text-muted">${escapeHtml(section.description || '')}</div>
          </td>
          <td class="text-center">
            <input class="form-check-input js-autosave-enabled" type="checkbox" ${enabled ? 'checked' : ''} ${disabled} aria-label="${escapeHtml(section.title || section.key)} enabled by default">
          </td>
          <td>
            <input class="form-control form-control-sm js-autosave-minutes" type="number" min="1" max="60" step="1" value="${escapeHtml(minutes)}" placeholder="Use default" ${disabled} aria-label="${escapeHtml(section.title || section.key)} minutes override">
          </td>
        </tr>
      `;
    }).join('');
  }

  function collectAutosaveSections() {
    const sections = {};
    autosaveBody?.querySelectorAll('tr[data-autosave-section]').forEach((row) => {
      const key = String(row.dataset.autosaveSection || '').trim();
      if (!key) return;
      const minutesRaw = row.querySelector('.js-autosave-minutes')?.value;
      sections[key] = {
        enabledByDefault: row.querySelector('.js-autosave-enabled')?.checked === true,
        defaultMinutes: minutesRaw === '' || minutesRaw == null ? null : Number(minutesRaw)
      };
    });
    return sections;
  }

  function formatSarTemplateLabel(item = {}, fallbackId = '') {
    const id = String(item?.id || fallbackId || '').trim();
    const title = String(item?.title || id).trim();
    const type = String(item?.type || '').trim();
    const version = Number(item?.version) || 1;
    if (!id) return '';
    return type ? `${title} | ${type} v${version}` : `${title} v${version}`;
  }

  function normalizeSarOverallTemplateRows(rows = []) {
    const seen = new Set();
    return (Array.isArray(rows) ? rows : [])
      .map((row) => {
        const id = String(row?.id || row?.templateId || '').trim();
        return {
          id,
          label: String(row?.label || row?.title || row?.templateTitle || id).trim() || id,
          hasDocx: row?.hasDocx === true,
          hasPdf: row?.hasPdf === true
        };
      })
      .filter((row) => row.id)
      .filter((row) => {
        const key = row.id.toLowerCase();
        if (seen.has(key)) return false;
        seen.add(key);
        return true;
      });
  }

  function defaultReportExportFormats() {
    return { docx: true, pdf: true, payload: true };
  }

  function defaultOverallExportFormats() {
    return { docx: true, pdf: true, payload: true };
  }

  function ensureSarTemplateExportFormats() {
    if (!studentAttendanceReportPolicy.templateExportFormats || typeof studentAttendanceReportPolicy.templateExportFormats !== 'object') {
      studentAttendanceReportPolicy.templateExportFormats = { report: {}, overall: {} };
    }
    if (!studentAttendanceReportPolicy.templateExportFormats.report) studentAttendanceReportPolicy.templateExportFormats.report = {};
    if (!studentAttendanceReportPolicy.templateExportFormats.overall) studentAttendanceReportPolicy.templateExportFormats.overall = {};
  }

  function getSarReportExportFormats(templateId = '') {
    ensureSarTemplateExportFormats();
    const id = String(templateId || studentAttendanceReportPolicy.reportTemplateId || '').trim();
    if (!id) return defaultReportExportFormats();
    return {
      ...defaultReportExportFormats(),
      ...(studentAttendanceReportPolicy.templateExportFormats.report[id] || {})
    };
  }

  function getSarOverallExportFormats(templateId = '') {
    ensureSarTemplateExportFormats();
    const id = String(templateId || '').trim();
    if (!id) return defaultOverallExportFormats();
    return {
      ...defaultOverallExportFormats(),
      ...(studentAttendanceReportPolicy.templateExportFormats.overall[id] || {})
    };
  }

  function setSarReportExportFormats(templateId = '', formats = {}) {
    ensureSarTemplateExportFormats();
    const id = String(templateId || '').trim();
    if (!id) return;
    studentAttendanceReportPolicy.templateExportFormats.report[id] = {
      docx: formats.docx !== false,
      pdf: formats.pdf !== false,
      payload: formats.payload !== false
    };
  }

  function setSarOverallExportFormats(templateId = '', formats = {}) {
    ensureSarTemplateExportFormats();
    const id = String(templateId || '').trim();
    if (!id) return;
    studentAttendanceReportPolicy.templateExportFormats.overall[id] = {
      docx: formats.docx !== false,
      pdf: formats.pdf !== false,
      payload: formats.payload !== false
    };
  }

  function collectSarTemplateExportFormats() {
    ensureSarTemplateExportFormats();
    const reportId = String(document.getElementById('sarReportTemplateId')?.value || '').trim();
    if (reportId) {
      setSarReportExportFormats(reportId, {
        docx: document.getElementById('sarReportExportDocx')?.checked === true,
        pdf: document.getElementById('sarReportExportPdf')?.checked === true,
        payload: document.getElementById('sarReportExportPayload')?.checked === true
      });
    }
    sarOverallTemplates.forEach((row) => {
      const docxInput = document.querySelector(`.js-sar-overall-export-docx[data-template-id="${CSS.escape(row.id)}"]`);
      const pdfInput = document.querySelector(`.js-sar-overall-export-pdf[data-template-id="${CSS.escape(row.id)}"]`);
      const payloadInput = document.querySelector(`.js-sar-overall-export-payload[data-template-id="${CSS.escape(row.id)}"]`);
      setSarOverallExportFormats(row.id, {
        docx: docxInput ? docxInput.checked : getSarOverallExportFormats(row.id).docx !== false,
        pdf: pdfInput ? pdfInput.checked : getSarOverallExportFormats(row.id).pdf !== false,
        payload: payloadInput ? payloadInput.checked : getSarOverallExportFormats(row.id).payload !== false
      });
    });
    const pruned = { report: {}, overall: {} };
    if (reportId) pruned.report[reportId] = getSarReportExportFormats(reportId);
    sarOverallTemplates.forEach((row) => {
      pruned.overall[row.id] = getSarOverallExportFormats(row.id);
    });
    return pruned;
  }

  function renderSarReportExportFormatControls() {
    const panel = document.getElementById('sarReportExportFormatsPanel');
    const reportId = String(document.getElementById('sarReportTemplateId')?.value || '').trim();
    if (!panel) return;
    panel.classList.toggle('d-none', !reportId);
    if (!reportId) return;
    const formats = getSarReportExportFormats(reportId);
    const docxInput = document.getElementById('sarReportExportDocx');
    const pdfInput = document.getElementById('sarReportExportPdf');
    const payloadInput = document.getElementById('sarReportExportPayload');
    if (docxInput) {
      docxInput.checked = formats.docx !== false;
      docxInput.disabled = !canUpdate || !sarReportTemplateCapabilities?.hasDocx;
    }
    if (pdfInput) {
      pdfInput.checked = formats.pdf !== false;
      pdfInput.disabled = !canUpdate || !sarReportTemplateCapabilities?.hasPdf;
    }
    if (payloadInput) {
      payloadInput.checked = formats.payload !== false;
      payloadInput.disabled = !canUpdate;
    }
  }

  function syncSarOverallTemplateInputs() {
    const ids = sarOverallTemplates.map((row) => row.id).filter(Boolean);
    const firstId = ids[0] || '';
    const legacyInput = document.getElementById('sarOverallTemplateId');
    const listInput = document.getElementById('sarOverallTemplateIds');
    if (legacyInput) legacyInput.value = firstId;
    if (listInput) listInput.value = JSON.stringify(ids);
    studentAttendanceReportPolicy.overallReportTemplateId = firstId;
    studentAttendanceReportPolicy.overallReportTemplateIds = ids;
  }

  function renderSarOverallTemplates() {
    const body = document.getElementById('sarOverallTemplatesBody');
    if (!body) return;
    syncSarOverallTemplateInputs();
    if (!sarOverallTemplates.length) {
      body.innerHTML = `<tr><td colspan="${canUpdate ? 6 : 5}" class="text-muted small py-3">No overall templates selected.</td></tr>`;
      return;
    }
    body.innerHTML = sarOverallTemplates.map((row, index) => {
      const canMoveUp = index > 0;
      const canMoveDown = index < sarOverallTemplates.length - 1;
      const formats = getSarOverallExportFormats(row.id);
      return `
        <tr data-sar-overall-index="${index}">
          <td><span class="badge bg-secondary">${index + 1}</span></td>
          <td>
            <div class="fw-semibold">${escapeHtml(row.label || row.id)}</div>
            <div class="small text-muted font-monospace">${escapeHtml(row.id)}</div>
          </td>
          <td>
            <div class="form-check form-switch mb-0">
              <input class="form-check-input js-sar-overall-export-docx" type="checkbox" data-template-id="${escapeHtml(row.id)}" ${formats.docx !== false ? 'checked' : ''} ${canUpdate && row.hasDocx ? '' : 'disabled'}>
            </div>
          </td>
          <td>
            <div class="form-check form-switch mb-0">
              <input class="form-check-input js-sar-overall-export-pdf" type="checkbox" data-template-id="${escapeHtml(row.id)}" ${formats.pdf !== false ? 'checked' : ''} ${canUpdate && row.hasPdf ? '' : 'disabled'}>
            </div>
          </td>
          <td>
            <div class="form-check form-switch mb-0">
              <input class="form-check-input js-sar-overall-export-payload" type="checkbox" data-template-id="${escapeHtml(row.id)}" ${formats.payload !== false ? 'checked' : ''} ${canUpdate ? '' : 'disabled'}>
            </div>
          </td>
          ${canUpdate ? `
            <td class="text-end text-nowrap">
              <button type="button" class="btn btn-outline-secondary btn-sm js-sar-overall-up" data-index="${index}" ${canMoveUp ? '' : 'disabled'} title="Move up"><i class="bi bi-arrow-up"></i></button>
              <button type="button" class="btn btn-outline-secondary btn-sm js-sar-overall-down" data-index="${index}" ${canMoveDown ? '' : 'disabled'} title="Move down"><i class="bi bi-arrow-down"></i></button>
              <button type="button" class="btn btn-outline-danger btn-sm js-sar-overall-remove" data-index="${index}" title="Remove"><i class="bi bi-x-lg"></i></button>
            </td>
          ` : ''}
        </tr>
      `;
    }).join('');
  }

  function initializeSarOverallTemplates(labels = studentAttendanceReportOverallLabels) {
    const labelMap = new Map(normalizeSarOverallTemplateRows(labels).map((row) => [row.id, row]));
    const ids = Array.isArray(studentAttendanceReportPolicy?.overallReportTemplateIds)
      ? studentAttendanceReportPolicy.overallReportTemplateIds
      : (studentAttendanceReportPolicy?.overallReportTemplateId ? [studentAttendanceReportPolicy.overallReportTemplateId] : []);
    sarOverallTemplates = normalizeSarOverallTemplateRows(ids.map((id) => {
      const cleanId = String(id || '').trim();
      return labelMap.get(cleanId) || { id: cleanId, label: cleanId };
    }));
    renderSarOverallTemplates();
  }

  function addSarOverallTemplate(item = {}) {
    const id = String(item?.id || '').trim();
    if (!id) return;
    const label = formatSarTemplateLabel(item, id);
    sarOverallTemplates = normalizeSarOverallTemplateRows([...sarOverallTemplates, {
      id,
      label,
      hasDocx: item?.hasDocx === true || item?.hasAttachedDocx === true || Boolean(item?.docxTemplate?.path),
      hasPdf: item?.hasPdf === true || item?.hasAttachedPdf === true || Boolean(item?.hasPdfTemplate) || Boolean(item?.pdfTemplate?.path)
    }]);
    setSarOverallExportFormats(id, defaultOverallExportFormats());
    renderSarOverallTemplates();
  }

  document.getElementById('btnPickSarReportTemplate')?.addEventListener('click', () => {
    if (!window.GenericPicker || !window.GenericPickerPresets) return;
    GenericPicker.open(GenericPickerPresets.normalizeConfig({
      title: 'Select Report Template',
      icon: 'bi-journal-text',
      apiEndpoint: '/school/reports/templates',
      placeholder: 'Search templates...',
      onSelect: (item) => {
        const id = String(item?.id || '').trim();
        if (!id) return;
        document.getElementById('sarReportTemplateId').value = id;
        document.getElementById('sarReportTemplateTitle').value = formatSarTemplateLabel(item, id);
        studentAttendanceReportPolicy.reportTemplateId = id;
        sarReportTemplateCapabilities = {
          hasDocx: Boolean(item?.hasDocxTemplate || item?.docxTemplate?.path),
          hasPdf: Boolean(item?.hasPdfTemplate || item?.pdfTemplate?.path)
        };
        setSarReportExportFormats(id, defaultReportExportFormats());
        renderSarReportExportFormatControls();
      }
    }));
  });

  document.getElementById('btnPickSarOverallTemplate')?.addEventListener('click', () => {
    if (!window.GenericPicker || !window.GenericPickerPresets) return;
    GenericPicker.open(GenericPickerPresets.normalizeConfig({
      title: 'Select Overall Report Template',
      icon: 'bi-layers',
      apiEndpoint: '/school/reports/overall-templates',
      placeholder: 'Search overall templates...',
      onSelect: (item) => {
        addSarOverallTemplate(item);
      }
    }));
  });

  document.getElementById('btnClearSarOverallTemplate')?.addEventListener('click', () => {
    sarOverallTemplates = [];
    renderSarOverallTemplates();
  });

  document.getElementById('sarOverallTemplatesBody')?.addEventListener('click', (event) => {
    const up = event.target.closest('.js-sar-overall-up');
    const down = event.target.closest('.js-sar-overall-down');
    const remove = event.target.closest('.js-sar-overall-remove');
    const button = up || down || remove;
    if (!button) return;
    const index = Number(button.getAttribute('data-index'));
    if (!Number.isInteger(index) || index < 0 || index >= sarOverallTemplates.length) return;
    if (remove) {
      sarOverallTemplates.splice(index, 1);
    } else {
      const delta = up ? -1 : 1;
      const nextIndex = index + delta;
      if (nextIndex < 0 || nextIndex >= sarOverallTemplates.length) return;
      const [row] = sarOverallTemplates.splice(index, 1);
      sarOverallTemplates.splice(nextIndex, 0, row);
    }
    renderSarOverallTemplates();
  });

  document.getElementById('studentAttendanceReportSettingsForm')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = document.getElementById('btnSaveStudentAttendanceReportSettings');
    if (!button) return;
    const result = await postSettings('/school/settings/student-attendance-report', {
      actionStateId: event.currentTarget.elements.actionStateId?.value || '',
      reportTemplateId: document.getElementById('sarReportTemplateId')?.value || '',
      overallReportTemplateId: document.getElementById('sarOverallTemplateId')?.value || '',
      overallReportTemplateIds: document.getElementById('sarOverallTemplateIds')?.value || '[]',
      templateExportFormats: JSON.stringify(collectSarTemplateExportFormats())
    }, button, 'studentAttendanceReportSettingsError');
