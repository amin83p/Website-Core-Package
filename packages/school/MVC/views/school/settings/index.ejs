      <section class="school-settings-panel card border-0 shadow-sm" id="student-attendance-report" role="tabpanel" aria-labelledby="settings-tab-student-attendance-report" tabindex="0" hidden>
        <header class="school-settings-panel-header card-header px-4 py-3">
          <div class="d-flex align-items-center gap-3">
            <span class="school-settings-nav-icon"><i class="bi bi-file-earmark-person" aria-hidden="true"></i></span>
            <div>
              <h2 class="h5 fw-bold mb-1">Student Attendance Report</h2>
              <p class="small text-muted mb-0">Choose templates used when generating reports from the Student Attendance Report page.</p>
            </div>
          </div>
        </header>
        <div class="card-body p-4">
          <p class="small text-muted mb-3">
            The report template supplies per-class attendance span data for each enrolled class in the selected date range.
            An optional overall report template merges multiple source slots into one document (classes map to slots by order).
          </p>
          <div class="alert alert-danger d-none js-settings-error" id="studentAttendanceReportSettingsError" role="alert"></div>
          <form id="studentAttendanceReportSettingsForm" novalidate>
            <input type="hidden" name="actionStateId" value="<%= actionStateId || '' %>">
            <div class="row g-3 mb-3">
              <div class="col-lg-6">
                <label class="form-label fw-semibold" for="sarReportTemplateTitle">Report template</label>
                <input type="hidden" name="reportTemplateId" id="sarReportTemplateId" value="<%= typeof studentAttendanceReportPolicy !== 'undefined' && studentAttendanceReportPolicy?.reportTemplateId ? studentAttendanceReportPolicy.reportTemplateId : '' %>">
                <div class="input-group">
                  <input class="form-control" type="text" id="sarReportTemplateTitle" readonly placeholder="No template selected" value="<%= typeof studentAttendanceReportTemplateLabel !== 'undefined' ? studentAttendanceReportTemplateLabel : '' %>">
                  <% if (canUpdateFlag) { %>
                    <button class="btn btn-outline-secondary" type="button" id="btnPickSarReportTemplate"><i class="bi bi-search"></i></button>
                  <% } %>
                </div>
                <div class="form-text">Required to generate reports from the Student Attendance Report page.</div>
                <div class="border rounded p-3 mt-3 <%= typeof studentAttendanceReportPolicy !== 'undefined' && studentAttendanceReportPolicy?.reportTemplateId ? '' : 'd-none' %>" id="sarReportExportFormatsPanel">
                  <div class="fw-semibold small mb-2">Export formats for Student Attendance Report</div>
                  <div class="d-flex flex-wrap gap-3">
                    <div class="form-check form-switch">
                      <input class="form-check-input" type="checkbox" id="sarReportExportDocx" <%= typeof studentAttendanceReportTemplateCapabilities !== 'undefined' && studentAttendanceReportTemplateCapabilities?.hasDocx ? '' : 'disabled' %>>
                      <label class="form-check-label" for="sarReportExportDocx">DOCX</label>
                    </div>
                    <div class="form-check form-switch">
                      <input class="form-check-input" type="checkbox" id="sarReportExportPdf" <%= typeof studentAttendanceReportTemplateCapabilities !== 'undefined' && studentAttendanceReportTemplateCapabilities?.hasPdf ? '' : 'disabled' %>>
                      <label class="form-check-label" for="sarReportExportPdf">PDF</label>
                    </div>
                    <div class="form-check form-switch">
                      <input class="form-check-input" type="checkbox" id="sarReportExportPayload" checked>
                      <label class="form-check-label" for="sarReportExportPayload">Payload</label>
                    </div>
                  </div>
                  <div class="form-text mt-2 mb-0">DOCX and PDF toggles require matching template files. These settings apply only to Student Attendance Report exports.</div>
                </div>
              </div>
              <div class="col-12">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                  <div>
                    <label class="form-label fw-semibold mb-1" for="sarOverallTemplateIds">Overall report templates (optional)</label>
                    <div class="form-text mt-0">Ordered options for merged reports. Class report rows always use the selected class report template.</div>
                  </div>
                  <% if (canUpdateFlag) { %>
                    <div class="d-flex gap-2">
                      <button class="btn btn-outline-secondary btn-sm" type="button" id="btnPickSarOverallTemplate">
                        <i class="bi bi-search me-1"></i>Add Overall Template
                      </button>
                      <button class="btn btn-outline-secondary btn-sm" type="button" id="btnClearSarOverallTemplate" title="Clear overall templates">
                        <i class="bi bi-x-lg me-1"></i>Clear
                      </button>
                    </div>
                  <% } %>
                </div>
                <input type="hidden" name="overallReportTemplateId" id="sarOverallTemplateId" value="<%= typeof studentAttendanceReportPolicy !== 'undefined' && studentAttendanceReportPolicy?.overallReportTemplateId ? studentAttendanceReportPolicy.overallReportTemplateId : '' %>">
                <input type="hidden" name="overallReportTemplateIds" id="sarOverallTemplateIds" value="">
                <div class="table-responsive border rounded">
                  <table class="table table-sm align-middle mb-0 school-settings-table" id="sarOverallTemplatesTable">
                    <thead class="table-light">
                      <tr>
                        <th style="width: 56px;">Order</th>
                        <th>Overall template</th>
                        <th style="width: 7rem;">DOCX</th>
                        <th style="width: 7rem;">PDF</th>
                        <th style="width: 7rem;">Payload</th>
                        <% if (canUpdateFlag) { %><th class="text-end" style="width: 190px;">Actions</th><% } %>
                      </tr>
                    </thead>
                    <tbody id="sarOverallTemplatesBody">
                      <tr><td colspan="<%= canUpdateFlag ? 6 : 5 %>" class="text-muted small py-3">No overall templates selected.</td></tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
            <% if (canUpdateFlag) { %>
              <div class="d-flex justify-content-end">
                <button class="btn btn-primary" type="submit" id="btnSaveStudentAttendanceReportSettings">
                  <i class="bi bi-save me-1"></i>Save Student Attendance Report Settings
                </button>
              </div>
            <% } %>
          </form>
        </div>
      </section>

      <section class="school-settings-panel card border-0 shadow-sm" id="timesheet-parameters" role="tabpanel" aria-labelledby="settings-tab-timesheet-parameters" tabindex="0" hidden>
        <header class="school-settings-panel-header card-header px-4 py-3">
          <div class="d-flex align-items-center gap-3">
            <span class="school-settings-nav-icon"><i class="bi bi-calendar2-week" aria-hidden="true"></i></span>
            <div>
              <h2 class="h5 fw-bold mb-1">Timesheet Parameters</h2>
              <p class="small text-muted mb-0">Control how class sessions with no student enrollment appear on instructor timesheets and how statutory holiday pay is calculated.</p>
            </div>
          </div>
        </header>
        <div class="card-body p-4">
          <div class="alert alert-danger d-none js-settings-error" id="timesheetParametersSettingsError" role="alert"></div>
          <form id="timesheetParametersSettingsForm" novalidate>
            <input type="hidden" name="actionStateId" value="<%= actionStateId || '' %>">
            <div class="rollup-feature-card">
              <div class="fw-semibold mb-1">Sessions with no student enrollment</div>
              <p class="small text-muted mb-3">Applies to class sessions that have no active enrolled students on the session date. School activity work sessions are not affected.</p>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="emptyEnrollmentSessions" id="emptyEnrollmentShowWithHours" value="show_with_hours" <%= emptyEnrollmentSessionsValue === 'show_with_hours' ? 'checked' : '' %> <%= canUpdateFlag ? '' : 'disabled' %>>
                <label class="form-check-label" for="emptyEnrollmentShowWithHours">Show in the timesheet with its hour</label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="emptyEnrollmentSessions" id="emptyEnrollmentShowWithoutHours" value="show_without_hours" <%= emptyEnrollmentSessionsValue === 'show_without_hours' ? 'checked' : '' %> <%= canUpdateFlag ? '' : 'disabled' %>>
                <label class="form-check-label" for="emptyEnrollmentShowWithoutHours">Show in the timesheet without its hour</label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="emptyEnrollmentSessions" id="emptyEnrollmentHide" value="hide" <%= emptyEnrollmentSessionsValue === 'hide' ? 'checked' : '' %> <%= canUpdateFlag ? '' : 'disabled' %>>
                <label class="form-check-label" for="emptyEnrollmentHide">Do not show in the timesheet</label>
              </div>
            </div>
            <div class="rollup-feature-card mt-4">
              <div class="d-flex align-items-center justify-content-between gap-3 mb-1">
                <div class="fw-semibold">Statutory holiday pay</div>
                <div class="form-check form-switch mb-0">
                  <input class="form-check-input" type="checkbox" role="switch" id="statutoryHolidayPayEnabled" name="statutoryHolidayPayEnabled" value="true" <%= statutoryHolidayPayEnabled ? 'checked' : '' %> <%= canUpdateFlag ? '' : 'disabled' %>>
                  <label class="form-check-label" for="statutoryHolidayPayEnabled">Enabled</label>
                </div>
              </div>
              <p class="small text-muted mb-3">When eligible, auto-add a statutory holiday pay row to timesheets using payable workday history, approved leave checks, and a rolling average-hours formula.</p>
              <div class="row g-3">
                <div class="col-md-4">
                  <label class="form-label small fw-semibold" for="statutoryHolidayMinWorkdays">Minimum workdays</label>
                  <input class="form-control" type="number" min="1" max="365" id="statutoryHolidayMinWorkdays" name="statutoryHolidayMinWorkdays" value="<%= statutoryHolidayPayPolicy.minWorkdays || 30 %>" <%= canUpdateFlag ? '' : 'disabled' %>>
                  <div class="form-text">Distinct payable workdays required before the holiday.</div>
                </div>
                <div class="col-md-4">
                  <label class="form-label small fw-semibold" for="statutoryHolidayWeekdayOccurrencesRequired">Weekday occurrences required</label>
                  <input class="form-control" type="number" min="1" max="9" id="statutoryHolidayWeekdayOccurrencesRequired" name="statutoryHolidayWeekdayOccurrencesRequired" value="<%= statutoryHolidayPayPolicy.weekdayOccurrencesRequired || 5 %>" <%= canUpdateFlag ? '' : 'disabled' %>>
                  <div class="form-text">Payable hours on at least this many of the previous same weekdays.</div>
                </div>
                <div class="col-md-4">
                  <label class="form-label small fw-semibold" for="statutoryHolidayWeekdayOccurrencesLookback">Weekday lookback count</label>
                  <input class="form-control" type="number" min="1" max="52" id="statutoryHolidayWeekdayOccurrencesLookback" name="statutoryHolidayWeekdayOccurrencesLookback" value="<%= statutoryHolidayPayPolicy.weekdayOccurrencesLookback || 9 %>" <%= canUpdateFlag ? '' : 'disabled' %>>
                  <div class="form-text">How many prior same-weekday occurrences to review.</div>
                </div>
                <div class="col-md-4">
                  <label class="form-label small fw-semibold" for="statutoryHolidayEarningsLookbackWeeks">Earnings lookback (weeks)</label>
                  <input class="form-control" type="number" min="1" max="12" id="statutoryHolidayEarningsLookbackWeeks" name="statutoryHolidayEarningsLookbackWeeks" value="<%= statutoryHolidayPayPolicy.earningsLookbackWeeks || 4 %>" <%= canUpdateFlag ? '' : 'disabled' %>>
                  <div class="form-text">Average payable hours are calculated over this window.</div>
                </div>
                <div class="col-md-4">
                  <label class="form-label small fw-semibold" for="statutoryHolidayBeforeAfterSearchDays">Before/after search days</label>
                  <input class="form-control" type="number" min="1" max="60" id="statutoryHolidayBeforeAfterSearchDays" name="statutoryHolidayBeforeAfterSearchDays" value="<%= statutoryHolidayPayPolicy.beforeAfterSearchDays || 14 %>" <%= canUpdateFlag ? '' : 'disabled' %>>
                  <div class="form-text">How far to search for adjacent payable workdays.</div>
                </div>
              </div>
              <div class="mt-3">
                <div class="fw-semibold small mb-2">Paid holiday types</div>
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" id="payableHolidayType_National_Holiday" name="payableHolidayType_National_Holiday" value="National Holiday" <%= payableHolidayTypesSelected.includes('National Holiday') ? 'checked' : '' %> <%= canUpdateFlag ? '' : 'disabled' %>>
                  <label class="form-check-label" for="payableHolidayType_National_Holiday">National Holiday</label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" id="payableHolidayType_Observance_Paid" name="payableHolidayType_Observance_Paid" value="Observance Paid" <%= payableHolidayTypesSelected.includes('Observance Paid') ? 'checked' : '' %> <%= canUpdateFlag ? '' : 'disabled' %>>
                  <label class="form-check-label" for="payableHolidayType_Observance_Paid">Observance Paid</label>
                </div>
              </div>
              <div class="mt-3">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" id="statutoryHolidayDisqualifyOnLeaveDuringHolidayWeek" name="statutoryHolidayDisqualifyOnLeaveDuringHolidayWeek" value="true" <%= statutoryHolidayPayPolicy.disqualifyOnLeaveDuringHolidayWeek !== false ? 'checked' : '' %> <%= canUpdateFlag ? '' : 'disabled' %>>
                  <label class="form-check-label" for="statutoryHolidayDisqualifyOnLeaveDuringHolidayWeek">Disqualify when approved leave overlaps the holiday week (Mon–Sun)</label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" id="statutoryHolidayDisqualifyOnLeaveBeforeAfter" name="statutoryHolidayDisqualifyOnLeaveBeforeAfter" value="true" <%= statutoryHolidayPayPolicy.disqualifyOnLeaveBeforeAfter !== false ? 'checked' : '' %> <%= canUpdateFlag ? '' : 'disabled' %>>
                  <label class="form-check-label" for="statutoryHolidayDisqualifyOnLeaveBeforeAfter">Disqualify when approved leave falls on the last or first adjacent payable workday</label>
                </div>
              </div>
            </div>
            <% if (canUpdateFlag) { %>
              <div class="d-flex justify-content-end mt-4">
                <button class="btn btn-primary" type="submit" id="btnSaveTimesheetParametersSettings">
                  <i class="bi bi-save me-1"></i>Save Timesheet Parameters
                </button>
              </div>
            <% } %>
          </form>
        </div>
      </section>
    </main>
  </div>
</div>

