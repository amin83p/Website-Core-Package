                                <i class="bi bi-envelope me-1"></i>Send test email
                              </button>
                            </div>
                          <% } %>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="border rounded" id="cardSessionNotificationSms">
                  <div class="d-flex align-items-center justify-content-between gap-2 p-3 border-bottom">
                    <button class="session-notification-section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#sessionNotificationSmsCollapse" aria-expanded="true" aria-controls="sessionNotificationSmsCollapse">
                      <i class="bi bi-chevron-down" aria-hidden="true"></i>
                      <i class="bi bi-phone text-primary" aria-hidden="true"></i>
                      <span>SMS notifications</span>
                    </button>
                    <div class="form-check form-switch mb-0">
                      <input class="form-check-input" type="checkbox" role="switch" id="sessionNotificationSmsEnabled" <%= canUpdateFlag ? '' : 'disabled' %>>
                      <label class="form-check-label visually-hidden" for="sessionNotificationSmsEnabled">Enable SMS notifications</label>
                    </div>
                  </div>
                  <div class="collapse show p-3" id="sessionNotificationSmsCollapse">
                    <div class="row g-3">
                      <div class="col-lg-6">
                        <label class="form-label fw-semibold">Send when</label>
                        <div class="form-check">
                          <input class="form-check-input" type="radio" name="sessionNotificationSmsSendWhen" id="sessionNotificationSmsSameDay" value="same_day" <%= canUpdateFlag ? '' : 'disabled' %>>
                          <label class="form-check-label" for="sessionNotificationSmsSameDay">Same day as session</label>
                        </div>
                        <div class="form-check">
                          <input class="form-check-input" type="radio" name="sessionNotificationSmsSendWhen" id="sessionNotificationSmsNextDay" value="next_day" <%= canUpdateFlag ? '' : 'disabled' %>>
                          <label class="form-check-label" for="sessionNotificationSmsNextDay">Day after session</label>
                        </div>
                      </div>
                      <div class="col-lg-6">
                        <label class="form-label fw-semibold" for="sessionNotificationSmsSendAtTime">Send at time</label>
                        <input class="form-control" type="time" id="sessionNotificationSmsSendAtTime" <%= canUpdateFlag ? '' : 'disabled' %>>
                        <div class="session-notification-digest-row mt-2" id="sessionNotificationSmsDigestRow">
