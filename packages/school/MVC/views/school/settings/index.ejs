                          <span class="d-flex align-items-center gap-2 flex-wrap" id="sessionNotificationSmsRangeGroup">
                            <input class="form-control form-control-sm session-notification-days-input d-none" type="number" min="1" max="365" step="1" id="sessionNotificationSmsDaysBefore" placeholder="Days" aria-label="Days before today" <%= canUpdateFlag ? '' : 'disabled' %>>
                            <select class="form-select form-select-sm" id="sessionNotificationSmsRangeType" aria-label="Sessions to include" <%= canUpdateFlag ? '' : 'disabled' %>>
                              <option value="this_week">This week</option>
                              <option value="two_weeks">These two weeks</option>
                              <option value="this_month">This month</option>
                              <option value="timesheet_period">Current timesheet period</option>
                              <option value="days_before_today">Days before today</option>
                            </select>
                          </span>
                          <label class="form-check-label mb-0" for="sessionNotificationSmsDailyAll">Daily digest summary</label>
                        </div>
                      </div>
                      <div class="col-12">
                        <label class="form-label" for="sessionNotificationSmsBody">Body template</label>
                        <textarea class="form-control" rows="2" maxlength="320" id="sessionNotificationSmsBody" <%= canUpdateFlag ? '' : 'disabled' %>></textarea>
                        <p class="small text-muted mt-1 mb-0">Keep messages short (320 characters). Daily digest SMS uses a summary with <code>{{sessionCount}}</code>; the full session list is email-only.</p>
                      </div>
                    </div>
                  </div>
                </div>

                <p class="small text-muted mt-3 mb-0">Placeholders: {{className}}, {{classId}}, {{sessionName}}, {{sessionId}}, {{sessionDate}}, {{sessionTime}}, {{teacherName}}, {{orgName}}, {{sessionManagerUrl}}, {{sessionCount}}, {{sessionList}}</p>
              </div>
            </div>

            <div class="rollup-feature-card" id="cardSessionAttendanceEdit">
              <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" role="switch" id="sessionAttendanceEditEnabled" <%= canUpdateFlag ? '' : 'disabled' %>>
