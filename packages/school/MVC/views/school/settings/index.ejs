<%
  const canUpdateFlag = typeof canUpdate !== 'undefined' && canUpdate === true;
  const conductLevelsJson = JSON.stringify(conductPolicy?.levels || []).replace(/</g, '\\u003c');
  const attendanceItemsJson = JSON.stringify(attendanceItems || []).replace(/</g, '\\u003c');
  const autosavePolicyJson = JSON.stringify(typeof autosavePolicy !== 'undefined' ? autosavePolicy : { defaultMinutes: 5, sections: {} }).replace(/</g, '\\u003c');
  const autosaveSectionsJson = JSON.stringify(typeof autosaveSections !== 'undefined' ? autosaveSections : []).replace(/</g, '\\u003c');
  const sessionAccessPolicyJson = JSON.stringify(typeof sessionAccessPolicy !== 'undefined' ? sessionAccessPolicy : {}).replace(/</g, '\\u003c');
  const studentAttendanceReportPolicyJson = JSON.stringify(typeof studentAttendanceReportPolicy !== 'undefined' ? studentAttendanceReportPolicy : { reportTemplateId: '', overallReportTemplateId: '', overallReportTemplateIds: [], templateExportFormats: { report: {}, overall: {} } }).replace(/</g, '\\u003c');
  const studentAttendanceReportTemplateCapabilitiesJson = JSON.stringify(typeof studentAttendanceReportTemplateCapabilities !== 'undefined' ? studentAttendanceReportTemplateCapabilities : { hasDocx: false, hasPdf: false }).replace(/</g, '\\u003c');
  const studentAttendanceReportOverallLabelsJson = JSON.stringify(typeof studentAttendanceReportOverallLabels !== 'undefined' ? studentAttendanceReportOverallLabels : []).replace(/</g, '\\u003c');
  const attendanceThresholdsEnabledFlag = typeof attendanceThresholdsEnabled === 'undefined'
    ? true
    : attendanceThresholdsEnabled !== false;
  const rollupFormulaJson = JSON.stringify(typeof rollupFormula !== 'undefined' ? rollupFormula : {}).replace(/</g, '\\u003c');
  const attendanceMarkAppearancePolicyJson = JSON.stringify(typeof attendanceMarkAppearancePolicy !== 'undefined' ? attendanceMarkAppearancePolicy : { marks: [] }).replace(/</g, '\\u003c');
  const attendanceMarkCuratedIconsJson = JSON.stringify(typeof attendanceMarkCuratedIcons !== 'undefined' ? attendanceMarkCuratedIcons : []).replace(/</g, '\\u003c');
%>

<style>
  .school-settings-page {
    --settings-sidebar-width: 278px;
    --settings-sidebar-collapsed-width: 76px;
  }
  .school-settings-workspace {
    display: grid;
    grid-template-columns: var(--settings-sidebar-width) minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    transition: grid-template-columns 160ms ease;
  }
  .school-settings-workspace.sidebar-collapsed {
    grid-template-columns: var(--settings-sidebar-collapsed-width) minmax(0, 1fr);
  }
  .attendance-timing-excuse-icon {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 1.35em;
    height: 1.35em;
    line-height: 1;
  }
  .attendance-timing-excuse-icon::before {
    content: "";
    position: absolute;
    inset: 0.02em;
    border: 3px solid #198754;
    border-radius: 50%;
    pointer-events: none;
  }
  .attendance-timing-excuse-left::before { clip-path: inset(0 50% 0 0); }
  .attendance-timing-excuse-right::before { clip-path: inset(0 0 0 50%); }
  .attendance-timing-excuse-full::before { clip-path: none; }
  .attendance-timing-excuse-icon > i { position: relative; z-index: 1; }
  .school-settings-sidebar {
    position: sticky;
    top: 1rem;
    overflow: hidden;
    border: 1px solid var(--bs-border-color);
    background: var(--bs-body-bg);
  }
  .school-settings-sidebar-header {
    min-height: 68px;
    border-bottom: 1px solid var(--bs-border-color);
  }
  .school-settings-sidebar-title,
  .school-settings-nav-label,
  .school-settings-org-details {
    transition: opacity 120ms ease;
  }
  .school-settings-org-details {
    min-width: 0;
  }
  .school-settings-nav {
    display: grid;
    gap: .35rem;
    padding: .75rem;
  }
  .school-settings-nav-item {
    display: flex;
    align-items: center;
    gap: .75rem;
    width: 100%;
    min-height: 48px;
    padding: .65rem .75rem;
    border: 0;
    border-radius: .65rem;
    color: var(--bs-body-color);
    background: transparent;
    text-align: left;
    text-decoration: none;
    transition: color 120ms ease, background-color 120ms ease, transform 120ms ease;
  }
  .school-settings-nav-item:hover,
  .school-settings-nav-item:focus-visible {
    color: var(--bs-primary);
    background: var(--bs-primary-bg-subtle);
  }
  .school-settings-nav-item.active {
    color: var(--bs-primary);
    background: var(--bs-primary-bg-subtle);
    font-weight: 700;
  }
  .school-settings-nav-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 32px;
    width: 32px;
    height: 32px;
    border-radius: .55rem;
    color: var(--bs-primary);
    background: var(--bs-primary-bg-subtle);
    font-size: 1rem;
  }
  .school-settings-sidebar-org {
    border-top: 1px solid var(--bs-border-color);
    padding: .85rem 1rem;
    background: var(--bs-tertiary-bg);
  }
  .school-settings-workspace.sidebar-collapsed .school-settings-sidebar-title,
  .school-settings-workspace.sidebar-collapsed .school-settings-nav-label,
  .school-settings-workspace.sidebar-collapsed .school-settings-org-details {
    display: none;
  }
  .school-settings-workspace.sidebar-collapsed .school-settings-sidebar-header {
    justify-content: center !important;
    padding-inline: .5rem !important;
  }
  .school-settings-workspace.sidebar-collapsed .school-settings-nav {
    padding-inline: .6rem;
  }
  .school-settings-workspace.sidebar-collapsed .school-settings-nav-item {
    justify-content: center;
    padding-inline: .35rem;
  }
  .school-settings-workspace.sidebar-collapsed .school-settings-sidebar-org {
    display: flex;
    justify-content: center;
    padding-inline: .5rem;
  }
  .school-settings-content {
    min-width: 0;
  }
  .school-settings-panel {
    display: none;
  }
  .school-settings-panel.active {
    display: block;
    animation: school-settings-panel-in 150ms ease-out;
  }
  .school-settings-panel-header {
    border-bottom: 1px solid var(--bs-border-color);
    background: var(--bs-body-bg);
  }
  @keyframes school-settings-panel-in {
    from { opacity: 0; transform: translateY(3px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .school-settings-table input:disabled {
    background-color: var(--bs-secondary-bg);
    opacity: 1;
  }
  .attendance-threshold-editor {
    transition: opacity 140ms ease;
  }
  .attendance-threshold-editor.is-disabled {
    opacity: .58;
  }
  .rollup-feature-card {
    border: 1px solid var(--bs-border-color);
    border-radius: 12px;
    padding: 1rem 1.15rem;
    background: var(--bs-body-bg);
  }
  .rollup-feature-card.is-disabled {
    opacity: 0.72;
  }
  .rollup-feature-options {
    border-top: 1px solid var(--bs-border-color-translucent);
    margin-top: 0.75rem;
    padding-top: 0.75rem;
  }
  .session-notification-section-toggle {
    border: 0;
    background: transparent;
    padding: 0;
    color: inherit;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
  }
  .session-notification-section-toggle .bi-chevron-down {
    transition: transform 0.2s ease;
  }
  .session-notification-section-toggle[aria-expanded="false"] .bi-chevron-down {
    transform: rotate(-90deg);
  }
  .session-notification-digest-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .session-notification-digest-row .form-select,
  .session-notification-digest-row .form-control {
    width: auto;
    min-width: 7rem;
  }
  .session-notification-digest-row .form-control.session-notification-days-input {
    width: 5.5rem;
    min-width: 5.5rem;
  }
  @media (max-width: 767.98px) {
    .school-settings-workspace,
    .school-settings-workspace.sidebar-collapsed {
      grid-template-columns: minmax(0, 1fr);
    }
    .school-settings-sidebar {
      position: static;
    }
    .school-settings-workspace.sidebar-collapsed .school-settings-sidebar-title {
      display: block;
    }
    .school-settings-workspace.sidebar-collapsed .school-settings-sidebar-header {
      justify-content: space-between !important;
      padding-inline: 1rem !important;
    }
    .school-settings-workspace.sidebar-collapsed .school-settings-nav,
    .school-settings-workspace.sidebar-collapsed .school-settings-sidebar-org {
      display: none;
    }
  }
</style>

<div class="sections-page school-settings-page">
  <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
    <div>
      <h1 class="page-heading size-md m-0 text-start" style="padding-left:0;">
        <i class="bi bi-gear-wide-connected me-2"></i>School Settings
      </h1>
      <p class="text-muted mb-0 mt-1">Organization-wide academic and operational policies managed from one place.</p>
    </div>
    <a href="<%= (typeof schoolSectionDashboardHref !== 'undefined' && schoolSectionDashboardHref) || '/dashboard/section-nav/SCHOOL' %>" class="school-navigator-dashboard btn btn-outline-secondary btn-sm">
      <i class="bi bi-speedometer2 me-1"></i>School Dashboard
    </a>
  </div>

  <% if (!canUpdateFlag) { %>
    <div class="alert alert-info border-0 shadow-sm" role="status">
      <i class="bi bi-eye me-2"></i>You have read-only access. School Settings update access is required to save changes.
    </div>
  <% } %>

  <div class="school-settings-workspace" id="schoolSettingsWorkspace">
    <aside class="school-settings-sidebar rounded-3 shadow-sm" id="schoolSettingsSidebar" aria-label="School settings">
      <div class="school-settings-sidebar-header d-flex align-items-center justify-content-between gap-2 px-3 py-2">
        <div class="school-settings-sidebar-title">
          <div class="fw-bold">Settings</div>
          <div class="small text-muted">Choose an area</div>
        </div>
        <button type="button" class="btn btn-sm btn-outline-secondary flex-shrink-0" id="btnToggleSettingsSidebar" aria-expanded="true" aria-controls="schoolSettingsNav" title="Collapse settings sidebar">
          <i class="bi bi-layout-sidebar-inset" id="settingsSidebarToggleIcon" aria-hidden="true"></i>
          <span class="visually-hidden" id="settingsSidebarToggleText">Collapse settings sidebar</span>
        </button>
      </div>
      <nav class="school-settings-nav" id="schoolSettingsNav" role="tablist" aria-orientation="vertical">
        <% (groups || []).forEach((group, index) => { %>
          <% if (group.href) { %>
          <a
            class="school-settings-nav-item"
            href="<%= group.href %>"
            title="<%= group.title %>"
          >
            <span class="school-settings-nav-icon"><i class="bi <%= group.icon %>" aria-hidden="true"></i></span>
            <span class="school-settings-nav-label"><%= group.title %></span>
          </a>
          <% } else { %>
          <a
            class="school-settings-nav-item <%= index === 0 ? 'active' : '' %>"
            href="#<%= group.key %>"
            role="tab"
            id="settings-tab-<%= group.key %>"
            data-settings-target="<%= group.key %>"
            aria-controls="<%= group.key %>"
            aria-selected="<%= index === 0 ? 'true' : 'false' %>"
            title="<%= group.title %>"
          >
            <span class="school-settings-nav-icon"><i class="bi <%= group.icon %>" aria-hidden="true"></i></span>
            <span class="school-settings-nav-label"><%= group.title %></span>
          </a>
          <% } %>
        <% }); %>
      </nav>
      <div class="school-settings-sidebar-org d-flex align-items-center gap-2">
        <i class="bi bi-building text-primary" aria-hidden="true"></i>
        <div class="school-settings-org-details min-w-0">
          <div class="small fw-semibold text-truncate" title="<%= activeOrgName %>"><%= activeOrgName %></div>
          <div class="small text-muted font-monospace text-truncate" title="<%= activeOrgId %>"><%= activeOrgId %></div>
        </div>
      </div>
    </aside>

    <main class="school-settings-content" id="schoolSettingsContent">
      <section class="school-settings-panel active card border-0 shadow-sm" id="conduct-rating-scale" role="tabpanel" aria-labelledby="settings-tab-conduct-rating-scale" tabindex="0">
        <header class="school-settings-panel-header card-header px-4 py-3">
          <div class="d-flex align-items-center gap-3">
            <span class="school-settings-nav-icon"><i class="bi bi-emoji-smile" aria-hidden="true"></i></span>
            <div>
              <h2 class="h5 fw-bold mb-1">Conduct Rating Scale</h2>
              <p class="small text-muted mb-0">Configure conduct labels, display codes, and percentage bands.</p>
            </div>
          </div>
        </header>
        <div class="card-body p-4">
          <p class="small text-muted">
            Configure the labels used for class conduct. Percentage ranges must cover 0–100 without gaps or overlaps,
            and each default percentage must remain inside its range. N/A remains a fixed non-percentage option.
          </p>
          <div class="alert alert-danger d-none js-settings-error" id="conductSettingsError" role="alert"></div>
          <form id="conductSettingsForm" novalidate>
            <input type="hidden" name="actionStateId" value="<%= actionStateId || '' %>">
            <div class="table-responsive">
              <table class="table table-sm align-middle school-settings-table">
                <thead class="table-light">
                  <tr>
                    <th>Code</th>
                    <th style="min-width:11rem;">Label</th>
                    <th>Display</th>
                    <th>Min %</th>
                    <th>Max %</th>
                    <th>Default %</th>
                  </tr>
                </thead>
                <tbody id="conductSettingsBody"></tbody>
              </table>
            </div>
            <% if (canUpdateFlag) { %>
              <div class="d-flex justify-content-end">
                <button class="btn btn-primary" type="submit" id="btnSaveConductSettings">
                  <i class="bi bi-save me-1"></i>Save Conduct Scale
                </button>
              </div>
            <% } %>
          </form>
        </div>
      </section>

      <section class="school-settings-panel card border-0 shadow-sm" id="attendance-matrix" role="tabpanel" aria-labelledby="settings-tab-attendance-matrix" tabindex="0" hidden>
        <header class="school-settings-panel-header card-header px-4 py-3">
          <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
              <span class="school-settings-nav-icon"><i class="bi bi-clock-history" aria-hidden="true"></i></span>
              <div>
                <h2 class="h5 fw-bold mb-1">Attendance Matrix Thresholds</h2>
                <p class="small text-muted mb-0">Configure duration-based late, early-leave, and combined thresholds.</p>
              </div>
            </div>
            <div class="form-check form-switch m-0">
              <input
                class="form-check-input"
                type="checkbox"
                role="switch"
                id="attendanceThresholdsEnabled"
                <%= attendanceThresholdsEnabledFlag ? 'checked' : '' %>
                <%= canUpdateFlag ? '' : 'disabled' %>
                aria-describedby="attendanceThresholdsEnabledHelp"
              >
              <label class="form-check-label fw-semibold" for="attendanceThresholdsEnabled">
                <span id="attendanceThresholdsEnabledLabel"><%= attendanceThresholdsEnabledFlag ? 'On' : 'Off' %></span>
              </label>
            </div>
          </div>
        </header>
        <div class="card-body p-4">
          <p class="small text-muted mb-3" id="attendanceThresholdsEnabledHelp">
            When Off, late and early-leaving students receive full attendance credit. They are recorded as Late, or Present when Late is unavailable for the class.
          </p>
          <p class="small text-muted mb-1">
            Create one threshold set per session duration. Exact duration matches are preferred; unmatched sessions use
            the selected default item and then the built-in 180 / 30 / 30 defaults.
          </p>
          <p class="small text-muted">When On, class-level attendance policy values continue to override these organization defaults.</p>
          <p class="small text-muted mb-3">
            Rollup % rules are configured separately in the
            <a href="#attendance-rollup">Attendance Rollup Formula</a> section.
          </p>
          <div class="alert alert-danger d-none js-settings-error" id="attendanceSettingsError" role="alert"></div>
          <form id="attendanceSettingsForm" novalidate>
            <input type="hidden" name="actionStateId" value="<%= actionStateId || '' %>">
            <div class="attendance-threshold-editor" id="attendanceThresholdEditor">
            <div class="d-flex justify-content-end mb-2">
              <% if (canUpdateFlag) { %>
                <button class="btn btn-outline-primary btn-sm" type="button" id="btnAddAttendanceDuration">
                  <i class="bi bi-plus-lg me-1"></i>Add Duration
                </button>
              <% } %>
            </div>
            <div class="table-responsive">
              <table class="table table-sm align-middle school-settings-table">
                <thead class="table-light">
                  <tr>
                    <th style="min-width:8rem;">Duration (min)</th>
                    <th style="min-width:8rem;">Late ≥</th>
                    <th style="min-width:8rem;">Early leave ≥</th>
                    <th style="min-width:13rem;">Combined late + early</th>
                    <th class="text-center">Default</th>
                    <% if (canUpdateFlag) { %><th aria-label="Actions"></th><% } %>
                  </tr>
                </thead>
                <tbody id="attendanceSettingsBody"></tbody>
              </table>
            </div>
            </div>
            <% if (canUpdateFlag) { %>
              <div class="d-flex justify-content-end">
                <button class="btn btn-primary" type="submit" id="btnSaveAttendanceSettings">
                  <i class="bi bi-save me-1"></i>Save Attendance Thresholds
                </button>
              </div>
            <% } %>
          </form>
        </div>
      </section>

      <section class="school-settings-panel card border-0 shadow-sm" id="attendance-marks" role="tabpanel" aria-labelledby="settings-tab-attendance-marks" tabindex="0" hidden>
        <header class="school-settings-panel-header card-header px-4 py-3">
          <div class="d-flex align-items-center gap-3">
            <span class="school-settings-nav-icon"><i class="bi bi-palette" aria-hidden="true"></i></span>
            <div>
              <h2 class="h5 fw-bold mb-1">Attendance Marks</h2>
              <p class="small text-muted mb-0">Configure labels, Bootstrap icons, and colors for the Attendance Matrix and Student Attendance Report.</p>
            </div>
          </div>
        </header>
        <div class="card-body p-4">
          <p class="small text-muted mb-3">
            Late and early-leave timing marks share the <span class="fw-semibold">late</span> color. The timing excuse ring color applies to half- and full-ring overlays on excused timing marks.
          </p>
          <div class="alert alert-danger d-none js-settings-error" id="attendanceMarksSettingsError" role="alert"></div>
          <form id="attendanceMarksSettingsForm" novalidate>
            <input type="hidden" name="actionStateId" value="<%= actionStateId || '' %>">
            <datalist id="attendanceMarkIconOptions">
              <% (attendanceMarkCuratedIcons || []).forEach((icon) => { %>
                <option value="<%= icon %>"></option>
              <% }); %>
            </datalist>
            <div class="table-responsive">
              <table class="table table-sm align-middle school-settings-table">
                <thead class="table-light">
                  <tr>
                    <th>Mark</th>
                    <th style="min-width:11rem;">Label</th>
                    <th style="min-width:9rem;">Icon</th>
                    <th style="min-width:8rem;">Color</th>
                    <th class="text-center" style="width:3rem;">Preview</th>
                  </tr>
                </thead>
                <tbody id="attendanceMarksSettingsBody"></tbody>
              </table>
            </div>
            <% if (canUpdateFlag) { %>
              <div class="d-flex justify-content-end">
                <button class="btn btn-primary" type="submit" id="btnSaveAttendanceMarksSettings">
                  <i class="bi bi-save me-1"></i>Save Attendance Marks
                </button>
              </div>
            <% } %>
          </form>
        </div>
      </section>

      <section class="school-settings-panel card border-0 shadow-sm" id="attendance-rollup" role="tabpanel" aria-labelledby="settings-tab-attendance-rollup" tabindex="0" hidden>
        <header class="school-settings-panel-header card-header px-4 py-3">
          <div class="d-flex align-items-center gap-3">
            <span class="school-settings-nav-icon"><i class="bi bi-percent" aria-hidden="true"></i></span>
            <div>
              <h2 class="h5 fw-bold mb-1">Attendance Rollup Formula</h2>
              <p class="small text-muted mb-0">Control how rollup % is calculated for the matrix, student report, Excel export, and print.</p>
            </div>
          </div>
        </header>
        <div class="card-body p-4">
          <p class="small text-muted mb-3">
            Turn each rule on or off. Disabled rules do not affect rollup %. Matrix thresholds above change saved roster status only.
            Session durations for grace minutes come from your Attendance Matrix Thresholds configuration.
          </p>
          <div class="alert alert-danger d-none js-settings-error" id="rollupSettingsError" role="alert"></div>
          <form id="rollupFormulaForm" novalidate>
            <input type="hidden" name="actionStateId" value="<%= actionStateId || '' %>">
            <div class="row g-3 mb-4">
              <div class="col-lg-6">
                <div class="rollup-feature-card" id="cardUnmarked">
                  <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" role="switch" id="includeUnmarkedSessions" <%= canUpdateFlag ? '' : 'disabled' %>>
                    <label class="form-check-label fw-semibold" for="includeUnmarkedSessions">Include unmarked sessions in rollup</label>
                  </div>
                  <p class="small text-muted mt-2 mb-0">When off, sessions with no attendance status are excluded from the rollup denominator.</p>
                  <div class="rollup-feature-options" id="unmarkedOptions">
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" id="countUnmarkedAsAbsent" <%= canUpdateFlag ? '' : 'disabled' %>>
                      <label class="form-check-label" for="countUnmarkedAsAbsent">Count unmarked sessions as absent (0% credit)</label>
                    </div>
                  </div>
                </div>
              </div>
              <div class="col-lg-6">
                <div class="rollup-feature-card" id="cardLateGrace">
                  <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" role="switch" id="includeLateGrace" <%= canUpdateFlag ? '' : 'disabled' %>>
                    <label class="form-check-label fw-semibold" for="includeLateGrace">Apply late arrival grace minutes</label>
                  </div>
                  <p class="small text-muted mt-2 mb-0">When on, late minutes up to the grace value per duration do not reduce rollup credit.</p>
                </div>
              </div>
              <div class="col-lg-6">
                <div class="rollup-feature-card" id="cardEarlyGrace">
                  <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" role="switch" id="includeEarlyGrace" <%= canUpdateFlag ? '' : 'disabled' %>>
                    <label class="form-check-label fw-semibold" for="includeEarlyGrace">Apply early leave grace minutes</label>
                  </div>
                  <p class="small text-muted mt-2 mb-0">When on, early-leave minutes up to the grace value per duration do not reduce rollup credit.</p>
                </div>
              </div>
              <div class="col-lg-6">
                <div class="rollup-feature-card" id="cardLateExcused">
                  <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" role="switch" id="includeLateExcusedRule" <%= canUpdateFlag ? '' : 'disabled' %>>
                    <label class="form-check-label fw-semibold" for="includeLateExcusedRule">Apply late excused rules in rollup</label>
                  </div>
                  <p class="small text-muted mt-2 mb-0">When off, the late excused flag is ignored for rollup math (minutes still apply).</p>
                  <div class="rollup-feature-options" id="lateExcusedOptions">
                    <label class="form-label small fw-semibold" for="lateExcusedTreatment">When late is excused</label>
                    <select class="form-select form-select-sm" id="lateExcusedTreatment" <%= canUpdateFlag ? '' : 'disabled' %>>
                      <option value="reduce_credit">Reduce credit by minutes</option>
                      <option value="waive_penalty">Waive penalty minutes</option>
                      <option value="count_as_absent">Count as absent (0% credit)</option>
                    </select>
                  </div>
                </div>
              </div>
              <div class="col-lg-6">
                <div class="rollup-feature-card" id="cardEarlyExcused">
                  <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" role="switch" id="includeEarlyExcusedRule" <%= canUpdateFlag ? '' : 'disabled' %>>
                    <label class="form-check-label fw-semibold" for="includeEarlyExcusedRule">Apply early leave excused rules in rollup</label>
                  </div>
                  <p class="small text-muted mt-2 mb-0">When off, the early leave excused flag is ignored for rollup math (minutes still apply).</p>
                  <div class="rollup-feature-options" id="earlyExcusedOptions">
                    <label class="form-label small fw-semibold" for="earlyExcusedTreatment">When early leave is excused</label>
                    <select class="form-select form-select-sm" id="earlyExcusedTreatment" <%= canUpdateFlag ? '' : 'disabled' %>>
                      <option value="reduce_credit">Reduce credit by minutes</option>
                      <option value="waive_penalty">Waive penalty minutes</option>
                      <option value="count_as_absent">Count as absent (0% credit)</option>
                    </select>
                  </div>
                </div>
              </div>
            </div>
            <h3 class="h6 fw-bold mb-2">Grace minutes by session duration</h3>
            <p class="small text-muted mb-3">Grace values apply only when the corresponding grace rule above is enabled.</p>
