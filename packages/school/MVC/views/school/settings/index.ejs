            <% if (canUpdateFlag) { %>
              <div class="d-flex justify-content-end mt-4">
                <button class="btn btn-primary" type="submit" id="btnSaveSessionAccessSettings">
                  <i class="bi bi-save me-1"></i>Save Session Access Settings
