  function resolveChannelSendWhen(channelPrefix) {
    const selected = document.querySelector(`input[name="sessionNotification${channelPrefix}SendWhen"]:checked`);
    const value = String(selected?.value || 'same_day').trim();
    if (value === 'next_day' || value === 'daily_all') return value;
    return 'same_day';
  }

  function collectChannelSessionDateRange(channelPrefix) {
    const type = document.getElementById(`sessionNotification${channelPrefix}RangeType`)?.value || 'this_week';
    const daysBeforeToday = document.getElementById(`sessionNotification${channelPrefix}DaysBefore`)?.value || '';
    return {
      type,
      daysBeforeToday: type === 'days_before_today' ? daysBeforeToday : null
    };
  }

  function readSessionNotificationEmailWrapperMappings() {
    const field = document.getElementById('sessionNotificationEmailWrapperMappings');
    const raw = String(field?.value || '[]').trim();
    try {
      const parsed = JSON.parse(raw);
      return Array.isArray(parsed) ? parsed : [];
    } catch (_) {
      return [];
    }
  }

  function writeSessionNotificationEmailWrapperMappings(mappings = []) {
    const field = document.getElementById('sessionNotificationEmailWrapperMappings');
    if (!field) return;
    const list = Array.isArray(mappings) ? mappings : [];
    field.value = JSON.stringify(list);
    field.dispatchEvent(new Event('input', { bubbles: true }));
    field.dispatchEvent(new Event('change', { bubbles: true }));
  }

  const COMPLETED_SESSION_EDIT_CONFIGS = [
    { idPrefix: 'sessionAttendanceEdit', policyKey: 'completedSessionAttendanceEdit', label: 'attendance' },
    { idPrefix: 'sessionNotesEdit', policyKey: 'completedSessionNotesEdit', label: 'Session Notes' },
    { idPrefix: 'sessionGradebookEdit', policyKey: 'completedSessionGradebookEdit', label: 'Grade book/Activities' },
    { idPrefix: 'sessionConductEdit', policyKey: 'completedSessionConductEdit', label: 'Class Conduct Before Reports' },
    { idPrefix: 'sessionCurriculumEdit', policyKey: 'completedSessionCurriculumEdit', label: 'Curriculum' },
    { idPrefix: 'sessionStudentCasesEdit', policyKey: 'completedSessionStudentCasesEdit', label: 'Student Cases' }
  ];

  function collectCompletedSessionEditPolicy(idPrefix) {
    return {
      enabled: document.getElementById(`${idPrefix}Enabled`)?.checked === true,
      windowType: document.getElementById(`${idPrefix}WindowType`)?.value || 'timesheet_period',
      daysAfterSession: document.getElementById(`${idPrefix}DaysAfter`)?.value || ''
    };
  }

  function collectSessionAccessPolicy() {
    const completedSessionEditPolicies = COMPLETED_SESSION_EDIT_CONFIGS.reduce((acc, config) => {
      acc[config.policyKey] = collectCompletedSessionEditPolicy(config.idPrefix);
      return acc;
    }, {});
    return {
      uncompletedSessionNotification: {
        enabled: document.getElementById('sessionNotificationEnabled')?.checked === true,
        channels: {
          email: {
            enabled: document.getElementById('sessionNotificationEmailEnabled')?.checked === true,
            sendWhen: resolveChannelSendWhen('Email'),
            prepareAtTime: String(document.getElementById('sessionNotificationEmailPrepareAtTime')?.value || '17:00').slice(0, 5),
            sendAtTime: String(document.getElementById('sessionNotificationEmailSendAtTime')?.value || '18:00').slice(0, 5),
            sessionDateRange: collectChannelSessionDateRange('Email'),
            emailTemplateId: document.getElementById('sessionNotificationEmailTemplateId')?.value || '',
            bodyTemplate: document.getElementById('sessionNotificationEmailBody')?.value || '',
            wrapperPlaceholderMappings: readSessionNotificationEmailWrapperMappings()
          },
          sms: {
            enabled: document.getElementById('sessionNotificationSmsEnabled')?.checked === true,
            sendWhen: resolveChannelSendWhen('Sms'),
            prepareAtTime: String(document.getElementById('sessionNotificationSmsPrepareAtTime')?.value || '17:00').slice(0, 5),
            sendAtTime: String(document.getElementById('sessionNotificationSmsSendAtTime')?.value || '18:00').slice(0, 5),
            sessionDateRange: collectChannelSessionDateRange('Sms'),
            bodyTemplate: document.getElementById('sessionNotificationSmsBody')?.value || ''
          }
        }
      },
      ...completedSessionEditPolicies
    };
  }

  function timeHmToMinutes(value = '') {
    const token = String(value || '').slice(0, 5);
    const match = /^(\d{2}):(\d{2})$/.exec(token);
    if (!match) return 0;
    return (Number(match[1]) * 60) + Number(match[2]);
  }

  const MIN_PREPARE_SEND_GAP_MINUTES = 10;

  function computePrepareSendGapMinutes(prepareAtTime = '', sendAtTime = '') {
    const prep = timeHmToMinutes(prepareAtTime || '17:00');
    const send = timeHmToMinutes(sendAtTime || '18:00');
    return send > prep ? (send - prep) : ((24 * 60) - prep) + send;
  }

  function isChannelScheduleGapValid(channelPrefix) {
    const enabled = document.getElementById(`sessionNotification${channelPrefix}Enabled`)?.checked === true;
    const notificationOn = document.getElementById('sessionNotificationEnabled')?.checked === true;
    if (!notificationOn || !enabled) return true;
    const prepare = document.getElementById(`sessionNotification${channelPrefix}PrepareAtTime`)?.value || '17:00';
    const send = document.getElementById(`sessionNotification${channelPrefix}SendAtTime`)?.value || '18:00';
    return computePrepareSendGapMinutes(prepare, send) >= MIN_PREPARE_SEND_GAP_MINUTES;
  }

  function refreshChannelScheduleWarning(channelPrefix) {
    const warning = document.getElementById(`sessionNotification${channelPrefix}ScheduleWarning`);
    const saveButton = document.getElementById('btnSaveSessionAccessSettings');
    const valid = isChannelScheduleGapValid(channelPrefix);
    if (warning) warning.classList.toggle('d-none', valid);
    return valid;
  }

  function isSessionAccessScheduleValid() {
    const emailValid = refreshChannelScheduleWarning('Email');
    const smsValid = refreshChannelScheduleWarning('Sms');
    const saveButton = document.getElementById('btnSaveSessionAccessSettings');
    const allValid = emailValid && smsValid;
    if (saveButton && canUpdate) saveButton.disabled = !allValid;
    return allValid;
  }

  function refreshChannelNotificationPanels(channelPrefix) {
    const sendWhen = resolveChannelSendWhen(channelPrefix);
    const isDigest = sendWhen === 'daily_all';
    const rangeGroup = document.getElementById(`sessionNotification${channelPrefix}RangeGroup`);
    const rangeType = document.getElementById(`sessionNotification${channelPrefix}RangeType`)?.value || 'this_week';
    const daysField = document.getElementById(`sessionNotification${channelPrefix}DaysBefore`);
    const rangeSelect = document.getElementById(`sessionNotification${channelPrefix}RangeType`);
    if (rangeGroup) rangeGroup.classList.toggle('d-none', !isDigest);
    if (daysField) {
      const showDays = isDigest && rangeType === 'days_before_today';
      daysField.classList.toggle('d-none', !showDays);
      daysField.disabled = !canUpdate || !showDays;
    }
    if (rangeSelect) {
      rangeSelect.disabled = !canUpdate || !isDigest;
    }
  }

  function refreshSessionAccessPanels() {
    const notificationOn = document.getElementById('sessionNotificationEnabled')?.checked === true;
    document.getElementById('cardSessionNotification')?.classList.toggle('is-disabled', !notificationOn);
    refreshChannelNotificationPanels('Email');
    refreshChannelNotificationPanels('Sms');
    isSessionAccessScheduleValid();

    const today = new Date();
    const yyyy = today.getFullYear();
    const mm = String(today.getMonth() + 1).padStart(2, '0');
    const dd = String(today.getDate()).padStart(2, '0');
    const sampleDate = `${yyyy}-${mm}-${dd}`;
    COMPLETED_SESSION_EDIT_CONFIGS.forEach((config) => {
      const editEnabled = document.getElementById(`${config.idPrefix}Enabled`)?.checked === true;
      document.getElementById(`card${config.idPrefix.charAt(0).toUpperCase()}${config.idPrefix.slice(1)}`)?.classList.toggle('is-disabled', !editEnabled);
      document.getElementById(`${config.idPrefix}DisabledHelp`)?.classList.toggle('d-none', editEnabled);
      document.getElementById(`${config.idPrefix}Options`)?.classList.toggle('d-none', !editEnabled);
      const windowType = document.getElementById(`${config.idPrefix}WindowType`)?.value || 'timesheet_period';
      const daysField = document.getElementById(`${config.idPrefix}DaysAfter`);
      if (daysField) {
        daysField.disabled = !canUpdate || windowType !== 'days_after_session';
      }
      const preview = document.getElementById(`${config.idPrefix}Preview`);
      if (!preview) return;
      let message = '';
      if (!editEnabled) {
        message = `Example: a completed session ${config.label} section would remain editable through the next calendar day after completion (${sampleDate}).`;
      } else if (windowType === 'days_after_session') {
        const days = Number(document.getElementById(`${config.idPrefix}DaysAfter`)?.value || 1);
        message = `Example: a completed session ${config.label} section would remain editable for ${days} day(s) after the session date.`;
      } else if (windowType === 'end_of_week') {
        message = `Example: a completed session ${config.label} section would remain editable through the end of that week.`;
      } else if (windowType === 'end_of_month') {
        message = `Example: a completed session ${config.label} section would remain editable through the end of that month.`;
      } else {
        message = `Example: a completed session ${config.label} section would remain editable through the end of its timesheet period.`;
      }
      preview.textContent = message;
    });
  }

  function setChannelSendWhen(channelPrefix, sendWhen) {
    const value = sendWhen || 'same_day';
    document.getElementById(`sessionNotification${channelPrefix}SameDay`).checked = value === 'same_day';
    document.getElementById(`sessionNotification${channelPrefix}NextDay`).checked = value === 'next_day';
    document.getElementById(`sessionNotification${channelPrefix}DailyAll`).checked = value === 'daily_all';
  }

  function renderChannelSessionDateRange(channelPrefix, sessionDateRange = {}) {
    const range = sessionDateRange && typeof sessionDateRange === 'object' ? sessionDateRange : {};
    const rangeTypeEl = document.getElementById(`sessionNotification${channelPrefix}RangeType`);
    if (rangeTypeEl) rangeTypeEl.value = range.type || 'this_week';
    const daysEl = document.getElementById(`sessionNotification${channelPrefix}DaysBefore`);
    if (daysEl) daysEl.value = range.daysBeforeToday || '';
  }

  function renderSessionAccessSettings() {
    const notification = sessionAccessPolicy?.uncompletedSessionNotification || {};
    const channels = notification.channels || {};
    const email = channels.email || {};
    const sms = channels.sms || {};
    const completedSessionEditPolicies = COMPLETED_SESSION_EDIT_CONFIGS.reduce((acc, config) => {
      acc[config.policyKey] = sessionAccessPolicy?.[config.policyKey] || {};
      return acc;
    }, {});
    const legacySendWhen = notification.sendWhen;
    const legacySendAtTime = notification.sendAtTime;

    const notificationEnabled = document.getElementById('sessionNotificationEnabled');
    if (notificationEnabled) notificationEnabled.checked = notification.enabled === true;

    document.getElementById('sessionNotificationEmailEnabled').checked = email.enabled !== false;
    setChannelSendWhen('Email', email.sendWhen || legacySendWhen || 'daily_all');
    document.getElementById('sessionNotificationEmailPrepareAtTime').value = String(
      email.prepareAtTime || email.sendAtTime || legacySendAtTime || '17:00'
    ).slice(0, 5);
    document.getElementById('sessionNotificationEmailSendAtTime').value = String(email.sendAtTime || legacySendAtTime || '18:00').slice(0, 5);
    renderChannelSessionDateRange('Email', email.sessionDateRange);
    const templateId = String(email.emailTemplateId || '').trim();
    const templateName = String(email.emailTemplateLabel || email.emailTemplateName || '').trim();
    document.getElementById('sessionNotificationEmailTemplateId').value = templateId;
    document.getElementById('sessionNotificationEmailTemplateName').value = templateName || templateId;
    document.getElementById('sessionNotificationEmailBody').value = email.bodyTemplate || '';
    writeSessionNotificationEmailWrapperMappings(email.wrapperPlaceholderMappings || []);
    refreshSessionNotificationEmailBodySummary();

    document.getElementById('sessionNotificationSmsEnabled').checked = sms.enabled === true;
    setChannelSendWhen('Sms', sms.sendWhen || legacySendWhen || 'same_day');
    document.getElementById('sessionNotificationSmsPrepareAtTime').value = String(
      sms.prepareAtTime || sms.sendAtTime || legacySendAtTime || '17:00'
    ).slice(0, 5);
    document.getElementById('sessionNotificationSmsSendAtTime').value = String(sms.sendAtTime || legacySendAtTime || '18:00').slice(0, 5);
    renderChannelSessionDateRange('Sms', sms.sessionDateRange);
    document.getElementById('sessionNotificationSmsBody').value = sms.bodyTemplate || '';

    COMPLETED_SESSION_EDIT_CONFIGS.forEach((config) => {
      const edit = completedSessionEditPolicies[config.policyKey] || {};
      const enabledEl = document.getElementById(`${config.idPrefix}Enabled`);
      const windowTypeEl = document.getElementById(`${config.idPrefix}WindowType`);
      const daysAfterEl = document.getElementById(`${config.idPrefix}DaysAfter`);
      if (enabledEl) enabledEl.checked = edit.enabled !== false;
      if (windowTypeEl) windowTypeEl.value = edit.windowType || 'timesheet_period';
      if (daysAfterEl) daysAfterEl.value = edit.daysAfterSession || '';
    });
    refreshSessionNotificationEmailTemplateWarning(
      email.emailTemplateBodyContentWarning
      || (email.emailTemplateMissingBodyContentSlot
        ? 'The selected email template does not include {{BODY_CONTENT}}. Add that placeholder to the template body in Email Management so school message content can appear inside the template wrapper.'
        : '')
    );
    refreshSessionAccessPanels();
  }

  function refreshSessionNotificationEmailTemplateWarning(message = '') {
    const warningNode = document.getElementById('sessionNotificationEmailTemplateBodyContentWarning');
    if (!warningNode) return;
    const text = String(message || '').trim();
    warningNode.textContent = text;
    warningNode.classList.toggle('d-none', !text);
  }

  async function checkSessionNotificationEmailTemplateSlot(templateId = '') {
    const normalizedTemplateId = String(templateId || '').trim();
    if (!normalizedTemplateId) {
      refreshSessionNotificationEmailTemplateWarning('');
      return;
    }
    try {
      const response = await fetch(`/school/settings/session-access/email-template-check?templateId=${encodeURIComponent(normalizedTemplateId)}`, {
        headers: { Accept: 'application/json', 'X-AJAX-Request': 'true' }
      });
      const result = await response.json().catch(() => null);
      if (!response.ok || !result || result.status !== 'success') return;
      refreshSessionNotificationEmailTemplateWarning(result.warning || '');
    } catch (_) {
      // Non-blocking guidance only.
    }
  }

  function normalizeSessionNotificationEmailBody(value = '') {
    return String(value || '').replace(/\s+/g, ' ').trim();
  }

  function refreshSessionNotificationEmailBodySummary() {
    const bodyField = document.getElementById('sessionNotificationEmailBody');
    const summaryNode = document.getElementById('sessionNotificationEmailBodySummary');
    if (!summaryNode) return;
    const value = String(bodyField?.value || '');
    const normalized = normalizeSessionNotificationEmailBody(value);
    const defaultNormalized = normalizeSessionNotificationEmailBody(sessionNotificationEmailDefaultBody);
    let text = 'Empty message';
    if (normalized) {
      text = normalized === defaultNormalized
        ? 'Using default message'
        : `Custom message (${value.length} chars)`;
    }
    summaryNode.textContent = text;
  }

  function openSessionNotificationEmailBodyRichEditor() {
    const bodyField = document.getElementById('sessionNotificationEmailBody');
    if (!bodyField || bodyField.disabled) return;
    if (!window.SessionNotificationEmailBodyModal || typeof window.SessionNotificationEmailBodyModal.open !== 'function') {
      showSettingsMessage({
        title: 'Rich Editor Unavailable',
        message: 'The notification body editor is not available on this page. Refresh and try again.',
        icon: 'warning',
        buttonClass: 'btn-warning'
      });
      return;
    }
    window.SessionNotificationEmailBodyModal.init({
      canUpdate,
      contextSources: sessionNotificationEmailContextSources
    });
    window.SessionNotificationEmailBodyModal.open({
      bodyValue: bodyField.value || '',
      customMappings: readSessionNotificationEmailWrapperMappings(),
      onSave: ({ bodyTemplate, wrapperPlaceholderMappings }) => {
        bodyField.value = String(bodyTemplate || '');
        writeSessionNotificationEmailWrapperMappings(wrapperPlaceholderMappings || []);
        refreshSessionNotificationEmailBodySummary();
      }
    });
  }

  [
    'sessionNotificationEnabled',
    'sessionNotificationEmailEnabled',
    'sessionNotificationSmsEnabled',
    'sessionNotificationEmailPrepareAtTime',
    'sessionNotificationEmailSendAtTime',
    'sessionNotificationSmsPrepareAtTime',
    'sessionNotificationSmsSendAtTime',
    'sessionNotificationEmailRangeType',
    'sessionNotificationSmsRangeType',
    'sessionNotificationEmailDaysBefore',
    'sessionNotificationSmsDaysBefore',
    'sessionAttendanceEditEnabled',
    'sessionAttendanceEditWindowType',
    'sessionAttendanceEditDaysAfter',
    'sessionNotesEditEnabled',
    'sessionNotesEditWindowType',
    'sessionNotesEditDaysAfter',
    'sessionGradebookEditEnabled',
    'sessionGradebookEditWindowType',
    'sessionGradebookEditDaysAfter',
    'sessionConductEditEnabled',
    'sessionConductEditWindowType',
    'sessionConductEditDaysAfter',
    'sessionCurriculumEditEnabled',
    'sessionCurriculumEditWindowType',
    'sessionCurriculumEditDaysAfter',
    'sessionStudentCasesEditEnabled',
    'sessionStudentCasesEditWindowType',
    'sessionStudentCasesEditDaysAfter'
  ].forEach((id) => {
    document.getElementById(id)?.addEventListener('change', refreshSessionAccessPanels);
    document.getElementById(id)?.addEventListener('input', refreshSessionAccessPanels);
  });
  document.querySelectorAll('input[name="sessionNotificationEmailSendWhen"], input[name="sessionNotificationSmsSendWhen"]').forEach((input) => {
    input.addEventListener('change', refreshSessionAccessPanels);
  });

  document.getElementById('sessionAccessSettingsForm')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = document.getElementById('btnSaveSessionAccessSettings');
    if (!button) return;
    if (!isSessionAccessScheduleValid()) {
      await showSettingsMessage({
        title: 'Invalid notification schedule',
        message: 'Prepare and Send must be at least 10 minutes apart for each enabled channel (send may be earlier on the clock if it is the next morning).',
        icon: 'warning',
        buttonClass: 'btn-warning'
      });
      return;
    }
    const policyPayload = collectSessionAccessPolicy();
    const result = await postSettings('/school/settings/session-access', {
      actionStateId: event.currentTarget.elements.actionStateId?.value || '',
      policy: JSON.stringify(policyPayload)
    }, button, 'sessionAccessSettingsError', { disableButton: false });
    if (!result) return;
    sessionAccessPolicy = result.policy && typeof result.policy === 'object' ? result.policy : sessionAccessPolicy;
    renderSessionAccessSettings();
    await showSettingsMessage({ title: 'Settings Saved', message: result.message, icon: 'success' });
  });

  function clearSessionNotificationEmailTemplate() {
    const templateId = document.getElementById('sessionNotificationEmailTemplateId');
    const templateName = document.getElementById('sessionNotificationEmailTemplateName');
    if (templateId) templateId.value = '';
    if (templateName) templateName.value = '';
    refreshSessionNotificationEmailTemplateWarning('');
  }

  function openSessionNotificationEmailTemplatePicker() {
    if (!window.GenericPicker || !window.GenericPickerPresets) {
      showSettingsMessage({
        title: 'Email Template Picker Unavailable',
        message: 'The email template picker is not available on this page. Refresh and try again.',
        icon: 'warning',
        buttonClass: 'btn-warning'
      });
      return;
    }
    GenericPicker.open(GenericPickerPresets.normalizeConfig({
      ...GenericPickerPresets.emailTemplate({
        title: 'Select Email Template',
        apiEndpoint: '/email-management/api/templates?isActive__eq=true&templateKind__eq=general'
      }),
      multiselect: false,
      onSelect: (selected) => {
        const item = Array.isArray(selected) ? selected[0] : selected;
        if (!item) return;
        const templateId = String(item.id || '').trim();
        const label = String(item.label || item.name || templateId).trim();
        const templateIdInput = document.getElementById('sessionNotificationEmailTemplateId');
        const templateNameInput = document.getElementById('sessionNotificationEmailTemplateName');
        if (templateIdInput) templateIdInput.value = templateId;
        if (templateNameInput) templateNameInput.value = label;
        checkSessionNotificationEmailTemplateSlot(templateId);
      }
    }));
  }

  document.getElementById('sessionNotificationEmailTemplatePickBtn')?.addEventListener('click', openSessionNotificationEmailTemplatePicker);
  document.getElementById('sessionNotificationEmailTemplateClearBtn')?.addEventListener('click', clearSessionNotificationEmailTemplate);
  document.getElementById('sessionNotificationEmailBodyEditBtn')?.addEventListener('click', openSessionNotificationEmailBodyRichEditor);
  document.getElementById('sessionNotificationEmailBodyModal')?.addEventListener('hidden.bs.modal', refreshSessionNotificationEmailBodySummary);

  function clearSessionNotificationTestTeacher() {
    const teacherId = document.getElementById('sessionNotificationTestTeacherId');
    const teacherName = document.getElementById('sessionNotificationTestTeacherName');
    if (teacherId) teacherId.value = '';
    if (teacherName) teacherName.value = '';
  }

  function openSessionNotificationTestTeacherPicker() {
    if (!window.GenericPicker || !window.GenericPickerPresets) {
      showSettingsMessage({
        title: 'Teacher Picker Unavailable',
        message: 'The teacher picker is not available on this page. Refresh and try again.',
        icon: 'warning',
        buttonClass: 'btn-warning'
      });
      return;
    }
    const context = (window.GenericPickerContexts && typeof window.GenericPickerContexts.activeOrganizationScope === 'function')
      ? window.GenericPickerContexts.activeOrganizationScope({ label: 'Active Organization' })
      : undefined;
    GenericPicker.open(GenericPickerPresets.normalizeConfig({
      ...GenericPickerPresets.person({
        title: 'Select Teacher',
        apiEndpoint: '/school/identity/api/persons?allowedSchoolRoles=teacher',
        searchFields: 'id,firstName,lastName,name.first,name.last,teacherCode,email,personId',
        context
      }),
      multiselect: false,
      onSelect: (selected) => {
        const item = Array.isArray(selected) ? selected[0] : selected;
        if (!item) return;
        const teacherId = String(item.personId || item.id || '').trim();
        const label = String(item.label || item.name || item.displayName || teacherId).trim();
        const teacherIdInput = document.getElementById('sessionNotificationTestTeacherId');
        const teacherNameInput = document.getElementById('sessionNotificationTestTeacherName');
        if (teacherIdInput) teacherIdInput.value = teacherId;
        if (teacherNameInput) teacherNameInput.value = label;
      }
    }));
  }

  async function sendSessionNotificationTestEmail() {
    const teacherId = String(document.getElementById('sessionNotificationTestTeacherId')?.value || '').trim();
    if (!teacherId) {
      setPanelError('sessionAccessSettingsError', 'Select a teacher before sending a test email.');
      await showSettingsMessage({
        title: 'Test Email Not Sent',
        message: 'Select a teacher before sending a test email.',
        icon: 'warning',
        buttonClass: 'btn-warning'
      });
      return;
    }
    setPanelError('sessionAccessSettingsError');
    const actionStateId = document.querySelector('#sessionAccessSettingsForm input[name="actionStateId"]')?.value || '';
    const modalEl = document.getElementById('sessionNotificationTestEmailModal');
    const modalError = document.getElementById('sessionNotificationTestEmailModalError');
    const sampleNotice = document.getElementById('sessionNotificationTestEmailSampleNotice');
    const warningsNode = document.getElementById('sessionNotificationTestEmailWarnings');
    const previewFrame = document.getElementById('sessionNotificationTestEmailPreviewFrame');
    const plainPreview = document.getElementById('sessionNotificationTestEmailPlainPreview');
    const previewMeta = document.getElementById('sessionNotificationTestEmailPreviewMeta');
    if (modalError) {
      modalError.textContent = '';
      modalError.classList.add('d-none');
    }
    try {
      const response = await fetch('/school/settings/session-access/test-notification/preview', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded',
          Accept: 'application/json',
          'X-AJAX-Request': 'true'
        },
        body: new URLSearchParams({
          actionStateId,
          teacherId,
          policy: JSON.stringify(collectSessionAccessPolicy())
        }).toString()
      });
      const result = await response.json().catch(() => null);
      if (!response.ok || !result || result.status !== 'success') {
        throw new Error(result?.message || 'Unable to preview test email.');
      }

      sessionNotificationTestEmailState.teacherId = teacherId;
      sessionNotificationTestEmailState.actionStateId = actionStateId;
      sessionNotificationTestEmailState.policyJson = JSON.stringify(collectSessionAccessPolicy());

      const toField = document.getElementById('sessionNotificationTestEmailPreviewTo');
      const subjectField = document.getElementById('sessionNotificationTestEmailPreviewSubject');
      if (toField) toField.value = String(result.recipient || '');
      if (subjectField) subjectField.value = String(result.subject || '');

      if (sampleNotice) {
        const sampleText = result.usedSampleData === true ? String(result.message || '').trim() : '';
        sampleNotice.textContent = sampleText;
        sampleNotice.classList.toggle('d-none', !sampleText);
      }

      const warningLines = Array.isArray(result.warnings)
        ? result.warnings.map((row) => String(row || '').trim()).filter(Boolean)
        : [];
      if (warningsNode) {
        warningsNode.textContent = warningLines.join(' ');
        warningsNode.classList.toggle('d-none', !warningLines.length);
      }

      if (previewMeta) {
        previewMeta.textContent = `Sessions included: ${result.sessionCount || 0}`;
      }

      const previewHtml = String(result?.preview?.html || '').trim();
      const previewText = String(result?.preview?.text || '').trim();
      if (previewFrame) {
        previewFrame.srcdoc = previewHtml || '';
        previewFrame.classList.toggle('d-none', !previewHtml);
      }
      if (plainPreview) {
        plainPreview.textContent = previewHtml ? '' : previewText;
        plainPreview.classList.toggle('d-none', Boolean(previewHtml));
      }

      if (modalEl && window.bootstrap?.Modal) {
        window.bootstrap.Modal.getOrCreateInstance(modalEl).show();
      }
    } catch (error) {
      const message = error?.message || 'Unable to preview test email.';
      setPanelError('sessionAccessSettingsError', message);
      await showSettingsMessage({
        title: 'Test Email Not Sent',
        message,
        icon: 'error',
        buttonClass: 'btn-danger'
      });
    }
  }

  const sessionNotificationTestEmailState = {
    teacherId: '',
    actionStateId: '',
    policyJson: ''
  };

  function setSessionNotificationTestEmailSending(isSending) {
    const button = document.getElementById('btnConfirmSessionNotificationTestEmail');
    if (!button) return;
    button.disabled = isSending;
    button.querySelector('.js-session-notification-test-email-send-label')?.classList.toggle('d-none', isSending);
    button.querySelector('.js-session-notification-test-email-send-spinner')?.classList.toggle('d-none', !isSending);
  }

  async function confirmSessionNotificationTestEmailSend() {
    const teacherId = String(sessionNotificationTestEmailState.teacherId || '').trim();
    if (!teacherId) return;
    const modalEl = document.getElementById('sessionNotificationTestEmailModal');
    const modalError = document.getElementById('sessionNotificationTestEmailModalError');
    if (modalError) {
      modalError.textContent = '';
      modalError.classList.add('d-none');
    }
    setSessionNotificationTestEmailSending(true);
    try {
      const response = await fetch('/school/settings/session-access/test-notification', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded',
          Accept: 'application/json',
          'X-AJAX-Request': 'true'
        },
        body: new URLSearchParams({
          actionStateId: sessionNotificationTestEmailState.actionStateId || '',
          teacherId,
          policy: sessionNotificationTestEmailState.policyJson || JSON.stringify(collectSessionAccessPolicy())
        }).toString()
      });
      const result = await response.json().catch(() => null);
      if (!response.ok || !result || result.status !== 'success') {
        throw new Error(result?.message || 'Unable to send test email.');
      }
      if (modalEl && window.bootstrap?.Modal) {
        window.bootstrap.Modal.getOrCreateInstance(modalEl).hide();
      }
      await showSettingsMessage({
        title: 'Test Email Sent',
        message: String(result.message || 'Test email sent successfully.'),
        icon: 'success'
      });
    } catch (error) {
      const message = error?.message || 'Unable to send test email.';
      if (modalError) {
        modalError.textContent = message;
        modalError.classList.remove('d-none');
      } else {
        await showSettingsMessage({
          title: 'Test Email Not Sent',
          message,
          icon: 'error',
          buttonClass: 'btn-danger'
        });
      }
    } finally {
      setSessionNotificationTestEmailSending(false);
    }
  }

  document.getElementById('btnPickSessionNotificationTestTeacher')?.addEventListener('click', openSessionNotificationTestTeacherPicker);
  document.getElementById('btnClearSessionNotificationTestTeacher')?.addEventListener('click', clearSessionNotificationTestTeacher);
  document.getElementById('btnSendSessionNotificationTestEmail')?.addEventListener('click', sendSessionNotificationTestEmail);
  document.getElementById('btnConfirmSessionNotificationTestEmail')?.addEventListener('click', confirmSessionNotificationTestEmailSend);

  renderConductLevels();
  renderAttendanceMarks();
  renderAttendanceItems();
  renderRollupFormulaControls();
  renderRollupGraceItems();
  renderAutosaveSections();
  renderSessionAccessSettings();
  initializeSarOverallTemplates();
  renderSarReportExportFormatControls();
})();
</script>
