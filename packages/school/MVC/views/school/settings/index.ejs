<%
  const canUpdateFlag = typeof canUpdate !== 'undefined' && canUpdate === true;
  const conductLevelsJson = JSON.stringify(conductPolicy?.levels || []).replace(/</g, '\\u003c');
  const attendanceItemsJson = JSON.stringify(attendanceItems || []).replace(/</g, '\\u003c');
  const autosavePolicyJson = JSON.stringify(typeof autosavePolicy !== 'undefined' ? autosavePolicy : { defaultMinutes: 5, sections: {} }).replace(/</g, '\\u003c');
  const autosaveSectionsJson = JSON.stringify(typeof autosaveSections !== 'undefined' ? autosaveSections : []).replace(/</g, '\\u003c');
  const sessionAccessPolicyJson = JSON.stringify(typeof sessionAccessPolicy !== 'undefined' ? sessionAccessPolicy : {}).replace(/</g, '\\u003c');
  const sessionNotificationEmailDefaultBodyJson = JSON.stringify(
    typeof sessionNotificationEmailDefaultBody !== 'undefined' ? sessionNotificationEmailDefaultBody : ''
  ).replace(/</g, '\\u003c');
  const sessionNotificationEmailTokensJson = JSON.stringify(
    typeof sessionNotificationEmailTokens !== 'undefined' ? sessionNotificationEmailTokens : []
  ).replace(/</g, '\\u003c');
  const sessionNotificationEmailWrapperTokensJson = JSON.stringify(
    typeof sessionNotificationEmailWrapperTokens !== 'undefined' ? sessionNotificationEmailWrapperTokens : []
  ).replace(/</g, '\\u003c');
  const sessionNotificationEmailWrapperBuiltinMappingsJson = JSON.stringify(
    typeof sessionNotificationEmailWrapperBuiltinMappings !== 'undefined' ? sessionNotificationEmailWrapperBuiltinMappings : []
  ).replace(/</g, '\\u003c');
  const sessionNotificationEmailContextSourcesJson = JSON.stringify(
    typeof sessionNotificationEmailContextSources !== 'undefined' ? sessionNotificationEmailContextSources : []
  ).replace(/</g, '\\u003c');
  const studentAttendanceReportPolicyJson = JSON.stringify(typeof studentAttendanceReportPolicy !== 'undefined' ? studentAttendanceReportPolicy : { reportTemplateId: '', overallReportTemplateId: '', overallReportTemplateIds: [], templateExportFormats: { report: {}, overall: {} } }).replace(/</g, '\\u003c');
  const studentAttendanceReportTemplateCapabilitiesJson = JSON.stringify(typeof studentAttendanceReportTemplateCapabilities !== 'undefined' ? studentAttendanceReportTemplateCapabilities : { hasDocx: false, hasPdf: false }).replace(/</g, '\\u003c');
  const studentAttendanceReportOverallLabelsJson = JSON.stringify(typeof studentAttendanceReportOverallLabels !== 'undefined' ? studentAttendanceReportOverallLabels : []).replace(/</g, '\\u003c');
  const timesheetParametersPolicyJson = JSON.stringify(typeof timesheetParametersPolicy !== 'undefined' ? timesheetParametersPolicy : { emptyEnrollmentSessions: 'hide' }).replace(/</g, '\\u003c');
  const emptyEnrollmentSessionsValue = String(
    (typeof timesheetParametersPolicy !== 'undefined' && timesheetParametersPolicy?.emptyEnrollmentSessions)
      ? timesheetParametersPolicy.emptyEnrollmentSessions
      : 'hide'
  ).trim() || 'hide';
  const statutoryHolidayPayPolicy = (typeof timesheetParametersPolicy !== 'undefined' && timesheetParametersPolicy?.statutoryHolidayPay)
    ? timesheetParametersPolicy.statutoryHolidayPay
    : {
      enabled: true,
      minWorkdays: 30,
      weekdayOccurrencesRequired: 5,
      weekdayOccurrencesLookback: 9,
      earningsLookbackWeeks: 4,
      beforeAfterSearchDays: 14,
      disqualifyOnLeaveDuringHolidayWeek: true,
      disqualifyOnLeaveBeforeAfter: true,
      payableHolidayTypes: ['National Holiday', 'Observance Paid']
    };
  const statutoryHolidayPayEnabled = statutoryHolidayPayPolicy.enabled !== false;
  const payableHolidayTypesSelected = Array.isArray(statutoryHolidayPayPolicy.payableHolidayTypes)
    ? statutoryHolidayPayPolicy.payableHolidayTypes
    : ['National Holiday', 'Observance Paid'];
  const attendanceThresholdsEnabledFlag = typeof attendanceThresholdsEnabled === 'undefined'
    ? true
    : attendanceThresholdsEnabled !== false;
  const rollupFormulaJson = JSON.stringify(typeof rollupFormula !== 'undefined' ? rollupFormula : {}).replace(/</g, '\\u003c');
  const attendanceMarkAppearancePolicyJson = JSON.stringify(typeof attendanceMarkAppearancePolicy !== 'undefined' ? attendanceMarkAppearancePolicy : { marks: [] }).replace(/</g, '\\u003c');
  const attendanceMarkCuratedIconsJson = JSON.stringify(typeof attendanceMarkCuratedIcons !== 'undefined' ? attendanceMarkCuratedIcons : []).replace(/</g, '\\u003c');
%>

<style>
  .school-settings-page {
    --settings-sidebar-width: 278px;
    --settings-sidebar-collapsed-width: 76px;
  }
  .school-settings-workspace {
    display: grid;
    grid-template-columns: var(--settings-sidebar-width) minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    transition: grid-template-columns 160ms ease;
  }
  .school-settings-workspace.sidebar-collapsed {
    grid-template-columns: var(--settings-sidebar-collapsed-width) minmax(0, 1fr);
  }
  .attendance-timing-excuse-icon {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 1.35em;
    height: 1.35em;
    line-height: 1;
  }
  .attendance-timing-excuse-icon::before {
    content: "";
    position: absolute;
    inset: 0.02em;
    border: 3px solid #198754;
    border-radius: 50%;
    pointer-events: none;
  }
  .attendance-timing-excuse-left::before { clip-path: inset(0 50% 0 0); }
  .attendance-timing-excuse-right::before { clip-path: inset(0 0 0 50%); }
  .attendance-timing-excuse-full::before { clip-path: none; }
  .attendance-timing-excuse-icon > i { position: relative; z-index: 1; }
  .school-settings-sidebar {
    position: sticky;
    top: 1rem;
    overflow: hidden;
    border: 1px solid var(--bs-border-color);
    background: var(--bs-body-bg);
  }
  .school-settings-sidebar-header {
    min-height: 68px;
    border-bottom: 1px solid var(--bs-border-color);
  }
  .school-settings-sidebar-title,
  .school-settings-nav-label,
  .school-settings-org-details {
    transition: opacity 120ms ease;
  }
  .school-settings-org-details {
    min-width: 0;
  }
  .school-settings-nav {
    display: grid;
    gap: .35rem;
    padding: .75rem;
  }
  .school-settings-nav-item {
    display: flex;
    align-items: center;
    gap: .75rem;
    width: 100%;
    min-height: 48px;
    padding: .65rem .75rem;
    border: 0;
    border-radius: .65rem;
    color: var(--bs-body-color);
    background: transparent;
    text-align: left;
    text-decoration: none;
    transition: color 120ms ease, background-color 120ms ease, transform 120ms ease;
  }
  .school-settings-nav-item:hover,
  .school-settings-nav-item:focus-visible {
    color: var(--bs-primary);
    background: var(--bs-primary-bg-subtle);
  }
  .school-settings-nav-item.active {
    color: var(--bs-primary);
    background: var(--bs-primary-bg-subtle);
    font-weight: 700;
  }
  .school-settings-nav-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 32px;
    width: 32px;
    height: 32px;
    border-radius: .55rem;
    color: var(--bs-primary);
    background: var(--bs-primary-bg-subtle);
    font-size: 1rem;
  }
  .school-settings-sidebar-org {
    border-top: 1px solid var(--bs-border-color);
    padding: .85rem 1rem;
    background: var(--bs-tertiary-bg);
  }
  .school-settings-workspace.sidebar-collapsed .school-settings-sidebar-title,
  .school-settings-workspace.sidebar-collapsed .school-settings-nav-label,
  .school-settings-workspace.sidebar-collapsed .school-settings-org-details {
    display: none;
  }
  .school-settings-workspace.sidebar-collapsed .school-settings-sidebar-header {
    justify-content: center !important;
    padding-inline: .5rem !important;
  }
  .school-settings-workspace.sidebar-collapsed .school-settings-nav {
    padding-inline: .6rem;
  }
  .school-settings-workspace.sidebar-collapsed .school-settings-nav-item {
    justify-content: center;
    padding-inline: .35rem;
  }
  .school-settings-workspace.sidebar-collapsed .school-settings-sidebar-org {
    display: flex;
    justify-content: center;
    padding-inline: .5rem;
  }
  .school-settings-content {
    min-width: 0;
  }
  .school-settings-panel {
    display: none;
  }
  .school-settings-panel.active {
    display: block;
    animation: school-settings-panel-in 150ms ease-out;
  }
  .school-settings-panel-header {
    border-bottom: 1px solid var(--bs-border-color);
    background: var(--bs-body-bg);
  }
  @keyframes school-settings-panel-in {
    from { opacity: 0; transform: translateY(3px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .school-settings-table input:disabled {
    background-color: var(--bs-secondary-bg);
    opacity: 1;
  }
  .attendance-threshold-editor {
    transition: opacity 140ms ease;
  }
  .attendance-threshold-editor.is-disabled {
    opacity: .58;
  }
  .rollup-feature-card {
    border: 1px solid var(--bs-border-color);
    border-radius: 12px;
    padding: 1rem 1.15rem;
    background: var(--bs-body-bg);
  }
  .rollup-feature-card.is-disabled {
    opacity: 0.72;
  }
  .rollup-feature-options {
    border-top: 1px solid var(--bs-border-color-translucent);
    margin-top: 0.75rem;
    padding-top: 0.75rem;
  }
  .session-notification-section-toggle {
    border: 0;
    background: transparent;
    padding: 0;
    color: inherit;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
  }
  .session-notification-section-toggle .bi-chevron-down {
    transition: transform 0.2s ease;
  }
  .session-notification-section-toggle[aria-expanded="false"] .bi-chevron-down {
    transform: rotate(-90deg);
  }
  .session-notification-digest-check {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: 0.5rem;
    width: 100%;
    min-width: 0;
  }
  .session-notification-digest-check .form-check {
    display: flex;
    align-items: center;
    margin-bottom: 0;
    flex: 0 0 auto;
    min-width: 0;
    padding-left: 0;
    gap: 0.5em;
  }
  .session-notification-digest-check .form-check-input {
    float: none;
    margin-left: 0;
    margin-top: 0;
    flex-shrink: 0;
  }
  .session-notification-digest-check .form-check-label {
    white-space: nowrap;
    padding-left: 0;
  }
  .session-notification-digest-controls {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    flex-wrap: nowrap;
    gap: 0.5rem;
    min-width: 0;
  }
  .session-notification-digest-controls .form-select,
  .session-notification-digest-controls .form-control {
    width: auto;
    flex: 0 0 auto;
  }
  .session-notification-digest-controls .form-select {
    min-width: 9rem;
    max-width: 11rem;
  }
  .session-notification-digest-controls .form-control.session-notification-days-input {
    width: 5.5rem;
    min-width: 5.5rem;
    max-width: 5.5rem;
  }
  @media (max-width: 767.98px) {
    .school-settings-workspace,
    .school-settings-workspace.sidebar-collapsed {
      grid-template-columns: minmax(0, 1fr);
    }
    .school-settings-sidebar {
      position: static;
    }
    .school-settings-workspace.sidebar-collapsed .school-settings-sidebar-title {
      display: block;
    }
    .school-settings-workspace.sidebar-collapsed .school-settings-sidebar-header {
      justify-content: space-between !important;
      padding-inline: 1rem !important;
    }
    .school-settings-workspace.sidebar-collapsed .school-settings-nav,
    .school-settings-workspace.sidebar-collapsed .school-settings-sidebar-org {
      display: none;
    }
  }
</style>

<div class="sections-page school-settings-page">
  <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
    <div>
      <h1 class="page-heading size-md m-0 text-start" style="padding-left:0;">
        <i class="bi bi-gear-wide-connected me-2"></i>School Settings
      </h1>
      <p class="text-muted mb-0 mt-1">Organization-wide academic and operational policies managed from one place.</p>
    </div>
    <a href="<%= (typeof schoolSectionDashboardHref !== 'undefined' && schoolSectionDashboardHref) || '/dashboard/section-nav/SCHOOL' %>" class="school-navigator-dashboard btn btn-outline-secondary btn-sm">
      <i class="bi bi-speedometer2 me-1"></i>School Dashboard
    </a>
  </div>

  <% if (!canUpdateFlag) { %>
    <div class="alert alert-info border-0 shadow-sm" role="status">
      <i class="bi bi-eye me-2"></i>You have read-only access. School Settings update access is required to save changes.
    </div>
  <% } %>

  <div class="school-settings-workspace" id="schoolSettingsWorkspace">
    <aside class="school-settings-sidebar rounded-3 shadow-sm" id="schoolSettingsSidebar" aria-label="School settings">
      <div class="school-settings-sidebar-header d-flex align-items-center justify-content-between gap-2 px-3 py-2">
        <div class="school-settings-sidebar-title">
          <div class="fw-bold">Settings</div>
          <div class="small text-muted">Choose an area</div>
        </div>
        <button type="button" class="btn btn-sm btn-outline-secondary flex-shrink-0" id="btnToggleSettingsSidebar" aria-expanded="true" aria-controls="schoolSettingsNav" title="Collapse settings sidebar">
          <i class="bi bi-layout-sidebar-inset" id="settingsSidebarToggleIcon" aria-hidden="true"></i>
          <span class="visually-hidden" id="settingsSidebarToggleText">Collapse settings sidebar</span>
        </button>
      </div>
      <nav class="school-settings-nav" id="schoolSettingsNav" role="tablist" aria-orientation="vertical">
        <% (groups || []).forEach((group, index) => { %>
          <% if (group.href) { %>
          <a
            class="school-settings-nav-item"
            href="<%= group.href %>"
            title="<%= group.title %>"
          >
            <span class="school-settings-nav-icon"><i class="bi <%= group.icon %>" aria-hidden="true"></i></span>
            <span class="school-settings-nav-label"><%= group.title %></span>
          </a>
          <% } else { %>
          <a
            class="school-settings-nav-item <%= index === 0 ? 'active' : '' %>"
            href="#<%= group.key %>"
            role="tab"
            id="settings-tab-<%= group.key %>"
            data-settings-target="<%= group.key %>"
            aria-controls="<%= group.key %>"
            aria-selected="<%= index === 0 ? 'true' : 'false' %>"
            title="<%= group.title %>"
          >
            <span class="school-settings-nav-icon"><i class="bi <%= group.icon %>" aria-hidden="true"></i></span>
            <span class="school-settings-nav-label"><%= group.title %></span>
          </a>
          <% } %>
        <% }); %>
      </nav>
      <div class="school-settings-sidebar-org d-flex align-items-center gap-2">
        <i class="bi bi-building text-primary" aria-hidden="true"></i>
        <div class="school-settings-org-details min-w-0">
          <div class="small fw-semibold text-truncate" title="<%= activeOrgName %>"><%= activeOrgName %></div>
          <div class="small text-muted font-monospace text-truncate" title="<%= activeOrgId %>"><%= activeOrgId %></div>
        </div>
      </div>
    </aside>

    <main class="school-settings-content" id="schoolSettingsContent">
      <section class="school-settings-panel active card border-0 shadow-sm" id="conduct-rating-scale" role="tabpanel" aria-labelledby="settings-tab-conduct-rating-scale" tabindex="0">
        <header class="school-settings-panel-header card-header px-4 py-3">
          <div class="d-flex align-items-center gap-3">
            <span class="school-settings-nav-icon"><i class="bi bi-emoji-smile" aria-hidden="true"></i></span>
            <div>
              <h2 class="h5 fw-bold mb-1">Conduct Rating Scale</h2>
              <p class="small text-muted mb-0">Configure conduct labels, display codes, and percentage bands.</p>
            </div>
          </div>
        </header>
        <div class="card-body p-4">
          <p class="small text-muted">
            Configure the labels used for class conduct. Percentage ranges must cover 0–100 without gaps or overlaps,
            and each default percentage must remain inside its range. N/A remains a fixed non-percentage option.
          </p>
          <div class="alert alert-danger d-none js-settings-error" id="conductSettingsError" role="alert"></div>
          <form id="conductSettingsForm" novalidate>
            <input type="hidden" name="actionStateId" value="<%= actionStateId || '' %>">
            <div class="table-responsive">
              <table class="table table-sm align-middle school-settings-table">
                <thead class="table-light">
                  <tr>
                    <th>Code</th>
                    <th style="min-width:11rem;">Label</th>
                    <th>Display</th>
                    <th>Min %</th>
                    <th>Max %</th>
                    <th>Default %</th>
                  </tr>
                </thead>
                <tbody id="conductSettingsBody"></tbody>
              </table>
            </div>
            <% if (canUpdateFlag) { %>
              <div class="d-flex justify-content-end">
                <button class="btn btn-primary" type="submit" id="btnSaveConductSettings">
                  <i class="bi bi-save me-1"></i>Save Conduct Scale
                </button>
              </div>
            <% } %>
          </form>
        </div>
      </section>

      <section class="school-settings-panel card border-0 shadow-sm" id="attendance-matrix" role="tabpanel" aria-labelledby="settings-tab-attendance-matrix" tabindex="0" hidden>
        <header class="school-settings-panel-header card-header px-4 py-3">
          <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
              <span class="school-settings-nav-icon"><i class="bi bi-clock-history" aria-hidden="true"></i></span>
              <div>
                <h2 class="h5 fw-bold mb-1">Attendance Matrix Thresholds</h2>
                <p class="small text-muted mb-0">Configure duration-based late, early-leave, and combined thresholds.</p>
              </div>
            </div>
            <div class="form-check form-switch m-0">
              <input
                class="form-check-input"
                type="checkbox"
                role="switch"
                id="attendanceThresholdsEnabled"
                <%= attendanceThresholdsEnabledFlag ? 'checked' : '' %>
                <%= canUpdateFlag ? '' : 'disabled' %>
                aria-describedby="attendanceThresholdsEnabledHelp"
              >
              <label class="form-check-label fw-semibold" for="attendanceThresholdsEnabled">
                <span id="attendanceThresholdsEnabledLabel"><%= attendanceThresholdsEnabledFlag ? 'On' : 'Off' %></span>
              </label>
            </div>
          </div>
        </header>
        <div class="card-body p-4">
          <p class="small text-muted mb-3" id="attendanceThresholdsEnabledHelp">
            When Off, late and early-leaving students receive full attendance credit. They are recorded as Late, or Present when Late is unavailable for the class.
          </p>
          <p class="small text-muted mb-1">
            Create one threshold set per session duration. Exact duration matches are preferred; unmatched sessions use
            the selected default item and then the built-in 180 / 30 / 30 defaults.
          </p>
          <p class="small text-muted">When On, class-level attendance policy values continue to override these organization defaults.</p>
          <p class="small text-muted mb-3">
            Rollup % rules are configured separately in the
            <a href="#attendance-rollup">Attendance Rollup Formula</a> section.
          </p>
          <div class="alert alert-danger d-none js-settings-error" id="attendanceSettingsError" role="alert"></div>
          <form id="attendanceSettingsForm" novalidate>
            <input type="hidden" name="actionStateId" value="<%= actionStateId || '' %>">
            <div class="attendance-threshold-editor" id="attendanceThresholdEditor">
            <div class="d-flex justify-content-end mb-2">
              <% if (canUpdateFlag) { %>
                <button class="btn btn-outline-primary btn-sm" type="button" id="btnAddAttendanceDuration">
                  <i class="bi bi-plus-lg me-1"></i>Add Duration
                </button>
              <% } %>
            </div>
            <div class="table-responsive">
              <table class="table table-sm align-middle school-settings-table">
                <thead class="table-light">
                  <tr>
                    <th style="min-width:8rem;">Duration (min)</th>
                    <th style="min-width:8rem;">Late ≥</th>
                    <th style="min-width:8rem;">Early leave ≥</th>
                    <th style="min-width:13rem;">Combined late + early</th>
                    <th class="text-center">Default</th>
                    <% if (canUpdateFlag) { %><th aria-label="Actions"></th><% } %>
                  </tr>
                </thead>
                <tbody id="attendanceSettingsBody"></tbody>
              </table>
            </div>
            </div>
            <% if (canUpdateFlag) { %>
              <div class="d-flex justify-content-end">
                <button class="btn btn-primary" type="submit" id="btnSaveAttendanceSettings">
                  <i class="bi bi-save me-1"></i>Save Attendance Thresholds
                </button>
              </div>
            <% } %>
          </form>
        </div>
      </section>

      <section class="school-settings-panel card border-0 shadow-sm" id="attendance-marks" role="tabpanel" aria-labelledby="settings-tab-attendance-marks" tabindex="0" hidden>
        <header class="school-settings-panel-header card-header px-4 py-3">
          <div class="d-flex align-items-center gap-3">
            <span class="school-settings-nav-icon"><i class="bi bi-palette" aria-hidden="true"></i></span>
            <div>
              <h2 class="h5 fw-bold mb-1">Attendance Marks</h2>
              <p class="small text-muted mb-0">Configure labels, Bootstrap icons, and colors for the Attendance Matrix and Student Attendance Report.</p>
            </div>
          </div>
        </header>
        <div class="card-body p-4">
          <p class="small text-muted mb-3">
            Late and early-leave timing marks share the <span class="fw-semibold">late</span> color. The timing excuse ring color applies to half- and full-ring overlays on excused timing marks.
          </p>
          <div class="alert alert-danger d-none js-settings-error" id="attendanceMarksSettingsError" role="alert"></div>
          <form id="attendanceMarksSettingsForm" novalidate>
            <input type="hidden" name="actionStateId" value="<%= actionStateId || '' %>">
            <datalist id="attendanceMarkIconOptions">
              <% (attendanceMarkCuratedIcons || []).forEach((icon) => { %>
                <option value="<%= icon %>"></option>
              <% }); %>
            </datalist>
            <div class="table-responsive">
              <table class="table table-sm align-middle school-settings-table">
                <thead class="table-light">
                  <tr>
                    <th>Mark</th>
                    <th style="min-width:11rem;">Label</th>
                    <th style="min-width:9rem;">Icon</th>
                    <th style="min-width:8rem;">Color</th>
                    <th class="text-center" style="width:3rem;">Preview</th>
                  </tr>
                </thead>
                <tbody id="attendanceMarksSettingsBody"></tbody>
              </table>
            </div>
            <% if (canUpdateFlag) { %>
              <div class="d-flex justify-content-end">
                <button class="btn btn-primary" type="submit" id="btnSaveAttendanceMarksSettings">
                  <i class="bi bi-save me-1"></i>Save Attendance Marks
                </button>
              </div>
            <% } %>
          </form>
        </div>
      </section>

      <section class="school-settings-panel card border-0 shadow-sm" id="attendance-rollup" role="tabpanel" aria-labelledby="settings-tab-attendance-rollup" tabindex="0" hidden>
        <header class="school-settings-panel-header card-header px-4 py-3">
          <div class="d-flex align-items-center gap-3">
            <span class="school-settings-nav-icon"><i class="bi bi-percent" aria-hidden="true"></i></span>
            <div>
              <h2 class="h5 fw-bold mb-1">Attendance Rollup Formula</h2>
              <p class="small text-muted mb-0">Control how rollup % is calculated for the matrix, student report, Excel export, and print.</p>
            </div>
          </div>
        </header>
        <div class="card-body p-4">
          <p class="small text-muted mb-3">
            Turn each rule on or off. Disabled rules do not affect rollup %. Matrix thresholds above change saved roster status only.
            Session durations for grace minutes come from your Attendance Matrix Thresholds configuration.
          </p>
          <div class="alert alert-danger d-none js-settings-error" id="rollupSettingsError" role="alert"></div>
          <form id="rollupFormulaForm" novalidate>
            <input type="hidden" name="actionStateId" value="<%= actionStateId || '' %>">
            <div class="row g-3 mb-4">
              <div class="col-lg-6">
                <div class="rollup-feature-card" id="cardUnmarked">
                  <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" role="switch" id="includeUnmarkedSessions" <%= canUpdateFlag ? '' : 'disabled' %>>
                    <label class="form-check-label fw-semibold" for="includeUnmarkedSessions">Include unmarked sessions in rollup</label>
                  </div>
                  <p class="small text-muted mt-2 mb-0">When off, sessions with no attendance status are excluded from the rollup denominator.</p>
                  <div class="rollup-feature-options" id="unmarkedOptions">
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" id="countUnmarkedAsAbsent" <%= canUpdateFlag ? '' : 'disabled' %>>
                      <label class="form-check-label" for="countUnmarkedAsAbsent">Count unmarked sessions as absent (0% credit)</label>
                    </div>
                  </div>
                </div>
              </div>
              <div class="col-lg-6">
                <div class="rollup-feature-card" id="cardLateGrace">
                  <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" role="switch" id="includeLateGrace" <%= canUpdateFlag ? '' : 'disabled' %>>
                    <label class="form-check-label fw-semibold" for="includeLateGrace">Apply late arrival grace minutes</label>
                  </div>
                  <p class="small text-muted mt-2 mb-0">When on, late minutes up to the grace value per duration do not reduce rollup credit.</p>
                </div>
              </div>
              <div class="col-lg-6">
                <div class="rollup-feature-card" id="cardEarlyGrace">
                  <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" role="switch" id="includeEarlyGrace" <%= canUpdateFlag ? '' : 'disabled' %>>
                    <label class="form-check-label fw-semibold" for="includeEarlyGrace">Apply early leave grace minutes</label>
                  </div>
                  <p class="small text-muted mt-2 mb-0">When on, early-leave minutes up to the grace value per duration do not reduce rollup credit.</p>
                </div>
              </div>
              <div class="col-lg-6">
                <div class="rollup-feature-card" id="cardLateExcused">
                  <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" role="switch" id="includeLateExcusedRule" <%= canUpdateFlag ? '' : 'disabled' %>>
                    <label class="form-check-label fw-semibold" for="includeLateExcusedRule">Apply late excused rules in rollup</label>
                  </div>
                  <p class="small text-muted mt-2 mb-0">When off, the late excused flag is ignored for rollup math (minutes still apply).</p>
                  <div class="rollup-feature-options" id="lateExcusedOptions">
                    <label class="form-label small fw-semibold" for="lateExcusedTreatment">When late is excused</label>
                    <select class="form-select form-select-sm" id="lateExcusedTreatment" <%= canUpdateFlag ? '' : 'disabled' %>>
                      <option value="reduce_credit">Reduce credit by minutes</option>
                      <option value="waive_penalty">Waive penalty minutes</option>
                      <option value="count_as_absent">Count as absent (0% credit)</option>
                    </select>
                  </div>
                </div>
              </div>
              <div class="col-lg-6">
                <div class="rollup-feature-card" id="cardEarlyExcused">
                  <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" role="switch" id="includeEarlyExcusedRule" <%= canUpdateFlag ? '' : 'disabled' %>>
                    <label class="form-check-label fw-semibold" for="includeEarlyExcusedRule">Apply early leave excused rules in rollup</label>
                  </div>
                  <p class="small text-muted mt-2 mb-0">When off, the early leave excused flag is ignored for rollup math (minutes still apply).</p>
                  <div class="rollup-feature-options" id="earlyExcusedOptions">
                    <label class="form-label small fw-semibold" for="earlyExcusedTreatment">When early leave is excused</label>
                    <select class="form-select form-select-sm" id="earlyExcusedTreatment" <%= canUpdateFlag ? '' : 'disabled' %>>
                      <option value="reduce_credit">Reduce credit by minutes</option>
                      <option value="waive_penalty">Waive penalty minutes</option>
                      <option value="count_as_absent">Count as absent (0% credit)</option>
                    </select>
                  </div>
                </div>
              </div>
            </div>
            <h3 class="h6 fw-bold mb-2">Grace minutes by session duration</h3>
            <p class="small text-muted mb-3">Grace values apply only when the corresponding grace rule above is enabled.</p>
            <div class="table-responsive mb-4">
              <table class="table table-sm align-middle school-settings-table mb-0">
                <thead class="table-light">
                  <tr>
                    <th>Duration (min)</th>
                    <th>Late grace (min)</th>
                    <th>Early leave grace (min)</th>
                  </tr>
                </thead>
                <tbody id="rollupGraceBody"></tbody>
              </table>
            </div>
            <% if (canUpdateFlag) { %>
              <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-primary" id="btnSaveRollupFormula">
                  <i class="bi bi-save me-1"></i>Save Rollup Formula
                </button>
              </div>
            <% } %>
          </form>
        </div>
      </section>

      <section class="school-settings-panel card border-0 shadow-sm" id="autosave" role="tabpanel" aria-labelledby="settings-tab-autosave" tabindex="0" hidden>
        <header class="school-settings-panel-header card-header px-4 py-3">
          <div class="d-flex align-items-center gap-3">
            <span class="school-settings-nav-icon"><i class="bi bi-arrow-repeat" aria-hidden="true"></i></span>
            <div>
              <h2 class="h5 fw-bold mb-1">Autosave</h2>
              <p class="small text-muted mb-0">Set default autosave intervals and per-page defaults for school workflows.</p>
            </div>
          </div>
        </header>
        <div class="card-body p-4">
          <p class="small text-muted">
            Teachers can override autosave on each supported page. Those overrides are stored on their device only.
            Organization defaults apply when a teacher has not changed settings on that page.
          </p>
          <div class="alert alert-danger d-none js-settings-error" id="autosaveSettingsError" role="alert"></div>
          <form id="autosaveSettingsForm" novalidate>
            <input type="hidden" name="actionStateId" value="<%= actionStateId || '' %>">
            <div class="row g-3 mb-4">
              <div class="col-md-4">
                <label class="form-label fw-semibold" for="autosaveDefaultMinutes">Default interval (minutes)</label>
                <input
                  class="form-control"
                  type="number"
                  min="1"
                  max="60"
                  step="1"
                  id="autosaveDefaultMinutes"
                  name="defaultMinutes"
                  value="<%= typeof autosavePolicy !== 'undefined' && autosavePolicy?.defaultMinutes != null ? autosavePolicy.defaultMinutes : 5 %>"
                  <%= canUpdateFlag ? '' : 'disabled' %>
                >
                <div class="form-text">Used when a section does not have its own override.</div>
              </div>
            </div>
            <div class="table-responsive">
              <table class="table table-sm align-middle school-settings-table">
                <thead class="table-light">
                  <tr>
                    <th>Section</th>
                    <th class="text-center">Enabled by default</th>
                    <th style="min-width:10rem;">Minutes override</th>
                  </tr>
                </thead>
                <tbody id="autosaveSettingsBody"></tbody>
              </table>
            </div>
            <% if (canUpdateFlag) { %>
              <div class="d-flex justify-content-end">
                <button class="btn btn-primary" type="submit" id="btnSaveAutosaveSettings">
                  <i class="bi bi-save me-1"></i>Save Autosave Settings
                </button>
              </div>
            <% } %>
          </form>
        </div>
      </section>

      <section class="school-settings-panel card border-0 shadow-sm" id="session-access" role="tabpanel" aria-labelledby="settings-tab-session-access" tabindex="0" hidden>
        <header class="school-settings-panel-header card-header px-4 py-3">
          <div class="d-flex align-items-center gap-3">
            <span class="school-settings-nav-icon"><i class="bi bi-shield-lock" aria-hidden="true"></i></span>
            <div>
              <h2 class="h5 fw-bold mb-1">Session Access &amp; Edit</h2>
              <p class="small text-muted mb-0">Control teacher reminders for uncompleted sessions and attendance edit windows after completion.</p>
            </div>
          </div>
        </header>
        <div class="card-body p-4">
          <div class="alert alert-danger d-none js-settings-error" id="sessionAccessSettingsError" role="alert"></div>
          <form id="sessionAccessSettingsForm" novalidate>
            <input type="hidden" name="actionStateId" value="<%= actionStateId || '' %>">
            <div class="rollup-feature-card mb-4" id="cardSessionNotification">
              <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" role="switch" id="sessionNotificationEnabled" <%= canUpdateFlag ? '' : 'disabled' %>>
                <label class="form-check-label fw-semibold" for="sessionNotificationEnabled">Notify teachers about uncompleted sessions</label>
              </div>
              <p class="small text-muted mt-2 mb-0">Configure email and SMS independently. Each channel can use its own schedule, session date range, and message templates.</p>
              <div class="rollup-feature-options mt-3" id="sessionNotificationOptions">

                <div class="border rounded mb-3" id="cardSessionNotificationEmail">
                  <div class="d-flex align-items-center justify-content-between gap-2 p-3 border-bottom">
                    <button class="session-notification-section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#sessionNotificationEmailCollapse" aria-expanded="true" aria-controls="sessionNotificationEmailCollapse">
                      <i class="bi bi-chevron-down" aria-hidden="true"></i>
                      <i class="bi bi-envelope text-primary" aria-hidden="true"></i>
                      <span>Email notifications</span>
                    </button>
                    <div class="form-check form-switch mb-0">
                      <input class="form-check-input" type="checkbox" role="switch" id="sessionNotificationEmailEnabled" <%= canUpdateFlag ? '' : 'disabled' %>>
                      <label class="form-check-label visually-hidden" for="sessionNotificationEmailEnabled">Enable email notifications</label>
                    </div>
                  </div>
                  <div class="collapse show p-3" id="sessionNotificationEmailCollapse">
                    <div class="row g-3">
                      <div class="col-lg-3">
                        <label class="form-label fw-semibold" for="sessionNotificationEmailPrepareAtTime">Prepare emails at</label>
                        <input class="form-control" type="time" id="sessionNotificationEmailPrepareAtTime" <%= canUpdateFlag ? '' : 'disabled' %>>
                        <p class="small text-muted mb-0 mt-1">Runs daily at this time to build messages and queue them in the outbox.</p>
                      </div>
                      <div class="col-lg-3">
                        <label class="form-label fw-semibold" for="sessionNotificationEmailSendAtTime">Send at time</label>
                        <input class="form-control" type="time" id="sessionNotificationEmailSendAtTime" <%= canUpdateFlag ? '' : 'disabled' %>>
                        <p class="small text-muted mb-0 mt-1">Runs daily at this time to deliver queued messages. If this time is earlier on the clock than prepare, it is treated as the next morning.</p>
                      </div>
                      <div class="col-12 d-none" id="sessionNotificationEmailScheduleWarning">
                        <div class="alert alert-warning py-2 px-3 small mb-0" role="alert">
                          Prepare and Send must be at least 10 minutes apart (send may be earlier on the clock if it is the next morning).
                        </div>
                      </div>
                      <div class="col-12">
                        <label class="form-label fw-semibold">Session(s) Range:</label>
                        <div class="form-check">
                          <input class="form-check-input" type="radio" name="sessionNotificationEmailSendWhen" id="sessionNotificationEmailSameDay" value="same_day" <%= canUpdateFlag ? '' : 'disabled' %>>
                          <label class="form-check-label" for="sessionNotificationEmailSameDay">Same day as session</label>
                        </div>
                        <div class="form-check">
                          <input class="form-check-input" type="radio" name="sessionNotificationEmailSendWhen" id="sessionNotificationEmailNextDay" value="next_day" <%= canUpdateFlag ? '' : 'disabled' %>>
                          <label class="form-check-label" for="sessionNotificationEmailNextDay">Day after session</label>
                        </div>
                        <div class="session-notification-digest-check" id="sessionNotificationEmailDigestRow">
                          <div class="form-check mb-0">
                            <input class="form-check-input" type="radio" name="sessionNotificationEmailSendWhen" id="sessionNotificationEmailDailyAll" value="daily_all" <%= canUpdateFlag ? '' : 'disabled' %>>
                            <label class="form-check-label" for="sessionNotificationEmailDailyAll">Daily digest of uncompleted sessions</label>
                          </div>
                          <span class="session-notification-digest-controls" id="sessionNotificationEmailRangeGroup">
                            <select class="form-select form-select-sm" id="sessionNotificationEmailRangeType" aria-label="Sessions to include" <%= canUpdateFlag ? '' : 'disabled' %>>
                              <option value="this_week">This week</option>
                              <option value="two_weeks">These two weeks</option>
                              <option value="this_month">This month</option>
                              <option value="timesheet_period">Current timesheet period</option>
                              <option value="days_before_today">Days before today</option>
                            </select>
                            <input class="form-control form-control-sm session-notification-days-input d-none" type="number" min="1" max="365" step="1" id="sessionNotificationEmailDaysBefore" placeholder="Days" aria-label="Days before today" <%= canUpdateFlag ? '' : 'disabled' %>>
                          </span>
                        </div>
                      </div>
                      <div class="col-12">
                        <label class="form-label fw-semibold" for="sessionNotificationEmailTemplateName">Email template</label>
                        <div class="input-group">
                          <input type="hidden" id="sessionNotificationEmailTemplateId" value="">
                          <input class="form-control" type="text" id="sessionNotificationEmailTemplateName" placeholder="Select an email template" readonly <%= canUpdateFlag ? '' : 'disabled' %>>
                          <button class="btn btn-outline-primary" type="button" id="sessionNotificationEmailTemplatePickBtn" <%= canUpdateFlag ? '' : 'disabled' %>>
                            <i class="bi bi-search me-1"></i> Pick
                          </button>
                          <button class="btn btn-outline-secondary" type="button" id="sessionNotificationEmailTemplateClearBtn" <%= canUpdateFlag ? '' : 'disabled' %>>Clear</button>
                        </div>
                        <p class="small text-muted mt-1 mb-0">
                          Subject and sender come from the selected general template in Email Management. School resolves wrapper placeholders (for example <code>{{TEACHER_NAME}}</code>, <code>{{SESSION_LIST}}</code>) and injects the composed notification body at <code>{{BODY_CONTENT}}</code>.
                          <a href="/email-management/templates?templateKind__eq=general" target="_blank" rel="noopener">Manage general templates</a>.
                          Open <strong>Edit notification body</strong> for placeholder reference and custom wrapper mappings.
                        </p>
                        <div class="alert alert-warning py-2 px-3 small mt-2 mb-0 d-none" id="sessionNotificationEmailTemplateBodyContentWarning" role="alert"></div>
                      </div>
                      <div class="col-12">
                        <label class="form-label fw-semibold" for="sessionNotificationEmailBodyEditBtn">Notification message body</label>
                        <textarea class="d-none" id="sessionNotificationEmailBody" <%= canUpdateFlag ? '' : 'disabled' %> aria-hidden="true"></textarea>
                        <input type="hidden" id="sessionNotificationEmailWrapperMappings" value="[]" <%= canUpdateFlag ? '' : 'disabled' %>>
                        <p class="small text-muted mb-2" id="sessionNotificationEmailBodySummary">Using default message</p>
                        <% if (canUpdateFlag) { %>
                          <button class="btn btn-outline-primary btn-sm" type="button" id="sessionNotificationEmailBodyEditBtn">
                            <i class="bi bi-pencil-square me-1"></i> Edit notification body
                          </button>
                        <% } %>
                      </div>
                    </div>
                    <div class="border rounded mt-3">
                      <button class="session-notification-section-toggle w-100 justify-content-start p-3" type="button" data-bs-toggle="collapse" data-bs-target="#sessionNotificationEmailTestCollapse" aria-expanded="false" aria-controls="sessionNotificationEmailTestCollapse">
                        <i class="bi bi-chevron-down" aria-hidden="true"></i>
                        <span>Test email</span>
                      </button>
                      <div class="collapse border-top px-3 pb-3" id="sessionNotificationEmailTestCollapse">
                        <p class="small text-muted mt-3 mb-3">Preview the email digest for a teacher using the session range and selected template above (saved settings not required).</p>
                        <div class="row g-3 align-items-end">
                          <div class="col-lg-8">
                            <label class="form-label" for="sessionNotificationTestTeacherName">Teacher</label>
                            <input type="hidden" id="sessionNotificationTestTeacherId" value="">
                            <div class="input-group">
                              <input class="form-control" type="text" id="sessionNotificationTestTeacherName" readonly placeholder="Select a teacher" <%= canUpdateFlag ? '' : 'disabled' %>>
                              <% if (canUpdateFlag) { %>
                                <button class="btn btn-outline-secondary" type="button" id="btnPickSessionNotificationTestTeacher" title="Select teacher"><i class="bi bi-search"></i></button>
                                <button class="btn btn-outline-danger" type="button" id="btnClearSessionNotificationTestTeacher" title="Clear teacher"><i class="bi bi-x"></i></button>
                              <% } %>
                            </div>
                          </div>
                          <% if (canUpdateFlag) { %>
                            <div class="col-lg-4 d-flex justify-content-lg-end">
                              <button class="btn btn-outline-primary" type="button" id="btnSendSessionNotificationTestEmail">
                                <i class="bi bi-envelope me-1"></i>Send test email
                              </button>
                            </div>
                          <% } %>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="border rounded" id="cardSessionNotificationSms">
                  <div class="d-flex align-items-center justify-content-between gap-2 p-3 border-bottom">
                    <button class="session-notification-section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#sessionNotificationSmsCollapse" aria-expanded="true" aria-controls="sessionNotificationSmsCollapse">
                      <i class="bi bi-chevron-down" aria-hidden="true"></i>
                      <i class="bi bi-phone text-primary" aria-hidden="true"></i>
                      <span>SMS notifications</span>
                    </button>
                    <div class="form-check form-switch mb-0">
                      <input class="form-check-input" type="checkbox" role="switch" id="sessionNotificationSmsEnabled" <%= canUpdateFlag ? '' : 'disabled' %>>
                      <label class="form-check-label visually-hidden" for="sessionNotificationSmsEnabled">Enable SMS notifications</label>
                    </div>
                  </div>
                  <div class="collapse show p-3" id="sessionNotificationSmsCollapse">
                    <div class="row g-3">
                      <div class="col-lg-3">
                        <label class="form-label fw-semibold" for="sessionNotificationSmsPrepareAtTime">Prepare SMS at</label>
                        <input class="form-control" type="time" id="sessionNotificationSmsPrepareAtTime" <%= canUpdateFlag ? '' : 'disabled' %>>
                        <p class="small text-muted mb-0 mt-1">Runs daily at this time to build messages and queue them in the outbox.</p>
                      </div>
                      <div class="col-lg-3">
                        <label class="form-label fw-semibold" for="sessionNotificationSmsSendAtTime">Send at time</label>
                        <input class="form-control" type="time" id="sessionNotificationSmsSendAtTime" <%= canUpdateFlag ? '' : 'disabled' %>>
                        <p class="small text-muted mb-0 mt-1">Runs daily at this time to deliver queued messages. If this time is earlier on the clock than prepare, it is treated as the next morning.</p>
                      </div>
                      <div class="col-12 d-none" id="sessionNotificationSmsScheduleWarning">
                        <div class="alert alert-warning py-2 px-3 small mb-0" role="alert">
                          Prepare and Send must be at least 10 minutes apart (send may be earlier on the clock if it is the next morning).
                        </div>
                      </div>
                      <div class="col-12">
                        <label class="form-label fw-semibold">Session(s) Range:</label>
                        <div class="form-check">
                          <input class="form-check-input" type="radio" name="sessionNotificationSmsSendWhen" id="sessionNotificationSmsSameDay" value="same_day" <%= canUpdateFlag ? '' : 'disabled' %>>
                          <label class="form-check-label" for="sessionNotificationSmsSameDay">Same day as session</label>
                        </div>
                        <div class="form-check">
                          <input class="form-check-input" type="radio" name="sessionNotificationSmsSendWhen" id="sessionNotificationSmsNextDay" value="next_day" <%= canUpdateFlag ? '' : 'disabled' %>>
                          <label class="form-check-label" for="sessionNotificationSmsNextDay">Day after session</label>
                        </div>
                        <div class="session-notification-digest-check" id="sessionNotificationSmsDigestRow">
                          <div class="form-check mb-0">
                            <input class="form-check-input" type="radio" name="sessionNotificationSmsSendWhen" id="sessionNotificationSmsDailyAll" value="daily_all" <%= canUpdateFlag ? '' : 'disabled' %>>
                            <label class="form-check-label" for="sessionNotificationSmsDailyAll">Daily digest of uncompleted sessions</label>
                          </div>
                          <span class="session-notification-digest-controls" id="sessionNotificationSmsRangeGroup">
                            <select class="form-select form-select-sm" id="sessionNotificationSmsRangeType" aria-label="Sessions to include" <%= canUpdateFlag ? '' : 'disabled' %>>
                              <option value="this_week">This week</option>
                              <option value="two_weeks">These two weeks</option>
                              <option value="this_month">This month</option>
                              <option value="timesheet_period">Current timesheet period</option>
                              <option value="days_before_today">Days before today</option>
                            </select>
                            <input class="form-control form-control-sm session-notification-days-input d-none" type="number" min="1" max="365" step="1" id="sessionNotificationSmsDaysBefore" placeholder="Days" aria-label="Days before today" <%= canUpdateFlag ? '' : 'disabled' %>>
                          </span>
                        </div>
                      </div>
                      <div class="col-12">
                        <label class="form-label" for="sessionNotificationSmsBody">Body template</label>
                        <textarea class="form-control" rows="2" maxlength="320" id="sessionNotificationSmsBody" <%= canUpdateFlag ? '' : 'disabled' %>></textarea>
                        <p class="small text-muted mt-1 mb-0">Keep messages short (320 characters). Daily digest SMS uses a summary with <code>{{sessionCount}}</code>; the full session list is email-only.</p>
                      </div>
                    </div>
                  </div>
                </div>

                <p class="small text-muted mt-3 mb-0">Placeholders: {{className}}, {{classId}}, {{sessionName}}, {{sessionId}}, {{sessionDate}}, {{sessionTime}}, {{teacherName}}, {{orgName}}, {{sessionManagerUrl}}, {{sessionCount}}, {{sessionList}}, {{sessionListHtml}}</p>
              </div>
            </div>

            <div class="rollup-feature-card mb-4" id="cardSessionCompletedEditWindows">
              <div class="d-flex align-items-start justify-content-between gap-2 mb-3">
                <div>
                  <h3 class="h6 fw-bold mb-1"><i class="bi bi-lock me-1 text-primary"></i>Completed Session Edit Windows</h3>
                  <p class="small text-muted mb-0">Control post-completion edit windows per section. Each section can be expanded/collapsed below.</p>
                </div>
              </div>

              <div class="border rounded rollup-feature-card p-0" id="cardSessionAttendanceEdit">
                <div class="d-flex align-items-center justify-content-between gap-2 p-3 border-bottom">
                  <button class="session-notification-section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#sessionAttendanceEditCollapse" aria-expanded="true" aria-controls="sessionAttendanceEditCollapse">
                    <i class="bi bi-chevron-down" aria-hidden="true"></i>
                    <i class="bi bi-people-fill text-primary" aria-hidden="true"></i>
                    <span>Allow attendance edits after session completion</span>
                  </button>
                  <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" role="switch" id="sessionAttendanceEditEnabled" <%= canUpdateFlag ? '' : 'disabled' %>>
                    <label class="form-check-label visually-hidden" for="sessionAttendanceEditEnabled">Allow attendance edits after session completion</label>
                  </div>
                </div>
                <div class="collapse show p-3" id="sessionAttendanceEditCollapse">
                  <p class="small text-muted mt-0 mb-0" id="sessionAttendanceEditDisabledHelp">
                    When off, teachers may edit attendance until the end of the next calendar day after completion.
                  </p>
                  <div class="rollup-feature-options mt-3" id="sessionAttendanceEditOptions">
                    <div class="row g-3 align-items-end">
                      <div class="col-md-5">
                        <label class="form-label fw-semibold" for="sessionAttendanceEditWindowType">Edit window</label>
                        <select class="form-select" id="sessionAttendanceEditWindowType" <%= canUpdateFlag ? '' : 'disabled' %>>
                          <option value="end_of_week">End of week</option>
                          <option value="end_of_month">End of month</option>
                          <option value="timesheet_period">Timesheet period</option>
                          <option value="days_after_session">Days after session</option>
                        </select>
                      </div>
                      <div class="col-md-3">
                        <label class="form-label fw-semibold" for="sessionAttendanceEditDaysAfter">Days after session</label>
                        <input class="form-control" type="number" min="1" max="365" step="1" id="sessionAttendanceEditDaysAfter" <%= canUpdateFlag ? '' : 'disabled' %>>
                      </div>
                    </div>
                    <p class="small text-muted mt-2 mb-0" id="sessionAttendanceEditPreview"></p>
                  </div>
                </div>
              </div>

              <div class="border rounded rollup-feature-card p-0 mt-3" id="cardSessionNotesEdit">
                <div class="d-flex align-items-center justify-content-between gap-2 p-3 border-bottom">
                  <button class="session-notification-section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#sessionNotesEditCollapse" aria-expanded="true" aria-controls="sessionNotesEditCollapse">
                    <i class="bi bi-chevron-down" aria-hidden="true"></i>
                    <i class="bi bi-journal-text text-primary" aria-hidden="true"></i>
                    <span>Allow Session Notes edits after session completion</span>
