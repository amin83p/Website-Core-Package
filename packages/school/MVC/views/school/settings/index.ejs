                <div class="row g-3 align-items-end">
                  <div class="col-md-5">
                    <label class="form-label fw-semibold" for="sessionAttendanceEditWindowType">Edit window</label>
                    <select class="form-select" id="sessionAttendanceEditWindowType" <%= canUpdateFlag ? '' : 'disabled' %>>
                      <option value="end_of_week">End of week</option>
                      <option value="end_of_month">End of month</option>
