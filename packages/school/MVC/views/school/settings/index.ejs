                <button class="btn btn-primary" type="submit" id="btnSaveAutosaveSettings">
                  <i class="bi bi-save me-1"></i>Save Autosave Settings
                </button>
              </div>
            <% } %>
          </form>
        </div>
      </section>

      <section class="school-settings-panel card border-0 shadow-sm" id="session-access" role="tabpanel" aria-labelledby="settings-tab-session-access" tabindex="0" hidden>
