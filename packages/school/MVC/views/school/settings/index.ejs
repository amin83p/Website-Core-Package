  });

  document.getElementById('timesheetParametersSettingsForm')?.addEventListener('submit', async event => {
    event.preventDefault();
    const button = document.getElementById('btnSaveTimesheetParametersSettings');
    if (!button) return;
    const selected = document.querySelector('input[name="emptyEnrollmentSessions"]:checked');
    const result = await postSettings('/school/settings/timesheet-parameters', {
      actionStateId: event.currentTarget.elements.actionStateId?.value || '',
      emptyEnrollmentSessions: selected?.value || 'hide',
      statutoryHolidayPayEnabled: document.getElementById('statutoryHolidayPayEnabled')?.checked ? 'true' : 'false',
      statutoryHolidayMinWorkdays: document.getElementById('statutoryHolidayMinWorkdays')?.value || '30',
      statutoryHolidayWeekdayOccurrencesRequired: document.getElementById('statutoryHolidayWeekdayOccurrencesRequired')?.value || '5',
      statutoryHolidayWeekdayOccurrencesLookback: document.getElementById('statutoryHolidayWeekdayOccurrencesLookback')?.value || '9',
      statutoryHolidayEarningsLookbackWeeks: document.getElementById('statutoryHolidayEarningsLookbackWeeks')?.value || '4',
      statutoryHolidayBeforeAfterSearchDays: document.getElementById('statutoryHolidayBeforeAfterSearchDays')?.value || '14',
      statutoryHolidayDisqualifyOnLeaveDuringHolidayWeek: document.getElementById('statutoryHolidayDisqualifyOnLeaveDuringHolidayWeek')?.checked ? 'true' : 'false',
      statutoryHolidayDisqualifyOnLeaveBeforeAfter: document.getElementById('statutoryHolidayDisqualifyOnLeaveBeforeAfter')?.checked ? 'true' : 'false',
      payableHolidayType_National_Holiday: document.getElementById('payableHolidayType_National_Holiday')?.checked ? 'true' : 'false',
      payableHolidayType_Observance_Paid: document.getElementById('payableHolidayType_Observance_Paid')?.checked ? 'true' : 'false'
    }, button, 'timesheetParametersSettingsError');
    if (!result) return;
    timesheetParametersPolicy = result.policy && typeof result.policy === 'object' ? result.policy : timesheetParametersPolicy;
    await showSettingsMessage({ title: 'Settings Saved', message: result.message, icon: 'success' });
