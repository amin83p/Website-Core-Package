<%- include('partials/tablePages-start', {
  title,
  newUrl,
  newLabel,
  user,
  tableName,
  btn_export: true,
  print: true,
  headerManageBtns: [
    '<a href="' + schoolSectionDashboardHref + '" class="school-navigator-dashboard btn btn-filled btn-secondary btn-md mb-2"><i class="bi bi-speedometer2 me-1"></i> School Dashboard</a>',
    '<a href="/dashboard/section-nav/SCHOOL_ACADEMIA" class="school-navigator-dashboard btn btn-filled btn-secondary btn-md mb-2"><i class="bi bi-backpack2 me-1"></i> School Academia</a>',
    '<a href="/school/teaching-outlines" class="btn btn-filled btn-secondary btn-md mb-2"><i class="bi bi-journal-check me-1"></i> Teaching Outlines</a>'
  ],
  manageBtns: []
}) %>

<%- include('partials/tablePages-search', {
  placeholder: 'Search teaching outline levels...',
  fields: [
    { name: 'isActive', label: 'Active', type: 'select', options: ['true', 'false'] },
    { name: 'levelKind', label: 'Kind', type: 'select', options: ['pre_clb', 'benchmark', 'extended', 'custom'] }
  ]
}) %>

<div class="table-scroll-wrapper" data-floating-row-actions="true">
  <table class="table-responsive size-md" id="first-table">
    <thead>
      <tr>
        <th class="draggable ps-4" data-column="sortOrder">Order</th>
        <th class="draggable" data-column="code">Code</th>
        <th class="draggable" data-column="title">Title</th>
        <th class="draggable" data-column="levelKind">Kind</th>
        <th class="draggable" data-column="matchAliases">Aliases</th>
        <th class="draggable" data-column="isActive">Active</th>
        <th class="text-end pe-4">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (!data || data.length === 0) { %>
        <tr><td colspan="7" class="text-center py-5 text-muted">No teaching outline levels found.</td></tr>
      <% } %>
      <% (data || []).forEach((item) => { %>
        <tr>
          <td class="ps-4"><%= Number(item.sortOrder || 0) %></td>
          <td>
            <div class="fw-bold font-monospace text-dark"><%= item.code %></div>
            <div class="x-small text-muted"><%= item.id %></div>
          </td>
          <td>
            <div class="fw-bold text-dark"><%= item.title %></div>
            <% if (item.shortTitle && item.shortTitle !== item.title) { %>
              <div class="small text-muted"><%= item.shortTitle %></div>
            <% } %>
            <% if (item.description) { %>
              <div class="small text-muted"><%= item.description %></div>
            <% } %>
          </td>
          <td>
            <span class="badge bg-light text-dark border text-uppercase"><%= item.levelKind || 'custom' %></span>
          </td>
          <td class="small text-muted">
            <%= Array.isArray(item.matchAliases) && item.matchAliases.length ? item.matchAliases.slice(0, 4).join(', ') + (item.matchAliases.length > 4 ? '…' : '') : '—' %>
          </td>
          <td>
            <span class="badge <%= item.isActive !== false ? 'bg-primary' : 'bg-danger' %>"><%= item.isActive !== false ? 'Active' : 'Inactive' %></span>
          </td>
          <td class="table-actions text-end pe-4">
            <div class="row-actions-wrap">
              <button
                type="button"
                class="btn btn-secondary btn-sm btn-row-actions-toggle"
                data-row-actions-id="<%= item.id %>"
                title="Level Actions">
                <i class="bi bi-three-dots-vertical"></i>
              </button>
              <div class="row-actions-menu d-none" data-row-actions-id="<%= item.id %>">
                <a href="/school/teaching-outlines/levels/edit/<%= item.id %>" class="btn btn-outline-primary btn-sm">
                  <i class="bi bi-pencil-square me-2"></i>Edit
                </a>
              </div>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<span id="urlRef" data-id="school/teaching-outlines/levels" hidden></span>

<%- include('partials/pagination', {
  pagination,
  filters,
  baseUrlPath: newUrl
}) %>

<%- include('partials/tablePages-end') %>
