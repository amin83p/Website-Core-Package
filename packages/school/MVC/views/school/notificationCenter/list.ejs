<% const canRemoveRunResults = typeof canRemoveRunResultsFlag === 'boolean'
  ? canRemoveRunResultsFlag === true
  : (access?.canDeleteRuns === true || access?.evaluations?.del?.adminBypass === true); %>

<%- include('partials/tablePages-start', {

  title,

  newUrl: 'school/notification-center',

  newHref: access?.canConfigure ? '/school/notification-center/rules/new' : null,

  newLabel: access?.canConfigure ? 'New rule' : null,

  user,

  tableName,

  btn_export: true,

  print: true,

  exportDataBaseUrl: 'school/notification-center',

  headerManageBtns: [

    '<a href="' + schoolSectionDashboardHref + '" class="school-navigator-dashboard btn btn-filled btn-secondary btn-md mb-2"><i class="bi bi-speedometer2 me-1"></i> School Dashboard</a>'

  ],

  manageBtns: access?.canViewRuns

    ? ['<a href="/school/notification-center/outbox" class="btn btn-outline-primary btn-md mb-2"><i class="bi bi-envelope-paper me-1"></i> Scheduled emails</a>']

    : [],

}) %>



<%- include('partials/tablePages-search', {

  placeholder: 'Search rules by label or type...'

}) %>



<div class="table-scroll-wrapper" data-floating-row-actions="true">

  <table class="table-responsive size-md" id="first-table">

    <thead>

      <tr>

        <th class="draggable ps-4" data-column="label">Label</th>

        <th class="draggable" data-column="ruleType">Type</th>

        <th class="draggable" data-column="enabled">Status</th>

        <th class="draggable" data-column="legacyKey">Source</th>

        <th class="text-end pe-4">Actions</th>

      </tr>

    </thead>

    <tbody>

      <% if (!data || data.length === 0) { %>

        <tr><td colspan="5" class="text-center py-5 text-muted">No rules found.<% if (access?.canConfigure) { %> Create a rule or save session notification settings to import the legacy rule.<% } %></td></tr>

      <% } %>

      <% (data || []).forEach((rule) => { %>
        <% const showRuleMetadata = access?.canViewRuleMetadata === true; %>

        <tr data-entity-row-id="<%= rule.id %>">

          <td class="ps-4">

            <% if (showRuleMetadata) { %>
            <div class="fw-semibold text-dark"><%= rule.label %></div>
            <% } else { %>
            <span class="text-muted">—</span>
            <% } %>

          </td>

          <td>
            <% if (showRuleMetadata) { %>
            <span class="text-dark"><%= typeof formatNotificationTokenLabel === 'function' ? formatNotificationTokenLabel(rule.ruleType) : rule.ruleType %></span>
            <% } else { %>
            <span class="text-muted">—</span>
            <% } %>
          </td>

          <td data-sort-value="<%= showRuleMetadata && rule.enabled ? '1' : '0' %>">

            <% if (showRuleMetadata) { %>
            <% if (rule.enabled) { %><span class="badge bg-success">Enabled</span><% } else { %><span class="badge bg-secondary">Paused</span><% } %>
            <% if (typeof isRuleOutsideActivityWindow === 'function' && isRuleOutsideActivityWindow(rule)) { %>
              <div class="x-small text-muted mt-1">Scheduled evaluation paused (outside activity date window)</div>
            <% } %>
            <% } else { %>
            <span class="text-muted">—</span>
            <% } %>

          </td>

          <td data-sort-value="<%= showRuleMetadata && rule.legacyKey ? 'legacy' : 'custom' %>">

            <% if (showRuleMetadata) { %>
            <% if (rule.legacyKey) { %><span class="badge bg-light text-muted border">Legacy sync</span><% } else { %><span class="text-muted small">Custom</span><% } %>
            <% } else { %>
            <span class="text-muted">—</span>
            <% } %>

          </td>

          <td class="table-actions text-end pe-4">

            <% if (access?.canConfigure || access?.canRunNow || canRemoveRunResults) { %>

            <div class="row-actions-wrap">

              <button type="button" class="btn btn-secondary btn-sm btn-row-actions-toggle" data-row-actions-id="<%= rule.id %>" title="Rule actions">

                <i class="bi bi-three-dots-vertical"></i>

              </button>

              <div class="row-actions-menu d-none" data-row-actions-id="<%= rule.id %>">

                <% if (access?.canConfigure) { %>

                  <a href="/school/notification-center/rules/<%= rule.id %>" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil-square me-2"></i>Edit</a>

                <% } %>

                <% if (access?.canRunNow) { %>

                  <form method="post" action="/school/notification-center/rules/<%= rule.id %>/run" class="d-inline js-nc-run-rule-form">

                    <button type="submit" class="btn btn-outline-secondary btn-sm"><i class="bi bi-play-fill me-2"></i>Run now</button>

                  </form>

                <% } %>

                <% if (canRemoveRunResults) { %>

                  <button type="button" class="btn btn-outline-danger btn-sm js-nc-delete-rule-runs" data-rule-id="<%= rule.id %>" data-rule-label="<%= rule.label || rule.ruleType || 'rule' %>">

                    <i class="bi bi-trash me-2"></i>Delete run results

                  </button>

                <% } %>

              </div>

            </div>

            <% } %>

          </td>

        </tr>

      <% }) %>

    </tbody>

  </table>

</div>



<%- include('partials/pagination', {

  pagination,

  filters,

  baseUrlPath: newUrl

}) %>



<div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mt-4 mb-2">

  <div>

    <h2 class="h5 fw-bold text-dark mb-0"><i class="bi bi-clock-history me-2"></i>Recent run results</h2>

    <p class="small text-muted mb-0">Stored results from <strong>Run now</strong> and scheduled rule evaluation. Open a row to review findings, or select runs to delete them.</p>

  </div>

  <% if (canRemoveRunResults && (runs || []).length) { %>

    <button type="button" class="btn btn-outline-danger btn-sm" id="ncDeleteSelectedRuns" disabled>

      <i class="bi bi-trash me-1"></i> Delete selected runs

    </button>

  <% } %>

</div>

<div class="table-scroll-wrapper mt-2" data-floating-row-actions="true">

  <table class="table-responsive size-md" id="nc-recent-runs-table">

    <thead>

      <tr>

        <% if (canRemoveRunResults) { %>

          <th class="text-center" style="width:2.75rem;" title="Select run results to delete">

            <input type="checkbox" class="form-check-input mt-0" id="ncRecentRunsSelectAll" aria-label="Select all recent run results">

          </th>

        <% } %>

        <th class="ps-4 text-center" data-column="review" style="width:3rem;">Review</th>

        <th class="draggable" data-column="ruleLabel">Run <span class="sort-icon"></span></th>

        <th class="draggable" data-column="status">Status <span class="sort-icon"></span></th>

        <th class="draggable" data-column="batchCount">Batches <span class="sort-icon"></span></th>

        <th class="draggable" data-column="findingCount">Findings <span class="sort-icon"></span></th>

        <th class="draggable" data-column="startedAt">Started <span class="sort-icon"></span></th>

        <th class="text-end pe-4">Actions</th>

      </tr>

    </thead>

    <tbody>

      <% if (!access?.canViewRuns) { %>

        <tr data-nc-runs-locked="1"><td colspan="<%= canRemoveRunResults ? 8 : 7 %>" class="text-center py-4 text-muted">You need READ_ALL access to view recent run results.</td></tr>

      <% } else if (!(runs || []).length) { %>

        <tr data-nc-empty-runs="1"><td colspan="<%= canRemoveRunResults ? 8 : 7 %>" class="text-center py-4 text-muted">No run results yet.</td></tr>

      <% } else { %>

        <% (runs || []).forEach((run) => {

          const runHref = '/school/notification-center/runs/' + encodeURIComponent(run.id);

          const viewed = typeof isRunViewedByUser === 'function' ? isRunViewedByUser(run, user) : false;

        %>

          <tr class="nc-run-row" data-run-href="<%= runHref %>" data-run-id="<%= run.id %>" data-rule-id="<%= run.ruleId || '' %>">

            <% if (canRemoveRunResults) { %>

              <td class="text-center js-nc-run-select-wrap" data-sort-value="">

                <input type="checkbox" class="form-check-input mt-0 js-nc-run-select" value="<%= run.id %>" aria-label="Select run result for <%= run.ruleLabel || run.ruleType || 'delete' %>">

              </td>

            <% } %>

            <td class="ps-4 text-center" data-sort-value="<%= viewed ? '1' : '0' %>">

              <% if (viewed) { %>

                <i class="bi bi-envelope-open text-success" title="Opened"></i>

              <% } else { %>

                <i class="bi bi-envelope-fill text-primary" title="Not opened yet"></i>

              <% } %>

            </td>

            <td data-sort-value="<%= run.ruleLabel || run.ruleType || '' %>">

              <a href="<%= runHref %>" class="fw-semibold text-dark text-decoration-none"><%= run.ruleLabel || run.ruleType %></a>

            </td>

            <td data-sort-value="<%= run.status || '' %>"><span class="badge bg-light text-dark border"><%= typeof formatNotificationTokenLabel === 'function' ? formatNotificationTokenLabel(run.status) : run.status %></span></td>

            <td data-sort-value="<%= run.batchCount || 0 %>"><%= run.batchCount || 0 %></td>

            <td data-sort-value="<%= run.findingCount || 0 %>"><%= run.findingCount || 0 %></td>

            <td data-sort-value="<%= run.startedAt || '' %>"><%= run.startedAt ? (typeof formatOrgDateTime === 'function' ? formatOrgDateTime(run.startedAt) : run.startedAt) : '—' %></td>

            <td class="table-actions text-end pe-4">

              <% if (access?.canViewRuns || canRemoveRunResults) { %>

              <div class="row-actions-wrap">

                <button type="button" class="btn btn-secondary btn-sm btn-row-actions-toggle" data-row-actions-id="run-<%= run.id %>" title="Run actions">

                  <i class="bi bi-three-dots-vertical"></i>

                </button>

                <div class="row-actions-menu d-none" data-row-actions-id="run-<%= run.id %>">

                  <% if (access?.canViewRuns) { %>

                    <a href="<%= runHref %>" class="btn btn-outline-primary btn-sm"><i class="bi bi-eye me-2"></i>View</a>

                  <% } %>

                  <% if (canRemoveRunResults) { %>

                    <form method="post" action="/school/notification-center/runs/<%= run.id %>/delete" class="d-inline js-nc-delete-run-form">

                      <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash me-2"></i>Delete</button>

                    </form>

                  <% } %>

                </div>

              </div>

              <% } %>

            </td>

          </tr>

        <% }); %>

      <% } %>

    </tbody>

    </table>

  </div>



<script src="<%= typeof staticAssetUrl === 'function' ? staticAssetUrl('/scripts/table-draggable-sort.js') : '/scripts/table-draggable-sort.js' %>"></script>

<%- include('school/notificationCenter/partials/runRuleLoadingScript') %>

<script>

(function () {

  function resolveCsrfToken() {

    return document.querySelector('meta[name="csrf-token"]')?.content || '';

  }

  function ensureRecentRunsEmptyState(tbody) {

    if (!tbody) return;

    if (tbody.querySelector('tr.nc-run-row')) return;

    if (tbody.querySelector('tr[data-nc-empty-runs]')) return;

    const table = tbody.closest('#nc-recent-runs-table');

    const colspan = table?.querySelector('th #ncRecentRunsSelectAll') ? 8 : 7;

    const row = document.createElement('tr');

    row.setAttribute('data-nc-empty-runs', '1');

    row.innerHTML = `<td colspan="${colspan}" class="text-center py-4 text-muted">No run results yet.</td>`;

    tbody.appendChild(row);

  }

  function resolveCsrfHeaders() {

    const csrfToken = resolveCsrfToken();

    const headers = {

      Accept: 'application/json',

      'X-AJAX-Request': '1'

    };

    if (csrfToken) {

      headers['x-csrf-token'] = csrfToken;

      headers['csrf-token'] = csrfToken;

    }

    return headers;

  }

  async function deleteNotificationRunByUrl(deleteUrl, row) {

    const response = await fetch(deleteUrl, {

      method: 'POST',

      headers: resolveCsrfHeaders(),

      credentials: 'same-origin'

    });

    const payload = await response.json().catch(() => ({}));

    if (!response.ok || payload.status !== 'ok') {

      throw new Error(payload.message || 'Could not delete this run.');

    }

    if (row) row.remove();

  }

  function syncNcRecentRunsBulkUi() {

    const tbody = document.querySelector('#nc-recent-runs-table tbody');

    const selectAll = document.getElementById('ncRecentRunsSelectAll');

    const deleteBtn = document.getElementById('ncDeleteSelectedRuns');

    const boxes = tbody ? Array.from(tbody.querySelectorAll('.js-nc-run-select')) : [];

    const checked = boxes.filter((box) => box.checked);

    if (deleteBtn) {

      deleteBtn.disabled = checked.length === 0;

    }

    if (selectAll) {

      selectAll.disabled = boxes.length === 0;

      selectAll.checked = boxes.length > 0 && checked.length === boxes.length;

      selectAll.indeterminate = checked.length > 0 && checked.length < boxes.length;

    }

  }

  document.getElementById('ncRecentRunsSelectAll')?.addEventListener('change', (event) => {

    const checked = event.target.checked;

    document.querySelectorAll('#nc-recent-runs-table .js-nc-run-select').forEach((box) => {

      box.checked = checked;

    });

    syncNcRecentRunsBulkUi();

  });

  document.querySelectorAll('.js-nc-run-select').forEach((box) => {

    box.addEventListener('change', () => syncNcRecentRunsBulkUi());

    box.addEventListener('click', (event) => event.stopPropagation());

  });

  document.querySelectorAll('.js-nc-run-select-wrap').forEach((cell) => {

    cell.addEventListener('click', (event) => event.stopPropagation());

  });

  document.getElementById('ncDeleteSelectedRuns')?.addEventListener('click', async () => {

    const selected = Array.from(document.querySelectorAll('#nc-recent-runs-table .js-nc-run-select:checked'));

    if (!selected.length) return;

    const choice = await showMessageModal({

      title: 'Delete runs',

      icon: 'warning',

      message: `Delete ${selected.length} selected notification run(s)? This cannot be undone.`,

      size: 'md',

      buttons: [

        { text: 'Cancel', class: 'btn-secondary btn-md' },

        { text: 'Delete', class: 'btn-danger btn-md' }

      ]

    });

    if (choice !== 'Delete') return;

    const deleteBtn = document.getElementById('ncDeleteSelectedRuns');

    if (deleteBtn) deleteBtn.disabled = true;

    const tbody = document.querySelector('#nc-recent-runs-table tbody');

    const failures = [];

    for (const box of selected) {

      const runId = String(box.value || '').trim();

      const row = box.closest('tr.nc-run-row');

      const deleteUrl = `/school/notification-center/runs/${encodeURIComponent(runId)}/delete`;

      try {

        await deleteNotificationRunByUrl(deleteUrl, row);

      } catch (error) {

        failures.push(error?.message || runId);

      }

    }

    ensureRecentRunsEmptyState(tbody);

    syncNcRecentRunsBulkUi();

    if (failures.length) {

      await showMessageModal({

        title: 'Some deletes failed',

        message: failures.slice(0, 5).join('\n'),

        icon: 'error',

        size: 'md'

      });

    }

  });

  syncNcRecentRunsBulkUi();

  document.querySelectorAll('.js-nc-delete-rule-runs').forEach((button) => {

    button.addEventListener('click', async () => {

      const ruleId = String(button.getAttribute('data-rule-id') || '').trim();

      const ruleLabel = String(button.getAttribute('data-rule-label') || '').trim() || 'this rule';

      const runRows = ruleId

        ? Array.from(document.querySelectorAll(`tr.nc-run-row[data-rule-id="${ruleId}"]`))

        : [];

      if (!runRows.length) {

        await showMessageModal({

          title: 'No run results',

          message: `There are no recent run results listed for “${ruleLabel}”. Scroll to Recent run results or run the rule again.`,

          icon: 'info',

          size: 'md'

        });

        return;

      }

      const choice = await showMessageModal({

        title: 'Delete run results',

        icon: 'warning',

        message: `Delete ${runRows.length} recent run result(s) for “${ruleLabel}”? This cannot be undone.`,

        size: 'md',

        buttons: [

          { text: 'Cancel', class: 'btn-secondary btn-md' },

          { text: 'Delete', class: 'btn-danger btn-md' }

        ]

      });

      if (choice !== 'Delete') return;

      const tbody = document.querySelector('#nc-recent-runs-table tbody');

      const failures = [];

      for (const row of runRows) {

        const runId = String(row.getAttribute('data-run-id') || '').trim();

        if (!runId) continue;

        try {

          await deleteNotificationRunByUrl(`/school/notification-center/runs/${encodeURIComponent(runId)}/delete`, row);

        } catch (error) {

          failures.push(error?.message || runId);

        }

      }

      ensureRecentRunsEmptyState(tbody);

      syncNcRecentRunsBulkUi();

      if (failures.length) {

        await showMessageModal({

          title: 'Some deletes failed',

          message: failures.slice(0, 5).join('\n'),

          icon: 'error',

          size: 'md'

        });

      }

    });

  });

  document.querySelectorAll('.js-nc-delete-run-form').forEach((form) => {

    if (form.dataset.ncDeleteBound === '1') return;

    form.dataset.ncDeleteBound = '1';

    form.addEventListener('submit', async (event) => {

      event.preventDefault();

      const choice = await showMessageModal({

        title: 'Delete run',

        icon: 'warning',

        message: 'Delete this notification run? This cannot be undone.',

        size: 'md',

        buttons: [

          { text: 'Cancel', class: 'btn-secondary btn-md' },

          { text: 'Delete', class: 'btn-danger btn-md' }

        ]

      });

      if (choice !== 'Delete') return;

      const row = form.closest('tr.nc-run-row');

      const tbody = row?.closest('tbody');

      const submitButton = form.querySelector('button[type="submit"]');

      if (submitButton) submitButton.disabled = true;

      try {

        await deleteNotificationRunByUrl(form.action, row);

        ensureRecentRunsEmptyState(tbody);

        syncNcRecentRunsBulkUi();

      } catch (error) {

        const message = error?.message || 'Could not delete this run.';

        await showMessageModal({ title: 'Delete failed', message, icon: 'error', size: 'md' });

      } finally {

        if (submitButton) submitButton.disabled = false;

      }

    });

  });



  const runsTable = document.getElementById('nc-recent-runs-table');

  if (runsTable && typeof window.initDraggableTableSort === 'function') {

    window.initDraggableTableSort(runsTable, { enableColumnReorder: false });

  }



  document.querySelectorAll('tr.nc-run-row[data-run-href]').forEach((row) => {

    row.addEventListener('click', (event) => {

      if (event.target.closest('a, button, form, .row-actions-wrap, .js-nc-run-select-wrap')) return;

      const href = row.getAttribute('data-run-href');

      if (href) window.location.href = href;

    });

    row.style.cursor = 'pointer';

  });

})();

</script>



<%- include('partials/tablePages-end') %>


