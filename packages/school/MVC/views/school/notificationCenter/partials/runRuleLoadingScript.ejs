<script>
(function initNotificationCenterRunRuleLoading() {
  document.querySelectorAll('.js-nc-run-rule-form').forEach((form) => {
    if (form.dataset.ncRunBound === '1') return;
    form.dataset.ncRunBound = '1';
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (window.NotificationCenterRunRule?.runRuleAndRedirect) {
        await window.NotificationCenterRunRule.runRuleAndRedirect(form.action);
        return;
      }
      form.submit();
    });
  });
})();
</script>
