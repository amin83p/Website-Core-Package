<%
  const panelPrefix = typeof schedulePanelPrefix !== 'undefined' ? schedulePanelPrefix : 'ncCompose';
  const sendAtValue = typeof scheduleSendAtValue !== 'undefined' ? scheduleSendAtValue : '';
  const tzHint = typeof scheduleTimeZoneHint !== 'undefined' ? scheduleTimeZoneHint : '';
%>
<div class="nc-schedule-send-panel border rounded-3 p-3 mb-3 bg-white flex-shrink-0" id="<%= panelPrefix %>SchedulePanel" data-schedule-panel="<%= panelPrefix %>">
  <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-2">
    <div class="small" id="<%= panelPrefix %>ScheduleSummary" role="status" aria-live="polite">
      Choose a send date and time below.
    </div>
    <button type="button" class="btn btn-outline-primary btn-sm" id="<%= panelPrefix %>SendNowBtn">
      <i class="bi bi-send me-1"></i>Send now
    </button>
  </div>
  <div class="row g-2 align-items-end">
    <div class="col-md-7">
      <label class="form-label fw-bold small mb-1" for="<%= panelPrefix %>SendAt">
        <i class="bi bi-calendar-event me-1 text-primary"></i>Send at
      </label>
      <input
        class="form-control size-md"
        type="datetime-local"
        id="<%= panelPrefix %>SendAt"
        name="sendAtLocal"
        value="<%= sendAtValue %>"
        required
      >
    </div>
    <div class="col-md-5">
      <div class="form-text small mb-0" id="<%= panelPrefix %>TimeZoneHint"><%= tzHint %></div>
    </div>
  </div>
  <input type="hidden" name="sendNow" id="<%= panelPrefix %>SendNow" value="">
</div>
<style>
  .nc-schedule-send-panel.nc-schedule-send-immediate {
    border-color: rgba(var(--bs-primary-rgb), 0.45);
    background: rgba(var(--bs-primary-rgb), 0.06);
  }
</style>
