<%
  const row = rule || {};
  const editing = typeof isEdit !== 'undefined' ? isEdit === true : !!row.id;
  const asid = (typeof actionStateId !== 'undefined' && actionStateId) ? actionStateId : '';
  const formatLabel = typeof formatNotificationTokenLabel === 'function'
    ? formatNotificationTokenLabel
    : (value) => String(value || '');
  const dateRangeTypes = Array.isArray(sessionDateRangeTypes) && sessionDateRangeTypes.length
    ? sessionDateRangeTypes
    : ['this_week', 'two_weeks', 'this_month', 'days_before_today', 'timesheet_period'];
  const types = Array.isArray(ruleTypes) && ruleTypes.length ? ruleTypes : [];
  const weekdayLabels = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
  let selectedDays = Array.isArray(row.schedule?.daysOfWeek) ? row.schedule.daysOfWeek.map((d) => Number(d)) : [];
  if (row.schedule?.scheduleEnabled === true && !selectedDays.length) {
    selectedDays = [0, 1, 2, 3, 4, 5, 6];
  }
  const selectedSet = new Set(selectedDays.filter((d) => Number.isFinite(d)));
%>

<div class="sections-page">
  <div class="d-flex align-items-center justify-content-between mb-4">
    <div>
      <h1 class="page-heading size-md m-0"><%= editing ? 'Edit Notification Rule' : 'New Notification Rule' %></h1>
      <% if (row.label) { %>
        <div class="text-muted small mt-1"><%= row.label %></div>
      <% } %>
    </div>
    <div class="d-flex flex-column align-items-end gap-1">
      <% if (editing && row.id) { %>
        <span class="badge bg-primary border font-monospace">ID: <%= row.id %></span>
      <% } %>
      <a href="/school/notification-center" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
    </div>
  </div>

  <div class="form-container wide" style="max-width: 1400px;">
    <form id="notificationRuleForm" method="post" action="/school/notification-center/rules/save">
      <input type="hidden" name="actionStateId" value="<%= asid %>">
      <input type="hidden" name="rule[id]" value="<%= row.id || '' %>">
      <input type="hidden" name="rule[schedule][autoQueueOnSchedule]" value="false">

      <ul class="nav nav-tabs mb-4" id="notificationRuleTabs" role="tablist">
        <li class="nav-item" role="presentation">
          <button class="nav-link active" type="button" data-bs-toggle="tab" data-bs-target="#tab-nc-general" role="tab" aria-controls="tab-nc-general" aria-selected="true">General</button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" type="button" data-bs-toggle="tab" data-bs-target="#tab-nc-schedule" role="tab" aria-controls="tab-nc-schedule" aria-selected="false">Schedule</button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" type="button" data-bs-toggle="tab" data-bs-target="#tab-nc-criteria" role="tab" aria-controls="tab-nc-criteria" aria-selected="false">Criteria</button>
        </li>
      </ul>

      <div class="tab-content">
        <div class="tab-pane fade show active" id="tab-nc-general" role="tabpanel">
          <p class="small text-muted mb-3">Define the rule label and type. Saved rules control what is found when you run them manually or on a schedule. Email is only sent after you review a run and schedule mail.</p>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label" for="ruleLabel">Label *</label>
              <input class="form-control size-md" id="ruleLabel" name="rule[label]" value="<%= row.label || '' %>" placeholder="e.g. Weekly session finalization reminders" required>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label" for="ruleType">Rule type *</label>
              <select class="form-select size-md" id="ruleType" name="rule[ruleType]" <%= row.legacyKey ? 'disabled' : '' %>>
                <% types.forEach((type) => { %>
                  <option value="<%= type %>" <%= row.ruleType === type ? 'selected' : '' %>><%= formatLabel(type) %></option>
                <% }); %>
              </select>
              <% if (row.legacyKey) { %>
                <input type="hidden" name="rule[ruleType]" value="<%= row.ruleType %>">
                <div class="form-text small">Legacy session rule type is managed from School Settings.</div>
              <% } %>
            </div>
          </div>

          <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
              <h6 class="fw-bold text-primary m-0 mb-3"><i class="bi bi-toggle-on me-1"></i>Rule status</h6>
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="ruleEnabled" name="rule[enabled]" value="true" <%= row.enabled !== false ? 'checked' : '' %>>
                <label class="form-check-label" for="ruleEnabled">Enabled</label>
              </div>
              <div class="form-text small">Paused rules cannot be run from Notification Centre.</div>
            </div>
          </div>

          <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
              <h6 class="fw-bold text-primary m-0 mb-3"><i class="bi bi-envelope-paper me-1"></i>Email compose</h6>
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="emailChannelEnabled" name="rule[channels][email][enabled]" value="true" <%= row.channels?.email?.enabled !== false ? 'checked' : '' %>>
                <label class="form-check-label" for="emailChannelEnabled">Allow email scheduling</label>
              </div>
              <div class="form-text small">When enabled, operators can schedule emails from run results. Send time is chosen when you compose mail after reviewing a run.</div>
            </div>
          </div>
        </div>

        <div class="tab-pane fade" id="tab-nc-schedule" role="tabpanel">
          <p class="small text-muted mb-3">Optional scheduled runs create a Scheduled Tasks entry. Run time uses your organization timezone (same as uncompleted session notifications in School Settings).</p>

          <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
              <h6 class="fw-bold text-primary m-0 mb-3"><i class="bi bi-alarm me-1"></i>Scheduled evaluation</h6>
              <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" role="switch" id="scheduleEnabled" name="rule[schedule][scheduleEnabled]" value="true" <%= row.schedule?.scheduleEnabled === true ? 'checked' : '' %>>
                <label class="form-check-label" for="scheduleEnabled">Enable scheduled evaluation</label>
              </div>
              <div class="form-text small mb-3">Preview results are stored for later review; email is still scheduled manually from a run. Pause or cancel the linked scheduled task, or disable this rule, to stop automatic runs.</div>
              <div class="row g-3">
                <div class="col-md-4">
                  <label class="form-label" for="scheduleRunAtTime">Run at time</label>
                  <input class="form-control size-md" type="time" id="scheduleRunAtTime" name="rule[schedule][runAtTime]" value="<%= row.schedule?.runAtTime || '08:00' %>">
                </div>
                <div class="col-12">
                  <label class="form-label d-block">Weekdays</label>
                  <div class="d-flex flex-wrap gap-2" id="ncScheduleWeekdays">
                    <% weekdayLabels.forEach((label, idx) => { %>
                      <label class="btn btn-outline-secondary btn-sm nc-weekday-toggle <%= selectedSet.has(idx) ? 'active' : '' %>">
                        <input type="checkbox" class="d-none nc-weekday-input" name="rule[schedule][daysOfWeek][]" value="<%= idx %>" <%= selectedSet.has(idx) ? 'checked' : '' %>>
                        <%= label %>
                      </label>
                    <% }); %>
                  </div>
                  <div class="form-text small">Select at least one day when scheduled evaluation is enabled.</div>
                </div>
              </div>
            </div>
          </div>

          <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
              <h6 class="fw-bold text-primary m-0 mb-3"><i class="bi bi-calendar-event me-1"></i>Activity date window</h6>
              <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" role="switch" id="activityDateWindowEnabled" name="rule[activityDateWindow][enabled]" value="true" <%= row.activityDateWindow?.enabled === true ? 'checked' : '' %>>
                <label class="form-check-label" for="activityDateWindowEnabled">Limit scheduled evaluation to a date range</label>
              </div>
              <div class="form-text small mb-3">When enabled, scheduled evaluation runs only between the start and end dates (organization calendar). Manual <strong>Run now</strong> is not limited by this window.</div>
              <div class="row g-3" id="activityDateWindowFields">
                <div class="col-md-6">
                  <label class="form-label" for="activityDateWindowStart">Start date</label>
                  <input class="form-control size-md" type="date" id="activityDateWindowStart" name="rule[activityDateWindow][startDate]" value="<%= row.activityDateWindow?.startDate || '' %>">
                </div>
                <div class="col-md-6">
                  <label class="form-label" for="activityDateWindowEnd">End date</label>
                  <input class="form-control size-md" type="date" id="activityDateWindowEnd" name="rule[activityDateWindow][endDate]" value="<%= row.activityDateWindow?.endDate || '' %>">
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="tab-pane fade" id="tab-nc-criteria" role="tabpanel">
          <p class="small text-muted mb-3">Limit which sessions or periods are included when the rule runs.</p>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label" for="sessionDateRange">Session date range</label>
              <select class="form-select size-md" id="sessionDateRange" name="rule[criteria][sessionDateRange][type]">
                <% dateRangeTypes.forEach((opt) => { %>
                  <option value="<%= opt %>" <%= (row.criteria?.sessionDateRange?.type || 'this_week') === opt ? 'selected' : '' %>><%= formatLabel(opt) %></option>
                <% }); %>
              </select>
            </div>
          </div>
        </div>
      </div>

      <div class="button-row mt-4 pt-3 border-top">
        <button type="submit" class="btn btn-filled btn-primary btn-md"><%= editing ? 'Save Changes' : 'Create Rule' %></button>
        <a href="/school/notification-center" class="btn btn-filled btn-secondary btn-md">Cancel</a>
      </div>
    </form>
  </div>
</div>

<script>
(function () {
  const form = document.getElementById('notificationRuleForm');
  const enabled = document.getElementById('scheduleEnabled');
  const weekdayWrap = document.getElementById('ncScheduleWeekdays');
  if (form && enabled && weekdayWrap) {
    weekdayWrap.querySelectorAll('.nc-weekday-toggle').forEach((label) => {
      label.addEventListener('click', (event) => {
        event.preventDefault();
        const input = label.querySelector('.nc-weekday-input');
        if (!input) return;
        input.checked = !input.checked;
        label.classList.toggle('active', input.checked);
      });
    });

    form.addEventListener('submit', (event) => {
      if (!enabled.checked) return;
      const checked = weekdayWrap.querySelectorAll('.nc-weekday-input:checked');
      if (!checked.length) {
        event.preventDefault();
        const scheduleTab = document.querySelector('#notificationRuleTabs [data-bs-target="#tab-nc-schedule"]');
        if (scheduleTab && typeof bootstrap !== 'undefined') bootstrap.Tab.getOrCreateInstance(scheduleTab).show();
        showMessageModal({
          title: 'Weekdays required',
          message: 'Select at least one weekday for scheduled evaluation.',
          icon: 'warning',
          size: 'md'
        });
      }
    });
  }

  const windowEnabled = document.getElementById('activityDateWindowEnabled');
  const startInput = document.getElementById('activityDateWindowStart');
  const endInput = document.getElementById('activityDateWindowEnd');
  if (form && windowEnabled && startInput && endInput) {
    function refreshActivityWindowFields() {
      const on = windowEnabled.checked;
      startInput.disabled = !on;
      endInput.disabled = !on;
      startInput.required = on;
      endInput.required = on;
    }

    windowEnabled.addEventListener('change', refreshActivityWindowFields);
    refreshActivityWindowFields();

    form.addEventListener('submit', (event) => {
      if (!windowEnabled.checked) return;
      const start = String(startInput.value || '').trim();
      const end = String(endInput.value || '').trim();
      if (!start || !end) {
        event.preventDefault();
        const scheduleTab = document.querySelector('#notificationRuleTabs [data-bs-target="#tab-nc-schedule"]');
        if (scheduleTab && typeof bootstrap !== 'undefined') bootstrap.Tab.getOrCreateInstance(scheduleTab).show();
        showMessageModal({
          title: 'Dates required',
          message: 'Enter both start and end dates for the activity date window.',
          icon: 'warning',
          size: 'md'
        });
        return;
      }
      if (start > end) {
        event.preventDefault();
        const scheduleTab = document.querySelector('#notificationRuleTabs [data-bs-target="#tab-nc-schedule"]');
        if (scheduleTab && typeof bootstrap !== 'undefined') bootstrap.Tab.getOrCreateInstance(scheduleTab).show();
        showMessageModal({
          title: 'Invalid date range',
          message: 'Activity date window start date must be on or before the end date.',
          icon: 'warning',
          size: 'md'
        });
      }
    });
  }
})();
</script>
