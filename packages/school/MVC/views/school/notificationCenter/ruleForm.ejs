<%
  const row = rule || {};
  const editing = typeof isEdit !== 'undefined' ? isEdit === true : !!row.id;
  const asid = (typeof actionStateId !== 'undefined' && actionStateId) ? actionStateId : '';
  const formatLabel = typeof formatNotificationTokenLabel === 'function'
    ? formatNotificationTokenLabel
    : (value) => String(value || '');
  const dateRangeTypes = Array.isArray(sessionDateRangeTypes) && sessionDateRangeTypes.length
    ? sessionDateRangeTypes
    : ['this_week', 'two_weeks', 'this_month', 'days_before_today', 'timesheet_period'];
  const types = Array.isArray(ruleTypes) && ruleTypes.length ? ruleTypes : [];
  const weekdayLabels = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
  let selectedDays = Array.isArray(row.schedule?.daysOfWeek) ? row.schedule.daysOfWeek.map((d) => Number(d)) : [];
  if (row.schedule?.scheduleEnabled === true && !selectedDays.length) {
    selectedDays = [0, 1, 2, 3, 4, 5, 6];
  }
  const selectedSet = new Set(selectedDays.filter((d) => Number.isFinite(d)));
  const emailCh = row.channels?.email && typeof row.channels.email === 'object' ? row.channels.email : {};
  const smsCh = row.channels?.sms && typeof row.channels.sms === 'object' ? row.channels.sms : {};
  const emailBodyMode = String(emailCh.emailBodyMode || 'html').toLowerCase() === 'plain' ? 'plain' : 'html';
  const placeholderRows = Array.isArray(emailComposePlaceholders) ? emailComposePlaceholders : [];
  const deliveryTz = typeof orgTimeZone !== 'undefined' && orgTimeZone ? orgTimeZone : 'UTC';
  const timingModes = Array.isArray(notificationTimingModes) && notificationTimingModes.length
    ? notificationTimingModes
    : ['same_day', 'next_day', 'daily_digest'];
  let timingMode = row.criteria?.notificationTiming?.mode || '';
  if (!timingMode) {
    const sw = String(emailCh.sendWhen || '').toLowerCase();
    timingMode = sw === 'daily_all' ? 'daily_digest' : (sw || 'daily_digest');
  }
  timingMode = timingModes.includes(timingMode) ? timingMode : 'daily_digest';
  const sessionRangeType = row.criteria?.sessionDateRange?.type || 'this_week';
  const daysBeforeToday = row.criteria?.sessionDateRange?.daysBeforeToday ?? '';
  const managerSummaryCfg = row.managerSummary && typeof row.managerSummary === 'object' ? row.managerSummary : {};
%>

<div class="sections-page">
  <div class="d-flex align-items-center justify-content-between mb-4">
    <div>
      <h1 class="page-heading size-md m-0"><%= editing ? 'Edit Notification Rule' : 'New Notification Rule' %></h1>
      <% if (row.label) { %>
        <div class="text-muted small mt-1"><%= row.label %></div>
      <% } %>
    </div>
    <div class="d-flex flex-column align-items-end gap-1">
      <% if (editing && row.id) { %>
        <span class="badge bg-primary border font-monospace">ID: <%= row.id %></span>
      <% } %>
      <a href="/school/notification-center" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
    </div>
  </div>

  <div class="form-container wide" style="max-width: 1400px;">
    <form id="notificationRuleForm" method="post" action="/school/notification-center/rules/save">
      <input type="hidden" name="actionStateId" value="<%= asid %>">
      <input type="hidden" name="rule[id]" value="<%= row.id || '' %>">

      <ul class="nav nav-tabs mb-4" id="notificationRuleTabs" role="tablist">
        <li class="nav-item" role="presentation">
          <button class="nav-link active" type="button" data-bs-toggle="tab" data-bs-target="#tab-nc-general" role="tab" aria-controls="tab-nc-general" aria-selected="true">General</button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" type="button" data-bs-toggle="tab" data-bs-target="#tab-nc-delivery" role="tab" aria-controls="tab-nc-delivery" aria-selected="false">Delivery</button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" type="button" data-bs-toggle="tab" data-bs-target="#tab-nc-schedule" role="tab" aria-controls="tab-nc-schedule" aria-selected="false">Schedule</button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" type="button" data-bs-toggle="tab" data-bs-target="#tab-nc-criteria" role="tab" aria-controls="tab-nc-criteria" aria-selected="false">Criteria</button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" type="button" data-bs-toggle="tab" data-bs-target="#tab-nc-managers" role="tab" aria-controls="tab-nc-managers" aria-selected="false">Managers</button>
        </li>
      </ul>

      <div class="tab-content">
        <div class="tab-pane fade show active" id="tab-nc-general" role="tabpanel">
          <p class="small text-muted mb-3">Define the rule label and type. Use the <strong>Delivery</strong> tab for outbound channels and send times; use <strong>Email templates</strong> below for optional message copy.</p>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label" for="ruleLabel">Label *</label>
              <input class="form-control size-md" id="ruleLabel" name="rule[label]" value="<%= row.label || '' %>" placeholder="e.g. Weekly session finalization reminders" required>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label" for="ruleType">Rule type *</label>
              <select class="form-select size-md" id="ruleType" name="rule[ruleType]" <%= row.legacyKey ? 'disabled' : '' %>>
                <% types.forEach((type) => { %>
                  <option value="<%= type %>" <%= row.ruleType === type ? 'selected' : '' %>><%= formatLabel(type) %></option>
                <% }); %>
              </select>
              <% if (row.legacyKey) { %>
                <input type="hidden" name="rule[ruleType]" value="<%= row.ruleType %>">
                <div class="form-text small">Legacy session rule type is managed from School Settings.</div>
              <% } %>
            </div>
          </div>

          <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
              <h6 class="fw-bold text-primary m-0 mb-3"><i class="bi bi-toggle-on me-1"></i>Rule status</h6>
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="ruleEnabled" name="rule[enabled]" value="true" <%= row.enabled !== false ? 'checked' : '' %>>
                <label class="form-check-label" for="ruleEnabled">Enabled</label>
              </div>
              <div class="form-text small">Paused rules cannot be run from Notification Centre.</div>
            </div>
          </div>

          <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
              <h6 class="fw-bold text-primary m-0 mb-3"><i class="bi bi-envelope-paper me-1"></i>Email templates</h6>
              <p class="small text-muted mb-2">Optional templates use <code>{{TOKEN}}</code> placeholders. Leave blank to use built-in copy for the selected rule type (for example, book covering wording for sessions without a submitted book report).</p>
              <div class="mb-3">
                <label class="form-label" for="emailSubjectTemplate">Subject template</label>
                <input class="form-control font-monospace size-md" type="text" id="emailSubjectTemplate" name="rule[channels][email][subjectTemplate]" value="<%= emailCh.subjectTemplate || '' %>" maxlength="500" placeholder="{{RULE_LABEL}} ({{ITEM_COUNT}} item(s))">
              </div>
              <div class="mb-3">
                <label class="form-label" for="emailBodyTextTemplate">Plain body template</label>
                <textarea class="form-control font-monospace size-md" id="emailBodyTextTemplate" name="rule[channels][email][bodyTextTemplate]" rows="8" maxlength="20000" placeholder="Hi {{TEACHER_NAME}},&#10;&#10;{{SESSION_LIST}}"><%= emailCh.bodyTextTemplate || '' %></textarea>
              </div>
              <div class="mb-3">
                <label class="form-label" for="emailBodyHtmlTemplate">HTML body template</label>
                <textarea class="form-control font-monospace size-md" id="emailBodyHtmlTemplate" name="rule[channels][email][bodyHtmlTemplate]" rows="8" maxlength="20000" placeholder="<p>Hi {{TEACHER_NAME}},</p>&#10;{{SESSION_LIST_HTML}}"><%= emailCh.bodyHtmlTemplate || '' %></textarea>
                <div class="form-text small">Inner HTML only; branded wrapper is applied when emails are composed.</div>
              </div>
              <% if (placeholderRows.length) { %>
                <details class="small">
                  <summary class="fw-semibold text-primary mb-2">Placeholders</summary>
                  <table class="table table-sm table-bordered mb-0">
                    <thead><tr><th>Token</th><th>Description</th></tr></thead>
                    <tbody>
                      <% placeholderRows.forEach((ph) => { %>
                        <tr>
                          <td class="font-monospace text-nowrap"><code>{{<%= ph.token %>}}</code></td>
                          <td><%= ph.description %></td>
                        </tr>
                      <% }); %>
                    </tbody>
                  </table>
                </details>
              <% } %>
            </div>
          </div>
        </div>

        <div class="tab-pane fade" id="tab-nc-delivery" role="tabpanel">
          <p class="small text-muted mb-3">Configure when and how messages are sent. Times use organization timezone: <strong><%= deliveryTz %></strong>. Manual <strong>Run now</strong> still requires review unless you only use scheduled auto-queue below.</p>

          <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
              <h6 class="fw-bold text-primary m-0 mb-3"><i class="bi bi-send-check me-1"></i>Scheduled auto-send</h6>
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="autoQueueOnSchedule" name="rule[schedule][autoQueueOnSchedule]" value="true" <%= row.schedule?.autoQueueOnSchedule === true ? 'checked' : '' %>>
                <label class="form-check-label" for="autoQueueOnSchedule">Queue messages automatically after scheduled evaluation</label>
              </div>
              <div class="form-text small">When enabled, a scheduled run queues email and/or SMS using the settings below. Manual runs are not auto-queued. Requires scheduled evaluation on the <strong>Schedule</strong> tab.</div>
            </div>
          </div>

          <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
              <h6 class="fw-bold text-primary m-0 mb-3"><i class="bi bi-envelope me-1"></i>Email delivery</h6>
              <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" role="switch" id="emailChannelEnabled" name="rule[channels][email][enabled]" value="true" <%= row.channels?.email?.enabled !== false ? 'checked' : '' %>>
                <label class="form-check-label" for="emailChannelEnabled">Enable email</label>
              </div>
              <div class="form-text small mb-3">When enabled, scheduled auto-send can queue email; operators can also schedule email manually from a run review.</div>
              <label class="form-label d-block">Email body format</label>
              <div class="d-flex flex-wrap gap-3 mb-3">
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="rule[channels][email][emailBodyMode]" id="emailBodyModeHtml" value="html" <%= emailBodyMode === 'html' ? 'checked' : '' %>>
                  <label class="form-check-label" for="emailBodyModeHtml">HTML (branded layout)</label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="rule[channels][email][emailBodyMode]" id="emailBodyModePlain" value="plain" <%= emailBodyMode === 'plain' ? 'checked' : '' %>>
                  <label class="form-check-label" for="emailBodyModePlain">Plain text only</label>
                </div>
              </div>
              <div class="col-md-4">
                <label class="form-label" for="emailSendAtTime">Send at time</label>
                <input class="form-control size-md" type="time" id="emailSendAtTime" name="rule[channels][email][sendAtTime]" value="<%= emailCh.sendAtTime || '18:00' %>">
              </div>
            </div>
          </div>

          <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
              <h6 class="fw-bold text-primary m-0 mb-3"><i class="bi bi-chat-dots me-1"></i>SMS delivery</h6>
              <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" role="switch" id="smsChannelEnabled" name="rule[channels][sms][enabled]" value="true" <%= smsCh.enabled === true ? 'checked' : '' %>>
                <label class="form-check-label" for="smsChannelEnabled">Enable SMS</label>
              </div>
              <div class="col-md-4">
                <label class="form-label" for="smsSendAtTime">Send at time</label>
                <input class="form-control size-md" type="time" id="smsSendAtTime" name="rule[channels][sms][sendAtTime]" value="<%= smsCh.sendAtTime || '18:00' %>">
              </div>
              <div class="form-text small mt-2">SMS uses the default short message from the rule type when auto-queued.</div>
            </div>
          </div>
        </div>

        <div class="tab-pane fade" id="tab-nc-schedule" role="tabpanel">
          <p class="small text-muted mb-3">Optional scheduled runs create a Scheduled Tasks entry. Run time uses your organization timezone (same as uncompleted session notifications in School Settings).</p>

          <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
              <h6 class="fw-bold text-primary m-0 mb-3"><i class="bi bi-alarm me-1"></i>Scheduled evaluation</h6>
              <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" role="switch" id="scheduleEnabled" name="rule[schedule][scheduleEnabled]" value="true" <%= row.schedule?.scheduleEnabled === true ? 'checked' : '' %>>
                <label class="form-check-label" for="scheduleEnabled">Enable scheduled evaluation</label>
              </div>
              <div class="form-text small mb-3">Preview results are stored for review. Use the <strong>Delivery</strong> tab to auto-queue messages after a scheduled run. Pause or cancel the linked scheduled task, or disable this rule, to stop automatic runs.</div>
              <div class="row g-3">
                <div class="col-md-4">
                  <label class="form-label" for="scheduleRunAtTime">Run at time</label>
                  <input class="form-control size-md" type="time" id="scheduleRunAtTime" name="rule[schedule][runAtTime]" value="<%= row.schedule?.runAtTime || '08:00' %>">
                </div>
                <div class="col-12">
                  <label class="form-label d-block">Weekdays</label>
                  <div class="d-flex flex-wrap gap-2" id="ncScheduleWeekdays">
                    <% weekdayLabels.forEach((label, idx) => { %>
                      <label class="btn btn-outline-secondary btn-sm nc-weekday-toggle <%= selectedSet.has(idx) ? 'active' : '' %>">
                        <input type="checkbox" class="d-none nc-weekday-input" name="rule[schedule][daysOfWeek][]" value="<%= idx %>" <%= selectedSet.has(idx) ? 'checked' : '' %>>
                        <%= label %>
                      </label>
                    <% }); %>
                  </div>
                  <div class="form-text small">Select at least one day when scheduled evaluation is enabled.</div>
                </div>
              </div>
            </div>
          </div>

          <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
              <h6 class="fw-bold text-primary m-0 mb-3"><i class="bi bi-calendar-event me-1"></i>Activity date window</h6>
              <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" role="switch" id="activityDateWindowEnabled" name="rule[activityDateWindow][enabled]" value="true" <%= row.activityDateWindow?.enabled === true ? 'checked' : '' %>>
                <label class="form-check-label" for="activityDateWindowEnabled">Limit scheduled evaluation to a date range</label>
              </div>
              <div class="form-text small mb-3">When enabled, scheduled evaluation runs only between the start and end dates (organization calendar). Manual <strong>Run now</strong> is not limited by this window.</div>
              <div class="row g-3" id="activityDateWindowFields">
                <div class="col-md-6">
                  <label class="form-label" for="activityDateWindowStart">Start date</label>
                  <input class="form-control size-md" type="date" id="activityDateWindowStart" name="rule[activityDateWindow][startDate]" value="<%= row.activityDateWindow?.startDate || '' %>">
                </div>
                <div class="col-md-6">
                  <label class="form-label" for="activityDateWindowEnd">End date</label>
                  <input class="form-control size-md" type="date" id="activityDateWindowEnd" name="rule[activityDateWindow][endDate]" value="<%= row.activityDateWindow?.endDate || '' %>">
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="tab-pane fade" id="tab-nc-criteria" role="tabpanel">
          <p class="small text-muted mb-3">Limit which sessions are included and when reminders align relative to session dates. Send clock times are on the <strong>Delivery</strong> tab.</p>
          <div class="card border-0 shadow-sm mb-3" id="ncCriteriaTimingCard">
            <div class="card-body">
              <h6 class="fw-bold text-primary m-0 mb-3"><i class="bi bi-clock-history me-1"></i>Session timing</h6>
              <div class="d-flex flex-column gap-2 mb-2">
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="rule[criteria][notificationTiming][mode]" id="ncTimingSameDay" value="same_day" <%= timingMode === 'same_day' ? 'checked' : '' %>>
                  <label class="form-check-label" for="ncTimingSameDay">Same day as session</label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="rule[criteria][notificationTiming][mode]" id="ncTimingNextDay" value="next_day" <%= timingMode === 'next_day' ? 'checked' : '' %>>
                  <label class="form-check-label" for="ncTimingNextDay">Day after session</label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="rule[criteria][notificationTiming][mode]" id="ncTimingDailyDigest" value="daily_digest" <%= timingMode === 'daily_digest' ? 'checked' : '' %>>
                  <label class="form-check-label" for="ncTimingDailyDigest">Daily digest of uncompleted sessions</label>
                </div>
              </div>
              <p class="small text-muted mb-0 d-none" id="ncTimingRelativeHelp">Eligible sessions are determined when the rule runs; outbound send time uses the Delivery tab.</p>
              <div class="row g-3 mt-3 d-none" id="ncTimingDigestFields">
                <div class="col-md-6">
                  <label class="form-label" for="sessionDateRange">Sessions to include in digest</label>
                  <select class="form-select size-md" id="sessionDateRange" name="rule[criteria][sessionDateRange][type]">
                    <% dateRangeTypes.forEach((opt) => { %>
                      <option value="<%= opt %>" <%= sessionRangeType === opt ? 'selected' : '' %>><%= formatLabel(opt) %></option>
                    <% }); %>
                  </select>
                </div>
                <div class="col-md-6 d-none" id="ncSessionDaysBeforeRow">
                  <label class="form-label" for="sessionDaysBeforeToday">Days before today</label>
                  <input class="form-control size-md" type="number" min="1" max="365" id="sessionDaysBeforeToday" name="rule[criteria][sessionDateRange][daysBeforeToday]" value="<%= daysBeforeToday %>">
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="tab-pane fade" id="tab-nc-managers" role="tabpanel">
          <p class="small text-muted mb-3">Managers receive a compact email with each teacher’s name and item count only. Teacher emails remain detailed. After <strong>scheduled auto-queue</strong> dispatches teacher messages, manager summaries are queued automatically. For manual runs, expand <strong>Manager summary email</strong> on run review and schedule from there.</p>
          <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
              <h6 class="fw-bold text-primary m-0 mb-3"><i class="bi bi-people me-1"></i>Manager summary email</h6>
              <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" role="switch" id="managerSummaryEnabled" name="rule[managerSummary][enabled]" value="true" <%= managerSummaryCfg.enabled === true ? 'checked' : '' %>>
                <label class="form-check-label" for="managerSummaryEnabled">Enable manager summary for this rule</label>
              </div>
              <div class="mb-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                  <label class="form-label mb-0">Manager recipients</label>
                  <button type="button" class="btn btn-outline-primary btn-sm" id="btnNcAddManager"><i class="bi bi-person-plus me-1"></i>Add manager</button>
                </div>
                <ul class="list-group list-group-flush border rounded" id="ncManagerRecipientList">
                  <% const managerRecipientRows = Array.isArray(managerRecipients) && managerRecipients.length
                    ? managerRecipients
                    : (Array.isArray(managerSummaryCfg.recipientPersonIds)
                      ? managerSummaryCfg.recipientPersonIds.map((id) => ({ personId: String(id || ''), name: String(id || '') }))
                      : []); %>
                  <% if (!managerRecipientRows.length) { %>
                    <li class="list-group-item text-muted small py-3" id="ncManagerRecipientEmpty">No managers selected.</li>
                  <% } %>
                  <% managerRecipientRows.forEach((recipient) => { %>
                    <li class="list-group-item d-flex align-items-center justify-content-between gap-2 nc-manager-recipient-row" data-person-id="<%= recipient.personId %>">
                      <div>
                        <div class="fw-semibold"><%= recipient.name || recipient.personId %></div>
                        <div class="x-small text-muted font-monospace"><%= recipient.personId %></div>
                      </div>
                      <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2 nc-manager-remove" title="Remove" aria-label="Remove manager"><i class="bi bi-x-lg"></i></button>
                      <input type="hidden" name="rule[managerSummary][recipientPersonIds][]" value="<%= recipient.personId %>">
                    </li>
                  <% }); %>
                </ul>
              </div>
              <div class="mb-3">
                <label class="form-label" for="managerSummarySubjectTemplate">Subject template (optional)</label>
                <input class="form-control font-monospace size-md" type="text" id="managerSummarySubjectTemplate" name="rule[managerSummary][subjectTemplate]" value="<%= managerSummaryCfg.subjectTemplate || '' %>" maxlength="500" placeholder="{{RULE_LABEL}} — manager summary ({{TEACHER_COUNT}} teachers, {{TOTAL_ITEM_COUNT}} items)">
              </div>
              <div class="mb-3">
                <label class="form-label" for="managerSummaryBodyTextTemplate">Plain body template (optional)</label>
                <textarea class="form-control font-monospace size-md" id="managerSummaryBodyTextTemplate" name="rule[managerSummary][bodyTextTemplate]" rows="6" maxlength="20000" placeholder="Hi {{MANAGER_NAME}},&#10;&#10;{{TEACHER_SUMMARY_LIST}}"><%= managerSummaryCfg.bodyTextTemplate || '' %></textarea>
              </div>
              <div class="mb-0">
                <label class="form-label" for="managerSummaryBodyHtmlTemplate">HTML body template (optional)</label>
                <textarea class="form-control font-monospace size-md" id="managerSummaryBodyHtmlTemplate" name="rule[managerSummary][bodyHtmlTemplate]" rows="6" maxlength="20000" placeholder="{{TEACHER_SUMMARY_LIST_HTML}}"><%= managerSummaryCfg.bodyHtmlTemplate || '' %></textarea>
                <div class="form-text small">Use manager summary placeholders listed under Email templates on the General tab.</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="button-row mt-4 pt-3 border-top d-flex flex-wrap align-items-center gap-2">
        <button type="submit" class="btn btn-filled btn-primary btn-md"><%= editing ? 'Save Changes' : 'Create Rule' %></button>
        <a href="/school/notification-center" class="btn btn-filled btn-secondary btn-md">Cancel</a>
        <% if (editing && row.id && !row.legacyKey && access?.canConfigure) { %>
          <button
            type="button"
            class="btn btn-outline-danger btn-md ms-auto js-nc-delete-rule-form"
            data-delete-url="/school/notification-center/rules/<%= row.id %>/delete"
            data-rule-label="<%= row.label || row.ruleType || 'rule' %>"
          >
            <i class="bi bi-trash me-1"></i>Delete rule
          </button>
        <% } %>
      </div>
    </form>
  </div>
</div>

<%- include('partials/modal_GenericPicker', { user }) %>

<script>
(function () {
  const form = document.getElementById('notificationRuleForm');
  const enabled = document.getElementById('scheduleEnabled');
  const weekdayWrap = document.getElementById('ncScheduleWeekdays');
  const managerList = document.getElementById('ncManagerRecipientList');
  const managerEmpty = document.getElementById('ncManagerRecipientEmpty');
  const managerEnabled = document.getElementById('managerSummaryEnabled');
  const btnAddManager = document.getElementById('btnNcAddManager');

  function escapeManagerHtml(value) {
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function syncManagerEmptyState() {
    if (!managerList || !managerEmpty) return;
    const hasRows = managerList.querySelectorAll('.nc-manager-recipient-row').length > 0;
    managerEmpty.classList.toggle('d-none', hasRows);
  }

  function addManagerRecipient(person) {
    if (!managerList || !person) return;
    const personId = String(person.id || person.personId || '').trim();
    if (!personId) return;
    if (managerList.querySelector(`.nc-manager-recipient-row[data-person-id="${personId}"]`)) return;
    const name = String(person.displayName || person.name || person.label || personId).trim();
    const li = document.createElement('li');
    li.className = 'list-group-item d-flex align-items-center justify-content-between gap-2 nc-manager-recipient-row';
    li.dataset.personId = personId;
    li.innerHTML = `<div><div class="fw-semibold">${escapeManagerHtml(name)}</div><div class="x-small text-muted font-monospace">${escapeManagerHtml(personId)}</div></div>`
      + `<button type="button" class="btn btn-outline-danger btn-sm py-0 px-2 nc-manager-remove" title="Remove" aria-label="Remove manager"><i class="bi bi-x-lg"></i></button>`
      + `<input type="hidden" name="rule[managerSummary][recipientPersonIds][]" value="${escapeManagerHtml(personId)}">`;
    managerList.appendChild(li);
    syncManagerEmptyState();
  }

  managerList?.addEventListener('click', (event) => {
    const removeBtn = event.target.closest('.nc-manager-remove');
    if (!removeBtn) return;
    removeBtn.closest('.nc-manager-recipient-row')?.remove();
    syncManagerEmptyState();
  });

  btnAddManager?.addEventListener('click', () => {
    if (!window.GenericPicker || !window.GenericPickerPresets) {
      showMessageModal({ title: 'Person picker', message: 'The person picker is not available on this page.', icon: 'warning', size: 'md' });
      return;
    }
    const context = window.GenericPickerContexts?.activeOrganizationScope
      ? window.GenericPickerContexts.activeOrganizationScope({ label: 'Active Organization' })
      : null;
    const config = window.GenericPickerPresets.person({
      title: 'Select manager',
      icon: 'bi-person-badge',
      apiEndpoint: '/school/schedules/api/school-person-picker',
      placeholder: 'Search staff...',
      searchFields: 'id,personId,displayName,name,email,roles,schoolRoles',
      context,
      limit: 20,
      onSelect: (person) => addManagerRecipient(person)
    });
    window.GenericPicker.open(config);
  });

  form?.addEventListener('submit', (event) => {
    if (!managerEnabled?.checked) return;
    const rows = managerList?.querySelectorAll('.nc-manager-recipient-row') || [];
    if (!rows.length) {
      event.preventDefault();
      const managersTab = document.querySelector('#notificationRuleTabs [data-bs-target="#tab-nc-managers"]');
      if (managersTab && typeof bootstrap !== 'undefined') bootstrap.Tab.getOrCreateInstance(managersTab).show();
      showMessageModal({
        title: 'Managers required',
        message: 'Add at least one manager recipient when manager summary is enabled.',
        icon: 'warning',
        size: 'md'
      });
    }
  });

  syncManagerEmptyState();

  if (form && enabled && weekdayWrap) {
    weekdayWrap.querySelectorAll('.nc-weekday-toggle').forEach((label) => {
      label.addEventListener('click', (event) => {
        event.preventDefault();
        const input = label.querySelector('.nc-weekday-input');
        if (!input) return;
        input.checked = !input.checked;
        label.classList.toggle('active', input.checked);
      });
    });

    form.addEventListener('submit', (event) => {
      if (!enabled.checked) return;
      const checked = weekdayWrap.querySelectorAll('.nc-weekday-input:checked');
      if (!checked.length) {
        event.preventDefault();
        const scheduleTab = document.querySelector('#notificationRuleTabs [data-bs-target="#tab-nc-schedule"]');
        if (scheduleTab && typeof bootstrap !== 'undefined') bootstrap.Tab.getOrCreateInstance(scheduleTab).show();
        showMessageModal({
          title: 'Weekdays required',
          message: 'Select at least one weekday for scheduled evaluation.',
          icon: 'warning',
          size: 'md'
        });
      }
    });
  }

  const windowEnabled = document.getElementById('activityDateWindowEnabled');
  const startInput = document.getElementById('activityDateWindowStart');
  const endInput = document.getElementById('activityDateWindowEnd');
  if (form && windowEnabled && startInput && endInput) {
    function refreshActivityWindowFields() {
      const on = windowEnabled.checked;
      startInput.disabled = !on;
      endInput.disabled = !on;
      startInput.required = on;
      endInput.required = on;
    }

    windowEnabled.addEventListener('change', refreshActivityWindowFields);
    refreshActivityWindowFields();

    form.addEventListener('submit', (event) => {
      if (!windowEnabled.checked) return;
      const start = String(startInput.value || '').trim();
      const end = String(endInput.value || '').trim();
      if (!start || !end) {
        event.preventDefault();
        const scheduleTab = document.querySelector('#notificationRuleTabs [data-bs-target="#tab-nc-schedule"]');
        if (scheduleTab && typeof bootstrap !== 'undefined') bootstrap.Tab.getOrCreateInstance(scheduleTab).show();
        showMessageModal({
          title: 'Dates required',
          message: 'Enter both start and end dates for the activity date window.',
          icon: 'warning',
          size: 'md'
        });
        return;
      }
      if (start > end) {
        event.preventDefault();
        const scheduleTab = document.querySelector('#notificationRuleTabs [data-bs-target="#tab-nc-schedule"]');
        if (scheduleTab && typeof bootstrap !== 'undefined') bootstrap.Tab.getOrCreateInstance(scheduleTab).show();
        showMessageModal({
          title: 'Invalid date range',
          message: 'Activity date window start date must be on or before the end date.',
          icon: 'warning',
          size: 'md'
        });
      }
    });
  }

  const timingCard = document.getElementById('ncCriteriaTimingCard');
  const ruleTypeSelect = document.getElementById('ruleType');
  const digestFields = document.getElementById('ncTimingDigestFields');
  const relativeHelp = document.getElementById('ncTimingRelativeHelp');
  const daysBeforeRow = document.getElementById('ncSessionDaysBeforeRow');
  const sessionRangeSelect = document.getElementById('sessionDateRange');

  function selectedTimingMode() {
    const checked = document.querySelector('input[name="rule[criteria][notificationTiming][mode]"]:checked');
    return String(checked?.value || 'daily_digest');
  }

  function refreshCriteriaTimingUi() {
    if (!timingCard) return;
    const isTimesheet = String(ruleTypeSelect?.value || '').trim() === 'timesheet_not_submitted';
    timingCard.classList.toggle('d-none', isTimesheet);
    if (isTimesheet) return;
    const mode = selectedTimingMode();
    const isDigest = mode === 'daily_digest';
    digestFields?.classList.toggle('d-none', !isDigest);
    relativeHelp?.classList.toggle('d-none', isDigest);
    const rangeType = String(sessionRangeSelect?.value || '');
    daysBeforeRow?.classList.toggle('d-none', !isDigest || rangeType !== 'days_before_today');
  }

  document.querySelectorAll('input[name="rule[criteria][notificationTiming][mode]"]').forEach((input) => {
    input.addEventListener('change', refreshCriteriaTimingUi);
  });
  ruleTypeSelect?.addEventListener('change', refreshCriteriaTimingUi);
  sessionRangeSelect?.addEventListener('change', refreshCriteriaTimingUi);
  refreshCriteriaTimingUi();

  const deleteRuleBtn = document.querySelector('.js-nc-delete-rule-form');
  if (deleteRuleBtn) {
    deleteRuleBtn.addEventListener('click', async () => {
      const deleteUrl = String(deleteRuleBtn.getAttribute('data-delete-url') || '').trim();
      const ruleLabel = String(deleteRuleBtn.getAttribute('data-rule-label') || '').trim() || 'this rule';
      if (!deleteUrl || typeof showMessageModal !== 'function') return;

      const choice = await showMessageModal({
        title: 'Delete rule',
        icon: 'warning',
        message: `Delete rule “${ruleLabel}”? This cannot be undone. Past run results may still appear in Recent run results.`,
        size: 'md',
        buttons: [
          { text: 'Cancel', class: 'btn-secondary btn-md' },
          { text: 'Delete', class: 'btn-danger btn-md' }
        ]
      });
      if (choice !== 'Delete') return;

      const csrfToken = typeof resolveCsrfToken === 'function' ? resolveCsrfToken() : '';
      const headers = { Accept: 'application/json', 'X-AJAX-Request': '1' };
      if (csrfToken) {
        headers['x-csrf-token'] = csrfToken;
        headers['csrf-token'] = csrfToken;
      }

      deleteRuleBtn.disabled = true;
      try {
        const response = await fetch(deleteUrl, { method: 'POST', headers, credentials: 'same-origin' });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok || payload.status !== 'ok') {
          throw new Error(payload.message || 'Could not delete this rule.');
        }
        window.location.href = '/school/notification-center?ruleDeleted=1';
      } catch (error) {
        await showMessageModal({
          title: 'Delete failed',
          message: error?.message || 'Could not delete this rule.',
          icon: 'error',
          size: 'md'
        });
        deleteRuleBtn.disabled = false;
      }
    });
  }
})();
</script>
