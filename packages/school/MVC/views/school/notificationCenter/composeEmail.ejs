<%
  const fmt = typeof formatNotificationTokenLabel === 'function' ? formatNotificationTokenLabel : (v) => String(v || '');
  const tzHint = timeZone ? ('Organization timezone: ' + timeZone) : 'Organization timezone applies when scheduling.';
%>

<div class="sections-page">
  <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
      <h1 class="page-heading size-md m-0"><i class="bi bi-envelope-plus me-2"></i><%= title %></h1>
      <div class="small text-muted mt-1">To: <strong><%= preview.recipientName || recipientPersonId %></strong> · <%= selectionKeys.length %> session(s)</div>
    </div>
    <a href="/school/notification-center/runs/<%= run.id %>" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Back to run</a>
  </div>

  <div class="form-container wide" style="max-width: 900px;">
    <form method="post" action="/school/notification-center/runs/<%= run.id %>/schedule-email" id="ncComposePageForm">
      <input type="hidden" name="actionStateId" value="<%= actionStateId || '' %>">
      <input type="hidden" name="recipientPersonId" value="<%= recipientPersonId %>">
      <% (selectionKeys || []).forEach((key) => { %>
        <input type="hidden" name="selectionKeys" value="<%= key %>">
      <% }); %>

      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <div class="mb-3">
            <label class="form-label fw-bold" for="ncSubject">Subject</label>
            <input class="form-control size-md" id="ncSubject" name="subject" value="<%= preview.subject || '' %>" required>
          </div>

          <%- include('partials/scheduleSendTimeFields', {
            schedulePanelPrefix: 'ncPage',
            scheduleSendAtValue: defaultSendAtLocal || '',
            scheduleTimeZoneHint: tzHint
          }) %>

          <div class="row g-3">
            <div class="col-12">
              <label class="form-label fw-bold" for="ncBodyText">Email body (plain text)</label>
              <textarea class="form-control size-md font-monospace" id="ncBodyText" name="bodyText" rows="14" required><%= preview.plainText || '' %></textarea>
              <textarea class="d-none" name="bodyHtml" id="ncBodyHtml" aria-hidden="true"><%- preview.htmlBody || '' %></textarea>
              <div class="form-text small">Plain-text version for editing; HTML with clickable session links is sent to recipients.</div>
            </div>
          </div>
        </div>
      </div>

      <div class="button-row pt-3 border-top d-flex flex-wrap gap-2">
        <button type="button" class="btn btn-outline-primary btn-md" id="ncPageSendNowFooter"><i class="bi bi-send me-1"></i> Send now</button>
        <button type="button" class="btn btn-outline-primary btn-md" id="ncPageScheduleBtn"><i class="bi bi-calendar-event me-1"></i> Schedule</button>
        <a href="/school/notification-center/runs/<%= run.id %>" class="btn btn-filled btn-secondary btn-md">Cancel</a>
      </div>
    </form>
  </div>
</div>

<script src="<%= typeof staticAssetUrl === 'function' ? staticAssetUrl('/scripts/notificationCenterScheduleSendTime.js') : '/scripts/notificationCenterScheduleSendTime.js' %>"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  const form = document.getElementById('ncComposePageForm');
  const sendNowFooter = document.getElementById('ncPageSendNowFooter');
  const scheduleBtn = document.getElementById('ncPageScheduleBtn');
  const controller = window.NotificationCenterScheduleSendTime?.createScheduleController({
    sendAtInput: document.getElementById('ncPageSendAt'),
    sendNowInput: document.getElementById('ncPageSendNow'),
    scheduleBtn: scheduleBtn,
    timeZone: <%- JSON.stringify(timeZone || 'UTC') %>,
    defaultSendAtLocal: <%- JSON.stringify(defaultSendAtLocal || '') %>,
    onSubmit: () => form?.requestSubmit()
  });
  sendNowFooter?.addEventListener('click', function (event) {
    event.preventDefault();
    controller?.submitSendNow();
  });
  scheduleBtn?.addEventListener('click', function (event) {
    event.preventDefault();
    void controller?.submitSchedule?.();
  });
});
</script>
