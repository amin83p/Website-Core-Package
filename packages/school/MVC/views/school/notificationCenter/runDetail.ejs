<div class="container py-3">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h1 class="h4 mb-1"><%= title %></h1>
      <div class="text-muted small">Status: <strong><%= run.status %></strong> · <%= run.findingCount || 0 %> finding(s) · <%= run.batchCount || 0 %> batch(es)</div>
    </div>
    <div class="d-flex gap-2">
      <a href="/school/notification-center" class="btn btn-outline-secondary btn-sm">Back</a>
      <% if (access?.canDispatch && run.status === 'preview') { %>
        <form method="post" action="/school/notification-center/runs/<%= run.id %>/dispatch">
          <button type="submit" class="btn btn-primary btn-sm">Queue email/SMS</button>
        </form>
      <% } %>
    </div>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Recipient</th>
            <th>Items</th>
            <th>Preview</th>
          </tr>
        </thead>
        <tbody>
          <% (run.batches || []).forEach((batch) => { %>
            <tr>
              <td class="fw-semibold"><%= batch.recipientName || batch.recipientPersonId %></td>
              <td><%= batch.itemCount || 0 %></td>
              <td>
                <details>
                  <summary class="text-primary" style="cursor:pointer">View</summary>
                  <pre class="small mt-2 mb-0"><%= batch.preview?.plainText || '' %></pre>
                </details>
              </td>
            </tr>
          <% }); %>
          <% if (!(run.batches || []).length) { %>
            <tr><td colspan="3" class="text-center text-muted py-4">No recipient batches in this run.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
