<%- include('partials/tablePages-start', {
  title, newUrl, newLabel, user, tableName, btn_export: true, print,
  headerManageBtns: [
    '<a href="' + schoolSectionDashboardHref + '" class="school-navigator-dashboard btn btn-filled btn-secondary btn-md mb-2"><i class="bi bi-speedometer2 me-1"></i> School Dashboard</a>',
    '<a href="/dashboard/section-nav/SCHOOL_PEOPLE" class="school-navigator-dashboard btn btn-filled btn-secondary mb-2 btn-md"><i class="bi bi-people me-1"></i> People Dashboard</a>'
  ],
  manageBtns: [
    `<a href="/school/referrals/archived" class="btn btn-outline-warning btn-md mb-2"><i class="bi bi-arrow-counterclockwise me-1"></i> Recover Archived</a>`
  ]
}) %>

<%- include('partials/tablePages-search', {
  placeholder: 'Search referrals...',
  fields: [
    { name: 'status', label: 'Status', type: 'select', options: statuses || ['Active'] }
  ]
}) %>

<div class="table-scroll-wrapper" data-floating-row-actions="true">
  <table class="table-responsive size-md" id="first-table">
    <thead>
      <tr>
        <th class="ps-4">Contact</th>
        <th>Organizations</th>
        <th>Contact info</th>
        <th>Notes</th>
        <th class="text-center">Status</th>
        <th class="text-end pe-4">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if(data.length === 0) { %>
        <tr><td colspan="6" class="text-center py-4 text-muted">No referrals found.</td></tr>
      <% } %>
      <% data.forEach(item => { %>
        <tr>
          <td class="ps-4">
            <div class="fw-bold text-primary"><%= item.firstName %> <%= item.lastName %></div>
            <div class="small text-muted font-monospace"><i class="bi bi-person-badge me-1"></i><%= item.id %></div>
          </td>
          <td class="small"><%= item.organizationLabels || '-' %></td>
          <td class="small text-muted">
            <div><i class="bi bi-envelope me-1"></i><%= item.email %></div>
            <div><i class="bi bi-telephone me-1"></i><%= item.phone %></div>
          </td>
          <td class="small text-muted"><%= String(item.notes || '').slice(0, 80) || '-' %></td>
          <td class="text-center">
            <% const badge = item.status === 'Active' ? 'bg-success' : 'bg-secondary'; %>
            <span class="badge <%= badge %>"><%= String(item.status || 'Unknown').toUpperCase() %></span>
          </td>
          <td class="table-actions text-end pe-4">
            <div class="row-actions-wrap">
              <button type="button" class="btn btn-secondary btn-sm btn-row-actions-toggle" data-row-actions-id="<%= item.id %>" title="Referral Actions">
                <i class="bi bi-three-dots-vertical"></i>
              </button>
              <div class="row-actions-menu d-none" data-row-actions-id="<%= item.id %>">
                <a href="/school/referrals/edit/<%= item.id %>" class="btn btn-outline-secondary btn-sm"><i class="bi bi-pencil-square me-2"></i>Edit</a>
                <button class="btn btn-outline-secondary btn-sm archive-btn" data-id="<%= item.id %>"><i class="bi bi-archive me-2"></i>Archive</button>
              </div>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<span id="urlRef" data-id="school/referrals" hidden></span>
<%- include('partials/pagination', { pagination, filters, baseUrlPath: 'school/referrals' }) %>
<%- include('partials/tablePages-end') %>