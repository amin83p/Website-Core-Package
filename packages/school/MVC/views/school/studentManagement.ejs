<%- include('partials/studentManagementStyles') %>
<link rel="stylesheet" href="/styles/attendance-hover-tip.css">

<div class="container-fluid school-student-management-root pt-3 pb-4" data-student-management-root>
  <div class="school-student-management-banner mb-3">
    <div class="school-student-management-banner-row d-flex justify-content-between align-items-center flex-wrap gap-3">
      <div class="school-student-management-banner-copy">
        <h1 class="h3 mb-1">Student File Management</h1>
        <p class="text-muted small mb-0">Search students, review the file, and open tools including the timeline.</p>
      </div>
      <div id="hubStudentsBannerStats" class="hub-students-banner-stats">
        <div class="text-muted small d-flex align-items-center justify-content-end" id="hubStudentsBannerStatsBody">
          <span class="spinner-border spinner-border-sm text-primary me-2" role="status" aria-hidden="true"></span>
          Loading student counts…
        </div>
      </div>
    </div>
  </div>

  <div id="schoolStudentManagementWorkspace" class="school-student-management-workspace"></div>
</div>

<%- include('partials/studentManagementModals') %>

