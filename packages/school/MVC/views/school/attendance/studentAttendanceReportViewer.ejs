    async function loadStudentAttendanceReport() {
        const startDate = String(document.getElementById('filter_startDate').value || '').trim();
        const endDate = String(document.getElementById('filter_endDate').value || '').trim();
        const studentIds = selectedStudents.map((row) => String(row.studentRecordId || row.id || '').trim()).filter(Boolean);
        if (!studentIds.length) {
            showReportMessage({ icon: 'warning', message: 'Select at least one student.' });
            return;
        }
        if (!startDate || !endDate) {
            showReportMessage({ icon: 'warning', message: 'Start date and end date are required.' });
            return;
        }

        const params = new URLSearchParams();
        params.set('startDate', startDate);
        params.set('endDate', endDate);
        params.set('studentIds', studentIds.join(','));

        const response = await fetch(`/school/attendances/report/api/data?${params.toString()}`, {
            headers: { 'X-AJAX-Request': 'true' }
        });
        const payload = await response.json();
        if (payload.status !== 'success') {
            throw new Error(payload.message || 'Could not load student attendance report.');
        }

        const days = Array.isArray(payload.days) ? payload.days : [];
        const students = orderReportStudentsBySelection(Array.isArray(payload.students) ? payload.students : []);
        const container = document.getElementById('studentReportSections');
        container.innerHTML = students.length
            ? students.map((student) => buildStudentSection(student, days, payload.startDate, payload.endDate)).join('')
            : '<p class="text-muted mb-0">No attendance data found for the selected students.</p>';
        populateCellDetailsFromPayload(students, payload.startDate, payload.endDate);
        mergeSelectedStudentsFromReportPayload(students);
        syncSarUrlFromFilters();
        document.getElementById('resultsContainer').classList.remove('d-none');
    }

    async function generateStudentAttendanceReport() {
        return openStudentAttendanceExportPanel();
    }

    function getSarFilterParams() {
        const startDate = String(document.getElementById('filter_startDate').value || '').trim();
        const endDate = String(document.getElementById('filter_endDate').value || '').trim();
        const studentIds = selectedStudents.map((row) => String(row.studentRecordId || row.id || '').trim()).filter(Boolean);
        return { startDate, endDate, studentIds };
    }

    function buildSarShareUrl() {
        const { startDate, endDate, studentIds } = getSarFilterParams();
        const url = new URL('/school/attendances/report', window.location.origin);
        if (startDate) url.searchParams.set('startDate', startDate);
        if (endDate) url.searchParams.set('endDate', endDate);
        if (studentIds.length) url.searchParams.set('studentIds', studentIds.join(','));
        return url.toString();
    }

    function syncSarUrlFromFilters() {
        if (!window.history?.replaceState) return;
        const { startDate, endDate, studentIds } = getSarFilterParams();
        const url = new URL(window.location.pathname, window.location.origin);
        if (startDate) url.searchParams.set('startDate', startDate);
        else url.searchParams.delete('startDate');
        if (endDate) url.searchParams.set('endDate', endDate);
        else url.searchParams.delete('endDate');
        if (studentIds.length) url.searchParams.set('studentIds', studentIds.join(','));
        else url.searchParams.delete('studentIds');
        url.searchParams.delete('personIds');
        const nextUrl = url.pathname + url.search;
        const currentUrl = window.location.pathname + window.location.search;
        if (currentUrl !== nextUrl) {
            window.history.replaceState({}, document.title, nextUrl);
        }
    }

    function mergeSelectedStudentsFromReportPayload(students = []) {
        if (!Array.isArray(students) || !students.length || !selectedStudents.length) return;
        const byPersonId = new Map(students.map((row) => [String(row.personId || '').trim(), row]));
        const byStudentRecordId = new Map(students.map((row) => [String(row.studentRecordId || '').trim(), row]));
        selectedStudents = selectedStudents.map((row) => {
            const studentRecordId = String(row.studentRecordId || row.id || '').trim();
            const personId = String(row.personId || '').trim();
            const match = byStudentRecordId.get(studentRecordId)
                || byPersonId.get(personId)
                || byPersonId.get(studentRecordId);
            if (!match) return row;
            return {
                id: String(match.studentRecordId || studentRecordId || row.id || '').trim(),
                studentRecordId: String(match.studentRecordId || studentRecordId || row.id || '').trim(),
                personId: String(match.personId || personId || '').trim(),
                name: String(match.name || row.name || '').trim()
            };
        });
        renderSelectedStudents();
    }

    async function copySarShareLink() {
        const { studentIds, startDate, endDate } = getSarFilterParams();
        if (!studentIds.length) {
            showReportMessage({ icon: 'warning', message: 'Select at least one student before copying a link.' });
            return;
        }
        if (!startDate || !endDate) {
            showReportMessage({ icon: 'warning', message: 'Set a start and end date before copying a link.' });
            return;
        }
        const shareUrl = buildSarShareUrl();
        syncSarUrlFromFilters();
        try {
            if (navigator.clipboard?.writeText) {
                await navigator.clipboard.writeText(shareUrl);
            } else {
                const input = document.createElement('textarea');
                input.value = shareUrl;
                input.setAttribute('readonly', '');
                input.style.position = 'fixed';
                input.style.left = '-9999px';
                document.body.appendChild(input);
                input.select();
                document.execCommand('copy');
                input.remove();
            }
            showReportMessage({
                icon: 'success',
                message: 'Shareable link copied. Anyone with access can open it to view the same students and date range.'
            });
        } catch (error) {
            showReportMessage({ icon: 'error', message: error.message || 'Could not copy the link.' });
        }
    }

    function validateSarFilters() {
        const { startDate, endDate, studentIds } = getSarFilterParams();
        if (!canGenerateReport) {
            showReportMessage({ icon: 'warning', message: 'Configure a report template in School Settings first.' });
            return null;
        }
        if (!studentIds.length) {
            showReportMessage({ icon: 'warning', message: 'Select at least one student.' });
            return null;
        }
        if (!startDate || !endDate) {
            showReportMessage({ icon: 'warning', message: 'Start date and end date are required.' });
            return null;
        }
        return { startDate, endDate, studentIds };
    }

    function buildSarFormatBadges(row = {}, exportType = 'class') {
        const badges = [];
        if (row.hasDocx) badges.push('<span class="badge bg-primary-subtle text-primary border sar-export-format-badge">DOCX</span>');
        if (row.hasPdf && exportType === 'class') badges.push('<span class="badge bg-danger-subtle text-danger border sar-export-format-badge">PDF</span>');
        badges.push('<span class="badge bg-secondary-subtle text-secondary border sar-export-format-badge">Payload</span>');
        return badges.length ? `<div class="d-flex flex-wrap gap-1 mt-1">${badges.join('')}</div>` : '';
    }

    function buildSarFormatButtons(row = {}, exportType = 'class') {
        const hasDocx = Boolean(row.hasDocx);
        const hasPdf = Boolean(row.hasPdf && exportType === 'class');
        const buttons = [];
        if (hasDocx) {
            buttons.push('<button type="button" class="btn btn-outline-primary btn-sm js-sar-row-export" data-format="docx"><i class="bi bi-filetype-docx me-1"></i>DOCX</button>');
        }
        if (hasPdf) {
            buttons.push('<button type="button" class="btn btn-outline-danger btn-sm js-sar-row-export" data-format="pdf"><i class="bi bi-filetype-pdf me-1"></i>PDF</button>');
        }
        buttons.push('<button type="button" class="btn btn-outline-secondary btn-sm js-sar-row-export" data-format="json"><i class="bi bi-braces me-1"></i>Payload</button>');
        return `<div class="btn-group btn-group-sm flex-wrap mt-2">${buttons.join('')}</div>`;
    }

    function evaluateOverallEligibilityForStudent(studentId) {
        const student = (sarExportPlan?.students || []).find((row) => String(row.personId || '').trim() === String(studentId || '').trim());
        if (!student?.overall?.defined) return { eligible: false, reason: 'No overall template configured.' };

        const slotCount = Number(student.overall.slotCount) || 0;
        if (!slotCount) return { eligible: false, reason: 'Overall template has no source slots.' };

        const panel = getSarExportRoot();
        if (!panel) return { eligible: false, reason: 'Export modal not ready.' };

        for (let index = 0; index < slotCount; index += 1) {
            const classRow = (student.classes || []).find((row) => Number(row.slotIndex) === index);
            if (!classRow) {
                return { eligible: false, reason: `Missing class for slot ${index + 1}.` };
            }
            const checkbox = panel.querySelector(
                `.js-sar-export-check[data-sar-export-type="class"][data-student-id="${CSS.escape(String(student.personId))}"][data-class-id="${CSS.escape(String(classRow.classId))}"]`
            );
            const checked = checkbox ? checkbox.checked : true;
            if (!checked) {
                return { eligible: false, reason: 'Select all required class reports for the overall template.' };
            }
            if (!classRow.exportable) {
                return { eligible: false, reason: classRow.warning || 'A required class report is not exportable.' };
            }
        }
        return { eligible: true, reason: '' };
    }

    function updateOverallEligibilityUi(studentId) {
        const panel = getSarExportRoot();
        if (!panel || !studentId) return;
        const cell = panel.querySelector(`.js-sar-overall-cell[data-student-id="${CSS.escape(String(studentId))}"]`);
        if (!cell) return;

        const student = (sarExportPlan?.students || []).find((row) => String(row.personId || '').trim() === String(studentId).trim());
        if (!student?.overall?.defined) return;

        const { eligible, reason } = evaluateOverallEligibilityForStudent(studentId);
        const checkbox = cell.querySelector('.js-sar-export-check[data-sar-export-type="overall"]');
        const statusEl = cell.querySelector('.js-sar-overall-status');
        const actionsEl = cell.querySelector('.js-sar-overall-actions');

        if (checkbox) {
            checkbox.disabled = !eligible;
            if (!eligible) checkbox.checked = false;
            else if (!checkbox.hasAttribute('data-user-touched')) checkbox.checked = true;
        }

        if (statusEl) {
            statusEl.textContent = eligible ? '' : (reason || 'Overall report not available.');
            statusEl.classList.toggle('d-none', eligible);
        }

        if (actionsEl) {
            actionsEl.classList.toggle('d-none', !eligible);
            actionsEl.querySelectorAll('.js-sar-row-export').forEach((btn) => {
                btn.disabled = !eligible || !(checkbox && checkbox.checked);
            });
        }
    }

    function renderSarExportPlan(plan = {}) {
        sarExportPlan = plan;
        const root = getSarExportRoot();
        const loadingEl = document.getElementById('sarExportLoading');
        const emptyEl = document.getElementById('sarExportEmpty');
        const tableWrap = document.getElementById('sarExportTableWrap');
        const tableBody = document.getElementById('sarExportTableBody');
        const overallHeader = document.getElementById('sarExportOverallHeader');
        const classBulkPanel = document.getElementById('sarExportClassBulkPanel');
        const overallBulkPanel = document.getElementById('sarExportOverallBulkPanel');
        const overallTemplateCardWrap = document.getElementById('sarExportOverallTemplateCardWrap');
        const reportTemplateTitleEl = document.getElementById('sarExportReportTemplateTitle');
        const overallTemplateTitleEl = document.getElementById('sarExportOverallTemplateTitle');
        const dateRangeEl = document.getElementById('sarExportDateRange');

        if (!root || !tableBody) return;

        loadingEl?.classList.add('d-none');
        const students = Array.isArray(plan.students) ? plan.students : [];
        const hasOverall = Boolean(plan.overallReportTemplateId);

        if (reportTemplateTitleEl) {
            reportTemplateTitleEl.textContent = plan.reportTemplateTitle || plan.reportTemplateId || '—';
        }
        if (overallTemplateTitleEl) {
            overallTemplateTitleEl.textContent = plan.overallReportTemplateTitle || plan.overallReportTemplateId || '—';
        }
        overallTemplateCardWrap?.classList.toggle('d-none', !hasOverall);
        if (dateRangeEl && plan.startDate && plan.endDate) {
            dateRangeEl.textContent = `${plan.startDate} → ${plan.endDate} · ${students.length} student${students.length === 1 ? '' : 's'}`;
        }

        overallHeader?.classList.toggle('d-none', !hasOverall);
        overallBulkPanel?.classList.toggle('d-none', !hasOverall);

        if (!students.length) {
            emptyEl?.classList.remove('d-none');
            tableWrap?.classList.add('d-none');
            classBulkPanel?.classList.add('d-none');
            overallBulkPanel?.classList.add('d-none');
            tableBody.innerHTML = '';
            return;
        }

        emptyEl?.classList.add('d-none');
        tableWrap?.classList.remove('d-none');
        classBulkPanel?.classList.remove('d-none');
        if (hasOverall) overallBulkPanel?.classList.remove('d-none');

        tableBody.innerHTML = students.map((student) => {
            const personId = String(student.personId || '').trim();
            const classBlocks = (student.classes || []).map((classRow) => {
                const classId = String(classRow.classId || '').trim();
                const className = escapeHtml(classRow.className || classId);
                const templateTitle = escapeHtml(classRow.templateTitle || classRow.templateId || '');
                const label = `${className} — ${templateTitle}`;
                const disabled = !classRow.exportable;
                return `
                    <div class="sar-export-class-row">
                        <div class="d-flex flex-wrap align-items-start gap-2">
                            <input
                                type="checkbox"
                                class="form-check-input mt-1 js-sar-export-check"
                                data-sar-export-type="class"
                                data-student-id="${escapeHtml(personId)}"
                                data-class-id="${escapeHtml(classId)}"
                                ${disabled ? 'disabled' : 'checked'}
                                aria-label="Include ${label}">
                            <div class="flex-grow-1 min-w-0">
                                <div class="sar-export-class-name">${className}</div>
                                <div class="sar-export-template-label">${templateTitle}</div>
                                ${!disabled ? buildSarFormatBadges(classRow, 'class') : ''}
                                ${disabled && classRow.warning ? `<div class="small text-warning mt-1">${escapeHtml(classRow.warning)}</div>` : ''}
                                ${!disabled ? buildSarFormatButtons(classRow, 'class') : ''}
                            </div>
                        </div>
                    </div>`;
            }).join('') || '<div class="small text-muted py-2">No classes in range.</div>';

            const overallCell = hasOverall
                ? (() => {
                    const overall = student.overall || {};
                    const overallTitle = escapeHtml(overall.templateTitle || plan.overallReportTemplateTitle || '');
                    const initialEligible = Boolean(overall.eligible);
                    return `
                        <td class="sar-export-overall-cell js-sar-overall-cell" data-student-id="${escapeHtml(personId)}">
                            <div class="d-flex flex-wrap align-items-start gap-2">
                                <input
                                    type="checkbox"
                                    class="form-check-input mt-1 js-sar-export-check"
                                    data-sar-export-type="overall"
                                    data-student-id="${escapeHtml(personId)}"
                                    ${initialEligible ? 'checked' : 'disabled'}
                                    aria-label="Include overall report for ${escapeHtml(student.name || personId)}">
                                <div class="flex-grow-1 min-w-0">
                                    <div class="sar-export-class-name">${overallTitle}</div>
                                    <div class="small text-muted">Overall merged report</div>
                                    ${initialEligible ? buildSarFormatBadges({ hasDocx: overall.hasDocx, hasPdf: false }, 'overall') : ''}
                                    <div class="small text-warning js-sar-overall-status ${initialEligible ? 'd-none' : ''}">
                                        ${escapeHtml((overall.warnings || []).join(' ') || 'Overall report not available for this student.')}
                                    </div>
                                    <div class="js-sar-overall-actions ${initialEligible ? '' : 'd-none'}">
                                        ${buildSarFormatButtons({ hasDocx: overall.hasDocx, hasPdf: false }, 'overall')}
                                    </div>
                                </div>
                            </div>
                        </td>`;
                })()
                : '';

            return `
                <tr data-student-id="${escapeHtml(personId)}">
                    <td class="sar-export-student-col ps-3 fw-semibold align-top">${escapeHtml(student.name || personId)}</td>
                    <td class="align-top">${classBlocks}</td>
                    ${overallCell}
                </tr>`;
        }).join('');

        students.forEach((student) => updateOverallEligibilityUi(student.personId));
    }

    function gatherSarExportTargets(format = '', scope = 'all') {
        const root = getSarExportRoot();
        if (!root) return [];
        const normalizedFormat = String(format || '').trim().toLowerCase();
        const normalizedScope = String(scope || 'all').trim().toLowerCase();
        const targets = [];
        const includeClass = normalizedScope === 'all' || normalizedScope === 'class';
        const includeOverall = normalizedScope === 'all' || normalizedScope === 'overall';

        if (includeClass) {
            root.querySelectorAll('.js-sar-export-check[data-sar-export-type="class"]:checked').forEach((checkbox) => {
                const studentId = String(checkbox.getAttribute('data-student-id') || '').trim();
                const classId = String(checkbox.getAttribute('data-class-id') || '').trim();
                const student = (sarExportPlan?.students || []).find((row) => String(row.personId || '').trim() === studentId);
                const classRow = (student?.classes || []).find((row) => String(row.classId || '').trim() === classId);
                if (!studentId || !classId || !classRow) return;
                if (normalizedFormat === 'docx' && !classRow.hasDocx) return;
                if (normalizedFormat === 'pdf' && !classRow.hasPdf) return;
                targets.push({ type: 'class', studentId, classId });
            });
        }

        if (includeOverall) {
            root.querySelectorAll('.js-sar-export-check[data-sar-export-type="overall"]:checked:not(:disabled)').forEach((checkbox) => {
                const studentId = String(checkbox.getAttribute('data-student-id') || '').trim();
                if (!studentId) return;
                const student = (sarExportPlan?.students || []).find((row) => String(row.personId || '').trim() === studentId);
                const overall = student?.overall;
                if (!overall?.defined) return;
                if (normalizedFormat === 'pdf') return;
                if (normalizedFormat === 'docx' && !overall.hasDocx) return;
                const classIds = [];
                root.querySelectorAll(
                    `.js-sar-export-check[data-sar-export-type="class"][data-student-id="${CSS.escape(studentId)}"]:checked`
                ).forEach((classCheckbox) => {
                    const classId = String(classCheckbox.getAttribute('data-class-id') || '').trim();
                    if (classId) classIds.push(classId);
                });
                targets.push({ type: 'overall', studentId, classIds });
            });
        }

        return targets;
    }

    function getSarExportLoadingLabel(format = '') {
        const token = String(format || '').trim().toLowerCase();
        if (token === 'docx') return 'Word (DOCX)';
        if (token === 'pdf') return 'PDF';
        if (token === 'json') return 'Payload (JSON)';
        return 'report';
    }

    function showSarExportWaiting(format = '', targetCount = 1) {
        if (typeof window.showLoading !== 'function') return null;
        const label = getSarExportLoadingLabel(format);
        const count = Number(targetCount) || 1;
        const countLabel = count > 1 ? `${count} selected report${count === 1 ? '' : 's'}` : 'selected report';
        return window.showLoading({
            title: 'Exporting Reports',
            note: `Generating ${label} for ${countLabel}. Please wait…`,
            operation: `Export ${label}`
        });
    }

    function hideSarExportWaiting(token) {
        if (typeof window.hideLoading !== 'function') return;
        if (token) window.hideLoading(token);
        else window.hideLoading({ force: true });
    }

    async function runSarExport(format, targets = []) {
        const filters = validateSarFilters();
        if (!filters) return;
        if (!targets.length) {
            showReportMessage({ icon: 'warning', message: 'Select at least one report that supports this export format.' });
            return;
        }

        const loadingToken = showSarExportWaiting(format, targets.length);
        try {
            const response = await fetch('/school/attendances/report/api/export', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    Accept: 'application/octet-stream, application/json',
                    'X-AJAX-Request': 'true'
                },
                body: new URLSearchParams({
                    actionStateId: sarActionStateId,
                    startDate: filters.startDate,
                    endDate: filters.endDate,
                    studentIds: filters.studentIds.join(','),
                    format: String(format || 'json'),
                    targets: JSON.stringify(targets)
                }).toString()
            });

            if (!response.ok) {
                const payload = await response.json().catch(() => null);
                throw new Error(payload?.message || 'Export failed.');
            }

            const blob = await response.blob();
            const disposition = response.headers.get('Content-Disposition') || '';
            const fileNameMatch = disposition.match(/filename="([^"]+)"/i);
            const fileName = fileNameMatch?.[1] || `student_attendance_export_${filters.startDate}_${filters.endDate}`;
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.download = fileName;
            document.body.appendChild(link);
            link.click();
            link.remove();
            URL.revokeObjectURL(url);
            showReportMessage({ icon: 'success', message: 'Export downloaded successfully.' });
        } finally {
            hideSarExportWaiting(loadingToken);
        }
    }

    async function openStudentAttendanceExportPanel() {
        const filters = validateSarFilters();
        if (!filters) return;

        const loadingEl = document.getElementById('sarExportLoading');
        const button = document.getElementById('btn_generateReport');

        showSarExportModal();
        loadingEl?.classList.remove('d-none');
        document.getElementById('sarExportEmpty')?.classList.add('d-none');
        document.getElementById('sarExportTableWrap')?.classList.add('d-none');
        document.getElementById('sarExportClassBulkPanel')?.classList.add('d-none');
        document.getElementById('sarExportOverallBulkPanel')?.classList.add('d-none');

        const dateRangeEl = document.getElementById('sarExportDateRange');
        if (dateRangeEl) {
            dateRangeEl.textContent = `${filters.startDate} → ${filters.endDate} · loading…`;
        }

        if (button) button.disabled = true;
        try {
            const params = new URLSearchParams();
            params.set('startDate', filters.startDate);
            params.set('endDate', filters.endDate);
            params.set('studentIds', filters.studentIds.join(','));

            const response = await fetch(`/school/attendances/report/api/export-plan?${params.toString()}`, {
                headers: { 'X-AJAX-Request': 'true' }
            });
            const payload = await response.json();
            if (payload.status !== 'success') {
                throw new Error(payload.message || 'Could not load export options.');
            }
            renderSarExportPlan(payload.plan || {});
        } catch (error) {
            showReportMessage({ icon: 'error', message: error.message || 'Could not load export options.' });
        } finally {
            loadingEl?.classList.add('d-none');
            if (button && canGenerateReport) button.disabled = false;
        }
    }

    document.getElementById('studentReportSections').addEventListener('click', (event) => {
        const cellTrigger = event.target.closest('[data-sar-cell-key]');
        if (cellTrigger) {
            event.preventDefault();
            openCellDetailModal(cellTrigger.getAttribute('data-sar-cell-key'));
            return;
        }
        const matrixTrigger = event.target.closest('[data-sar-matrix-url]');
        if (!matrixTrigger) return;
        event.preventDefault();
        confirmOpenAttendanceMatrix(matrixTrigger.getAttribute('data-sar-matrix-url'));
    });

    document.getElementById('btn_sarOpenMatrix')?.addEventListener('click', () => {
        confirmOpenAttendanceMatrix(sarCurrentMatrixUrl);
    });

    document.getElementById('btn_copyReportLink')?.addEventListener('click', () => {
        copySarShareLink().catch((error) => showReportMessage({ icon: 'error', message: error.message || 'Could not copy link.' }));
    });
    document.getElementById('filter_startDate')?.addEventListener('change', syncSarUrlFromFilters);
    document.getElementById('filter_endDate')?.addEventListener('change', syncSarUrlFromFilters);
    document.getElementById('btn_openStudentPicker').addEventListener('click', openStudentPicker);
    document.getElementById('btn_clearStudents').addEventListener('click', () => {
        selectedStudents = [];
        renderSelectedStudents();
        cellDetailByKey.clear();
        document.getElementById('studentReportSections').innerHTML = '';
        document.getElementById('resultsContainer').classList.add('d-none');
        sarExportPlan = null;
    });
    document.getElementById('btn_expandAllStudents')?.addEventListener('click', () => setAllStudentSectionsExpanded(true));
    document.getElementById('btn_collapseAllStudents')?.addEventListener('click', () => setAllStudentSectionsExpanded(false));
    document.getElementById('btn_loadData').addEventListener('click', () => {
        loadStudentAttendanceReport().catch((error) => showReportMessage({ icon: 'error', message: error.message || 'Load failed.' }));
    });
    document.getElementById('btn_generateReport')?.addEventListener('click', () => {
        openStudentAttendanceExportPanel().catch((error) => showReportMessage({ icon: 'error', message: error.message || 'Export panel failed.' }));
    });

    document.getElementById('sarExportModal')?.addEventListener('click', (event) => {
        const exportBtn = event.target.closest('.js-sar-row-export');
        if (exportBtn) {
            event.preventDefault();
            const format = String(exportBtn.getAttribute('data-format') || 'json').trim().toLowerCase();
            const rowHost = exportBtn.closest('.sar-export-class-row, .js-sar-overall-cell');
            const checkbox = rowHost?.querySelector('.js-sar-export-check');
            if (!checkbox) return;
            const studentId = String(checkbox.getAttribute('data-student-id') || '').trim();
            const exportType = String(checkbox.getAttribute('data-sar-export-type') || '').trim().toLowerCase();
            const targets = [];
            if (exportType === 'class') {
                const classId = String(checkbox.getAttribute('data-class-id') || '').trim();
                if (!studentId || !classId) return;
                targets.push({ type: 'class', studentId, classId });
            } else if (exportType === 'overall') {
                const classIds = [];
                getSarExportRoot()?.querySelectorAll(
                    `.js-sar-export-check[data-sar-export-type="class"][data-student-id="${CSS.escape(studentId)}"]:checked`
                ).forEach((classCheckbox) => {
                    const classId = String(classCheckbox.getAttribute('data-class-id') || '').trim();
                    if (classId) classIds.push(classId);
                });
                targets.push({ type: 'overall', studentId, classIds });
            }
            runSarExport(format, targets).catch((error) => {
                showReportMessage({ icon: 'error', message: error.message || 'Export failed.' });
            });
            return;
        }

        const bulkBtn = event.target.closest('.js-sar-bulk-export');
        if (bulkBtn) {
            event.preventDefault();
            const format = String(bulkBtn.getAttribute('data-format') || 'json').trim().toLowerCase();
            const scope = String(bulkBtn.getAttribute('data-export-scope') || 'all').trim().toLowerCase();
            const targets = gatherSarExportTargets(format, scope);
            const scopeLabel = scope === 'overall' ? 'overall report' : 'class report';
            if (!targets.length) {
                showReportMessage({ icon: 'warning', message: `Select at least one ${scopeLabel} that supports this format.` });
                return;
            }
            runSarExport(format, targets).catch((error) => {
                showReportMessage({ icon: 'error', message: error.message || 'Export failed.' });
            });
        }
    });

    document.getElementById('sarExportModal')?.addEventListener('change', (event) => {
        const checkbox = event.target.closest('.js-sar-export-check');
        if (!checkbox) return;
        const studentId = String(checkbox.getAttribute('data-student-id') || '').trim();
        if (checkbox.getAttribute('data-sar-export-type') === 'overall') {
            checkbox.setAttribute('data-user-touched', '1');
            const cell = checkbox.closest('.js-sar-overall-cell');
            const actionsEl = cell?.querySelector('.js-sar-overall-actions');
            if (actionsEl) {
                actionsEl.querySelectorAll('.js-sar-row-export').forEach((btn) => {
                    btn.disabled = !checkbox.checked;
                });
            }
            return;
        }
        updateOverallEligibilityUi(studentId);
    });
    document.getElementById('btn_reset').addEventListener('click', () => {
        selectedStudents = [];
        renderSelectedStudents();
        setDateRange(null, null);
        setActiveRangeChip('');
        cellDetailByKey.clear();
        document.getElementById('resultsContainer').classList.add('d-none');
        document.getElementById('studentReportSections').innerHTML = '';
        sarExportPlan = null;
    });

    document.querySelectorAll('.btn-range').forEach((btn) => {
        btn.addEventListener('click', (event) => {
            const range = event.currentTarget.getAttribute('data-range');
            const today = new Date();
            let start;
            let end;
            if (range === 'today') {
                start = startOfLocalDay(today);
                end = new Date(start);
            } else if (range === 'twoWeeks') {
                const day = today.getDay() || 7;
                start = startOfLocalDay(today);
                start.setDate(today.getDate() - (day - 1));
                end = new Date(start);
                end.setDate(start.getDate() + 13);
            } else if (range === 'thisWeek') {
                const day = today.getDay() || 7;
                start = startOfLocalDay(today);
                start.setDate(today.getDate() - (day - 1));
                end = new Date(start);
                end.setDate(start.getDate() + 6);
            } else if (range === 'prevWeek') {
                const day = today.getDay() || 7;
                start = startOfLocalDay(today);
                start.setDate(today.getDate() - (day - 1) - 7);
                end = new Date(start);
                end.setDate(start.getDate() + 6);
            } else if (range === 'thisMonth') {
                start = new Date(today.getFullYear(), today.getMonth(), 1);
                end = new Date(today.getFullYear(), today.getMonth() + 1, 0);
            } else if (range === 'prevMonth') {
                start = new Date(today.getFullYear(), today.getMonth() - 1, 1);
                end = new Date(today.getFullYear(), today.getMonth(), 0);
            } else {
                return;
            }
            setDateRange(start, end);
            setActiveRangeChip(range);
            if (selectedStudents.length) {
                loadStudentAttendanceReport().catch((error) => showReportMessage({ icon: 'error', message: error.message || 'Load failed.' }));
            }
        });
    });

    if (initialStartDate) document.getElementById('filter_startDate').value = initialStartDate;
    if (initialEndDate) document.getElementById('filter_endDate').value = initialEndDate;
    if (initialStudents.length) {
        selectedStudents = initialStudents.map((row) => ({
            id: String(row.studentRecordId || '').trim(),
            studentRecordId: String(row.studentRecordId || '').trim(),
            personId: String(row.personId || '').trim(),
            name: String(row.name || row.studentRecordId || '').trim()
        })).filter((row) => row.studentRecordId);
        renderSelectedStudents();
    } else if (initialStudentIds.length) {
        selectedStudents = initialStudentIds.map((id) => ({
            id,
            studentRecordId: id,
            name: `Student ${id}`
        }));
        renderSelectedStudents();
    } else {
        renderSelectedStudents();
        const today = new Date();
        const day = today.getDay() || 7;
        const start = startOfLocalDay(today);
        start.setDate(today.getDate() - (day - 1));
        const end = new Date(start);
        end.setDate(start.getDate() + 6);
        setDateRange(start, end);
        setActiveRangeChip('thisWeek');
    }

    syncSarUrlFromFilters();

    if ((initialStudents.length || initialStudentIds.length) && initialStartDate && initialEndDate) {
        loadStudentAttendanceReport().catch((error) => showReportMessage({ icon: 'error', message: error.message || 'Load failed.' }));
    }
})();
</script>
