function isAttendanceDetailsModalDirty() {
    if (!detailsModalSnapshot) return false;
    const current = captureAttendanceDetailsModalSnapshot();
    return Object.keys(current).some((key) => current[key] !== detailsModalSnapshot[key]);
}

document.addEventListener('DOMContentLoaded', () => {
    function bindCollapseToggle(options = {}) {
        const collapseEl = document.getElementById(String(options.collapseId || ''));
        const buttonEl = document.getElementById(String(options.buttonId || ''));
        const iconEl = document.getElementById(String(options.iconId || ''));
        if (!collapseEl || !buttonEl || !iconEl) return;
        const setState = (open) => {
            iconEl.className = open ? 'bi bi-chevron-up' : 'bi bi-chevron-down';
            buttonEl.setAttribute('aria-expanded', open ? 'true' : 'false');
            buttonEl.setAttribute('aria-label', open ? 'Close filters' : 'Open filters');
        };
        setState(collapseEl.classList.contains('show'));
        collapseEl.addEventListener('shown.bs.collapse', () => setState(true));
        collapseEl.addEventListener('hidden.bs.collapse', () => setState(false));
    }
    bindCollapseToggle({
        collapseId: 'attFilterCollapse',
        buttonId: 'attFilterToggleBtn',
        iconId: 'attFilterToggleIcon'
    });

    const actionStateId = '<%= (typeof actionStateId !== 'undefined' && actionStateId) ? actionStateId : '' %>';
    setAttendanceActionStateId(actionStateId);
    setAttendanceBudgetState(window.ATTENDANCE_ACTION_LIMITS || {});
    syncAttendanceRequestBudgetFromUsage();
    window.CAN_EDIT_ATTENDANCE_ROSTER = <%= (typeof canEditAttendanceRoster !== 'undefined' && canEditAttendanceRoster) ? 'true' : 'false' %>;
    window.CAN_MARK_ATTENDANCE_EXCUSED = <%= (typeof canMarkAttendanceExcused !== 'undefined' && canMarkAttendanceExcused) ? 'true' : 'false' %>;
    window.CAN_OVERRIDE_SESSION_LOCK = <%= (typeof canOverrideSessionLock !== 'undefined' && canOverrideSessionLock) ? 'true' : 'false' %>;

    if (typeof bootstrap !== 'undefined') {
        detailsModalInstance = new bootstrap.Modal(document.getElementById('cellDetailsModal'));
    }

    const cellDetailsModalEl = document.getElementById('cellDetailsModal');
    if (cellDetailsModalEl) {
        cellDetailsModalEl.addEventListener('hide.bs.modal', (event) => {
            if (detailsModalAllowClose) {
                detailsModalAllowClose = false;
                detailsModalSnapshot = null;
                return;
            }
            if (!isAttendanceDetailsModalDirty()) return;
            event.preventDefault();
            void (async () => {
                const discard = await showAttendanceMatrixMessage({
                    title: 'Unsaved attendance details',
                    icon: 'warning',
                    message: '<p class="mb-0">You have unsaved late/early minutes, excuse details, or a note draft. Close without applying them?</p>',
                    buttons: [
                        { text: 'Keep editing', class: 'btn-secondary', value: false },
                        { text: 'Discard changes', class: 'btn-danger', value: true }
                    ]
                });
                if (!(discard === true || discard?.value === true || discard === 'Discard changes')) return;
                detailsModalAllowClose = true;
                if (detailsModalInstance) detailsModalInstance.hide();
            })();
        });
    }

    // --- 1. Date Range Logic (local calendar dates for YYYY-MM-DD inputs) ---
    const toYmd = (d) => {
        if (!d) return '';
        const y = d.getFullYear();
        const m = String(d.getMonth() + 1).padStart(2, '0');
        const day = String(d.getDate()).padStart(2, '0');
        return `${y}-${m}-${day}`;
    };
    const setDateRange = (start, end) => {
        document.getElementById('filter_startDate').value = start ? toYmd(start) : '';
        document.getElementById('filter_endDate').value = end ? toYmd(end) : '';
    };
    const startOfLocalDay = (d) => new Date(d.getFullYear(), d.getMonth(), d.getDate());

    function setActiveRangeChip(range) {
        document.querySelectorAll('.btn-range.range-chip').forEach((btn) => {
            btn.classList.toggle('active', btn.getAttribute('data-range') === range);
        });
    }

    function normalizeAttendanceRangeToken(raw) {
        const token = String(raw || '').trim();
        if (!token) return '';
        const lower = token.toLowerCase();
        if (lower === 'alltime' || lower === 'all_time') return 'allTime';
        const known = ['today', 'twoWeeks', 'thisWeek', 'prevWeek', 'thisMonth', 'prevMonth'];
        return known.find((key) => key.toLowerCase() === lower) || '';
    }

    function computeAttendanceRangeDates(range) {
        const today = new Date();
        let start;
        let end;
        if (range === 'today') {
            start = startOfLocalDay(today);
            end = new Date(start);
        } else if (range === 'twoWeeks') {
            const day = today.getDay() || 7;
            start = startOfLocalDay(today);
            start.setDate(today.getDate() - (day - 1));
            end = new Date(start);
            end.setDate(start.getDate() + 13);
        } else if (range === 'thisWeek') {
            const day = today.getDay() || 7;
            start = startOfLocalDay(today);
            start.setDate(today.getDate() - (day - 1));
            end = new Date(start);
            end.setDate(start.getDate() + 6);
        } else if (range === 'prevWeek') {
            const day = today.getDay() || 7;
            start = startOfLocalDay(today);
            start.setDate(today.getDate() - (day - 1) - 7);
            end = new Date(start);
            end.setDate(start.getDate() + 6);
        } else if (range === 'thisMonth') {
            start = new Date(today.getFullYear(), today.getMonth(), 1);
            end = new Date(today.getFullYear(), today.getMonth() + 1, 0);
        } else if (range === 'prevMonth') {
            start = new Date(today.getFullYear(), today.getMonth() - 1, 1);
            end = new Date(today.getFullYear(), today.getMonth(), 0);
        } else {
            return null;
        }
        return { start, end };
    }

    function applyAttendanceRangeSelection(range, { autoLoad = true } = {}) {
        const token = normalizeAttendanceRangeToken(range);
        if (!token) return false;
        if (token === 'allTime') {
            setDateRange(null, null);
            setActiveRangeChip('allTime');
            if (autoLoad && document.getElementById('filter_classId').value) {
                document.getElementById('btn_loadData').click();
            }
            return true;
        }
        const dates = computeAttendanceRangeDates(token);
        if (!dates) return false;
        setDateRange(dates.start, dates.end);
        setActiveRangeChip(token);
        if (autoLoad && document.getElementById('filter_classId').value) {
            document.getElementById('btn_loadData').click();
        }
        return true;
    }

    document.querySelectorAll('.btn-range').forEach(btn => {
        btn.addEventListener('click', (e) => {
            const range = e.currentTarget.getAttribute('data-range');
            applyAttendanceRangeSelection(range);
        });
    });

    function setAttendancePrintEnabled(enabled) {
        const printBtn = document.getElementById('btn_printAttendanceMatrix');
        if (printBtn) {
            printBtn.disabled = !enabled;
            printBtn.title = enabled ? 'Print attendance matrix for the loaded range' : 'Load the matrix first';
        }
        const exportBtn = document.getElementById('btn_exportAttendanceExcel');
        if (exportBtn) {
            exportBtn.disabled = !enabled;
            exportBtn.title = enabled ? 'Export attendance matrix to Excel for the loaded range' : 'Load the matrix first';
        }
    }

    function exportAttendanceExcel() {
        if (!window.currentMatrixData || window.currentMatrixData.status !== 'success') {
            showAttendanceMatrixMessage({
                title: 'Nothing to export',
                icon: 'warning',
                message: 'Load an attendance matrix for a class first.',
                buttons: [{ text: 'Close', class: 'btn-secondary' }]
            });
            return;
        }
        const classId = String(document.getElementById('filter_classId')?.value || window.currentMatrixData.classId || '').trim();
        const startDate = String(document.getElementById('filter_startDate')?.value || '').trim();
        const endDate = String(document.getElementById('filter_endDate')?.value || '').trim();
        if (!classId) {
            showAttendanceMatrixMessage({
                title: 'Class required',
                icon: 'warning',
                message: 'Select a class and load the matrix before exporting.',
                buttons: [{ text: 'Close', class: 'btn-secondary' }]
            });
            return;
        }
        const params = new URLSearchParams({ classId });
        if (startDate) params.set('startDate', startDate);
        if (endDate) params.set('endDate', endDate);
        const visibleIds = Array.from(getAttendanceVisiblePersonIds() || []).filter(Boolean);
        params.set('personIds', visibleIds.join(','));
        const sessionIds = (window.currentMatrixData?.sessions || [])
            .map((sessionRow) => String(sessionRow?.id || '').trim())
            .filter(Boolean);
        if (sessionIds.length) params.set('sessionIds', sessionIds.join(','));
        window.location.href = `/school/attendances/api/export.xlsx?${params.toString()}`;
    }

    document.getElementById('btn_clearClass')?.addEventListener('click', () => {
        document.getElementById('filter_classId').value = '';
        document.getElementById('filter_className').value = '';
        document.getElementById('resultsContainer').classList.add('d-none');
        window.currentMatrixData = null;
        window.attendanceVisiblePersonIds = null;
        setAttendancePrintEnabled(false);
    });

    document.getElementById('btn_reset')?.addEventListener('click', () => {
        document.getElementById('filter_classId').value = '';
        document.getElementById('filter_className').value = '';
        document.getElementById('filter_startDate').value = '';
        document.getElementById('filter_endDate').value = '';
        document.getElementById('resultsContainer').classList.add('d-none');
        window.currentMatrixData = null;
        window.attendanceVisiblePersonIds = null;
        setAttendancePrintEnabled(false);
        setActiveRangeChip('');
    });

    // --- 2. Pickers ---
    const btnPicker = document.getElementById('btn_openClassPicker');
    if (btnPicker) {
        btnPicker.addEventListener('click', () => {
            GenericPicker.open(GenericPickerPresets.class({
                title: 'Select Class',
                icon: 'bi-book',
                onSelect: (item) => {
                    document.getElementById('filter_classId').value = item.id;
                    document.getElementById('filter_className').value = item.title || item.id;
                    document.getElementById('btn_loadData').click();
                }
            }));
        });
    }

    document.getElementById('btn_mentionUser').addEventListener('click', () => {
        GenericPicker.open(GenericPickerPresets.user({
            title: 'Tag User',
            icon: 'bi-at',
            apiEndpoint: '/school/identity/api/taggable-users',
            placeholder: 'Search for a user...',
            onSelect: (item) => {
                const mentionId = item.userId || item.id;
                const name = item.displayName || item.name || item.email || mentionId;
                if (mentionId && mentionId !== 'undefined' && !currentMentions.find(m => m.id === mentionId)) {
                    currentMentions.push({
                        id: mentionId,
                        name: name,
                        email: item.email || ''
                    });
                    renderMentions();
                } else if (!mentionId || mentionId === 'undefined') {
                    showAttendanceMatrixMessage({
                        title: 'Tag User',
                        icon: 'error',
                        message: 'Could not retrieve a valid user ID.'
                    });
                }
            }
        }));
    });

    function renderMentions() {
        const area = document.getElementById('pendingMentionsArea');
        area.innerHTML = '';
        currentMentions.forEach(m => {
            area.innerHTML += `<span class="mention-badge shadow-sm">@${m.name} <i class="bi bi-x-circle ms-1" style="cursor:pointer;" onclick="removeMention('${m.id}')"></i></span>`;
        });
    }
    
    window.removeMention = (id) => {
        currentMentions = currentMentions.filter(m => m.id !== id);
        renderMentions();
    };

    // --- 3. Render Engine ---
    const MATRIX_STUDENT_WINDOW = 50;
    const MATRIX_SESSION_WINDOW = 20;
    const attMatrixWindowState = {
        loadedStudents: 0,
        loadedSessions: 0,
        hasMoreStudents: false,
        hasMoreSessions: false,
        loading: false
    };

    function buildAttendanceSessionHeaderCell(classId, sessionRow) {
        const d = new Date(sessionRow.date + 'T00:00:00');
        const shortDate = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
        return `<th class="att-cell text-primary small fw-bold text-decoration-underline" style="cursor:pointer;" title="Click to open Session Manager" onclick="confirmOpenSession('${classId}', '${sessionRow.id}')">${shortDate}</th>`;
    }

    function buildTimingExcuseIcon(innerIcon, ringClass) {
        if (window.AttendanceMarkAppearance?.buildTimingExcuseIcon) {
            return window.AttendanceMarkAppearance.buildTimingExcuseIcon(innerIcon, ringClass);
        }
        return `<span class="attendance-timing-excuse-icon ${ringClass}">${innerIcon}</span>`;
    }

    function buildLateTimingIcon(rec) {
        const late = Number(rec?.lateMinutes) || 0;
        const early = Number(rec?.earlyLeaveMinutes) || 0;
        const lateExcused = late > 0 && attendanceFlagIsTrue(rec?.lateExcused);
        const earlyExcused = early > 0 && attendanceFlagIsTrue(rec?.earlyLeaveExcused);
        const icon = window.AttendanceMarkAppearance?.buildMarkIconHtml
            ? window.AttendanceMarkAppearance.buildMarkIconHtml('late')
            : '<i class="bi bi-clock-fill status-late"></i>';
        if (lateExcused && earlyExcused) return buildTimingExcuseIcon(icon, 'attendance-timing-excuse-full');
        if (lateExcused) return buildTimingExcuseIcon(icon, 'attendance-timing-excuse-left');
        if (earlyExcused) return buildTimingExcuseIcon(icon, 'attendance-timing-excuse-right');
        return icon;
    }

    function buildTimingExcuseTooltip(rec, baseText) {
        const late = Number(rec?.lateMinutes) || 0;
        const early = Number(rec?.earlyLeaveMinutes) || 0;
        const parts = [baseText];
        if (late > 0 && attendanceFlagIsTrue(rec?.lateExcused)) parts.push('late arrival excused');
        if (early > 0 && attendanceFlagIsTrue(rec?.earlyLeaveExcused)) parts.push('left early excused');
        if (isAbsentLikeAttendanceStatus(rec?.status) && attendanceAbsenceIsExcused(rec)) parts.push('absence excused');
        return parts.join(' - ');
    }

    function buildAttendanceRecordCell(stu, rec) {
        const markAppearance = window.AttendanceMarkAppearance;
        const buildIcon = (key, ringClass) => {
            if (markAppearance?.buildMarkIconHtml) {
                return ringClass
                    ? markAppearance.buildMarkIconHtml(key, { ringClass })
                    : markAppearance.buildMarkIconHtml(key);
            }
            return '';
        };
        let icon = buildIcon('unmarked') || '<i class="bi bi-dash text-muted"></i>';
        let tooltip = 'Not marked yet';
        if (rec.status === 'present') { icon = buildIcon('present'); tooltip = markAppearance?.getMark('present')?.label || 'Present'; }
        else if (rec.status === 'late') { icon = buildLateTimingIcon(rec); tooltip = buildTimingExcuseTooltip(rec, markAppearance?.getMark('late')?.label || 'Late'); }
        else if (rec.status === 'excused' || (rec.status === 'absent' && attendanceAbsenceIsExcused(rec))) {
            icon = buildIcon('excused_absence', 'attendance-timing-excuse-full');
            tooltip = markAppearance?.getMark('excused_absence')?.label || 'Excused absence';
        }
        else if (rec.status === 'absent') { icon = buildIcon('absent'); tooltip = markAppearance?.getMark('absent')?.label || 'Absent'; }
        else if (rec.status === 'acf' && attendanceAbsenceIsExcused(rec)) {
            icon = buildIcon('excused_absence', 'attendance-timing-excuse-full');
            tooltip = markAppearance?.getMark('excused_absence')?.label || 'Excused ACF';
        }
        else if (rec.status === 'acf') { icon = buildIcon('acf'); tooltip = markAppearance?.getMark('acf')?.label || 'Absent Camera Off'; }
        else if (rec.status === 'not_applicable') {
            icon = buildIcon('not_applicable');
            tooltip = rec.withinEnrollmentWindow === false
                ? 'N/A - not enrolled for this session'
                : (rec.applicability === 'approved_leave'
                    ? 'N/A - approved leave'
                    : (rec.applicability === 'makeup_required' ? 'N/A - make-up session required' : (markAppearance?.getMark('not_applicable')?.label || 'N/A')));
        }
        const hasComments = (rec.comments && rec.comments.length > 0);
        const noteBadge = hasComments
            ? `<div class="position-absolute top-0 end-0 pe-1 pt-1">${buildIcon('notes', '') || '<i class="bi bi-chat-dots-fill status-notes" style="font-size: 0.65rem;"></i>'}</div>`
            : '';
        const classId = String(window.currentMatrixData?.classId || document.getElementById('filter_classId')?.value || '').trim();
        const historyBtn = window.attendanceHistoryModeOn
            ? `<button type="button" class="btn btn-link btn-sm p-0 position-absolute top-0 start-0 ps-1 pt-1 attendance-cell-history-btn" title="View change history" aria-label="View change history" data-class-id="${attEscapeHtml(classId)}" data-session-id="${attEscapeHtml(rec.sessionId)}" data-session-date="${attEscapeHtml(rec.date || '')}" data-person-id="${attEscapeHtml(stu.personId)}" data-student-name="${attEscapeHtml(stu.name || '')}" onclick="event.stopPropagation(); openAttendanceCellHistory(this);"><i class="bi bi-info-circle" style="font-size:0.65rem;"></i></button>`
            : '';
        return `<td class="att-cell" title="${tooltip} (Click for Details)" onclick="openInteractiveModal('${stu.personId}', '${rec.sessionId}')">${historyBtn}${icon}${noteBadge}</td>`;
    }

    function formatAttendanceHistorySessionDate(ymd) {
        const raw = String(ymd || '').trim();
        if (!/^\d{4}-\d{2}-\d{2}$/.test(raw)) return raw || '';
        const d = new Date(`${raw}T00:00:00`);
        if (Number.isNaN(d.getTime())) return raw;
        return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    }

    function resolveAttendanceHistoryStudentName(personId, buttonEl) {
        const fromDataset = String(buttonEl?.dataset?.studentName || '').trim();
        if (fromDataset) return fromDataset;
        const row = (window.currentMatrixData?.matrix || []).find((stu) => String(stu?.personId || '').trim() === String(personId || '').trim());
        return String(row?.name || personId || '').trim() || 'Student';
    }

    function buildHistoryAttendanceSnapshot(entry, side) {
        const prefix = side === 'to' ? 'to' : 'from';
        return {
            status: String(entry?.[`${prefix}Status`] || '').trim(),
            lateMinutes: Number(entry?.[`${prefix}LateMinutes`]) || 0,
            earlyLeaveMinutes: Number(entry?.[`${prefix}EarlyLeaveMinutes`]) || 0,
            lateExcused: attendanceFlagIsTrue(entry?.[`${prefix}LateExcused`]),
            earlyLeaveExcused: attendanceFlagIsTrue(entry?.[`${prefix}EarlyLeaveExcused`]),
            absenceExcused: attendanceFlagIsTrue(entry?.[`${prefix}AbsenceExcused`])
        };
    }

    function buildHistoryAttendanceIcon(snapshot) {
        const markAppearance = window.AttendanceMarkAppearance;
        const buildIcon = (key, ringClass) => {
            if (markAppearance?.buildMarkIconHtml) {
                return ringClass
                    ? markAppearance.buildMarkIconHtml(key, { ringClass })
                    : markAppearance.buildMarkIconHtml(key);
            }
            return '';
        };
        const rec = snapshot || {};
        if (!rec.status) return buildIcon('unmarked') || '<i class="bi bi-dash text-muted"></i>';
        if (rec.status === 'present') return buildIcon('present');
        if (rec.status === 'late') return buildLateTimingIcon(rec);
        if (rec.status === 'excused' || (rec.status === 'absent' && attendanceAbsenceIsExcused(rec))) {
            return buildIcon('excused_absence', 'attendance-timing-excuse-full');
        }
        if (rec.status === 'absent') return buildIcon('absent');
        if (rec.status === 'acf' && attendanceAbsenceIsExcused(rec)) {
            return buildIcon('excused_absence', 'attendance-timing-excuse-full');
        }
        if (rec.status === 'acf') return buildIcon('acf');
        if (rec.status === 'not_applicable') return buildIcon('not_applicable');
        return buildIcon('unmarked') || '<i class="bi bi-dash text-muted"></i>';
    }

    function buildHistoryAttendanceTimingText(snapshot) {
        const rec = snapshot || {};
        const parts = [];
        const late = Number(rec.lateMinutes) || 0;
        const early = Number(rec.earlyLeaveMinutes) || 0;
        if (late > 0) {
            parts.push(`Late ${late} min${late === 1 ? '' : 's'}${attendanceFlagIsTrue(rec.lateExcused) ? ' (excused)' : ''}`);
        }
        if (early > 0) {
            parts.push(`Left early ${early} min${early === 1 ? '' : 's'}${attendanceFlagIsTrue(rec.earlyLeaveExcused) ? ' (excused)' : ''}`);
        }
        return parts.join(' · ');
    }

    function buildHistoryAttendanceCellHtml(entry, side) {
        const snapshot = buildHistoryAttendanceSnapshot(entry, side);
        const label = side === 'to'
            ? (entry?.toLabel || entry?.toStatus || 'Unmarked')
            : (entry?.fromLabel || entry?.fromStatus || 'Unmarked');
        const timingText = buildHistoryAttendanceTimingText(snapshot);
        const timingHtml = timingText
            ? `<div class="attendance-history-status-timing">${attEscapeHtml(timingText)}</div>`
            : '';
        return `
            <div class="attendance-history-status-cell">
                <div class="attendance-history-status-icon">${buildHistoryAttendanceIcon(snapshot)}</div>
                <div class="attendance-history-status-text">
                    <div class="attendance-history-status-label">${attEscapeHtml(label)}</div>
                    ${timingHtml}
                </div>
            </div>
        `;
    }

    function formatAttendanceHistoryWhen(isoValue) {
        const raw = String(isoValue || '').trim();
        if (!raw) return '—';
        const date = new Date(raw);
        if (Number.isNaN(date.getTime())) return raw;
        return date.toLocaleString();
    }

    function renderAttendanceCellHistoryTable(entries) {
        const tbody = document.getElementById('attendanceCellHistoryBody');
        const emptyEl = document.getElementById('attendanceCellHistoryEmpty');
        const tableEl = document.getElementById('attendanceCellHistoryTable');
        if (!tbody || !emptyEl || !tableEl) return;
        const rows = Array.isArray(entries) ? entries : [];
        if (!rows.length) {
            tbody.innerHTML = '';
            tableEl.classList.add('d-none');
            emptyEl.classList.remove('d-none');
            return;
        }
        tableEl.classList.remove('d-none');
        emptyEl.classList.add('d-none');
        tbody.innerHTML = rows.map((entry) => `
            <tr>
                <td>${attEscapeHtml(formatAttendanceHistoryWhen(entry.changedAt))}</td>
                <td>${attEscapeHtml(entry?.changedBy?.displayName || entry?.changedBy?.username || entry?.changedBy?.userId || '—')}</td>
                <td>${buildHistoryAttendanceCellHtml(entry, 'from')}</td>
                <td>${buildHistoryAttendanceCellHtml(entry, 'to')}</td>
            </tr>
        `).join('');
    }

    function entrySessionDateFromMatrix(personId, sessionId) {
        const row = (window.currentMatrixData?.matrix || []).find((stu) => String(stu?.personId || '').trim() === String(personId || '').trim());
        const rec = (row?.records || []).find((item) => String(item?.sessionId || '').trim() === String(sessionId || '').trim());
        return String(rec?.date || '').trim();
    }

    async function fetchAttendanceChangeLogForCell({ classId, sessionId, personId }) {
        if (!(await ensureAttendanceRequestBudgetAvailable())) {
            throw new Error(ATTENDANCE_ACTION_STATE_HANDLED_ERROR);
        }
        const params = new URLSearchParams({
            classId: String(classId || '').trim(),
            sessionId: String(sessionId || '').trim(),
            studentPersonId: String(personId || '').trim()
        });
        const res = await fetch(`/school/attendances/api/change-log?${params.toString()}`, {
            headers: { 'X-AJAX-Request': 'true' }
        });
        const result = await res.json();
        hydrateAttendanceBudgetFromApi(res, result, { estimateAttempt: true, source: 'change-log' });
        if (result.status !== 'success') {
            const handled = await handleAttendanceActionStateFailure(result);
            if (handled) throw new Error(ATTENDANCE_ACTION_STATE_HANDLED_ERROR);
            throw new Error(result.message || 'Unable to load change history.');
        }
        return Array.isArray(result.entries) ? result.entries : [];
    }

    async function openAttendanceCellHistory(buttonEl) {
        const classId = String(buttonEl?.dataset?.classId || '').trim();
        const sessionId = String(buttonEl?.dataset?.sessionId || '').trim();
        const personId = String(buttonEl?.dataset?.personId || '').trim();
        if (!classId || !sessionId || !personId) return;

        const metaEl = document.getElementById('attendanceCellHistoryMeta');
        const loadingEl = document.getElementById('attendanceCellHistoryLoading');
        const modalEl = document.getElementById('attendanceCellHistoryModal');
        if (!modalEl) return;

        if (metaEl) {
            const studentName = resolveAttendanceHistoryStudentName(personId, buttonEl);
            const sessionDate = formatAttendanceHistorySessionDate(buttonEl?.dataset?.sessionDate || entrySessionDateFromMatrix(personId, sessionId));
            metaEl.textContent = sessionDate ? `${studentName} · ${sessionDate}` : studentName;
        }
        renderAttendanceCellHistoryTable([]);
        if (loadingEl) loadingEl.classList.remove('d-none');
        bootstrap.Modal.getOrCreateInstance(modalEl).show();

        try {
            const entries = await fetchAttendanceChangeLogForCell({ classId, sessionId, personId });
            renderAttendanceCellHistoryTable(entries);
        } catch (error) {
            if (isHandledAttendanceActionStateError(error)) return;
            renderAttendanceCellHistoryTable([]);
            if (metaEl) metaEl.textContent = error.message || 'Unable to load change history.';
        } finally {
            if (loadingEl) loadingEl.classList.add('d-none');
        }
    }
    window.openAttendanceCellHistory = openAttendanceCellHistory;

    function rerenderAttendanceMatrixCellsForHistoryMode() {
        const data = window.currentMatrixData;
        if (!data?.matrix) return;
        data.matrix.forEach((stu) => {
            const personId = String(stu?.personId || '').trim();
            if (!personId) return;
            const rowEl = document.querySelector(`tr.matrix-student-row[data-person-id="${CSS.escape(personId)}"]`);
            if (!rowEl) return;
            const cells = rowEl.querySelectorAll('td.att-cell');
            (stu.records || []).forEach((rec, index) => {
                const targetCell = cells[index];
                if (!targetCell) return;
                const template = document.createElement('template');
                template.innerHTML = buildAttendanceRecordCell(stu, rec).trim();
                const replacement = template.content.firstElementChild;
                if (replacement) targetCell.replaceWith(replacement);
            });
        });
    }

    function setAttendanceHistoryMode(enabled) {
        window.attendanceHistoryModeOn = Boolean(enabled);
        const resultsContainer = document.getElementById('resultsContainer');
        const toggleBtn = document.getElementById('btn_attendanceMatrixHistory');
        if (resultsContainer) {
            resultsContainer.classList.toggle('attendance-history-mode-on', window.attendanceHistoryModeOn);
        }
        if (toggleBtn) {
            toggleBtn.classList.toggle('active', window.attendanceHistoryModeOn);
            toggleBtn.setAttribute('aria-pressed', window.attendanceHistoryModeOn ? 'true' : 'false');
        }
        rerenderAttendanceMatrixCellsForHistoryMode();
    }

    function buildAttendanceStudentRowHtml(stu) {
        const personId = String(stu?.personId || '').trim();
        const s = stu.summary || {};
        const p = Number(s.totalPresentSessions) || 0;
        const a = Number(s.totalAbsentSessions) || 0;
        const na = Number(s.totalNotApplicableSessions) || 0;
        const pct = s.performancePercent;
        const pctStr = pct == null ? '—' : `${pct}%`;
        const rollupTitle = [
            `Present (marked): ${p}`,
            `Absent: ${a}`,
            na ? `N/A: ${na}` : null,
            `Efficiency: ${pctStr}`
        ].filter(Boolean).join(' · ');
        let rowHtml = `
          <td class="matrix-sticky-rollup px-2 py-2 text-center small" title="${rollupTitle.replace(/"/g, '&quot;')}">
            <div><span class="text-success fw-semibold">${p}</span><span class="text-muted"> / </span><span class="text-danger fw-semibold">${a}</span>${na ? `<span class="text-muted"> / </span><span class="text-secondary fw-semibold">${na}</span>` : ''}</div>
            <div class="fw-bold text-primary mt-1" style="font-size: 0.9rem;">${pctStr}</div>
          </td>
          <td class="ps-3 matrix-sticky-name">${typeof schoolRenderStudentNameHtml === 'function' ? schoolRenderStudentNameHtml(stu.name, stu.studentRecordId, { className: 'text-decoration-none fw-bold' }) : stu.name}</td>`;
        (stu.records || []).forEach((rec) => {
            rowHtml += buildAttendanceRecordCell(stu, rec);
        });
        return `<tr class="matrix-student-row" data-person-id="${attEscapeHtml(personId)}">${rowHtml}</tr>`;
