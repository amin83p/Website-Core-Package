function attendanceFlagIsTrue(value) {
    return value === true || value === 1 || ['true', '1', 'yes', 'on'].includes(String(value || '').trim().toLowerCase());
}

function parseAttendanceMinutesInputValue(id) {
    const input = document.getElementById(id);
    const n = Number(input?.value || 0);
    return Number.isFinite(n) && n > 0 ? Math.floor(n) : 0;
}

function attendanceCanMarkExcused() {
    return window.CAN_MARK_ATTENDANCE_EXCUSED === true;
}

function syncExcuseNotesAccess(record = null) {
    const canMark = attendanceCanMarkExcused();
    const editorWrap = document.getElementById('wrap_cellExcuseNotesEditor');
    const readonlyWrap = document.getElementById('wrap_cellExcuseNotesReadonly');
    const notesWrap = document.getElementById('wrap_cellExcuseNotes');
    if (!notesWrap) return;
    if (canMark) {
        notesWrap.classList.remove('d-none');
        if (editorWrap) editorWrap.classList.remove('d-none');
        if (readonlyWrap) readonlyWrap.classList.add('d-none');
        return;
    }
    const excuseRef = String(record?.excuseRef || document.getElementById('inp_cellExcuseRef')?.value || '').trim();
    const excuseAttachment = record?.excuseAttachment || window.currentAttendanceExcuseAttachment || null;
    const hasExcuseData = Boolean(excuseRef || excuseAttachment);
    if (editorWrap) editorWrap.classList.add('d-none');
    if (readonlyWrap) {
        if (hasExcuseData) {
            const parts = [];
            if (excuseRef) parts.push(`<div class="text-muted">${attendanceAttachmentEscape(excuseRef).replace(/\n/g, '<br>')}</div>`);
            if (excuseAttachment) {
                parts.push(renderAttendanceAttachmentLink(excuseAttachment, '<span class="text-muted">No file attached.</span>'));
            }
            readonlyWrap.innerHTML = parts.join('');
            readonlyWrap.classList.remove('d-none');
            notesWrap.classList.remove('d-none');
        } else {
            readonlyWrap.innerHTML = '';
            readonlyWrap.classList.add('d-none');
            notesWrap.classList.add('d-none');
        }
    } else {
        notesWrap.classList.toggle('d-none', !hasExcuseData);
    }
}

function syncTimingExcuseControl({ minutesInputId, checkboxId, wrapperId, buttonId, inactiveText, activeText }) {
    const minutes = parseAttendanceMinutesInputValue(minutesInputId);
    const checkbox = document.getElementById(checkboxId);
    const wrapper = document.getElementById(wrapperId);
    const button = document.getElementById(buttonId);
    if (!checkbox || !wrapper) return false;
    if (!attendanceCanMarkExcused()) {
        checkbox.checked = false;
        wrapper.classList.add('d-none');
        return false;
    }
    if (minutes > 0) {
        wrapper.classList.remove('d-none');
        if (button) {
            const active = checkbox.checked === true;
            button.classList.toggle('btn-success', active);
            button.classList.toggle('btn-outline-success', !active);
            button.setAttribute('aria-pressed', active ? 'true' : 'false');
            button.innerHTML = active
                ? `<i class="bi bi-shield-check"></i><span>${activeText}</span>`
                : `<i class="bi bi-shield-plus"></i><span>${inactiveText}</span>`;
        }
        return checkbox.checked === true;
    }
    checkbox.checked = false;
    wrapper.classList.add('d-none');
    if (button) {
        button.classList.remove('btn-success');
        button.classList.add('btn-outline-success');
        button.setAttribute('aria-pressed', 'false');
        button.innerHTML = `<i class="bi bi-shield-plus"></i><span>${inactiveText}</span>`;
    }
    return false;
}

function syncAbsenceExcuseControl() {
    const attendance = document.querySelector('input[name="modal_cell_attendance"]:checked')?.value || '';
    const checkbox = document.getElementById('inp_cellAbsenceExcused');
    const wrapper = document.getElementById('wrap_cellAbsenceExcused');
    const button = document.getElementById('btn_cellAbsenceExcused');
    if (!checkbox || !wrapper) return false;
    if (!attendanceCanMarkExcused()) {
        checkbox.checked = false;
        wrapper.classList.add('d-none');
        return false;
    }
    if (!isAbsentLikeAttendanceStatus(attendance)) {
        checkbox.checked = false;
        wrapper.classList.add('d-none');
        if (button) {
            button.classList.remove('btn-success');
            button.classList.add('btn-outline-success');
            button.setAttribute('aria-pressed', 'false');
            button.innerHTML = '<i class="bi bi-shield-plus"></i><span>Mark absence excused</span>';
        }
        return false;
    }
    wrapper.classList.remove('d-none');
    if (button) {
        const active = checkbox.checked === true;
        button.classList.toggle('btn-success', active);
        button.classList.toggle('btn-outline-success', !active);
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
        button.innerHTML = active
            ? '<i class="bi bi-shield-check"></i><span>Absence excused</span>'
            : '<i class="bi bi-shield-plus"></i><span>Mark absence excused</span>';
    }
    return checkbox.checked === true;
}

function syncTimingExcuseControls() {
    syncTimingExcuseControl({
        minutesInputId: 'inp_cellLateMins',
