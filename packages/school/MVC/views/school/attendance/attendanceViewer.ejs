    function findAttendanceMatrixCellContext(studentPersonId, sessionId) {
        const data = window.currentMatrixData;
        if (!data || !Array.isArray(data.matrix) || !Array.isArray(data.sessions)) return null;
        const studentKey = String(studentPersonId || '').trim();
        const sessionKey = String(sessionId || '').trim();
        if (!studentKey || !sessionKey) return null;
        const studentIndex = data.matrix.findIndex((stu) => String(stu?.personId || '').trim() === studentKey);
        if (studentIndex < 0) return null;
        const student = data.matrix[studentIndex];
        const recordIndex = (student.records || []).findIndex((rec) => String(rec?.sessionId || '').trim() === sessionKey);
        if (recordIndex < 0) return null;
        const sessionIndex = data.sessions.findIndex((sessionRow) => String(sessionRow?.id || '').trim() === sessionKey);
        if (sessionIndex < 0) return null;
        const rowEl = document.querySelector(`#matrixBody tr.matrix-student-row[data-person-id="${CSS.escape(studentKey)}"]`);
        const cellEl = rowEl?.children?.[sessionIndex + 2] || null;
        return {
            student,
            recordIndex,
            sessionIndex,
            rowEl,
            cellEl
        };
    }

    function buildPatchedAttendanceRecord(existingRecord, payload, serverRecord) {
        const oldRecord = (existingRecord && typeof existingRecord === 'object') ? existingRecord : {};
        const resultRecord = (serverRecord && typeof serverRecord === 'object') ? serverRecord : {};
        const parseNonNegInt = (value, fallback = 0) => {
            const parsed = parseAttendanceNonNegativeInteger(value);
            if (parsed == null) return parseAttendanceNonNegativeInteger(fallback) ?? 0;
            return parsed;
        };
        const hasKey = (obj, key) => Object.prototype.hasOwnProperty.call(obj || {}, key);
        const nextStatus = String(resultRecord.attendance || payload?.attendance || oldRecord.status || '').trim().toLowerCase();
        const nextLateMinutes = parseNonNegInt(
            hasKey(resultRecord, 'lateMinutes') ? resultRecord.lateMinutes : payload?.lateMinutes,
            oldRecord.lateMinutes
        );
        const nextEarlyLeaveMinutes = parseNonNegInt(
            hasKey(resultRecord, 'earlyLeaveMinutes') ? resultRecord.earlyLeaveMinutes : payload?.earlyLeaveMinutes,
            oldRecord.earlyLeaveMinutes
        );
        const nextNotesRaw = hasKey(resultRecord, 'notes')
            ? resultRecord.notes
            : (payload?.notes !== undefined ? payload.notes : (oldRecord.rosterStudentNotes ?? oldRecord.notes));
        const nextExcuseRefRaw = hasKey(resultRecord, 'excuseRef')
            ? resultRecord.excuseRef
            : (payload?.excuseRef !== undefined ? payload.excuseRef : oldRecord.excuseRef);
        const nextExcuseAttachment = hasKey(resultRecord, 'excuseAttachment')
            ? resultRecord.excuseAttachment
            : (payload?.excuseAttachment !== undefined ? payload.excuseAttachment : oldRecord.excuseAttachment);
        return {
            ...oldRecord,
            status: nextStatus || oldRecord.status || 'absent',
            lateMinutes: nextLateMinutes,
            earlyLeaveMinutes: nextEarlyLeaveMinutes,
            lateExcused: hasKey(resultRecord, 'lateExcused')
                ? attendanceFlagIsTrue(resultRecord.lateExcused)
                : attendanceFlagIsTrue(payload?.lateExcused ?? oldRecord.lateExcused),
            earlyLeaveExcused: hasKey(resultRecord, 'earlyLeaveExcused')
                ? attendanceFlagIsTrue(resultRecord.earlyLeaveExcused)
                : attendanceFlagIsTrue(payload?.earlyLeaveExcused ?? oldRecord.earlyLeaveExcused),
            absenceExcused: hasKey(resultRecord, 'absenceExcused')
                ? attendanceFlagIsTrue(resultRecord.absenceExcused)
                : attendanceFlagIsTrue(payload?.absenceExcused ?? oldRecord.absenceExcused),
            excuseRef: String(nextExcuseRefRaw || '').trim(),
            excuseAttachment: (nextExcuseAttachment && typeof nextExcuseAttachment === 'object') ? nextExcuseAttachment : null,
            rosterStudentNotes: String(nextNotesRaw || '').trim(),
            notes: String(nextNotesRaw || '').trim()
        };
    }

    function patchAttendanceMatrixCellAfterSave({ studentPersonId, sessionId, payload, serverRecord }) {
        const cellContext = findAttendanceMatrixCellContext(studentPersonId, sessionId);
        if (!cellContext || !cellContext.student) return false;
        const previous = cellContext.student.records?.[cellContext.recordIndex];
        if (!previous) return false;
        const patchedRecord = buildPatchedAttendanceRecord(previous, payload, serverRecord);
        cellContext.student.records[cellContext.recordIndex] = patchedRecord;
        if (cellContext.cellEl) {
            const replacement = document.createElement('template');
            replacement.innerHTML = buildAttendanceRecordCell(cellContext.student, patchedRecord).trim();
            const nextCellEl = replacement.content.firstElementChild;
            if (nextCellEl) cellContext.cellEl.replaceWith(nextCellEl);
        }
        return true;
    }

    async function refreshAttendanceDisplayRollups(options = {}) {
        const data = window.currentMatrixData;
        if (!data?.classId || !Array.isArray(data.matrix)) return false;
        if (!(await ensureAttendanceRequestBudgetAvailable())) return false;
        const startDate = String(document.getElementById('filter_startDate')?.value || data.startDate || '').trim();
        const endDate = String(document.getElementById('filter_endDate')?.value || data.endDate || '').trim();
        const personIds = Array.isArray(options.personIds)
            ? options.personIds.map((id) => String(id || '').trim()).filter(Boolean)
            : [];
        try {
            const requestBody = {
                classId: data.classId,
                startDate,
                endDate
            };
            if (personIds.length) requestBody.personIds = personIds;
            const res = await fetch('/school/attendances/api/rollups', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-AJAX-Request': 'true' },
                body: JSON.stringify(requestBody)
            });
            const result = await res.json().catch(() => null);
            hydrateAttendanceBudgetFromApi(res, result, { estimateAttempt: true, source: 'rollups' });
            if (!result || result.status !== 'success') {
                const handled = await handleAttendanceActionStateFailure(result || {});
                if (handled) throw new Error(ATTENDANCE_ACTION_STATE_HANDLED_ERROR);
                return false;
            }
            const rollups = result.rollups || {};
            data.matrix.forEach((row) => {
                const key = String(row.personId || '');
                if (rollups[key]) row.summary = rollups[key];
            });
            updateAttendanceRollupDom(data.matrix);
            return true;
        } catch (error) {
            if (isHandledAttendanceActionStateError(error)) return false;
            return false;
        }
    }

    function queueAttendanceScopedRollupRefresh(studentPersonId, waitMs = 180) {
        const personId = String(studentPersonId || '').trim();
        if (personId) attendanceScopedRollupQueue.add(personId);
        return new Promise((resolve) => {
            attendanceScopedRollupWaiters.push(resolve);
            if (attendanceScopedRollupTimer) clearTimeout(attendanceScopedRollupTimer);
            const delay = Number.isFinite(Number(waitMs)) && Number(waitMs) >= 0 ? Number(waitMs) : 180;
            attendanceScopedRollupTimer = setTimeout(async () => {
                attendanceScopedRollupTimer = null;
                const queuedIds = Array.from(attendanceScopedRollupQueue);
                attendanceScopedRollupQueue.clear();
                const ok = queuedIds.length
                    ? await refreshAttendanceDisplayRollups({ personIds: queuedIds })
                    : true;
                const waiters = attendanceScopedRollupWaiters.splice(0, attendanceScopedRollupWaiters.length);
                waiters.forEach((fn) => {
                    try { fn(ok); } catch (_) {}
                });
            }, delay);
        });
    }

    function mergeAttendanceMatrixPayload(existing, chunk, mergeMode) {
        if (!mergeMode) return chunk;
        if (mergeMode === 'sessions') {
            const mergedMatrix = (existing.matrix || []).map((row, index) => ({
                ...row,
                records: [...(row.records || []), ...((chunk.matrix?.[index]?.records) || [])]
            }));
            return {
                ...existing,
                sessions: [...(existing.sessions || []), ...(chunk.sessions || [])],
                matrix: mergedMatrix,
                window: chunk.window || existing.window
            };
        }
        return {
            ...existing,
            matrix: [...(existing.matrix || []), ...(chunk.matrix || [])],
            window: chunk.window || existing.window
        };
    }

    function updateAttendanceWindowState(result, mergeMode) {
        const windowMeta = result.window || {};
        attMatrixWindowState.hasMoreStudents = Boolean(windowMeta.hasMoreStudents);
        attMatrixWindowState.hasMoreSessions = Boolean(windowMeta.hasMoreSessions);
        if (!mergeMode) {
            attMatrixWindowState.loadedStudents = (result.matrix || []).length;
            attMatrixWindowState.loadedSessions = (result.sessions || []).length;
            return;
        }
        if (mergeMode === 'sessions') {
            attMatrixWindowState.loadedSessions += (result.sessions || []).length;
        } else if (mergeMode === 'students') {
            attMatrixWindowState.loadedStudents += (result.matrix || []).length;
        }
    }

    async function loadAttendanceMatrixData(options = {}) {
        const classId = document.getElementById('filter_classId').value;
        const startDate = document.getElementById('filter_startDate').value;
        const endDate = document.getElementById('filter_endDate').value;
        const mergeMode = options.merge === 'sessions' || options.merge === 'students' ? options.merge : null;

        if (!classId) return;
        if (attMatrixWindowState.loading) return;
        if (!(await ensureAttendanceRequestBudgetAvailable())) return;

        const btn = document.getElementById('btn_loadData');
        const originalHtml = btn.innerHTML;
        const skipButtonBusy = options && options.skipButtonBusy === true;
        if (skipButtonBusy && options.loadingNote && typeof window.updateLoading === 'function') {
            window.updateLoading({
                title: options.loadingTitle || 'Refreshing Attendance Matrix',
                note: options.loadingNote,
                operation: 'Attendance Matrix'
            });
        }
        if (!skipButtonBusy) {
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
            btn.disabled = true;
        }

        attMatrixWindowState.loading = true;
        try {
            const params = new URLSearchParams({
                classId,
                startDate,
                endDate,
                studentOffset: String(mergeMode === 'students' ? attMatrixWindowState.loadedStudents : 0),
                studentLimit: String(mergeMode === 'sessions'
                    ? (attMatrixWindowState.loadedStudents || MATRIX_STUDENT_WINDOW)
                    : MATRIX_STUDENT_WINDOW),
                sessionOffset: String(mergeMode === 'sessions' ? attMatrixWindowState.loadedSessions : 0),
                sessionLimit: String(mergeMode === 'students'
                    ? (attMatrixWindowState.loadedSessions || MATRIX_SESSION_WINDOW)
                    : MATRIX_SESSION_WINDOW)
            });
            const sessionIdsFilter = String(
                options.sessionIds
                || new URLSearchParams(window.location.search).get('sessionIds')
                || ''
            ).trim();
            if (sessionIdsFilter) params.set('sessionIds', sessionIdsFilter);
            const url = `/school/attendances/api/data?${params.toString()}`;
            const res = await fetch(url, { cache: 'no-store', headers: { 'X-AJAX-Request': 'true' } });
            const chunk = await res.json();
            hydrateAttendanceBudgetFromApi(res, chunk, { estimateAttempt: true, source: 'matrix-load' });
            const guarded = typeof window.applyGuardedApiResult === 'function'
                ? await window.applyGuardedApiResult(chunk, { busyTitle: 'Load In Progress', replayTitle: 'Load Already Completed' })
                : { stop: false };
            if (guarded.stop) return;

            if (chunk.status !== 'success') {
                const handled = await handleAttendanceActionStateFailure(chunk);
                if (handled) throw new Error(ATTENDANCE_ACTION_STATE_HANDLED_ERROR);
                throw new Error(chunk.message);
            }

            const result = mergeMode && window.currentMatrixData
                ? mergeAttendanceMatrixPayload(window.currentMatrixData, chunk, mergeMode)
                : chunk;
            updateAttendanceWindowState(chunk, mergeMode);

            window.currentMatrixData = result;
            if (!mergeMode) {
                resetAttendanceStudentVisibility(result.matrix);
            }
            document.getElementById('resultsContainer').classList.remove('d-none');
            renderAttendanceMatrixLegend();
            setAttendancePrintEnabled(true);

            document.getElementById('filter_className').value = result.className || 'Loaded Class';
            document.getElementById('lbl_displayClassName').innerText = result.className || 'Class Attendance';

            const headers = document.getElementById('matrixHeaders');
            const tbody = document.getElementById('matrixBody');

            if (mergeMode === 'sessions') {
                (chunk.sessions || []).forEach((sessionRow) => {
                    headers.insertAdjacentHTML('beforeend', buildAttendanceSessionHeaderCell(classId, sessionRow));
                });
                tbody.querySelectorAll('tr.matrix-student-row').forEach((rowEl, index) => {
                    const studentRow = chunk.matrix?.[index];
                    if (!studentRow) return;
                    (studentRow.records || []).forEach((rec) => {
                        rowEl.insertAdjacentHTML('beforeend', buildAttendanceRecordCell(studentRow, rec));
                    });
                });
                bindAttendanceStudentVisibilityDropdown();
                applyAttendanceStudentVisibility();
                return;
            }

            if (mergeMode === 'students') {
                (chunk.matrix || []).forEach((stu) => {
                    tbody.insertAdjacentHTML('beforeend', buildAttendanceStudentRowHtml(stu));
                });
                bindAttendanceStudentVisibilityDropdown();
                applyAttendanceStudentVisibility();
                return;
            }

            headers.innerHTML = '';
            tbody.innerHTML = '';

            const policyTitle = 'Attendance rollup';
            const studentHeaderHtml = buildAttendanceStudentFilterDropdownHtml(
                result.matrix,
                getAttendanceVisiblePersonIds()
            );
            let headerHtml = `
              <th class="matrix-sticky-rollup text-center small px-2 py-2" title="${policyTitle.replace(/"/g, '&quot;')}">
                <div class="fw-bold text-secondary">Rollup</div>
                <div class="text-muted" style="font-size: 0.68rem; line-height: 1.2;">P / A / %</div>
              </th>
              <th style="min-width: 220px;" class="ps-3 matrix-sticky-name">${studentHeaderHtml}</th>`;
            if (result.sessions.length === 0) {
                headerHtml += '<th>Status</th>';
                tbody.innerHTML = '<tr><td colspan="3" class="text-center py-5 text-muted">No active sessions found in this date range.</td></tr>';
                headers.innerHTML = headerHtml;
                bindAttendanceStudentVisibilityDropdown();
                return;
            }

            result.sessions.forEach((sessionRow) => {
                headerHtml += buildAttendanceSessionHeaderCell(classId, sessionRow);
            });
            headers.innerHTML = headerHtml;

            if (result.matrix.length === 0) {
                tbody.innerHTML = `<tr><td colspan="${result.sessions.length + 2}" class="text-center py-5 text-muted">No students found.</td></tr>`;
                bindAttendanceStudentVisibilityDropdown();
                return;
            }

            result.matrix.forEach((stu) => {
                tbody.insertAdjacentHTML('beforeend', buildAttendanceStudentRowHtml(stu));
            });

            bindAttendanceStudentVisibilityDropdown();
            applyAttendanceStudentVisibility();
            await refreshAttendanceDisplayRollups();

            const currentUrlParams = new URLSearchParams(window.location.search);
            const targetStudentId = currentUrlParams.get('studentId');
            const targetSessionId = currentUrlParams.get('sessionId');

            if (targetStudentId && targetSessionId) {
                setTimeout(() => {
                    openInteractiveModal(targetStudentId, targetSessionId);
                    const cleanUrl = new URL(`${window.location.origin}/school/attendances`);
                    cleanUrl.searchParams.set('classId', classId);
                    if (startDate) cleanUrl.searchParams.set('startDate', startDate);
                    if (endDate) cleanUrl.searchParams.set('endDate', endDate);
                    window.history.replaceState({}, document.title, cleanUrl.pathname + cleanUrl.search);
                }, 200);
            }

        } catch (error) {
            if (isHandledAttendanceActionStateError(error)) return;
            console.error(error);
            if (!mergeMode) {
                window.currentMatrixData = null;
                window.attendanceVisiblePersonIds = null;
                setAttendancePrintEnabled(false);
            }
            showAttendanceMatrixMessage({
                title: 'Error',
                icon: 'error',
                message: error.message,
                buttons: [{ text: 'Close', class: 'btn-secondary' }]
            });
        } finally {
            attMatrixWindowState.loading = false;
            if (!skipButtonBusy) {
                btn.innerHTML = originalHtml;
                btn.disabled = false;
            }
        }
    }

    document.querySelector('.matrix-wrapper')?.addEventListener('scroll', () => {
        const wrapper = document.querySelector('.matrix-wrapper');
        if (!wrapper || attMatrixWindowState.loading || !window.currentMatrixData) return;
        const nearBottom = wrapper.scrollTop + wrapper.clientHeight >= wrapper.scrollHeight - 100;
        const nearRight = wrapper.scrollLeft + wrapper.clientWidth >= wrapper.scrollWidth - 100;
        if (nearBottom && attMatrixWindowState.hasMoreStudents) {
            loadAttendanceMatrixData({ merge: 'students', skipButtonBusy: true });
        } else if (nearRight && attMatrixWindowState.hasMoreSessions) {
            loadAttendanceMatrixData({ merge: 'sessions', skipButtonBusy: true });
        }
    });

    document.getElementById('btn_loadData').addEventListener('click', () => loadAttendanceMatrixData());
    document.getElementById('btn_attendanceMatrixHistory')?.addEventListener('click', () => {
        setAttendanceHistoryMode(!window.attendanceHistoryModeOn);
    });
    document.getElementById('btn_attendanceMatrixLegend')?.addEventListener('click', () => {
        openAttendanceMatrixLegendModal();
    });

    // --- 3b. Attendance Matrix Print ---
    const ATT_PRINT_STATUS_LETTER = {
        present: 'P',
        late: 'L',
        excused: 'E',
        absent: 'A',
        acf: 'ACF',
        not_applicable: '—'
    };

    function attPrintEscapeHtml(value) {
        return String(value == null ? '' : value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function attPrintFormatDateShort(ymd) {
        const raw = String(ymd || '').trim();
        if (!/^\d{4}-\d{2}-\d{2}$/.test(raw)) return raw || '—';
        const d = new Date(`${raw}T00:00:00`);
        if (Number.isNaN(d.getTime())) return raw;
        return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    }

    function attPrintFormatWeekday(ymd) {
        const raw = String(ymd || '').trim();
        if (!/^\d{4}-\d{2}-\d{2}$/.test(raw)) return '';
        const d = new Date(`${raw}T00:00:00`);
        if (Number.isNaN(d.getTime())) return '';
        return d.toLocaleDateString('en-US', { weekday: 'short' });
    }

    function attPrintFormatRangeLabel(startDate, endDate) {
        const start = String(startDate || '').trim();
        const end = String(endDate || '').trim();
        if (!start && !end) return 'All sessions';
        if (start && end) return `${attPrintFormatDateShort(start)} – ${attPrintFormatDateShort(end)}`;
        if (start) return `From ${attPrintFormatDateShort(start)}`;
        return `Through ${attPrintFormatDateShort(end)}`;
    }

    function attPrintMinutesPart(rec) {
        const late = Number(rec?.lateMinutes) || 0;
        const early = Number(rec?.earlyLeaveMinutes) || 0;
        const lateSuffix = late > 0 && attendanceFlagIsTrue(rec?.lateExcused) ? 'E' : '';
        const earlySuffix = early > 0 && attendanceFlagIsTrue(rec?.earlyLeaveExcused) ? 'E' : '';
        if (late <= 0 && early <= 0) return '';
        if (late > 0 && early > 0) return `${late}'${lateSuffix}/${early}'${earlySuffix}`;
        if (late > 0) return `${late}'${lateSuffix}`;
        return `/${early}'${earlySuffix}`;
    }

    function attPrintStatusLetter(rec) {
        const status = String(rec?.status || '').trim().toLowerCase();
        if (status === 'excused' || (isAbsentLikeAttendanceStatus(status) && attendanceAbsenceIsExcused(rec))) return 'E';
        return ATT_PRINT_STATUS_LETTER[status] || '—';
    }

    function attPrintCellText(rec) {
        const letter = attPrintStatusLetter(rec);
        const mins = attPrintMinutesPart(rec);
        if (!mins) return letter;
        if (letter === '—') return letter;
        return `${letter} ${mins}`;
    }

    function attPrintFormatCommentEntry(comment, index = 0, total = 1) {
        if (!comment) return '';
        if (typeof comment === 'string') return String(comment).trim();
        const text = String(comment?.text || '').trim();
        if (!text) return '';
        const author = String(comment?.authorName || '').trim();
        const label = total > 1 ? `Comment ${index + 1}` : 'Comment';
        return author ? `${label} (${author}): ${text}` : `${label}: ${text}`;
    }

    function attPrintCollectNoteParts(rec) {
        const parts = [];
        const excuse = String(rec?.excuseRef || '').trim();
        const rosterNote = String(rec?.rosterStudentNotes || '').trim();
        if (excuse) parts.push(`Excuse: ${excuse}`);
        if (rosterNote) parts.push(`Note: ${rosterNote}`);
        const comments = Array.isArray(rec?.comments) ? rec.comments : [];
        comments.forEach((comment, index) => {
            const formatted = attPrintFormatCommentEntry(comment, index, comments.length);
            if (formatted) parts.push(formatted);
        });
        return parts;
    }

    function attPrintBuildSessionNotesById(students = []) {
        const notesBySessionId = new Map();
        (Array.isArray(students) ? students : []).forEach((stu) => {
            (Array.isArray(stu?.records) ? stu.records : []).forEach((rec) => {
                const sessionId = String(rec?.sessionId || '').trim();
                const sessionNote = String(rec?.sessionLevelNote || '').trim();
                if (!sessionId || !sessionNote || notesBySessionId.has(sessionId)) return;
                notesBySessionId.set(sessionId, sessionNote);
            });
        });
        return notesBySessionId;
    }

    function attPrintBuildSessionNoteIndex(sessions = [], sessionNotesById = new Map()) {
        const sessionNoteEntries = [];
        const markerBySessionId = new Map();
        (Array.isArray(sessions) ? sessions : []).forEach((sessionRow) => {
            const sessionId = String(sessionRow?.id || sessionRow?.sessionId || '').trim();
            const note = String(sessionNotesById.get(sessionId) || '').trim();
            if (!sessionId || !note) return;
            const num = sessionNoteEntries.length + 1;
            sessionNoteEntries.push({
                num,
                sessionId,
                dateLabel: attPrintFormatDateShort(sessionRow?.date),
                weekday: attPrintFormatWeekday(sessionRow?.date),
                note
            });
            markerBySessionId.set(sessionId, num);
        });
        return { sessionNoteEntries, markerBySessionId };
    }

    function attPrintToSuperscript(n) {
        const map = { '0': '⁰', '1': '¹', '2': '²', '3': '³', '4': '⁴', '5': '⁵', '6': '⁶', '7': '⁷', '8': '⁸', '9': '⁹' };
        return String(n).split('').map((ch) => map[ch] || ch).join('');
    }

    function attPrintBuildSummary(matrixData) {
        const counts = { present: 0, late: 0, excused: 0, absent: 0, acf: 0, not_applicable: 0, other: 0 };
        const students = Array.isArray(matrixData?.matrix) ? matrixData.matrix : [];
        const sessions = Array.isArray(matrixData?.sessions) ? matrixData.sessions : [];
        let pctSum = 0;
        let pctCount = 0;

        students.forEach((stu) => {
            (Array.isArray(stu.records) ? stu.records : []).forEach((rec) => {
                const key = String(rec?.status || '').trim().toLowerCase();
                const absenceExcused = attendanceFlagIsTrue(rec?.absenceExcused) || key === 'excused';
                if (key === 'excused') {
                    counts.excused += 1;
                    return;
                }
                if ((key === 'absent' || key === 'acf') && absenceExcused) {
                    counts.excused += 1;
                    return;
                }
                if (Object.prototype.hasOwnProperty.call(counts, key)) counts[key] += 1;
                else counts.other += 1;
            });
            const pct = stu?.summary?.performancePercent;
            if (pct != null && Number.isFinite(Number(pct))) {
                pctSum += Number(pct);
                pctCount += 1;
            }
        });

        const avgPct = pctCount ? Math.round((pctSum / pctCount) * 100) / 100 : null;
        return {
            studentCount: students.length,
            sessionCount: sessions.length,
            counts,
            avgPct
        };
    }

    function buildPrintMarkAppearanceCss() {
        const marks = Array.isArray(window.__attendanceMarkAppearance?.marks)
            ? window.__attendanceMarkAppearance.marks
            : [];
        const vars = marks.map((row) => {
            const key = String(row?.key || '').trim().replace(/_/g, '-');
            const color = String(row?.color || '').trim();
            if (!key || !color) return '';
            return `--att-mark-${key}: ${color};`;
        }).filter(Boolean).join('\n');
        return vars ? `:root {\n${vars}\n}` : '';
    }

    function buildAttendancePrintDocument(matrixData, meta = {}) {
        const data = matrixData && typeof matrixData === 'object' ? matrixData : {};
        const sessions = Array.isArray(data.sessions) ? data.sessions : [];
        const students = Array.isArray(data.matrix) ? data.matrix : [];
        const summary = attPrintBuildSummary(data);
        const className = String(data.className || meta.className || 'Class').trim() || 'Class';
        const orgName = String(meta.orgName || '').trim();
        const rangeLabel = attPrintFormatRangeLabel(meta.startDate, meta.endDate);
        const printedAt = meta.printedAt instanceof Date ? meta.printedAt : new Date();
        const printedAtLabel = formatSchoolInstant(printedAt);
        const fallbackSettings = {
            includeOrg: true,
            orgName,
            includeHeaderNote: false,
            headerNote: '',
            orientation: 'landscape',
            density: 'compact',
            requestedByLabel: '',
            logoUrl: ''
        };
        const settings = window.AppPrintManager?.normalizeSettings
            ? window.AppPrintManager.normalizeSettings({ ...fallbackSettings, ...(meta.printSettings || {}) })
            : fallbackSettings;
        const displayOrgName = settings.includeOrg ? String(settings.orgName || orgName || '').trim() : '';
        const logoUrl = String(settings.logoUrl || '').trim();
        const logoHtml = logoUrl
            ? `<img class="print-logo" src="${attPrintEscapeHtml(logoUrl)}" alt="Organization logo" onerror="this.style.display='none'">`
            : '';
        const pageCss = window.PrintDocumentBuilder?.buildPageCss
            ? window.PrintDocumentBuilder.buildPageCss(settings.orientation)
            : `@page { margin: 10mm; size: ${settings.orientation === 'portrait' ? 'portrait' : 'landscape'}; }`;
        const previewControlsHtml = window.AppPrintManager?.buildPreviewControlsHtml
            ? window.AppPrintManager.buildPreviewControlsHtml(settings)
            : '<div class="screen-actions no-print"><button type="button" onclick="window.print()">Print</button><button type="button" onclick="window.close()">Close</button></div>';
        const printNoteHtml = window.AppPrintManager?.buildPrintNoteHtml
            ? window.AppPrintManager.buildPrintNoteHtml(settings)
            : '';
        const orientationScript = window.PrintDocumentBuilder?.buildPreviewOrientationScript
            ? window.PrintDocumentBuilder.buildPreviewOrientationScript({ orientation: settings.orientation, sourcePath: location.pathname, mode: 'attendance-matrix' })
            : '';

        const attendanceNotes = [];
        const attendanceNoteByKey = new Map();
        const sessionNotesById = attPrintBuildSessionNotesById(students);
        const { sessionNoteEntries, markerBySessionId } = attPrintBuildSessionNoteIndex(sessions, sessionNotesById);

        function attendanceNoteMarkerFor(studentName, rec) {
            const parts = attPrintCollectNoteParts(rec);
            if (!parts.length) return '';
            const key = [
                String(rec?.sessionId || ''),
                String(studentName || ''),
                parts.join('|')
            ].join('::');
            let num = attendanceNoteByKey.get(key);
            if (!num) {
                num = attendanceNotes.length + 1;
                attendanceNoteByKey.set(key, num);
                const late = Number(rec?.lateMinutes) || 0;
                const early = Number(rec?.earlyLeaveMinutes) || 0;
                const timingBits = [];
                if (late > 0) timingBits.push(`Late ${late}'${attendanceFlagIsTrue(rec?.lateExcused) ? ' excused' : ''}`);
                if (early > 0) timingBits.push(`Early leave ${early}'${attendanceFlagIsTrue(rec?.earlyLeaveExcused) ? ' excused' : ''}`);
                attendanceNotes.push({
                    num,
                    studentName: String(studentName || 'Student'),
                    dateLabel: attPrintFormatDateShort(rec?.date),
                    statusLetter: attPrintStatusLetter(rec),
                    timing: timingBits.join(', '),
                    parts
                });
            }
            return `<sup class="fn-mark">${attPrintEscapeHtml(attPrintToSuperscript(num))}</sup>`;
        }

        const headerCells = sessions.map((s) => {
            const shortDate = attPrintFormatDateShort(s.date);
            const weekday = attPrintFormatWeekday(s.date);
            const sessionId = String(s?.id || s?.sessionId || '').trim();
            const sessionMarkerNum = markerBySessionId.get(sessionId);
            const sessionMarkerHtml = sessionMarkerNum
                ? `<sup class="fn-mark session-fn-mark">${attPrintEscapeHtml(attPrintToSuperscript(sessionMarkerNum))}</sup>`
                : '';
            return `<th class="day-col"><div class="day-date">${attPrintEscapeHtml(shortDate)}${sessionMarkerHtml}</div>${weekday ? `<div class="day-wd">${attPrintEscapeHtml(weekday)}</div>` : ''}</th>`;
        }).join('');

        const bodyRows = students.map((stu, index) => {
            const s = stu.summary || {};
            const p = Number(s.totalPresentSessions) || 0;
            const a = Number(s.totalAbsentSessions) || 0;
            const na = Number(s.totalNotApplicableSessions) || 0;
            const pct = s.performancePercent;
            const pctStr = pct == null ? '—' : `${pct}%`;
            const rollupNa = na ? ` / ${na}` : '';
            const name = String(stu.name || 'Student');
            const cells = (Array.isArray(stu.records) ? stu.records : []).map((rec) => {
                const text = attPrintCellText(rec);
                const statusClass = `st-${String(rec?.status || 'na').replace(/_/g, '-')}`;
                const fn = attendanceNoteMarkerFor(name, rec);
                return `<td class="att-print-cell ${statusClass}">${attPrintEscapeHtml(text)}${fn}</td>`;
            }).join('');
            return `<tr>
                <td class="num-col">${index + 1}</td>
                <td class="name-col">${attPrintEscapeHtml(name)}</td>
                <td class="rollup-col"><div class="rollup-pa">${p} / ${a}${rollupNa}</div><div class="rollup-pct">${attPrintEscapeHtml(pctStr)}</div></td>
                ${cells}
            </tr>`;
        }).join('');

        const emptyRow = !students.length
            ? `<tr><td colspan="${sessions.length + 3}" class="empty-msg">No visible students to print. Use the Students filter on the matrix to show students, then print again.</td></tr>`
            : (!sessions.length
                ? `<tr><td colspan="3" class="empty-msg">No active sessions found in this date range.</td></tr>`
                : '');

        const sessionNotesHtml = sessionNoteEntries.length
            ? `<section class="footnotes session-notes">
                <h2>Session Notes</h2>
                <ol>
                  ${sessionNoteEntries.map((entry) => {
                    const headBits = [attPrintEscapeHtml(entry.dateLabel)];
                    if (entry.weekday) headBits.push(attPrintEscapeHtml(entry.weekday));
                    return `<li value="${entry.num}"><span class="fn-head">${headBits.join(' · ')}</span> — ${attPrintEscapeHtml(entry.note)}</li>`;
                  }).join('')}
                </ol>
              </section>`
            : '';

        const attendanceNotesHtml = attendanceNotes.length
            ? `<section class="footnotes attendance-notes">
                <h2>Attendance Notes</h2>
                <ol>
                  ${attendanceNotes.map((fn) => {
                    const headBits = [
                      attPrintEscapeHtml(fn.studentName),
                      attPrintEscapeHtml(fn.dateLabel),
                      attPrintEscapeHtml(fn.statusLetter)
                    ];
                    if (fn.timing) headBits.push(attPrintEscapeHtml(fn.timing));
                    return `<li value="${fn.num}"><span class="fn-head">${headBits.join(' · ')}</span> — ${attPrintEscapeHtml(fn.parts.join(' · '))}</li>`;
                  }).join('')}
                </ol>
              </section>`
            : '';

        const avgPctLabel = summary.avgPct == null ? '—' : `${summary.avgPct}%`;
        const c = summary.counts;
        const printEnabled = getMatrixEnabledAttendanceStatuses(data);
        const printEnabledSet = new Set(printEnabled);
        const printStatParts = [
            `<span class="stat"><b>${summary.studentCount}</b> students</span>`,
            `<span class="stat"><b>${summary.sessionCount}</b> sessions</span>`
        ];
        if (printEnabledSet.has('present')) printStatParts.push(`<span class="stat">P <b>${c.present}</b></span>`);
        if (printEnabledSet.has('late')) printStatParts.push(`<span class="stat">L <b>${c.late}</b></span>`);
        printStatParts.push(`<span class="stat">E <b>${c.excused}</b></span>`);
        if (printEnabledSet.has('absent')) printStatParts.push(`<span class="stat">A <b>${c.absent}</b></span>`);
        if (printEnabledSet.has('acf')) printStatParts.push(`<span class="stat">ACF <b>${c.acf || 0}</b></span>`);
        if (printEnabledSet.has('not_applicable')) printStatParts.push(`<span class="stat">N/A <b>${c.not_applicable}</b></span>`);
        printStatParts.push(`<span class="stat">Avg rollup <b>${attPrintEscapeHtml(avgPctLabel)}</b></span>`);
        const printLegend = buildAttendanceLegendText(printEnabled);

        return `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>${attPrintEscapeHtml(`Attendance Matrix — ${className}`)}</title>
  <style id="print-page-orientation-css">${pageCss}</style>
  <style>
    ${buildPrintMarkAppearanceCss()}
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: "Segoe UI", Arial, sans-serif;
      font-size: 10px;
      color: #111;
      line-height: 1.25;
    }
    body.print-density-normal { font-size: 11px; line-height: 1.35; }
    .sheet { padding: 0; }
    .identity-block { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; margin-bottom: 8px; }
    .identity-copy { min-width: 0; flex: 1 1 auto; }
    .print-logo { display: block; flex: 0 0 auto; width: auto; height: 58px; max-width: 180px; object-fit: contain; object-position: right top; }
    .doc-header { margin-bottom: 8px; }
    .doc-header h1 {
      margin: 0 0 2px 0;
      font-size: 16px;
      font-weight: 700;
    }
    .org-name {
      font-size: 13px;
      font-weight: 700;
      margin: 0 0 4px 0;
    }
    .print-note {
      margin: 0 0 8px;
      border: 1px solid #cfd7e3;
      background: #f4f7fb;
      padding: 6px 8px;
      color: #333;
      white-space: pre-wrap;
    }
    .meta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 18px;
      color: #333;
      margin-bottom: 6px;
    }
    .meta-row span strong { font-weight: 600; }
    .summary {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 14px;
      border: 1px solid #ccc;
      background: #f8f9fa;
      padding: 6px 8px;
      margin-bottom: 8px;
      border-radius: 2px;
    }
    .summary .stat { white-space: nowrap; }
    .summary .stat b { font-weight: 700; }
    .legend {
      margin: 0 0 8px 0;
      color: #444;
      font-size: 9.5px;
    }
    table.matrix {
      width: 100%;
      border-collapse: collapse;
      table-layout: auto;
    }
    table.matrix th,
    table.matrix td {
      border: 1px solid #bbb;
      padding: 3px 4px;
      vertical-align: middle;
    }
    table.matrix thead th {
      background: #eef1f4;
      font-weight: 700;
      text-align: center;
    }
    table.matrix thead { display: table-header-group; }
    table.matrix tbody tr { page-break-inside: avoid; }
    .num-col { width: 28px; text-align: center; color: #555; }
    .name-col { text-align: left; min-width: 110px; max-width: 160px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .rollup-col { text-align: center; min-width: 52px; white-space: nowrap; }
    .rollup-pa { font-size: 9px; color: #444; }
    .rollup-pct { font-weight: 700; font-size: 10px; }
    .day-col { min-width: 42px; }
    .day-date { font-size: 9.5px; }
    .day-wd { font-size: 8px; color: #666; font-weight: 500; }
    .att-print-cell {
      text-align: center;
      white-space: nowrap;
      font-weight: 600;
      font-size: 9.5px;
    }
    .st-present { color: var(--att-mark-present, #198754); }
    .st-late { color: var(--att-mark-late, #FFFF00); }
    .st-excused { color: var(--att-mark-excused-absence, #055160); }
    .st-absent { color: var(--att-mark-absent, #dc3545); }
    .st-acf { color: var(--att-mark-acf, #b02a37); }
    .st-not-applicable, .st-na { color: var(--att-mark-not-applicable, #6c757d); font-weight: 500; }
    .fn-mark { font-size: 8px; font-weight: 700; color: var(--att-mark-notes, #0d6efd); margin-left: 1px; }
    .session-fn-mark { color: #6f42c1; }
    .empty-msg { text-align: center; color: #666; padding: 16px !important; }
    .footnotes {
      margin-top: 12px;
      page-break-inside: avoid;
    }
    .footnotes h2 {
      margin: 0 0 4px 0;
      font-size: 12px;
    }
    .footnotes ol {
      margin: 0;
      padding-left: 18px;
    }
    .footnotes li {
      margin-bottom: 3px;
      page-break-inside: avoid;
    }
    .fn-head { font-weight: 600; }
    .doc-footer {
      margin-top: 10px;
      padding-top: 4px;
      border-top: 1px solid #ddd;
      color: #666;
      font-size: 9px;
      display: flex;
      justify-content: space-between;
      gap: 12px;
    }
    @media print {
      body { margin: 0; }
      .no-print { display: none !important; }
      a { color: inherit; text-decoration: none; }
    }
    @media screen {
      body { background: #e9ecef; padding: 16px; }
      .sheet {
        background: #fff;
        padding: 14px 16px;
        box-shadow: 0 1px 6px rgba(0,0,0,0.12);
        max-width: 100%;
      }
      .screen-actions {
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
      }
      .screen-actions-label { color: #333; font-weight: 600; }
      .screen-actions button {
        font: inherit;
        padding: 6px 12px;
        cursor: pointer;
        border: 1px solid #adb5bd;
        background: #fff;
        border-radius: 4px;
      }
      .screen-actions button.is-active { background: #174ea6; border-color: #174ea6; color: #fff; }
      .screen-actions-hint { margin: -4px 0 10px; color: #555; font-size: 11px; }
    }
  </style>
</head>
<body class="print-density-${settings.density}" data-print-orientation="${settings.orientation}">
  ${previewControlsHtml}
  <div class="sheet">
    <div class="identity-block">
      <div class="identity-copy">
        <header class="doc-header">
          ${displayOrgName ? `<div class="org-name">${attPrintEscapeHtml(displayOrgName)}</div>` : ''}
          <h1>Attendance Matrix</h1>
          <div class="meta-row">
            <span><strong>Class:</strong> ${attPrintEscapeHtml(className)}</span>
            <span><strong>Range:</strong> ${attPrintEscapeHtml(rangeLabel)}</span>
            <span><strong>Printed:</strong> ${attPrintEscapeHtml(printedAtLabel)}</span>
            ${settings.requestedByLabel ? `<span><strong>Requested by:</strong> ${attPrintEscapeHtml(settings.requestedByLabel)}</span>` : ''}
          </div>
        </header>
      </div>
      ${logoHtml}
    </div>
    ${printNoteHtml}

    <div class="summary">
      ${printStatParts.join('\n      ')}
    </div>
    <div class="legend">${attPrintEscapeHtml(printLegend)}</div>

    <table class="matrix">
      <thead>
        <tr>
          <th class="num-col">#</th>
          <th class="name-col">Student</th>
          <th class="rollup-col">P/A/%</th>
          ${headerCells}
        </tr>
      </thead>
      <tbody>
        ${bodyRows || emptyRow}
      </tbody>
    </table>

    ${sessionNotesHtml}
    ${attendanceNotesHtml}

    <footer class="doc-footer">
      <span>Generated from Attendance Matrix</span>
      <span>${attPrintEscapeHtml(className)} · ${attPrintEscapeHtml(rangeLabel)}</span>
    </footer>
  </div>
  ${orientationScript}
</body>
</html>`;
    }

    function openAttendancePrint() {
        if (!window.currentMatrixData || window.currentMatrixData.status !== 'success') {
            showAttendanceMatrixMessage({
                title: 'Nothing to print',
                icon: 'warning',
                message: 'Load an attendance matrix for a class first.',
                buttons: [{ text: 'Close', class: 'btn-secondary' }]
            });
            return;
        }

        const orgName = String(document.getElementById('activeOrgNameRef')?.getAttribute('data-name') || '').trim();
        const startDate = document.getElementById('filter_startDate')?.value || '';
        const endDate = document.getElementById('filter_endDate')?.value || '';
        const printData = getVisibleAttendanceMatrixForPrint(window.currentMatrixData);
        const defaults = { orgName, orientation: 'landscape', density: 'compact' };
        const openPreview = (settings = defaults) => {
            const html = buildAttendancePrintDocument(printData, {
                orgName,
                startDate,
                endDate,
                className: window.currentMatrixData.className,
                printedAt: new Date(),
                printSettings: settings
            });
            const printWindow = window.AppPrintManager?.openHtmlPreview
                ? window.AppPrintManager.openHtmlPreview({
                    title: 'Attendance Matrix',
                    html,
                    settings,
                    sourcePath: location.pathname,
                    view: 'attendance-matrix'
                })
                : null;
            if (!printWindow) {
                showAttendanceMatrixMessage({
                    title: 'Popup blocked',
                    icon: 'warning',
                    message: 'Allow pop-ups for this site to open the print page.',
                    buttons: [{ text: 'Close', class: 'btn-secondary' }]
                });
            }
        };

        if (window.AppPrintManager?.openSettings) {
            window.AppPrintManager.openSettings({
                mode: 'attendance-matrix',
                defaults,
                onConfirm: openPreview
            });
        } else {
            openPreview(defaults);
        }
    }

    document.getElementById('btn_printAttendanceMatrix')?.addEventListener('click', () => openAttendancePrint());
    document.getElementById('btn_exportAttendanceExcel')?.addEventListener('click', () => exportAttendanceExcel());

    // --- 4. Interactive Note Saving Logic ---
    document.getElementById('btn_saveComment').addEventListener('click', async () => {
        const classId = document.getElementById('modal_classId').value;
        const sessionId = document.getElementById('modal_sessionId').value;
        const personId = document.getElementById('modal_personId').value;
        const text = document.getElementById('inp_newComment').value;

        if (!text.trim()) return;

        const btn = document.getElementById('btn_saveComment');
        const origBtn = btn.innerHTML;
        btn.innerHTML = 'Sending...'; btn.disabled = true;
        showAttendanceMatrixBusy({
            title: 'Sending Note',
            note: 'Please wait while the attendance note is sent and the matrix refreshes.',
            operation: 'Attendance Matrix'
        });

        try {
            if (!(await ensureAttendanceRequestBudgetAvailable())) return;
            const payload = {
                classId: classId,
                sessionId: sessionId,
                studentPersonId: personId,
                text: text,
                mentions: currentMentions,
                attachment: await uploadAttendanceFile(document.getElementById('inp_newCommentFile'), 'comment', classId, sessionId, personId),
                actionStateId: resolveAttendanceActionStateId()
            };

            const res = await fetch('/school/attendances/api/comment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-AJAX-Request': 'true' },
                body: JSON.stringify(payload)
            });
            const result = await res.json();
            hydrateAttendanceBudgetFromApi(res, result, { estimateAttempt: true, source: 'comment-save' });
            const guarded = typeof window.applyGuardedApiResult === 'function'
                ? await window.applyGuardedApiResult(result, { busyTitle: 'Send Note In Progress', replayTitle: 'Note Already Sent' })
                : { stop: false };
            if (guarded.stop) return;

            if (result.status !== 'success') {
                const handled = await handleAttendanceActionStateFailure(result);
                if (handled) throw new Error(ATTENDANCE_ACTION_STATE_HANDLED_ERROR);
                throw new Error(result.message);
            }
            
            document.getElementById('inp_newComment').value = '';
            const savedCommentFileInput = document.getElementById('inp_newCommentFile');
            if (savedCommentFileInput) savedCommentFileInput.value = '';
            currentMentions = [];
            renderMentions();
            detailsModalSnapshot = captureAttendanceDetailsModalSnapshot();
            
            await loadAttendanceMatrixData({
                skipButtonBusy: true,
                loadingTitle: 'Refreshing Attendance Matrix',
                loadingNote: 'Refreshing the attendance matrix after sending the note...'
            });

            const thread = document.getElementById('det_commentsThread');
            let mentionHtml = '';
            result.comment.mentions.forEach(m => mentionHtml += `<span class="mention-badge me-1">@${m.name}</span>`);
            const attachmentHtml = result.comment.attachment ? `<div class="small mt-1">${renderAttendanceAttachmentLink(result.comment.attachment)}</div>` : '';
            thread.innerHTML += `
                <div class="comment-bubble">
                    <span class="comment-time">${formatSchoolInstant(result.comment.timestamp)}</span>
                    <div class="comment-author">${result.comment.authorName}</div>
                    <div class="mt-1">${mentionHtml} ${result.comment.text}</div>
                    ${attachmentHtml}
                </div>
            `;
            thread.scrollTop = thread.scrollHeight;

        } catch (err) {
            if (isHandledAttendanceActionStateError(err)) return;
            hideAttendanceMatrixBusy(true);
            showAttendanceMatrixMessage({
                title: 'Error',
                icon: 'error',
                message: err.message,
                buttons: [{ text: 'Close', class: 'btn-secondary' }]
            });
        } finally {
            hideAttendanceMatrixBusy();
            btn.innerHTML = origBtn; btn.disabled = false;
        }
    });

    ['inp_cellLateMins', 'inp_cellLeaveMins'].forEach((id) => {
        document.getElementById(id)?.addEventListener('input', syncTimingExcuseControls);
        document.getElementById(id)?.addEventListener('change', syncTimingExcuseControls);
    });
    [
        { buttonId: 'btn_cellLateExcused', checkboxId: 'inp_cellLateExcused' },
        { buttonId: 'btn_cellEarlyLeaveExcused', checkboxId: 'inp_cellEarlyLeaveExcused' }
    ].forEach(({ buttonId, checkboxId }) => {
        document.getElementById(buttonId)?.addEventListener('click', () => {
            const checkbox = document.getElementById(checkboxId);
            if (!checkbox) return;
            checkbox.checked = !checkbox.checked;
            syncTimingExcuseControls();
        });
    });
    document.getElementById('btn_cellAbsenceExcused')?.addEventListener('click', () => {
        const checkbox = document.getElementById('inp_cellAbsenceExcused');
        if (!checkbox) return;
        checkbox.checked = !checkbox.checked;
        syncAbsenceExcuseControl();
    });
    document.querySelectorAll('input[name="modal_cell_attendance"]').forEach((el) => {
        el.addEventListener('change', () => syncTimingExcuseControls());
    });

    const btnSaveAttendance = document.getElementById('btn_saveAttendance');
    if (btnSaveAttendance) {
        btnSaveAttendance.addEventListener('click', async () => {
            const classId = document.getElementById('modal_classId').value;
            const sessionId = document.getElementById('modal_sessionId').value;
            const personId = document.getElementById('modal_personId').value;
            const attendance = document.querySelector('input[name="modal_cell_attendance"]:checked')?.value;
            if (!attendance) {
                if (typeof showMessageModal === 'function') {
                    showMessageModal({ title: 'Attendance', icon: 'warning', message: 'Select a status (Present, Late, Absent, ACF, or N/A).', buttons: [{ text: 'OK', class: 'btn-primary' }] });
                } else { alert('Select an attendance status.'); }
                return;
            }

            const saveButtons = [btnSaveAttendance].filter(Boolean);
            const originalSaveButtons = saveButtons.map((btn) => ({ btn, html: btn.innerHTML }));
            saveButtons.forEach((btn) => {
                btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
                btn.disabled = true;
            });
            detailsModalAllowClose = true;
            if (detailsModalInstance) detailsModalInstance.hide();
            showAttendanceMatrixBusy({
                title: 'Saving Attendance',
                note: 'Please wait while attendance changes are applied.',
                operation: 'Attendance Matrix'
            });

            try {
                if (!(await ensureAttendanceRequestBudgetAvailable())) return;
                const payload = {
                    classId,
                    sessionId,
                    studentPersonId: personId,
                    attendance,
                    lateMinutes: document.getElementById('inp_cellLateMins').value,
                    earlyLeaveMinutes: document.getElementById('inp_cellLeaveMins').value,
                    notes: document.getElementById('inp_rosterStudentNote').value,
                    actionStateId: resolveAttendanceActionStateId()
                };
                if (attendanceCanMarkExcused()) {
                    payload.lateExcused = parseAttendanceMinutesInputValue('inp_cellLateMins') > 0 && document.getElementById('inp_cellLateExcused')?.checked === true;
                    payload.earlyLeaveExcused = parseAttendanceMinutesInputValue('inp_cellLeaveMins') > 0 && document.getElementById('inp_cellEarlyLeaveExcused')?.checked === true;
                    payload.absenceExcused = isAbsentLikeAttendanceStatus(attendance) && document.getElementById('inp_cellAbsenceExcused')?.checked === true;
                    payload.excuseRef = document.getElementById('inp_cellExcuseRef').value;
                    payload.excuseAttachment = await uploadAttendanceFile(document.getElementById('inp_cellExcuseFile'), 'excuse', classId, sessionId, personId) || window.currentAttendanceExcuseAttachment || null;
                }
                const res = await fetch('/school/attendances/api/update-roster-cell', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-AJAX-Request': 'true' },
                    body: JSON.stringify(payload)
                });
                const result = await res.json();
                hydrateAttendanceBudgetFromApi(res, result, { estimateAttempt: true, source: 'cell-save' });
                const guarded = typeof window.applyGuardedApiResult === 'function'
                    ? await window.applyGuardedApiResult(result, { busyTitle: 'Save In Progress', replayTitle: 'Save Already Completed' })
                    : { stop: false };
                if (guarded.stop) return;
                if (result.status !== 'success') {
                    const handled = await handleAttendanceActionStateFailure(result);
                    if (handled) throw new Error(ATTENDANCE_ACTION_STATE_HANDLED_ERROR);
                    throw new Error(result.message);
                }

                const patched = patchAttendanceMatrixCellAfterSave({
                    studentPersonId: personId,
                    sessionId,
                    payload,
                    serverRecord: result.record
                });
                if (!patched) {
                    await loadAttendanceMatrixData({
                        skipButtonBusy: true,
                        loadingTitle: 'Refreshing Attendance Matrix',
                        loadingNote: 'Refreshing the attendance matrix after saving attendance...'
                    });
                    return;
                }

                detailsModalSnapshot = captureAttendanceDetailsModalSnapshot();
                await queueAttendanceScopedRollupRefresh(personId);
            } catch (err) {
                if (isHandledAttendanceActionStateError(err)) return;
                hideAttendanceMatrixBusy(true);
                showAttendanceMatrixMessage({
                    title: 'Error',
                    icon: 'error',
                    message: err.message,
                    buttons: [{ text: 'Close', class: 'btn-secondary' }]
                });
            } finally {
                hideAttendanceMatrixBusy();
                originalSaveButtons.forEach(({ btn, html }) => {
                    btn.innerHTML = html;
                    btn.disabled = false;
                });
            }
        });
    }

    // --- 5. Query / server initial state: class, date range, deep link ---
    const init = window.ATTENDANCE_PAGE_INITIAL || {};
    const urlParams = new URLSearchParams(window.location.search);
    const qClassId = (urlParams.get('classId') || init.classId || '').trim();
    const qClassName = (urlParams.get('className') || init.className || '').trim();
    let qStart = (urlParams.get('startDate') || init.startDate || '').trim();
    let qEnd = (urlParams.get('endDate') || init.endDate || '').trim();
    const qStudentId = (urlParams.get('studentId') || init.studentId || '').trim();
    const qSessionId = (urlParams.get('sessionId') || init.sessionId || '').trim();
    const qSessionIds = (urlParams.get('sessionIds') || init.sessionIds || '').trim();
    const qRange = (urlParams.get('range') || init.range || '').trim();
    const normalizedRange = normalizeAttendanceRangeToken(qRange);

    if (qStart && !qEnd) qEnd = qStart;

    if (qClassId) {
        document.getElementById('filter_classId').value = qClassId;
        document.getElementById('filter_className').value = qClassName || 'Loading Class Data...';
    }
    if (qStart) document.getElementById('filter_startDate').value = qStart;
    if (qEnd) document.getElementById('filter_endDate').value = qEnd;

    if (!qClassId) {
        applyAttendanceRangeSelection('thisWeek');
    } else if (qStart && qEnd) {
        if (normalizedRange) setActiveRangeChip(normalizedRange);
        document.getElementById('btn_loadData').click();
    } else if (normalizedRange) {
        applyAttendanceRangeSelection(normalizedRange);
    } else if (qStudentId && qSessionId && !qStart) {
        applyAttendanceRangeSelection('allTime');
    } else if (qSessionIds && qClassId && !qStart) {
        applyAttendanceRangeSelection('allTime');
    } else {
        applyAttendanceRangeSelection('thisWeek');
    }
    renderAttendanceMatrixLegend();
});

// --- NEW: Global Function to handle Header Clicks ---
window.confirmOpenSession = async function(classId, sessionId) {
    if (typeof showMessageModal === 'function') {
        const res = await showMessageModal({
            title: 'Open Session Manager',
            icon: 'question',
            message: 'Do you want to open the Session Manager for this specific date in a new tab?',
            buttons: [
                { text: 'Cancel', class: 'btn-secondary', value: false },
                { text: 'Open Session', class: 'btn-primary', value: true }
            ]
        });
        if (res === true || (res && res.value === true) || res === 'Open Session') {
            window.open(`/school/classes/${classId}/sessions/${sessionId}`, '_blank');
        }
    } else {
        if (confirm("Do you want to open the Session Manager for this date in a new tab?")) {
            window.open(`/school/classes/${classId}/sessions/${sessionId}`, '_blank');
        }
    }
};

// Global Function to handle Cell Clicks
window.openInteractiveModal = function(studentPersonId, sessionId) {
    if (!window.currentMatrixData) return;
    const matrix = window.currentMatrixData.matrix;
    const student = matrix.find(s => s.personId === studentPersonId);
    if (!student) return;
    const record = student.records.find(r => r.sessionId === sessionId);
    if (!record) return;

    document.getElementById('modal_classId').value = window.currentMatrixData.classId;
    document.getElementById('modal_sessionId').value = sessionId;
    document.getElementById('modal_personId').value = studentPersonId;
    const studentNameEl = document.getElementById('det_studentName');
    if (studentNameEl) {
        if (typeof schoolRenderStudentNameHtml === 'function') {
            studentNameEl.innerHTML = schoolRenderStudentNameHtml(student.name, record.studentRecordId || student.studentRecordId, { className: 'text-decoration-none fw-bold' });
        } else {
            studentNameEl.innerText = student.name;
        }
    }
    document.getElementById('det_date').innerText = `Session Date: ${record.date}`;

    const allowed = getMatrixEnabledAttendanceStatuses(window.currentMatrixData);
    const known = ['present', 'late', 'absent', 'acf', 'not_applicable'];
    let effStatus = known.includes(record.status) ? record.status : 'absent';
    if (record.status === 'excused') effStatus = 'absent';
    syncModalAttendanceOptions(allowed, effStatus);
    document.querySelectorAll('input[name="modal_cell_attendance"]').forEach((el) => {
        el.checked = el.value === effStatus;
    });
    document.getElementById('inp_cellLateMins').value = record.lateMinutes != null && record.lateMinutes !== '' ? record.lateMinutes : '';
    document.getElementById('inp_cellLeaveMins').value = record.earlyLeaveMinutes != null && record.earlyLeaveMinutes !== '' ? record.earlyLeaveMinutes : '';
    const lateExcusedInput = document.getElementById('inp_cellLateExcused');
    const earlyLeaveExcusedInput = document.getElementById('inp_cellEarlyLeaveExcused');
    const absenceExcusedInput = document.getElementById('inp_cellAbsenceExcused');
    if (lateExcusedInput) lateExcusedInput.checked = Number(record.lateMinutes || 0) > 0 && attendanceFlagIsTrue(record.lateExcused);
    if (earlyLeaveExcusedInput) earlyLeaveExcusedInput.checked = Number(record.earlyLeaveMinutes || 0) > 0 && attendanceFlagIsTrue(record.earlyLeaveExcused);
    if (absenceExcusedInput) {
        absenceExcusedInput.checked = isAbsentLikeAttendanceStatus(effStatus)
            && (attendanceAbsenceIsExcused(record) || record.status === 'excused');
    }
    syncTimingExcuseControls();
    document.getElementById('inp_cellExcuseRef').value = record.excuseRef || '';
    window.currentAttendanceExcuseAttachment = record.excuseAttachment || null;
    const excuseFileInput = document.getElementById('inp_cellExcuseFile');
    if (excuseFileInput) excuseFileInput.value = '';
    const excusePreview = document.getElementById('inp_cellExcuseAttachmentPreview');
    if (excusePreview) {
        excusePreview.innerHTML = attendanceCanMarkExcused()
            ? renderAttendanceAttachmentLink(record.excuseAttachment, '<span class="text-muted">No file attached.</span>')
            : '';
    }
    syncExcuseNotesAccess(record);
    document.getElementById('inp_rosterStudentNote').value = record.rosterStudentNotes != null ? record.rosterStudentNotes : '';

    const locked = record.sessionLocked === true;
    const makeupRequired = record.applicability === 'makeup_required';
    const outsideEnrollmentWindow = record.withinEnrollmentWindow === false;
    const canEdit = window.CAN_EDIT_ATTENDANCE_ROSTER === true;
    const canOverride = window.CAN_OVERRIDE_SESSION_LOCK === true;
    const allowEdit = canEdit && !outsideEnrollmentWindow && !makeupRequired && (!locked || canOverride);
    const fs = document.getElementById('fieldset_cell_attendance');
    if (fs) fs.disabled = !allowEdit;
    const lockNotice = document.getElementById('cell_modal_lock_notice');
    const makeupNotice = document.getElementById('cell_modal_makeup_notice');
    const enrollmentNotice = document.getElementById('cell_modal_enrollment_notice');
    if (enrollmentNotice) {
        if (outsideEnrollmentWindow) enrollmentNotice.classList.remove('d-none');
        else enrollmentNotice.classList.add('d-none');
    }
    if (makeupNotice) {
        if (makeupRequired && canEdit) makeupNotice.classList.remove('d-none');
        else makeupNotice.classList.add('d-none');
    }
    if (locked && !canOverride && canEdit && !makeupRequired) lockNotice.classList.remove('d-none');
    else lockNotice.classList.add('d-none');
    const saveAttBtn = document.getElementById('btn_saveAttendance');
    if (saveAttBtn) {
        saveAttBtn.disabled = !allowEdit;
    }
    ['inp_newComment', 'inp_newCommentFile', 'btn_saveComment', 'btn_mentionUser'].forEach((id) => {
        const el = document.getElementById(id);
        if (el) el.disabled = !allowEdit;
    });

    const thread = document.getElementById('det_commentsThread');
    thread.innerHTML = '';
    if (record.comments && record.comments.length > 0) {
        record.comments.forEach(c => {
            let mentionHtml = '';
            (c.mentions || []).forEach(m => mentionHtml += `<span class="mention-badge me-1">@${m.name}</span>`);
            const attachmentHtml = c.attachment ? `<div class="small mt-1">${renderAttendanceAttachmentLink(c.attachment)}</div>` : '';
            
            thread.innerHTML += `
                <div class="comment-bubble">
                    <span class="comment-time">${formatSchoolInstant(c.timestamp)}</span>
                    <div class="comment-author">${c.authorName}</div>
                    <div class="mt-1">${mentionHtml} ${c.text}</div>
                    ${attachmentHtml}
                </div>
            `;
        });
    } else {
        thread.innerHTML = '<div class="text-muted small text-center py-2">No administrative notes yet. Be the first to comment.</div>';
    }

            document.getElementById('inp_newComment').value = '';
            const commentFileInput = document.getElementById('inp_newCommentFile');
            if (commentFileInput) commentFileInput.value = '';
            currentMentions = [];
    document.getElementById('pendingMentionsArea').innerHTML = '';

    if (detailsModalInstance) detailsModalInstance.show();
    detailsModalSnapshot = captureAttendanceDetailsModalSnapshot();
    detailsModalAllowClose = false;
};
</script>
