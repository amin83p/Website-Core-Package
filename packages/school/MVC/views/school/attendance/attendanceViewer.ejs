              <div><span class="text-success fw-semibold">${p}</span><span class="text-muted"> / </span><span class="text-danger fw-semibold">${a}</span>${na ? `<span class="text-muted"> / </span><span class="text-secondary fw-semibold">${na}</span>` : ''}</div>
              <div class="fw-bold text-primary mt-1" style="font-size: 0.9rem;">${pctStr}</div>`;
