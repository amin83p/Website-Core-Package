<%- include('_attendanceMarkAppearance') %>
<style>
    .att-cell { text-align: center; vertical-align: middle; min-width: 80px; position: relative; cursor: pointer; transition: background-color 0.2s; }
    .att-cell:hover { background-color: #f1f3f5; }
    .attendance-timing-excuse-icon {
      position: relative;
      display: inline-grid;
      place-items: center;
      width: 1.45em;
      height: 1.45em;
      line-height: 1;
    }
    .attendance-timing-excuse-icon::before {
      content: "";
      position: absolute;
      inset: 0.02em;
      border: 3px solid var(--att-mark-timing-excuse-ring, #198754);
      border-radius: 50%;
      pointer-events: none;
    }
    .attendance-timing-excuse-left::before { clip-path: inset(0 50% 0 0); }
    .attendance-timing-excuse-right::before { clip-path: inset(0 0 0 50%); }
    .attendance-timing-excuse-full::before { clip-path: none; }
    .attendance-timing-excuse-icon > i { position: relative; z-index: 1; }
    .attendance-legend-icon-btn {
      width: 2.25rem;
      height: 2.25rem;
      padding: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      line-height: 1;
    }
    .attendance-legend-icon-btn .bi {
      font-size: 1.05rem;
      line-height: 1;
    }
    .attendance-history-toggle-btn.active {
      color: #0d6efd;
      border-color: #0d6efd;
      background-color: rgba(13, 110, 253, 0.08);
    }
    .attendance-cell-history-btn {
      z-index: 2;
      color: #6c757d;
      line-height: 1;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.15s ease;
    }
    #resultsContainer.attendance-history-mode-on .attendance-cell-history-btn {
      opacity: 1;
      pointer-events: auto;
    }
    .attendance-cell-history-btn:hover,
    .attendance-cell-history-btn:focus {
      color: #0d6efd;
    }
    .attendance-history-status-cell {
      display: flex;
      align-items: flex-start;
      gap: 0.5rem;
      min-width: 8rem;
    }
    .attendance-history-status-icon {
      flex: 0 0 auto;
      line-height: 1;
      margin-top: 0.1rem;
    }
    .attendance-history-status-text {
      min-width: 0;
    }
    .attendance-history-status-label {
      font-weight: 600;
      line-height: 1.2;
    }
    .attendance-history-status-timing {
      font-size: 0.8rem;
      color: #6c757d;
      line-height: 1.2;
      margin-top: 0.15rem;
    }
    .attendance-legend-modal-body .attendance-legend-items {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.65rem;
    }
    .attendance-legend-modal-body .attendance-legend-item {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      margin-right: 0 !important;
    }
    .attendance-status-picker {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 0.55rem;
    }
    .attendance-status-picker .btn {
      border-width: 1.5px;
      border-radius: 8px !important;
      padding: 0.55rem 0.7rem;
      font-weight: 700;
      line-height: 1.15;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.35rem;
      min-height: 2.55rem;
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06);
    }
    .attendance-status-picker .btn i {
      font-size: 1rem;
      margin-right: 0 !important;
    }
    .attendance-status-picker .btn-check:checked + .btn {
      color: #fff !important;
      box-shadow: 0 0 0 0.18rem rgba(13, 110, 253, 0.16), 0 0.25rem 0.7rem rgba(15, 23, 42, 0.12);
      transform: translateY(-1px);
    }
    .attendance-status-picker .btn-check:focus + .btn {
      box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.2);
    }
    .attendance-timing-toggle {
      min-height: 2.15rem;
      border-radius: 8px;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.35rem;
      width: 100%;
    }
    .attendance-status-picker .attendance-absence-excuse-slot {
      grid-column: 1 / 6;
    }
    .attendance-status-picker .attendance-absence-excuse-slot .attendance-timing-toggle {
      width: 100%;
    }
    @media (max-width: 991.98px) {
      .attendance-status-picker {
        grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
      }
    }
    
    .matrix-wrapper { max-height: 600px; overflow: auto; border: 1px solid #dee2e6; border-radius: 12px; box-shadow: 0 0.15rem 0.5rem rgba(15, 23, 42, 0.05); }
    .matrix-table th { position: sticky; top: 0; background-color: #f8f9fa; z-index: 2; box-shadow: 0 2px 2px -1px rgba(0, 0, 0, 0.1); }
    /* Sticky rollup + student name columns */
    .matrix-table th.matrix-sticky-rollup,
    .matrix-table td.matrix-sticky-rollup {
      position: sticky;
      left: 0;
      z-index: 3;
      border-right: 1px solid #dee2e6;
      background-color: #f8f9fa;
      width: 96px;
      min-width: 96px;
      max-width: 96px;
      vertical-align: middle;
    }
    .matrix-table td.matrix-sticky-rollup { background-color: #fff; z-index: 2; }
    .matrix-table th.matrix-sticky-name,
    .matrix-table td.matrix-sticky-name {
      position: sticky;
      left: 96px;
      z-index: 3;
      border-right: 2px solid #dee2e6;
      background-color: #f8f9fa;
      box-shadow: 2px 0 2px -1px rgba(0, 0, 0, 0.06);
    }
    .matrix-table td.matrix-sticky-name {
      background-color: #fff;
      z-index: 2;
      font-weight: bold;
    }
    .matrix-table th.matrix-sticky-name {
      overflow: visible;
    }
    .matrix-student-filter-dropdown .dropdown-toggle {
      font-size: 0.72rem;
      padding: 0.15rem 0.45rem;
      line-height: 1.2;
    }
    .matrix-student-filter-dropdown .dropdown-menu {
      max-height: 280px;
      overflow-y: auto;
      min-width: 250px;
      z-index: 30;
    }
    .matrix-student-filter-dropdown .form-check-label {
      font-size: 0.82rem;
      font-weight: 500;
    }
    .attendance-student-filter-menu-floating {
      z-index: 2000 !important;
      max-height: min(320px, calc(100vh - 24px));
      overflow-y: auto;
      min-width: 250px;
    }
    tr.matrix-student-row.is-student-hidden {
      display: none !important;
    }

    /* Comment Thread CSS */
    .comment-thread { max-height: 300px; overflow-y: auto; background: #f8f9fa; border-radius: 6px; padding: 10px; }
    .comment-bubble { background: #fff; border: 1px solid #e9ecef; border-radius: 8px; padding: 10px; margin-bottom: 10px; box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
    .comment-author { font-weight: bold; font-size: 0.8rem; color: #495057; }
    .comment-time { font-size: 0.7rem; color: #adb5bd; float: right; }
    .mention-badge { background-color: #e7f1ff; color: #0d6efd; font-size: 0.75rem; padding: 2px 6px; border-radius: 12px; font-weight: bold; border: 1px solid #b6d4fe; }
    .schedule-shell .filter-panel {
        background: linear-gradient(145deg, #edf5ff 0%, #f8fbff 100%);
        border: 1px solid #dce9ff;
        border-radius: 14px;
    }
    .schedule-shell .range-chip.active {
        box-shadow: 0 0 0 2px rgba(13, 110, 253, 0.15);
    }
</style>

<%
  const dashHref = typeof schoolSectionDashboardHref === 'string' && schoolSectionDashboardHref
    ? schoolSectionDashboardHref
    : '/dashboard/section-nav/SCHOOL';
  const showAttendanceManageBtns = typeof isAttendanceAdminViewer !== 'undefined' && isAttendanceAdminViewer === true;
  const attManageBtns = showAttendanceManageBtns ? [
    '<a href="/school/attendances/report" class="btn btn-outline-primary btn-md mb-2"><i class="bi bi-person-lines-fill me-1"></i> Student Attendance Report</a>',
    '<a href="/school/settings" class="btn btn-outline-primary btn-md mb-2"><i class="bi bi-gear me-1"></i> School Settings</a>',
    '<button type="button" id="btn_copyLink" class="btn btn-outline-primary btn-md mb-2" onclick="navigator.clipboard.writeText(window.location.href); alert(\'Link copied\');"><i class="bi bi-link-45deg me-1"></i> Copy Link</button>',
    '<a href="/school/grades-matrix" class="btn btn-outline-primary btn-md mb-2"><i class="bi bi-table me-1"></i> Grades Matrix</a>'
  ] : [];
%>

<%- include('partials/tablePages-start', {
  title,
  newUrl: null,
  newLabel: null,
  user,
  tableName: typeof tableName !== 'undefined' ? tableName : 'Attendance_Matrix',
  btn_export: false,
  print: false,
  optionalBtnsBeforePrint: [
    '<button type="button" id="btn_exportAttendanceExcel" class="btn btn-filled btn-success btn-md me-2 mb-2" disabled title="Load the matrix first"><i class="bi bi-cloud-download me-1"></i> Export</button>',
    '<button type="button" id="btn_printAttendanceMatrix" class="btn btn-filled btn-edit btn-md me-2 mb-2" disabled title="Load the matrix first">🖨 Print</button>'
  ],
  headerManageBtns: [
    '<a href="' + dashHref + '" class="school-navigator-dashboard btn btn-filled btn-secondary btn-md mb-2"><i class="bi bi-speedometer2 me-1"></i> School Dashboard</a>',
    '<a href="/dashboard/section-nav/SCHOOL_ACADEMIA" class="school-navigator-dashboard btn btn-filled btn-secondary btn-md mb-2"><i class="bi bi-journal-bookmark me-1"></i> School Academia</a>'
  ],
  manageBtns: attManageBtns
}) %>

<div class="schedule-shell">
    <p class="text-muted small mb-3">View and manage class attendance across sessions. Pick a class, set a date range, then apply to load the matrix.</p>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white d-flex align-items-center justify-content-between py-2 px-3">
            <div class="fw-bold text-dark"><i class="bi bi-funnel me-2"></i>Filter Attendance Matrix</div>
            <button
                id="attFilterToggleBtn"
                type="button"
                class="btn btn-outline-secondary btn-sm px-2"
                data-bs-toggle="collapse"
                data-bs-target="#attFilterCollapse"
                aria-expanded="true"
                aria-controls="attFilterCollapse"
                aria-label="Close filters">
                <i id="attFilterToggleIcon" class="bi bi-chevron-up"></i>
            </button>
        </div>
        <div class="collapse show" id="attFilterCollapse">
            <div class="card-body filter-panel p-3" id="attFilterForm">
                <div class="row g-3 align-items-end">
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label" for="filter_className">Class</label>
                        <div class="input-group">
                            <input type="hidden" id="filter_classId">
                            <input type="text" id="filter_className" class="form-control bg-white" placeholder="Select class..." readonly>
                            <button type="button" class="btn btn-outline-primary" id="btn_openClassPicker" title="Select class">
                                <i class="bi bi-book"></i>
                            </button>
                            <button type="button" class="btn btn-outline-secondary" id="btn_clearClass" title="Clear class">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-3">
                        <label class="form-label" for="filter_startDate">Start Date</label>
                        <input type="date" id="filter_startDate" class="form-control size-md">
                    </div>
                    <div class="col-lg-2 col-md-3">
                        <label class="form-label" for="filter_endDate">End Date</label>
                        <input type="date" id="filter_endDate" class="form-control size-md">
                    </div>
                    <div class="col-12 col-lg-4 d-flex justify-content-lg-end gap-2 pt-lg-2">
                        <button type="button" id="btn_loadData" class="btn btn-filled btn-primary btn-md">
                            <i class="bi bi-funnel me-1"></i> Apply
                        </button>
                        <button type="button" id="btn_reset" class="btn btn-outline-secondary btn-md">Reset</button>
                    </div>
                </div>
                <div class="border rounded-3 bg-white bg-opacity-75 p-2 mt-3">
                    <div class="small fw-bold text-uppercase text-muted mb-2">Quick Ranges</div>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm btn-range range-chip" data-range="today">Today</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm btn-range range-chip" data-range="twoWeeks">Two Weeks</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm btn-range range-chip" data-range="thisWeek">This Week</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm btn-range range-chip" data-range="prevWeek">Prev Week</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm btn-range range-chip" data-range="thisMonth">This Month</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm btn-range range-chip" data-range="prevMonth">Prev Month</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm btn-range range-chip" data-range="allTime">Whole Class (All Time)</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm d-none" id="resultsContainer">
        <div class="card-header bg-white border-bottom py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h5 class="m-0 fw-bold text-primary" id="lbl_displayClassName">Class Name</h5>
            <div class="d-flex align-items-center gap-2">
                <button type="button"
                    class="btn btn-sm btn-outline-secondary attendance-legend-icon-btn attendance-history-toggle-btn"
                    id="btn_attendanceMatrixHistory"
                    aria-label="Toggle change history"
                    title="Toggle change history"
                    aria-pressed="false">
                    <i class="bi bi-clock-history" aria-hidden="true"></i>
                </button>
                <button type="button"
                    class="btn btn-sm btn-outline-secondary attendance-legend-icon-btn"
                    id="btn_attendanceMatrixLegend"
                    data-attendance-open-legend
                    aria-label="Legend"
                    title="Legend">
                    <i class="bi bi-info-circle" aria-hidden="true"></i>
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="matrix-wrapper">
                <table class="table table-hover mb-0 matrix-table" id="attendanceTable">
                    <thead><tr id="matrixHeaders"></tr></thead>
                    <tbody id="matrixBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="attendanceMatrixLegendModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-2 px-3">
                <h6 class="modal-title mb-0 fw-semibold"><i class="bi bi-info-circle me-1"></i>Attendance Legend</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="attendanceMatrixLegendModalBody" class="attendance-legend-modal-body"></div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="attendanceCellHistoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header py-2 px-3">
                <h6 class="modal-title mb-0 fw-semibold"><i class="bi bi-clock-history me-1"></i>Attendance Change History</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="attendanceCellHistoryMeta" class="small text-muted mb-2"></div>
                <div id="attendanceCellHistoryLoading" class="text-center py-3 d-none">
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span class="ms-2">Loading history...</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-striped mb-0" id="attendanceCellHistoryTable">
                        <thead>
                            <tr>
                                <th>When</th>
                                <th>Who</th>
                                <th>From</th>
                                <th>To</th>
                            </tr>
                        </thead>
                        <tbody id="attendanceCellHistoryBody"></tbody>
                    </table>
                </div>
                <div id="attendanceCellHistoryEmpty" class="text-muted small py-2 d-none">No status changes recorded for this cell.</div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="cellDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-person-badge me-2"></i> Attendance Details
                </h5>
                <div class="ms-auto d-flex align-items-center gap-2">
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>
            <div class="modal-body">
                
                <input type="hidden" id="modal_classId">
                <input type="hidden" id="modal_sessionId">
                <input type="hidden" id="modal_personId">

                <div class="mb-3 pb-3 border-bottom">
                    <h5 class="fw-bold mb-1" id="det_studentName">Student Name</h5>
                    <div class="text-muted small" id="det_date">Date</div>
                    <p class="text-warning small mb-0 mt-2 d-none" id="cell_modal_lock_notice">This session is locked. Attendance cannot be changed unless an administrator unlocks it or overrides the lock.</p>
                    <p class="text-warning small mb-0 mt-2 d-none" id="cell_modal_makeup_notice">This session requires a make-up session. Attendance and roster notes cannot be changed here. Create or open the make-up session instead.</p>
                    <p class="text-secondary small mb-0 mt-2 d-none" id="cell_modal_enrollment_notice">This student was not enrolled for this session date. Attendance and roster details are read-only.</p>
                </div>

                <fieldset id="fieldset_cell_attendance" class="border-0 p-0 m-0 mb-4">
                    <legend class="fw-bold small text-secondary mb-2">Attendance</legend>
                    <div class="attendance-status-picker mb-3" role="group" aria-label="Attendance status">
                        <input type="radio" class="btn-check modal-att-option" name="modal_cell_attendance" id="modal_att_present" value="present" data-status="present">
                        <label class="btn btn-outline-success" for="modal_att_present" title="Present" data-status-label="present"><i class="bi bi-check-circle"></i>Present</label>
                        <input type="radio" class="btn-check modal-att-option" name="modal_cell_attendance" id="modal_att_late" value="late" data-status="late">
                        <label class="btn btn-outline-warning text-dark" for="modal_att_late" title="Late" data-status-label="late"><i class="bi bi-clock-history"></i>Late</label>
                        <input type="radio" class="btn-check modal-att-option" name="modal_cell_attendance" id="modal_att_absent" value="absent" data-status="absent">
                        <label class="btn btn-outline-danger" for="modal_att_absent" title="Absent" data-status-label="absent"><i class="bi bi-x-circle"></i>Absent</label>
                        <input type="radio" class="btn-check modal-att-option" name="modal_cell_attendance" id="modal_att_acf" value="acf" data-status="acf">
                        <label class="btn btn-outline-danger" for="modal_att_acf" title="Absent Camera Off" data-status-label="acf"><i class="bi bi-camera-video-off"></i>ACF</label>
                        <input type="radio" class="btn-check modal-att-option" name="modal_cell_attendance" id="modal_att_na" value="not_applicable" data-status="not_applicable">
                        <label class="btn btn-outline-secondary" for="modal_att_na" title="Not applicable" data-status-label="not_applicable"><i class="bi bi-dash-circle"></i>N/A</label>
                        <div class="d-none attendance-absence-excuse-slot" id="wrap_cellAbsenceExcused">
                            <input class="d-none" type="checkbox" id="inp_cellAbsenceExcused">
                            <button type="button" class="btn btn-outline-success btn-sm attendance-timing-toggle" id="btn_cellAbsenceExcused" aria-pressed="false">
                                <i class="bi bi-shield-plus"></i><span>Mark absence excused</span>
                            </button>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold small mb-0">Late arrival (mins)</label>
                            <input type="number" class="form-control form-control-sm" id="inp_cellLateMins" placeholder="0" min="0">
                            <div class="mt-2 d-none" id="wrap_cellLateExcused">
                                <input class="d-none" type="checkbox" id="inp_cellLateExcused">
                                <button type="button" class="btn btn-outline-success btn-sm attendance-timing-toggle" id="btn_cellLateExcused" aria-pressed="false">
                                    <i class="bi bi-shield-plus"></i><span>Mark late excused</span>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small mb-0">Left early (mins)</label>
                            <input type="number" class="form-control form-control-sm" id="inp_cellLeaveMins" placeholder="0" min="0">
                            <div class="mt-2 d-none" id="wrap_cellEarlyLeaveExcused">
                                <input class="d-none" type="checkbox" id="inp_cellEarlyLeaveExcused">
                                <button type="button" class="btn btn-outline-success btn-sm attendance-timing-toggle" id="btn_cellEarlyLeaveExcused" aria-pressed="false">
                                    <i class="bi bi-shield-plus"></i><span>Mark early leave excused</span>
                                </button>
                            </div>
                        </div>
                        <div class="col-12" id="wrap_cellExcuseNotes">
                            <label class="form-label fw-bold small mb-0">Excuse / reference notes</label>
                            <div class="row g-2 align-items-start" id="wrap_cellExcuseNotesEditor">
                                <div class="col-md-8">
                                    <textarea class="form-control form-control-sm" id="inp_cellExcuseRef" rows="3" placeholder="Add details..."></textarea>
                                </div>
                                <div class="col-md-4">
                                    <input type="file" class="form-control form-control-sm" id="inp_cellExcuseFile">
                                    <div class="small text-muted mt-1">Attach supporting file if needed.</div>
                                </div>
                            </div>
                            <div class="small mt-2 d-none" id="wrap_cellExcuseNotesReadonly"></div>
                            <div class="small mt-2" id="inp_cellExcuseAttachmentPreview"></div>
                        </div>
                    </div>

                    <div class="mb-0">
                        <label class="fw-bold small text-secondary" for="inp_rosterStudentNote">Student note (on roster)</label>
                        <textarea class="form-control form-control-sm" id="inp_rosterStudentNote" rows="2" placeholder="Optional note for this student on this session"></textarea>
                    </div>
                </fieldset>

                <div class="mb-3">
                    <label class="fw-bold text-primary"><i class="bi bi-chat-text me-1"></i> Admin Discussion</label>
                    <div class="comment-thread mb-3" id="det_commentsThread">
                        </div>

                    <div class="border rounded p-2 bg-white">
                        <div class="d-flex flex-wrap gap-1 mb-2" id="pendingMentionsArea"></div>
                        <textarea class="form-control border-0 bg-transparent p-0 mb-2" id="inp_newComment" rows="2" placeholder="Write a note..."></textarea>
                        <input type="file" class="form-control form-control-sm mb-2" id="inp_newCommentFile">
                        <div class="d-flex justify-content-between align-items-center border-top pt-2">
                            <button class="btn btn-sm btn-outline-secondary" id="btn_mentionUser"><i class="bi bi-at"></i> Tag User</button>
                            <button class="btn btn-sm btn-primary fw-bold" id="btn_saveComment">Send Note</button>
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <% if (typeof canEditAttendanceRoster !== 'undefined' && canEditAttendanceRoster) { %>
                <button type="button" class="btn btn-primary fw-bold" id="btn_saveAttendance">Save attendance</button>
                <% } %>
            </div>
        </div>
    </div>
</div>

<%- include('partials/modal_GenericPicker') %>
<%- include('partials/tablePages-end') %>
<script src="/scripts/attendanceMarkAppearanceClient.js"></script>

<script>
// Store the loaded matrix globally so we can access it on clicks
window.currentMatrixData = null;
window.attendanceHistoryModeOn = false;
window.attendanceVisiblePersonIds = null;
let currentMentions = [];
let detailsModalInstance = null;
let detailsModalAllowClose = false;
let detailsModalSnapshot = null;
let attendanceMatrixBusyToken = null;
let attendanceMatrixBusyDepth = 0;
let attendanceScopedRollupTimer = null;
const attendanceScopedRollupQueue = new Set();
const attendanceScopedRollupWaiters = [];
const ATTENDANCE_ACTION_STATE_HANDLED_ERROR = '__attendance_action_state_handled__';
// Set to a positive number only for local UI testing; null uses the server action-state limit.
const ATTENDANCE_MATRIX_UI_REQUEST_LIMIT_OVERRIDE = null;
const ATTENDANCE_MATRIX_MUTATION_BUDGET_SOURCES = new Set(['cell-save', 'comment-save']);
const attendanceRequestBudgetState = {
    maxAttempts: null,
    maxTimeMinutes: null,
    maxVolumeKB: null,
    attemptCount: 0,
    mutationCount: 0,
    exhausted: false,
    reloadPromptShown: false
};

function attEscapeHtml(value) {
    return String(value == null ? '' : value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
}

const DEFAULT_ENABLED_ATTENDANCE_STATUSES = ['present', 'late', 'absent', 'acf', 'not_applicable'];

function isAbsentLikeAttendanceStatus(attendance) {
    const att = String(attendance || '').trim().toLowerCase();
    return att === 'absent' || att === 'acf';
}

function attendanceAbsenceIsExcused(rec) {
    return attendanceFlagIsTrue(rec?.absenceExcused);
}

function getMatrixEnabledAttendanceStatuses(matrixData) {
    const list = matrixData?.enabledAttendanceStatuses;
    if (Array.isArray(list) && list.length) {
        return list.map((s) => String(s || '').trim().toLowerCase()).filter(Boolean);
    }
    return [...DEFAULT_ENABLED_ATTENDANCE_STATUSES];
}

function syncModalAttendanceOptions(enabledStatuses, currentStatus) {
    const enabled = new Set(enabledStatuses || DEFAULT_ENABLED_ATTENDANCE_STATUSES);
    const current = String(currentStatus || '').trim().toLowerCase();
    document.querySelectorAll('.modal-att-option').forEach((el) => {
        const code = String(el.value || '').trim().toLowerCase();
        const show = enabled.has(code) || code === current;
        const label = document.querySelector(`label[for="${el.id}"]`);
        el.classList.toggle('d-none', !show);
        if (label) label.classList.toggle('d-none', !show);
        if (!show) el.checked = false;
    });
}

function buildAttendanceLegendText(enabledStatuses) {
    if (window.AttendanceMarkAppearance?.buildAttendanceLegendText) {
        return window.AttendanceMarkAppearance.buildAttendanceLegendText({
            includeTimingNote: true,
            includeRollup: true,
            includeNotes: true
        });
    }
    const enabled = new Set(enabledStatuses || DEFAULT_ENABLED_ATTENDANCE_STATUSES);
    const parts = [];
    if (enabled.has('present')) parts.push('P Present');
    if (enabled.has('late')) parts.push('L Late');
    parts.push('E Excused absence (Absent/ACF + flag)');
    if (enabled.has('absent')) parts.push('A Absent');
    if (enabled.has('acf')) parts.push('ACF Absent Camera Off');
    if (enabled.has('not_applicable')) parts.push('— N/A');
    parts.push('Late excused · Early leave excused · Not marked · Notes exist');
    parts.push("minutes as late'/early' (e.g. L 12', L /5', or L 12'/5')");
    parts.push('Rollup % = time-based credit');
    return 'Legend: ' + parts.join(' · ');
}

function renderAttendanceMatrixLegend() {
    const modalBody = document.getElementById('attendanceMatrixLegendModalBody');
    if (!modalBody || !window.AttendanceMarkAppearance?.buildLegendEntries) return;
    const escapeLegend = (value) => String(value ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    const items = window.AttendanceMarkAppearance.buildLegendEntries().map((entry) => {
        if (window.AttendanceMarkAppearance.buildLegendItemHtml) {
            return window.AttendanceMarkAppearance.buildLegendItemHtml(entry);
        }
        return `<span class="attendance-legend-item">${escapeLegend(entry.label || entry.key || '')}</span>`;
    });
    items.push('<span class="attendance-legend-item"><i class="bi bi-percent text-secondary"></i> Rollup % = time-based credit</span>');
    const notesMark = window.AttendanceMarkAppearance.getMark?.('notes');
    const notesIcon = window.AttendanceMarkAppearance.buildMarkIconHtml
        ? window.AttendanceMarkAppearance.buildMarkIconHtml('notes')
        : '<i class="bi bi-chat-dots-fill status-notes"></i>';
    items.push(`<span class="attendance-legend-item">${notesIcon} ${escapeLegend(notesMark?.label || 'Notes exist')}</span>`);
    items.push('<span class="attendance-legend-item text-muted small">minutes as late\'/early\' (e.g. L 12\', L /5\', or L 12\'/5\')</span>');
    modalBody.innerHTML = `<div class="attendance-legend-items">${items.join('')}</div>`;
}

function openAttendanceMatrixLegendModal() {
    const modalEl = document.getElementById('attendanceMatrixLegendModal');
    if (!modalEl || !window.bootstrap?.Modal) return;
    renderAttendanceMatrixLegend();
    window.bootstrap.Modal.getOrCreateInstance(modalEl).show();
}

function resetAttendanceStudentVisibility(matrixRows) {
    const ids = new Set();
    (Array.isArray(matrixRows) ? matrixRows : []).forEach((stu) => {
        const id = String(stu?.personId || '').trim();
        if (id) ids.add(id);
    });
    window.attendanceVisiblePersonIds = ids;
    return ids;
}

function getAttendanceVisiblePersonIds() {
    if (window.attendanceVisiblePersonIds instanceof Set) return window.attendanceVisiblePersonIds;
    return resetAttendanceStudentVisibility(window.currentMatrixData?.matrix || []);
}

function buildAttendanceStudentFilterDropdownHtml(students, visibleIds) {
    const rows = Array.isArray(students) ? students : [];
    const visible = visibleIds instanceof Set ? visibleIds : new Set();
    const total = rows.length;
    const shown = rows.reduce((count, stu) => {
        const id = String(stu?.personId || '').trim();
        return count + (id && visible.has(id) ? 1 : 0);
    }, 0);
    const items = rows.map((stu) => {
        const id = String(stu?.personId || '').trim();
        if (!id) return '';
        const name = String(stu?.name || id).trim() || id;
        const checked = visible.has(id) ? ' checked' : '';
        return `
          <li class="px-3 py-1">
            <div class="form-check mb-0">
              <input class="form-check-input matrix-student-visibility-check" type="checkbox" value="${attEscapeHtml(id)}" id="attVis_${attEscapeHtml(id)}"${checked}>
              <label class="form-check-label" for="attVis_${attEscapeHtml(id)}">${attEscapeHtml(name)}</label>
            </div>
          </li>`;
    }).join('');
    return `
      <div class="d-flex flex-column align-items-start gap-1">
        <div class="fw-bold">Student Name</div>
        <div class="dropdown matrix-student-filter-dropdown">
          <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" id="btn_matrixStudentFilter">
            <i class="bi bi-people me-1"></i>Students <span class="matrix-student-filter-count">${shown}/${total}</span>
          </button>
          <ul class="dropdown-menu shadow-sm p-0 attendance-student-filter-menu" aria-labelledby="btn_matrixStudentFilter">
            <li class="px-3 py-2 border-bottom bg-light sticky-top">
              <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-primary btn-sm flex-fill" id="btn_matrixStudentSelectAll">Select All</button>
                <button type="button" class="btn btn-outline-secondary btn-sm flex-fill" id="btn_matrixStudentClearAll">Clear All</button>
              </div>
            </li>
            ${items || '<li class="px-3 py-2 text-muted small">No students loaded.</li>'}
          </ul>
        </div>
      </div>`;
}

function updateAttendanceStudentFilterCount() {
    const label = document.querySelector('#attendanceTable .matrix-student-filter-count');
    if (!label) return;
    const total = Array.isArray(window.currentMatrixData?.matrix) ? window.currentMatrixData.matrix.length : 0;
    const visible = getAttendanceVisiblePersonIds().size;
    label.textContent = `${Math.min(visible, total)}/${total}`;
}

function applyAttendanceStudentVisibility() {
    const visible = getAttendanceVisiblePersonIds();
    document.querySelectorAll('#matrixBody tr.matrix-student-row').forEach((row) => {
        const id = String(row.getAttribute('data-person-id') || '').trim();
        row.classList.toggle('is-student-hidden', !(id && visible.has(id)));
    });
    updateAttendanceStudentFilterCount();
}

function mountStudentFilterDropdownOutside(dropdownRoot) {
    const toggle = dropdownRoot?.querySelector?.('[data-bs-toggle="dropdown"]');
    const menu = dropdownRoot?.querySelector?.('.dropdown-menu');
    if (!toggle || !menu || typeof bootstrap === 'undefined' || !bootstrap.Dropdown) return null;

    const existing = bootstrap.Dropdown.getInstance(toggle);
    if (existing) existing.dispose();

    const instance = new bootstrap.Dropdown(toggle, {
        autoClose: 'outside',
        popperConfig(defaultConfig) {
            const config = typeof defaultConfig === 'object' && defaultConfig ? { ...defaultConfig } : {};
            config.strategy = 'fixed';
            const modifiers = Array.isArray(config.modifiers) ? config.modifiers.slice() : [];
            modifiers.push({
                name: 'preventOverflow',
                options: { boundary: 'viewport', padding: 8 }
            });
            modifiers.push({
                name: 'flip',
                options: { fallbackPlacements: ['bottom-start', 'top-start', 'bottom-end', 'top-end'] }
            });
            config.modifiers = modifiers;
            return config;
        }
    });

    if (toggle.dataset.studentFilterOutsideBound === '1') return instance;
    toggle.dataset.studentFilterOutsideBound = '1';

    toggle.addEventListener('show.bs.dropdown', () => {
        if (menu.parentElement !== document.body) {
            menu.dataset.returnToParent = '1';
            document.body.appendChild(menu);
        }
        menu.classList.add('attendance-student-filter-menu-floating', 'show');
    });

    toggle.addEventListener('hidden.bs.dropdown', () => {
        menu.classList.remove('attendance-student-filter-menu-floating', 'show');
        if (menu.dataset.returnToParent === '1' && dropdownRoot.isConnected) {
            dropdownRoot.appendChild(menu);
            delete menu.dataset.returnToParent;
        }
    });

    return instance;
}

function bindAttendanceStudentVisibilityDropdown() {
    const table = document.getElementById('attendanceTable');
    if (!table) return;
    const dropdownRoot = table.querySelector('.matrix-student-filter-dropdown');
    const menu = dropdownRoot?.querySelector('.dropdown-menu') || table;

    mountStudentFilterDropdownOutside(dropdownRoot);

    const bindRoot = (root) => {
        root.querySelectorAll?.('.matrix-student-visibility-check')?.forEach((input) => {
            input.addEventListener('change', () => {
                const id = String(input.value || '').trim();
                if (!id) return;
                const visible = getAttendanceVisiblePersonIds();
                if (input.checked) visible.add(id);
                else visible.delete(id);
                applyAttendanceStudentVisibility();
            });
        });

        root.querySelector('#btn_matrixStudentSelectAll')?.addEventListener('click', (event) => {
            event.preventDefault();
            event.stopPropagation();
            resetAttendanceStudentVisibility(window.currentMatrixData?.matrix || []);
            const checks = document.querySelectorAll('.matrix-student-visibility-check');
            checks.forEach((input) => { input.checked = true; });
            applyAttendanceStudentVisibility();
        });

        root.querySelector('#btn_matrixStudentClearAll')?.addEventListener('click', (event) => {
            event.preventDefault();
            event.stopPropagation();
            window.attendanceVisiblePersonIds = new Set();
            const checks = document.querySelectorAll('.matrix-student-visibility-check');
            checks.forEach((input) => { input.checked = false; });
            applyAttendanceStudentVisibility();
        });
    };

    bindRoot(menu);
}

function getVisibleAttendanceMatrixForPrint(matrixData) {
    const data = matrixData && typeof matrixData === 'object' ? { ...matrixData } : {};
    const allStudents = Array.isArray(data.matrix) ? data.matrix : [];
    const visible = getAttendanceVisiblePersonIds();
    data.matrix = allStudents.filter((stu) => {
        const id = String(stu?.personId || '').trim();
        return id && visible.has(id);
    });
    return data;
}

function formatSchoolInstant(value) {
    if (window.AppOrgDateTime && typeof window.AppOrgDateTime.formatSchoolInstant === 'function') {
        return window.AppOrgDateTime.formatSchoolInstant(value);
    }
    if (window.AppOrgDateTime && typeof window.AppOrgDateTime.formatInstant === 'function') {
        return window.AppOrgDateTime.formatInstant(value);
    }
    return '-';
}

const attendanceAttachmentEscape = (value) => String(value ?? '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');

async function uploadAttendanceFile(input, category, classId, sessionId, studentPersonId = '') {
    const file = input?.files && input.files[0];
    if (!file) return null;
    if (!(await ensureAttendanceRequestBudgetAvailable())) {
        throw new Error(ATTENDANCE_ACTION_STATE_HANDLED_ERROR);
    }
    const body = new FormData();
    body.append('kind', category || 'attendance');
    body.append('classId', classId || '');
    body.append('sessionId', sessionId || '');
    body.append('studentPersonId', studentPersonId || '');
    body.append('actionStateId', window.ATTENDANCE_ACTION_STATE_ID || '');
    body.append('file', file);
    const res = await fetch('/school/attendances/api/files/upload', {
        method: 'POST',
        headers: { 'X-AJAX-Request': 'true' },
        body
    });
    const result = await res.json().catch(() => null);
    hydrateAttendanceBudgetFromApi(res, result, { estimateAttempt: true, source: 'file-upload' });
    if (!res.ok || !result || result.status !== 'success') {
        const handled = await handleAttendanceActionStateFailure(result || {});
        if (handled) throw new Error(ATTENDANCE_ACTION_STATE_HANDLED_ERROR);
        throw new Error(result?.message || 'File upload failed.');
    }
    return result.file || null;
}

function renderAttendanceAttachmentLink(attachment, emptyText = '') {
    const att = attachment && typeof attachment === 'object' ? attachment : null;
    if (!att) return emptyText;
    const href = att.dataUrl || att.url || att.uploadUrl || att.storagePath || att.path || '';
    if (!href) return `<span class="text-muted">${attendanceAttachmentEscape(att.name || 'Attached file')}</span>`;
    return `<a href="${attendanceAttachmentEscape(href)}" target="_blank" rel="noopener" class="text-decoration-none"><i class="bi bi-paperclip me-1"></i>${attendanceAttachmentEscape(att.name || att.originalName || 'Open attachment')}</a>`;
}

function showAttendanceMatrixMessage({ title = 'Attendance Matrix', icon = 'info', message = '', buttons = null } = {}) {
    try { hideAttendanceMatrixBusy(true); } catch (_) {}
    const safeMessage = String(message || '').trim() || 'Operation could not be completed.';
    const safeButtons = Array.isArray(buttons) && buttons.length
        ? buttons
        : [{ text: 'Close', class: icon === 'error' ? 'btn-danger' : 'btn-primary' }];
    if (typeof window.showMessageModal === 'function') {
        return window.showMessageModal({ title, icon, message: safeMessage, buttons: safeButtons });
    }
    alert(safeMessage.replace(/<[^>]*>/g, ''));
    return Promise.resolve();
}

function parseAttendancePositiveInteger(value) {
    const n = Number(value);
    return Number.isFinite(n) && n > 0 ? Math.floor(n) : null;
}

function parseAttendanceNonNegativeInteger(value) {
    const n = Number(value);
    return Number.isFinite(n) && n >= 0 ? Math.floor(n) : null;
}

function resolveAttendanceActionStateId() {
    return String(window.ATTENDANCE_ACTION_STATE_ID || '').trim();
}

function setAttendanceActionStateId(nextId) {
    const value = String(nextId || '').trim();
    if (!value) return;
    window.ATTENDANCE_ACTION_STATE_ID = value;
}

function setAttendanceBudgetState(nextState = {}) {
    const maxAttempts = parseAttendancePositiveInteger(nextState.maxAttempts);
    const maxTimeMinutes = parseAttendancePositiveInteger(nextState.maxTimeMinutes);
    const maxVolumeKB = parseAttendancePositiveInteger(nextState.maxVolumeKB);
    const attemptCount = parseAttendanceNonNegativeInteger(nextState.attemptCount);
    if (maxAttempts != null) attendanceRequestBudgetState.maxAttempts = maxAttempts;
    if (maxTimeMinutes != null) attendanceRequestBudgetState.maxTimeMinutes = maxTimeMinutes;
    if (maxVolumeKB != null) attendanceRequestBudgetState.maxVolumeKB = maxVolumeKB;
    if (attemptCount != null) attendanceRequestBudgetState.attemptCount = attemptCount;
    syncAttendanceRequestBudgetExhausted({ prompt: false });
}

function getActiveAttendanceRangeChip() {
    const active = document.querySelector('.btn-range.range-chip.active');
    return active ? String(active.getAttribute('data-range') || '').trim() : '';
}

function captureAttendanceMatrixFilterState() {
    const classId = String(document.getElementById('filter_classId')?.value || window.currentMatrixData?.classId || '').trim();
    const className = String(document.getElementById('filter_className')?.value || window.currentMatrixData?.className || '').trim();
    const startDate = String(document.getElementById('filter_startDate')?.value || '').trim();
    const endDate = String(document.getElementById('filter_endDate')?.value || '').trim();
    const range = getActiveAttendanceRangeChip();
    return { classId, className, startDate, endDate, range };
}

function buildAttendanceMatrixReloadUrl(state = {}) {
    const url = new URL(`${window.location.origin}/school/attendances`);
    const next = state && typeof state === 'object' ? state : captureAttendanceMatrixFilterState();
    if (next.classId) url.searchParams.set('classId', next.classId);
    if (next.className && next.className !== 'Loading Class Data...') {
        url.searchParams.set('className', next.className);
    }
    if (next.startDate) url.searchParams.set('startDate', next.startDate);
    if (next.endDate) url.searchParams.set('endDate', next.endDate);
    if (next.range) url.searchParams.set('range', next.range);
    return url.pathname + url.search;
}

function navigateAttendanceMatrixReload(state) {
    window.location.assign(buildAttendanceMatrixReloadUrl(state));
}

function resolveEffectiveAttendanceRequestMaxAttempts() {
    const override = Number(ATTENDANCE_MATRIX_UI_REQUEST_LIMIT_OVERRIDE);
    if (Number.isFinite(override) && override > 0) return Math.floor(override);
    const serverMax = attendanceRequestBudgetState.maxAttempts;
    return serverMax > 0 ? serverMax : 0;
}

function resolveEffectiveAttendanceRequestCount() {
    const override = Number(ATTENDANCE_MATRIX_UI_REQUEST_LIMIT_OVERRIDE);
    if (Number.isFinite(override) && override > 0) {
        return attendanceRequestBudgetState.mutationCount || 0;
    }
    return attendanceRequestBudgetState.attemptCount;
}

function clearAttendanceBudgetNotice() {
    const notice = document.getElementById('attendanceBudgetNotice');
    if (notice) notice.remove();
}

function syncAttendanceRequestBudgetFromUsage() {
    clearAttendanceBudgetNotice();
    syncAttendanceRequestBudgetExhausted({ prompt: true });
}

function syncAttendanceRequestBudgetExhausted({ prompt = true } = {}) {
    const maxAttempts = resolveEffectiveAttendanceRequestMaxAttempts();
    const attemptCount = resolveEffectiveAttendanceRequestCount();
    const isExhausted = maxAttempts > 0 && attemptCount >= maxAttempts;
    const wasExhausted = attendanceRequestBudgetState.exhausted;
    attendanceRequestBudgetState.exhausted = isExhausted;
    if (prompt && isExhausted && !wasExhausted && !attendanceRequestBudgetState.reloadPromptShown) {
        void promptAttendanceMatrixReload({ reason: 'limit_reached' });
    }
}

async function ensureAttendanceRequestBudgetAvailable() {
    syncAttendanceRequestBudgetExhausted({ prompt: true });
    if (!attendanceRequestBudgetState.exhausted) return true;
    if (!attendanceRequestBudgetState.reloadPromptShown) {
        await promptAttendanceMatrixReload({ reason: 'limit_reached' });
    }
    return false;
}

async function promptAttendanceMatrixReload({ reason = 'limit_reached', serverMessage = '' } = {}) {
    if (attendanceRequestBudgetState.reloadPromptShown) return false;
    attendanceRequestBudgetState.reloadPromptShown = true;
    attendanceRequestBudgetState.exhausted = true;

    const attemptCount = attendanceRequestBudgetState.attemptCount;
    const effectiveCount = resolveEffectiveAttendanceRequestCount();
    const maxAttempts = resolveEffectiveAttendanceRequestMaxAttempts();
    const attemptUsage = maxAttempts > 0
        ? `<p class="small text-muted mt-2 mb-0">Requests used: <strong>${effectiveCount}</strong> / <strong>${maxAttempts}</strong></p>`
        : '';

    let body = '';
    if (reason === 'limit_reached') {
        body = `<p class="mb-2">This attendance page can only send a limited number of updates at one time. You have reached that limit.</p>
            <p class="mb-2">Attendance you already saved is stored. If you have an attendance cell open with unsaved changes, save or note them before reloading.</p>
            <p class="mb-0">Click <strong>Reload page</strong> to continue with the same class and date filters.</p>${attemptUsage}`;
    } else {
        const cleaned = String(serverMessage || '').trim();
        body = `${cleaned || '<p class="mb-0">The attendance page session is no longer valid.</p>'}
            <p class="mt-2 mb-0">Click <strong>Reload page</strong> to continue with the same class and date filters.</p>${attemptUsage}`;
    }

    const reloadChoice = await showAttendanceMatrixMessage({
        title: 'Attendance page needs a refresh',
        icon: 'warning',
        message: body,
        buttons: [
            { text: 'Close', class: 'btn-secondary', value: false },
            { text: 'Reload page', class: 'btn-primary', value: true }
        ]
    });
    if (reloadChoice === true || reloadChoice?.value === true || reloadChoice === 'Reload page') {
        navigateAttendanceMatrixReload(captureAttendanceMatrixFilterState());
        return true;
    }
    return false;
}

function attendanceSanitizeMessageText(message) {
    return String(message || '').replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
}

function hydrateAttendanceBudgetFromApi(response, result, options = {}) {
    const estimateAttempt = options.estimateAttempt !== false;
    const source = String(options.source || 'unknown').trim();
    let countedFromServer = false;
    const headers = response?.headers;
    if (headers && typeof headers.get === 'function') {
        setAttendanceActionStateId(headers.get('x-action-state-id'));
        const headerAttemptRaw = headers.get('x-action-state-attempt-count');
        if (headerAttemptRaw != null && String(headerAttemptRaw).trim() !== '') countedFromServer = true;
        setAttendanceBudgetState({
            attemptCount: headerAttemptRaw,
            maxAttempts: headers.get('x-action-state-max-attempts'),
            maxTimeMinutes: headers.get('x-action-state-max-time-minutes'),
            maxVolumeKB: headers.get('x-action-state-max-volume-kb')
        });
    }
    const context = result?.actionStateContext;
    if (context && typeof context === 'object') {
        countedFromServer = true;
        setAttendanceBudgetState({
            attemptCount: context.attemptCount,
            maxAttempts: context.maxAttempts
        });
    } else if (estimateAttempt && !countedFromServer) {
        attendanceRequestBudgetState.attemptCount += 1;
    }
    if (
        ATTENDANCE_MATRIX_MUTATION_BUDGET_SOURCES.has(source)
        && result
        && typeof result === 'object'
        && result.status === 'success'
    ) {
        attendanceRequestBudgetState.mutationCount += 1;
    }
    syncAttendanceRequestBudgetFromUsage();
}

function isHandledAttendanceActionStateError(error) {
    return String(error?.message || '').trim() === ATTENDANCE_ACTION_STATE_HANDLED_ERROR;
}

function isAttendanceActionStateFailureMessage(message) {
    const text = attendanceSanitizeMessageText(message).toLowerCase();
    if (!text) return false;
    return text.includes('security violation')
        || text.includes('session validation failed')
        || text.includes('missing action state token')
        || text.includes('action state token')
        || text.includes('action session has expired')
        || text.includes('too many attempts');
}

function isAttendanceActionStateReloadRecommended(message) {
    const text = attendanceSanitizeMessageText(message).toLowerCase();
    if (!text) return false;
    return text.includes('too many attempts')
        || text.includes('session validation failed')
        || text.includes('missing action state token')
        || text.includes('action session has expired')
        || text.includes('invalid action state')
        || text.includes('action state not found');
}

async function handleAttendanceActionStateFailure(result) {
    const message = String(result?.message || '').trim();
    const context = result?.actionStateContext;
    const hasContext = context && typeof context === 'object';
    if (!hasContext && !isAttendanceActionStateFailureMessage(message)) return false;

    if (hasContext) {
        setAttendanceBudgetState({
            attemptCount: context.attemptCount,
            maxAttempts: context.maxAttempts
        });
        syncAttendanceRequestBudgetFromUsage();
    }

    if (!isAttendanceActionStateReloadRecommended(message)) return false;

    await promptAttendanceMatrixReload({
        reason: 'session_invalid',
        serverMessage: message || '<p class="mb-0">The attendance page session is no longer valid.</p>'
    });
    return true;
}

function showAttendanceMatrixBusy({
    title = 'Working...',
    note = 'Please wait while the attendance matrix is updated.',
    operation = 'Attendance Matrix'
} = {}) {
    attendanceMatrixBusyDepth += 1;
    if (typeof window.showLoading === 'function') {
        if (!attendanceMatrixBusyToken) {
            attendanceMatrixBusyToken = window.showLoading({ title, note, operation });
        } else if (typeof window.updateLoading === 'function') {
            window.updateLoading({ title, note, operation });
        }
    }
}

function hideAttendanceMatrixBusy(force = false) {
    attendanceMatrixBusyDepth = force ? 0 : Math.max(0, attendanceMatrixBusyDepth - 1);
    if (attendanceMatrixBusyDepth > 0) return;
    try {
        if (typeof window.hideLoading === 'function') {
            if (attendanceMatrixBusyToken) window.hideLoading(attendanceMatrixBusyToken);
            else window.hideLoading();
        }
    } catch (_) {}
    attendanceMatrixBusyToken = null;
}

