<div class="modal fade" id="reportAiAssistModal" tabindex="-1" aria-labelledby="reportAiAssistModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable modal-lg">
    <div class="modal-content">
      <div class="modal-header py-2">
        <div>
          <h5 class="modal-title fw-bold" id="reportAiAssistModalLabel"><i class="bi bi-robot me-2 text-primary"></i>AI Assist</h5>
          <div class="small text-muted" id="reportAiAssistModalSubtitle"></div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div id="reportAiAssistServicePickerWrap" class="mb-3 d-none">
          <label class="form-label fw-semibold" for="reportAiAssistServiceSelect">Service</label>
          <select id="reportAiAssistServiceSelect" class="form-select size-md"></select>
        </div>
        <p class="small text-muted mb-3" id="reportAiAssistServiceDescription"></p>
        <div id="reportAiAssistInputsHost" class="row g-3 mb-3"></div>
        <div id="reportAiAssistModalResult" class="d-none border rounded bg-light p-3">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="fw-semibold small text-uppercase text-muted">Result</span>
            <button type="button" class="btn btn-outline-secondary btn-sm" id="reportAiAssistModalCopyResult"><i class="bi bi-clipboard me-1"></i>Copy</button>
          </div>
          <pre id="reportAiAssistModalResultBody" class="small mb-0" style="white-space: pre-wrap; max-height: 280px; overflow: auto;"></pre>
        </div>
      </div>
      <div class="modal-footer py-2 flex-wrap gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Close</button>
        <button type="button" class="btn btn-filled btn-primary btn-sm" id="reportAiAssistModalRunBtn">
          <i class="bi bi-stars me-1"></i>Perform AI Assist
        </button>
      </div>
    </div>
  </div>
</div>

<div id="reportAiAssistResultsTray" class="card border-0 shadow-sm mb-4 d-none">
  <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
    <span class="fw-bold"><i class="bi bi-robot me-2 text-primary"></i>AI Assist results</span>
    <button type="button" class="btn btn-outline-secondary btn-sm" id="reportAiAssistTrayClearBtn">Clear</button>
  </div>
  <div class="card-body p-3" id="reportAiAssistResultsTrayBody"></div>
</div>