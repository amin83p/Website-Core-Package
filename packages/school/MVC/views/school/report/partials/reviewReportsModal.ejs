<style>
  .review-reports-icon-btn {
    width: 2rem;
    height: 2rem;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }
  .review-reports-row-actions {
    max-width: 11rem;
  }
</style>
<div class="modal fade" id="reviewReportsModal" tabindex="-1" aria-labelledby="reviewReportsModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable review-reports-modal-dialog">
    <div class="modal-content review-reports-modal-content">
      <div class="modal-header py-3">
        <div>
          <h5 class="modal-title fw-bold" id="reviewReportsModalLabel"><i class="bi bi-clipboard-check me-2 text-primary"></i>Review Reports</h5>
          <div class="small text-muted mt-1">Pick a date range to list assigned report rows by teacher, then open Fill Reports to review, edit, and lock.</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body pt-2 review-reports-modal-body">
        <div class="row g-3 align-items-end mb-3">
          <div class="col-md-4">
            <label class="form-label" for="reviewReportsStartDate">Start date</label>
            <input type="date" id="reviewReportsStartDate" class="form-control size-md">
          </div>
          <div class="col-md-4">
            <label class="form-label" for="reviewReportsEndDate">End date</label>
            <input type="date" id="reviewReportsEndDate" class="form-control size-md">
          </div>
          <div class="col-md-4">
            <button type="button" class="btn btn-filled btn-primary btn-md w-100" id="btn_reviewReportsLoad">
              <i class="bi bi-search me-1"></i> Load assignments
            </button>
          </div>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3" id="reviewReportsRangeChips" role="group" aria-label="Date range shortcuts">
          <button type="button" class="btn btn-outline-secondary btn-sm review-reports-range-chip" data-range="thisMonth">This month</button>
          <button type="button" class="btn btn-outline-secondary btn-sm review-reports-range-chip" data-range="lastMonth">Last month</button>
          <button type="button" class="btn btn-outline-secondary btn-sm review-reports-range-chip" data-range="lastMonthFirstHalf">Last month · 1st half</button>
          <button type="button" class="btn btn-outline-secondary btn-sm review-reports-range-chip" data-range="lastMonthSecondHalf">Last month · 2nd half</button>
          <button type="button" class="btn btn-outline-secondary btn-sm review-reports-range-chip" data-range="currentMonthFirstHalf">This month · 1st half</button>
          <button type="button" class="btn btn-outline-secondary btn-sm review-reports-range-chip" data-range="currentMonthSecondHalf">This month · 2nd half</button>
        </div>
        <div id="reviewReportsWarning" class="alert alert-warning d-none mb-3" role="alert"></div>
        <div id="reviewReportsLoading" class="text-center text-muted py-4 d-none">
          <div class="spinner-border spinner-border-sm text-primary me-2" role="status" aria-hidden="true"></div>
          Loading assignments…
        </div>
        <div id="reviewReportsEmpty" class="text-center text-muted py-4 d-none">No semi-monthly report assignments match this date range.</div>
        <div id="reviewReportsResults" class="d-none"></div>
      </div>
      <div class="modal-footer py-2">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>