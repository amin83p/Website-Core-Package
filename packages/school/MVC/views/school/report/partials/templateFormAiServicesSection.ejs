<div class="card border-0 shadow-sm mb-3 template-form-section">
  <div class="card-header p-0">
    <button class="btn w-100 text-start d-flex align-items-center justify-content-between gap-2 px-3 py-3 template-section-toggle collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAiServices" aria-expanded="false" aria-controls="collapseAiServices">
      <span class="d-flex align-items-center gap-2 flex-wrap">
        <h5 class="m-0 fw-bold">AI services</h5>
        <span class="badge bg-light text-dark border">Template bindings</span>
      </span>
      <i class="bi bi-chevron-down template-section-chevron" aria-hidden="true"></i>
    </button>
  </div>
  <div id="collapseAiServices" class="collapse">
    <div class="card-body p-3 border-top">
      <div class="alert alert-light border small mb-3">
        Attach one or more School AI services to this template. Each input can pull from a report field, a DOCX prefill key, static text, or stay empty for teachers to fill on the instance.
        Configure prompts under <strong>School AI Assist → Service Definitions</strong>.
      </div>
      <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
        <select class="form-select form-select-sm" id="templateAiServiceAddSelect" style="max-width: 320px;">
          <option value="">Add AI service…</option>
          <% (Array.isArray(aiServiceCatalogRows) ? aiServiceCatalogRows : []).forEach((svc) => { %>
            <option value="<%= svc.serviceKey %>"><%= svc.label || svc.serviceKey %></option>
          <% }) %>
        </select>
        <button type="button" class="btn btn-outline-primary btn-sm" id="btnTemplateAiServiceAdd"><i class="bi bi-plus-lg me-1"></i>Add</button>
      </div>
      <div id="templateAiServicesList" class="d-flex flex-column gap-3"></div>
      <p class="small text-muted mb-0 mt-3" id="templateAiServicesEmptyHint">No AI services configured on this template.</p>
    </div>
  </div>
</div>