<div class="modal fade" id="smmrByFunderModal" tabindex="-1" aria-labelledby="smmrByFunderModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable smmr-by-funder-modal-dialog">
    <div class="modal-content smmr-by-funder-modal-content">
      <div class="modal-header py-3">
        <div>
          <h5 class="modal-title fw-bold" id="smmrByFunderModalLabel"><i class="bi bi-diagram-3 me-2 text-primary"></i>Report By Funder</h5>
          <div class="small text-muted mt-1">Choose a funder and date range, then select students to load on the semi-monthly report.</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body pt-2 smmr-by-funder-modal-body">
        <div class="row g-3 align-items-end mb-3">
          <div class="col-md-4">
            <label class="form-label" for="smmrByFunderSelect">Funder</label>
            <select id="smmrByFunderSelect" class="form-select size-md">
              <option value="">Choose funder…</option>
              <% (Array.isArray(funderPickerOptions) ? funderPickerOptions : []).forEach((opt) => { %>
                <option value="<%= String(opt.id || '').replace(/"/g, '&quot;') %>"><%= opt.label || opt.id %></option>
              <% }); %>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label" for="smmrByFunderStartDate">Start date</label>
            <input type="date" id="smmrByFunderStartDate" class="form-control size-md">
          </div>
          <div class="col-md-3">
            <label class="form-label" for="smmrByFunderEndDate">End date</label>
            <input type="date" id="smmrByFunderEndDate" class="form-control size-md">
          </div>
          <div class="col-md-2">
            <button type="button" class="btn btn-filled btn-primary btn-md w-100" id="btn_smmrByFunderLoad">
              <i class="bi bi-search me-1"></i> Load
            </button>
          </div>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
          <button type="button" class="btn btn-outline-secondary btn-sm" id="btn_smmrByFunderSelectAll">Select all</button>
          <button type="button" class="btn btn-outline-secondary btn-sm" id="btn_smmrByFunderSelectNone">Unselect all</button>
          <span class="small text-muted ms-auto" id="smmrByFunderSelectionCount">0 selected</span>
        </div>
        <div id="smmrByFunderLoading" class="text-center text-muted py-4 d-none">
          <div class="spinner-border spinner-border-sm text-primary me-2" role="status" aria-hidden="true"></div>
          Loading students…
        </div>
        <div id="smmrByFunderEmpty" class="text-center text-muted py-4 d-none">No matching enrollments for this funder and date range.</div>
        <div id="smmrByFunderTableWrap" class="d-none table-responsive smmr-by-funder-table-wrap flex-grow-1">
          <table class="table table-hover align-middle mb-0 smmr-by-funder-table" id="smmrByFunderTable">
            <thead class="table-light">
              <tr>
                <th class="ps-3 smmr-by-funder-check-col"><input type="checkbox" class="form-check-input" id="smmrByFunderCheckAll" title="Select all"></th>
                <th>Student</th>
                <th>Class</th>
                <th>Enrollment</th>
              </tr>
            </thead>
            <tbody id="smmrByFunderTableBody"></tbody>
          </table>
        </div>
      </div>
      <div class="modal-footer py-2">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-filled btn-primary btn-sm" id="btn_smmrByFunderApply" disabled>Apply selection</button>
      </div>
    </div>
  </div>
</div>
