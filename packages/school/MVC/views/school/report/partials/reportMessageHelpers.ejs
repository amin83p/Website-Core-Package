<script>
(() => {
  if (window.ReportMessaging?.ready) return;

  function escapeReportMessage(value) {
    return String(value ?? '').replace(/[&<>"']/g, (char) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;'
    }[char]));
  }

  function plainReportMessage(value) {
    return String(value ?? '').replace(/<br\s*\/?>/gi, '\n').replace(/<[^>]+>/g, '').trim();
  }

  function formatPdfAcroFieldType(rawType = '') {
    const token = String(rawType || '').trim();
    if (!token) return 'Unknown';
    return token
      .replace(/^PDF/i, '')
      .replace(/Field$/i, '')
      .replace(/([a-z])([A-Z])/g, '$1 $2')
      .trim() || token;
  }

  function buildSnapshotComplianceSaveFailureModalHtml(compliance = {}, options = {}) {
    const inner = buildTemplateFileComplianceModalHtml(compliance, options);
    return (
      '<div class="text-start report-compliance-save-failure">'
      + '<p class="mb-3">The template was not saved. Your Word file uses placeholders that are not covered by <strong>Lock Snapshot Keys</strong> (or their DOCX shortcuts).</p>'
      + inner
      + '</div>'
    );
  }

  function buildTemplateFileComplianceModalHtml(result = {}, options = {}) {
    const results = Array.isArray(result.results) ? result.results : [];
    const skippedReason = options.skippedReason || 'Add keys before checking templates.';
    const passLineSuffix = options.passLineSuffix || 'passed the check';
    const failureIntro = options.failureIntro || 'These placeholders are not allowed:';
    const tokenFixHint = options.tokenFixHint || 'Remove them from the file or add the keys to your template.';

    if (result.snapshotConfigured === false || results.some((row) => row.skipped && row.reason)) {
      const reason = results.find((row) => row.reason)?.reason || skippedReason;
      return `<div class="text-start report-compliance-modal"><p class="mb-0">${escapeReportMessage(reason)}</p></div>`;
    }

    if (result.ok) {
      const lines = results.filter((row) => !row.skipped).map((row) => {
        const count = Number(row.tokensChecked || 0);
        const suffix = count ? ` (${count} placeholder token${count === 1 ? '' : 's'} checked)` : '';
        return `<li><strong>${escapeReportMessage(row.label || 'Template')}:</strong> ${escapeReportMessage(passLineSuffix)}${escapeReportMessage(suffix)}.</li>`;
      });
      return `<div class="text-start report-compliance-modal"><ul class="mb-0 ps-3">${lines.join('') || '<li>Check completed.</li>'}</ul></div>`;
    }

    const blocks = results.filter((row) => row.ok === false).map((row) => {
      const issues = Array.isArray(row.issues) ? row.issues : [];
      const tokenIssues = issues.filter((issue) => (issue.type === 'token' || issue.type === 'pdf_placeholder') && issue.token);
      const otherIssues = issues.filter((issue) => !((issue.type === 'token' || issue.type === 'pdf_placeholder') && issue.token));
      const extraCount = Math.max(0, Number(row.totalIssueCount || 0) - issues.length);

      let body = '';
      if (tokenIssues.length) {
        body += `<p class="small text-muted mb-2">${escapeReportMessage(failureIntro)}</p>`;
        body += '<ul class="list-unstyled mb-0 report-compliance-token-list" style="max-height:min(14rem,38vh);overflow-y:auto;border:1px solid rgba(15,23,42,.12);border-radius:.375rem;padding:.5rem .75rem;background:#fff;">';
        body += tokenIssues.map((issue) => (
          `<li class="mb-1"><code class="user-select-all">${escapeReportMessage(`{{${issue.token}}}`)}</code></li>`
        )).join('');
        body += '</ul>';
      }
      if (otherIssues.length) {
        body += `<ul class="mb-0 ps-3 small mt-2">${otherIssues.map((issue) => (
          `<li class="mb-1">${escapeReportMessage(issue.message || 'Issue found')}</li>`
        )).join('')}</ul>`;
      }
      if (extraCount) {
        body += `<p class="small text-muted mb-0 mt-2">…and ${extraCount} more issue(s) not shown.</p>`;
      }

      const allowed = Array.isArray(row.allowedSample) && row.allowedSample.length
        ? `<div class="small border-top pt-2 mt-2"><div class="text-muted mb-1">Allowed examples</div><div class="d-flex flex-wrap gap-1">${row.allowedSample.map((token) => (
          `<code class="user-select-all">${escapeReportMessage(`{{${token}}}`)}</code>`
        )).join('')}</div></div>`
        : '';

      const fixHint = tokenIssues.length
        ? `<p class="small text-muted mb-0 mt-2">${escapeReportMessage(tokenFixHint)}</p>`
        : '';

      return `<div class="border rounded p-3 mb-2 bg-light"><div class="fw-semibold mb-2">${escapeReportMessage(row.label || 'Template')}</div>${body}${allowed}${fixHint}</div>`;
    });

    return `<div class="text-start report-compliance-modal">${blocks.join('') || '<p class="mb-0">Check failed.</p>'}</div>`;
  }

  function buildPdfFieldsInspectModalHtml({ label = 'Default', fields = [] } = {}) {
    const list = (Array.isArray(fields) ? fields : [])
      .map((field) => ({
        name: String(field?.name || '').trim(),
        type: formatPdfAcroFieldType(field?.type)
      }))
      .filter((field) => field.name);
    if (!list.length) {
      return '<p class="mb-0 text-muted">No fillable PDF fields were found in the saved file.</p>';
    }
    const safeLabel = escapeReportMessage(label || 'Default');
    const rows = list.map((field, index) => (
      `<tr>`
      + `<td class="text-muted small text-end pe-2" style="width: 2.5rem;">${index + 1}</td>`
      + `<td><code class="small user-select-all">${escapeReportMessage(field.name)}</code></td>`
      + `<td class="small text-muted text-nowrap">${escapeReportMessage(field.type)}</td>`
      + `</tr>`
    )).join('');
    return (
      '<div class="report-pdf-fields-modal text-start">'
      + `<p class="small text-muted mb-2">Fillable AcroForm fields in the saved PDF template <strong>${safeLabel}</strong>.</p>`
      + `<div class="d-flex flex-wrap align-items-center gap-2 mb-2">`
      + `<span class="badge text-bg-secondary">${list.length} field${list.length === 1 ? '' : 's'}</span>`
      + `<span class="small text-muted">Use these exact names in <strong>PDF Field Map</strong>.</span>`
      + `</div>`
      + `<div class="table-responsive border rounded" style="max-height: min(22rem, 55vh); overflow: auto;">`
      + `<table class="table table-sm table-striped align-middle mb-0">`
      + `<thead class="table-light" style="position: sticky; top: 0; z-index: 1;">`
      + `<tr><th scope="col" class="text-end pe-2" style="width: 2.5rem;">#</th><th scope="col">Field name</th><th scope="col">Type</th></tr>`
      + `</thead><tbody>${rows}</tbody></table></div>`
      + `<p class="small text-muted mt-2 mb-0">Tip: select a field name in the table to copy it.</p>`
      + `</div>`
    );
  }

  function reportMessageModalAvailable() {
    return typeof window.showMessageModal === 'function' && document.getElementById('messageModal');
  }

  function buildAttendanceEligibilitySaveFailureModalHtml(message = '') {
    const raw = String(message || '').trim();
    if (!raw.startsWith('ATTENDANCE_ELIGIBILITY_ROW|')) return null;
    const parts = raw.split('|');
    if (parts.length < 5) return null;
    const rowId = parts[1] || '';
    const rowLabel = parts[2] || '';
    const periodHint = parts[3] || '';
    const names = parts.slice(4).join('|').split('\n').map((row) => row.trim()).filter(Boolean);
    if (!names.length) return null;
    const listItems = names.map((name) => (
      `<li class="mb-1 d-flex align-items-start gap-2">`
      + `<i class="bi bi-person-x text-danger mt-1" aria-hidden="true"></i>`
      + `<span>${escapeReportMessage(name)}</span>`
      + `</li>`
    )).join('');
    const rowLine = rowLabel
      ? `<div class="border rounded p-3 mb-3 bg-light-subtle"><div class="small text-muted text-uppercase fw-semibold mb-1">Target row</div><div class="fw-semibold">${escapeReportMessage(rowLabel)}</div>${periodHint ? `<div class="small text-muted mt-1">Attendance is required on at least one session between <strong>${escapeReportMessage(periodHint)}</strong>.</div>` : ''}</div>`
      : '';
    const rowIdAttr = rowId ? ` data-assignment-target-row-id="${escapeReportMessage(rowId)}"` : '';
    return (
      '<div class="text-start report-attendance-eligibility-error"'
      + rowIdAttr
      + '>'
      + '<p class="mb-2">These students are on the target row but have <strong>no attendance status</strong> (N/A) during that report period. They cannot stay selected for an Each Student report.</p>'
      + rowLine
      + `<ul class="list-unstyled mb-0 ps-0" style="max-height:min(14rem,38vh);overflow-y:auto;border:1px solid rgba(15,23,42,.12);border-radius:.375rem;padding:.5rem .75rem;background:#fff;">${listItems}</ul>`
      + '<p class="small text-muted mt-3 mb-0">Open <strong>Edit</strong> on this target row, uncheck the students listed above (or adjust the report period), then save the assignment again.</p>'
      + '</div>'
    );
  }

  function buildRemovedTargetStudentInstancesConfirmHtml(rows = []) {
    const items = Array.isArray(rows) ? rows : [];
    if (!items.length) return '';
    const grouped = new Map();
    items.forEach((row) => {
      const key = String(row?.assignmentRowId || row?.rowLabel || 'row');
      if (!grouped.has(key)) {
        grouped.set(key, {
          rowLabel: String(row?.rowLabel || 'Target row').trim(),
          templateTitle: String(row?.templateTitle || 'Report').trim(),
          students: []
        });
      }
      grouped.get(key).students.push({
        name: String(row?.studentName || row?.studentId || 'Student').trim(),
        status: String(row?.status || '').trim()
      });
    });
    const blocks = [...grouped.values()].map((group) => {
      const studentRows = group.students.map((student) => (
        `<li class="mb-1 d-flex align-items-start gap-2">`
        + `<i class="bi bi-person-x text-danger mt-1" aria-hidden="true"></i>`
        + `<span>${escapeReportMessage(student.name)}`
        + (student.status ? `<span class="text-muted small"> (${escapeReportMessage(student.status)})</span>` : '')
        + `</span></li>`
      )).join('');
      return `<div class="border rounded p-3 mb-2 bg-light-subtle">`
        + `<div class="small text-muted text-uppercase fw-semibold mb-1">Target row</div>`
        + `<div class="fw-semibold mb-1">${escapeReportMessage(group.rowLabel)}</div>`
        + `<div class="small text-muted mb-2">${escapeReportMessage(group.templateTitle)}</div>`
        + `<ul class="list-unstyled mb-0">${studentRows}</ul>`
        + `</div>`;
    }).join('');
    return (
      '<div class="text-start report-removed-student-instance-confirm">'
      + '<p class="mb-2">Saving will remove these students from the assignment target row(s). Matching report instances still exist and will be deleted if you continue.</p>'
      + blocks
      + '<p class="small text-muted mb-0 mt-2">Choose <strong>Delete instances</strong> to save the assignment and remove these report instances, or <strong>Cancel</strong> to keep editing.</p>'
      + '</div>'
    );
  }

  function buildVerifyAllRowsResultModalHtml(result = {}) {
    const payload = result && typeof result === 'object' ? result : {};
    const rowCount = Number(payload.validatedRowCount || 0);
    const stale = Array.isArray(payload.staleInstances) ? payload.staleInstances : [];
    const intro = payload.ok
      ? `<p class="mb-2">All <strong>${escapeReportMessage(String(rowCount || 'target'))}</strong> target row${rowCount === 1 ? '' : 's'} passed enrollment, attendance, schedule, and template checks.</p>`
      : `<p class="mb-2">${escapeReportMessage(String(payload.message || 'Some issues were found.'))}</p>`;
    if (!stale.length) {
      return (
        '<div class="text-start report-verify-all-rows-result">'
        + intro
        + '<p class="small text-muted mb-0">No stale or orphaned report instances were found for this assignment preview.</p>'
        + '</div>'
      );
    }
    const grouped = new Map();
    stale.forEach((row) => {
      const key = String(row?.assignmentRowId || row?.rowLabel || 'row');
      if (!grouped.has(key)) {
        grouped.set(key, {
          rowLabel: String(row?.rowLabel || 'Target row').trim(),
          templateTitle: String(row?.templateTitle || 'Report').trim(),
          students: []
        });
      }
      grouped.get(key).students.push({
        name: String(row?.studentName || row?.studentId || 'Student').trim(),
        status: String(row?.status || row?.reason || '').trim()
      });
    });
    const blocks = [...grouped.values()].map((group) => {
      const studentRows = group.students.map((student) => (
        `<li class="mb-1 d-flex align-items-start gap-2">`
        + `<i class="bi bi-exclamation-triangle text-warning mt-1" aria-hidden="true"></i>`
        + `<span>${escapeReportMessage(student.name)}`
        + (student.status ? `<span class="text-muted small"> (${escapeReportMessage(student.status)})</span>` : '')
        + `</span></li>`
      )).join('');
      return `<div class="border rounded p-3 mb-2 bg-light-subtle">`
        + `<div class="small text-muted text-uppercase fw-semibold mb-1">Target row</div>`
        + `<div class="fw-semibold mb-1">${escapeReportMessage(group.rowLabel)}</div>`
        + `<div class="small text-muted mb-2">${escapeReportMessage(group.templateTitle)}</div>`
        + `<ul class="list-unstyled mb-0">${studentRows}</ul>`
        + `</div>`;
    }).join('');
    return (
      '<div class="text-start report-verify-all-rows-result">'
      + intro
      + `<p class="small text-muted mb-2">These report instances do not match the current target rows on this form. You can delete them here without saving the assignment. Use <strong>Save Assignment</strong> afterward to persist target row changes.</p>`
      + blocks
      + '</div>'
    );
  }

  function buildVerifyAllRowsDeleteConfirmHtml(result = {}) {
    const payload = result && typeof result === 'object' ? result : {};
    const instanceRows = Array.isArray(payload.staleInstances) ? payload.staleInstances : [];
    const removedHtml = buildRemovedTargetStudentInstancesConfirmHtml(instanceRows);
    if (removedHtml) {
      return (
        '<div class="text-start report-verify-delete-confirm">'
        + '<p class="mb-2">Verification found report instances that should be removed for the current form state.</p>'
        + removedHtml.replace(
          'Choose <strong>Delete instances</strong> to save the assignment and remove these report instances, or <strong>Cancel</strong> to keep editing.',
          'Choose <strong>Delete instances</strong> to remove these report instances only (the assignment is not saved until you click Save Assignment), or <strong>Cancel</strong> to keep editing.'
        )
        + '</div>'
      );
    }
    return buildVerifyAllRowsResultModalHtml(payload);
  }

  function buildInactiveEnrollmentSaveFailureModalHtml(message = '') {
    const raw = String(message || '').trim();
    if (!raw.startsWith('INACTIVE_ENROLLMENT_ROW|')) return null;
    const parts = raw.split('|');
    if (parts.length < 4) return null;
    const rowLabel = parts[1] || '';
    const periodHint = parts[2] || '';
    const names = parts.slice(3).join('|').split('\n').map((row) => row.trim()).filter(Boolean);
    if (!names.length) return null;
    const listItems = names.map((name) => (
      `<li class="mb-1">${escapeReportMessage(name)}</li>`
    )).join('');
    const rowLine = rowLabel
      ? `<p class="mb-2">Target row: <strong>${escapeReportMessage(rowLabel)}</strong></p>`
      : '';
    const periodLine = periodHint
      ? `<p class="small text-muted mb-2">Enrollment must be active for the full report period (<strong>${escapeReportMessage(periodHint)}</strong>).</p>`
      : '';
    return (
      '<div class="text-start report-inactive-enrollment-error">'
      + '<p class="mb-2">The following students are not actively enrolled for this reporting period:</p>'
      + rowLine
      + periodLine
      + `<ul class="list-unstyled mb-0 ps-0" style="max-height:min(14rem,38vh);overflow-y:auto;border:1px solid rgba(15,23,42,.12);border-radius:.375rem;padding:.5rem .75rem;background:#fff;">${listItems}</ul>`
      + '<p class="small text-muted mt-3 mb-0">Remove them from the row, adjust the report dates, or update class enrollment so their enrollment covers the full period.</p>'
      + '</div>'
    );
  }

  function buildOverallExportPreviewFailureModalHtml(report = {}) {
    const payload = report && typeof report === 'object' ? report : {};
    const summary = escapeReportMessage(String(payload.summary || 'The overall report could not be exported.').trim());
    const format = escapeReportMessage(String(payload.format || 'DOCX').trim());
    const student = escapeReportMessage(String(payload.studentName || payload.studentId || '').trim());
    const sections = Array.isArray(payload.sections) ? payload.sections : [];
    const sectionBlocks = sections.map((section) => {
      const title = escapeReportMessage(String(section?.title || 'Issues').trim());
      const items = Array.isArray(section?.items) ? section.items : [];
      const rows = items.map((item) => {
        const label = escapeReportMessage(String(item?.fieldLabel || item?.fieldId || 'Field').trim() || 'Field');
        const fieldId = String(item?.fieldId || '').trim();
        const message = escapeReportMessage(String(item?.message || '').trim());
        const idLine = fieldId && fieldId !== String(item?.fieldLabel || '').trim()
          ? `<div class="small text-muted font-monospace">${escapeReportMessage(fieldId)}</div>`
          : '';
        return (
          `<li class="mb-2 pb-2 border-bottom border-light-subtle">`
          + `<div class="fw-semibold">${label}</div>`
          + idLine
          + (message ? `<div class="small mt-1">${message}</div>` : '')
          + `</li>`
        );
      }).join('');
      return (
        `<div class="border rounded p-3 mb-3 bg-light-subtle">`
        + `<div class="small text-uppercase fw-semibold text-muted mb-2">${title}</div>`
        + `<ul class="list-unstyled mb-0">${rows || '<li class="small text-muted">No details.</li>'}</ul>`
        + `</div>`
      );
    }).join('');
    const metaBadges = [
      format ? `<span class="badge text-bg-secondary">${format}</span>` : '',
      student ? `<span class="badge text-bg-light text-dark border">${student}</span>` : ''
    ].filter(Boolean).join('');
    return (
      '<div class="text-start report-overall-export-error">'
      + `<p class="mb-2">${summary}</p>`
      + (metaBadges ? `<div class="d-flex flex-wrap gap-2 mb-3">${metaBadges}</div>` : '')
      + sectionBlocks
      + '<p class="small text-muted mb-0 border-top pt-2">Open the <strong>overall report template</strong>, fix the fields above (validation rules, conversion expressions, or calculations), confirm source class reports cover the period, then export again.</p>'
      + '</div>'
    );
  }

  function buildDocxExportCancelledModalHtml(message = '') {
    const raw = String(message || '').trim();
    const prefix = 'DOCX export cancelled. Missing stored values for:';
    if (!raw.includes(prefix)) return null;
    const tailMatch = raw.match(/Missing stored values for:\s*([\s\S]+?)\.\s*Update the Word template/i);
    if (!tailMatch) return null;
    const hintBlock = tailMatch[1].trim();
    const hints = hintBlock.split(/,\s*(?=T\d+\.|O\.)/i).map((row) => row.trim()).filter(Boolean);
    const rows = hints.map((hint) => {
      const tokenMatch = hint.match(/^((?:T\d+|O)\.[A-Za-z0-9]+)/i);
      const token = tokenMatch ? tokenMatch[1] : hint.split('(')[0].trim();
      const detail = hint.includes('(') ? hint.slice(hint.indexOf('(')).trim() : '';
      return (
        `<li class="mb-2 pb-2 border-bottom border-light-subtle">`
        + `<code class="user-select-all">${escapeReportMessage(token)}</code>`
        + (detail ? `<div class="small text-muted mt-1">${escapeReportMessage(detail)}</div>` : '')
        + `</li>`
      );
    }).join('');
    const footer = raw.includes('Update the Word') ? raw.slice(raw.indexOf('Update the Word')).trim() : '';
    const count = hints.length;
    return (
      '<div class="text-start report-docx-export-error">'
      + '<p class="mb-2">The Word export was cancelled because placeholders in the overall template do not have stored values for this student and period.</p>'
      + `<div class="d-flex flex-wrap align-items-center gap-2 mb-2">`
      + `<span class="badge text-bg-warning">${count} missing placeholder${count === 1 ? '' : 's'}</span>`
      + `<span class="small text-muted">Keys use <code>T#.</code> (source template slot) or <code>O.</code> (overall field) prefixes.</span>`
      + `</div>`
      + `<p class="small text-muted mb-2">Missing tokens:</p>`
      + `<ul class="list-unstyled mb-0 report-compliance-token-list" style="max-height:min(14rem,38vh);overflow-y:auto;border:1px solid rgba(15,23,42,.12);border-radius:.375rem;padding:.5rem .75rem;background:#fff;">${rows}</ul>`
      + (footer ? `<div class="small border-top pt-2 mt-3 mb-0"><div class="fw-semibold mb-1">How to fix</div><p class="text-muted mb-0">${escapeReportMessage(footer)}</p></div>` : '')
      + '</div>'
    );
  }

  async function showReportMessage({
    title = 'Notice',
    message = '',
    icon = 'warning',
    buttonClass = 'btn-primary',
    buttons = null,
    html = false,
    size = 'md'
  } = {}) {
    if (!reportMessageModalAvailable()) {
      console.error('Report message modal is unavailable on this page.');
      return 'OK';
    }
    let resolvedHtml = html === true;
    let resolvedMessage = message;
    let resolvedSize = size;
    if (!resolvedHtml && icon === 'error') {
      const attendanceEligibilityHtml = buildAttendanceEligibilitySaveFailureModalHtml(message);
      if (attendanceEligibilityHtml) {
        resolvedMessage = attendanceEligibilityHtml;
        resolvedHtml = true;
        resolvedSize = 'lg';
      } else {
        const inactiveEnrollmentHtml = buildInactiveEnrollmentSaveFailureModalHtml(message);
        if (inactiveEnrollmentHtml) {
          resolvedMessage = inactiveEnrollmentHtml;
          resolvedHtml = true;
          resolvedSize = 'lg';
        } else {
          const docxHtml = buildDocxExportCancelledModalHtml(plainReportMessage(message));
          if (docxHtml) {
            resolvedMessage = docxHtml;
            resolvedHtml = true;
            resolvedSize = 'lg';
          }
        }
      }
    }
    const displayMessage = resolvedHtml ? String(resolvedMessage ?? '') : escapeReportMessage(plainReportMessage(resolvedMessage));
    return window.showMessageModal({
      title,
      icon,
      message: displayMessage,
      size: resolvedSize,
      buttons: buttons || [{ text: 'OK', class: buttonClass }]
    });
  }

  async function confirmReportAction({
    title = 'Confirm',
    message = '',
    confirmText = 'Confirm',
    cancelText = 'Cancel',
    confirmClass = 'btn-danger',
    icon = 'warning',
    html = false
  } = {}) {
    if (!reportMessageModalAvailable()) {
      console.error('Report message modal is unavailable on this page.');
      return false;
    }
    const displayMessage = html ? String(message ?? '') : escapeReportMessage(plainReportMessage(message));
    const result = await window.showMessageModal({
      title,
      icon,
      message: displayMessage,
      buttons: [
        { text: cancelText, class: 'btn-secondary' },
        { text: confirmText, class: confirmClass }
      ]
    });
    return result === confirmText;
  }

  window.ReportMessaging = {
    ready: true,
    escapeReportMessage,
    plainReportMessage,
    buildPdfFieldsInspectModalHtml,
    buildTemplateFileComplianceModalHtml,
    buildSnapshotComplianceSaveFailureModalHtml,
    buildDocxExportCancelledModalHtml,
    buildOverallExportPreviewFailureModalHtml,
    buildRemovedTargetStudentInstancesConfirmHtml,
    buildVerifyAllRowsResultModalHtml,
    buildVerifyAllRowsDeleteConfirmHtml,
    buildAttendanceEligibilitySaveFailureModalHtml,
    buildInactiveEnrollmentSaveFailureModalHtml,
    formatPdfAcroFieldType,
    showReportMessage,
    confirmReportAction
  };
})();
</script>
