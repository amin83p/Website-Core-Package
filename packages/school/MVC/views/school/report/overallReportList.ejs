<%- include('partials/tablePages-start', {
  title,
  newUrl,
  newLabel,
  user,
  tableName,
  btn_export: true,
  print,
  headerManageBtns: [
    `<a href="/school/reports" class="btn btn-outline-secondary btn-sm"><i class="bi bi-house me-1"></i>Report Home</a>`,
    `<a href="/school/reports/overall-templates" class="btn btn-primary btn-sm"><i class="bi bi-files me-1"></i>Choose Template</a>`
  ]
}) %>
<%- include('partials/tablePages-search', { placeholder: 'Search overall reports...', fields: [] }) %>
<div class="table-scroll-wrapper" data-floating-row-actions="true">
  <table class="table-responsive size-md" id="first-table">
    <thead><tr><th class="ps-4">Overall report</th><th>Template</th><th>Sources</th><th>Status</th><th>Revision</th><th>Exports</th><th class="text-end pe-4">Actions</th></tr></thead>
    <tbody>
      <% if (!data?.length) { %><tr><td colspan="7" class="text-center text-muted py-4">No overall reports have been created.</td></tr><% } %>
      <% (data || []).forEach((row) => { const status=String(row.status||'draft'); %>
        <tr>
          <td class="ps-4"><div class="fw-bold"><%= row.title || row.id %></div><div class="x-small text-muted font-monospace"><%= row.id %></div></td>
          <td><span class="font-monospace small"><%= row.overallTemplateId %></span><div class="small">v<%= Number(row.overallTemplateVersion || 1) %></div></td>
          <td><%= (row.sourceSelections || []).length %></td>
          <td><span class="badge <%= status === 'locked' ? 'bg-dark' : (status === 'submitted' ? 'bg-success' : (status === 'draft' ? 'bg-warning text-dark' : 'bg-secondary')) %>"><%= status %></span></td>
          <td><%= Number(row.revision || 1) %></td>
          <td><%= (row.generatedDocs || []).length %></td>
          <td class="text-end pe-4">
            <div class="d-flex justify-content-end gap-1">
              <a href="/school/reports/overall-reports/edit/<%= encodeURIComponent(row.id) %>" class="btn btn-outline-primary btn-sm">Open</a>
              <% if (status !== 'archived') { %>
                <% const removeAction = (row.generatedDocs || []).length ? 'Archive' : 'Delete'; %>
                <a
                  href="/school/reports/overall-reports/delete/<%= encodeURIComponent(row.id) %>"
                  class="btn btn-outline-danger btn-sm js-remove-overall-report"
                  data-action="<%= removeAction %>"
                  data-report-title="<%= row.title || row.id %>"
                ><%= removeAction %></a>
              <% } %>
            </div>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>
<%- include('partials/pagination', { pagination, filters, baseUrlPath: 'school/reports/overall-reports' }) %>
<%- include('partials/tablePages-end') %>

<script>
(() => {
  const escapeHtml = value => String(value ?? '').replace(/[&<>"']/g, character => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[character]));

  async function confirmReportRemoval(link) {
    const action = String(link.dataset.action || 'Delete');
    const reportTitle = String(link.dataset.reportTitle || 'this overall report');
    const isArchive = action === 'Archive';
    const message = isArchive
      ? `Archive <strong>${escapeHtml(reportTitle)}</strong>? The report and its generated documents will remain available as read-only records.`
      : `Delete <strong>${escapeHtml(reportTitle)}</strong>? This action cannot be undone.`;
    if (typeof window.showMessageModal === 'function' && document.getElementById('messageModal')) {
      const result = await window.showMessageModal({
        title: `${action} Overall Report?`,
        icon: 'warning',
        message,
        buttons: [
          { text: 'Cancel', class: 'btn-secondary' },
          { text: action, class: 'btn-danger' }
        ]
      });
      return result === action;
    }
    return window.confirm(`${action} ${reportTitle}?`);
  }

  document.querySelectorAll('.js-remove-overall-report').forEach(link => {
    link.addEventListener('click', async event => {
      event.preventDefault();
      if (await confirmReportRemoval(link)) window.location.assign(link.href);
    });
  });
})();
</script>
