<%
  const sharedFields = Array.isArray(matrix?.sharedFields) ? matrix.sharedFields : [];
  const commonFields = Array.isArray(matrix?.commonFields) ? matrix.commonFields : [];
  const tableFields = Array.isArray(matrix?.tableFields) ? matrix.tableFields : [];
  const rows = Array.isArray(matrix?.rows) ? matrix.rows : [];
  const progress = matrix?.progress || { total: rows.length, submitted: 0, drafts: 0, pending: rows.length };
  const fallbackSharedFields = sharedFields;
  const sharedGroups = Array.isArray(matrix?.sharedGroups) && matrix.sharedGroups.length
    ? matrix.sharedGroups
    : (fallbackSharedFields.length ? [{ id: 'shared-default', label: 'Shared fields', fields: fallbackSharedFields }] : []);
  const hasEditableRows = rows.some((row) => !row.locked);
  const canUnlockReportInstanceSafe = Boolean(typeof canUnlockReportInstance !== 'undefined' && canUnlockReportInstance);
  const canReopenReportInstanceSafe = Boolean(typeof canReopenReportInstanceToDraft !== 'undefined' && canReopenReportInstanceToDraft);
  const startedRows = rows.filter((row) => row.instanceId && !row.isPending);
  const uniformStatus = (() => {
    if (!startedRows.length) return '';
    const first = String(startedRows[0].status || '').toLowerCase();
    if (!first) return '';
    return startedRows.every((row) => String(row.status || '').toLowerCase() === first) ? first : '';
  })();
  const showBulkReopen = canReopenReportInstanceSafe && uniformStatus === 'submitted' && startedRows.length > 0;
  const showBulkUnlock = canUnlockReportInstanceSafe && uniformStatus === 'locked' && startedRows.length > 0;
  const sharedFieldsEditableSafe = matrix?.sharedFieldsEditable !== false;
  const sharedFieldsLockReasonSafe = String(matrix?.sharedFieldsLockReason || '').trim();
  const hasSharedFieldsBlock = sharedFields.length > 0;
  const isMatrixAdminViewerSafe = Boolean(typeof isMatrixAdminViewer !== 'undefined' && isMatrixAdminViewer);
  const statusBadgeLabel = (status) => {
    const token = String(status || '').toLowerCase();
    if (token === 'submitted') return 'Submitted (awaiting review)';
    if (token === 'locked') return 'Locked';
    if (token === 'draft') return 'Draft';
    if (token === 'pending' || !token) return 'Not started';
    return status || '-';
  };
  const statusIconMeta = (status) => {
    const token = String(status || '').toLowerCase();
    if (token === 'submitted') {
      return { icon: 'bi-check-circle-fill', className: 'matrix-status-icon--submitted', label: statusBadgeLabel(status) };
    }
    if (token === 'locked') {
      return { icon: 'bi-lock-fill', className: 'matrix-status-icon--locked', label: statusBadgeLabel(status) };
    }
    if (token === 'draft') {
      return { icon: 'bi-pencil-square', className: 'matrix-status-icon--draft', label: statusBadgeLabel(status) };
    }
    return { icon: 'bi-circle', className: 'matrix-status-icon--pending', label: statusBadgeLabel(status) };
  };
%>
