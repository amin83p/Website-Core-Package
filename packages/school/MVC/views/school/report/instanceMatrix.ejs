<div class="sections-page report-matrix-page">
  <input type="hidden" name="actionStateId" id="reportMatrixActionStateId" value="<%= actionStateId || '' %>">
  <script type="application/json" id="reportMatrixData"><%- JSON.stringify(matrix || {}).replace(/</g, '\\u003c') %></script>

  <div class="mb-4">
    <h1 class="page-heading size-md m-0 text-start" style="padding-left:0;">Fill Reports</h1>
    <div class="card matrix-context-card shadow-sm mt-3">
      <div class="card-body py-3 px-3 px-md-4">
        <div class="matrix-context-title"><%= matrix.templateTitle %></div>
        <div class="row matrix-context-meta">
          <div class="col-12 col-md-6 col-xl-4 matrix-context-item">
            <div class="matrix-context-label"><i class="bi bi-mortarboard" aria-hidden="true"></i>Class</div>
            <div class="matrix-context-value"><%= matrix.className || matrix.classId || '-' %></div>
          </div>
          <div class="col-6 col-md-3 col-xl-2 matrix-context-item">
            <div class="matrix-context-label"><i class="bi bi-calendar-event" aria-hidden="true"></i>Session</div>
            <div class="matrix-context-value"><%= matrix.sessionDate || '-' %></div>
          </div>
          <div class="col-6 col-md-3 col-xl-3 matrix-context-item">
            <div class="matrix-context-label"><i class="bi bi-person-badge" aria-hidden="true"></i>Teacher</div>
            <div class="matrix-context-value"><%= matrix.teacherName || matrix.teacherId || '-' %></div>
          </div>
          <div class="col-12 col-xl-3 matrix-context-item">
            <div class="matrix-context-label"><i class="bi bi-calendar-range" aria-hidden="true"></i>Report period</div>
            <div class="matrix-context-value matrix-context-period">
              <span><%= matrix.reportStartDate || '-' %></span>
              <span class="matrix-context-period-sep">to</span>
              <span><%= matrix.reportDueDate || '-' %></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <% if (isMatrixAdminViewerSafe) { %>
  <div class="card border-0 shadow-sm mb-4" id="reportMatrixNavigation">
    <div class="card-body py-2">
      <div class="d-flex flex-wrap align-items-center gap-2">
        <% if (matrix.classId && matrix.sessionId) { %>
          <a href="/school/classes/<%= encodeURIComponent(matrix.classId) %>/sessions/<%= encodeURIComponent(matrix.sessionId) %>" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Session</a>
        <% } %>
        <a href="/school/reports/instances" class="btn btn-outline-primary btn-sm"><i class="bi bi-list-check me-1"></i>Instances</a>
        <button type="button" class="btn btn-outline-warning btn-sm" id="btnMatrixPrefillPreview"><i class="bi bi-arrow-repeat me-1"></i>Preview Prefill Updates</button>
        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnMatrixExportDocx"><i class="bi bi-file-earmark-word me-1"></i>Export DOCX</button>
        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnMatrixExportPdf"><i class="bi bi-file-earmark-pdf me-1"></i>Export PDF</button>
        <a href="/school/reports/instances/matrix/<%= encodeURIComponent(matrix.assignmentId) %>/export?format=json&download=1" class="btn btn-outline-secondary btn-sm js-export-report-instance"><i class="bi bi-download me-1"></i>Export Payload</a>
      </div>
    </div>
  </div>
  <% } %>

  <div class="d-flex flex-wrap gap-2 mb-4">
    <div class="card border-0 shadow-sm matrix-summary-card"><div class="card-body py-2"><div class="small text-muted">Students</div><div class="fs-5 fw-bold" data-progress-key="total"><%= progress.total %></div></div></div>
    <div class="card border-0 shadow-sm matrix-summary-card"><div class="card-body py-2"><div class="small text-muted">Submitted</div><div class="fs-5 fw-bold text-success" data-progress-key="submitted"><%= progress.submitted %></div></div></div>
    <div class="card border-0 shadow-sm matrix-summary-card"><div class="card-body py-2"><div class="small text-muted">Drafts</div><div class="fs-5 fw-bold text-warning" data-progress-key="drafts"><%= progress.drafts %></div></div></div>
    <div class="card border-0 shadow-sm matrix-summary-card"><div class="card-body py-2"><div class="small text-muted">Not started</div><div class="fs-5 fw-bold text-info" data-progress-key="pending"><%= progress.pending %></div></div></div>
  </div>

  <% if (commonFields.length) { %>
    <div class="card border-0 shadow-sm mb-4" id="reportMatrixCommonFields">
      <div class="card-header bg-white py-3"><h5 class="m-0 fw-bold"><i class="bi bi-info-circle me-2 text-primary"></i>Common report values</h5></div>
      <div class="card-body"><div class="row g-3">
        <% commonFields.forEach((field) => { const value = field.value === undefined || field.value === null ? '' : field.value; const col = field.fullPageWidth ? 'col-12' : 'col-12 col-md-6 col-xl-4'; %>
          <div class="<%= col %>"><label class="form-label fw-bold"><%= field.label %> <span class="badge bg-light text-secondary border ms-1">View only</span></label>
            <% if (field.type === 'textarea') { %><textarea class="form-control" rows="3" data-field-id="<%= field.id %>" readonly><%= value %></textarea>
            <% } else { %><input type="<%= field.type === 'date' ? 'date' : 'text' %>" class="form-control" data-field-id="<%= field.id %>" value="<%= value %>" readonly><% } %>
          </div>
        <% }); %>
      </div></div>
    </div>
  <% } %>
  <% if (sharedGroups.length) { %>
    <div class="card border-0 shadow-sm mb-4" id="reportMatrixSharedFields">
      <div class="card-header bg-white py-3"><h5 class="m-0 fw-bold"><i class="bi bi-people me-2 text-primary"></i>Shared report fields</h5></div>
      <div class="card-body">
        <% if (hasSharedFieldsBlock && !sharedFieldsEditableSafe && sharedFieldsLockReasonSafe) { %>
          <div class="alert alert-warning small mb-3" role="alert">
            <div class="fw-semibold"><i class="bi bi-lock-fill me-1"></i>Shared fields are read-only</div>
            <div class="mb-0"><%= sharedFieldsLockReasonSafe %></div>
          </div>
        <% } %>
        <% if (sharedFields.some((field) => field.hasConflictingInitialValues)) { %><div class="alert alert-warning small">One or more shared fields have different initial values. Choose the common value explicitly.</div><% } %>
        <div class="accordion" id="reportMatrixSharedSections">
          <% sharedGroups.forEach((group, groupIndex) => { const collapseId = 'reportMatrixSharedGroup' + groupIndex; %>
            <div class="accordion-item"><h2 class="accordion-header" id="<%= collapseId %>Heading"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#<%= collapseId %>" aria-expanded="true"><%= group.label %> <span class="badge bg-info-subtle text-info-emphasis border ms-2"><%= group.fields.length %> field(s)</span></button></h2>
              <div id="<%= collapseId %>" class="accordion-collapse collapse show"><div class="accordion-body"><div class="row g-3">
                <% (group.fields || []).forEach((field) => { const value = field.value === undefined || field.value === null ? '' : field.value; const col = field.fullPageWidth ? 'col-12' : 'col-12 col-md-6 col-xl-4'; const sharedDisabled = !sharedFieldsEditableSafe; %>
                  <div class="<%= col %>"><label class="form-label fw-bold"><%= field.label %> <span class="badge bg-info-subtle text-info-emphasis border ms-1">Shared</span></label>
                    <% if (field.type === 'textarea') { %><textarea class="form-control js-matrix-shared-field" rows="3" data-field-id="<%= field.id %>" <%= sharedDisabled ? 'readonly' : '' %>><%= value %></textarea>
                    <% } else if (field.type === 'select') { %>
                      <%- include('partials/reportSelectField', {
                        field,
                        value,
                        name: `matrix_shared_${field.id}`,
                        idPrefix: `matrix_shared_${field.id}`,
                        disabled: sharedDisabled,
                        readOnly: sharedDisabled,
                        inputClass: 'js-matrix-shared-field',
                        size: ''
                      }) %>
                    <% } else { %><input type="<%= (!sharedDisabled && field.type === 'number') ? 'number' : (field.type === 'date' ? 'date' : 'text') %>" class="form-control js-matrix-shared-field" data-field-id="<%= field.id %>" value="<%= value %>" <%= sharedDisabled ? 'readonly' : '' %>><% } %>
                  </div>
                <% }); %>
              </div></div></div>
            </div>
          <% }); %>
        </div>
      </div>
    </div>
  <% } %>

  <div class="card border-0 shadow-sm" id="reportMatrixStudentReports">
    <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
      <h5 class="m-0 fw-bold"><i class="bi bi-table me-2 text-primary"></i>Student reports</h5>
      <button type="button" class="btn btn-outline-primary btn-sm" id="btnReportMatrixExpandTable" data-bs-toggle="modal" data-bs-target="#reportMatrixTableModal" title="Open student reports in a larger view">
        <i class="bi bi-arrows-fullscreen me-1"></i>Open expanded view
      </button>
    </div>
    <div id="reportMatrixTableInlineHost">
    <div class="matrix-table-wrap matrix-table-wrap--inline">
      <table class="table table-bordered table-hover align-middle mb-0 matrix-table" id="reportMatrixTable">
        <thead class="table-light">
          <tr>
            <th class="matrix-student-col ps-3">Student</th>
            <% tableFields.forEach((field) => { %>
              <% const headerTipParts = [];
                 if (field.helpText) headerTipParts.push(String(field.helpText));
                 if (field.placeholder) headerTipParts.push('Expected: ' + String(field.placeholder));
                 const headerTip = headerTipParts.join('\n'); %>
              <th data-matrix-field-id="<%= field.id %>">
                <div class="matrix-field-header">
                  <div class="matrix-field-header-main">
                    <div class="matrix-field-header-top">
                      <span class="matrix-header-label<%= headerTip ? ' matrix-header-tip-trigger' : '' %>"<% if (headerTip) { %> tabindex="0" data-tip="<%= headerTip %>"<% } %>><%= field.label %></span>
                      <% if (field.required) { %><span class="text-danger" title="Required" aria-label="Required">*</span><% } %>
                    </div>
                    <% if (field.readOnly) { %>
                      <div class="matrix-field-header-badges">
                        <span class="badge bg-light text-secondary border" style="font-size:0.65rem;">View only<%= field.calculated ? ' / calculated' : '' %></span>
                      </div>
                    <% } %>
                  </div>
                  <div class="matrix-field-header-footer">
                    <%- include('partials/matrixColumnBulkHeader', { field }) %>
                  </div>
                </div>
              </th>
            <% }); %>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach((row) => { %>
            <tr data-student-id="<%= row.studentId %>" data-instance-id="<%= row.instanceId || '' %>" data-report-status="<%= row.status || '' %>" class="<%= row.locked ? 'table-secondary' : '' %>">
              <td class="matrix-student-col ps-3">
                <% const rowStatusMeta = statusIconMeta(row.status); %>
                <div class="matrix-student-head">
                  <div class="fw-bold matrix-student-name"><%= row.studentName %></div>
                  <div class="matrix-student-tools">
                    <span class="matrix-status-icon js-matrix-status <%= rowStatusMeta.className %>" data-bs-toggle="tooltip" title="<%= rowStatusMeta.label %>" aria-label="<%= rowStatusMeta.label %>"><i class="bi <%= rowStatusMeta.icon %>" aria-hidden="true"></i></span>
                    <a href="<%= row.editHref || '#' %>" class="matrix-row-icon-btn js-matrix-open <%= row.editHref ? '' : 'd-none' %>" target="_blank" rel="noopener noreferrer" title="Open individual report" aria-label="Open individual report"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a>
                    <% if (row.instanceId && String(row.status || '').toLowerCase() === 'submitted' && canReopenReportInstanceSafe) { %>
                      <button type="button" class="matrix-row-icon-btn matrix-row-icon-btn--warning js-matrix-reopen-instance" data-instance-id="<%= row.instanceId %>" data-student-name="<%= row.studentName %>" title="Reopen as draft for the teacher" aria-label="Reopen as draft for the teacher"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i></button>
                    <% } %>
                    <% if (row.instanceId && String(row.status || '').toLowerCase() === 'locked' && canUnlockReportInstanceSafe) { %>
                      <button type="button" class="matrix-row-icon-btn matrix-row-icon-btn--warning js-matrix-unlock-instance" data-instance-id="<%= row.instanceId %>" data-student-name="<%= row.studentName %>" title="Unlock returns the report to submitted" aria-label="Unlock returns the report to submitted"><i class="bi bi-unlock" aria-hidden="true"></i></button>
                    <% } %>
                  </div>
                </div>
              </td>
              <% tableFields.forEach((field) => { %>
                <% const value = row.answers?.[field.id] === undefined || row.answers?.[field.id] === null ? '' : row.answers[field.id]; %>
                <% const disabled = row.locked || field.readOnly; %>
                <td data-matrix-cell="<%= field.id %>">
                  <% if (field.type === 'textarea') { %>
                    <textarea class="form-control form-control-sm js-matrix-row-field" rows="3" data-field-id="<%= field.id %>" placeholder="<%= field.placeholder || '' %>" <%= disabled ? 'readonly' : '' %>><%= value %></textarea>
                  <% } else if (field.type === 'select') { %>
                    <%- include('partials/reportSelectField', {
                      field,
                      value,
                      name: `matrix_row_${row.studentId}_${field.id}`,
                      idPrefix: `${row.studentId}_${field.id}`,
                      disabled,
                      readOnly: disabled,
                      inputClass: 'js-matrix-row-field',
                      size: 'sm'
                    }) %>
                  <% } else if (field.type === 'checkbox') { %>
                    <div class="form-check d-flex justify-content-center">
                      <input type="checkbox" class="form-check-input js-matrix-row-field" data-field-id="<%= field.id %>" <%= value === true || String(value).toLowerCase() === 'true' ? 'checked' : '' %> <%= disabled ? 'disabled' : '' %>>
                    </div>
                  <% } else { %>
                    <input type="<%= (!disabled && field.type === 'number') ? 'number' : (field.type === 'date' ? 'date' : 'text') %>" class="form-control form-control-sm js-matrix-row-field" data-field-id="<%= field.id %>" value="<%= value %>" placeholder="<%= field.placeholder || '' %>" <%= disabled ? 'readonly' : '' %>>
                  <% } %>
                </td>
              <% }); %>

            </tr>
          <% }); %>
          <% if (!rows.length) { %><tr><td colspan="<%= tableFields.length + 1 %>" class="text-center text-muted py-5">No students are targeted by this assignment.</td></tr><% } %>
        </tbody>
      </table>
    </div>
    </div>
  </div>

  <div class="card border-0 shadow-sm mt-4" id="reportMatrixActions">
    <div class="card-body py-2">
      <div class="d-flex flex-wrap align-items-center gap-2">
        <button type="button" class="btn btn-primary btn-sm js-matrix-bulk-action" data-action="save" <%= hasEditableRows ? '' : 'disabled' %>><i class="bi bi-save me-1"></i>Save All Drafts</button>
        <button type="button" class="btn btn-success btn-sm js-matrix-bulk-action" data-action="submit" <%= hasEditableRows ? '' : 'disabled' %>><i class="bi bi-send-check me-1"></i>Submit All Reports</button>
        <button type="button" class="btn btn-outline-dark btn-sm js-matrix-bulk-action" data-action="lock" <%= hasEditableRows ? '' : 'disabled' %>><i class="bi bi-lock me-1"></i>Lock All Reports</button>
        <% if (showBulkReopen || showBulkUnlock) { %>
          <span id="matrixLifecycleDivider" class="mx-1 text-muted d-none d-md-inline">|</span>
        <% } %>
        <% if (showBulkReopen) { %>
          <button type="button" class="btn btn-outline-warning btn-sm" id="btnMatrixReopenAll" title="Reopen every submitted report in this matrix to draft"><i class="bi bi-arrow-counterclockwise me-1"></i>Reopen All for Teachers</button>
        <% } %>
        <% if (showBulkUnlock) { %>
          <button type="button" class="btn btn-warning btn-sm" id="btnMatrixUnlockAll" title="Unlock every locked report in this matrix back to submitted"><i class="bi bi-unlock me-1"></i>Unlock All Reports</button>
        <% } %>
      </div>
    </div>
  </div>
</div>

