<%- include('partials/calculatedFieldsRuntime') %>
<%- include('partials/reportMessageHelpers') %>
<script src="/scripts/reportAssignmentDelete.js"></script>
<script src="/scripts/reportSelectField.js"></script>
<script>
  (function () {
    const dataEl = document.getElementById('reportMatrixData');
    let matrixState = JSON.parse(dataEl?.textContent || '{}');
    const dirtyStudents = new Set();
    let sharedDirty = false;
    const REPORT_MATRIX_STUDENT_WINDOW = 50;
    const reportMatrixWindowState = {
      loadedStudents: Array.isArray(matrixState.rows) ? matrixState.rows.length : 0,
      hasMoreStudents: Boolean(matrixState.window?.hasMoreStudents),
      loading: false
    };
    window.CAN_EXPORT_REPORT_INSTANCE = <%- JSON.stringify(typeof canExportReportInstance !== 'undefined' && !!canExportReportInstance) %>;
    window.CAN_REOPEN_REPORT_INSTANCE = <%- JSON.stringify(typeof canReopenReportInstanceToDraft !== 'undefined' && !!canReopenReportInstanceToDraft) %>;
    window.MATRIX_HAS_SHARED_FIELDS = <%- JSON.stringify(hasSharedFieldsBlock) %>;
    window.CAN_UNLOCK_REPORT_INSTANCE = <%- JSON.stringify(typeof canUnlockReportInstance !== 'undefined' && !!canUnlockReportInstance) %>;

    function initializeTooltips() {
      if (typeof bootstrap === 'undefined' || !bootstrap?.Tooltip) return;
      document.querySelectorAll('.report-matrix-page [data-bs-toggle="tooltip"]').forEach((el) => {
        if (!bootstrap.Tooltip.getInstance(el)) new bootstrap.Tooltip(el);
      });
    }

    let matrixColumnHeaderTipEl = null;
    let activeMatrixHeaderTipTrigger = null;
    let matrixHeaderTipWindowBound = false;

    function ensureMatrixColumnHeaderTipElement() {
      if (matrixColumnHeaderTipEl && document.body.contains(matrixColumnHeaderTipEl)) return matrixColumnHeaderTipEl;
      matrixColumnHeaderTipEl = document.getElementById('matrixColumnHeaderTip');
      if (!matrixColumnHeaderTipEl) {
        matrixColumnHeaderTipEl = document.createElement('div');
        matrixColumnHeaderTipEl.id = 'matrixColumnHeaderTip';
        matrixColumnHeaderTipEl.className = 'matrix-column-header-tip';
        matrixColumnHeaderTipEl.setAttribute('role', 'tooltip');
        matrixColumnHeaderTipEl.hidden = true;
        document.body.appendChild(matrixColumnHeaderTipEl);
      } else if (matrixColumnHeaderTipEl.parentElement !== document.body) {
        document.body.appendChild(matrixColumnHeaderTipEl);
      }
      return matrixColumnHeaderTipEl;
    }

    function hideMatrixColumnHeaderTip() {
      if (activeMatrixHeaderTipTrigger) activeMatrixHeaderTipTrigger.removeAttribute('aria-describedby');
      activeMatrixHeaderTipTrigger = null;
      if (!matrixColumnHeaderTipEl) return;
      matrixColumnHeaderTipEl.classList.remove('is-visible', 'is-below');
      matrixColumnHeaderTipEl.hidden = true;
    }

    function showMatrixColumnHeaderTip(trigger) {
      const label = String(trigger?.getAttribute('data-tip') || '').trim();
      if (!label) {
        hideMatrixColumnHeaderTip();
        return;
      }
      const tip = ensureMatrixColumnHeaderTipElement();
      if (activeMatrixHeaderTipTrigger && activeMatrixHeaderTipTrigger !== trigger) {
        activeMatrixHeaderTipTrigger.removeAttribute('aria-describedby');
      }
      activeMatrixHeaderTipTrigger = trigger;
      trigger.setAttribute('aria-describedby', tip.id);
      const tipBg = '#0f172a';
      const parts = (label.includes('\n') ? label.split('\n') : label.split(' | '))
        .map((part) => String(part || '').trim())
        .filter(Boolean);
      tip.innerHTML = parts.map((part, index) => (
        `<span class="sch-tip-line${index > 0 ? ' sch-tip-sub' : ''}">${reportMatrixEscapeHtml(part)}</span>`
      )).join('');
      tip.style.background = tipBg;
      tip.style.color = '#ffffff';
      tip.style.borderColor = tipBg;
      tip.style.setProperty('--sch-tip-arrow', tipBg);
      tip.hidden = false;
      tip.removeAttribute('hidden');
      tip.classList.remove('is-below');
      const rect = trigger.getBoundingClientRect();
      let left = rect.left + (rect.width / 2);
      const tipWidth = tip.offsetWidth || 160;
      const tipHeight = tip.offsetHeight || 80;
      const pad = 10;
      left = Math.max(pad + tipWidth / 2, Math.min(left, window.innerWidth - pad - tipWidth / 2));
      tip.style.left = `${left}px`;
      if ((rect.top - tipHeight - 14) < pad) {
        tip.classList.add('is-below');
        tip.style.top = `${Math.min(window.innerHeight - pad - tipHeight, rect.bottom)}px`;
      } else {
        tip.style.top = `${rect.top}px`;
      }
      tip.classList.add('is-visible');
    }

    function bindMatrixColumnHeaderTips() {
      const table = document.getElementById('reportMatrixTable');
      if (!table || table.dataset.matrixHeaderTipsBound === '1') return;
      table.dataset.matrixHeaderTipsBound = '1';
      ensureMatrixColumnHeaderTipElement();
      table.addEventListener('pointerover', (event) => {
        const trigger = event.target.closest('.matrix-header-tip-trigger');
        if (!trigger || !table.contains(trigger)) return;
        showMatrixColumnHeaderTip(trigger);
      });
      table.addEventListener('pointerout', (event) => {
        const trigger = event.target.closest('.matrix-header-tip-trigger');
        if (!trigger) return;
        const next = event.relatedTarget;
        if (next && trigger.contains(next)) return;
        hideMatrixColumnHeaderTip();
      });
      table.addEventListener('focusin', (event) => {
        const trigger = event.target.closest('.matrix-header-tip-trigger');
        if (trigger) showMatrixColumnHeaderTip(trigger);
      });
      table.addEventListener('focusout', (event) => {
        const trigger = event.target.closest('.matrix-header-tip-trigger');
        if (!trigger) return;
        const next = event.relatedTarget;
        if (next && trigger.contains(next)) return;
        hideMatrixColumnHeaderTip();
      });
      if (!matrixHeaderTipWindowBound) {
        matrixHeaderTipWindowBound = true;
        window.addEventListener('scroll', hideMatrixColumnHeaderTip, true);
        window.addEventListener('resize', hideMatrixColumnHeaderTip);
      }
    }

    function showReportMatrixMessage({ title = 'Fill Reports', icon = 'info', message = '' } = {}) {
      return window.ReportMessaging.showReportMessage({
        title,
        icon,
        message,
        buttonClass: icon === 'error' ? 'btn-danger' : 'btn-primary'
      });
    }

    function reportMatrixEscapeHtml(value) {
      return String(value == null ? '' : value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function reportMatrixStatusIconMeta(status) {
      const token = String(status || '').toLowerCase();
      if (token === 'submitted') {
        return { icon: 'bi-check-circle-fill', className: 'matrix-status-icon--submitted', label: 'Submitted (awaiting review)' };
      }
      if (token === 'locked') {
        return { icon: 'bi-lock-fill', className: 'matrix-status-icon--locked', label: 'Locked' };
      }
      if (token === 'draft') {
        return { icon: 'bi-pencil-square', className: 'matrix-status-icon--draft', label: 'Draft' };
      }
      if (token === 'pending' || !token) {
        return { icon: 'bi-circle', className: 'matrix-status-icon--pending', label: 'Not started' };
      }
      return { icon: 'bi-circle', className: 'matrix-status-icon--pending', label: status || 'Not started' };
    }

    function applyReportMatrixStatusIcon(statusEl, status) {
      if (!statusEl) return;
      const meta = reportMatrixStatusIconMeta(status);
      statusEl.className = `matrix-status-icon js-matrix-status ${meta.className}`;
      statusEl.title = meta.label;
      statusEl.setAttribute('aria-label', meta.label);
      statusEl.setAttribute('data-bs-original-title', meta.label);
      const icon = statusEl.querySelector('i');
      if (icon) icon.className = `bi ${meta.icon}`;
    }

    function readReportMatrixQueryParams() {
      const params = new URLSearchParams(window.location.search);
      return {
        assignmentRowId: params.get('assignmentRowId') || params.get('rowId') || '',
        teacherId: params.get('teacherId') || ''
      };
    }

    function buildReportMatrixFieldHtml(field, row) {
      const value = row.answers?.[field.id];
      const disabled = row.locked || field.readOnly;
      const valueStr = value === undefined || value === null ? '' : String(value);
      const readonlyAttr = disabled ? 'readonly' : '';
      const disabledAttr = disabled ? 'disabled' : '';
      if (field.type === 'textarea') {
        return `<textarea class="form-control form-control-sm js-matrix-row-field" rows="3" data-field-id="${reportMatrixEscapeHtml(field.id)}" placeholder="${reportMatrixEscapeHtml(field.placeholder || '')}" ${readonlyAttr}>${reportMatrixEscapeHtml(valueStr)}</textarea>`;
      }
      if (field.type === 'select') {
        const binaryHtml = window.ReportSelectField?.buildReportSelectFieldHtml?.({
          field,
          value,
          name: `matrix_row_${reportMatrixEscapeHtml(row.studentId)}_${reportMatrixEscapeHtml(field.id)}`,
          idPrefix: `${reportMatrixEscapeHtml(row.studentId)}_${reportMatrixEscapeHtml(field.id)}`,
          disabled,
          readOnly: disabled,
          inputClass: 'js-matrix-row-field',
          size: 'sm'
        });
        if (binaryHtml) return binaryHtml;
        const options = Array.isArray(field.options) ? field.options : [];
        const opts = options.map((opt) => {
          const selected = String(opt.value) === valueStr ? ' selected' : '';
          return `<option value="${reportMatrixEscapeHtml(opt.value)}"${selected}>${reportMatrixEscapeHtml(opt.label || opt.value)}</option>`;
        }).join('');
        return `<select class="form-select form-select-sm js-matrix-row-field" data-field-id="${reportMatrixEscapeHtml(field.id)}" ${disabledAttr}>${opts}</select>`;
      }
      if (field.type === 'checkbox') {
        const checked = value === true || String(value).toLowerCase() === 'true' ? ' checked' : '';
        return `<div class="form-check d-flex justify-content-center"><input type="checkbox" class="form-check-input js-matrix-row-field" data-field-id="${reportMatrixEscapeHtml(field.id)}"${checked}${disabled ? ' disabled' : ''}></div>`;
      }
      const inputType = (!disabled && field.type === 'number') ? 'number' : (field.type === 'date' ? 'date' : 'text');
      return `<input type="${inputType}" class="form-control form-control-sm js-matrix-row-field" data-field-id="${reportMatrixEscapeHtml(field.id)}" value="${reportMatrixEscapeHtml(valueStr)}" placeholder="${reportMatrixEscapeHtml(field.placeholder || '')}" ${readonlyAttr}>`;
    }

    function buildReportMatrixRowHtml(row) {
      const tableFields = Array.isArray(matrixState.tableFields) ? matrixState.tableFields : [];
      const statusMeta = reportMatrixStatusIconMeta(row.status);
      const reopenBtn = row.instanceId && String(row.status || '').toLowerCase() === 'submitted' && window.CAN_REOPEN_REPORT_INSTANCE
        ? `<button type="button" class="matrix-row-icon-btn matrix-row-icon-btn--warning js-matrix-reopen-instance" data-instance-id="${reportMatrixEscapeHtml(row.instanceId)}" data-student-name="${reportMatrixEscapeHtml(row.studentName)}" title="Reopen as draft for the teacher" aria-label="Reopen as draft for the teacher"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i></button>`
        : '';
      const unlockBtn = row.instanceId && String(row.status || '').toLowerCase() === 'locked' && window.CAN_UNLOCK_REPORT_INSTANCE
        ? `<button type="button" class="matrix-row-icon-btn matrix-row-icon-btn--warning js-matrix-unlock-instance" data-instance-id="${reportMatrixEscapeHtml(row.instanceId)}" data-student-name="${reportMatrixEscapeHtml(row.studentName)}" title="Unlock returns the report to submitted" aria-label="Unlock returns the report to submitted"><i class="bi bi-unlock" aria-hidden="true"></i></button>`
        : '';
      const openHref = row.editHref || '';
      const openBtn = openHref
        ? `<a href="${reportMatrixEscapeHtml(openHref)}" class="matrix-row-icon-btn js-matrix-open" target="_blank" rel="noopener noreferrer" title="Open individual report" aria-label="Open individual report"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a>`
        : '';
      const cells = tableFields.map((field) => (
        `<td data-matrix-cell="${reportMatrixEscapeHtml(field.id)}">${buildReportMatrixFieldHtml(field, row)}</td>`
      )).join('');
      return `<tr data-student-id="${reportMatrixEscapeHtml(row.studentId)}" data-instance-id="${reportMatrixEscapeHtml(row.instanceId || '')}" data-report-status="${reportMatrixEscapeHtml(row.status || '')}" class="${row.locked ? 'table-secondary' : ''}">
        <td class="matrix-student-col ps-3">
          <div class="matrix-student-head">
            <div class="fw-bold matrix-student-name">${reportMatrixEscapeHtml(row.studentName)}</div>
            <div class="matrix-student-tools">
              <span class="matrix-status-icon js-matrix-status ${statusMeta.className}" data-bs-toggle="tooltip" title="${reportMatrixEscapeHtml(statusMeta.label)}" aria-label="${reportMatrixEscapeHtml(statusMeta.label)}"><i class="bi ${statusMeta.icon}" aria-hidden="true"></i></span>
              ${openBtn}
              ${reopenBtn}
              ${unlockBtn}
            </div>
          </div>
        </td>
        ${cells}
      </tr>`;
    }

    async function loadMoreReportMatrixRows() {
      if (reportMatrixWindowState.loading || !reportMatrixWindowState.hasMoreStudents) return;
      const assignmentId = String(matrixState.assignmentId || '').trim();
      if (!assignmentId) return;
      reportMatrixWindowState.loading = true;
      try {
        const qs = new URLSearchParams(readReportMatrixQueryParams());
        qs.set('studentOffset', String(reportMatrixWindowState.loadedStudents));
        qs.set('studentLimit', String(REPORT_MATRIX_STUDENT_WINDOW));
        const url = `/school/reports/instances/matrix/${encodeURIComponent(assignmentId)}/api/data?${qs.toString()}`;
        const res = await fetch(url, { headers: { 'X-AJAX-Request': 'true' }, cache: 'no-store' });
        const payload = await res.json();
        if (payload.status !== 'success') throw new Error(payload.message || 'Load failed');
        const rows = Array.isArray(payload.rows) ? payload.rows : [];
        const mergedRows = rows.map((apiRow) => {
          const sid = String(apiRow.studentId || '');
          const local = (matrixState.rows || []).find((item) => String(item.studentId || '') === sid);
          if (!local || !dirtyStudents.has(sid)) return apiRow;
          return {
            ...apiRow,
            answers: { ...(apiRow.answers || {}), ...(local.answers || {}) }
          };
        });
        const tbody = document.querySelector('#reportMatrixTable tbody');
        if (tbody && mergedRows.length) {
          mergedRows.forEach((row) => tbody.insertAdjacentHTML('beforeend', buildReportMatrixRowHtml(row)));
        }
        matrixState.rows = [...(matrixState.rows || []), ...mergedRows];
        matrixState.window = payload.window || matrixState.window;
        persistMatrixStateJson();
        const windowMeta = payload.window || {};
        reportMatrixWindowState.hasMoreStudents = Boolean(windowMeta.hasMoreStudents);
        reportMatrixWindowState.loadedStudents += rows.length;
        initializeTooltips();
      } catch (error) {
        showReportMatrixMessage({
          title: 'Load Error',
          icon: 'error',
          message: error?.message || 'Unable to load more students.'
        });
      } finally {
        reportMatrixWindowState.loading = false;
      }
    }

    document.addEventListener('scroll', (event) => {
      const wrap = event.target;
      if (!wrap?.classList?.contains('matrix-table-wrap') || reportMatrixWindowState.loading) return;
      const nearBottom = wrap.scrollTop + wrap.clientHeight >= wrap.scrollHeight - 120;
      if (nearBottom && reportMatrixWindowState.hasMoreStudents) {
        loadMoreReportMatrixRows();
      }
    }, true);

    const MATRIX_MODAL_SIZE_CLASSES = ['modal-lg', 'modal-xl', 'modal-fullscreen', 'modal-dialog-centered'];
    const REPORT_MATRIX_MODAL_IDS = ['reportMatrixTableModal', 'matrixPdfExportModal', 'reportMatrixPrefillModal'];

    function portalReportMatrixModalsToBody() {
      REPORT_MATRIX_MODAL_IDS.forEach((id) => {
        const modalEl = document.getElementById(id);
        if (modalEl && modalEl.parentElement !== document.body) {
          document.body.appendChild(modalEl);
        }
      });
    }

    function updateReportMatrixTableModalSize() {
      const dialog = document.getElementById('reportMatrixTableModalDialog');
      if (!dialog) return;
      dialog.classList.remove(...MATRIX_MODAL_SIZE_CLASSES);
      dialog.classList.add('modal-fullscreen');
    }

    function moveReportMatrixTableToModal() {
      const wrap = document.querySelector('#reportMatrixTableInlineHost .matrix-table-wrap');
      const host = document.getElementById('reportMatrixTableModalHost');
      if (wrap && host) host.appendChild(wrap);
    }

    function restoreReportMatrixTableInline() {
      const wrap = document.querySelector('#reportMatrixTableModalHost .matrix-table-wrap')
        || document.querySelector('#reportMatrixTableInlineHost .matrix-table-wrap');
      const host = document.getElementById('reportMatrixTableInlineHost');
      if (wrap && host) host.appendChild(wrap);
    }

    portalReportMatrixModalsToBody();

    const reportMatrixTableModalEl = document.getElementById('reportMatrixTableModal');
    if (reportMatrixTableModalEl) {
      reportMatrixTableModalEl.addEventListener('show.bs.modal', () => {
        updateReportMatrixTableModalSize();
        moveReportMatrixTableToModal();
      });
      reportMatrixTableModalEl.addEventListener('hidden.bs.modal', () => {
        restoreReportMatrixTableInline();
      });
    }

    document.addEventListener('click', function (event) {
      const exportLink = event.target.closest('.js-export-report-instance');
      if (!exportLink) return;
      if (window.CAN_EXPORT_REPORT_INSTANCE) return;
      event.preventDefault();
      event.stopPropagation();
      showReportMatrixMessage({
        title: 'Access Denied',
        icon: 'error',
        message: 'You do not have permission to export report documents or payloads. Contact an administrator if you need Export access.'
      });
    });

    function persistMatrixStateJson() {
      if (dataEl) {
        dataEl.textContent = JSON.stringify(matrixState).replace(/</g, '\\u003c');
      }
    }

    function fieldBulkEligible(field) {
      if (!field || field.readOnly === true || field.calculated === true) return false;
      const type = String(field.type || 'text').trim().toLowerCase();
      return type !== 'textarea';
    }

    function coerceBulkValue(field, raw) {
      const type = String(field?.type || 'text').trim().toLowerCase();
      if (type === 'number') {
        if (raw === '' || raw === undefined || raw === null) return '';
        const value = Number(raw);
        return Number.isFinite(value) ? value : '';
      }
      if (type === 'checkbox') {
        const token = String(raw ?? '').trim().toLowerCase();
        if (token === 'true' || token === '1' || token === 'yes' || token === 'on') return true;
        if (token === 'false' || token === '0' || token === 'no' || token === 'off') return false;
        return null;
      }
      return raw === undefined || raw === null ? '' : String(raw);
    }

    let activeColumnBulkFieldId = '';

    function closeMatrixColumnBulkPopover() {
      const pop = document.getElementById('matrixColumnBulkPopover');
      if (!pop) return;
      pop.classList.add('d-none');
      pop.setAttribute('hidden', '');
      activeColumnBulkFieldId = '';
    }

    function positionMatrixColumnBulkPopover(anchorEl) {
      const pop = document.getElementById('matrixColumnBulkPopover');
      if (!pop || !anchorEl) return;
      const rect = anchorEl.getBoundingClientRect();
      const width = Math.min(320, Math.max(240, rect.width + 40));
      let left = rect.left + (rect.width / 2) - (width / 2);
      left = Math.max(8, Math.min(left, window.innerWidth - width - 8));
      const top = Math.min(rect.bottom + 6, window.innerHeight - 16);
      pop.style.width = `${width}px`;
      pop.style.left = `${left}px`;
      pop.style.top = `${top}px`;
    }

    function buildColumnBulkPopoverBodyHtml(field) {
      const fieldId = String(field?.id || '').trim();
      const type = String(field?.type || 'text').trim().toLowerCase();
      const esc = reportMatrixEscapeHtml;
      if (type === 'select') {
        const binaryHtml = window.ReportSelectField?.buildReportSelectFieldHtml?.({
          field,
          value: '',
          name: `matrix_bulk_${fieldId}`,
          idPrefix: `matrix_bulk_${fieldId}`,
          inputClass: 'js-matrix-column-bulk-value',
          size: 'sm'
        });
        if (binaryHtml) {
          return `<div class="matrix-column-bulk-value-host">${binaryHtml}</div>`;
        }
        const options = Array.isArray(field.options) ? field.options : [];
        const opts = ['<option value="">Choose…</option>']
          .concat(options.map((opt) => {
            const value = esc(String(opt?.value ?? ''));
            const label = esc(String(opt?.label || opt?.value || ''));
            return `<option value="${value}">${label}</option>`;
          }))
          .join('');
        return `<label class="form-label" for="matrix_bulk_select_${esc(fieldId)}">Value</label><select id="matrix_bulk_select_${esc(fieldId)}" class="form-select form-select-sm js-matrix-column-bulk-value" data-field-id="${esc(fieldId)}">${opts}</select>`;
      }
      if (type === 'checkbox') {
        const binaryHtml = window.ReportSelectField?.buildReportSelectFieldHtml?.({
          field: {
            id: fieldId,
            type: 'select',
            label: field.label,
            options: [
              { value: 'true', label: 'Checked' },
              { value: 'false', label: 'Unchecked' }
            ]
          },
          value: '',
          name: `matrix_bulk_${fieldId}`,
          idPrefix: `matrix_bulk_${fieldId}`,
          inputClass: 'js-matrix-column-bulk-value',
          size: 'sm'
        });
        return `<div class="matrix-column-bulk-value-host">${binaryHtml || ''}</div>`;
      }
      if (type === 'number') {
        return `<label class="form-label" for="matrix_bulk_number_${esc(fieldId)}">Value</label><input type="number" id="matrix_bulk_number_${esc(fieldId)}" class="form-control form-control-sm js-matrix-column-bulk-value" data-field-id="${esc(fieldId)}" step="any">`;
      }
      if (type === 'date') {
        return `<label class="form-label" for="matrix_bulk_date_${esc(fieldId)}">Date</label><input type="date" id="matrix_bulk_date_${esc(fieldId)}" class="form-control form-control-sm js-matrix-column-bulk-value" data-field-id="${esc(fieldId)}">`;
      }
      return `<label class="form-label" for="matrix_bulk_text_${esc(fieldId)}">Value</label><input type="text" id="matrix_bulk_text_${esc(fieldId)}" class="form-control form-control-sm js-matrix-column-bulk-value" data-field-id="${esc(fieldId)}" placeholder="Enter value for all students">`;
    }

    function readColumnBulkRawValueFromPopover(field) {
      const body = document.getElementById('matrixColumnBulkPopoverBody');
      if (!body || !field) return '';
      const fieldId = String(field.id || '').trim();
      const radios = body.querySelectorAll(`input[type="radio"][data-field-id="${CSS.escape(fieldId)}"]`);
      if (radios.length) {
        const checked = Array.from(radios).find((el) => el.checked);
        return checked ? checked.value : '';
      }
      const control = body.querySelector('.js-matrix-column-bulk-value');
      if (!control) return '';
      if (control.type === 'checkbox') return control.checked;
      return readControl(control);
    }

    function openMatrixColumnBulkPopover(fieldId, anchorEl) {
      const cleanFieldId = String(fieldId || '').trim();
      if (!cleanFieldId || !anchorEl) return;
      const field = (matrixState.tableFields || []).find((item) => String(item.id || '') === cleanFieldId);
      if (!field || !fieldBulkEligible(field)) return;
      const pop = document.getElementById('matrixColumnBulkPopover');
      const body = document.getElementById('matrixColumnBulkPopoverBody');
      const titleEl = document.getElementById('matrixColumnBulkPopoverTitle');
      const subtitleEl = document.getElementById('matrixColumnBulkPopoverSubtitle');
      if (!pop || !body || !titleEl || !subtitleEl) return;
      if (pop.parentElement !== document.body) {
        document.body.appendChild(pop);
      }
      titleEl.textContent = String(field.label || 'Apply to all students');
      subtitleEl.textContent = 'Choose a value for every editable student in this column. You can still adjust individual rows afterward.';
      body.innerHTML = buildColumnBulkPopoverBodyHtml(field);
      activeColumnBulkFieldId = cleanFieldId;
      positionMatrixColumnBulkPopover(anchorEl);
      pop.classList.remove('d-none');
      pop.removeAttribute('hidden');
      const firstFocus = body.querySelector('input:not([type="hidden"]), select, textarea, button');
      if (firstFocus && typeof firstFocus.focus === 'function') firstFocus.focus();
    }

    function applyColumnBulkValue(fieldId) {
      const cleanFieldId = String(fieldId || activeColumnBulkFieldId || '').trim();
      if (!cleanFieldId) return;
      const field = (matrixState.tableFields || []).find((item) => String(item.id || '') === cleanFieldId);
      if (!field || !fieldBulkEligible(field)) return;
      const raw = readColumnBulkRawValueFromPopover(field);
      if (raw === '' || raw === null || raw === undefined) {
        showReportMatrixMessage({
          title: 'Choose a value',
          icon: 'info',
          message: 'Select or enter a value before applying to all students.'
        });
        return;
      }
      const value = coerceBulkValue(field, raw);
      if (field.type === 'checkbox' && value === null) {
        showReportMatrixMessage({
          title: 'Choose a value',
          icon: 'info',
          message: 'Select Checked or Unchecked before applying.'
        });
        return;
      }
      let applied = 0;
      (matrixState.rows || []).forEach((rowState) => {
        if (rowState.locked) return;
        rowState.answers = { ...(rowState.answers || {}), [cleanFieldId]: value };
        dirtyStudents.add(String(rowState.studentId || ''));
        applied += 1;
      });
      document.querySelectorAll('#reportMatrixTable tr[data-student-id]').forEach((rowEl) => {
        const studentId = String(rowEl.dataset.studentId || '');
        const rowState = (matrixState.rows || []).find((item) => String(item.studentId || '') === studentId);
        if (!rowState || rowState.locked) return;
        const control = rowEl.querySelector(`.js-matrix-row-field[data-field-id="${CSS.escape(cleanFieldId)}"]`);
        if (!control || control.disabled || control.readOnly) return;
        writeControl(control, value);
        rowEl.classList.add('matrix-row-dirty');
        recalculateRow(rowEl);
      });
      persistMatrixStateJson();
      closeMatrixColumnBulkPopover();
      if (!applied) {
        showReportMatrixMessage({
          title: 'No rows updated',
          icon: 'info',
          message: 'There are no editable student rows for this column.'
        });
      }
    }

    function readControl(control) {
      if (!control) return '';
      if (control.type === 'checkbox') return control.checked;
      if (control.type === 'radio') return control.checked ? control.value : '';
      if (control.type === 'number') {
        if (control.value === '') return '';
        const value = Number(control.value);
        return Number.isFinite(value) ? value : control.value;
      }
      return control.value;
    }

    function writeControl(control, value) {
      if (!control) return;
      if (control.type === 'radio') {
        const fieldId = String(control.dataset.fieldId || '').trim();
        if (!fieldId) return;
        const container = control.closest('tr[data-student-id], #reportMatrixSharedFields, .accordion-body') || document;
        const group = container.querySelectorAll(`[data-field-id="${CSS.escape(fieldId)}"]`);
        const target = value === undefined || value === null ? '' : String(value);
        group.forEach((el) => {
          if (el.type === 'radio') el.checked = String(el.value) === target;
        });
        return;
      }
      if (control.type === 'checkbox') control.checked = value === true || String(value).toLowerCase() === 'true';
      else control.value = value === undefined || value === null ? '' : String(value);
    }

    function collectControls(container, selector) {
      const out = {};
      const processedRadioFields = new Set();
      container.querySelectorAll(selector).forEach((control) => {
        const fieldId = String(control.dataset.fieldId || '').trim();
        if (!fieldId) return;
        if (control.type === 'radio') {
          if (processedRadioFields.has(fieldId)) return;
          processedRadioFields.add(fieldId);
          const group = container.querySelectorAll(`${selector}[data-field-id="${CSS.escape(fieldId)}"]`);
          const checked = Array.from(group).find((el) => el.checked);
          out[fieldId] = checked ? readControl(checked) : '';
          return;
        }
        out[fieldId] = readControl(control);
      });
      return out;
    }

    function allMatrixFields() {
      return [
        ...(matrixState.sharedFields || []),
        ...(matrixState.commonFields || []),
        ...(matrixState.tableFields || [])
      ];
    }

    function recalculateRow(row) {
      if (!row || !window.SchoolReportCalculatedFields?.recomputeCalculatedAnswers) return;
      const studentId = String(row.dataset.studentId || '');
      const rowState = (matrixState.rows || []).find((item) => String(item.studentId || '') === studentId);
      if (!rowState) return;
      const answers = {
        ...(rowState.answers || {}),
        ...collectControls(document, '#reportMatrixCommonFields [data-field-id]'),
        ...collectControls(document, '.js-matrix-shared-field'),
        ...collectControls(row, '.js-matrix-row-field')
      };
      const result = window.SchoolReportCalculatedFields.recomputeCalculatedAnswers({
        fields: allMatrixFields(),
        answers,
        prefill: rowState.calculationPrefill || {}
      });
      const displayResult = window.SchoolReportCalculatedFields.applyReadOnlyDisplayConversions
        ? window.SchoolReportCalculatedFields.applyReadOnlyDisplayConversions({
          fields: allMatrixFields(),
          answers: result.answers,
          prefill: rowState.calculationPrefill || {}
        })
        : { answers: result.answers };
      rowState.answers = result.answers;
      (matrixState.tableFields || []).filter((field) => field.calculated).forEach((field) => {
        const selector = `.js-matrix-row-field[data-field-id="${CSS.escape(field.id)}"]`;
        writeControl(row.querySelector(selector), displayResult.answers[field.id]);
      });
    }

    function recalculateAllRows() {
      document.querySelectorAll('tr[data-student-id]').forEach(recalculateRow);
    }

    function syncRowLifecycleActions(row, rowState) {
      if (!row) return;
      row.querySelectorAll('.js-matrix-reopen-instance, .js-matrix-unlock-instance').forEach((el) => el.remove());
      const instanceId = String(rowState?.instanceId || '').trim();
      const status = String(rowState?.status || '').toLowerCase();
      const studentName = String(rowState?.studentName || rowState?.studentId || '');
      row.dataset.instanceId = instanceId;
      row.dataset.reportStatus = status;
      if (!instanceId) return;
      const host = row.querySelector('.matrix-student-tools');
      if (!host) return;
      if (status === 'submitted' && window.CAN_REOPEN_REPORT_INSTANCE) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'matrix-row-icon-btn matrix-row-icon-btn--warning js-matrix-reopen-instance';
        btn.dataset.instanceId = instanceId;
        btn.dataset.studentName = studentName;
        btn.title = 'Reopen as draft for the teacher';
        btn.setAttribute('aria-label', 'Reopen as draft for the teacher');
        btn.innerHTML = '<i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>';
        host.appendChild(btn);
      }
      if (status === 'locked' && window.CAN_UNLOCK_REPORT_INSTANCE) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'matrix-row-icon-btn matrix-row-icon-btn--warning js-matrix-unlock-instance';
        btn.dataset.instanceId = instanceId;
        btn.dataset.studentName = studentName;
        btn.title = 'Unlock returns the report to submitted';
        btn.setAttribute('aria-label', 'Unlock returns the report to submitted');
        btn.innerHTML = '<i class="bi bi-unlock" aria-hidden="true"></i>';
        host.appendChild(btn);
      }
    }

    function syncBulkLifecycleActions() {
      const started = (matrixState.rows || []).filter((row) => row.instanceId && !row.isPending);
      const first = started.length ? String(started[0].status || '').toLowerCase() : '';
      const uniform = first && started.every((row) => String(row.status || '').toLowerCase() === first) ? first : '';
      const actions = document.getElementById('reportMatrixActions')?.querySelector('.d-flex');
      if (!actions) return;
      document.getElementById('btnMatrixReopenAll')?.remove();
      document.getElementById('btnMatrixUnlockAll')?.remove();
      document.getElementById('matrixLifecycleDivider')?.remove();
      if (uniform === 'submitted' && window.CAN_REOPEN_REPORT_INSTANCE) {
        const divider = document.createElement('span');
        divider.id = 'matrixLifecycleDivider';
        divider.className = 'mx-1 text-muted d-none d-md-inline';
        divider.textContent = '|';
        actions.appendChild(divider);
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.id = 'btnMatrixReopenAll';
        btn.className = 'btn btn-outline-warning btn-sm';
        btn.title = 'Reopen every submitted report in this matrix to draft';
        btn.innerHTML = '<i class="bi bi-arrow-counterclockwise me-1"></i>Reopen All for Teachers';
        btn.addEventListener('click', function () {
          runMatrixLifecycleAction('reopen', collectMatrixLifecycleTargets('reopen'));
        });
        actions.appendChild(btn);
      } else if (uniform === 'locked' && window.CAN_UNLOCK_REPORT_INSTANCE) {
        const divider = document.createElement('span');
        divider.id = 'matrixLifecycleDivider';
        divider.className = 'mx-1 text-muted d-none d-md-inline';
        divider.textContent = '|';
        actions.appendChild(divider);
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.id = 'btnMatrixUnlockAll';
        btn.className = 'btn btn-warning btn-sm';
        btn.title = 'Unlock every locked report in this matrix back to submitted';
        btn.innerHTML = '<i class="bi bi-unlock me-1"></i>Unlock All Reports';
        btn.addEventListener('click', function () {
          runMatrixLifecycleAction('unlock', collectMatrixLifecycleTargets('unlock'));
        });
        actions.appendChild(btn);
      }
    }

    function applyMatrixState(nextMatrix, savedStudentId, options = {}) {
      const preserveStudentIds = options.preserveStudentIds instanceof Set ? options.preserveStudentIds : new Set();
      const preserveShared = options.preserveShared === true;
      if (!nextMatrix || typeof nextMatrix !== 'object') return;
      matrixState = nextMatrix;
      if (!preserveShared) {
        (nextMatrix.sharedFields || []).forEach((field) => {
          writeControl(document.querySelector(`.js-matrix-shared-field[data-field-id="${CSS.escape(field.id)}"]`), field.value);
        });
      }
      (nextMatrix.commonFields || []).forEach((field) => {
        writeControl(document.querySelector(`[data-field-id="${CSS.escape(field.id)}"]:not(.js-matrix-row-field)`), field.value);
      });
      const fieldMap = new Map((nextMatrix.tableFields || []).map((field) => [String(field.id), field]));
      (nextMatrix.rows || []).forEach((rowState) => {
        const row = document.querySelector(`tr[data-student-id="${CSS.escape(String(rowState.studentId))}"]`);
        if (!row) return;
        row.querySelectorAll('.js-matrix-row-field').forEach((control) => {
          const field = fieldMap.get(String(control.dataset.fieldId || ''));
          if (!field) return;
          const rowId = String(rowState.studentId);
          if (!preserveStudentIds.has(rowId) && (savedStudentId === undefined || savedStudentId === null || rowId === String(savedStudentId) || field.readOnly || field.calculated)) {
            writeControl(control, rowState.answers?.[field.id]);
          }
        });
        const status = row.querySelector('.js-matrix-status');
        applyReportMatrixStatusIcon(status, rowState.status);
        const openLink = row.querySelector('.js-matrix-open');
        if (openLink && rowState.editHref) {
          openLink.href = rowState.editHref;
          openLink.classList.remove('d-none');
        }
        row.classList.toggle('table-secondary', Boolean(rowState.locked));
        syncRowLifecycleActions(row, rowState);
      });
      Object.entries(nextMatrix.progress || {}).forEach(([key, value]) => {
        const target = document.querySelector(`[data-progress-key="${CSS.escape(key)}"]`);
        if (target) target.textContent = String(value);
      });
      syncBulkLifecycleActions();
    }

    async function runBulkAction(button) {
      const requestedAction = String(button?.dataset.action || 'save').toLowerCase();
      const submitAction = ['save', 'submit', 'lock'].includes(requestedAction) ? requestedAction : 'save';
      const rowStates = new Map((matrixState.rows || []).map((row) => [String(row.studentId), row]));
      const editableRows = Array.from(document.querySelectorAll('tr[data-student-id]')).filter((row) => {
        const state = rowStates.get(String(row.dataset.studentId || ''));
        return state ? !state.locked : !row.classList.contains('table-secondary');
      });
      if (!editableRows.length) {
        await showReportMatrixMessage({
          title: 'No Editable Reports',
          icon: 'info',
          message: 'There are no editable student reports to process.'
        });
        return;
      }
      const actionButtons = Array.from(document.querySelectorAll('.js-matrix-bulk-action'));
      actionButtons.forEach((item) => { item.disabled = true; });
      const loadingToken = typeof window.showLoading === 'function'
        ? window.showLoading(submitAction === 'submit'
          ? 'Submitting student reports...'
          : (submitAction === 'lock' ? 'Locking student reports...' : 'Saving student reports...'))
        : null;
      let feedback;
      try {
        const response = await fetch('/school/reports/instances/matrix/' + encodeURIComponent(matrixState.assignmentId) + '/save-all', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
            'x-ajax-request': 'true',
            'x-action-state-id': String(document.getElementById('reportMatrixActionStateId')?.value || '')
          },
          body: JSON.stringify({
            assignmentRowId: matrixState.assignmentRowId,
            teacherId: matrixState.teacherId,
            submitAction,
            rows: editableRows.map((row) => ({
              studentId: String(row.dataset.studentId || ''),
              answers: collectControls(row, '.js-matrix-row-field')
            })),
            sharedAnswers: collectControls(document, '.js-matrix-shared-field'),
            actionStateId: String(document.getElementById('reportMatrixActionStateId')?.value || '')
          })
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || !['success', 'partial'].includes(result.status)) {
          throw new Error(result.message || 'Unable to process the report matrix.');
        }
        const unsuccessfulIds = new Set((result.results || [])
          .filter((item) => item.status !== 'success')
          .map((item) => String(item.studentId || '')));
        applyMatrixState(result.matrix, null, { preserveStudentIds: unsuccessfulIds, preserveShared: unsuccessfulIds.size > 0 });
        dirtyStudents.clear();
        document.querySelectorAll('tr[data-student-id]').forEach((row) => row.classList.remove('matrix-row-dirty'));
        unsuccessfulIds.forEach((studentId) => {
          dirtyStudents.add(studentId);
          document.querySelector('tr[data-student-id="' + CSS.escape(studentId) + '"]')?.classList.add('matrix-row-dirty');
        });
        sharedDirty = unsuccessfulIds.size > 0;
        const detail = (result.results || [])
          .filter((item) => item.status === 'error' && item.message)
          .slice(0, 3)
          .map((item) => String(item.studentId || '') + ': ' + item.message)
          .join(' | ');
        const message = [result.message || 'Report matrix processed.', detail].filter(Boolean).join(' ');
        feedback = {
          title: submitAction === 'submit' ? 'Reports Submitted' : (submitAction === 'lock' ? 'Reports Locked' : 'Reports Saved'),
          icon: result.status === 'partial' ? 'warning' : 'success',
          message
        };
      } catch (error) {
        feedback = {
          title: submitAction === 'submit'
            ? 'Unable to Submit Reports'
            : (submitAction === 'lock' ? 'Unable to Lock Reports' : 'Unable to Save Reports'),
          icon: 'error',
          message: error.message
        };
      } finally {
        const hasEditable = (matrixState.rows || []).some((row) => !row.locked);
        actionButtons.forEach((item) => { item.disabled = !hasEditable; });
        if (typeof window.hideLoading === 'function') window.hideLoading(loadingToken || { force: true });
      }
      await showReportMatrixMessage(feedback);
    }

    const prefillModal = document.getElementById('reportMatrixPrefillModal');
    const prefillRowsEl = document.getElementById('reportMatrixPrefillRows');
    const prefillSummaryEl = document.getElementById('reportMatrixPrefillSummary');
    const applyPrefillButton = document.getElementById('btnApplyMatrixPrefill');
    function escapeHtml(value) { return String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[char])); }
    function updatePrefillApplyState() { if (applyPrefillButton) applyPrefillButton.disabled = !prefillRowsEl?.querySelector('.js-matrix-prefill-key:checked'); }
    function renderPrefillPreview(result) {
      const students = Array.isArray(result?.students) ? result.students : [];
      if (prefillSummaryEl) prefillSummaryEl.textContent = students.length ? (String(result.summary?.changed || 0) + ' student(s) have updates. Select individual prefill keys to apply.') : 'No student rows were found.';
      if (!prefillRowsEl) return;
      prefillRowsEl.innerHTML = students.map((student) => {
        const disabled = student.locked || student.pending || !student.changes?.length;
        const status = student.pending ? 'pending (no stored snapshot)' : (student.locked ? 'locked' : student.status);
        const changes = (student.changes || []).map((change) => '<label class="d-flex gap-2 align-items-start border rounded p-2 mb-2"><input type="checkbox" class="form-check-input js-matrix-prefill-key mt-1" data-student-id="' + escapeHtml(student.studentId) + '" data-prefill-key="' + escapeHtml(change.prefillKey) + '" ' + (disabled ? 'disabled' : '') + '><span><strong>' + escapeHtml(change.prefillKey) + '</strong><br><span class="small text-muted">' + (change.fields || []).map((field) => escapeHtml(field.label) + ': ' + escapeHtml(field.currentValue) + ' ? ' + escapeHtml(field.newValue)).join('<br>') + '</span></span></label>').join('');
        return '<div class="card mb-3"><div class="card-header py-2 d-flex justify-content-between"><strong>' + escapeHtml(student.studentName || student.studentId) + '</strong><span class="badge bg-light text-secondary border">' + escapeHtml(status) + '</span></div><div class="card-body py-2">' + (changes || '<span class="small text-muted">No applicable updates.</span>') + '</div></div>';
      }).join('');
      prefillRowsEl.querySelectorAll('.js-matrix-prefill-key').forEach((item) => item.addEventListener('change', updatePrefillApplyState));
      updatePrefillApplyState();
    }
    async function loadPrefillPreview() {
      if (prefillSummaryEl) prefillSummaryEl.textContent = 'Loading prefill updates...';
      if (prefillRowsEl) prefillRowsEl.innerHTML = '';
      if (typeof bootstrap !== 'undefined' && prefillModal) bootstrap.Modal.getOrCreateInstance(prefillModal).show();
      try {
        const response = await fetch('/school/reports/instances/matrix/' + encodeURIComponent(matrixState.assignmentId) + '/prefill-preview?assignmentRowId=' + encodeURIComponent(matrixState.assignmentRowId || '') + '&teacherId=' + encodeURIComponent(matrixState.teacherId || ''), { headers: { Accept: 'application/json', 'x-ajax-request': 'true' } });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || result.status !== 'success') throw new Error(result.message || 'Unable to preview prefill updates.');
        renderPrefillPreview(result);
      } catch (error) { if (prefillSummaryEl) prefillSummaryEl.textContent = error.message; }
    }
    async function applyPrefillUpdates() {
      const updates = {};
      prefillRowsEl?.querySelectorAll('.js-matrix-prefill-key:checked').forEach((item) => { const id = String(item.dataset.studentId || ''); (updates[id] ||= []).push(item.dataset.prefillKey); });
      const body = { assignmentRowId: matrixState.assignmentRowId, teacherId: matrixState.teacherId, updates: Object.entries(updates).map(([studentId, prefillKeys]) => ({ studentId, prefillKeys })), actionStateId: String(document.getElementById('reportMatrixActionStateId')?.value || '') };
      applyPrefillButton.disabled = true;
      try {
        const response = await fetch('/school/reports/instances/matrix/' + encodeURIComponent(matrixState.assignmentId) + '/prefill-apply', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json', 'x-ajax-request': 'true', 'x-action-state-id': body.actionStateId }, body: JSON.stringify(body) });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || !['success','partial'].includes(result.status)) throw new Error(result.message || 'Unable to apply prefill updates.');
        if (typeof bootstrap !== 'undefined' && prefillModal) bootstrap.Modal.getOrCreateInstance(prefillModal).hide();
        if (result.matrix) applyMatrixState(result.matrix, null);
        await showReportMatrixMessage({
          title: 'Prefill Updates Applied',
          icon: result.status === 'partial' ? 'warning' : 'success',
          message: result.message || 'Prefill updates applied.'
        });
        if (!result.matrix) window.location.reload();
      } catch (error) {
        await showReportMatrixMessage({ title: 'Unable to Apply Prefill Updates', icon: 'error', message: error.message });
        applyPrefillButton.disabled = false;
      }
    }
    document.getElementById('btnMatrixPrefillPreview')?.addEventListener('click', loadPrefillPreview);
    applyPrefillButton?.addEventListener('click', applyPrefillUpdates);

    document.getElementById('reportMatrixTable')?.addEventListener('click', (event) => {
      const applyAllBtn = event.target.closest('.js-matrix-column-apply-all');
      if (!applyAllBtn) return;
      event.preventDefault();
      event.stopPropagation();
      openMatrixColumnBulkPopover(applyAllBtn.dataset.fieldId || '', applyAllBtn);
    });
    document.getElementById('btnMatrixColumnBulkCancel')?.addEventListener('click', () => closeMatrixColumnBulkPopover());
    document.getElementById('btnMatrixColumnBulkConfirm')?.addEventListener('click', () => applyColumnBulkValue(activeColumnBulkFieldId));
    document.addEventListener('click', (event) => {
      const pop = document.getElementById('matrixColumnBulkPopover');
      if (!pop || pop.hasAttribute('hidden')) return;
      if (pop.contains(event.target) || event.target.closest('.js-matrix-column-apply-all')) return;
      closeMatrixColumnBulkPopover();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      const pop = document.getElementById('matrixColumnBulkPopover');
      if (!pop || pop.hasAttribute('hidden')) return;
      closeMatrixColumnBulkPopover();
    });

    document.querySelectorAll('.js-matrix-row-field').forEach((control) => {
      control.addEventListener('change', () => {
        const row = control.closest('tr[data-student-id]');
        if (!row) return;
        recalculateRow(row);
        dirtyStudents.add(String(row.dataset.studentId || ''));
        row.classList.add('matrix-row-dirty');
      });
      control.addEventListener('input', () => {
        const row = control.closest('tr[data-student-id]');
        if (!row) return;
        recalculateRow(row);
        dirtyStudents.add(String(row.dataset.studentId || ''));
        row.classList.add('matrix-row-dirty');
      });
    });
    document.querySelectorAll('.js-matrix-shared-field').forEach((control) => {
      control.addEventListener('change', () => { sharedDirty = true; recalculateAllRows(); });
      control.addEventListener('input', () => { sharedDirty = true; recalculateAllRows(); });
    });
    document.querySelectorAll('.js-matrix-bulk-action').forEach((button) => {
      button.addEventListener('click', () => runBulkAction(button));
    });

    function matrixActionStateId() {
      return String(document.getElementById('reportMatrixActionStateId')?.value || '').trim();
    }

    function collectMatrixLifecycleTargets(kind) {
      const wantStatus = kind === 'reopen' ? 'submitted' : 'locked';
      return (matrixState.rows || [])
        .filter((row) => row.instanceId && !row.isPending && String(row.status || '').toLowerCase() === wantStatus)
        .map((row) => ({
          instanceId: String(row.instanceId),
          studentName: String(row.studentName || row.studentId || row.instanceId)
        }));
    }

    async function runMatrixLifecycleAction(kind, targets) {
      const api = window.ReportAssignmentDelete;
      if (!api || typeof api.reopenReportInstance !== 'function' || typeof api.unlockReportInstance !== 'function') {
        await showReportMatrixMessage({
          title: 'Unable to Process',
          icon: 'error',
          message: 'Lifecycle helpers are unavailable. Hard-refresh the page (Ctrl+F5) and try again.'
        });
        return;
      }
      const rows = Array.isArray(targets) ? targets.filter((row) => row?.instanceId) : [];
      if (!rows.length) {
        await showReportMatrixMessage({
          title: kind === 'reopen' ? 'Nothing to Reopen' : 'Nothing to Unlock',
          icon: 'info',
          message: kind === 'reopen'
            ? 'There are no submitted reports to reopen.'
            : 'There are no locked reports to unlock.'
        });
        return;
      }
      const confirmFn = kind === 'reopen'
        ? (msg) => api.confirmReopen(msg)
        : (msg) => api.confirmUnlock(msg);
      let confirmMessage = kind === 'reopen'
        ? (rows.length === 1
          ? ('Reopen the report for ' + rows[0].studentName + ' as draft so the teacher can edit it?')
          : ('Reopen all ' + rows.length + ' submitted reports as draft for teachers?'))
        : (rows.length === 1
          ? ('Unlock the report for ' + rows[0].studentName + '? Status will return to submitted.')
          : ('Unlock all ' + rows.length + ' locked reports? Status will return to submitted.'));
      if (kind === 'reopen' && window.MATRIX_HAS_SHARED_FIELDS) {
        const reopenIds = new Set(rows.map((row) => String(row.instanceId || '').trim()).filter(Boolean));
        const remainingBlocking = (matrixState.rows || []).filter((row) => {
          const id = String(row.instanceId || '').trim();
          if (!id || reopenIds.has(id) || row.isPending) return false;
          const status = String(row.status || '').toLowerCase();
          return status && status !== 'draft';
        });
        if (remainingBlocking.length) {
          confirmMessage += '\n\nImportant: shared fields will stay read-only after this reopen because ' + remainingBlocking.length + ' other student report(s) remain submitted/locked/archived. Only private fields will be editable until those reports are also reopened to draft.';
        } else if (rows.length > 1) {
          confirmMessage += '\n\nAfter reopen, shared fields become editable because all student reports in this matrix will be draft.';
        }
      }
      const confirmed = await confirmFn(confirmMessage);
      if (!confirmed) return;

      const actionStateId = matrixActionStateId();
      const failures = [];
      await api.withLoading(kind === 'reopen' ? 'Reopening reports...' : 'Unlocking reports...', async function () {
        for (const row of rows) {
          try {
            if (kind === 'reopen') {
              await api.reopenReportInstance(row.instanceId, { actionStateId });
            } else {
              await api.unlockReportInstance(row.instanceId, { actionStateId });
            }
          } catch (error) {
            failures.push((row.studentName || row.instanceId) + ': ' + (error?.message || 'failed'));
          }
        }
      });

      if (failures.length) {
        const failureText = failures.slice(0, 5).join(' | ') + (failures.length > 5 ? (' | +' + (failures.length - 5) + ' more') : '');
        const isActionStateFailure = /security violation|action state/i.test(failureText);
        await showReportMatrixMessage({
          title: kind === 'reopen' ? 'Reopen Incomplete' : 'Unlock Incomplete',
          icon: isActionStateFailure ? 'error' : 'warning',
          message: failureText
        });
      }
      window.location.reload();
    }

    document.addEventListener('click', function (event) {
      const reopenBtn = event.target.closest('.js-matrix-reopen-instance');
      if (reopenBtn) {
        if (!window.CAN_REOPEN_REPORT_INSTANCE) return;
        event.preventDefault();
        runMatrixLifecycleAction('reopen', [{
          instanceId: reopenBtn.getAttribute('data-instance-id'),
          studentName: reopenBtn.getAttribute('data-student-name') || ''
        }]);
        return;
      }
      const unlockBtn = event.target.closest('.js-matrix-unlock-instance');
      if (unlockBtn) {
        if (!window.CAN_UNLOCK_REPORT_INSTANCE) return;
        event.preventDefault();
        runMatrixLifecycleAction('unlock', [{
          instanceId: unlockBtn.getAttribute('data-instance-id'),
          studentName: unlockBtn.getAttribute('data-student-name') || ''
        }]);
      }
    });

    document.getElementById('btnMatrixReopenAll')?.addEventListener('click', function () {
      if (!window.CAN_REOPEN_REPORT_INSTANCE) return;
      runMatrixLifecycleAction('reopen', collectMatrixLifecycleTargets('reopen'));
    });
    document.getElementById('btnMatrixUnlockAll')?.addEventListener('click', function () {
      if (!window.CAN_UNLOCK_REPORT_INSTANCE) return;
      runMatrixLifecycleAction('unlock', collectMatrixLifecycleTargets('unlock'));
    });

    const matrixDocxModalEl = document.getElementById('matrixDocxExportModal');
    const matrixDocxModal = matrixDocxModalEl && window.bootstrap?.Modal
      ? window.bootstrap.Modal.getOrCreateInstance(matrixDocxModalEl)
      : null;
    const matrixPdfModalEl = document.getElementById('matrixPdfExportModal');
    const matrixPdfModal = matrixPdfModalEl && window.bootstrap?.Modal
      ? window.bootstrap.Modal.getOrCreateInstance(matrixPdfModalEl)
      : null;

    function buildDocxOptionHtml(options, selectedKey) {
      return (Array.isArray(options) ? options : []).map((opt) => {
        const key = String(opt.key || '');
        const selected = key === String(selectedKey || '') ? ' selected' : '';
        const label = String(opt.label || key);
        const fileName = String(opt.fileName || '');
        return `<option value="${key.replace(/"/g, '&quot;')}"${selected}>${label}${fileName ? ` (${fileName})` : ''}</option>`;
      }).join('');
    }

    function buildPdfOptionHtml(options, selectedKey) {
      return (Array.isArray(options) ? options : []).map((opt) => {
        const key = String(opt.key || '');
        const selected = key === String(selectedKey || '') ? ' selected' : '';
        const label = String(opt.label || key);
        const fileName = String(opt.fileName || '');
        return `<option value="${key.replace(/"/g, '&quot;')}"${selected}>${label}${fileName ? ` (${fileName})` : ''}</option>`;
      }).join('');
    }

    document.getElementById('btnMatrixExportDocx')?.addEventListener('click', async () => {
      try {
        const previewUrl = '/school/reports/instances/matrix/'
          + encodeURIComponent(matrixState.assignmentId)
          + '/export-docx-preview?assignmentRowId=' + encodeURIComponent(matrixState.assignmentRowId || '')
          + '&teacherId=' + encodeURIComponent(matrixState.teacherId || '');
        const response = await fetch(previewUrl, {
          headers: { Accept: 'application/json', 'x-ajax-request': 'true' }
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || result.status === 'error') {
          throw new Error(result.message || 'Unable to prepare Word export suggestions.');
        }
        const tbody = document.getElementById('matrixDocxExportRows');
        tbody.innerHTML = '';
        (result.rows || []).forEach((row) => {
          const tr = document.createElement('tr');
          tr.innerHTML = `
            <td>
              <input type="hidden" class="js-docx-student-id" value="${String(row.studentId || '').replace(/"/g, '&quot;')}">
              ${String(row.studentName || row.studentId || '')}
            </td>
            <td>${String(row.funderLabel || 'Default / unknown')}</td>
            <td>
              <select class="form-select form-select-sm js-docx-key">
                ${buildDocxOptionHtml(row.availableDocxOptions || result.availableDocxOptions, row.suggestedDocxKey)}
              </select>
            </td>
          `;
          tbody.appendChild(tr);
        });
        matrixDocxModal?.show();
      } catch (error) {
        await showReportMatrixMessage({
          title: 'Export DOCX',
          icon: 'error',
          message: error?.message || 'Unable to open export options.'
        });
      }
    });

    document.getElementById('btnConfirmMatrixDocxExport')?.addEventListener('click', async () => {
      const btn = document.getElementById('btnConfirmMatrixDocxExport');
      const original = btn?.innerHTML;
      try {
        if (btn) {
          btn.disabled = true;
          btn.innerHTML = 'Exporting…';
        }
        const selections = [...document.querySelectorAll('#matrixDocxExportRows tr')].map((tr) => ({
          studentId: tr.querySelector('.js-docx-student-id')?.value || '',
          docxKey: tr.querySelector('.js-docx-key')?.value || 'default'
        })).filter((row) => row.studentId);
        const mode = document.querySelector('input[name="matrixDocxExportMode"]:checked')?.value || 'consolidated';
        const response = await fetch(
          '/school/reports/instances/matrix/' + encodeURIComponent(matrixState.assignmentId) + '/export',
          {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Accept: 'application/octet-stream',
              'x-ajax-request': 'true'
            },
            body: JSON.stringify({
              format: 'docx',
              mode,
              assignmentRowId: matrixState.assignmentRowId || '',
              teacherId: matrixState.teacherId || '',
              selections
            })
          }
        );
        if (!response.ok) {
          let message = 'Export failed.';
          try {
            const err = await response.json();
            message = err.message || message;
          } catch (_) {}
          throw new Error(message);
        }
        const blob = await response.blob();
        const disposition = response.headers.get('Content-Disposition') || '';
        const match = disposition.match(/filename="?([^"]+)"?/i);
        const fileName = match?.[1] || (mode === 'zip'
          ? `report-matrix-${matrixState.assignmentId}.zip`
          : `report-matrix-${matrixState.assignmentId}.docx`);
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = fileName;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
        matrixDocxModal?.hide();
      } catch (error) {
        await showReportMatrixMessage({
          title: 'Export Failed',
          icon: 'error',
          message: error?.message || 'Unable to export Word files.'
        });
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = original;
        }
      }
    });

    document.getElementById('btnMatrixExportPdf')?.addEventListener('click', async () => {
      try {
        const previewUrl = '/school/reports/instances/matrix/'
          + encodeURIComponent(matrixState.assignmentId)
          + '/export-pdf-preview?assignmentRowId=' + encodeURIComponent(matrixState.assignmentRowId || '')
          + '&teacherId=' + encodeURIComponent(matrixState.teacherId || '');
        const response = await fetch(previewUrl, {
          headers: { Accept: 'application/json', 'x-ajax-request': 'true' }
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || result.status === 'error') {
          throw new Error(result.message || 'Unable to prepare PDF export suggestions.');
        }
        const tbody = document.getElementById('matrixPdfExportRows');
        tbody.innerHTML = '';
        (result.rows || []).forEach((row) => {
          const tr = document.createElement('tr');
          tr.innerHTML = `
            <td>
              <input type="hidden" class="js-pdf-student-id" value="${String(row.studentId || '').replace(/"/g, '&quot;')}">
              ${String(row.studentName || row.studentId || '')}
            </td>
            <td>${String(row.funderLabel || 'Default / unknown')}</td>
            <td>
              <select class="form-select form-select-sm js-pdf-key">
                ${buildPdfOptionHtml(row.availablePdfOptions || result.availablePdfOptions, row.suggestedPdfKey)}
              </select>
            </td>
          `;
          tbody.appendChild(tr);
        });
        matrixPdfModal?.show();
      } catch (error) {
        await showReportMatrixMessage({
          title: 'Export PDF',
          icon: 'error',
          message: error?.message || 'Unable to open export options.'
        });
      }
    });

    document.getElementById('btnConfirmMatrixPdfExport')?.addEventListener('click', async () => {
      const btn = document.getElementById('btnConfirmMatrixPdfExport');
      const original = btn?.innerHTML;
      try {
        if (btn) {
          btn.disabled = true;
          btn.innerHTML = 'Exporting...';
        }
        const selections = [...document.querySelectorAll('#matrixPdfExportRows tr')].map((tr) => ({
          studentId: tr.querySelector('.js-pdf-student-id')?.value || '',
          pdfKey: tr.querySelector('.js-pdf-key')?.value || 'default'
        })).filter((row) => row.studentId);
        const response = await fetch(
          '/school/reports/instances/matrix/' + encodeURIComponent(matrixState.assignmentId) + '/export',
          {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Accept: 'application/octet-stream',
              'x-ajax-request': 'true'
            },
            body: JSON.stringify({
              format: 'pdf',
              assignmentRowId: matrixState.assignmentRowId || '',
              teacherId: matrixState.teacherId || '',
              selections
            })
          }
        );
        if (!response.ok) {
          let message = 'Export failed.';
          try {
            const err = await response.json();
            message = err.message || message;
          } catch (_) {}
          throw new Error(message);
        }
        const blob = await response.blob();
        const disposition = response.headers.get('Content-Disposition') || '';
        const match = disposition.match(/filename="?([^"]+)"?/i);
        const fileName = match?.[1] || `report-matrix-${matrixState.assignmentId}-pdf.zip`;
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = fileName;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
        matrixPdfModal?.hide();
      } catch (error) {
        await showReportMatrixMessage({
          title: 'Export Failed',
          icon: 'error',
          message: error?.message || 'Unable to export PDF files.'
        });
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = original;
        }
      }
    });

    window.addEventListener('beforeunload', (event) => {
      if (!sharedDirty && dirtyStudents.size === 0) return;
      event.preventDefault();
      event.returnValue = '';
    });
    recalculateAllRows();
    initializeTooltips();
    bindMatrixColumnHeaderTips();
  })();
</script>

<div class="modal fade" id="matrixDocxExportModal" tabindex="-1" aria-labelledby="matrixDocxExportModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="matrixDocxExportModalLabel">Export Word reports</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <div class="fw-semibold mb-2">Export mode</div>
          <div class="form-check">
            <input class="form-check-input" type="radio" name="matrixDocxExportMode" id="matrixDocxModeConsolidated" value="consolidated" checked>
