  function showConfigWarning(message) {
    const el = document.getElementById('smmrConfigAlert');
    if (!el) return;
    if (!message) {
      el.classList.add('d-none');
      el.textContent = '';
      return;
    }
    el.textContent = message;
    el.classList.remove('d-none');
  }

  async function loadSemiMonthlyReport() {
    const startDate = String(document.getElementById('filter_startDate').value || '').trim();
    const endDate = String(document.getElementById('filter_endDate').value || '').trim();
    const studentIds = selectedStudents.map((row) => String(row.studentRecordId || row.id || '').trim()).filter(Boolean);
    if (!studentIds.length) {
      showReportMessage({ icon: 'warning', message: 'Select at least one student.' });
      return;
    }
    if (!startDate || !endDate) {
      showReportMessage({ icon: 'warning', message: 'Start date and end date are required.' });
      return;
    }

    const loadBtn = document.getElementById('btn_loadData');
    const loadBtnHtml = loadBtn?.innerHTML;
    if (loadBtn) {
      loadBtn.disabled = true;
      loadBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>';
    }

    try {
      const params = new URLSearchParams();
      params.set('startDate', startDate);
      params.set('endDate', endDate);
      params.set('studentIds', studentIds.join(','));
      const response = await fetch(`/school/reports/semi-monthly/api/data?${params.toString()}`, {
        headers: { 'X-AJAX-Request': 'true' }
      });
      const payload = await response.json();
      if (payload.status !== 'success') {
        throw new Error(payload.message || 'Could not load semi-monthly report.');
      }
      showConfigWarning(payload.configurationWarning || '');
      const students = Array.isArray(payload.students) ? payload.students : [];
      const container = document.getElementById('studentReportSections');
      container.innerHTML = students.length
        ? students.map((student) => buildStudentSection(student, payload.startDate || startDate, payload.endDate || endDate)).join('')
        : '<p class="text-muted mb-0">No enrolled classes found for the selected students and date range.</p>';
      document.getElementById('resultsContainer').classList.remove('d-none');
      syncShareUrl();
    } catch (error) {
      showReportMessage({ icon: 'error', message: error.message || 'Load failed.' });
    } finally {
      if (loadBtn) {
        loadBtn.disabled = false;
        if (loadBtnHtml) loadBtn.innerHTML = loadBtnHtml;
      }
    }
  }

  function getFilterParams() {
    return {
      startDate: String(document.getElementById('filter_startDate').value || '').trim(),
      endDate: String(document.getElementById('filter_endDate').value || '').trim(),
      studentIds: selectedStudents.map((row) => String(row.studentRecordId || row.id || '').trim()).filter(Boolean)
    };
  }

  function validateSmmrFilters() {
    const filters = getFilterParams();
    if (!filters.studentIds.length) {
      showReportMessage({ icon: 'warning', message: 'Select at least one student.' });
      return null;
    }
    if (!filters.startDate || !filters.endDate) {
      showReportMessage({ icon: 'warning', message: 'Start date and end date are required.' });
      return null;
    }
    return filters;
  }

  function findSmmrExportStudent(personId) {
    return (smmrExportPlan?.students || []).find((row) => String(row.personId || '').trim() === String(personId || '').trim()) || null;
  }

  function getSmmrOverallOptions(student = {}) {
    if (Array.isArray(student.overallOptions) && student.overallOptions.length) return student.overallOptions;
    return student.overall ? [student.overall] : [];
  }

  function buildSmmrFormatButtons(row = {}, exportType = 'instance') {
    const personId = String(row.personId || row.studentId || '').trim();
    const instanceId = String(row.instanceId || '').trim();
    const overallTemplateId = String(row.templateId || '').trim();
    const idAttr = exportType === 'overall'
      ? `data-overall-template-id="${escapeHtml(overallTemplateId)}"`
      : `data-instance-id="${escapeHtml(instanceId)}"`;
    const parts = [];
    if (row.hasDocx) parts.push(`<button type="button" class="btn btn-outline-primary btn-sm py-0 js-smmr-row-export" data-format="docx" data-export-type="${exportType}" data-student-id="${escapeHtml(personId)}" ${idAttr}>DOCX</button>`);
    if (row.hasPdf) parts.push(`<button type="button" class="btn btn-outline-danger btn-sm py-0 js-smmr-row-export" data-format="pdf" data-export-type="${exportType}" data-student-id="${escapeHtml(personId)}" ${idAttr}>PDF</button>`);
    if (row.hasPayload !== false) parts.push(`<button type="button" class="btn btn-outline-secondary btn-sm py-0 js-smmr-row-export" data-format="json" data-export-type="${exportType}" data-student-id="${escapeHtml(personId)}" ${idAttr}>JSON</button>`);
    return parts.length ? `<div class="d-flex flex-wrap gap-1 mt-1">${parts.join('')}</div>` : '';
  }

  function renderSmmrExportPlan(plan = {}) {
    smmrExportPlan = plan;
    const students = Array.isArray(plan.students) ? plan.students : [];
    const hasOverall = Array.isArray(plan.overallReportTemplates) && plan.overallReportTemplates.length > 0;
    const exportableCount = students.reduce((sum, student) => sum + (student.instances || []).filter((row) => row.exportable).length, 0);
    document.getElementById('smmrExportEmpty')?.classList.toggle('d-none', exportableCount > 0 || hasOverall);
    document.getElementById('smmrExportTableWrap')?.classList.toggle('d-none', !students.length);
    document.getElementById('smmrExportOverallHeader')?.classList.toggle('d-none', !hasOverall);
    document.getElementById('smmrExportOverallBulkPanel')?.classList.toggle('d-none', !hasOverall);
    const body = document.getElementById('smmrExportTableBody');
    if (!body) return;
    body.innerHTML = students.map((student) => {
      const personId = String(student.personId || '').trim();
      const instanceBlocks = (student.instances || []).map((row) => {
        if (!row.exportable) return '';
        const label = `${row.className || row.classId} · ${row.templateTitle || row.templateId} · ${row.sessionDate || '—'}`;
        return `
          <div class="smmr-export-instance-row">
            <div class="d-flex gap-2 align-items-start">
              <input type="checkbox" class="form-check-input mt-1 js-smmr-export-check" data-export-type="instance" data-student-id="${escapeHtml(personId)}" data-instance-id="${escapeHtml(row.instanceId)}" checked>
              <div class="flex-grow-1 min-w-0">
                <div class="small fw-semibold">${escapeHtml(label)}</div>
                ${buildSmmrFormatButtons({ ...row, personId }, 'instance')}
              </div>
            </div>
          </div>`;
      }).join('') || '<div class="small text-muted py-2">No exportable instances.</div>';

      const overallCell = hasOverall ? (() => {
        const options = getSmmrOverallOptions(student).filter((opt) => opt?.defined);
        const eligible = options.filter((opt) => opt.eligible);
        const selected = eligible[0] || options[0] || null;
        const selectHtml = eligible.length
          ? eligible.map((opt) => `<option value="${escapeHtml(opt.templateId)}">${escapeHtml(opt.templateTitle || opt.templateId)}</option>`).join('')
          : '<option value="">No eligible overall template</option>';
        return `
          <td class="align-top js-smmr-overall-cell" data-student-id="${escapeHtml(personId)}">
            <div class="d-flex gap-2 align-items-start">
              <input type="checkbox" class="form-check-input mt-1 js-smmr-export-check" data-export-type="overall" data-student-id="${escapeHtml(personId)}" data-overall-template-id="${escapeHtml(selected?.templateId || '')}" ${selected?.eligible ? 'checked' : 'disabled'}>
              <div class="flex-grow-1">
                <select class="form-select form-select-sm js-smmr-overall-template-select mb-1" data-student-id="${escapeHtml(personId)}" ${eligible.length <= 1 ? 'disabled' : ''}>${selectHtml}</select>
                ${selected?.eligible ? buildSmmrFormatButtons({ ...selected, personId, studentId: personId }, 'overall') : `<div class="small text-warning">${escapeHtml((selected?.warnings || []).join(' ') || 'Overall not available.')}</div>`}
              </div>
            </div>
          </td>`;
      })() : '';

      return `
        <tr data-student-id="${escapeHtml(personId)}">
          <td class="smmr-export-student-col ps-3 fw-semibold align-top">${escapeHtml(student.name || personId)}</td>
          <td class="align-top">${instanceBlocks}</td>
          ${overallCell}
        </tr>`;
    }).join('');
  }

  function gatherSmmrExportTargets(format = '', scope = 'all') {
    const root = document.getElementById('smmrExportModal');
    if (!root) return [];
    const normalizedFormat = String(format || '').trim().toLowerCase();
    const normalizedScope = String(scope || 'all').trim().toLowerCase();
    const targets = [];
    const includeInstance = normalizedScope === 'all' || normalizedScope === 'instance';
    const includeOverall = normalizedScope === 'all' || normalizedScope === 'overall';

    if (includeInstance) {
      root.querySelectorAll('.js-smmr-export-check[data-export-type="instance"]:checked').forEach((checkbox) => {
        const studentId = String(checkbox.getAttribute('data-student-id') || '').trim();
        const instanceId = String(checkbox.getAttribute('data-instance-id') || '').trim();
        const student = findSmmrExportStudent(studentId);
        const row = (student?.instances || []).find((item) => String(item.instanceId || '').trim() === instanceId);
        if (!studentId || !instanceId || !row) return;
        if (normalizedFormat === 'docx' && !row.hasDocx) return;
        if (normalizedFormat === 'pdf' && !row.hasPdf) return;
        if (normalizedFormat === 'json' && row.hasPayload === false) return;
        targets.push({ type: 'instance', studentId, instanceId });
      });
    }

    if (includeOverall) {
      root.querySelectorAll('.js-smmr-export-check[data-export-type="overall"]:checked:not(:disabled)').forEach((checkbox) => {
        const studentId = String(checkbox.getAttribute('data-student-id') || '').trim();
        const cell = checkbox.closest('.js-smmr-overall-cell');
        const overallTemplateId = String(cell?.querySelector('.js-smmr-overall-template-select')?.value || checkbox.getAttribute('data-overall-template-id') || '').trim();
        const student = findSmmrExportStudent(studentId);
        const option = getSmmrOverallOptions(student).find((row) => String(row.templateId || '').trim() === overallTemplateId);
        if (!overallTemplateId || !option?.eligible) return;
        if (normalizedFormat === 'docx' && !option.hasDocx) return;
        if (normalizedFormat === 'pdf' && !option.hasPdf) return;
        if (normalizedFormat === 'json' && option.hasPayload === false) return;
        targets.push({ type: 'overall', studentId, overallTemplateId });
      });
    }
    return targets;
  }

  async function runSmmrExport(format, targets = []) {
    const filters = validateSmmrFilters();
    if (!filters) return;
    if (!targets.length) {
      showReportMessage({ icon: 'warning', message: 'Select at least one export that supports this format.' });
      return;
    }
    const loadingToken = typeof window.showLoading === 'function'
      ? window.showLoading({ title: 'Exporting Reports', note: 'Generating files…', operation: 'Export' })
      : null;
    try {
      const response = await fetch('/school/reports/semi-monthly/api/export', {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded',
          Accept: 'application/octet-stream, application/json',
          'X-AJAX-Request': 'true'
        },
        body: new URLSearchParams({
          actionStateId: smmrActionStateId,
          startDate: filters.startDate,
          endDate: filters.endDate,
          studentIds: filters.studentIds.join(','),
          format: String(format || 'json'),
          targets: JSON.stringify(targets)
        }).toString()
      });
      if (!response.ok) {
        const payload = await response.json().catch(() => null);
        throw new Error(payload?.message || `Export failed (${response.status}).`);
      }
      const blob = await response.blob();
      if (!blob || blob.size === 0) throw new Error('Export returned an empty file.');
      const disposition = response.headers.get('Content-Disposition') || '';
      const fileNameMatch = disposition.match(/filename="([^"]+)"/i);
      const fileName = fileNameMatch?.[1] || `semi_monthly_export_${filters.startDate}_${filters.endDate}`;
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = fileName;
      document.body.appendChild(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
      showReportMessage({ icon: 'success', message: 'Export downloaded successfully.' });
    } catch (error) {
      showReportMessage({ icon: 'error', message: error.message || 'Export failed.' });
    } finally {
      if (loadingToken && typeof window.hideLoading === 'function') window.hideLoading(loadingToken);
    }
  }

  async function openSmmrExportPanel() {
    if (!canExportReport || configuredTemplateCount <= 0) return;
    const filters = validateSmmrFilters();
    if (!filters) return;
    const modalEl = document.getElementById('smmrExportModal');
    if (!modalEl || !window.bootstrap?.Modal) return;
    window.bootstrap.Modal.getOrCreateInstance(modalEl).show();
    document.getElementById('smmrExportLoading')?.classList.remove('d-none');
    document.getElementById('smmrExportEmpty')?.classList.add('d-none');
    document.getElementById('smmrExportTableWrap')?.classList.add('d-none');
    const dateRangeEl = document.getElementById('smmrExportDateRange');
    if (dateRangeEl) dateRangeEl.textContent = `${filters.startDate} → ${filters.endDate} · loading…`;
    try {
      const params = new URLSearchParams();
      params.set('startDate', filters.startDate);
      params.set('endDate', filters.endDate);
      params.set('studentIds', filters.studentIds.join(','));
      const response = await fetch(`/school/reports/semi-monthly/api/export-plan?${params.toString()}`, {
        credentials: 'same-origin',
        headers: { 'X-AJAX-Request': 'true' }
      });
      const payload = await response.json();
      if (!response.ok || payload.status !== 'success') {
        throw new Error(payload.message || 'Could not load export options.');
      }
      if (dateRangeEl) dateRangeEl.textContent = `${filters.startDate} → ${filters.endDate}`;
      renderSmmrExportPlan(payload.plan || {});
    } catch (error) {
      showReportMessage({ icon: 'error', message: error.message || 'Could not load export options.' });
    } finally {
      document.getElementById('smmrExportLoading')?.classList.add('d-none');
    }
  }

  function syncShareUrl() {
    if (!window.history?.replaceState) return;
    const { startDate, endDate, studentIds } = getFilterParams();
    const url = new URL(window.location.pathname, window.location.origin);
    if (startDate) url.searchParams.set('startDate', startDate);
    if (endDate) url.searchParams.set('endDate', endDate);
    if (studentIds.length) url.searchParams.set('studentIds', studentIds.join(','));
    const nextUrl = url.pathname + url.search;
    if (window.location.pathname + window.location.search !== nextUrl) {
      window.history.replaceState({}, document.title, nextUrl);
    }
  }

  async function copyShareLink() {
    const { studentIds, startDate, endDate } = getFilterParams();
    if (!studentIds.length) {
      showReportMessage({ icon: 'warning', message: 'Select at least one student before copying a link.' });
      return;
    }
    if (!startDate || !endDate) {
      showReportMessage({ icon: 'warning', message: 'Set a start and end date before copying a link.' });
      return;
    }
    const url = new URL('/school/reports/semi-monthly', window.location.origin);
    url.searchParams.set('startDate', startDate);
    url.searchParams.set('endDate', endDate);
    url.searchParams.set('studentIds', studentIds.join(','));
    syncShareUrl();
    try {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(url.toString());
      } else {
        const input = document.createElement('textarea');
        input.value = url.toString();
        input.setAttribute('readonly', '');
        input.style.position = 'fixed';
        input.style.left = '-9999px';
        document.body.appendChild(input);
        input.select();
        document.execCommand('copy');
        input.remove();
      }
      showReportMessage({
        icon: 'success',
        message: 'Shareable link copied. Anyone with access can open it to view the same students and date range.'
      });
    } catch (error) {
      showReportMessage({ icon: 'error', message: error.message || 'Could not copy the link.' });
    }
  }

  function setAllStudentSectionsExpanded(expanded) {
    document.querySelectorAll('.student-report-card .student-report-collapse').forEach((sectionEl) => {
      if (window.bootstrap?.Collapse) {
        const collapse = window.bootstrap.Collapse.getOrCreateInstance(sectionEl, { toggle: false });
        if (expanded) collapse.show();
        else collapse.hide();
      } else {
        sectionEl.classList.toggle('show', expanded);
      }
      const toggleBtn = document.querySelector(`[data-bs-target="#${sectionEl.id}"]`);
      if (toggleBtn) toggleBtn.setAttribute('aria-expanded', expanded ? 'true' : 'false');
    });
  }

  document.getElementById('studentReportSections')?.addEventListener('click', (event) => {
    const matrixTrigger = event.target.closest('[data-sar-matrix-url]');
    if (!matrixTrigger) return;
    event.preventDefault();
    confirmOpenAttendanceMatrix(matrixTrigger.getAttribute('data-sar-matrix-url'));
  });

  document.getElementById('btn_openStudentPicker')?.addEventListener('click', openStudentPicker);
  document.getElementById('btn_openSchoolStudentPicker')?.addEventListener('click', openHierarchicalStudentPicker);
  document.getElementById('btn_clearStudents')?.addEventListener('click', () => {
    selectedStudents = [];
    renderSelectedStudents();
    document.getElementById('studentReportSections').innerHTML = '';
    document.getElementById('resultsContainer').classList.add('d-none');
    showConfigWarning('');
  });
  document.getElementById('btn_loadData')?.addEventListener('click', () => {
    loadSemiMonthlyReport().catch((error) => showReportMessage({ icon: 'error', message: error.message || 'Load failed.' }));
  });
  document.getElementById('btn_copyReportLink')?.addEventListener('click', () => {
    copyShareLink().catch((error) => showReportMessage({ icon: 'error', message: error.message || 'Could not copy link.' }));
  });
  document.getElementById('btn_exportSmmr')?.addEventListener('click', () => {
    openSmmrExportPanel().catch((error) => showReportMessage({ icon: 'error', message: error.message || 'Export failed.' }));
  });
  document.getElementById('smmrExportModal')?.addEventListener('click', (event) => {
    const rowBtn = event.target.closest('.js-smmr-row-export');
    if (rowBtn) {
      event.preventDefault();
      const format = String(rowBtn.getAttribute('data-format') || 'json').trim().toLowerCase();
      const exportType = String(rowBtn.getAttribute('data-export-type') || '').trim().toLowerCase();
      const studentId = String(rowBtn.getAttribute('data-student-id') || '').trim();
      const targets = [];
      if (exportType === 'instance') {
        const instanceId = String(rowBtn.getAttribute('data-instance-id') || '').trim();
        if (studentId && instanceId) targets.push({ type: 'instance', studentId, instanceId });
      } else if (exportType === 'overall') {
        const cell = rowBtn.closest('.js-smmr-overall-cell');
        const overallTemplateId = String(
          rowBtn.getAttribute('data-overall-template-id')
          || cell?.querySelector('.js-smmr-overall-template-select')?.value
          || ''
        ).trim();
        if (studentId && overallTemplateId) targets.push({ type: 'overall', studentId, overallTemplateId });
      }
      runSmmrExport(format, targets);
      return;
    }
    const bulkBtn = event.target.closest('.js-smmr-bulk-export');
    if (bulkBtn) {
      event.preventDefault();
      const format = String(bulkBtn.getAttribute('data-format') || 'json').trim().toLowerCase();
      const scope = String(bulkBtn.getAttribute('data-export-scope') || 'all').trim().toLowerCase();
      runSmmrExport(format, gatherSmmrExportTargets(format, scope));
    }
  });
  document.getElementById('smmrExportModal')?.addEventListener('change', (event) => {
    const select = event.target.closest('.js-smmr-overall-template-select');
    if (!select) return;
    const studentId = String(select.getAttribute('data-student-id') || '').trim();
    const cell = select.closest('.js-smmr-overall-cell');
    const checkbox = cell?.querySelector('.js-smmr-export-check[data-export-type="overall"]');
    const templateId = String(select.value || '').trim();
    const student = findSmmrExportStudent(studentId);
    const option = getSmmrOverallOptions(student).find((row) => String(row.templateId || '').trim() === templateId);
    if (checkbox) {
      checkbox.setAttribute('data-overall-template-id', templateId);
      checkbox.disabled = !option?.eligible;
      checkbox.checked = Boolean(option?.eligible);
    }
  });
  document.getElementById('btn_expandAllStudents')?.addEventListener('click', () => setAllStudentSectionsExpanded(true));
  document.getElementById('btn_collapseAllStudents')?.addEventListener('click', () => setAllStudentSectionsExpanded(false));
  document.getElementById('btn_reset')?.addEventListener('click', () => {
    document.getElementById('filter_startDate').value = '';
    document.getElementById('filter_endDate').value = '';
    document.querySelectorAll('.btn-range').forEach((btn) => btn.classList.remove('active'));
  });
  document.querySelectorAll('.btn-range').forEach((btn) => {
    btn.addEventListener('click', () => applyQuickRange(btn.getAttribute('data-range')));
  });
  document.getElementById('filter_startDate')?.addEventListener('change', syncShareUrl);
  document.getElementById('filter_endDate')?.addEventListener('change', syncShareUrl);

  if (initialStartDate) document.getElementById('filter_startDate').value = initialStartDate;
  if (initialEndDate) document.getElementById('filter_endDate').value = initialEndDate;
  if (initialStudents.length) {
    selectedStudents = initialStudents.map((row) => ({
      id: String(row.studentRecordId || '').trim(),
      studentRecordId: String(row.studentRecordId || '').trim(),
      personId: String(row.personId || '').trim(),
      name: String(row.name || row.studentRecordId || '').trim()
    })).filter((row) => row.studentRecordId);
  } else if (initialStudentIds.length) {
    selectedStudents = initialStudentIds.map((id) => ({ id, studentRecordId: id, name: `Student ${id}` }));
  }
  renderSelectedStudents();
  syncShareUrl();

  if ((initialStudents.length || initialStudentIds.length) && initialStartDate && initialEndDate) {
    loadSemiMonthlyReport();
  }
})();
</script>
