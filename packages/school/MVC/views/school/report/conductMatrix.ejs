<style>
  .cm-matrix-wrapper { max-height: min(70vh, 720px); overflow: auto; border: 1px solid #dee2e6; border-radius: 12px; box-shadow: 0 0.15rem 0.5rem rgba(15, 23, 42, 0.05); }
  .cm-matrix-table th { position: sticky; top: 0; z-index: 2; background-color: #f8f9fa; vertical-align: bottom; font-size: 0.78rem; }
  .cm-matrix-table th.cm-sticky-name,
  .cm-matrix-table td.cm-sticky-name {
    position: sticky; left: 0; z-index: 3; min-width: 140px; max-width: 180px;
    border-right: 2px solid #dee2e6; background-color: #fff; font-weight: 600;
    box-shadow: 2px 0 2px -1px rgba(0, 0, 0, 0.06);
  }
  .cm-matrix-table th.cm-sticky-name { background-color: #f8f9fa; z-index: 4; }
  .cm-matrix-table th.cm-col-disabled,
  .cm-matrix-table td.cm-col-disabled { opacity: 0.35; pointer-events: none; }
  .cm-matrix-cell { text-align: center; vertical-align: middle; min-width: 72px; cursor: pointer; font-size: 0.75rem; font-weight: 600; }
  .cm-matrix-cell.cm-empty { color: #adb5bd; font-weight: 400; cursor: default; }
  .cm-matrix-cell.cm-editable:hover { background-color: #f1f3f5; }
  .cm-matrix-cell.cm-not-roster { cursor: not-allowed; color: #dee2e6; }
  .cm-col-toggle { font-size: 0.7rem; }
  .cm-col-toggle input:disabled + span { opacity: 0.85; }
  .schedule-shell .filter-panel {
    background: linear-gradient(145deg, #edf5ff 0%, #f8fbff 100%);
    border: 1px solid #dce9ff;
    border-radius: 14px;
  }
  .schedule-shell .range-chip.active { box-shadow: 0 0 0 2px rgba(13, 110, 253, 0.15); }
</style>

<%
  const dashHref = typeof schoolSectionDashboardHref === 'string' && schoolSectionDashboardHref
    ? schoolSectionDashboardHref
    : '/dashboard/section-nav/SCHOOL';
  const cmManageBtns = [];
  if (typeof canOpenAttendanceMatrix !== 'undefined' && canOpenAttendanceMatrix) {
    cmManageBtns.push('<a href="/school/attendances" class="btn btn-outline-primary btn-md mb-2"><i class="bi bi-grid-3x3 me-1"></i> Attendance Matrix</a>');
  }
  cmManageBtns.push('<a href="/school/grades-matrix" class="btn btn-outline-primary btn-md mb-2"><i class="bi bi-table me-1"></i> Grades Matrix</a>');
%>

<%- include('partials/tablePages-start', {
  title,
  newUrl: null,
  newLabel: null,
  user,
  tableName: typeof tableName !== 'undefined' ? tableName : 'Class_Conduct_Matrix',
  btn_export: false,
  print: false,
  headerManageBtns: [
    '<a href="' + dashHref + '" class="school-navigator-dashboard btn btn-filled btn-secondary btn-md mb-2"><i class="bi bi-speedometer2 me-1"></i> School Dashboard</a>',
    '<a href="/dashboard/section-nav/SCHOOL_ACADEMIA" class="school-navigator-dashboard btn btn-filled btn-secondary btn-md mb-2"><i class="bi bi-journal-bookmark me-1"></i> School Academia</a>'
  ],
  manageBtns: cmManageBtns
}) %>

<div class="schedule-shell">
  <p class="text-muted small mb-3">View class conduct across sessions for one class. Cells show ratings only where a teacher saved conduct for that student on that session. Optional sessions can be hidden with the column toggle; sessions that require conduct before reports stay enabled.</p>

  <div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-white d-flex align-items-center justify-content-between py-2 px-3">
      <div class="fw-bold text-dark"><i class="bi bi-funnel me-2"></i>Filter Class Conduct Matrix</div>
      <button id="cmFilterToggleBtn" type="button" class="btn btn-outline-secondary btn-sm px-2" data-bs-toggle="collapse" data-bs-target="#cmFilterCollapse" aria-expanded="true" aria-controls="cmFilterCollapse">
        <i id="cmFilterToggleIcon" class="bi bi-chevron-up"></i>
      </button>
    </div>
    <div class="collapse show" id="cmFilterCollapse">
      <div class="card-body filter-panel p-3">
        <div class="row g-3 align-items-end">
          <div class="col-lg-4 col-md-6">
            <label class="form-label" for="cm_className">Class</label>
            <div class="input-group">
              <input type="hidden" id="cm_classId">
              <input type="text" id="cm_className" class="form-control bg-white" placeholder="Select class..." readonly>
              <button type="button" class="btn btn-outline-primary" id="cm_btnClassPicker" title="Select class"><i class="bi bi-book"></i></button>
              <button type="button" class="btn btn-outline-secondary" id="cm_btnClearClass" title="Clear class"><i class="bi bi-x-lg"></i></button>
            </div>
          </div>
          <div class="col-lg-2 col-md-3">
            <label class="form-label" for="cm_startDate">Start Date</label>
            <input type="date" id="cm_startDate" class="form-control size-md">
          </div>
          <div class="col-lg-2 col-md-3">
            <label class="form-label" for="cm_endDate">End Date</label>
            <input type="date" id="cm_endDate" class="form-control size-md">
          </div>
          <div class="col-12 col-lg-auto d-flex gap-2">
            <button type="button" id="cm_btnReset" class="btn btn-outline-secondary btn-md">Reset</button>
            <button type="button" id="cm_btnLoad" class="btn btn-filled btn-primary btn-md"><i class="bi bi-funnel me-1"></i> Apply</button>
          </div>
        </div>
        <div class="border rounded-3 bg-white bg-opacity-75 p-2 mt-3">
          <div class="small fw-bold text-uppercase text-muted mb-2">Quick Ranges</div>
          <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm cm-range range-chip" data-range="thisMonth">This Month</button>
            <button type="button" class="btn btn-outline-secondary btn-sm cm-range range-chip" data-range="thisWeek">This Week</button>
            <button type="button" class="btn btn-outline-secondary btn-sm cm-range range-chip" data-range="allTime">All Dates</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card border-0 shadow-sm d-none" id="cm_results">
    <div class="card-header bg-white border-bottom py-3">
      <h5 class="m-0 fw-bold text-primary" id="cm_classTitle">Class</h5>
      <div class="small text-muted mt-1">Click a cell to add or edit conduct (when the session column is enabled). Format: Effort / Participation / Teachers / Students.</div>
    </div>
    <div class="card-body p-0">
      <div class="cm-matrix-wrapper">
        <table class="table table-hover table-bordered mb-0 cm-matrix-table" id="cm_table">
          <thead id="cm_thead"></thead>
          <tbody id="cm_tbody"></tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="cmCellModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title fw-bold"><i class="bi bi-emoji-smile me-2"></i>Class conduct</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="mb-2"><span class="text-muted small">Student</span><div class="fw-semibold" id="cmModalStudent">—</div></div>
        <div class="mb-3"><span class="text-muted small">Session</span><div class="fw-semibold" id="cmModalSession">—</div></div>
        <div id="cmModalDimensionFields"></div>
        <div class="form-check mt-3 d-none" id="cmModalReadyWrap">
          <input class="form-check-input" type="checkbox" id="cmModalReady">
          <label class="form-check-label" for="cmModalReady">Mark session ready for reports</label>
        </div>
      </div>
      <div class="modal-footer bg-light">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="cmModalSave"><i class="bi bi-check2-circle me-1"></i>Save</button>
      </div>
    </div>
  </div>
</div>

<%- include('partials/tablePages-end') %>

<script>
  window.__conductRatingScalePolicy = <%- JSON.stringify(typeof conductRatingScaleResolved !== 'undefined' ? conductRatingScaleResolved : { levels: [] }).replace(/</g, '\\u003c') %>;
  window.__conductMatrixInitial = <%- JSON.stringify({
    classId: typeof initialClassId !== 'undefined' ? initialClassId : '',
    className: typeof initialClassName !== 'undefined' ? initialClassName : '',
    startDate: typeof initialStartDate !== 'undefined' ? initialStartDate : '',
    endDate: typeof initialEndDate !== 'undefined' ? initialEndDate : '',
    range: typeof initialRange !== 'undefined' ? initialRange : '',
    actionStateId: typeof actionStateId !== 'undefined' ? actionStateId : ''
  }).replace(/</g, '\\u003c').replace(/&/g, '\\u0026') %>;
</script>
<script src="/scripts/conductMatrixClient.js"></script>
