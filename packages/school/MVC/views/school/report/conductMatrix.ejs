<style>
  .cm-matrix-wrapper { max-height: min(70vh, 720px); overflow: auto; border: 1px solid #dee2e6; border-radius: 12px; box-shadow: 0 0.15rem 0.5rem rgba(15, 23, 42, 0.05); }
  .attendance-legend-icon-btn {
    width: 2.25rem; height: 2.25rem; padding: 0;
    display: inline-flex; align-items: center; justify-content: center; line-height: 1;
  }
  .attendance-legend-icon-btn .bi { font-size: 1.05rem; line-height: 1; }
  .cm-session-view-btn.active {
    color: #0d6efd; border-color: #0d6efd; background-color: rgba(13, 110, 253, 0.08);
  }
  .cm-matrix-table th { position: sticky; top: 0; z-index: 2; background-color: #f8f9fa; vertical-align: bottom; font-size: 0.78rem; box-shadow: 0 2px 2px -1px rgba(0, 0, 0, 0.1); }
  .cm-matrix-table th.cm-sticky-rollup,
  .cm-matrix-table td.cm-sticky-rollup {
    position: sticky; left: 0; z-index: 3; width: 96px; min-width: 96px; max-width: 96px;
    border-right: 1px solid #dee2e6; background-color: #f8f9fa; vertical-align: middle;
  }
  .cm-matrix-table td.cm-sticky-rollup { background-color: #fff; z-index: 2; }
  .cm-matrix-table th.cm-sticky-name,
  .cm-matrix-table td.cm-sticky-name {
    position: sticky; left: 96px; z-index: 3; min-width: 148px; max-width: 220px;
    border-right: 2px solid #dee2e6; background-color: #fff; font-weight: 600;
    box-shadow: 2px 0 2px -1px rgba(0, 0, 0, 0.06);
  }
  .cm-matrix-table th.cm-sticky-name { background-color: #f8f9fa; z-index: 4; }
  .cm-matrix-table tbody tr.cm-student-row:nth-child(even) td:not(.cm-col-disabled) { background-color: #f8fafc; }
  .cm-matrix-table tbody tr.cm-student-row:nth-child(even) td.cm-sticky-rollup,
  .cm-matrix-table tbody tr.cm-student-row:nth-child(even) td.cm-sticky-name { background-color: #f8fafc; }
  .cm-matrix-table th.cm-col-disabled,
  .cm-matrix-table td.cm-col-disabled { opacity: 0.35; pointer-events: none; background: #f8f9fa; }
  .cm-matrix-table th.att-cell {
    text-align: center; vertical-align: middle; min-width: 80px; position: relative;
    transition: background-color 0.2s; font-weight: 700;
  }
  .cm-matrix-table th.att-cell:hover { background-color: #f1f3f5; }
  .cm-matrix-table th.cm-session-col { padding: 0.35rem 0.25rem !important; vertical-align: middle; }
  .cm-matrix-table th.cm-session-col.cm-day-start,
  .cm-matrix-table td.cm-day-start {
    border-left: 1px solid #e2e8f0;
    box-shadow: inset 1px 0 0 rgba(255, 255, 255, 0.65);
  }
  .cm-session-header-date {
    display: block; cursor: pointer; color: var(--bs-primary, #0d6efd);
    font-size: 0.875em; font-weight: 700; text-decoration: underline;
  }
  .cm-col-toggle { font-size: 0.68rem; white-space: nowrap; font-weight: 400; text-decoration: none; }
  .cm-matrix-cell { text-align: center; vertical-align: middle; min-width: 88px; cursor: pointer; font-size: 0.72rem; padding: 0.35rem 0.2rem !important; }
  .cm-matrix-cell.cm-empty .cm-cell-empty-mark { color: #adb5bd; font-weight: 400; }
  .cm-matrix-cell.cm-editable:hover { background-color: #f1f3f5; }
  .cm-matrix-cell.cm-not-roster { cursor: not-allowed; }
  .cm-cell-off-roster { color: #dee2e6; font-size: 1.1rem; }
  .cm-cell-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.15rem 0.25rem; justify-items: center; }
  .cm-dim-chip {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 1.65rem; padding: 0.06rem 0.22rem; border-radius: 0.25rem;
    background: #e9ecef; font-weight: 700; font-size: 0.65rem; line-height: 1.2;
  }
  .cm-dim-chip-empty { background: transparent; color: #ced4da; font-weight: 400; }
  .cm-dim-chip.cm-code-s { background-color: #198754; color: #fff; border: 1px solid #157347; }
  .cm-dim-chip.cm-code-sat { background-color: #c5f135; color: #1a3d0a; border: 1px solid #a8d42a; }
  .cm-dim-chip.cm-code-ni { background-color: #fd7e14; color: #fff; border: 1px solid #e96b00; }
  .cm-dim-chip.cm-code-u { background-color: #dc3545; color: #fff; border: 1px solid #bb2d3b; }
  .cm-dim-chip.cm-code-na { background-color: #fff; color: #495057; border: 1px solid #ced4da; font-weight: 600; }
  .cm-col-toggle input:disabled + .cm-col-toggle-label { font-weight: 600; color: #084298; }
  .cm-conduct-legend { display: flex; flex-wrap: wrap; gap: 0.35rem; font-size: 0.68rem; }
  .cm-conduct-legend .cm-legend-item { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.1rem 0.35rem; border: 1px solid #dee2e6; border-radius: 999px; background: #fff; }
  .cm-modal-context-banner { background: linear-gradient(145deg, #f8f9fa 0%, #fff 100%); }
  .cm-modal-dim-card .conduct-emoji-picker { display: flex; flex-wrap: wrap; gap: 0.25rem; justify-content: center; margin-bottom: 0.5rem; }
  #cmCellModal .conduct-emoji-picker { display: flex; flex-wrap: wrap; gap: 0.2rem; justify-content: center; margin-bottom: 0.35rem; }
  #cmCellModal .conduct-code-btn {
    min-width: 1.85rem; padding: 0.12rem 0.28rem; font-size: 0.72rem; font-weight: 700;
    border: 1px solid #ced4da; border-radius: 0.35rem; background: #fff;
  }
  #cmCellModal .conduct-code-btn.active { background: #0d6efd; border-color: #0d6efd; color: #fff; }
  #cmCellModal .conduct-code-btn[data-code="S"].active { background: #198754; border-color: #157347; }
  #cmCellModal .conduct-code-btn[data-code="Sat"].active { background: #c5f135; border-color: #a8d42a; color: #1a3d0a; }
  #cmCellModal .conduct-code-btn[data-code="NI"].active { background: #fd7e14; border-color: #e96b00; }
  #cmCellModal .conduct-code-btn[data-code="U"].active { background: #dc3545; border-color: #bb2d3b; }
  #cmCellModal .conduct-percent-input { max-width: 5.5rem; margin: 0 auto; text-align: center; }
  .schedule-shell .filter-panel {
    background: linear-gradient(145deg, #edf5ff 0%, #f8fbff 100%);
    border: 1px solid #dce9ff;
    border-radius: 14px;
  }
  .schedule-shell .range-chip.active { box-shadow: 0 0 0 2px rgba(13, 110, 253, 0.15); }
  .cm-filter-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-left: auto;
  }
  .cm-filter-actions .cm-filter-action-btn {
    width: 7.25rem;
    justify-content: center;
  }
</style>
<link rel="stylesheet" href="/styles/schedule-viewer.css">
<link rel="stylesheet" href="/styles/school-matrix-expand.css">

<%
  const dashHref = typeof schoolSectionDashboardHref === 'string' && schoolSectionDashboardHref
    ? schoolSectionDashboardHref
    : '/dashboard/section-nav/SCHOOL';
  const cmManageBtns = [];
  if (typeof canOpenAttendanceMatrix !== 'undefined' && canOpenAttendanceMatrix) {
    cmManageBtns.push('<a href="/school/attendances" class="btn btn-outline-primary btn-md mb-2"><i class="bi bi-grid-3x3 me-1"></i> Attendance Matrix</a>');
  }
  cmManageBtns.push('<a href="/school/grades-matrix" class="btn btn-outline-primary btn-md mb-2"><i class="bi bi-table me-1"></i> Grades Matrix</a>');
  cmManageBtns.push('<a href="/school/class-conduct-report" class="btn btn-outline-primary btn-md mb-2"><i class="bi bi-clipboard2-data me-1"></i> Class Conduct Report</a>');
  cmManageBtns.push('<a href="/school/conduct-matrix/assignment-wizard" class="btn btn-outline-primary btn-md mb-2"><i class="bi bi-ui-checks-grid me-1"></i> Assignment</a>');
%>

<%- include('partials/tablePages-start', {
  title,
  newUrl: null,
  newLabel: null,
  user,
  tableName: typeof tableName !== 'undefined' ? tableName : 'Class_Conduct_Matrix',
  btn_export: false,
  print: false,
  optionalBtnsBeforePrint: [
    '<button type="button" id="btn_printConductMatrix" class="btn btn-filled btn-edit btn-md me-2 mb-2" disabled title="Load the matrix first">🖨 Print</button>'
  ],
  headerManageBtns: [
    '<a href="' + dashHref + '" class="school-navigator-dashboard btn btn-filled btn-secondary btn-md mb-2"><i class="bi bi-speedometer2 me-1"></i> School Dashboard</a>',
    '<a href="/dashboard/section-nav/SCHOOL_ACADEMIA" class="school-navigator-dashboard btn btn-filled btn-secondary btn-md mb-2"><i class="bi bi-journal-bookmark me-1"></i> School Academia</a>'
  ],
  manageBtns: cmManageBtns
}) %>

<div class="schedule-shell">
  <p class="text-muted small mb-3">View class conduct across sessions for one class. Use <strong>Show</strong> to include optional sessions on Manage Session → Reports. Sessions that require conduct before reports stay enabled.</p>

  <div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-white d-flex align-items-center justify-content-between py-2 px-3">
      <div class="fw-bold text-dark"><i class="bi bi-funnel me-2"></i>Filter Class Conduct Matrix</div>
      <button
        id="cmFilterToggleBtn"
        type="button"
        class="btn btn-outline-secondary btn-sm px-2"
        data-bs-toggle="collapse"
        data-bs-target="#cmFilterCollapse"
        aria-expanded="true"
        aria-controls="cmFilterCollapse"
        aria-label="Close filters">
        <i id="cmFilterToggleIcon" class="bi bi-chevron-up"></i>
      </button>
    </div>
    <div class="collapse show" id="cmFilterCollapse">
      <div class="card-body filter-panel p-3" id="cmFilterForm">
        <div class="row g-3 align-items-end">
          <div class="col-lg-4 col-md-6">
            <label class="form-label" for="cm_className">Class</label>
            <div class="input-group">
              <input type="hidden" id="cm_classId">
              <input type="text" id="cm_className" class="form-control bg-white js-cm-rolling-class-anchor" placeholder="Select class..." readonly>
              <button type="button" class="btn btn-outline-primary" id="cm_btnClassPicker" title="Select class">
                <i class="bi bi-book"></i>
              </button>
              <button type="button" class="btn btn-outline-secondary" id="cm_btnClearClass" title="Clear class">
                <i class="bi bi-x-lg"></i>
              </button>
            </div>
          </div>
          <div class="col-lg-2 col-md-3">
            <%- include('../schedule/partials/personScheduleStartDateWithShortcuts', {
              startDateFieldClass: 'w-100 schedule-date-field-with-shortcuts',
              shortcutsButtonId: 'btn_cmDateShortcuts',
              startDateInputId: 'cm_startDate',
              menuControlsId: 'cmDateRangeMenu',
              startDateLabelFor: 'cm_startDate',
              startDateInputClass: 'form-control size-md schedule-date-input-with-shortcuts'
            }) %>
          </div>
          <div class="col-lg-2 col-md-3">
            <label class="form-label" for="cm_endDate">End Date</label>
            <input type="date" id="cm_endDate" class="form-control size-md">
          </div>
          <div class="col-12 col-lg-auto cm-filter-actions">
            <button type="button" id="cm_btnReset" class="btn btn-outline-secondary btn-md cm-filter-action-btn">Reset</button>
            <button type="button" id="cm_btnLoad" class="btn btn-filled btn-primary btn-md cm-filter-action-btn">
              <i class="bi bi-funnel me-1"></i> Apply
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
  <%- include('../schedule/partials/personScheduleDateRangeShortcuts', { dateRangeMenuId: 'cmDateRangeMenu', includeMatrixAllDates: true }) %>

  <div class="card border-0 shadow-sm d-none" id="cm_results">
    <div class="card-header bg-white border-bottom py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
      <div>
        <h5 class="m-0 fw-bold text-primary js-cm-rolling-class-anchor" id="cm_classTitle">Class</h5>
        <p class="small text-muted mb-0 mt-1">Click a cell to edit. Avg column uses rated sessions with <strong>Show</strong> enabled.</p>
      </div>
      <div class="d-flex align-items-center gap-2 flex-wrap ms-md-auto">
        <div class="d-flex align-items-center gap-2" id="cmMatrixResultActions">
        <% if (typeof canShowEnrollmentClaims !== 'undefined' && canShowEnrollmentClaims === true) { %>
        <button type="button" id="btn_toggleEnrollmentClaims" class="btn btn-sm btn-outline-secondary attendance-legend-icon-btn" disabled aria-label="Show claim numbers" title="Load the matrix first"><i class="bi bi-card-text" aria-hidden="true"></i></button>
        <% } %>
        <button type="button"
          class="btn btn-sm btn-outline-secondary attendance-legend-icon-btn"
          id="btn_cmMatrixRosterNicknames"
          disabled
          aria-label="Show roster nicknames"
          title="Load the matrix first"
          aria-pressed="false">
          <i class="bi bi-person-vcard" aria-hidden="true"></i>
        </button>
        <button type="button"
          class="btn btn-sm btn-outline-secondary attendance-legend-icon-btn cm-session-view-btn active"
          id="cm_btnShowAllSessions"
          aria-label="Show all sessions"
          title="All sessions"
          aria-pressed="true">
          <i class="bi bi-grid-3x3-gap" aria-hidden="true"></i>
        </button>
        <button type="button"
          class="btn btn-sm btn-outline-secondary attendance-legend-icon-btn cm-session-view-btn"
          id="cm_btnShowConductSessions"
          aria-label="Show conduct sessions only"
          title="Conduct sessions only"
          aria-pressed="false">
          <i class="bi bi-funnel-fill" aria-hidden="true"></i>
        </button>
        <button type="button"
          class="btn btn-sm btn-outline-secondary attendance-legend-icon-btn"
          id="cm_btnLegend"
          data-bs-toggle="modal"
          data-bs-target="#cmLegendModal"
          aria-label="Conduct rating legend"
          title="Legend">
          <i class="bi bi-info-circle" aria-hidden="true"></i>
        </button>
        </div>
        <button type="button"
          class="btn btn-sm btn-outline-secondary attendance-legend-icon-btn"
          id="btn_cmExpandMatrixView"
          data-bs-toggle="modal"
          data-bs-target="#cmMatrixExpandModal"
          disabled
          aria-label="Load the matrix first"
          title="Load the matrix first">
          <i class="bi bi-arrows-fullscreen" aria-hidden="true"></i>
        </button>
      </div>
    </div>
    <div class="card-body p-0">
      <div id="cmMatrixExpandInlineHost">
      <div class="cm-matrix-wrapper">
        <table class="table table-hover mb-0 cm-matrix-table" id="cm_table">
          <thead id="cm_thead"></thead>
          <tbody id="cm_tbody"></tbody>
        </table>
      </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/schoolMatrixExpandModal', {
  expandModalId: 'cmMatrixExpandModal',
  expandModalDialogId: 'cmMatrixExpandModalDialog',
  expandModalHostId: 'cmMatrixExpandModalHost',
  expandModalToolbarSlotId: 'cmMatrixExpandToolbarSlot',
  expandModalTitle: 'Class conduct matrix'
}) %>

<div class="modal fade" id="cmLegendModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header py-2 px-3">
        <h6 class="modal-title mb-0 fw-semibold"><i class="bi bi-info-circle me-1"></i>Class conduct legend</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="small text-muted">Matrix cells show rating codes in order: effort, participation, respects teachers, respects students.</p>
        <div class="cm-conduct-legend" id="cmConductLegend"></div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="cmCellModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
    <div class="modal-content border-0 shadow">
      <div class="modal-header border-0 pb-0">
        <div>
          <h5 class="modal-title fw-bold mb-0"><i class="bi bi-emoji-smile me-2 text-primary"></i>Class conduct</h5>
          <p class="text-muted small mb-0 mt-1">Pick a level or enter a percent for each dimension.</p>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body pt-2">
        <div class="cm-modal-context-banner rounded-3 p-3 mb-3 border">
          <div class="row g-3">
            <div class="col-sm-6">
              <div class="text-uppercase text-muted small fw-semibold mb-1">Student</div>
              <div class="fw-bold fs-6" id="cmModalStudent">—</div>
            </div>
            <div class="col-sm-6">
              <div class="text-uppercase text-muted small fw-semibold mb-1">Session</div>
              <div class="fw-bold fs-6" id="cmModalSession">—</div>
            </div>
          </div>
        </div>
        <div class="cm-conduct-legend mb-3" id="cmModalLegendInline" aria-label="Rating scale"></div>
        <div class="row g-3" id="cmModalDimensionFields"></div>
        <div class="alert alert-info border-0 mt-3 mb-0 d-none" id="cmModalReadyWrap">
          <div class="form-check mb-0">
            <input class="form-check-input" type="checkbox" id="cmModalReady">
            <label class="form-check-label fw-semibold" for="cmModalReady">Mark session ready for reports</label>
            <div class="small text-muted ms-4 ps-1">Completes the class conduct step for this session on Manage Session → Reports.</div>
          </div>
        </div>
      </div>
      <div class="modal-footer bg-light border-0">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="cmModalSave"><i class="bi bi-check2-circle me-1"></i>Save conduct</button>
      </div>
    </div>
  </div>
</div>

<%- include('partials/reportMessageHelpers') %>
<%- include('partials/tablePages-end') %>

<script>
  window.__conductRatingScalePolicy = <%- JSON.stringify(typeof conductRatingScaleResolved !== 'undefined' ? conductRatingScaleResolved : { levels: [] }).replace(/</g, '\\u003c') %>;
  window.__conductMatrixInitial = <%- JSON.stringify({
    classId: typeof initialClassId !== 'undefined' ? initialClassId : '',
    className: typeof initialClassName !== 'undefined' ? initialClassName : '',
    startDate: typeof initialStartDate !== 'undefined' ? initialStartDate : '',
    endDate: typeof initialEndDate !== 'undefined' ? initialEndDate : '',
    range: typeof initialRange !== 'undefined' ? initialRange : '',
    actionStateId: typeof actionStateId !== 'undefined' ? actionStateId : ''
  }).replace(/</g, '\\u003c').replace(/&/g, '\\u0026') %>;
</script>
