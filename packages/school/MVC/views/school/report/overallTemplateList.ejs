<%- include('partials/tablePages-start', {
  title,
  newUrl,
  newLabel,
  user,
  tableName,
  btn_export: true,
  print,
  headerManageBtns: [
    `<a href="/school/reports" class="btn btn-outline-secondary btn-sm"><i class="bi bi-house me-1"></i>Report Home</a>`,
    `<a href="/school/reports/overall-reports" class="btn btn-outline-primary btn-sm"><i class="bi bi-file-earmark-check me-1"></i>Overall Reports</a>`
  ]
}) %>

<%- include('partials/tablePages-search', { placeholder: 'Search overall report templates...', fields: [] }) %>

<div class="table-scroll-wrapper" data-floating-row-actions="true">
  <table class="table-responsive size-md" id="first-table">
    <thead>
      <tr>
        <th class="ps-4">Template</th>
        <th>Version</th>
        <th>Status</th>
        <th>Sources</th>
        <th>Fields</th>
        <th>Word files</th>
        <th class="text-end pe-4">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (!data?.length) { %>
        <tr><td colspan="7" class="text-center text-muted py-4">No overall report templates found.</td></tr>
      <% } %>
      <% (data || []).forEach((row) => { %>
        <tr>
          <td class="ps-4">
            <div class="fw-bold"><%= row.title %></div>
            <div class="x-small text-muted font-monospace"><%= row.id %></div>
            <div class="small text-muted"><%= row.description || '' %></div>
          </td>
          <td><span class="badge bg-light text-dark border">v<%= Number(row.version || 1) %></span></td>
          <td>
            <% const status = String(row.status || 'draft').toLowerCase(); %>
            <span class="badge <%= status === 'active' ? 'bg-success' : (status === 'draft' ? 'bg-warning text-dark' : 'bg-secondary') %>"><%= status %></span>
          </td>
          <td>
            <% (row.sourceSlots || []).forEach((slot) => { %>
              <div class="small mb-1"><span class="badge bg-primary-subtle text-primary-emphasis border"><%= slot.slotKey %></span> <span class="font-monospace"><%= slot.templateId %></span></div>
            <% }); %>
          </td>
          <td><%= (row.schema?.fields || []).filter((field) => !['section','subheader','row_break'].includes(field.type)).length %></td>
          <td>
            <span class="badge bg-light text-dark border"><%= row.docxTemplate?.path ? 'Default' : 'No default' %></span>
            <% if ((row.docxTemplatesByFunder || []).length) { %>
              <span class="badge bg-info-subtle text-info-emphasis border"><%= row.docxTemplatesByFunder.length %> funder</span>
            <% } %>
          </td>
          <td class="table-actions pe-4">
            <div class="row-actions-wrap">
              <button
                type="button"
                class="btn btn-secondary btn-sm btn-row-actions-toggle"
                data-row-actions-id="<%= row.id %>"
                title="Overall Template Actions">
                <i class="bi bi-three-dots-vertical"></i>
              </button>
              <div class="row-actions-menu d-none" data-row-actions-id="<%= row.id %>">
                <% if (status === 'active') { %>
                  <a href="/school/reports/overall-reports/new/<%= encodeURIComponent(row.id) %>" class="btn btn-primary btn-sm"><i class="bi bi-plus-circle me-2"></i>Create Report</a>
                <% } %>
                <a href="/school/reports/overall-templates/edit/<%= encodeURIComponent(row.id) %>" class="btn btn-outline-secondary btn-sm"><i class="bi bi-pencil-square me-2"></i>Edit</a>
                <a
                  href="/school/reports/overall-templates/delete/<%= encodeURIComponent(row.id) %>"
                  class="btn btn-outline-danger btn-sm js-delete-overall-template"
                  data-template-title="<%= row.title %>"
                ><i class="bi bi-trash me-2"></i>Delete</a>
              </div>
            </div>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>
<%- include('partials/pagination', { pagination, filters, baseUrlPath: newUrl }) %>
<%- include('partials/tablePages-end') %>

<%- include('partials/reportMessageHelpers') %>

<script>
(() => {
  async function confirmTemplateDelete(link) {
    const templateTitle = String(link.dataset.templateTitle || 'this overall report template');
    const message = `Delete <strong>${templateTitle.replace(/[&<>"']/g, character => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[character]))}</strong>? A template that is already referenced by an overall report cannot be deleted.`;
    return window.ReportMessaging.confirmReportAction({
      title: 'Delete Overall Report Template?',
      message,
      confirmText: 'Delete',
      html: true
    });
  }

  document.querySelectorAll('.js-delete-overall-template').forEach(link => {
    link.addEventListener('click', async event => {
      event.preventDefault();
      if (await confirmTemplateDelete(link)) window.location.assign(link.href);
    });
  });
})();
</script>
