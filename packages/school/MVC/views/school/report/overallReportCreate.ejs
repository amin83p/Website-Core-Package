<%
  const sourceSlotsJson = JSON.stringify(sourceSlotOptions || []).replace(/</g, '\\u003c');
%>
<div class="sections-page">
  <div class="d-flex justify-content-between align-items-start mb-4">
    <div><h1 class="page-heading size-md m-0 text-start" style="padding-left:0;"><i class="bi bi-file-earmark-plus me-2"></i><%= title %></h1><div class="text-muted"><%= template.title %> &middot; v<%= Number(template.version || 1) %></div></div>
    <a href="/school/reports/overall-templates" class="btn btn-outline-secondary btn-sm">Back</a>
  </div>
  <form method="POST" id="overallReportCreateForm" action="/school/reports/overall-reports/new/<%= encodeURIComponent(template.id) %>">
    <input type="hidden" name="actionStateId" value="<%= actionStateId || '' %>">
    <div class="card border-0 shadow-sm mb-3"><div class="card-body">
      <label class="form-label fw-bold">Overall report name</label>
      <input class="form-control" name="title" maxlength="240" placeholder="<%= template.title %> - <%= new Date().toISOString().slice(0,10) %>">
    </div></div>
    <div class="card border-0 shadow-sm mb-3">
      <div class="card-header bg-white"><h5 class="mb-0 fw-bold">Completed Source Reports</h5><div class="small text-muted">Search submitted or locked reports matching each source-template slot.</div></div>
      <div class="card-body" id="sourceReportPickerRows">
        <% (sourceSlotOptions || []).forEach((slot) => { %>
          <div class="mb-3 border rounded p-3" data-source-slot="<%= slot.slotKey %>">
            <input type="hidden" name="sourceInstance_<%= slot.slotKey %>" id="sourceInstance_<%= slot.slotKey %>" value="">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
              <div><span class="badge bg-primary me-2"><%= slot.slotKey %></span><strong><%= slot.templateTitle || slot.templateId %></strong><div class="small text-muted ms-1 mt-1"><%= slot.templateType || 'Report' %> &middot; v<%= Number(slot.templateVersion || 1) %> &middot; <span class="font-monospace"><%= slot.templateId %></span></div></div>
              <button type="button" class="btn btn-outline-primary btn-sm js-pick-source-report" data-slot-key="<%= slot.slotKey %>" <%= slot.instances?.length ? '' : 'disabled' %>><i class="bi bi-search me-1"></i>Find Completed Report</button>
            </div>
            <div class="form-control bg-white source-report-summary" id="sourceSummary_<%= slot.slotKey %>"><span class="text-muted">No completed report selected</span></div>
            <% if (!slot.instances?.length) { %><div class="form-text text-danger">No submitted or locked instances are available for this template.</div><% } %>
          </div>
        <% }); %>
      </div>
    </div>
    <div class="card border-0 shadow-sm mb-3"><div class="card-body">
      <label class="form-label fw-bold">Output Word template</label>
      <select class="form-select" name="selectedDocxKey" required>
        <% (docxOptions || []).forEach((option) => { %><option value="<%= option.key %>"><%= option.label %> &middot; <%= option.fileName %></option><% }); %>
      </select>
      <% if (!docxOptions?.length) { %><div class="form-text text-danger">This overall template has no Word file configured.</div><% } %>
    </div></div>
    <div class="d-flex justify-content-end gap-2"><a href="/school/reports/overall-templates" class="btn btn-outline-secondary">Cancel</a><button class="btn btn-primary" type="submit" <%= !docxOptions?.length ? 'disabled' : '' %>>Create Snapshot Report</button></div>
  </form>
</div>

<%- include('partials/modal_GenericPicker', { user }) %>

<script>
(() => {
  const sourceSlots = <%- sourceSlotsJson %>;
  const bySlot = new Map(sourceSlots.map(slot => [String(slot.slotKey), slot]));
  const escapeHtml = value => String(value ?? '').replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
  const selectedBySlot = new Map();

  function pickerConfig(config) {
    return window.GenericPickerPresets?.normalizeConfig ? window.GenericPickerPresets.normalizeConfig(config) : config;
  }

  function showReportModal(title, message) {
    if (typeof window.showMessageModal === 'function' && document.getElementById('messageModal')) {
      return window.showMessageModal({ title, icon: 'warning', message: escapeHtml(message), buttons: [{ text: 'OK', class: 'btn-primary' }] });
    }
    window.alert(message);
    return null;
  }

  function summaryHtml(item) {
    const person = item.studentName || item.studentId || 'Whole class';
    const context = [item.className, item.teacherName, item.reportDate ? String(item.reportDate).slice(0, 10) : ''].filter(Boolean).map(escapeHtml).join(' &middot; ');
    return `<strong>${escapeHtml(person)}</strong><span class="badge bg-light text-dark border ms-2">${escapeHtml(item.status)}</span><div>${escapeHtml(item.title || item.id)}</div><div class="small text-muted">${context || 'Completed report'} &middot; <code>${escapeHtml(item.id)}</code></div>`;
  }

  function openSourcePicker(slotKey) {
    const slot = bySlot.get(String(slotKey));
    if (!slot || !window.GenericPicker) return;
    const usedIds = new Set([...selectedBySlot.entries()].filter(([key]) => key !== slotKey).map(([, item]) => String(item.id)));
    window.GenericPicker.open(pickerConfig({
      title: `Select Completed Report for ${slotKey}`,
      icon: 'bi-file-earmark-check',
      placeholder: 'Search student, class, teacher, title, date, status, or id...',
      sourceMode: 'local',
      localItems: (slot.instances || []).map(item => ({ ...item, id: String(item.id), templateTitle: slot.templateTitle })),
      searchFields: 'id,title,status,studentId,studentName,className,teacherName,reportDate,templateTitle',
      multiselect: false,
      limit: 5000,
      renderer: item => `<div>${summaryHtml(item)}<div class="small text-muted mt-1">${escapeHtml(slot.templateTitle || slot.templateId)}</div></div>`,
      onSelect(item) {
        if (usedIds.has(String(item.id))) { showReportModal('Report Already Selected', 'Choose a different completed report for this source slot.'); return; }
        selectedBySlot.set(slotKey, item);
        document.getElementById(`sourceInstance_${slotKey}`).value = item.id;
        document.getElementById(`sourceSummary_${slotKey}`).innerHTML = summaryHtml(item);
      }
    }));
  }

  document.querySelectorAll('.js-pick-source-report').forEach(button => button.addEventListener('click', () => openSourcePicker(button.dataset.slotKey)));
  document.getElementById('overallReportCreateForm').addEventListener('submit', event => {
    const missing = sourceSlots.filter(slot => !String(document.getElementById(`sourceInstance_${slot.slotKey}`)?.value || '').trim());
    if (!missing.length) return;
    event.preventDefault();
    showReportModal('Completed Reports Required', `Select a completed report for: ${missing.map(slot => slot.slotKey).join(', ')}.`);
  });
})();
</script>
