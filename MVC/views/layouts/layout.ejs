<!DOCTYPE html>
<%
  const layoutBrand = (typeof appBrand !== 'undefined' && appBrand && typeof appBrand === 'object') ? appBrand : {};
  const layoutAppName = layoutBrand.appName || 'Amin Paknejad';
  const layoutShortName = layoutBrand.appShortName || layoutAppName || 'Website';
  const layoutThemeColor = layoutBrand.themeColor || '#ffffff';
  const layoutIconSvgUrl = layoutBrand.iconSvgUrl || '/uploads/GLOBAL/logo/icon.svg';
  const layoutLogoUrl = layoutBrand.logoUrl || '/uploads/GLOBAL/logo/Logo1.png';
  const layoutAppleIconUrl = layoutBrand.appleTouchIconUrl || layoutLogoUrl;
  const layoutHtmlClass = (typeof htmlClass !== 'undefined' && htmlClass) ? String(htmlClass).trim() : '';
  const layoutBodyClass = (typeof bodyClass !== 'undefined' && bodyClass) ? String(bodyClass).trim() : '';
  const layoutMainClass = (typeof mainClass !== 'undefined' && mainClass) ? String(mainClass).trim() : 'container my-4';
  const layoutCanUsePageDiagnostics = (typeof canUsePageDiagnostics !== 'undefined' && canUsePageDiagnostics);
  const layoutPageDiagnosticsEnabled = (typeof pageDiagnosticsEnabled === 'undefined' || pageDiagnosticsEnabled);
%>
<html lang="en"<% if (layoutHtmlClass) { %> class="<%= layoutHtmlClass %>"<% } %>>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title || layoutAppName %></title>
  <meta name="theme-color" content="<%= layoutThemeColor %>" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="<%= layoutShortName %>" />
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />

  <script>
    (function () {
      try {
        const storedHeaderCompact = localStorage.getItem('app_header_compact');
        if (storedHeaderCompact !== '0') {
          document.documentElement.classList.add('header-pref-compact');
        }
        const pageWidth = String(localStorage.getItem('app_page_width') || '').trim().toLowerCase();
        if (pageWidth === 'wide') {
          document.documentElement.classList.add('app-page-width-wide');
        } else if (pageWidth === 'full') {
          document.documentElement.classList.add('app-page-width-full');
        }
      } catch (_) {}
    })();
  </script>
  <script>
    window.__APP_UI_SETTINGS__ = <%- JSON.stringify((typeof appUiSettings !== 'undefined' && appUiSettings) ? appUiSettings : { genericPickerSearchDebounceMs: 400 }) %>;
  </script>

  <link rel="icon" type="image/svg+xml" href="<%= layoutIconSvgUrl %>">
  <link rel="icon" type="image/png" href="<%= layoutLogoUrl %>">
  <link rel="shortcut icon" type="image/png" href="<%= layoutLogoUrl %>">
  <link rel="apple-touch-icon" sizes="180x180" href="<%= layoutAppleIconUrl %>">
  <link rel="manifest" href="/site.webmanifest">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

  <link rel="stylesheet" href="<%= typeof staticAssetUrl === 'function' ? staticAssetUrl('/styles/main.css') : '/styles/main.css' %>">
  <style>
    :root {
      --app-brand-logo-url: url(<%- JSON.stringify(layoutLogoUrl) %>);
    }
  </style>

  <% if (typeof pageCss !== 'undefined' && pageCss) { %>
    <link rel="stylesheet" href="<%= typeof staticAssetUrl === 'function' ? staticAssetUrl('/styles/' + pageCss) : '/styles/' + pageCss %>">
  <% } %>

  <% if (typeof includeModal !== 'undefined' && includeModal) { %>
    <link rel="stylesheet" href="<%= typeof staticAssetUrl === 'function' ? staticAssetUrl('/styles/modal.css') : '/styles/modal.css' %>">
  <% } %>

  <% if (typeof tableName !== 'undefined' && tableName) { %>
    <link rel="stylesheet" href="<%= typeof staticAssetUrl === 'function' ? staticAssetUrl('/styles/pagination.css') : '/styles/pagination.css' %>">
  <% } %>

</head>
<body<% if (layoutBodyClass) { %> class="<%= layoutBodyClass %>"<% } %>>
  <% if (typeof user !== 'undefined') { %>
      <%- include('../partials/header', { user }) %>
  <% } else { %>
      <%- include('../partials/header') %>
  <% } %>

  <% if (typeof backendRecoveryActive !== 'undefined' && backendRecoveryActive && typeof backendRecoveryCanView !== 'undefined' && backendRecoveryCanView) { %>
    <%- include('../partials/backendRecoveryBanner') %>
  <% } %>

  <main class="<%= layoutMainClass %>">
    <%- body %>
  </main>

  <%- include('../partials/footer') %>

  <% if (typeof includeModal !== 'undefined' && includeModal !== null && includeModal) { %>
    <%- include('../partials/modal') %>
  <% } %>
  
  <% if (typeof includeModal_Table !== 'undefined' && includeModal_Table !== null && includeModal_Table) { %>
    <%- include('../partials/modal-table') %>
  <% } %>
  <% if (typeof includeModal_FileImport !== 'undefined' && includeModal_FileImport!== null && includeModal_FileImport) { %>
    <%- include('../partials/modal_FileImport') %>
  <% } %>
  <% if (typeof includeModal_StudentImport !== 'undefined' && includeModal_StudentImport!== null && includeModal_StudentImport) { %>
    <%- include('../../packages/school/MVC/views/school/student/modal_StudentImport') %>
  <% } %>
  <%- include('../partials/modal_FileExport') %>

  <%- include('../partials/adminVerificationModal') %>
  <%- include('../partials/quickMenu') %>
  <%- include('../partials/startMenu') %>
  <%- include('../partials/loadingModal') %>
  <% if (typeof user !== 'undefined' && user && typeof chatAccess !== 'undefined' && chatAccess && (chatAccess.canRead || chatAccess.canReadAll)) { %>
    <%- include('../partials/chatModal') %>
  <% } %>
  <% if ((typeof print !== 'undefined' && print) || (typeof includePrintManager !== 'undefined' && includePrintManager)) { %>
    <%- include('../partials/printSettingsModal') %>
  <% } %>
  <% if (layoutCanUsePageDiagnostics && !layoutPageDiagnosticsEnabled) { %>
    <div class="modal fade page-diagnostics-toggle-modal" id="pageDiagnosticsToggleModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3">
          <div class="modal-header bg-light border-bottom">
            <h5 class="modal-title fw-bold text-dark mb-0">
              <i class="bi bi-speedometer2 me-2" aria-hidden="true"></i>Page Diagnostics
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="page-diagnostics-preference-panel">
              <div class="form-check form-switch mb-1">
                <input class="form-check-input" type="checkbox" role="switch" id="pageDiagnosticsToggleSwitch" data-no-wait="true">
                <label class="form-check-label fw-semibold" for="pageDiagnosticsToggleSwitch">Page Diagnostics</label>
              </div>
              <div class="small text-muted">Diagnostics are off for this account, so full page diagnostics scripts are not loaded.</div>
              <div class="alert alert-danger d-none mt-3 mb-0" id="pageDiagnosticsToggleError"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% } %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <% if (layoutCanUsePageDiagnostics && layoutPageDiagnosticsEnabled) { %>
    <script>
      window.__PAGE_DIAGNOSTICS__ = {
        enabled: true,
        lazy: true,
        endpoint: '/debug/client-diagnostics/page-presence',
        presencePingEndpoint: '/debug/client-diagnostics/page-presence/ping',
        preferenceEndpoint: <%- JSON.stringify(typeof pageDiagnosticsPreferenceEndpoint !== 'undefined' ? pageDiagnosticsPreferenceEndpoint : '/debug/client-diagnostics/preference') %>,
        csrfToken: <%- JSON.stringify(typeof csrfToken !== 'undefined' ? csrfToken : '') %>,
        currentPath: <%- JSON.stringify((typeof originalUrl !== 'undefined' && originalUrl) ? String(originalUrl).split(/[?#]/)[0] : '') %>,
        requestId: <%- JSON.stringify(typeof requestId !== 'undefined' ? requestId : '') %>,
        buildVersion: <%- JSON.stringify(typeof buildVersionShort !== 'undefined' ? buildVersionShort : '') %>,
        runtime: <%- JSON.stringify(typeof pageDiagnosticsRuntime !== 'undefined' && pageDiagnosticsRuntime ? pageDiagnosticsRuntime : { kind: 'server', nodeEnv: '', isProduction: false }) %>,
        scriptUrls: {
          health: <%- JSON.stringify(typeof staticAssetUrl === 'function' ? staticAssetUrl('/scripts/pageDiagnosticsHealth.js') : '/scripts/pageDiagnosticsHealth.js') %>,
          main: <%- JSON.stringify(typeof staticAssetUrl === 'function' ? staticAssetUrl('/scripts/pageDiagnostics.js') : '/scripts/pageDiagnostics.js') %>
        }
      };
    </script>
    <script src="<%= typeof staticAssetUrl === 'function' ? staticAssetUrl('/scripts/pageDiagnosticsLoader.js') : '/scripts/pageDiagnosticsLoader.js' %>"></script>
  <% } else if (layoutCanUsePageDiagnostics) { %>
    <script>
      (function () {
        const endpoint = <%- JSON.stringify(typeof pageDiagnosticsPreferenceEndpoint !== 'undefined' ? pageDiagnosticsPreferenceEndpoint : '/debug/client-diagnostics/preference') %>;
        const csrfToken = <%- JSON.stringify(typeof csrfToken !== 'undefined' ? csrfToken : '') %>;
        function setError(message) {
          const target = document.getElementById('pageDiagnosticsToggleError');
          if (!target) return;
          const text = String(message || '').trim();
          target.textContent = text;
          target.classList.toggle('d-none', !text);
        }
        async function savePreference(enabled) {
          const headers = {
            Accept: 'application/json',
            'Content-Type': 'application/json',
            'x-ajax-request': 'true'
          };
          if (csrfToken) headers['x-csrf-token'] = csrfToken;
          const response = await fetch(endpoint, {
            method: 'POST',
            headers,
            credentials: 'same-origin',
            body: JSON.stringify({ enabled })
          });
          const payload = await response.json().catch(() => ({}));
          if (!response.ok || payload.status !== 'success') {
            throw new Error(payload.message || 'Unable to update page diagnostics.');
          }
        }
        document.addEventListener('DOMContentLoaded', function () {
          const input = document.getElementById('pageDiagnosticsToggleSwitch');
          if (!input) return;
          input.addEventListener('change', async function () {
            if (!input.checked) return;
            setError('');
            input.disabled = true;
            try {
              await savePreference(true);
              window.location.reload();
            } catch (error) {
              input.checked = false;
              input.disabled = false;
              setError(error && error.message ? error.message : 'Unable to update page diagnostics.');
            }
          });
        });
      })();
    </script>
  <% } %>
  <% if (typeof orgTimeZone !== 'undefined' && orgTimeZone) { %>
    <script>
      window.__APP_ORG_DATETIME__ = {
        timeZone: <%- JSON.stringify(orgTimeZone) %>,
        today: <%- JSON.stringify(typeof orgToday !== 'undefined' ? orgToday : '') %>
      };
    </script>
    <script src="<%= typeof staticAssetUrl === 'function' ? staticAssetUrl('/scripts/orgDateTime.js') : '/scripts/orgDateTime.js' %>"></script>
  <% } %>
  <script src="<%= typeof staticAssetUrl === 'function' ? staticAssetUrl('/scripts/main.js') : '/scripts/main.js' %>"></script>

  <% if (typeof includeModal !== 'undefined' && includeModal) { %>
    <script src="<%= typeof staticAssetUrl === 'function' ? staticAssetUrl('/scripts/modal.js') : '/scripts/modal.js' %>"></script>
  <% } %>
  <% if (typeof includeModal_Table !== 'undefined' && includeModal_Table) { %>
    <script src="<%= typeof staticAssetUrl === 'function' ? staticAssetUrl('/scripts/modal-table.js') : '/scripts/modal-table.js' %>"></script>
  <% } %>

  <% if ((typeof print !== 'undefined' && print) || (typeof includePrintManager !== 'undefined' && includePrintManager)) { %>
    <script src="<%= typeof staticAssetUrl === 'function' ? staticAssetUrl('/scripts/printDocumentBuilder.js') : '/scripts/printDocumentBuilder.js' %>"></script>
    <script src="<%= typeof staticAssetUrl === 'function' ? staticAssetUrl('/scripts/appPrintManager.js') : '/scripts/appPrintManager.js' %>"></script>
    <script src="<%= typeof staticAssetUrl === 'function' ? staticAssetUrl('/scripts/print.js') : '/scripts/print.js' %>"></script>
  <% } %>
  
  <% if (typeof includeModal_FileImport !== 'undefined' && includeModal_FileImport!== null && includeModal_FileImport) { %>
    <script src="<%= typeof staticAssetUrl === 'function' ? staticAssetUrl('/scripts/modal_FileImport.js') : '/scripts/modal_FileImport.js' %>"></script>
  <% } %>
  <script src="<%= typeof staticAssetUrl === 'function' ? staticAssetUrl('/scripts/modal_FileExport.js') : '/scripts/modal_FileExport.js' %>"></script>

  <% if (typeof pageScript !== 'undefined' && pageScript) { %>
    <script src="<%= typeof staticAssetUrl === 'function' ? staticAssetUrl('/scripts/' + pageScript) : '/scripts/' + pageScript %>"></script>
  <% } %>
</body>
</html>
