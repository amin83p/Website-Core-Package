<script>
const adminCanReviewHistory = <%= canReviewHistory ? 'true' : 'false' %>;
const adminCanDeleteAll = <%= canDeleteAllChats ? 'true' : 'false' %>;
let adminOrphanAuditRows = [];
let adminOrphanAuditProgressTimer = null;

function adminGetCsrfHeaders() {
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';
  const headers = { 'Content-Type': 'application/json', Accept: 'application/json' };
  if (csrfToken) {
    headers['x-csrf-token'] = csrfToken;
    headers['csrf-token'] = csrfToken;
  }
  return headers;
}

function adminFormatBytes(bytes) {
    const value = Number(bytes) || 0;
    if (!value) return '0 B';
    const units = ['B', 'KB', 'MB', 'GB', 'TB'];
    const i = Math.min(Math.floor(Math.log(value) / Math.log(1024)), units.length - 1);
    const scaled = value / Math.pow(1024, i);
    return `${scaled.toFixed(i === 0 ? 0 : 2)} ${units[i]}`;
}

function adminNormalizeUploadRelativePath(value) {
    return String(value || '').replace(/\\/g, '/').replace(/^\/+/, '').replace(/\/+$/, '').trim();
}

function adminBuildFileManagerHref(row) {
    const kind = String(row?.kind || '').toLowerCase();
    const fileName = adminNormalizeUploadRelativePath(row?.fileName);
    const rawPath = adminNormalizeUploadRelativePath(row?.path || row?.relativePath || '');
    let relative = rawPath;
    if (kind === 'folder') {
        relative = rawPath || adminNormalizeUploadRelativePath(`chat/${row?.conversationId || ''}`);
    } else if (fileName) {
        if (rawPath && (rawPath === fileName || rawPath.endsWith(`/${fileName}`))) {
            relative = rawPath;
        } else if (rawPath) {
            relative = `${rawPath.replace(/\/+$/, '')}/${fileName}`;
        } else if (row?.conversationId) {
            relative = `chat/${row.conversationId}/${fileName}`;
        }
    }
    if (!relative) return '/files';
    const scopePath = /^global\//i.test(relative) ? relative : `GLOBAL/${relative}`;
    return `/files?path=${encodeURIComponent(scopePath)}`;
}

function adminSetOrphanAuditProgress(active, label, percent) {
    const wrap = document.getElementById('adminOrphanAuditProgressWrap');
    const bar = document.getElementById('adminOrphanAuditProgressBar');
    const lbl = document.getElementById('adminOrphanAuditProgressLabel');
    if (wrap) wrap.classList.toggle('d-none', !active);
    if (lbl && label) lbl.textContent = label;
    if (bar) {
        const pct = Math.max(5, Math.min(100, Number(percent) || 0));
        bar.style.width = `${pct}%`;
        bar.setAttribute('aria-valuenow', String(Math.round(pct)));
        bar.classList.toggle('progress-bar-animated', active && pct < 100);
        bar.classList.toggle('progress-bar-striped', active);
    }
}

function adminStartOrphanAuditProgress() {
    let pct = 10;
    adminSetOrphanAuditProgress(true, 'Scanning upload folders…', pct);
    adminOrphanAuditProgressTimer = window.setInterval(() => {
        pct = Math.min(pct + Math.random() * 8 + 4, 92);
        const label = pct < 55 ? 'Scanning upload folders…' : 'Matching message references…';
        adminSetOrphanAuditProgress(true, label, pct);
    }, 350);
}

function adminStopOrphanAuditProgress(success) {
    if (adminOrphanAuditProgressTimer) {
        window.clearInterval(adminOrphanAuditProgressTimer);
        adminOrphanAuditProgressTimer = null;
    }
    if (success) {
        adminSetOrphanAuditProgress(true, 'Audit complete.', 100);
        window.setTimeout(() => adminSetOrphanAuditProgress(false), 600);
        return;
    }
    adminSetOrphanAuditProgress(false);
}

function adminOpenOrphanAuditModal() {
    if (!adminCanDeleteAll) return;
    const modalEl = document.getElementById('adminOrphanAuditModal');
    bootstrap.Modal.getOrCreateInstance(modalEl).show();
    adminSetOrphanAuditProgress(false);
}

function adminOrphanRowKey(row) {
    if (row.kind === 'folder') return `folder:${row.conversationId}`;
    return `file:${row.conversationId}:${row.fileName}`;
}

function adminRenderOrphanAuditTable() {
    const tbody = document.getElementById('adminOrphanAuditTableBody');
    const deleteBtn = document.getElementById('adminOrphanAuditDeleteBtn');
    if (!tbody) return;
    if (!adminOrphanAuditRows.length) {
        tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-4">No orphan attachments found.</td></tr>';
        if (deleteBtn) deleteBtn.disabled = true;
        return;
    }
    tbody.innerHTML = adminOrphanAuditRows.map((row) => {
        const key = adminOrphanRowKey(row);
        const label = row.kind === 'folder'
            ? adminEscapeHtml(row.path || row.conversationId)
            : adminEscapeHtml(row.fileName || '');
        const reviewHref = adminEscapeHtml(adminBuildFileManagerHref(row));
        const reviewLabel = row.kind === 'folder' ? 'Open folder' : 'Open file';
        return `<tr data-orphan-key="${adminEscapeHtml(key)}">
          <td><input type="checkbox" class="form-check-input admin-orphan-select" data-orphan-key="${adminEscapeHtml(key)}" checked></td>
          <td>${adminEscapeHtml(row.kind)}</td>
          <td class="font-monospace small">${adminEscapeHtml(row.conversationId || '')}</td>
          <td class="small">${label}</td>
          <td>${adminEscapeHtml(adminFormatBytes(row.sizeBytes))}</td>
          <td class="small text-muted">${adminEscapeHtml(row.reason || '')}</td>
          <td class="text-nowrap">
            <a href="${reviewHref}" class="btn btn-outline-primary btn-sm" target="_blank" rel="noopener noreferrer" title="Review in File Manager">
              <i class="bi bi-folder2-open me-1"></i>${reviewLabel}
            </a>
          </td>
        </tr>`;
    }).join('');
    if (deleteBtn) deleteBtn.disabled = false;
    tbody.querySelectorAll('.admin-orphan-select').forEach((input) => {
        input.addEventListener('change', adminUpdateOrphanDeleteButtonState);
    });
    adminUpdateOrphanDeleteButtonState();
}

function adminUpdateOrphanDeleteButtonState() {
    const deleteBtn = document.getElementById('adminOrphanAuditDeleteBtn');
    const selected = document.querySelectorAll('#adminOrphanAuditTableBody .admin-orphan-select:checked');
    if (deleteBtn) deleteBtn.disabled = selected.length === 0;
}

function adminOrphanAuditSelectAll(checked) {
    document.querySelectorAll('#adminOrphanAuditTableBody .admin-orphan-select').forEach((input) => {
        input.checked = !!checked;
    });
    adminUpdateOrphanDeleteButtonState();
}

async function adminRunOrphanAudit() {
    const runBtn = document.getElementById('adminOrphanAuditRunBtn');
    const summary = document.getElementById('adminOrphanAuditSummary');
    const deleteBtn = document.getElementById('adminOrphanAuditDeleteBtn');
    if (runBtn) runBtn.disabled = true;
    if (deleteBtn) deleteBtn.disabled = true;
    if (summary) summary.textContent = 'Running audit…';
    adminStartOrphanAuditProgress();
    let success = false;
    try {
        const resp = await fetch('/chat/admin/attachment-audit', { headers: { Accept: 'application/json' } });
        const res = await resp.json();
        if (res.status !== 'success') {
            if (summary) summary.textContent = res.message || 'Audit failed.';
            return;
        }
        const report = res.data || {};
        const folders = Array.isArray(report.orphanConversationFolders) ? report.orphanConversationFolders : [];
        const files = Array.isArray(report.orphanFiles) ? report.orphanFiles : [];
        adminOrphanAuditRows = [...folders, ...files];
        adminRenderOrphanAuditTable();
        const totals = report.totals || {};
        if (summary) {
            summary.textContent = `${totals.orphanFolderCount || 0} orphan folder(s), ${totals.orphanFileCount || 0} orphan file(s), ${adminFormatBytes(totals.orphanTotalBytes)} total.`;
        }
        success = true;
    } catch (err) {
        console.error(err);
        if (summary) summary.textContent = 'Error connecting to server.';
    } finally {
        adminStopOrphanAuditProgress(success);
        if (runBtn) runBtn.disabled = false;
    }
}

async function adminDeleteSelectedOrphans() {
    const selectedKeys = new Set(
        [...document.querySelectorAll('#adminOrphanAuditTableBody .admin-orphan-select:checked')]
            .map((input) => input.getAttribute('data-orphan-key'))
            .filter(Boolean)
    );
    if (!selectedKeys.size) return;

    const selectedRows = adminOrphanAuditRows.filter((row) => selectedKeys.has(adminOrphanRowKey(row)));
    const totalBytes = selectedRows.reduce((sum, row) => sum + (Number(row.sizeBytes) || 0), 0);
    const confirmMessage = `Delete ${selectedRows.length} selected orphan item(s) (${adminFormatBytes(totalBytes)})? This cannot be undone.`;

    let isConfirmed = false;
    if (typeof window.showMessageModal === 'function') {
        const result = await window.showMessageModal({
            title: 'Delete orphan attachments',
            icon: 'warning',
            message: confirmMessage,
            buttons: [
                { text: 'Cancel', class: 'btn-secondary' },
                { text: 'Delete', class: 'btn-danger' }
            ]
        });
        if (result === 'Delete') isConfirmed = true;
    } else {
        isConfirmed = window.confirm(confirmMessage);
    }
    if (!isConfirmed) return;

    const orphanFolderIds = selectedRows.filter((row) => row.kind === 'folder').map((row) => row.conversationId);
    const orphanFiles = selectedRows.filter((row) => row.kind === 'file').map((row) => ({
        convId: row.conversationId,
        fileName: row.fileName
    }));

    try {
        const resp = await fetch('/chat/admin/attachment-cleanup', {
            method: 'POST',
            headers: adminGetCsrfHeaders(),
            body: JSON.stringify({
                confirm: true,
                orphanFolderIds,
                orphanFiles
            })
        });
        const res = await resp.json();
        if (res.status !== 'success') {
            const errMsg = res.message || 'Cleanup failed.';
            if (typeof window.showMessageModal === 'function') {
                await window.showMessageModal({ title: 'Error', icon: 'error', message: errMsg });
            } else {
                alert(errMsg);
            }
            return;
        }
        if (typeof window.showMessageModal === 'function') {
            await window.showMessageModal({
                title: 'Cleanup complete',
                icon: 'success',
                message: 'Selected orphan attachments were removed.',
                buttons: [{ text: 'OK', class: 'btn-success' }]
            });
        }
        await adminRunOrphanAudit();
    } catch (err) {
        console.error(err);
        if (typeof window.showMessageModal === 'function') {
            await window.showMessageModal({ title: 'Connection Error', icon: 'error', message: 'Error connecting to server.' });
        } else {
            alert('Error connecting to server.');
        }
    }
}

function adminEscapeHtml(value) {
    return String(value == null ? '' : value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
}

function getAdminAttachmentUrl(convId, fileRef) {
    const token = String(fileRef || '').split(/[?#]/)[0].replace(/\\/g, '/');
    const parts = token.split('/').filter(Boolean);
    const rawName = parts.length ? parts[parts.length - 1] : '';
    let fileName = rawName;
    try { fileName = decodeURIComponent(rawName); } catch (_) { /* keep raw */ }
    if (!convId || !fileName) return '';
    return `/chat/attachments/${encodeURIComponent(convId)}/${encodeURIComponent(fileName)}`;
}

function formatAdminMessageInstant(value) {
    if (window.AppOrgDateTime && typeof AppOrgDateTime.formatInstant === 'function') {
        return AppOrgDateTime.formatInstant(value);
    }
    const date = new Date(value);
    return Number.isNaN(date.getTime()) ? '' : date.toLocaleString();
}

function formatAdminDayLabel(value) {
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return '';
    if (window.AppOrgDateTime && typeof AppOrgDateTime.formatInstant === 'function') {
        return AppOrgDateTime.formatInstant(value, { month: 'short', day: 'numeric', year: 'numeric' });
    }
    return date.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
}

function normalizeAdminMessageText(value) {
    return String(value == null ? '' : value)
        .replace(/\r\n/g, '\n')
        .replace(/\r/g, '\n');
}

function isAdminLegacySystemHtmlMessage(content) {
    const raw = String(content || '');
    return /<(?:b|strong)>System Message:<\/(?:b|strong)>/i.test(raw)
        && /<a\s+href=/i.test(raw);
}

function normalizeAdminLegacySystemHtml(content) {
    return String(content || '')
        .replace(/^[\s\S]*?(?=<(?:b|strong)>System Message)/i, '<i class="bi bi-pin-map-fill text-primary"></i> ')
        .replace(/âž[\s\S]*?(?=Open Specific Note)/i, '<i class="bi bi-box-arrow-up-right"></i> ');
}

function adminSanitizeMessageHtml(html, options = {}) {
    const raw = String(html || '');
  const trusted = options.trusted === true;
    if (window.DOMPurify && typeof window.DOMPurify.sanitize === 'function') {
        return window.DOMPurify.sanitize(raw, { ADD_ATTR: ['target', 'rel', 'class', 'style'] });
    }
    return trusted ? raw : adminEscapeHtml(raw);
}

function adminMessageShouldRenderHtml(msg) {
    const type = String(msg?.type || 'text').toLowerCase();
    if (type === 'system') return true;
    const content = String(msg?.content || '');
    if (type === 'text' && isAdminLegacySystemHtmlMessage(content)) return true;
    return /<[a-z][\s\S]*?>/i.test(content);
}

function buildAdminMessageContentHtml(msg, convId) {
    if (msg.deletedAt) {
        return '<div class="admin-chat-msg-text">Message deleted</div>';
    }
    if (msg.type === 'system') {
        return `<div class="admin-chat-msg-text admin-chat-msg-html msg-system-content">${adminSanitizeMessageHtml(msg.content || 'System message', { trusted: true })}</div>`;
    }
    if (msg.type === 'image') {
        const safeUrl = getAdminAttachmentUrl(convId, msg.fileUrl);
        if (!safeUrl) {
            return '<div class="admin-chat-msg-text text-muted">Image unavailable</div>';
        }
        return `<a href="${adminEscapeHtml(safeUrl)}" target="_blank" rel="noopener"><img src="${adminEscapeHtml(safeUrl)}" alt="Image attachment"></a>`;
    }
    if (msg.type === 'file') {
        const safeUrl = getAdminAttachmentUrl(convId, msg.fileUrl);
        if (!safeUrl) {
            return '<div class="admin-chat-msg-text text-muted">Attachment unavailable</div>';
        }
        return `<a href="${adminEscapeHtml(safeUrl)}" target="_blank" rel="noopener" class="admin-chat-file-link"><i class="bi bi-file-earmark-arrow-down fs-5 text-primary"></i><span><strong>Download attachment</strong><br><span class="small text-muted">Open secured file</span></span></a>`;
    }
    const content = normalizeAdminMessageText(msg.content || '');
    if (msg.type === 'text' && isAdminLegacySystemHtmlMessage(content)) {
        return `<div class="admin-chat-msg-text admin-chat-msg-html msg-system-content">${adminSanitizeMessageHtml(normalizeAdminLegacySystemHtml(content), { trusted: true })}</div>`;
    }
    if (adminMessageShouldRenderHtml(msg)) {
        return `<div class="admin-chat-msg-text admin-chat-msg-html">${adminSanitizeMessageHtml(content)}</div>`;
    }
    return `<div class="admin-chat-msg-text">${adminEscapeHtml(content)}</div>`;
}

function adminDecodeParticipantsAttr(value) {
    try {
        return decodeURIComponent(String(value || ''));
    } catch (_) {
        return String(value || '');
    }
}

async function adminFetchAllMessages(convId) {
    const collected = [];
    let before = null;
    let guard = 0;
    while (guard++ < 50) {
        const query = new URLSearchParams({ limit: '100' });
        if (before) query.set('before', before);
        // eslint-disable-next-line no-await-in-loop
        const resp = await fetch(`/chat/messages/${encodeURIComponent(convId)}?${query.toString()}`);
        // eslint-disable-next-line no-await-in-loop
        const res = await resp.json();
        if (res.status !== 'success') {
            return { ok: false, message: res.message || 'Unknown error', messages: collected };
        }
        const page = Array.isArray(res.data) ? res.data : [];
        collected.unshift(...page);
        const pagination = res.pagination || {};
        if (!pagination.hasMore || !pagination.oldestId) break;
        before = pagination.oldestId;
    }
    return { ok: true, messages: collected };
}

function renderAdminChatTranscript(container, messages, convId) {
    const senderAlign = new Map();
    let alignToggle = 0;
    let lastDayKey = '';

    const transcript = document.createElement('div');
    transcript.className = 'admin-chat-transcript';

    messages.forEach((msg) => {
        const dayKey = formatAdminDayLabel(msg.timestamp || msg.sentAt);
        if (dayKey && dayKey !== lastDayKey) {
            lastDayKey = dayKey;
            const divider = document.createElement('div');
            divider.className = 'admin-chat-day-divider';
            divider.textContent = dayKey;
            transcript.appendChild(divider);
        }

        const senderId = String(msg.senderId || 'unknown');
        if (!senderAlign.has(senderId)) {
            senderAlign.set(senderId, alignToggle % 2 === 0 ? 'start' : 'end');
            alignToggle += 1;
        }
        const align = senderAlign.get(senderId);
        const isSystem = msg.type === 'system';
        const isDeleted = Boolean(msg.deletedAt);

        const row = document.createElement('div');
        row.className = `admin-chat-message-row align-${align}${isSystem ? ' is-system' : ''}${isDeleted ? ' is-deleted' : ''}`;

        if (!isSystem) {
            const label = document.createElement('div');
            label.className = 'admin-chat-sender-label';
            label.textContent = senderId;
            row.appendChild(label);
        }

        const bubbleClass = isDeleted
            ? 'deleted'
            : (isSystem ? 'system' : (align === 'end' ? 'sent' : 'received'));
        const bubble = document.createElement('div');
        bubble.className = `admin-chat-bubble ${bubbleClass}`;

        if (msg.replyTo && !isDeleted) {
            const quote = document.createElement('div');
            quote.className = 'admin-chat-reply-quote';
            quote.textContent = String(msg.replyTo.preview || 'Quoted message');
            bubble.appendChild(quote);
        }

        bubble.insertAdjacentHTML('beforeend', buildAdminMessageContentHtml(msg, convId));

        const footer = document.createElement('div');
        footer.className = 'admin-chat-msg-footer';
        footer.innerHTML = `<span>${adminEscapeHtml(formatAdminMessageInstant(msg.timestamp || msg.sentAt))}</span><span class="admin-chat-status-badge">${adminEscapeHtml(msg.status || 'sent')}</span>`;
        bubble.appendChild(footer);
        row.appendChild(bubble);
        transcript.appendChild(row);
    });

    container.innerHTML = '';
    container.appendChild(transcript);
    container.scrollTop = container.scrollHeight;
}

function removeConversationRowFromTable(convId) {
    const table = document.getElementById('first-table');
    const tbody = table?.querySelector('tbody');
    if (!tbody) return;
    tbody.querySelector(`tr[data-conversation-id="${CSS.escape(String(convId))}"]`)?.remove();
    if (!tbody.querySelector('tr[data-conversation-id]')) {
        tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4 text-muted">No conversations found.</td></tr>';
    }
}

async function adminViewChat(convId, participants) {
    if (!adminCanReviewHistory) return;
    const modalEl = document.getElementById('adminChatViewModal');
    const titleEl = document.getElementById('adminChatTitle');
    const subTitleEl = document.getElementById('adminChatSubtitle');
    const metaEl = document.getElementById('adminChatMeta');
    const container = document.getElementById('adminChatContainer');

    titleEl.textContent = participants || 'Conversation';
    subTitleEl.textContent = `Conversation ID: ${convId}`;
    metaEl.textContent = '';
    container.innerHTML = '<div class="admin-chat-empty-state"><div class="spinner-border text-primary mb-3" role="status"></div><div>Loading message history…</div></div>';

    const bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
    bsModal.show();

    try {
        const history = await adminFetchAllMessages(convId);
        if (!history?.ok) {
            container.innerHTML = `<div class="p-4"><div class="alert alert-danger mb-0">Failed to load messages: ${adminEscapeHtml(history?.message || 'Unknown error')}</div></div>`;
            return;
        }
        const messages = Array.isArray(history.messages) ? history.messages : [];
        metaEl.textContent = `${messages.length} message${messages.length === 1 ? '' : 's'}`;

        if (!messages.length) {
            container.innerHTML = '<div class="admin-chat-empty-state"><i class="bi bi-chat-square-text fs-2 mb-2"></i><div>No messages in this conversation.</div></div>';
            return;
        }

        renderAdminChatTranscript(container, messages, convId);
    } catch (e) {
        console.error(e);
        container.innerHTML = '<div class="p-4"><div class="alert alert-danger mb-0">Error connecting to server.</div></div>';
    }
}

document.addEventListener('click', (event) => {
    const participantLink = event.target.closest('.admin-chat-participants-link');
    if (participantLink) {
        if (!adminCanReviewHistory) return;
        const convId = participantLink.getAttribute('data-conv-id');
        const participants = adminDecodeParticipantsAttr(participantLink.getAttribute('data-participants'));
        if (convId) adminViewChat(convId, participants);
        return;
    }
    const viewBtn = event.target.closest('.js-admin-view-chat');
    if (viewBtn) {
        const convId = viewBtn.getAttribute('data-conv-id');
        const participants = adminDecodeParticipantsAttr(viewBtn.getAttribute('data-participants'));
        if (convId) adminViewChat(convId, participants);
        return;
    }
    const deleteBtn = event.target.closest('.js-admin-delete-chat');
    if (deleteBtn) {
        const convId = deleteBtn.getAttribute('data-conv-id');
        if (convId) adminDeleteChat(convId);
    }
});

async function adminDeleteChat(convId) {
    let isConfirmed = false;
    if (typeof window.showMessageModal === 'function') {
        const result = await window.showMessageModal({
            title: 'Delete Conversation',
            icon: 'warning',
            message: '<strong>⚠️ ADMIN ACTION</strong><br><br>Are you sure you want to delete this? This will permanently delete the conversation history and <strong>ALL attached files</strong> for all participants.',
            buttons: [
                { text: 'Cancel', class: 'btn-secondary' },
                { text: 'Delete', class: 'btn-danger' }
            ]
        });
        if (result === 'Delete') isConfirmed = true;
    } else {
        isConfirmed = confirm("⚠️ ADMIN ACTION: Are you sure?\n\nThis will permanently delete the conversation history and ALL attached files for all participants.");
    }

    if (!isConfirmed) return;

    const deleteButtons = document.querySelectorAll(`tr[data-conversation-id="${CSS.escape(String(convId))}"] .delete-btn`);
    deleteButtons.forEach((button) => { button.disabled = true; });

    try {
        const resp = await fetch(`/chat/delete/${encodeURIComponent(convId)}`, { method: 'DELETE' });
        const res = await resp.json();

        if (res.status === 'success') {
            removeConversationRowFromTable(convId);
            if (typeof window.showMessageModal === 'function') {
                await window.showMessageModal({
                    title: 'Deleted',
                    icon: 'success',
                    message: 'Conversation and files deleted successfully.',
                    buttons: [{ text: 'OK', class: 'btn-success' }]
                });
            }
            return;
        }

        deleteButtons.forEach((button) => { button.disabled = false; });
        const errMsg = `Failed: ${res.message || 'Unable to delete conversation.'}`;
        if (typeof window.showMessageModal === 'function') {
            await window.showMessageModal({ title: 'Error', icon: 'error', message: errMsg });
        } else {
            alert(errMsg);
        }
    } catch (e) {
        console.error(e);
        deleteButtons.forEach((button) => { button.disabled = false; });
        const errMsg = 'Error connecting to server.';
        if (typeof window.showMessageModal === 'function') {
            await window.showMessageModal({ title: 'Connection Error', icon: 'error', message: errMsg });
        } else {
            alert(errMsg);
        }
    }
}
</script>