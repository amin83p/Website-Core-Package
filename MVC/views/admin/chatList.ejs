<% const adminChatAccess = (typeof chatAccess !== 'undefined' && chatAccess) ? chatAccess : {}; %>
<% const canReviewHistory = !!adminChatAccess.canReviewConversationHistory; %>
<% const canDeleteAllChats = !!adminChatAccess.canDeleteAll; %>
<%
  const chatOrphanAuditSecondRow = canDeleteAllChats
    ? [`<div class="w-100 d-flex justify-content-end flex-wrap"><button type="button" class="btn btn-outline-primary btn-md mb-2" id="adminOrphanAuditBtn" onclick="adminOpenOrphanAuditModal()"><i class="bi bi-folder-x me-1"></i> Audit orphan attachments</button></div>`]
    : [];
%>

<%- include('../partials/tablePages-start', {
  title,
  newUrl,
  newLabel: null,
  user,
  tableName: 'System Conversations',
  print,
  btn_export: true,
  optionalToolbarSecondRow: chatOrphanAuditSecondRow
}) %>

<%- include('../partials/tablePages-search', {
    placeholder: 'Search conversations...',
    fields: []
  }) %>

<div class="table-scroll-wrapper" data-floating-row-actions="true">
  <table class="table-responsive size-md" id="first-table">
    <thead>
      <tr>
        <th class="draggable">ID<span class="sort-icon"></span></th>
        <th class="draggable">Participants<span class="sort-icon"></span></th>
        <th class="draggable">Started<span class="sort-icon"></span></th>
        <th class="draggable">Last Active<span class="sort-icon"></span></th>
        <th class="draggable">Last Message<span class="sort-icon"></span></th>
        <th class="draggable">Total Size<span class="sort-icon"></span></th>
        <th class="draggable">Msgs<span class="sort-icon"></span></th>
        <th class="text-end pe-4">Action</th>
      </tr>
    </thead>

    <tbody>
      <% (data || []).forEach(conv => { %>
        <tr data-conversation-id="<%= conv.id %>">
          <td>
            <span class="text-muted small"><%= conv.id %></span>
          </td>
          
          <td>
            <% if (canReviewHistory) { %>
              <button
                type="button"
                class="btn btn-link p-0 border-0 text-start admin-chat-participants-link"
                data-conv-id="<%= conv.id %>"
                data-participants="<%= encodeURIComponent(conv.participants || '') %>"
                title="Review conversation">
                <i class="bi bi-people-fill text-secondary me-1"></i>
                <span class="fw-bold text-dark text-decoration-underline"><%= conv.participants %></span>
              </button>
            <% } else { %>
              <i class="bi bi-people-fill text-secondary me-1"></i>
              <span class="fw-bold text-dark"><%= conv.participants %></span>
            <% } %>
          </td>

          <td>
            <%= typeof formatOrgDateTime === 'function' ? formatOrgDateTime(conv.startDate, { month: 'short', day: 'numeric', year: 'numeric' }) : new Date(conv.startDate).toLocaleDateString() %>
            <div class="text-muted x-small"><%= typeof formatOrgDateTime === 'function' ? formatOrgDateTime(conv.startDate, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', hour12: true }) : new Date(conv.startDate).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'}) %></div>
          </td>

          <td>
            <%= typeof formatOrgDateTime === 'function' ? formatOrgDateTime(conv.updatedAt, { month: 'short', day: 'numeric', year: 'numeric' }) : new Date(conv.updatedAt).toLocaleDateString() %>
            <div class="text-muted x-small"><%= typeof formatOrgDateTime === 'function' ? formatOrgDateTime(conv.updatedAt, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', hour12: true }) : new Date(conv.updatedAt).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'}) %></div>
          </td>

          <td>
            <div class="text-truncate" style="max-width: 200px;" title="<%= conv.lastMsg %>">
                <%= conv.lastMsg %>
            </div>
          </td>

          <td>
            <span class="badge bg-light text-dark border"><%= conv.sizeStr %></span>
          </td>

          <td>
            <span class="badge bg-secondary rounded-pill"><%= conv.msgCount %></span>
          </td>

          <td class="table-actions text-end pe-4">
            <% if (canReviewHistory || canDeleteAllChats) { %>
              <div class="row-actions-wrap">
                <button
                  type="button"
                  class="btn btn-secondary btn-sm btn-row-actions-toggle"
                  data-row-actions-id="<%= conv.id %>"
                  title="Row actions">
                  <i class="bi bi-three-dots-vertical"></i>
                </button>
                <div class="row-actions-menu d-none" data-row-actions-id="<%= conv.id %>">
                  <% if (canReviewHistory) { %>
                    <button
                      type="button"
                      class="btn btn-outline-primary btn-sm js-admin-view-chat"
                      data-conv-id="<%= conv.id %>"
                      data-participants="<%= encodeURIComponent(conv.participants || '') %>">
                      <i class="bi bi-eye me-2"></i>View history
                    </button>
                  <% } %>
                  <% if (canDeleteAllChats) { %>
                    <button
                      type="button"
                      class="btn btn-outline-danger btn-sm js-admin-delete-chat delete-btn"
                      data-conv-id="<%= conv.id %>">
                      <i class="bi bi-trash me-2"></i>Delete
                    </button>
                  <% } %>
                </div>
              </div>
            <% } else { %>
              <span class="text-muted small">—</span>
            <% } %>
          </td>
        </tr>
      <% }) %>

      <% if (!data || data.length === 0) { %>
        <tr>
            <td colspan="8" class="text-center py-4 text-muted">No conversations found.</td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/tablePages-end') %>

<div class="modal fade" id="adminOrphanAuditModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl">
    <div class="modal-content border-0 shadow-lg">
      <div class="modal-header border-0">
        <div>
          <h5 class="modal-title fw-bold mb-1">Orphan attachment audit</h5>
          <div class="small text-muted" id="adminOrphanAuditSummary">Run an audit to find upload folders and files not referenced by conversations.</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-0">
        <div class="p-3 border-bottom bg-light d-flex flex-wrap gap-2 align-items-center">
          <button type="button" class="btn btn-filled btn-primary btn-md" id="adminOrphanAuditRunBtn" onclick="adminRunOrphanAudit()"><i class="bi bi-search me-1"></i> Run audit</button>
          <button type="button" class="btn btn-outline-secondary btn-md" onclick="adminOrphanAuditSelectAll(true)">Select all</button>
          <button type="button" class="btn btn-outline-secondary btn-md" onclick="adminOrphanAuditSelectAll(false)">Clear selection</button>
          <button type="button" class="btn btn-filled btn-danger btn-md ms-auto" id="adminOrphanAuditDeleteBtn" onclick="adminDeleteSelectedOrphans()" disabled>Delete selected</button>
        </div>
        <div id="adminOrphanAuditProgressWrap" class="px-3 py-2 border-bottom bg-white d-none" aria-live="polite">
          <div class="d-flex align-items-center gap-3">
            <div class="progress flex-grow-1" style="height: 0.55rem;">
              <div id="adminOrphanAuditProgressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width: 35%;" aria-valuenow="35" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
            <span class="small text-muted text-nowrap" id="adminOrphanAuditProgressLabel">Preparing audit…</span>
          </div>
        </div>
        <div class="table-responsive">
          <table class="table table-sm table-hover mb-0" id="adminOrphanAuditTable">
            <thead class="table-light">
              <tr>
                <th style="width:2.5rem;"></th>
                <th>Kind</th>
                <th>Conversation</th>
                <th>Path / file</th>
                <th>Size</th>
                <th>Reason</th>
                <th>Review</th>
              </tr>
            </thead>
            <tbody id="adminOrphanAuditTableBody">
              <tr><td colspan="7" class="text-center text-muted py-4">No audit results yet. Click <strong>Run audit</strong> to scan upload storage.</td></tr>
            </tbody>
          </table>
        </div>
      </div>
      <div class="modal-footer border-0 bg-light">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="adminChatViewModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg admin-chat-view-dialog">
    <div class="modal-content border-0 shadow-lg">
      <div class="modal-header admin-chat-view-header border-0">
        <div>
            <h5 class="modal-title fw-bold mb-1" id="adminChatTitle">Conversation History</h5>
            <div class="small text-muted" id="adminChatSubtitle">ID: ...</div>
            <div class="small text-muted" id="adminChatMeta"></div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body admin-chat-view-body p-0" id="adminChatContainer">
          </div>
      <div class="modal-footer border-0 bg-light">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

