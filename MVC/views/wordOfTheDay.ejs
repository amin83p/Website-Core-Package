<%- include('./partials/publicPageBackgroundStyles') %>
<section class="pte-public-page home-pro home-pte-page wod-public-page">
  <%
    const detail = (typeof wordOfDayDetail !== 'undefined' && wordOfDayDetail) ? wordOfDayDetail : null;
    const entry = detail && detail.entry ? detail.entry : null;
    const dateKey = detail && detail.dateKey ? String(detail.dateKey) : '';
    const orgId = detail && detail.orgId ? String(detail.orgId) : '';
    const summary = (typeof reactionSummary !== 'undefined' && reactionSummary) ? reactionSummary : { likes: 0, dislikes: 0, myVote: null };
    const pageErr = typeof pageError !== 'undefined' ? pageError : null;
    const uiConstants = (typeof wordOfDayUiConstants !== 'undefined' && wordOfDayUiConstants)
      ? wordOfDayUiConstants
      : { wordTypeIcon: () => 'bi-tag', difficultyIcon: () => 'bi-speedometer2' };
    const typeLabels = typeof wordTypeLabels !== 'undefined' ? wordTypeLabels : {};
    const diffLabels = typeof difficultyLabels !== 'undefined' ? difficultyLabels : {};
    const wordTypes = entry && Array.isArray(entry.wordTypes) ? entry.wordTypes : [];
    const examples = entry && Array.isArray(entry.examples) ? entry.examples : [];
    const photoUrl = entry && entry.photo && entry.photo.url ? String(entry.photo.url) : '';
    const audioUrl = entry && entry.audio && entry.audio.url ? String(entry.audio.url) : '';
    const wodFormattedDateLabel = (typeof formattedDateLabel !== 'undefined' && formattedDateLabel) ? String(formattedDateLabel) : '';
    const wodPrevDateHref = (typeof prevDateHref !== 'undefined' && prevDateHref) ? String(prevDateHref) : '';
    const wodNextDateHref = (typeof nextDateHref !== 'undefined' && nextDateHref) ? String(nextDateHref) : '';
    const wodTodayHref = (typeof todayHref !== 'undefined' && todayHref) ? String(todayHref) : '';
    const wodIsViewingToday = typeof isViewingToday !== 'undefined' && isViewingToday === true;
    const wodCanGoNext = typeof canGoNext !== 'undefined' && canGoNext === true;
    const wodShowTodayNav = typeof showTodayNav === 'undefined' ? true : Boolean(showTodayNav);
    const showDateNav = Boolean(wodPrevDateHref && wodTodayHref);
    const canExportWodSocial = typeof canExportWordOfDaySocialImage !== 'undefined' && canExportWordOfDaySocialImage === true;
    const wodBrandName = typeof wordOfDayBrandName !== 'undefined' ? String(wordOfDayBrandName || '').trim() : '';
    const socialExportExamples = examples.slice(0, 2);
    const wodSocialExportPhotoSrc = (typeof wordOfDaySocialExportPhotoSrc !== 'undefined' && wordOfDaySocialExportPhotoSrc)
      ? String(wordOfDaySocialExportPhotoSrc)
      : '';
  %>

  <div class="wod-public-topbar reveal wod-public-topbar--split">
    <a href="/" class="wod-public-back-link"><i class="bi bi-arrow-left" aria-hidden="true"></i>Back to home</a>
    <% if (canExportWodSocial && entry && wodIsViewingToday) { %>
      <button type="button" class="btn btn-outline-primary btn-sm wod-social-export-open" data-wod-social-export-open>
        <i class="bi bi-image me-1" aria-hidden="true"></i>Create social image
      </button>
    <% } %>
  </div>

  <% if (showDateNav) { %>
    <nav class="wod-public-date-nav reveal" aria-label="Browse other days">
      <a href="<%= wodPrevDateHref %>" rel="prev"><i class="bi bi-chevron-left" aria-hidden="true"></i>Previous day</a>
      <div class="wod-date-nav-group">
        <% if (wodShowTodayNav) { %>
          <a href="<%= wodTodayHref %>" class="wod-date-nav-today<%= wodIsViewingToday ? ' is-current' : '' %>">Today</a>
        <% } %>
        <% if (wodCanGoNext && wodNextDateHref) { %>
          <a href="<%= wodNextDateHref %>" rel="next">Next day<i class="bi bi-chevron-right" aria-hidden="true"></i></a>
        <% } %>
      </div>
    </nav>
  <% } %>

  <% if (pageErr && !entry) { %>
    <section class="wod-public-empty-card reveal" aria-live="polite">
      <p class="wod-public-kicker">Word of the Day</p>
      <% if (wodFormattedDateLabel) { %><p class="wod-public-date-label mb-2"><%= wodFormattedDateLabel %></p><% } %>
      <h1 class="h4 mb-2">Unavailable</h1>
      <p class="text-muted mb-0"><%= pageErr %></p>
    </section>
  <% } else if (entry) { %>
    <div class="wod-public-shell reveal">
      <header class="wod-public-hero-band" aria-labelledby="wodPublicTitle">
        <p class="wod-public-kicker">Word of the Day</p>
        <% if (wodFormattedDateLabel) { %>
          <p class="wod-public-date-label"><%= wodFormattedDateLabel %></p>
        <% } %>
      </header>

      <div class="wod-public-layout<%= photoUrl ? ' wod-public-layout--with-photo' : '' %>">
        <div class="wod-public-layout-visual">
          <% if (photoUrl) { %>
            <figure class="wod-public-hero-figure">
              <button type="button" class="wod-public-photo-btn" data-wod-photo-open data-url="<%= photoUrl %>" data-filename="<%= entry.photo.fileName || entry.word %>" data-mime="<%= entry.photo.mimeType || 'image/jpeg' %>" aria-label="Open illustration full size">
                <img src="<%= photoUrl %>" alt="<%= entry.word %> illustration">
              </button>
            </figure>
          <% } %>

          <div class="wod-public-hero-main">
            <div class="wod-public-word-row">
              <h1 id="wodPublicTitle" class="wod-public-word"><%= entry.word %></h1>
              <button type="button" class="wod-speak-btn" data-wod-speak data-speak-text="<%= entry.word %>" aria-label="Read word aloud">
                <i class="bi bi-volume-up-fill wod-speak-icon-idle" aria-hidden="true"></i>
                <i class="bi bi-stop-fill wod-speak-icon-active d-none" aria-hidden="true"></i>
              </button>
            </div>
            <% if (entry.pronunciation) { %>
              <p class="wod-public-phonetics" lang="en"><%= entry.pronunciation %></p>
            <% } %>
            <div class="wod-public-chips" aria-label="Type and difficulty">
              <% wordTypes.forEach((key) => { %>
                <span class="wod-public-chip"><i class="bi <%= uiConstants.wordTypeIcon(key) %>" aria-hidden="true"></i><%= typeLabels[key] || key %></span>
              <% }) %>
              <% if (entry.difficulty) { %>
                <span class="wod-public-chip"><i class="bi <%= uiConstants.difficultyIcon(entry.difficulty) %>" aria-hidden="true"></i><%= diffLabels[entry.difficulty] || entry.difficulty %></span>
              <% } %>
            </div>
            <% if (entry.authorName) { %>
              <p class="wod-public-meta-lines">Contributed by <strong><%= entry.authorName %></strong></p>
            <% } %>
            <% if (audioUrl) { %>
              <div class="wod-hero-audio wod-stylish-audio-player wod-stylish-audio-player--editorial" data-wod-audio-player>
                <audio class="wod-audio-element" preload="metadata" playsinline>
                  <source src="<%= audioUrl %>" type="<%= entry.audio.mimeType || 'audio/mpeg' %>">
                </audio>
                <div class="wod-audio-player-inner">
                  <button type="button" class="wod-audio-play-toggle" data-wod-audio-play aria-label="Play pronunciation">
                    <i class="bi bi-play-fill wod-audio-icon-play" aria-hidden="true"></i>
                    <i class="bi bi-pause-fill wod-audio-icon-pause d-none" aria-hidden="true"></i>
                  </button>
                  <div class="wod-audio-player-main">
                    <input type="range" class="form-range wod-audio-seek" data-wod-audio-seek min="0" max="100" value="0" step="0.1" aria-label="Seek pronunciation">
                    <div class="wod-audio-times">
                      <span data-wod-audio-current>0:00</span>
                      <span data-wod-audio-duration>0:00</span>
                    </div>
                  </div>
                </div>
              </div>
            <% } %>
          </div>
        </div>

        <article class="wod-public-article wod-public-layout-reading">
          <% if (entry.meaning) { %>
            <section class="wod-public-section" aria-labelledby="wodMeaningHeading">
              <div class="wod-public-section-heading-row">
                <h2 id="wodMeaningHeading" class="wod-public-section-label">Meaning</h2>
                <button type="button" class="wod-speak-btn" data-wod-speak data-speak-text="<%= entry.meaning %>" aria-label="Read meaning aloud">
                  <i class="bi bi-volume-up-fill wod-speak-icon-idle" aria-hidden="true"></i>
                  <i class="bi bi-stop-fill wod-speak-icon-active d-none" aria-hidden="true"></i>
                </button>
              </div>
              <p class="wod-public-meaning"><%= entry.meaning %></p>
            </section>
          <% } %>

          <% if (examples.length) { %>
            <section class="wod-public-section" aria-labelledby="wodExamplesHeading">
              <h2 id="wodExamplesHeading" class="wod-public-section-label">In context</h2>
              <ol class="wod-public-examples">
                <% examples.forEach((ex) => { %>
                  <li class="wod-public-example-row">
                    <span class="wod-public-example-text"><%= ex %></span>
                    <button type="button" class="wod-speak-btn" data-wod-speak data-speak-text="<%= ex %>" aria-label="Read example aloud">
                      <i class="bi bi-volume-up-fill wod-speak-icon-idle" aria-hidden="true"></i>
                      <i class="bi bi-stop-fill wod-speak-icon-active d-none" aria-hidden="true"></i>
                    </button>
                  </li>
                <% }) %>
              </ol>
            </section>
          <% } %>

          <% if (entry.videoUrl) { %>
            <section class="wod-public-section" aria-label="Video">
              <h2 class="wod-public-section-label">Video</h2>
              <a href="<%= entry.videoUrl %>" class="btn btn-outline-primary wod-public-video-link" target="_blank" rel="noopener noreferrer"><i class="bi bi-play-btn me-1"></i>Watch video</a>
            </section>
          <% } %>

          <section class="wod-public-section" id="wodReactionPanel" data-wod-reaction-panel
            data-entry-id="<%= entry.id %>"
            data-org-id="<%= orgId %>"
            data-date-key="<%= dateKey %>"
            data-my-vote="<%= summary.myVote || '' %>">
            <h2 class="wod-public-section-label">Your feedback</h2>
            <p class="wod-public-reactions-intro">Your ideas help us improve our word choices.<% if (!user) { %> You can vote without signing in.<% } %></p>
            <div class="wod-public-reactions">
              <button type="button" class="btn btn-outline-success btn-vote<%= summary.myVote === 'like' ? ' is-active-like' : '' %>" data-wod-vote="like">
                <i class="bi bi-hand-thumbs-up me-1"></i>Like
              </button>
              <button type="button" class="btn btn-outline-danger btn-vote<%= summary.myVote === 'dislike' ? ' is-active-dislike' : '' %>" data-wod-vote="dislike">
                <i class="bi bi-hand-thumbs-down me-1"></i>Dislike
              </button>
            </div>
            <div id="wodDislikeFeedback" class="wod-dislike-feedback is-hidden" role="region" aria-labelledby="wodDislikeFeedbackTitle" hidden>
              <p id="wodDislikeFeedbackTitle" class="mb-2 fw-semibold">Would you share why this word didn’t work for you?</p>
              <p class="text-muted small mb-2">Your ideas help us improve our word choices. Your comment is saved without your name. We keep it for staff review only; it is not shown on this page.</p>
              <label class="visually-hidden" for="wodDislikeComment">Optional reason</label>
              <textarea id="wodDislikeComment" class="form-control" rows="3" maxlength="2000" placeholder="Optional — tell us what would have worked better"></textarea>
              <div class="wod-dislike-feedback-actions">
                <button type="button" class="btn btn-danger btn-sm" data-wod-dislike-submit>Submit dislike</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" data-wod-dislike-skip">Skip</button>
                <button type="button" class="btn btn-link btn-sm text-decoration-none" data-wod-dislike-cancel>Cancel</button>
              </div>
            </div>
          </section>
        </article>
      </div>
    </div>
  <% } else { %>
    <section class="wod-public-empty-card reveal">
      <p class="wod-public-kicker">Word of the Day</p>
      <% if (wodFormattedDateLabel) { %><p class="wod-public-date-label mb-2"><%= wodFormattedDateLabel %></p><% } %>
      <h1 class="h4">No word yet</h1>
      <p class="text-muted mb-0">No approved word is scheduled for this day yet.</p>
    </section>
  <% } %>
</section>

<% if (canExportWodSocial && entry && wodIsViewingToday) { %>
  <div id="wodSocialExportStage" class="wod-social-export-stage" aria-hidden="true">
    <div id="wodSocialExportCard" class="wod-social-export-card" data-wod-social-export-card>
      <style>
        #wodSocialExportCard,#wodSocialExportCard *{box-sizing:border-box}
        #wodSocialExportCard{background:linear-gradient(160deg,#f8fafc 0%,#eef4fb 48%,#e8f1fa 100%);border:1px solid rgba(10,102,194,.15);border-radius:var(--wod-ex-radius,24px);color:#0f172a;display:flex;flex-direction:column;font-family:Georgia,'Times New Roman',serif;height:100%;overflow:hidden;padding:var(--wod-ex-pad,52px)}
        #wodSocialExportCard .wod-social-export-card__inner{display:flex;flex:1;flex-direction:column;gap:var(--wod-ex-block-gap,18px);height:100%;min-height:0;overflow:hidden}
        #wodSocialExportCard .wod-social-export-block{display:flex;flex-direction:column;flex-shrink:0;gap:var(--wod-ex-gap,14px);min-width:0}
        #wodSocialExportCard .wod-social-export-block--head{gap:calc(var(--wod-ex-gap,14px) * .55)}
        #wodSocialExportCard .wod-social-export-kicker{color:#0a66c2;font-size:var(--wod-ex-kicker,30px);font-weight:600;letter-spacing:.06em;line-height:1.15;margin:0;text-transform:uppercase}
        #wodSocialExportCard .wod-social-export-date{color:#64748b;font-family:system-ui,sans-serif;font-size:var(--wod-ex-date,24px);line-height:1.2;margin:0}
        #wodSocialExportCard .wod-social-export-photo-wrap{border-radius:var(--wod-ex-photo-radius,18px);flex-shrink:0;max-height:var(--wod-ex-photo-max,320px);overflow:hidden}
        #wodSocialExportCard .wod-social-export-photo{display:block;height:auto;max-height:var(--wod-ex-photo-max,320px);object-fit:cover;width:100%}
        #wodSocialExportCard .wod-social-export-word{font-size:var(--wod-ex-word,88px);font-weight:500;line-height:1.08;margin:0;word-break:break-word}
        #wodSocialExportCard .wod-social-export-pronunciation{color:#475569;font-family:system-ui,sans-serif;font-size:var(--wod-ex-pron,28px);font-style:italic;line-height:1.25;margin:0}
        #wodSocialExportCard .wod-social-export-chips{display:flex;flex-wrap:wrap;font-family:system-ui,sans-serif;gap:calc(var(--wod-ex-gap,14px) * .65)}
        #wodSocialExportCard .wod-social-export-chip{background:rgba(10,102,194,.1);border-radius:999px;color:#0a66c2;font-size:var(--wod-ex-chip,22px);font-weight:600;line-height:1.2;padding:.3em .85em}
        #wodSocialExportCard .wod-social-export-meaning{font-family:system-ui,sans-serif;font-size:var(--wod-ex-meaning,30px);line-height:1.4;margin:0}
        #wodSocialExportCard .wod-social-export-examples{font-family:system-ui,sans-serif;font-size:var(--wod-ex-example,26px);line-height:1.45;margin:0;padding-left:1.25em}
        #wodSocialExportCard .wod-social-export-examples li{margin:.15em 0}
        #wodSocialExportCard .wod-social-export-brand{color:#64748b;font-family:system-ui,sans-serif;font-size:var(--wod-ex-brand,22px);font-weight:600;line-height:1.2;margin:var(--wod-ex-brand-margin,0);text-align:right}
        #wodSocialExportCard[data-wod-export-layout="story"] .wod-social-export-card__inner{justify-content:space-between}
        #wodSocialExportCard[data-wod-export-layout="landscape"] .wod-social-export-card__inner{column-gap:var(--wod-ex-gap,14px);display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.12fr);grid-template-rows:auto minmax(0,1fr) auto}
        #wodSocialExportCard[data-wod-export-layout="landscape"] .wod-social-export-block--head{grid-column:1/-1}
        #wodSocialExportCard[data-wod-export-layout="landscape"] .wod-social-export-block--visual{align-self:stretch;grid-column:1;grid-row:2}
        #wodSocialExportCard[data-wod-export-layout="landscape"] .wod-social-export-block--main{align-self:center;grid-column:2;grid-row:2}
        #wodSocialExportCard[data-wod-export-layout="landscape"] .wod-social-export-block--foot{grid-column:1/-1}
        #wodSocialExportCard[data-wod-export-layout="landscape"] .wod-social-export-photo-wrap,#wodSocialExportCard[data-wod-export-layout="landscape"] .wod-social-export-photo{height:100%;max-height:100%;object-fit:cover}
      </style>
      <div class="wod-social-export-card__inner">
        <div class="wod-social-export-block wod-social-export-block--head">
          <p class="wod-social-export-kicker">Word of the Day</p>
          <% if (wodFormattedDateLabel) { %><p class="wod-social-export-date"><%= wodFormattedDateLabel %></p><% } %>
        </div>
        <% if (photoUrl && wodSocialExportPhotoSrc) { %>
          <div class="wod-social-export-block wod-social-export-block--visual">
            <div class="wod-social-export-photo-wrap">
              <img class="wod-social-export-photo" src="<%= wodSocialExportPhotoSrc %>" alt="" />
            </div>
          </div>
        <% } %>
        <div class="wod-social-export-block wod-social-export-block--main">
          <h2 class="wod-social-export-word" data-wod-export-word><%= entry.word %></h2>
          <% if (entry.pronunciation) { %><p class="wod-social-export-pronunciation"><%= entry.pronunciation %></p><% } %>
          <% if (wordTypes.length || entry.difficulty) { %>
            <div class="wod-social-export-chips">
              <% wordTypes.forEach((key) => { %>
                <span class="wod-social-export-chip"><%= typeLabels[key] || key %></span>
              <% }) %>
              <% if (entry.difficulty) { %>
                <span class="wod-social-export-chip"><%= diffLabels[entry.difficulty] || entry.difficulty %></span>
              <% } %>
            </div>
          <% } %>
          <% if (entry.meaning) { %>
            <p class="wod-social-export-meaning"><%= entry.meaning %></p>
          <% } %>
        </div>
        <div class="wod-social-export-block wod-social-export-block--foot">
          <% if (socialExportExamples.length) { %>
            <ol class="wod-social-export-examples">
              <% socialExportExamples.forEach((ex) => { %>
                <li><%= ex %></li>
              <% }) %>
            </ol>
          <% } %>
          <% if (wodBrandName) { %>
            <p class="wod-social-export-brand"><%= wodBrandName %></p>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="wodSocialExportModal" tabindex="-1" aria-labelledby="wodSocialExportModalLabel" aria-hidden="true" data-wod-social-export>
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title h5" id="wodSocialExportModalLabel">Create social image</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p class="text-muted small">Choose a preset or set custom width and height (600–1920 px) for Facebook or Instagram.</p>
          <div class="d-flex flex-wrap gap-2 mb-3" role="group" aria-label="Size presets">
            <button type="button" class="btn btn-outline-secondary btn-sm" data-wod-social-preset="1080x1080">Square post · 1080×1080</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" data-wod-social-preset="1080x1920">Story · 1080×1920</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" data-wod-social-preset="1200x630">Facebook link · 1200×630</button>
          </div>
          <div class="row g-2 mb-3">
            <div class="col-6">
              <label class="form-label small fw-semibold" for="wodSocialExportWidth">Width (px)</label>
              <input type="number" class="form-control form-control-sm" id="wodSocialExportWidth" data-wod-social-width min="600" max="1920" step="1" value="1080" />
            </div>
            <div class="col-6">
              <label class="form-label small fw-semibold" for="wodSocialExportHeight">Height (px)</label>
              <input type="number" class="form-control form-control-sm" id="wodSocialExportHeight" data-wod-social-height min="600" max="1920" step="1" value="1080" />
            </div>
          </div>
          <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" id="wodSocialExportAspectLock" data-wod-social-aspect-lock checked />
            <label class="form-check-label small" for="wodSocialExportAspectLock">Keep aspect ratio when resizing</label>
          </div>
          <div class="wod-social-export-preview-wrap" data-wod-social-preview-wrap>
            <div class="wod-social-export-preview-scaler" data-wod-social-preview-scaler></div>
          </div>
          <p class="small text-danger d-none mb-0" data-wod-social-export-error role="alert"></p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-primary" data-wod-social-download>
            <i class="bi bi-download me-1" aria-hidden="true"></i>Download PNG
          </button>
        </div>
      </div>
    </div>
  </div>

  <script type="application/json" id="wodSocialExportPayload"><%- JSON.stringify({
    dateKey,
    word: entry.word,
    brandName: wodBrandName
  }) %></script>
  <script src="<%= typeof staticAssetUrl === 'function' ? staticAssetUrl('/scripts/vendor/html-to-image.js') : '/scripts/vendor/html-to-image.js' %>"></script>
<% } %>

<% if (entry && photoUrl) { %>
  <%- include('./partials/modal_ImageViewer') %>
<% } %>