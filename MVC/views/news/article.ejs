}

.news-article-hero-title-line1 {
  animation: newsTitleReveal 0.85s cubic-bezier(0.22, 1, 0.36, 1) both;
  display: block;
}

@media (min-width: 992px) {
  .news-article-hero-title-line1 { grid-area: title-line1; }
  .news-article-hero-title-line1 {
    box-sizing: border-box;
    margin-left: calc(50% - 50vw);
    padding-left: calc(50vw - 50%);
    padding-right: calc(50vw - 50%);
    width: 100vw;
  }
  .news-article-hero-title-rest {
    display: block;
    grid-area: title-rest;
  }
  .news-article-hero-title-rest:empty { display: none; }
}

