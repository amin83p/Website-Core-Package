  left: -9999px;
  pointer-events: none;
  position: absolute;
  top: 0;
  visibility: hidden;
}

@keyframes newsTitleReveal {
  from {
    clip-path: inset(0 100% 0 0);
    opacity: 0.2;
    transform: translateX(-12px);
  }
  to {
    clip-path: inset(0 0 0 0);
    opacity: 1;
    transform: translateX(0);
  }
}

.news-article-hero-details {
  position: relative;
}

@media (min-width: 992px) {
  .news-article-hero-details { grid-area: details; }
}

.news-article-hero-summary {
  color: var(--news-muted);
  font-size: clamp(1.02rem, 1.7vw, 1.25rem);
  line-height: 1.72;
  margin-bottom: 0;
}

.news-article-hero .news-article-author-band { margin-top: 1.5rem; }

.news-hero-orbit { inset: 0; pointer-events: none; position: absolute; }
.news-hero-orbit span { border: 1px solid rgba(29,95,184,0.18); border-radius: 999px; position: absolute; }
