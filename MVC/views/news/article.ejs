    display: grid;
    grid-template-areas:
      "title-line1 title-line1"
      "title-rest media"
      "details media";
    grid-template-columns: minmax(0, 1fr) minmax(260px, min(42%, 520px));
    row-gap: clamp(0.35rem, 1vw, 0.65rem);
  }
