    function looksLikeHtmlMarkup(text) {
        const token = String(text || '').trim();
        if (token.length < 4) return false;
        return /<(?:p|h[1-6]|ul|ol|li|img|a|div|br|strong|em)\b/i.test(token)
            || /<[a-z][a-z0-9]*\b[^>]*>[\s\S]*<\/[a-z][a-z0-9]*>/i.test(token);
    }

    function normalizeHtmlAssetUrls(html) {
        return String(html || '').replace(
            /\s(src|href)\s*=\s*(["'])(?!\/|https?:|data:|blob:|mailto:|tel:|#)([^"']+)\2/gi,
            (match, attr, quote, path) => ` ${attr}=${quote}/${String(path).replace(/^\/+/, '')}${quote}`
        );
    }

    function applyHtmlToQuillEditor(html, { replaceAll = false } = {}) {
        const source = normalizeHtmlAssetUrls(String(html || '').trim());
        if (!source) return false;
        if (replaceAll) {
            quill.setText('');
        }
        const range = quill.getSelection(true);
        const index = replaceAll ? 0 : (range ? range.index : quill.getLength());
        if (range && range.length && !replaceAll) {
            quill.deleteText(range.index, range.length, 'user');
        }
        quill.clipboard.dangerouslyPasteHTML(index, source, 'user');
        return true;
    }

    quill.root.addEventListener('paste', (event) => {
        const html = event.clipboardData && typeof event.clipboardData.getData === 'function'
            ? String(event.clipboardData.getData('text/html') || '')
            : '';
        const plain = event.clipboardData && typeof event.clipboardData.getData === 'function'
            ? String(event.clipboardData.getData('text/plain') || '')
            : '';
        if (figureEditor?.clipboardHasEmbeddedImage?.(html, plain)) {
            event.preventDefault();
            showNewsMessage(
                'Embedded image blocked',
                'Paste text only, or insert images from Inline image / Figure using the media library.'
            );
            return;
        }
        if (!html.trim() && looksLikeHtmlMarkup(plain)) {
            event.preventDefault();
            applyHtmlToQuillEditor(plain, { replaceAll: false });
        }
    });

