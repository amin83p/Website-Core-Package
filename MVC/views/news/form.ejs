<% 
  const isEdit = !!(item && item.id);
  const catList = typeof categories !== 'undefined' ? categories : [];
  const existingOrgs = (item && item.targetOrgIds) ? item.targetOrgIds : [];
  const articleAttachments = (item && item.attachments) ? item.attachments : [];
  const featuredImg = (item && item.content && item.content.featuredImage) ? item.content.featuredImage : '';
  const resolvedNewsMediaDefaultFolder = (typeof newsMediaDefaultFolder !== 'undefined' && newsMediaDefaultFolder)
    ? newsMediaDefaultFolder
    : 'news';
%>

<link href="https://cdn.jsdelivr.net/npm/quill@1.3.6/dist/quill.snow.css" rel="stylesheet">

<div class="sections-page">
  <div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="page-heading size-md m-0">
      <%= isEdit ? 'Edit Article' : 'Compose Article' %>
    </h1>
    <% if (isEdit) { %>
        <span class="badge bg-secondary border">ID: <%= item.id %></span>
    <% } %>
  </div>

  <form id="newsForm" action="<%= isEdit ? '/news/manage/edit/' + item.id : '/news/manage/new' %>" method="POST">
    <input type="hidden" name="actionStateId" value="<%= typeof actionStateId !== 'undefined' ? actionStateId : '' %>">
    
    <input type="hidden" name="htmlContent" id="hiddenHtmlContent">
    <input type="hidden" name="targetOrgIds" id="targetOrgIdsInput">
    <input type="hidden" name="attachmentRegistry" id="attachmentRegistryInput" value='<%- JSON.stringify(articleAttachments) %>'>
    
    <input type="hidden" name="featuredImage" id="featuredImageInput" value="<%= featuredImg %>">

    <script type="application/json" id="initTargetOrgs"><%- JSON.stringify(existingOrgs) %></script>
    <script type="application/json" id="initArticleAttachments"><%- JSON.stringify(articleAttachments) %></script>

    <div class="row g-4">
        
        <div class="col-lg-8">
            <div class="card p-4 border-0 shadow-sm mb-4">
                
                <div class="mb-3">
                    <label class="form-label fw-bold">Headline Title *</label>
                    <input type="text" name="title" class="form-control size-lg fw-bold" 
                           value="<%= item ? item.meta.title : '' %>" required placeholder="Enter a catchy headline...">
                </div>
                
                <div class="mb-3">
                    <label class="form-label fw-bold">Summary / Excerpt</label>
                    <textarea name="summary" class="form-control" rows="2" 
                              placeholder="Brief description for list views (optional)"><%= item ? item.content.summary : '' %></textarea>
                </div>

                <div class="d-flex justify-content-between align-items-end mb-2">
                    <label class="form-label fw-bold mb-0">Article Body</label>
                    
                    <button type="button" class="btn btn-sm btn-primary btn-filled" id="btnOpenMediaForEditor">
                        <i class="bi bi-images me-1"></i> Manage & Insert Media
                    </button>
                </div>

                <div id="editor-wrapper" class="border rounded">
                    <div id="editor-container" style="height: 600px; font-size: 16px; border:none;">
                        <%- item ? item.content.body : '' %>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white fw-bold py-3">Publishing</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Status</label>
                        <select name="status" class="form-select">
                            <option value="draft" <%= (item && item.status==='draft')?'selected':'' %>>Draft</option>
                            <option value="published" <%= (item && item.status==='published')?'selected':'' %>>Published</option>
                            <option value="archived" <%= (item && item.status==='archived')?'selected':'' %>>Archived</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Publish Date</label>
                        <input type="datetime-local" name="publishDate" class="form-control" 
                               value="<%= (item && item.meta.publishDate) ? new Date(item.meta.publishDate).toISOString().slice(0, 16) : new Date().toISOString().slice(0, 16) %>">
                    </div>
                    <hr>
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-filled">
                            <i class="bi bi-save me-1"></i> <%= isEdit ? 'Update Article' : 'Save Article' %>
                        </button>
                        <a href="/news/manage" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white fw-bold py-3">Featured Image</div>
                <div class="card-body text-center">
                    <div id="featuredImagePreview" class="mb-3 <%= featuredImg ? '' : 'd-none' %>">
                        <img src="<%= featuredImg %>" class="img-fluid rounded border shadow-sm" style="max-height: 200px; width: 100%; object-fit: cover;">
                    </div>
                    
                    <div id="featuredImagePlaceholder" class="mb-3 p-4 bg-light border rounded border-dashed <%= featuredImg ? 'd-none' : '' %>">
                        <i class="bi bi-image text-muted fs-1 opacity-50"></i>
                        <div class="small text-muted mt-2">Optional main photo</div>
                    </div>
                    
                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-outline-primary btn-sm" id="btnSetFeaturedImage">
                            <i class="bi bi-card-image me-1"></i> <%= featuredImg ? 'Replace Image' : 'Set Featured Image' %>
                        </button>
                        <button type="button" class="btn btn-outline-danger btn-sm <%= featuredImg ? '' : 'd-none' %>" id="btnRemoveFeaturedImage">
                            Remove Image
                        </button>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white fw-bold py-3">Audience & Scope</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Visibility Level</label>
                        <div class="form-check">
                            <input class="form-check-input visibility-radio" type="radio" name="visibility" id="visPublic" value="public" 
                                   <%= (!item || item.visibility==='public')?'checked':'' %>>
                            <label class="form-check-label" for="visPublic">Public (Website)</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input visibility-radio" type="radio" name="visibility" id="visUsers" value="users" 
                                   <%= (item && item.visibility==='users')?'checked':'' %>>
                            <label class="form-check-label" for="visUsers">All Logged-in Users</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input visibility-radio" type="radio" name="visibility" id="visOrg" value="org" 
                                   <%= (item && item.visibility==='org')?'checked':'' %>>
                            <label class="form-check-label" for="visOrg">Specific Organizations</label>
                        </div>
                    </div>
                    <div id="targetOrgContainer" class="d-none">
                        <label class="form-label small fw-bold text-primary">Target Organizations</label>
                        <div class="border rounded bg-light p-2 mb-2" style="max-height: 150px; overflow-y: auto;">
                            <div id="selectedOrgsList" class="d-flex flex-wrap gap-2">
                                <span class="text-muted small fst-italic p-1" id="noOrgsMsg">No organizations selected.</span>
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary w-100" id="btnAddOrg">
                            <i class="bi bi-plus-lg me-1"></i> Add Organization
                        </button>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-bold py-3">Categorization</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Category</label>
                        <select name="category" class="form-select">
                            <% catList.forEach(cat => { %>
                                <option value="<%= cat.name %>" <%= (item && item.meta.category === cat.name) ? 'selected' : '' %>>
                                    <%= cat.name %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Tags</label>
                        <input type="text" name="tags" class="form-control" placeholder="comma, separated" 
                               value="<%= (item && item.meta.tags) ? item.meta.tags.join(', ') : '' %>">
                    </div>
                </div>
            </div>

        </div>
    </div>
  </form>
</div>

<%- include('../partials/modal_GenericPicker') %>
<%- include('../partials/modal_MediaManager') %>

<script src="https://cdn.jsdelivr.net/npm/quill@1.3.6/dist/quill.js"></script>
<script>
document.addEventListener('DOMContentLoaded', () => {
    if (typeof window.Quill !== 'function') {
        console.error('[news/form] Quill failed to load (check Content-Security-Policy).');
        if (typeof showMessageModal === 'function') {
            showMessageModal({
                title: 'Editor Unavailable',
                icon: 'error',
                message: 'The rich text editor could not load. Refresh the page or contact support if this continues.',
                buttons: [{ text: 'OK', class: 'btn-primary', value: 'ok' }]
            });
        }
        return;
    }
    const attachmentRegistryInput = document.getElementById('attachmentRegistryInput');
    const NEWS_MEDIA_DEFAULT_FOLDER = <%- JSON.stringify(resolvedNewsMediaDefaultFolder) %>;
    const mediaManagerModalEl = document.getElementById('mediaManagerModal');
    const mediaManagerModal = (window.bootstrap && window.bootstrap.Modal && mediaManagerModalEl)
        ? window.bootstrap.Modal.getOrCreateInstance(mediaManagerModalEl)
        : null;
    const mediaManagerModalApi = (window.MediaManagerModal && typeof window.MediaManagerModal.open === 'function')
        ? window.MediaManagerModal
        : null;
    const newsMediaLibraryCache = new Map();

    let articleAttachments = JSON.parse(document.getElementById('initArticleAttachments').textContent || '[]');

    const quill = new Quill('#editor-container', {
        theme: 'snow',
        placeholder: 'Write your story...',
        modules: { toolbar: [
            [{ header: [1, 2, 3, false] }],
            ['bold', 'italic', 'underline', 'strike', 'blockquote'],
            [{ color: [] }, { background: [] }],
            [{ list: 'ordered' }, { list: 'bullet' }],
            [{ align: [] }],
            ['link', 'image', 'video'], ['clean']
        ]}
    });

    function syncAttachmentRegistry() {
        attachmentRegistryInput.value = JSON.stringify(articleAttachments);
    }
    syncAttachmentRegistry();

    async function showNewsMessage(title, message, icon = 'error') {
        if (typeof showMessageModal === 'function') {
            await showMessageModal({
                title,
                icon,
                message,
                buttons: [{ text: 'OK', class: icon === 'success' ? 'btn-success' : 'btn-primary', value: 'ok' }]
            });
            return;
        }
        alert(message);
    }

    function resolveMediaRowUrl(row = {}) {
        const url = String(row.url || row.path || '').trim();
        if (!url) return '';
        if (/^\/uploads\//i.test(url)) return url;
        const match = url.match(/\/uploads\/(.+)$/i);
        if (match && match[1]) return `/uploads/${match[1].replace(/^\/+/, '')}`;
        return url;
    }

    function inferMediaTypeFromRow(row = {}) {
        const name = String(row.name || row.originalName || row.filename || '').toLowerCase();
        const ext = name.includes('.') ? name.slice(name.lastIndexOf('.')) : '';
        const imageExt = ['.jpg', '.jpeg', '.png', '.gif', '.webp', '.svg', '.bmp', '.ico'];
        if (imageExt.includes(ext)) return 'image';
        const mime = String(row.mimeType || '').toLowerCase();
        if (mime.startsWith('image/')) return 'image';
        return 'document';
    }

    async function fetchNewsMediaLibrary(options = {}) {
        const hasFolder = Object.prototype.hasOwnProperty.call(options || {}, 'folder');
        const folder = hasFolder ? String(options.folder ?? '').trim() : '';
        const cacheKey = hasFolder ? `folder:${folder}` : '__default__';
        if (!options.forceRefresh && newsMediaLibraryCache.has(cacheKey)) {
            return newsMediaLibraryCache.get(cacheKey);
        }

        let endpoint = '/news/api/media/library';
        if (hasFolder) {
            endpoint += `${endpoint.includes('?') ? '&' : '?'}folder=${encodeURIComponent(folder)}`;
        }
        const response = await fetch(endpoint, {
            method: 'GET',
            headers: { 'X-AJAX-Request': 'true', Accept: 'application/json' },
            credentials: 'include'
        });
        const result = await response.json().catch(() => null);
        if (!response.ok || !result || result.status !== 'success') {
            throw new Error((result && result.message) || `Unable to load news media (status ${response.status}).`);
        }

        const payload = {
            rows: Array.isArray(result.results) ? result.results : [],
            message: String(result.message || '').trim() || 'News media loaded.',
            folders: Array.isArray(result.folders) ? result.folders : [],
            currentFolder: String(result.currentFolder || folder || '').trim(),
            parentFolder: String(result.parentFolder || '').trim(),
            defaultFolder: String(result.defaultFolder || NEWS_MEDIA_DEFAULT_FOLDER).trim() || NEWS_MEDIA_DEFAULT_FOLDER,
            defaults: result.defaults && typeof result.defaults === 'object' ? result.defaults : null
        };
        newsMediaLibraryCache.set(cacheKey, payload);
        return payload;
    }

    async function uploadNewsMediaFiles(files = [], context = {}) {
        const inputFiles = Array.isArray(files) ? files.filter(Boolean) : [];
        if (!inputFiles.length) throw new Error('No files selected for upload.');

        const uploadFolder = String(context.currentFolder || context.defaultFolder || NEWS_MEDIA_DEFAULT_FOLDER).trim()
            || NEWS_MEDIA_DEFAULT_FOLDER;
        const formData = new FormData();
        inputFiles.forEach((file) => formData.append('files', file));
        formData.set('folder', uploadFolder);

        const response = await fetch('/news/api/upload', {
            method: 'POST',
            headers: { 'X-AJAX-Request': 'true', Accept: 'application/json' },
            credentials: 'include',
            body: formData
        });
        const result = await response.json().catch(() => null);
        if (!response.ok || !result || result.status !== 'success') {
            throw new Error((result && result.message) || `Upload failed (status ${response.status}).`);
        }

        newsMediaLibraryCache.clear();
        const rows = Array.isArray(result.results)
            ? result.results
            : (Array.isArray(result.rows) ? result.rows : []);
        return {
            rows,
            message: String(result.message || '').trim() || `Uploaded ${rows.length} file(s).`
        };
    }

    function applyFeaturedImage(imageUrl) {
        const url = String(imageUrl || '').trim();
        if (!url) return;
        document.getElementById('featuredImageInput').value = url;
        const preview = document.getElementById('featuredImagePreview');
        preview.querySelector('img').src = url;
        preview.classList.remove('d-none');
        document.getElementById('featuredImagePlaceholder').classList.add('d-none');
        document.getElementById('btnSetFeaturedImage').innerHTML = '<i class="bi bi-card-image me-1"></i> Replace Image';
        document.getElementById('btnRemoveFeaturedImage').classList.remove('d-none');
    }

    function insertMediaIntoEditor(row = {}) {
        const url = resolveMediaRowUrl(row);
        if (!url) throw new Error('Selected media has no URL.');
        const name = String(row.name || row.originalName || row.filename || 'Media').trim() || 'Media';
        const type = inferMediaTypeFromRow(row);
        if (!articleAttachments.some((entry) => entry.url === url)) {
            articleAttachments.push({ url, type, name });
            syncAttachmentRegistry();
        }
        const range = quill.getSelection(true);
        if (type === 'image') {
            quill.insertEmbed(range.index, 'image', url);
        } else {
            quill.insertText(range.index, ` ${name} `, 'link', url);
        }
    }

    async function openNewsMediaPicker(mode) {
        if (!mediaManagerModalApi || typeof mediaManagerModalApi.open !== 'function') {
            await showNewsMessage('Media Library Unavailable', 'The media manager is not available on this page.', 'warning');
            return;
        }

        const isFeatured = mode === 'featured';
        if (typeof mediaManagerModalApi.setModalCompat === 'function' && mediaManagerModalEl && mediaManagerModal) {
            mediaManagerModalApi.setModalCompat({
                modalEl: mediaManagerModalEl,
                modalInstance: mediaManagerModal,
                open: (instance) => {
                    if (instance && typeof instance.show === 'function') instance.show();
                    return true;
                },
                close: (instance) => {
                    if (instance && typeof instance.hide === 'function') instance.hide();
                    return true;
                }
            });
        }

        await mediaManagerModalApi.open({
            title: isFeatured ? 'Select Featured Image' : 'Select Article Media',
            mode: 'assign',
            mediaKind: isFeatured ? 'image' : 'any',
            maxSelection: 1,
            defaultView: 'tile',
            defaultFolder: NEWS_MEDIA_DEFAULT_FOLDER,
            forceRefresh: true,
            onRefresh: async (query = {}) => fetchNewsMediaLibrary({
                folder: query && query.folder,
                forceRefresh: true
            }),
            onUpload: uploadNewsMediaFiles,
            onApply: async (selectedRows) => {
                const rows = Array.isArray(selectedRows) ? selectedRows : [];
                if (!rows.length) throw new Error('Select at least one file.');
                if (isFeatured) {
                    applyFeaturedImage(resolveMediaRowUrl(rows[0]));
                    return;
                }
                insertMediaIntoEditor(rows[0]);
            }
        });
    }

    document.getElementById('btnOpenMediaForEditor').addEventListener('click', () => {
        openNewsMediaPicker('editor').catch((error) => {
            showNewsMessage('Media Error', error.message || 'Unable to open media library.');
        });
    });

    document.getElementById('btnSetFeaturedImage').addEventListener('click', () => {
        openNewsMediaPicker('featured').catch((error) => {
            showNewsMessage('Media Error', error.message || 'Unable to open media library.');
        });
    });

    document.getElementById('btnRemoveFeaturedImage').addEventListener('click', () => {
        document.getElementById('featuredImageInput').value = '';
        document.getElementById('featuredImagePreview').classList.add('d-none');
        document.getElementById('featuredImagePlaceholder').classList.remove('d-none');
        document.getElementById('btnSetFeaturedImage').innerHTML = '<i class="bi bi-card-image me-1"></i> Set Featured Image';
        document.getElementById('btnRemoveFeaturedImage').classList.add('d-none');
    });
    const newsForm = document.getElementById('newsForm');
    newsForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        document.getElementById('hiddenHtmlContent').value = document.querySelector('.ql-editor').innerHTML;

        const submitBtn = newsForm.querySelector('button[type="submit"]');
        const originalHtml = submitBtn ? submitBtn.innerHTML : '';
        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Saving...';
        }

        try {
            const fd = new FormData(newsForm);
            const response = await fetch(newsForm.action, {
                method: 'POST',
                headers: {
                    'X-AJAX-Request': 'true',
                    Accept: 'application/json'
                },
                body: fd
            });
            const result = await response.json().catch(() => ({}));

            if (response.ok && result.status === 'success') {
                if (typeof showMessageModal === 'function') {
                    await showMessageModal({
                        title: 'Success',
                        icon: 'success',
                        message: result.message || 'Article saved.',
                        buttons: [{ text: 'OK', class: 'btn-success', value: 'ok' }]
                    });
                }
                window.location.href = result.redirect || '/news/manage';
                return;
            }

            const message = result.message
                || (response.status === 403
                    ? 'This page is out of date. Please refresh the page and try again.'
                    : 'Failed to save article.');
            if (typeof showMessageModal === 'function') {
                await showMessageModal({
                    title: 'Error',
                    icon: 'error',
                    message,
                    buttons: [{ text: 'OK', class: 'btn-danger', value: 'ok' }]
                });
            } else {
                alert(message);
            }
        } catch (err) {
            console.error(err);
            const message = 'An unexpected error occurred while saving the article.';
            if (typeof showMessageModal === 'function') {
                await showMessageModal({
                    title: 'System Error',
                    icon: 'error',
                    message,
                    buttons: [{ text: 'OK', class: 'btn-danger', value: 'ok' }]
                });
            } else {
                alert(message);
            }
        } finally {
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalHtml;
            }
        }
    });

    // --- 7. ORG PICKER & VISIBILITY ---
    const targetOrgsInput = document.getElementById('targetOrgIdsInput');
    const selectedOrgsList = document.getElementById('selectedOrgsList');
    const noOrgsMsg = document.getElementById('noOrgsMsg');
    
    let targetOrgIds = JSON.parse(document.getElementById('initTargetOrgs').textContent || '[]');

    function renderOrgs() {
        targetOrgIds = [...new Set(targetOrgIds)].filter(Boolean);
        selectedOrgsList.innerHTML = '';
        if (targetOrgIds.length === 0) {
            selectedOrgsList.appendChild(noOrgsMsg);
            targetOrgsInput.value = '[]';
            return;
        }

        targetOrgIds.forEach(id => {
            const badge = document.createElement('span');
            badge.className = 'badge bg-primary d-flex align-items-center gap-2';
            badge.innerHTML = `<span>Org #${id}</span><i class="bi bi-x-circle-fill cursor-pointer remove-org-btn" data-id="${id}"></i>`;
            selectedOrgsList.appendChild(badge);
        });

        targetOrgsInput.value = JSON.stringify(targetOrgIds);

        document.querySelectorAll('.remove-org-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const removeId = e.target.dataset.id;
                targetOrgIds = targetOrgIds.filter(oid => String(oid) !== String(removeId));
                renderOrgs();
            });
        });
    }

    const btnAddOrg = document.getElementById('btnAddOrg');
    if (btnAddOrg) {
        btnAddOrg.addEventListener('click', () => {
            GenericPicker.open(GenericPickerPresets.organization({
                title: 'Target Organization',
                placeholder: 'Search...',
                onSelect: (item) => {
                    if (!targetOrgIds.includes(String(item.id))) {
                        targetOrgIds.push(String(item.id));
                        renderOrgs();
                    }
                }
            }));
        });
    }
    renderOrgs();

    const orgContainer = document.getElementById('targetOrgContainer');
    const radios = document.querySelectorAll('.visibility-radio');
    function toggleOrgSelect() {
        const selected = document.querySelector('.visibility-radio:checked');
        if (selected && selected.value === 'org') {
            orgContainer.classList.remove('d-none');
        } else {
            orgContainer.classList.add('d-none');
        }
    }
    radios.forEach(r => r.addEventListener('change', toggleOrgSelect));
    toggleOrgSelect();
});
</script>

<style>
.cursor-pointer { cursor: pointer; }
.border-dashed { border-style: dashed !important; }
</style>
