<% 
  const isEdit = !!(item && item.id);
  const catList = typeof categories !== 'undefined' ? categories : [];
  const existingOrgs = (item && item.targetOrgIds) ? item.targetOrgIds : [];
  const articleAttachments = (item && item.attachments) ? item.attachments : [];
  const featuredImg = (item && item.content && item.content.featuredImage) ? item.content.featuredImage : '';
  const resolvedNewsMediaDefaultFolder = (typeof newsMediaDefaultFolder !== 'undefined' && newsMediaDefaultFolder)
    ? newsMediaDefaultFolder
    : 'news';
  const roleNotifyOptionsList = (typeof notifyRoleOptions !== 'undefined' && Array.isArray(notifyRoleOptions))
    ? notifyRoleOptions
    : [];
  const resolvedNotifyActiveOrgId = typeof notifyActiveOrgId !== 'undefined' ? String(notifyActiveOrgId || '').trim() : '';
  const resolvedNotifyOrgTimeZone = typeof notifyOrgTimeZone !== 'undefined' ? String(notifyOrgTimeZone || '').trim() : '';
  const resolvedNotifyDefaultSendAtLocal = typeof notifyDefaultSendAtLocal !== 'undefined' ? String(notifyDefaultSendAtLocal || '').trim() : '';
  const itemWasPublished = !!(item && String(item.status || '').toLowerCase() === 'published');
  const savedNotifyRoleKeys = (item && item.notifications && Array.isArray(item.notifications.roleKeys))
    ? item.notifications.roleKeys
    : [];
%>

<link href="https://cdn.jsdelivr.net/npm/quill@1.3.6/dist/quill.snow.css" rel="stylesheet">
<%- include('partials/newsArticleBodyStyles') %>

<div class="sections-page">
  <div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="page-heading size-md m-0">
      <%= isEdit ? 'Edit Article' : 'Compose Article' %>
    </h1>
    <% if (isEdit) { %>
        <span class="badge bg-secondary border">ID: <%= item.id %></span>
    <% } %>
  </div>

  <form id="newsForm" action="<%= isEdit ? '/news/manage/edit/' + item.id : '/news/manage/new' %>" method="POST">
    <input type="hidden" name="actionStateId" value="<%= typeof actionStateId !== 'undefined' ? actionStateId : '' %>">
    
    <input type="hidden" name="htmlContent" id="hiddenHtmlContent">
    <input type="hidden" name="targetOrgIds" id="targetOrgIdsInput">
    <input type="hidden" name="attachmentRegistry" id="attachmentRegistryInput" value='<%- JSON.stringify(articleAttachments) %>'>
    
    <input type="hidden" name="featuredImage" id="featuredImageInput" value="<%= featuredImg %>">

    <script type="application/json" id="initTargetOrgs"><%- JSON.stringify(existingOrgs) %></script>
    <script type="application/json" id="initArticleAttachments"><%- JSON.stringify(articleAttachments) %></script>

    <div class="row g-4">
        
        <div class="col-lg-8">
            <div class="card p-4 border-0 shadow-sm mb-4">
                
                <div class="mb-3">
                    <label class="form-label fw-bold">Headline Title *</label>
                    <input type="text" name="title" class="form-control size-lg fw-bold" 
                           value="<%= item ? item.meta.title : '' %>" required placeholder="Enter a catchy headline...">
                </div>
                
                <div class="mb-3">
                    <label class="form-label fw-bold">Summary / Excerpt</label>
                    <textarea name="summary" class="form-control" rows="2" 
                              placeholder="Brief description for list views (optional)"><%= item ? item.content.summary : '' %></textarea>
                </div>

                <div class="d-flex justify-content-between align-items-end mb-2 flex-wrap gap-2">
                    <label class="form-label fw-bold mb-0">Article Body</label>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnPasteHtmlSource" title="Paste raw HTML from a code block">
                            <i class="bi bi-code-slash me-1"></i> Paste HTML
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="btnInsertInlineImage" title="Small inline image from library">
                            <i class="bi bi-image me-1"></i> Inline image
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="btnInsertFigureImage" title="Sized figure with layout options">
                            <i class="bi bi-card-image me-1"></i> Figure
                        </button>
                        <button type="button" class="btn btn-sm btn-primary btn-filled" id="btnOpenMediaForEditor">
                            <i class="bi bi-images me-1"></i> Media library
                        </button>
                    </div>
                </div>

                <p class="small text-muted mb-2">Tip: with a left/right figure, add wrap text beside the image; press Enter twice on a blank line to start full-width content below the image.</p>
                <div id="editor-wrapper" class="border rounded">
                    <div id="editor-container" style="height: 600px; font-size: 16px; border:none;">
                        <%- item ? item.content.body : '' %>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white fw-bold py-3">Publishing</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Status</label>
                        <select name="status" class="form-select">
                            <option value="draft" <%= (item && item.status==='draft')?'selected':'' %>>Draft</option>
                            <option value="published" <%= (item && item.status==='published')?'selected':'' %>>Published</option>
                            <option value="archived" <%= (item && item.status==='archived')?'selected':'' %>>Archived</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Publish Date</label>
                        <input type="datetime-local" name="publishDate" class="form-control" 
                               value="<%= (item && item.meta.publishDate) ? new Date(item.meta.publishDate).toISOString().slice(0, 16) : new Date().toISOString().slice(0, 16) %>">
                    </div>
                    <hr>
                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-outline-primary" id="btnPreviewArticle">
                            <i class="bi bi-eye me-1"></i> Preview article
                        </button>
                        <button type="submit" class="btn btn-primary btn-filled">
                            <i class="bi bi-save me-1"></i> <%= isEdit ? 'Update Article' : 'Save Article' %>
                        </button>
                        <a href="/news/manage" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white fw-bold py-3">Featured Image</div>
                <div class="card-body text-center">
                    <div id="featuredImagePreview" class="mb-3 <%= featuredImg ? '' : 'd-none' %>">
                        <img src="<%= featuredImg %>" class="img-fluid rounded border shadow-sm" style="max-height: 200px; width: 100%; object-fit: cover;">
                    </div>
                    
                    <div id="featuredImagePlaceholder" class="mb-3 p-4 bg-light border rounded border-dashed <%= featuredImg ? 'd-none' : '' %>">
                        <i class="bi bi-image text-muted fs-1 opacity-50"></i>
                        <div class="small text-muted mt-2">Optional main photo</div>
                    </div>
                    
                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-outline-primary btn-sm" id="btnSetFeaturedImage">
                            <i class="bi bi-card-image me-1"></i> <%= featuredImg ? 'Replace Image' : 'Set Featured Image' %>
                        </button>
                        <button type="button" class="btn btn-outline-danger btn-sm <%= featuredImg ? '' : 'd-none' %>" id="btnRemoveFeaturedImage">
                            Remove Image
                        </button>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white fw-bold py-3">Audience & Scope</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Visibility Level</label>
                        <div class="form-check">
                            <input class="form-check-input visibility-radio" type="radio" name="visibility" id="visPublic" value="public" 
                                   <%= (!item || item.visibility==='public')?'checked':'' %>>
                            <label class="form-check-label" for="visPublic">Public (Website)</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input visibility-radio" type="radio" name="visibility" id="visUsers" value="users" 
                                   <%= (item && item.visibility==='users')?'checked':'' %>>
                            <label class="form-check-label" for="visUsers">All Logged-in Users</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input visibility-radio" type="radio" name="visibility" id="visOrg" value="org" 
                                   <%= (item && item.visibility==='org')?'checked':'' %>>
                            <label class="form-check-label" for="visOrg">Specific Organizations</label>
                        </div>
                    </div>
                    <div id="targetOrgContainer" class="d-none">
                        <label class="form-label small fw-bold text-primary">Target Organizations</label>
                        <div class="border rounded bg-light p-2 mb-2" style="max-height: 150px; overflow-y: auto;">
                            <div id="selectedOrgsList" class="d-flex flex-wrap gap-2">
                                <span class="text-muted small fst-italic p-1" id="noOrgsMsg">No organizations selected.</span>
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary w-100" id="btnAddOrg">
                            <i class="bi bi-plus-lg me-1"></i> Add Organization
                        </button>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4" id="newsNotifyCard">
                <div class="card-header bg-white fw-bold py-3">Email notification</div>
                <div class="card-body">
                    <% if (!resolvedNotifyActiveOrgId) { %>
                        <p class="small text-muted mb-0">Select an organization to notify members by role.</p>
                    <% } else { %>
                        <p class="small text-muted mb-2">Configure roles, recipients, and send time in a full-screen workspace.</p>
                        <div id="newsNotifySidebarStatus" class="small mb-3 text-muted">Notifications off</div>
                        <button type="button" class="btn btn-outline-primary w-100" id="btnOpenNotifyWorkspace">
                            <i class="bi bi-envelope-paper me-1"></i> Configure notifications
                        </button>
                        <input type="hidden" name="notifyRecipientsJson" id="notifyRecipientsJson" value="[]">
                        <input type="hidden" name="notifyRoleKeysHidden" id="notifyRoleKeysHidden" value="">
                        <input type="hidden" name="notifySendNow" id="notifySendNow" value="">
                        <input type="hidden" name="notifySendAtLocal" id="notifySendAtLocal" value="<%= resolvedNotifyDefaultSendAtLocal %>">
                        <input type="checkbox" class="d-none" name="notifyEnabled" id="notifyEnabled" value="1">
                        <% if (itemWasPublished) { %>
                            <input type="checkbox" class="d-none" name="notifyResend" id="notifyResend" value="1">
                        <% } %>
                    <% } %>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-bold py-3">Categorization</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Category</label>
                        <select name="category" class="form-select">
                            <% catList.forEach(cat => { %>
                                <option value="<%= cat.name %>" <%= (item && item.meta.category === cat.name) ? 'selected' : '' %>>
                                    <%= cat.name %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Tags</label>
                        <input type="text" name="tags" class="form-control" placeholder="comma, separated" 
                               value="<%= (item && item.meta.tags) ? item.meta.tags.join(', ') : '' %>">
                    </div>
                </div>
            </div>

        </div>
    </div>
  </form>
</div>

<div class="modal fade" id="pasteHtmlModal" tabindex="-1" aria-labelledby="pasteHtmlModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="pasteHtmlModalLabel">Paste HTML source</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted mb-2">Paste raw HTML (for example from a chat code block). This replaces the current article body with rendered content.</p>
                <textarea id="pasteHtmlSourceInput" class="form-control font-monospace" rows="14" placeholder="<p>Hello</p>"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnApplyPasteHtml">Apply to body</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="newsFigureModal" tabindex="-1" aria-labelledby="newsFigureModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="newsFigureModalLabel">Figure image options</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted">Choose layout and width, then pick an uploaded image from the media library.</p>
                <div class="mb-3">
                    <label class="form-label fw-semibold" for="newsFigureLayoutSelect">Layout</label>
                    <select id="newsFigureLayoutSelect" class="form-select">
                        <option value="center">Centered (text above/below)</option>
                        <option value="float-left">Float left (text wraps right)</option>
                        <option value="float-right">Float right (text wraps left)</option>
                        <option value="block">Full width block (no side text)</option>
                    </select>
                </div>
                <div class="mb-2 d-flex justify-content-between align-items-center">
                    <label class="form-label fw-semibold mb-0" for="newsFigureWidthSlider">Width</label>
                    <span class="badge bg-light text-dark border" id="newsFigureWidthLabel">72%</span>
                </div>
                <input type="range" class="form-range" id="newsFigureWidthSlider" min="25" max="100" step="1" value="72">
                <div class="d-flex flex-wrap gap-2 mt-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary news-figure-width-preset" data-width="50">50%</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary news-figure-width-preset" data-width="72">72%</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary news-figure-width-preset" data-width="100">100%</button>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnNewsFigureContinue">Choose image…</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="newsNotifyWorkspaceModal" tabindex="-1" aria-labelledby="newsNotifyWorkspaceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-fullscreen-lg-down">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="newsNotifyWorkspaceModalLabel">Email notification</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="newsNotifyPublishWarning" class="alert alert-warning d-none small py-2" role="status">
                    Set status to <strong>Published</strong> to send notifications when you save.
                </div>
                <p class="text-muted">Notify people in your active organization when this article is published. Duplicate email addresses are merged into one message.</p>
                <div class="form-check form-switch mb-4">
                    <input class="form-check-input" type="checkbox" id="notifyEnabledWorkspace" value="1">
                    <label class="form-check-label fw-semibold" for="notifyEnabledWorkspace">Send notification when published</label>
                </div>
                <div id="newsNotifyOptions">
                    <div class="row g-4">
                        <div class="col-lg-4">
                            <div class="card h-100 border-0 bg-light">
                                <div class="card-body">
                                    <h6 class="fw-bold mb-2">Notify roles</h6>
                                    <p class="small text-muted">Roles are taken from person accounts in your active organization (School, PTE, and other installed packages).</p>
                                    <div id="newsNotifyRoleSummary" class="d-flex flex-wrap gap-1 mb-3" style="min-height: 1.5rem;"></div>
                                    <div id="newsNotifyRoleContainer" class="d-none" aria-hidden="true"></div>
                                    <button type="button" class="btn btn-outline-primary" id="btnManageNotifyRoles" <%= roleNotifyOptionsList.length ? '' : 'disabled' %>>
                                        <i class="bi bi-diagram-3 me-1"></i> Manage roles
                                    </button>
                                    <% if (!roleNotifyOptionsList.length) { %>
                                        <div class="form-text mt-2">No package roles were found on active person memberships in this organization.</div>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-8">
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                                <h6 class="fw-bold mb-0">Recipients</h6>
                                <div class="d-flex flex-wrap gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-primary" id="btnLoadNotifyRecipients">
                                        <i class="bi bi-people me-1"></i> Load from roles
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" id="btnAddNotifyRecipient">
                                        <i class="bi bi-plus-lg me-1"></i> Add email
                                    </button>
                                </div>
                            </div>
                            <div class="table-responsive border rounded mb-2" style="max-height: min(50vh, 420px); overflow-y: auto;">
                                <table class="table table-sm align-middle mb-0">
                                    <thead class="table-light sticky-top">
                                        <tr>
                                            <th style="width:3rem;">Include</th>
                                            <th>Name</th>
                                            <th>Email</th>
                                            <th>Roles</th>
                                            <th style="width:3rem;"></th>
                                        </tr>
                                    </thead>
                                    <tbody id="newsNotifyRecipientsBody"></tbody>
                                </table>
                            </div>
                            <div class="small text-muted mb-4" id="newsNotifyRecipientCount">0 recipient(s)</div>
                            <h6 class="fw-bold">Send time</h6>
                            <div class="d-flex flex-wrap gap-2 mb-2">
                                <button type="button" class="btn btn-outline-success" id="btnNotifySendNow">
                                    <i class="bi bi-send me-1"></i> Send now
                                </button>
                                <button type="button" class="btn btn-outline-primary" id="btnNotifyScheduleSend">
                                    <i class="bi bi-calendar-event me-1"></i> Schedule send
                                </button>
                            </div>
                            <% if (resolvedNotifyOrgTimeZone) { %>
                                <div class="form-text mb-3">Organization timezone: <%= resolvedNotifyOrgTimeZone %></div>
                            <% } %>
                            <% if (itemWasPublished) { %>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="notifyResendWorkspace" value="1">
                                    <label class="form-check-label" for="notifyResendWorkspace">Resend notification on this update</label>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer justify-content-between">
                <span class="small text-muted" id="newsNotifyWorkspaceFooterHint">Changes apply when you save the article.</span>
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Done</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="newsNotifyRolesModal" tabindex="-1" aria-labelledby="newsNotifyRolesModalLabel" aria-hidden="true" data-bs-focus="false">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="newsNotifyRolesModalLabel">Notify roles</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted">Select roles assigned to people in your active organization. Member counts reflect active person records with each role.</p>
                <div class="input-group input-group-sm mb-3">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="search" class="form-control" id="newsNotifyRolesSearch" placeholder="Search roles or packages…" autocomplete="off">
                </div>
                <div id="newsNotifyRolesModalBody"></div>
                <div id="newsNotifyRolesModalEmpty" class="text-muted small d-none">No roles match your search.</div>
            </div>
            <div class="modal-footer justify-content-between">
                <span class="small text-muted" id="newsNotifyRolesModalSelectionCount"></span>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="btnSaveNotifyRoles">Apply</button>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/modal_GenericPicker') %>
<%- include('../partials/modal_MediaManager') %>

<script src="https://cdn.jsdelivr.net/npm/quill@1.3.6/dist/quill.js"></script>
<script src="<%= typeof staticAssetUrl === 'function' ? staticAssetUrl('/scripts/news/quillNewsFigure.js') : '/scripts/news/quillNewsFigure.js' %>"></script>
<script src="<%= typeof staticAssetUrl === 'function' ? staticAssetUrl('/scripts/news/quillNewsFigureFloatLayout.js') : '/scripts/news/quillNewsFigureFloatLayout.js' %>"></script>
<script src="<%= typeof staticAssetUrl === 'function' ? staticAssetUrl('/scripts/news/newsNotifyRolesModal.js') : '/scripts/news/newsNotifyRolesModal.js' %>"></script>
<script src="<%= typeof staticAssetUrl === 'function' ? staticAssetUrl('/scripts/news/newsNotifyRecipients.js') : '/scripts/news/newsNotifyRecipients.js' %>"></script>
<script src="<%= typeof staticAssetUrl === 'function' ? staticAssetUrl('/scripts/news/newsNotifyScheduleSendTime.js') : '/scripts/news/newsNotifyScheduleSendTime.js' %>"></script>
<script>
document.addEventListener('DOMContentLoaded', () => {
    if (typeof window.Quill !== 'function') {
        console.error('[news/form] Quill failed to load (check Content-Security-Policy).');
        if (typeof showMessageModal === 'function') {
            showMessageModal({
                title: 'Editor Unavailable',
                icon: 'error',
                message: 'The rich text editor could not load. Refresh the page or contact support if this continues.',
                buttons: [{ text: 'OK', class: 'btn-primary', value: 'ok' }]
            });
        }
        return;
    }
    const attachmentRegistryInput = document.getElementById('attachmentRegistryInput');
    const NEWS_MEDIA_DEFAULT_FOLDER = <%- JSON.stringify(resolvedNewsMediaDefaultFolder) %>;
    const mediaManagerModalEl = document.getElementById('mediaManagerModal');
    const mediaManagerModal = (window.bootstrap && window.bootstrap.Modal && mediaManagerModalEl)
        ? window.bootstrap.Modal.getOrCreateInstance(mediaManagerModalEl)
        : null;
    const mediaManagerModalApi = (window.MediaManagerModal && typeof window.MediaManagerModal.open === 'function')
        ? window.MediaManagerModal
        : null;
    const newsMediaLibraryCache = new Map();

    let articleAttachments = JSON.parse(document.getElementById('initArticleAttachments').textContent || '[]');

    const quill = new Quill('#editor-container', {
        theme: 'snow',
        placeholder: 'Write your story...',
        modules: { toolbar: [
            [{ header: [1, 2, 3, false] }],
            ['bold', 'italic', 'underline', 'strike', 'blockquote'],
            [{ color: [] }, { background: [] }],
            [{ list: 'ordered' }, { list: 'bullet' }],
            [{ align: [] }],
            ['link', 'image', 'video'], ['clean']
        ]}
    });

    const figureEditor = window.NewsFigureEditor || null;
    const floatLayout = window.NewsFigureFloatLayout || null;
    if (floatLayout?.debounceSync) {
        quill.on('text-change', () => {
            floatLayout.debounceSync(quill.root);
        });
        floatLayout.syncNewsFigureFloatLayout(quill.root);
    }
    const toolbarModule = quill.getModule('toolbar');
    if (toolbarModule) {
        toolbarModule.addHandler('image', () => {
            openNewsMediaPicker('inline').catch((error) => {
                showNewsMessage('Media Error', error.message || 'Unable to open media library.');
            });
        });
    }

    let pendingFigureOptions = { layout: 'center', widthPct: 72 };
    let editingFigureIndex = null;
    const newsFigureModalEl = document.getElementById('newsFigureModal');
    const newsFigureModal = (window.bootstrap && window.bootstrap.Modal && newsFigureModalEl)
        ? window.bootstrap.Modal.getOrCreateInstance(newsFigureModalEl)
        : null;
    const newsFigureLayoutSelect = document.getElementById('newsFigureLayoutSelect');
    const newsFigureWidthSlider = document.getElementById('newsFigureWidthSlider');
    const newsFigureWidthLabel = document.getElementById('newsFigureWidthLabel');

    function syncFigureWidthLabel() {
        if (!newsFigureWidthSlider || !newsFigureWidthLabel) return;
        newsFigureWidthLabel.textContent = `${newsFigureWidthSlider.value}%`;
    }

    function readFigureOptionsFromModal() {
        const layout = newsFigureLayoutSelect ? newsFigureLayoutSelect.value : 'center';
        const widthPct = newsFigureWidthSlider ? Number(newsFigureWidthSlider.value) : 72;
        return {
