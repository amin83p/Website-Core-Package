<%
  const loginBrand = (typeof appBrand !== 'undefined' && appBrand && typeof appBrand === 'object') ? appBrand : {};
  const loginLogoUrl = loginBrand.logoUrl || '/uploads/GLOBAL/logo/Logo1.png';
  const loginAppName = loginBrand.appName || 'Amin Paknejad';
  const loginTagline = loginBrand.tagline || 'Learn, work, and thrive in new places.';
  const loginLogoAlt = loginBrand.footerLogoAlt || loginBrand.ownerDisplayName || loginAppName;
%>

<div class="login-scene">
  <div class="login-card">
    <aside class="login-hero">
      <div class="login-hero-inner">
        <div class="login-logo-shell">
          <span class="login-logo-ring" aria-hidden="true"></span>
          <div class="login-logo-frame">
            <img
              src="<%= loginLogoUrl %>"
              alt="<%= loginLogoAlt %>"
              class="login-hero-logo"
              onerror="this.closest('.login-logo-frame').classList.add('d-none')"
            >
          </div>
        </div>
        <p class="login-hero-eyebrow"><i class="bi bi-stars"></i> Welcome back</p>
        <h1 class="login-hero-title"><%= loginAppName %></h1>
        <p class="login-hero-tagline"><%= loginTagline %></p>
        <ul class="login-hero-features">
          <li><i class="bi bi-shield-lock-fill"></i><span>Secure sign-in with session protection and optional CAPTCHA.</span></li>
          <li><i class="bi bi-grid-1x2-fill"></i><span>One workspace for classes, reports, and your organization tools.</span></li>
          <li><i class="bi bi-lightning-charge-fill"></i><span>Pick up where you left off across devices.</span></li>
        </ul>
      </div>
    </aside>

    <section class="login-panel">
      <div class="login-panel-mobile-brand">
        <img src="<%= loginLogoUrl %>" alt="<%= loginLogoAlt %>" class="login-mobile-logo">
        <div class="fw-bold text-dark"><%= loginAppName %></div>
      </div>

      <header class="login-panel-header">
        <h2>Sign in</h2>
        <p>Enter your credentials to access your account.</p>
      </header>

      <form id="loginForm">
        <div class="mb-3">
          <label class="form-label" for="loginUsername">Username</label>
          <div class="input-group">
            <span class="input-group-text border-end-0 ps-3">
              <i class="bi bi-person"></i>
            </span>
            <input
              type="text"
              id="loginUsername"
              name="username"
              class="form-control size-md border-start-0"
              placeholder="Username or email"
              required
              autofocus
              autocomplete="username"
            >
          </div>
        </div>

        <div class="mb-4">
          <div class="d-flex justify-content-between align-items-center gap-2">
            <label class="form-label mb-0" for="loginPassword">Password</label>
            <a href="/password-reset" class="small text-decoration-none fw-semibold text-primary">Forgot password?</a>
          </div>
          <div class="input-group mt-1">
            <span class="input-group-text border-end-0 ps-3">
              <i class="bi bi-key"></i>
            </span>
            <input
              type="password"
              id="loginPassword"
              name="password"
              class="form-control size-md border-start-0"
              placeholder="••••••••"
              required
              autocomplete="current-password"
            >
          </div>
        </div>

        <div id="captchaContainer" class="mb-4 d-none login-fade-in">
          <label class="form-label text-danger">Security check</label>
          <div class="login-captcha-card p-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <div class="border rounded bg-white overflow-hidden" style="height: 50px;">
                <img id="captchaImage" src="" alt="CAPTCHA" style="height: 100%; width: auto;">
              </div>
              <button type="button" class="btn btn-sm btn-outline-secondary" onclick="refreshCaptcha()" title="Refresh image">
                <i class="bi bi-arrow-clockwise"></i>
              </button>
            </div>
            <input
              type="text"
              name="captcha"
              id="captchaInput"
              class="form-control text-center fw-bold login-letter-spacing"
              placeholder="Enter code"
              maxlength="6"
              autocomplete="off"
            >
          </div>
        </div>

        <div class="d-grid mb-3">
          <button type="submit" class="btn btn-primary btn-filled login-submit-btn">
            Sign in
          </button>
        </div>

        <% if (typeof microsoftAuthEnabled !== 'undefined' && microsoftAuthEnabled) { %>
          <div class="login-divider" role="presentation"><span>or continue with</span></div>
          <div class="d-grid mb-3">
            <a href="/auth/microsoft" class="btn btn-outline-secondary py-2 fw-semibold">
              <i class="bi bi-microsoft me-2"></i>Microsoft
            </a>
          </div>
        <% } %>

        <div class="login-footer-links">
          <a href="/" class="text-muted">Cancel</a>
          <span class="text-muted mx-2">·</span>
          <a href="/persons/join" class="fw-bold text-primary">Create account</a>
        </div>
      </form>
    </section>
  </div>
</div>

<script id="microsoftSessionLimitJson" type="application/json"><%- JSON.stringify((typeof microsoftSessionLimit !== 'undefined' && microsoftSessionLimit) ? microsoftSessionLimit : null).replace(/</g, '\\u003c') %></script>

<script>
function refreshCaptcha() {
    const img = document.getElementById('captchaImage');
    img.src = '/captcha?' + Date.now();
    document.getElementById('captchaInput').value = '';
}

function showCaptcha() {
    const container = document.getElementById('captchaContainer');
    const input = document.getElementById('captchaInput');

    if (container.classList.contains('d-none')) {
        container.classList.remove('d-none');
        refreshCaptcha();
        input.setAttribute('required', 'true');
    }
    container.classList.add('login-shake-element');
    setTimeout(() => container.classList.remove('login-shake-element'), 500);
}

function parseJsonScript(id, fallback) {
    try {
        const node = document.getElementById(id);
        return JSON.parse((node && node.textContent) || '');
    } catch (_) {
        return fallback;
    }
}

function escapeHtml(value) {
    return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
}

function escapeJsString(value) {
    return String(value || '')
        .replace(/\\/g, '\\\\')
        .replace(/'/g, "\\'")
        .replace(/\r?\n/g, ' ');
}

function getSessionButtonId(sessionId) {
    return `btn-kill-${String(sessionId || '').replace(/[^A-Za-z0-9_-]/g, '_')}`;
}

function showSessionLimitModal(result) {
    if (!result || !Array.isArray(result.activeSessions)) return;
    const provider = String(result.provider || 'password').toLowerCase();
    const isMicrosoft = provider === 'microsoft';

    let listHtml = '<div class="list-group text-start mt-3 border rounded" style="max-height:300px; overflow-y:auto; background:#fff;">';
    result.activeSessions.forEach(s => {
        const ua = s.deviceFingerprint?.browser || 'Unknown Device';
        const ip = s.deviceFingerprint?.ip || 'Unknown IP';
        let timeStr = 'Just now';
        try { timeStr = new Date(s.lastActivityAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}); } catch(e) {}
        const org = s.currentOrgId === 'SYSTEM' ? 'System' : `Org #${s.currentOrgId}`;
        const rawSessionId = String(s.id || '');
        const safeSessionId = escapeJsString(rawSessionId);
        const buttonId = getSessionButtonId(rawSessionId);
        const uaHtml = escapeHtml(ua);
        const ipHtml = escapeHtml(ip);
        const orgHtml = escapeHtml(org);
        const timeHtml = escapeHtml(timeStr);

        listHtml += `
            <div class="list-group-item d-flex justify-content-between align-items-center p-3">
                <div style="font-size:0.9rem; line-height:1.3; overflow:hidden;">
                    <div class="fw-bold text-dark text-truncate" style="max-width:200px;" title="${uaHtml}">
                        <i class="bi bi-laptop me-1 text-secondary"></i> ${uaHtml}
                    </div>
                    <div class="text-muted small mt-1">${ipHtml} - ${orgHtml} - ${timeHtml}</div>
                </div>
                <button type="button" id="${buttonId}" class="btn btn-sm btn-outline-danger shadow-sm" style="min-width:90px;" onclick="window.killSessionAndLogin('${safeSessionId}', '${provider}')">
                    Disconnect
                </button>
            </div>
        `;
    });
    listHtml += '</div>';

    const msgContent = `
        <div class="text-start">
            <div class="alert alert-warning border-0 bg-warning-subtle text-dark small mb-3">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                Limit Reached: You have <b>${result.activeSessions.length}</b> active session(s).
            </div>
            <p class="small text-muted mb-0">
                ${isMicrosoft
                    ? 'Select a session below to disconnect it and continue Microsoft sign-in here:'
                    : 'Select a session below to disconnect it and log in here:'}
            </p>
            ${listHtml}
        </div>
    `;

    showMessageModal({
        title: 'Session Limit Reached',
        icon: 'warning',
        message: msgContent,
        size: 'md',
        buttons: [{ text: "Cancel", class: "btn-secondary" }]
    });
}

document.addEventListener('DOMContentLoaded', () => {
    const params = new URLSearchParams(window.location.search);
    if (params.get('warning') && typeof showMessageModal === 'function') {
        showMessageModal({ title: 'Notice', message: params.get('warning'), icon: 'warning', buttons: [{ text: 'OK', class: 'btn-warning' }] });
        window.history.replaceState({}, document.title, "/login");
    }
    const microsoftSessionLimit = parseJsonScript('microsoftSessionLimitJson', null);
    if (microsoftSessionLimit && Array.isArray(microsoftSessionLimit.activeSessions) && typeof showMessageModal === 'function') {
        showSessionLimitModal(microsoftSessionLimit);
        window.history.replaceState({}, document.title, "/login");
    }
});

document.addEventListener('DOMContentLoaded', () => {
  const form = document.getElementById('loginForm');

  form.addEventListener('submit', async e => {
    e.preventDefault();
    const btn = form.querySelector('button[type="submit"]');
    const originalText = btn.innerHTML;

    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span> Checking...';

    const payload = {
        username: form.querySelector('input[name="username"]').value,
        password: form.querySelector('input[name="password"]').value
    };

    const captchaVal = document.getElementById('captchaInput').value;
    if (!document.getElementById('captchaContainer').classList.contains('d-none')) {
        payload.captcha = captchaVal;
    }

    try {
      const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';
      const response = await fetch('/login', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-AJAX-Request': 'true',
          'csrf-token': csrfToken
        },
        body: JSON.stringify(payload)
      });

      const result = await response.json();

      if (response.ok) {
        window.location.href = result.redirectUrl || '/dashboard';
      } else {
        if (result.status === 'captcha_required') {
            showCaptcha();
            showMessageModal({
              title: 'Security Check',
              icon: 'warning',
              message: result.message || 'Please solve the CAPTCHA to prove you are human.',
              size: 'sm',
              buttons: [{ text: "OK", class: "btn-secondary" }]
            });
        }
        else if (result.status === 'session_limit_exceeded' && result.activeSessions) {
             showSessionLimitModal(result);
        }
        else {
            showMessageModal({
              title: 'Login Failed',
              icon: 'error',
              message: result.message || 'Invalid credentials.',
              size: 'md',
              buttons: [{ text: "Try Again", class: "btn-danger" }]
            });
            if (!document.getElementById('captchaContainer').classList.contains('d-none')) {
                refreshCaptcha();
            }
        }
      }
    } catch (error) {
      console.error(error);
      await showLoginFlowMessage('System error while processing the login request.');
    } finally {
        btn.disabled = false;
        btn.innerHTML = originalText;
    }
  });
});

async function showLoginFlowMessage(message, title = 'Login Failed') {
    const text = String(message || 'The login request could not be completed.');
    if (typeof window.showMessageModal === 'function') {
        await window.showMessageModal({
            title,
            icon: 'error',
            message: text,
            buttons: [{ text: 'OK', class: 'btn-danger' }]
        });
        return;
    }
    console.error(text);
}

window.killSessionAndLogin = async function(sessionId, authProvider = 'password') {
    const form = document.getElementById('loginForm');
    const username = form.querySelector('input[name="username"]').value;
    const password = form.querySelector('input[name="password"]').value;
    const btn = document.getElementById(getSessionButtonId(sessionId));
    const originalButtonHtml = btn ? btn.innerHTML : '';
    if(btn) { btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>'; btn.disabled = true; }

    try {
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';
        const res = await fetch('/force-login', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
              'Content-Type': 'application/json',
              'X-AJAX-Request': 'true',
              'csrf-token': csrfToken
            },
            body: JSON.stringify({ username, password, sessionIdToKill: sessionId, authProvider })
        });
        const json = await res.json().catch(() => ({ status: 'error', message: 'Request failed (' + res.status + ').' }));
        if (json.status === 'success') {
             window.location.href = json.redirectUrl || '/dashboard';
             return;
        } else {
             await showLoginFlowMessage(json.message || 'Failed to terminate session.');
             if (res.status === 401 && String(authProvider).toLowerCase() === 'microsoft') {
                 window.location.href = '/login';
                 return;
             }
        }
    } catch (err) {
        console.error(err);
        await showLoginFlowMessage('Network error while completing the login request.');
    } finally {
        if (btn) {
            btn.innerHTML = originalButtonHtml;
            btn.disabled = false;
        }
    }
};
</script>
