<section class="pte-public-page important-notices-page notices-page-v2 offer-page-v2">
  <%
    const pageContent = (typeof importantNoticesContent !== 'undefined' && importantNoticesContent && typeof importantNoticesContent === 'object')
      ? importantNoticesContent
      : {};
    const hero = pageContent.hero || {};
    const highlights = Array.isArray(pageContent.highlights) ? pageContent.highlights : [];
    const intro = pageContent.intro || {};
    const allNotices = Array.isArray(pageContent.notices) ? pageContent.notices : [];
    const notices = allNotices
      .filter((row) => row && row.active !== false)
      .sort((a, b) => (Number(a.order) || 0) - (Number(b.order) || 0));
    const resourcePanel = pageContent.resourcePanel || {};
    const resourceLinks = (Array.isArray(resourcePanel.links) ? resourcePanel.links : [])
      .filter((row) => row && row.active !== false && row.href)
      .sort((a, b) => (Number(a.order) || 0) - (Number(b.order) || 0));
    const finalCta = pageContent.finalCta || {};

    function noticeSlug(title, index) {
      const base = String(title || '')
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');
      return base || `notice-${index + 1}`;
    }

    function formatNoticeDate(value) {
      const token = String(value || '').trim();
      if (!/^\d{4}-\d{2}-\d{2}$/.test(token)) return '';
      const parsed = new Date(`${token}T12:00:00.000Z`);
      if (Number.isNaN(parsed.getTime())) return token;
      try {
        return parsed.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
      } catch (_) {
        return token;
      }
    }
  %>

  <section class="pte-hero-intro offer-hero reveal" aria-labelledby="importantNoticesTitle">
    <div class="pte-hero-orbit" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>

    <div class="offer-hero-top pte-hero-copy">
      <span class="pte-eyebrow offer-kicker"><%= hero.eyebrow || 'Resources' %></span>
      <h1 id="importantNoticesTitle"><%= hero.title || 'Important Notices' %></h1>
      <p><%= hero.subtitle || 'Legal, privacy, and operational notices for visitors and platform users.' %></p>
    </div>

    <div class="pte-hero-actions offer-hero-actions">
      <a href="<%= hero.primaryHref || '/contact' %>" class="btn pte-btn-primary offer-btn-main">
        <i class="bi bi-envelope me-2"></i>
        <%= hero.primaryLabel || 'Contact Us' %>
      </a>
      <a href="<%= hero.secondaryHref || '/' %>" class="btn pte-btn-secondary offer-btn-ghost">
        <i class="bi bi-house me-2"></i>
        <%= hero.secondaryLabel || 'Back to Home' %>
      </a>
    </div>

    <div class="pte-highlight-row offer-metrics" aria-label="Page highlights">
      <% highlights.forEach((item) => { %>
        <div class="pte-highlight-chip offer-chip">
          <strong><%= item.value %></strong>
          <span><%= item.label %></span>
        </div>
      <% }) %>
    </div>
  </section>

  <section class="pte-section notices-intro-panel reveal delay-1" aria-label="Page overview">
    <article class="notices-card notices-panel">
      <div class="pte-section-heading pte-section-heading-left">
        <span><%= intro.eyebrow || 'Overview' %></span>
        <h2><%= intro.title || 'How to use this page' %></h2>
        <p><%= intro.body || 'Review the notices below for legal, privacy, and operational information.' %></p>
      </div>
    </article>
  </section>

  <% if (notices.length) { %>
    <nav class="notices-toc reveal delay-1" aria-label="Notice table of contents">
      <h2 class="notices-toc-title">On this page</h2>
      <ul class="notices-toc-list">
        <% notices.forEach((notice, index) => { %>
          <li>
            <a href="#notice-<%= noticeSlug(notice.title, index) %>"><%= notice.title %></a>
          </li>
        <% }) %>
      </ul>
    </nav>

    <section class="notices-list reveal delay-2" aria-label="Important notices">
      <% notices.forEach((notice, index) => {
        const slug = noticeSlug(notice.title, index);
        const paragraphs = Array.isArray(notice.body) ? notice.body : [];
        const effectiveLabel = formatNoticeDate(notice.effectiveDate);
      %>
        <article class="notices-card notices-item" id="notice-<%= slug %>">
          <header class="notices-item-header">
            <div>
              <% if (notice.category) { %>
                <span class="notices-category"><%= notice.category %></span>
              <% } %>
              <h2><%= notice.title %></h2>
              <% if (effectiveLabel) { %>
                <p class="notices-effective">Effective <%= effectiveLabel %></p>
              <% } %>
            </div>
          </header>
          <% if (notice.summary) { %>
            <p class="notices-summary"><%= notice.summary %></p>
          <% } %>
          <div class="notices-body">
            <% paragraphs.forEach((paragraph) => { %>
              <p><%= paragraph %></p>
            <% }) %>
          </div>
          <% if (notice.linkHref) { %>
            <a href="<%= notice.linkHref %>" class="btn btn-outline-primary btn-sm notices-item-link">
              <%= notice.linkLabel || 'Learn more' %>
              <i class="bi bi-arrow-right ms-1"></i>
            </a>
          <% } %>
        </article>
      <% }) %>
    </section>
  <% } else { %>
    <section class="notices-card notices-empty reveal delay-2">
      <p class="mb-0 text-muted">No notices are published at this time.</p>
    </section>
  <% } %>

  <section class="notices-card notices-panel notices-resources reveal delay-2" aria-label="Related resources">
    <div class="pte-section-heading pte-section-heading-left">
      <h2><%= resourcePanel.title || 'Related resources' %></h2>
      <p><%= resourcePanel.body || 'More information and ways to reach the team.' %></p>
    </div>
    <% if (resourceLinks.length) { %>
      <div class="notices-resource-links">
        <% resourceLinks.forEach((link) => { %>
          <a href="<%= link.href %>" class="notices-resource-link"><%= link.label %><i class="bi bi-arrow-right"></i></a>
        <% }) %>
      </div>
    <% } %>
  </section>

  <section class="notices-panel notices-cta reveal delay-3">
    <div>
      <h2><%= finalCta.title || 'Need clarification on a notice?' %></h2>
      <p><%= finalCta.body || 'Contact us and reference the notice title in your message.' %></p>
    </div>
    <div class="pte-hero-actions notices-cta-actions">
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="<%= finalCta.signedInPrimaryHref || '/dashboard' %>" class="btn pte-btn-primary">
          <i class="bi bi-speedometer2 me-2"></i><%= finalCta.signedInPrimaryLabel || 'Open Dashboard' %>
        </a>
      <% } else { %>
        <a href="<%= finalCta.guestPrimaryHref || '/login' %>" class="btn pte-btn-primary">
          <i class="bi bi-box-arrow-in-right me-2"></i><%= finalCta.guestPrimaryLabel || 'Sign In' %>
        </a>
        <a href="<%= finalCta.guestSecondaryHref || '/persons/join' %>" class="btn pte-btn-secondary"><%= finalCta.guestSecondaryLabel || 'Create Account' %></a>
      <% } %>
      <a href="<%= finalCta.contactHref || '/contact' %>" class="btn pte-btn-secondary">
        <i class="bi bi-chat-dots me-2"></i><%= finalCta.contactLabel || 'Contact Us' %>
      </a>
    </div>
  </section>
</section>

<style>
@import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap');

/* One continuous backdrop: gradient lives on the page block, not on body (avoids viewport split) */
html.pte-public-root,
html.pte-public-root body.important-notices-public-body {
  background-color: #f8fbff;
  min-height: 100%;
}

body.important-notices-public-body {
  color: #17223b;
}

main.important-notices-public-main {
  margin-bottom: 0 !important;
  margin-top: 0 !important;
  padding-bottom: 0;
  padding-top: 0;
  position: relative;
  background: transparent;
}

.important-notices-page {
  --notices-primary: #1d5fb8;
  --notices-primary-dark: #0d4fa9;
  --notices-teal: #087f8c;
  --notices-amber: #f0b84e;
  --notices-ink: #13222c;
  --notices-muted: #53636f;
  --notices-border: #d7e1e7;
  --notices-surface: rgba(255, 255, 255, 0.9);
  --notices-soft: #f5f8fa;
  color: var(--notices-ink);
  font-family: 'Manrope', 'Segoe UI', sans-serif;
  isolation: isolate;
  padding-bottom: clamp(2rem, 5vw, 4.5rem);
  position: relative;
}

.important-notices-page::before {
  background:
    radial-gradient(circle at 8% 5%, rgba(29, 95, 184, 0.16), transparent 28%),
    radial-gradient(circle at 92% 4%, rgba(8, 127, 140, 0.16), transparent 26%),
    radial-gradient(circle at 9% 44%, rgba(29, 95, 184, 0.08), transparent 24%),
    radial-gradient(circle at 91% 72%, rgba(8, 127, 140, 0.1), transparent 28%),
    linear-gradient(135deg, #f8fbff 0%, #eef8f5 52%, #ffffff 100%);
  bottom: 0;
  content: "";
  left: 50%;
  pointer-events: none;
  position: absolute;
  top: 0;
  transform: translateX(-50%);
  width: 100vw;
  z-index: -1;
}

.important-notices-page > * {
  position: relative;
  z-index: 1;
}

.notices-page-v2 {
  --notices-primary: #1d5fb8;
  --notices-ink: #13222c;
  --notices-muted: #53636f;
  --notices-border: #d7e1e7;
  --notices-surface: rgba(255, 255, 255, 0.9);
  --notices-soft: #f5f8fa;
  font-family: 'Manrope', 'Segoe UI', sans-serif;
}

.notices-page-v2 .reveal {
  opacity: 0;
  transform: translateY(14px);
  animation: noticesFadeUp 0.55s ease forwards;
}

.notices-page-v2 .delay-1 { animation-delay: 0.1s; }
.notices-page-v2 .delay-2 { animation-delay: 0.2s; }
.notices-page-v2 .delay-3 { animation-delay: 0.3s; }

@keyframes noticesFadeUp {
  to { opacity: 1; transform: translateY(0); }
}

.important-notices-page .pte-hero-intro {
  background: transparent;
  border: 0;
  border-radius: 0;
  box-shadow: none;
  margin-bottom: 1.15rem;
  overflow: visible;
  padding: clamp(1.4rem, 3vw, 2.4rem) 0;
  position: relative;
}

.important-notices-page .pte-hero-orbit {
  bottom: 0;
  left: 50%;
  overflow: hidden;
  pointer-events: none;
  position: absolute;
  top: 0;
  transform: translateX(-50%);
  width: 100vw;
  z-index: 1;
}

.important-notices-page .pte-hero-orbit span {
  border-radius: 999px;
  position: absolute;
}

.important-notices-page .pte-hero-orbit span:nth-child(1) {
  background: radial-gradient(circle, rgba(8, 127, 140, 0.22) 0%, rgba(8, 127, 140, 0) 72%);
  height: 220px;
  left: 8%;
  top: 8%;
  width: 220px;
}

.important-notices-page .pte-hero-orbit span:nth-child(2) {
  background: radial-gradient(circle, rgba(29, 95, 184, 0.2) 0%, rgba(29, 95, 184, 0) 70%);
  height: 180px;
  right: 10%;
  top: 24%;
  width: 180px;
}

.important-notices-page .pte-hero-orbit span:nth-child(3) {
  background: radial-gradient(circle, rgba(29, 95, 184, 0.18) 1px, transparent 2px);
  background-size: 18px 18px;
  border-radius: 0;
  height: 120px;
  right: 18%;
  top: 20%;
  width: 150px;
}

.important-notices-page .pte-hero-copy {
  margin-left: 0;
  margin-right: auto;
  max-width: none;
  position: relative;
  text-align: left;
  width: 100%;
  z-index: 2;
}

.important-notices-page .pte-eyebrow,
.important-notices-page .pte-section-heading span {
  color: var(--notices-teal);
  display: inline-flex;
  font-size: 0.8rem;
  font-weight: 850;
  letter-spacing: 0;
  line-height: 1;
  margin-bottom: 0.85rem;
  text-transform: uppercase;
}

.important-notices-page .pte-hero-copy h1 {
  color: #083253;
  font-size: clamp(2.25rem, 5.2vw, 5.05rem);
  font-weight: 920;
  letter-spacing: 0;
  line-height: 0.98;
  margin: 0;
  max-width: none;
}

.important-notices-page .pte-hero-copy p {
  color: #365568;
  font-size: clamp(1rem, 1.7vw, 1.28rem);
  font-weight: 560;
  line-height: 1.72;
  margin: 1rem 0 0;
  max-width: 880px;
}

.important-notices-page .pte-hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.65rem;
  margin-top: 1.35rem;
  position: relative;
  z-index: 2;
}

.important-notices-page .btn {
  align-items: center;
  border-radius: 8px;
  display: inline-flex;
  font-weight: 760;
  justify-content: center;
  min-height: 44px;
  padding: 0.62rem 1rem;
}

.important-notices-page .pte-btn-primary {
  background: var(--notices-amber);
  border: 1px solid var(--notices-amber);
  color: #16232c;
}

.important-notices-page .pte-btn-primary:hover,
.important-notices-page .pte-btn-primary:focus {
  background: #d99b23;
  border-color: #d99b23;
  color: #16232c;
}

.important-notices-page .pte-btn-secondary {
  background: #ffffff;
  border: 1px solid #c9dce9;
  color: #163445;
}

.important-notices-page .pte-btn-secondary:hover,
.important-notices-page .pte-btn-secondary:focus {
  background: #e9f4fb;
  border-color: #9cc6df;
  color: #16232c;
}

.important-notices-page .pte-highlight-row {
  display: grid;
  gap: 0.7rem;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 1.35rem;
  max-width: none;
  position: relative;
  z-index: 2;
}

.important-notices-page .pte-highlight-chip {
  background: rgba(255, 255, 255, 0.78);
  border: 1px solid rgba(202, 219, 232, 0.92);
  border-radius: 14px;
  box-shadow: 0 12px 30px rgba(17, 54, 78, 0.07);
  min-height: 76px;
  padding: 0.78rem 0.85rem;
}

.important-notices-page .pte-highlight-chip strong {
  color: var(--notices-primary-dark);
  display: block;
  font-size: 1rem;
  margin-bottom: 0.24rem;
}

.important-notices-page .pte-highlight-chip span {
  color: #456071;
  display: block;
  font-size: 0.8rem;
  line-height: 1.35;
}

.important-notices-page .pte-section-heading h2 {
  color: var(--notices-ink);
  font-size: 2rem;
  font-weight: 830;
  line-height: 1.18;
  margin: 0;
}

.important-notices-page .pte-section-heading p {
  color: var(--notices-muted);
  font-size: 1rem;
  line-height: 1.65;
  margin: 0.65rem 0 0;
}

@media (max-width: 900px) {
  .important-notices-page .pte-highlight-row {
    grid-template-columns: 1fr;
  }
}

.notices-page-v2 .notices-card,
.notices-page-v2 .notices-panel {
  background: var(--notices-surface);
  border: 1px solid var(--notices-border);
  border-radius: 20px;
  padding: 1.5rem 1.75rem;
  margin-bottom: 1.25rem;
  box-shadow: 0 8px 24px rgba(17, 48, 79, 0.05);
}

.notices-page-v2 .notices-toc {
  background: var(--notices-surface);
  border: 1px solid var(--notices-border);
  border-radius: 16px;
  padding: 1.25rem 1.5rem;
  margin-bottom: 1.25rem;
}

.notices-page-v2 .notices-toc-title {
  font-size: 0.95rem;
  font-weight: 700;
  margin: 0 0 0.75rem;
  color: var(--notices-ink);
}

.notices-page-v2 .notices-toc-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
}

.notices-page-v2 .notices-toc-list a {
  color: var(--notices-primary);
  text-decoration: none;
  font-weight: 600;
  font-size: 0.92rem;
}

.notices-page-v2 .notices-toc-list a:hover {
  text-decoration: underline;
}

.notices-page-v2 .notices-item-header h2 {
  font-size: 1.35rem;
  margin: 0.35rem 0 0;
  color: var(--notices-ink);
}

.notices-page-v2 .notices-category {
  display: inline-flex;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--notices-primary);
  background: rgba(10, 102, 194, 0.1);
  border-radius: 999px;
  padding: 0.2rem 0.65rem;
}

.notices-page-v2 .notices-effective {
  font-size: 0.85rem;
  color: var(--notices-muted);
  margin: 0.35rem 0 0;
}

.notices-page-v2 .notices-summary {
  font-weight: 600;
  color: var(--notices-ink);
  margin: 1rem 0 0.75rem;
}

.notices-page-v2 .notices-body p {
  color: var(--notices-muted);
  line-height: 1.65;
  margin-bottom: 0.75rem;
}

.notices-page-v2 .notices-resource-links {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  margin-top: 1rem;
}

.notices-page-v2 .notices-resource-link {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.55rem 1rem;
  border-radius: 999px;
  border: 1px solid var(--notices-border);
  background: var(--notices-soft);
  color: var(--notices-ink);
  font-weight: 600;
  text-decoration: none;
  font-size: 0.9rem;
}

.notices-page-v2 .notices-cta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  background: linear-gradient(135deg, #0a66c2 0%, #094d92 100%);
  color: #fff;
  border: none;
  border-radius: 20px;
  padding: 1.75rem 2rem;
  margin-top: 0.5rem;
}

.notices-page-v2 .notices-cta h2 {
  color: #fff;
  font-size: 1.5rem;
  margin-bottom: 0.35rem;
}

.notices-page-v2 .notices-cta p {
  color: rgba(255, 255, 255, 0.9);
  margin: 0;
  max-width: 42rem;
}

@media (max-width: 768px) {
  .notices-page-v2 .notices-card,
  .notices-page-v2 .notices-cta {
    padding: 1.25rem;
  }

  .important-notices-page .pte-hero-copy h1 {
    font-size: clamp(2rem, 9vw, 2.8rem);
  }
}
</style>
