<%
  const modalChatAccess = (typeof chatAccess !== 'undefined' && chatAccess && typeof chatAccess === 'object') ? chatAccess : {};
  const canChatCreate = !!modalChatAccess.canCreate;
  const canChatUpdate = !!modalChatAccess.canUpdate;
  const canChatDelete = !!(modalChatAccess.canDelete || modalChatAccess.canDeleteAll);
  const canChatBroadcast = !!modalChatAccess.canDeleteAll;
%>
<div class="modal fade" id="chatInterfaceModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-centered chat-shell-dialog" id="chatModalDialog" style="max-width: calc(100vw - 8px); width: min(900px, calc(100vw - 8px)); margin: 4px auto;"> 
    <div class="modal-content overflow-hidden shadow-lg" id="chatModalContent" style="height: 600px; min-height: 400px; min-width: 350px; position: relative; resize: none; overflow: hidden;">
      <button type="button" class="btn-close chat-shell-global-close" data-bs-dismiss="modal" aria-label="Close"></button>
      
      <div class="modal-body p-0 d-flex h-100 position-relative">
          
          <div class="chat-sidebar bg-light border-end d-flex flex-column" id="chatSidebar" style="width: 280px; min-width: 0px; max-width: 65%;">
              
              <div class="p-2 bg-white border-bottom d-flex justify-content-between align-items-center chat-shell-header" id="chatModalHeaderRow">
                  <div class="d-flex align-items-center gap-2">
                      <h6 class="fw-bold m-0 text-secondary ps-2" id="sidebarTitle">Messages</h6>
                      <button type="button" class="btn btn-sm btn-light text-secondary rounded-circle chat-modal-drag-handle" id="chatModalDragHandle" title="Move Chat Window" aria-label="Move Chat Window">
                          <i class="bi bi-arrows-move"></i>
                      </button>
                  </div>
                  <div class="d-flex align-items-center gap-1">
                      <button type="button" class="btn btn-sm btn-light text-secondary rounded-circle" id="chatSoundToggle" title="Mute chat sounds" aria-label="Mute chat sounds" aria-pressed="false">
                          <i class="bi bi-volume-up-fill" aria-hidden="true"></i>
                      </button>
                      <% if (canChatCreate) { %>
                          <button class="btn btn-sm btn-light text-primary rounded-circle" title="New Chat" onclick="startNewChatWizard()">
                              <i class="bi bi-pencil-square"></i>
                          </button>
                      <% } %>
                      <% if (canChatBroadcast) { %>
                          <button class="btn btn-sm btn-light text-primary rounded-circle" title="Broadcast" onclick="startBroadcastWizard()">
                              <i class="bi bi-broadcast"></i>
                          </button>
                      <% } %>
                  </div>
              </div>

              <div class="p-2 border-bottom chat-shell-search-row">
                  <input type="text" class="form-control form-control-sm bg-white" placeholder="Search..." id="chatSearchInput" onkeyup="handleSearch(this.value)">
              </div>

              <div class="flex-grow-1 overflow-auto custom-scrollbar" id="conversationList">
                   <div class="text-center text-muted mt-5 small">Loading...</div>
              </div>
          </div>

          <div id="sidebarResizer" class="bg-light border-end border-start d-flex align-items-center justify-content-center" 
               style="width: 8px; cursor: col-resize; flex-shrink: 0; user-select: none;">
               <i class="bi bi-three-dots-vertical text-muted opacity-25" style="font-size: 0.7rem;"></i>
          </div>

          <div class="chat-main d-flex flex-column flex-grow-1 bg-white position-relative" id="chatMainArea" style="min-width: 200px;">
              
              <div id="chatEmptyState" class="d-flex flex-column align-items-center justify-content-center h-100 text-muted">
                  <div class="bg-light p-3 rounded-circle mb-3">
                      <i class="bi bi-chat-dots fs-1 opacity-50"></i>
                  </div>
                  <h5>Select a chat</h5>
              </div>

              <div id="chatActiveView" class="d-flex flex-column h-100 d-none">
                  
                  <div class="p-2 px-3 border-bottom d-flex justify-content-between align-items-center bg-white shadow-sm" style="z-index: 10;">
                      <div class="d-flex align-items-center overflow-hidden">
                           <button id="toggleSidebarBtn" class="btn btn-sm btn-light border me-2 text-secondary" onclick="toggleSidebar()" title="Toggle Sidebar">
                                <i class="bi bi-layout-sidebar"></i>
                           </button>

                           <% if (canChatDelete) { %>
                               <button class="btn btn-sm btn-light border me-3 text-danger" onclick="deleteCurrentChat()" title="Delete Conversation">
                                    <i class="bi bi-trash"></i>
                               </button>
                           <% } %>

                           <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center me-2 fw-bold flex-shrink-0" 
                               style="width: 32px; height: 32px; font-size: 0.85rem;" id="chatHeaderAvatar">U</div>
                           <div class="overflow-hidden">
                               <div class="fw-bold text-dark small text-truncate" id="chatHeaderName">User</div>
                           </div>
                      </div>
                  </div>

                  <div class="flex-grow-1 overflow-auto p-3 bg-light custom-scrollbar" id="chatMessageContainer" 
                       style="background-image: radial-gradient(#e9ecef 1px, transparent 1px); background-size: 15px 15px;">
                  </div>

                  <div id="attachmentPreviewArea" class="d-none"></div>

                  <div class="p-2 border-top bg-white chat-compose-wrap">
                      <div id="chatReadOnlyNotice" class="small text-muted px-2 py-1 <%= canChatUpdate ? 'd-none' : '' %>">
                          You can read this conversation, but your access profile does not allow sending messages.
                      </div>
                      <form id="chatForm" class="d-flex align-items-end gap-2 <%= canChatUpdate ? '' : 'd-none' %>">
                           <button type="button" id="chatAttachmentButton" class="btn btn-light text-secondary rounded-circle" onclick="document.getElementById('chatFileInput').click()">
                              <i class="bi bi-paperclip"></i>
                          </button>
              
                          <input type="file" id="chatFileInput" class="d-none" multiple onchange="handleFileSelection(this)">
                          
                          <textarea class="form-control bg-light border-0" id="chatInput" rows="1" 
                                    placeholder="Message..." 
                                    style="resize:none; min-height: 38px; max-height: 160px; overflow-y: auto; line-height: 1.5;"></textarea>
                          
                          <button type="submit" id="chatSendButton" data-no-wait="true" class="btn btn-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                              <i class="bi bi-send-fill" style="font-size: 0.9rem; margin-left: 2px;"></i>
                          </button>
                      </form>
                  </div>
              </div>
          </div>
      </div>
       
      <div id="modalResizer" style="position: absolute; bottom: 0; right: 0; width: 22px; height: 22px; cursor: nwse-resize; z-index: 20;">
          <svg viewBox="0 0 10 10" width="100%" height="100%" fill="#adb5bd">
            <path d="M10 10 L10 2 L2 10 Z" />
          </svg>
      </div>

    </div>
  </div>
</div>

<div class="modal fade" id="chatBroadcastModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Broadcast Message</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="chatBroadcastForm">
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label small fw-semibold mb-1" for="chatBroadcastSearchInput">Recipients</label>
                        <input type="text" id="chatBroadcastSearchInput" class="form-control form-control-sm" placeholder="Search users...">
                        <div class="form-text">Select one or more recipients.</div>
                    </div>
                    <div id="chatBroadcastSelectedRecipients" class="d-flex flex-wrap gap-1 mb-2"></div>
                    <div id="chatBroadcastRecipientList" class="border rounded p-2 bg-light custom-scrollbar" style="max-height: 220px; overflow-y: auto;">
                        <div class="text-muted small">Loading recipients...</div>
                    </div>

                    <hr class="my-3">
                    <div class="mb-2">
                        <label class="form-label small fw-semibold mb-1" for="chatBroadcastMessageInput">Message</label>
                        <textarea id="chatBroadcastMessageInput" class="form-control" rows="4" placeholder="Type your message..."></textarea>
                    </div>
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="small text-muted" id="chatBroadcastRecipientCount">0 recipients selected</div>
                        <div>
                            <button type="button" class="btn btn-sm btn-light" id="chatBroadcastAttachButton">
                                <i class="bi bi-paperclip me-1"></i>Attach files
                            </button>
                            <input type="file" id="chatBroadcastFileInput" class="d-none" multiple>
                        </div>
                    </div>
                    <div id="chatBroadcastAttachmentPreview" class="d-none mt-2"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="chatBroadcastSendButton">Send Broadcast</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    /* Compact Styling */
    .chat-shell-header {
        padding: 0.55rem 0.6rem !important;
    }
    .chat-shell-search-row {
        background: #f8fafc;
    }
    .chat-shell-search-row #chatSearchInput {
        border-radius: 10px;
        border: 1px solid #dbe3ef;
        padding-left: 0.75rem;
        box-shadow: none;
    }
    .chat-shell-search-row #chatSearchInput:focus {
        border-color: #99bffb;
        box-shadow: 0 0 0 0.15rem rgba(13, 110, 253, 0.15);
    }
    .chat-shell-global-close {
        position: absolute;
        top: 10px;
        right: 10px;
        z-index: 30;
        width: 30px;
        height: 30px;
        border-radius: 999px;
        background-color: rgba(255, 255, 255, 0.96);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.14);
    }
    .chat-modal-drag-handle {
        cursor: move;
    }
    .chat-modal-drag-handle:active {
        cursor: grabbing;
    }
    .chat-item { cursor: pointer; border-bottom: 1px solid #f8f9fa; padding: 10px; }
    .chat-item:hover, .chat-item.active { background-color: #f1f5f9; }
    .msg-bubble { max-width: 85%; padding: 8px 12px; border-radius: 12px; font-size: 0.9rem; margin-bottom: 2px; }
    .msg-sent { background-color: #d1e7dd; align-self: flex-end; border-bottom-right-radius: 2px; }
    .msg-received { background-color: #fff; border: 1px solid #eee; align-self: flex-start; border-bottom-left-radius: 2px; }
    .msg-text-content { white-space: pre-wrap; word-break: break-word; }
    .msg-time { font-size: 0.65rem; color: #adb5bd; margin-bottom: 8px; text-align: right; margin-right: 4px; }
    
    /* Scrollbar */
    .custom-scrollbar::-webkit-scrollbar { width: 5px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

    /* Status Icons */
    .msg-status { font-size: 0.75rem; margin-left: 4px; vertical-align: middle; }
    .status-sending { color: #adb5bd; }
    .status-sent { color: #adb5bd; }
    .status-delivered { color: #adb5bd; }
    .status-read { color: #0d6efd; }

    /* Images */
    .msg-bubble img { max-width: 200px; height: auto; border-radius: 8px; display: block; object-fit: cover; }
    .msg-bubble img:after { content: "⚠️ Image Error"; display: block; font-size: 12px; color: #dc3545; } 

    /* Attachment Preview */
    #attachmentPreviewArea { display: flex; gap: 10px; padding: 10px; background: #f8f9fa; border-top: 1px solid #dee2e6; overflow-x: auto; }
    #chatBroadcastAttachmentPreview { display: flex; gap: 10px; padding: 10px; background: #f8f9fa; border: 1px solid #dee2e6; border-radius: 8px; overflow-x: auto; }
    .att-preview-card { position: relative; width: 80px; height: 80px; border-radius: 8px; overflow: hidden; border: 1px solid #dee2e6; flex-shrink: 0; background: #fff; display: flex; align-items: center; justify-content: center; }
    .att-preview-card img { width: 100%; height: 100%; object-fit: cover; }
    .att-preview-remove { position: absolute; top: 2px; right: 2px; background: rgba(0,0,0,0.6); color: #fff; border-radius: 50%; width: 18px; height: 18px; font-size: 12px; display: flex; align-items: center; justify-content: center; cursor: pointer; }
    .att-preview-file { font-size: 2rem; color: #6c757d; }   
    .broadcast-recipient-chip { display: inline-flex; align-items: center; gap: 4px; background: #e7f1ff; color: #0d6efd; border-radius: 999px; padding: 2px 8px; font-size: 0.75rem; }
    .broadcast-recipient-row.active { background: #e7f1ff; border-color: #0d6efd !important; }

    /* Sidebar Item Styling */
    .chat-item {
        cursor: pointer;
        padding: 10px 12px;
        margin: 0 6px 4px;
        border: 1px solid #eef3fb;
        border-radius: 10px;
        transition: all 0.2s ease;
        position: relative;
    }
    .chat-item:hover {
        background-color: #f8f9fa;
        border-color: #dbe7fb;
    }
    .chat-item.active {
        background-color: #e7f1ff; /* Light blue active state */
        border-color: #0d6efd;
        box-shadow: inset 0 0 0 1px rgba(13, 110, 253, 0.2);
    }
    
    /* Unread Styling */
    .chat-item.unread {
        background-color: #fff; /* Differentiate unread background? */
    }
    .chat-item.unread .chat-name {
        font-weight: 700 !important;
        color: #000;
    }
    .chat-item.unread .chat-msg {
        font-weight: 600 !important;
        color: #333;
    }

    /* Avatar Badge */
    .avatar-wrapper { position: relative; }
    .status-dot {
        position: absolute; bottom: 0; right: 0;
        width: 10px; height: 10px;
        border-radius: 50%; border: 2px solid #fff;
        background-color: #ccc; /* Offline/Default */
    }
    .status-dot.online { background-color: #28a745; }

    /* Unread Counter Badge */
    .unread-badge {
        background-color: #dc3545;
        color: white;
        font-size: 0.7rem;
        padding: 2px 6px;
        border-radius: 10px;
        font-weight: bold;
        min-width: 18px;
        text-align: center;
        display: inline-block;
    }

    .chat-compose-wrap {
        background: linear-gradient(180deg, #ffffff 0%, #fafcff 100%);
    }

    #chatForm {
        border: 1px solid #dbe7fb;
        border-radius: 999px;
        padding: 4px 6px;
        background: #f8fbff;
    }
    #chatForm #chatInput {
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
        padding-left: 4px;
        padding-right: 6px;
    }
    #chatForm #chatAttachmentButton {
        border: 1px solid #dbe7fb;
    }
    #chatForm #chatSendButton {
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.25);
    }

    .broadcast-recipient-row {
        margin: 0 0 6px 0;
        border-radius: 8px;
    }

    #sidebarResizer,
    #modalResizer {
        touch-action: none;
    }
</style>

<script>
// --- GLOBAL VARIABLES ---
let socket;
let socketHandlersBound = false;
let socketReadyPromise = null;
const CHAT_MESSAGE_PAGE_SIZE = 50;
let currentConvId = null;
let currentUser = { id: '<%= user.id %>' };
const chatAccess = <%- JSON.stringify({
    canRead: !!(modalChatAccess.canRead || modalChatAccess.canReadAll),
    canCreate: canChatCreate,
    canUpdate: canChatUpdate,
    canDelete: canChatDelete,
    canDeleteAll: !!modalChatAccess.canDeleteAll,
    canBroadcast: canChatBroadcast
}) %>;
let isSidebarVisible = true;
let previousSidebarWidth = 280;
let pendingAttachments = [];
let currentConversationCanMessage = chatAccess.canUpdate;
let currentConversationScopeReason = '';
const unreadByConversation = new Map();
const latestIncomingMessageByConversation = new Map();
let totalUnreadCount = 0;
const chatSoundStorageKey = `chat.soundMuted.${String(currentUser.id)}`;
let chatSoundMuted = false;
let chatAudioContext = null;
let chatInitialUnreadSoundPlayed = false;
let hasMoreOlderMessages = false;
let oldestLoadedMessageId = null;
let loadingOlderMessages = false;
let broadcastRecipients = [];
const selectedBroadcastRecipients = new Map();
let broadcastPendingAttachments = [];
let broadcastSending = false;
let chatModalOffsetX = 0;
let chatModalOffsetY = 0;
let chatModalIsMaximized = false;
let chatModalRestoreState = null;

function normalizeClientUnreadCount(value) {
    const parsed = Number(value);
    if (!Number.isFinite(parsed) || parsed <= 0) return 0;
    return Math.floor(parsed);
}

function renderGlobalUnreadCount() {
    const badge = document.getElementById('chatGlobalBadge');
    if (!badge) return;
    const count = normalizeClientUnreadCount(totalUnreadCount);
    badge.innerText = String(count);
    badge.classList.toggle('d-none', count === 0);

    const trigger = document.getElementById('chatGlobalTrigger');
    if (trigger) {
        trigger.setAttribute(
            'aria-label',
            count > 0 ? `Messages, ${count} unread` : 'Messages'
        );
    }
}

function renderConversationUnreadCount(convId) {
    const key = String(convId || '');
    const unreadCount = normalizeClientUnreadCount(unreadByConversation.get(key));
    document.querySelectorAll('.chat-item[data-conv-id]').forEach((item) => {
        if (String(item.dataset.convId || '') !== key) return;
        item.classList.toggle('unread', unreadCount > 0);
        const slot = item.querySelector('.unread-badge-slot');
        if (slot) {
            slot.innerHTML = unreadCount > 0
                ? `<span class="unread-badge ms-2">${unreadCount}</span>`
                : '';
        }
    });
}

function applyUnreadState(convId, unreadCount, totalUnread) {
    const key = String(convId || '');
    if (key && Number.isFinite(Number(unreadCount))) {
        unreadByConversation.set(key, normalizeClientUnreadCount(unreadCount));
    }

    if (Number.isFinite(Number(totalUnread))) {
        totalUnreadCount = normalizeClientUnreadCount(totalUnread);
    } else {
        totalUnreadCount = [...unreadByConversation.values()]
            .reduce((sum, count) => sum + normalizeClientUnreadCount(count), 0);
    }

    if (key) renderConversationUnreadCount(key);
    renderGlobalUnreadCount();
}

function replaceUnreadState(conversations, totalUnread) {
    unreadByConversation.clear();
    (Array.isArray(conversations) ? conversations : []).forEach((conversation) => {
        unreadByConversation.set(
            String(conversation?.id || ''),
            normalizeClientUnreadCount(conversation?.unreadCount)
        );
    });
    totalUnreadCount = Number.isFinite(Number(totalUnread))
        ? normalizeClientUnreadCount(totalUnread)
        : [...unreadByConversation.values()]
            .reduce((sum, count) => sum + normalizeClientUnreadCount(count), 0);
    renderGlobalUnreadCount();
}

function markConversationReadLocally(convId) {
    const key = String(convId || '');
    const previousCount = normalizeClientUnreadCount(unreadByConversation.get(key));
    unreadByConversation.set(key, 0);
    totalUnreadCount = Math.max(0, normalizeClientUnreadCount(totalUnreadCount) - previousCount);
    renderConversationUnreadCount(key);
    renderGlobalUnreadCount();
}

function isTabVisible() {
    return document.visibilityState === 'visible';
}

function isAppActive() {
    return isTabVisible() && document.hasFocus();
}

function isConversationActivelyViewed(convId) {
    const modal = document.getElementById('chatInterfaceModal');
    return Boolean(
        modal &&
        modal.classList.contains('show') &&
        String(currentConvId || '') === String(convId || '') &&
        isAppActive()
    );
}

function markActiveConversationRead() {
    if (!currentConvId || !isConversationActivelyViewed(currentConvId)) return;
    const unreadCount = normalizeClientUnreadCount(
        unreadByConversation.get(String(currentConvId))
    );
    if (unreadCount === 0) return;

    const messageId = latestIncomingMessageByConversation.get(String(currentConvId)) || null;
    markConversationReadLocally(currentConvId);
    if (socket && socket.connected) {
        socket.emit('mark_conversation_read', {
            convId: currentConvId,
            messageId
        });
    }
}

function loadChatSoundPreference() {
    try {
        chatSoundMuted = localStorage.getItem(chatSoundStorageKey) === '1';
    } catch (_) {
        chatSoundMuted = false;
    }
}

function saveChatSoundPreference() {
    try {
        localStorage.setItem(chatSoundStorageKey, chatSoundMuted ? '1' : '0');
    } catch (_) {}
}

function renderChatSoundToggle() {
    const button = document.getElementById('chatSoundToggle');
    if (!button) return;
    const label = chatSoundMuted ? 'Unmute chat sounds' : 'Mute chat sounds';
    button.title = label;
    button.setAttribute('aria-label', label);
    button.setAttribute('aria-pressed', chatSoundMuted ? 'true' : 'false');
    button.innerHTML = chatSoundMuted
        ? '<i class="bi bi-volume-mute-fill" aria-hidden="true"></i>'
        : '<i class="bi bi-volume-up-fill" aria-hidden="true"></i>';
}

function ensureChatAudioContext() {
    if (chatAudioContext) return chatAudioContext;
    const AudioContextClass = window.AudioContext || window.webkitAudioContext;
    if (!AudioContextClass) return null;
    try {
        chatAudioContext = new AudioContextClass();
    } catch (_) {
        chatAudioContext = null;
    }
    return chatAudioContext;
}

async function unlockChatAudio() {
    const context = ensureChatAudioContext();
    if (!context || context.state !== 'suspended') return context;
    try {
        await context.resume();
    } catch (_) {}
    return context;
}

async function playChatDing() {
    if (chatSoundMuted || !isTabVisible()) return;

    const context = await unlockChatAudio();
    if (!context || context.state !== 'running') return;

    const start = context.currentTime;
    [
        { frequency: 880, offset: 0, duration: 0.09 },
        { frequency: 1174.66, offset: 0.1, duration: 0.12 }
    ].forEach((tone) => {
        const oscillator = context.createOscillator();
        const gain = context.createGain();
        const toneStart = start + tone.offset;
        const toneEnd = toneStart + tone.duration;
        oscillator.type = 'sine';
        oscillator.frequency.setValueAtTime(tone.frequency, toneStart);
        gain.gain.setValueAtTime(0.0001, toneStart);
        gain.gain.exponentialRampToValueAtTime(0.12, toneStart + 0.015);
        gain.gain.exponentialRampToValueAtTime(0.0001, toneEnd);
        oscillator.connect(gain);
        gain.connect(context.destination);
        oscillator.start(toneStart);
        oscillator.stop(toneEnd + 0.01);
    });
}

function initChatSoundControls() {
    loadChatSoundPreference();
    renderChatSoundToggle();
    const button = document.getElementById('chatSoundToggle');
    if (button) {
        button.addEventListener('click', async () => {
            chatSoundMuted = !chatSoundMuted;
            saveChatSoundPreference();
            renderChatSoundToggle();
            if (!chatSoundMuted) await unlockChatAudio();
        });
    }

    document.addEventListener('pointerdown', unlockChatAudio, { capture: true });
    document.addEventListener('keydown', unlockChatAudio, { capture: true });
}

function safeText(value) {
    return String(value || '').replace(/[&<>"']/g, (m) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;', "'":'&#39;' }[m]));
}

function safeAttr(value) {
    return safeText(value);
}

function loadScript(src) {
    return new Promise((resolve, reject) => {
        if (document.querySelector(`script[src="${src}"]`)) {
            resolve();
            return;
        }
        const script = document.createElement('script');
        script.src = src;
        script.async = true;
        script.onload = () => resolve();
        script.onerror = () => reject(new Error(`Failed to load ${src}`));
        document.head.appendChild(script);
    });
}

function safeInlineJson(value) {
    return JSON.stringify(String(value == null ? '' : value))
        .replace(/&/g, '\\u0026')
        .replace(/</g, '\\u003c')
        .replace(/'/g, '\\u0027');
}

function bindChatSocketHandlers() {
    if (!socket || socketHandlersBound) return;
    socketHandlersBound = true;

    socket.on('connect_error', (error) => {
        console.warn('Chat connection rejected:', error && error.message ? error.message : error);
    });

    socket.on('chat_error', (payload) => {
        const message = payload && payload.message ? payload.message : 'Chat action was not allowed.';
        if (/read-only|role scope|contact scope|no longer share/i.test(message)) {
            setConversationWriteState(false, message);
            window.currentChatCanMessage = false;
            window.currentChatScopeReason = message;
        }
        safeShowAlert(message, 'warning');
    });

    socket.on('connect', () => {
        socket.emit('identify', currentUser.id);
        refreshInbox();
    });

    socket.on('message_sent_ack', (data) => {
        const tempRow = document.getElementById(`msg-row-${data.tempId}`);
        if (tempRow) {
            tempRow.id = `msg-row-${data.realMsg.id}`;
            const statusContainer = tempRow.querySelector('.status-container');
            if (statusContainer) {
                statusContainer.id = `status-${data.realMsg.id}`;
                statusContainer.innerHTML = '<i class="bi bi-check status-sent msg-status"></i>';
            }
        }
    });

    socket.on('new_message', (data) => {
        if (String(data.message.senderId) === String(currentUser.id)) return;

        const modalEl = document.getElementById('chatInterfaceModal');
        const isModalOpen = modalEl.classList.contains('show');
        const isCurrentConversationOpen = isModalOpen
            && String(currentConvId || '') === String(data.convId || '');
        const isActiveConversation = isConversationActivelyViewed(data.convId);

        const eventConversationUnread = Number.isFinite(Number(data.unreadCount))
            ? data.unreadCount
            : normalizeClientUnreadCount(unreadByConversation.get(String(data.convId))) + 1;
        const eventTotalUnread = Number.isFinite(Number(data.totalUnread))
            ? data.totalUnread
            : normalizeClientUnreadCount(totalUnreadCount) + 1;
        applyUnreadState(data.convId, eventConversationUnread, eventTotalUnread);
        latestIncomingMessageByConversation.set(String(data.convId), data.message.id);
        if (!isActiveConversation) playChatDing();

        if (isCurrentConversationOpen && !messageExistsInContainer(data.message.id)) {
            appendMessage(data.message);
        }

        if (isActiveConversation) {
            markConversationReadLocally(data.convId);
            if (socket && socket.connected) {
                socket.emit('mark_conversation_read', {
                    convId: data.convId,
                    messageId: data.message.id
                });
            }
        } else {
            if (socket && socket.connected) socket.emit('mark_delivered', { convId: data.convId, messageId: data.message.id });
            if (isModalOpen && !isCurrentConversationOpen) refreshInbox();
        }
    });

    socket.on('unread_state', (data) => {
        applyUnreadState(data.convId, data.unreadCount, data.totalUnread);
    });

    socket.on('status_update', (data) => {
        const statusContainer = document.getElementById(`status-${data.messageId}`);
        if (statusContainer) {
            if (data.status === 'delivered') statusContainer.innerHTML = '<i class="bi bi-check-all status-delivered msg-status"></i>';
            else if (data.status === 'read') statusContainer.innerHTML = '<i class="bi bi-check-all status-read msg-status"></i>';
        }
    });

    socket.on('on_conversation_deleted', (data) => {
        refreshInbox();
        if (currentConvId === data.convId) {
            currentConvId = null;
            document.getElementById('chatActiveView').classList.add('d-none');
            document.getElementById('chatEmptyState').classList.remove('d-none');
            safeShowAlert("The other user has deleted this conversation.", "warning");
        }
    });
}

async function ensureChatSocket() {
    if (!chatAccess.canRead) return null;
    if (socket && socket.connected) return socket;
    if (socketReadyPromise) return socketReadyPromise;

    socketReadyPromise = (async () => {
        try {
            if (typeof io === 'undefined') {
                await loadScript('/socket.io/socket.io.js');
            }
            if (!socket) {
                socket = io({ autoConnect: false });
                bindChatSocketHandlers();
            }
            if (!socket.connected) {
                socket.connect();
                await new Promise((resolve, reject) => {
                    const timeout = setTimeout(() => {
                        cleanup();
                        reject(new Error('Chat connection timeout'));
                    }, 15000);
                    const onConnect = () => {
                        cleanup();
                        resolve();
                    };
                    const onError = (error) => {
                        cleanup();
                        reject(error || new Error('Chat connection failed'));
                    };
                    const cleanup = () => {
                        clearTimeout(timeout);
                        socket.off('connect', onConnect);
                        socket.off('connect_error', onError);
                    };
                    socket.on('connect', onConnect);
                    socket.on('connect_error', onError);
                });
            }
            socket.emit('identify', currentUser.id);
            return socket;
        } catch (error) {
            console.warn('Chat connection rejected:', error && error.message ? error.message : error);
            socketReadyPromise = null;
            return null;
        }
    })();

    return socketReadyPromise;
}

function initChatFormHandler() {
    const form = document.getElementById('chatForm');
    if (!form || form.dataset.chatBound === '1') return;
    form.dataset.chatBound = '1';
    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!chatAccess.canUpdate || !currentConversationCanMessage) {
            safeShowAlert(currentConversationScopeReason || 'This conversation is read-only.', 'warning');
            return;
        }
        const input = document.getElementById('chatInput');
        const text = input.value.trim();
        if (!text && pendingAttachments.length === 0) return;

        if (pendingAttachments.length > 0) {
            await uploadPendingFiles();
        }

        if (text) {
            const tempId = 'temp_' + Date.now();
            appendMessage({
                id: tempId, content: text, senderId: currentUser.id, type: 'text', status: 'sending'
            }, true);
            if (!socket || !socket.connected) {
                await ensureChatSocket();
            }
            if (!socket || !socket.connected) {
                safeShowAlert('Chat connection is not available yet. Please try again.', 'warning');
                return;
            }
            socket.emit('send_message', {
                tempId: tempId, convId: currentConvId, content: text, type: 'text', senderId: currentUser.id
            });
            input.value = '';
            input.style.height = '38px';
        }
    });
}

function initMessageScrollLoader() {
    const container = document.getElementById('chatMessageContainer');
    if (!container || container.dataset.scrollBound === '1') return;
    container.dataset.scrollBound = '1';
    container.addEventListener('scroll', () => {
        if (!currentConvId || !hasMoreOlderMessages || loadingOlderMessages) return;
        if (container.scrollTop < 80) loadOlderMessages();
    });
}

function initChatSystem() {
    if (!chatAccess.canRead) return;
    refreshInbox();
    initMessageScrollLoader();
    initChatFormHandler();
}

function buildAvatarHtml(name, avatarUrl, size = 40, bgClass = 'bg-secondary', textClass = 'text-white') {
    const displayName = String(name || 'U');
    const initial = displayName.charAt(0).toUpperCase() || 'U';
    const safeName = safeText(displayName);
    const safeAvatarUrl = String(avatarUrl || '').trim();
    if (safeAvatarUrl) {
        return `<img src="${safeAttr(safeAvatarUrl)}" alt="${safeName}" class="rounded-circle" style="width: ${size}px; height: ${size}px; object-fit: cover;" onerror="this.remove();">`;
    }
    return `<div class="rounded-circle ${bgClass} ${textClass} d-flex align-items-center justify-content-center fw-bold" style="width: ${size}px; height: ${size}px; font-size: 1rem;">${safeText(initial)}</div>`;
}

// --- CUSTOM MODAL HELPER ---
async function safeShowAlert(msg, type = 'info') {
    if (typeof window.showMessageModal === 'function') {
        const btn_class = (type === 'info' ? 'btn-primary' : type === 'error' ? 'btn-danger' : type === 'success' ? 'btn-success' : 'btn-warning');
        await window.showMessageModal({
            title: type.charAt(0).toUpperCase() + type.slice(1),
            icon: type, 
            message: msg,
            size: 'sm',
            buttons: [{ text: 'OK', class: btn_class }]
        });
    } else {
        alert(msg);
    }
}

document.addEventListener('DOMContentLoaded', () => {
    // 1. Move Modal to Body
    const modalEl = document.getElementById('chatInterfaceModal');
    if(modalEl) document.body.appendChild(modalEl);
    if(!modalEl) return;
    
    // 2. Init Logic
    initChatSystem();
    initResizers();
    initChatSoundControls();
    initBroadcastComposer();
    window.addEventListener('focus', markActiveConversationRead);
    document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') markActiveConversationRead();
    });

    // 3. Connect socket and refresh when modal opens
    modalEl.addEventListener('show.bs.modal', async () => {
        await ensureChatSocket();
        showInbox();
        const modalContent = document.getElementById('chatModalContent');
        if (modalContent) {
            applyChatModalTransform(modalContent);
            keepChatModalInViewport(modalContent);
            setChatModalDragHandleState();
        }

        const sidebar = document.getElementById('chatSidebar');
        if (sidebar && sidebar.classList.contains('d-none')) {
            toggleSidebar();
        }

        if (currentConvId && typeof currentChatName !== 'undefined') {
            setTimeout(() => {
                openChat(
                    currentConvId,
                    currentChatName,
                    currentChatTarget,
                    currentChatAvatar,
                    window.currentChatCanMessage,
                    window.currentChatScopeReason
                );
            }, 100);
        }
    });
    modalEl.addEventListener('hidden.bs.modal', () => {
        if (socket && socket.connected) socket.disconnect();
        socketReadyPromise = null;
    });
});
async function uploadPendingFiles() {
    if (!currentConvId) return;
    if (!chatAccess.canUpdate || !currentConversationCanMessage) {
        safeShowAlert(currentConversationScopeReason || 'This conversation is read-only.', 'warning');
        return;
    }
    if (!socket || !socket.connected) {
        await ensureChatSocket();
    }
    if (!socket || !socket.connected) {
        safeShowAlert('Chat connection is not available yet. Please try again.', 'warning');
        return;
    }

    // 1. Show Loading
    const loadingId = 'temp_load_' + Date.now();
    appendMessage({
        id: loadingId, content: '<div class="spinner-border spinner-border-sm"></div> Sending files...', 
        senderId: currentUser.id, type: 'text', status: 'sending'
    }, true);
    scrollToBottom();

    const formData = new FormData();
    formData.append('convId', currentConvId);
    pendingAttachments.forEach(file => formData.append('files', file));

    try {
        const resp = await fetch('/chat/upload', { method: 'POST', body: formData });
        const res = await resp.json();

        // Remove loading bubble
        const tempRow = document.getElementById(`msg-row-${loadingId}`);
        if(tempRow) tempRow.remove();

        if (res.status === 'success') {
            pendingAttachments = [];
            renderPreviews();

            // 2. Process uploaded files
            res.files.forEach(f => {
                // A. Emit to Server (for Recipient)
                if (socket && socket.connected) socket.emit('send_message', {
                    convId: currentConvId,
                    content: f.type === 'image' ? 'Image' : 'File',
                    type: f.type,
                    fileUrl: f.url,
                    senderId: currentUser.id
                });

                // B. RENDER LOCALLY (Fixes "I don't see my image")
                appendMessage({
                    id: 'temp_img_sent_' + Date.now() + Math.random(),
                    content: f.type === 'image' ? 'Image' : 'File',
                    type: f.type,
                    fileUrl: f.url,
                    senderId: currentUser.id,
                    timestamp: new Date(),
                    status: 'sent'
                });
            });
        } else {
            if (resp.status === 403) {
                setConversationWriteState(false, res.message || 'This conversation is read-only.');
            }
            safeShowAlert("Upload failed: " + res.message, "error");
        }
    } catch (e) {
        console.error(e);
        const tempRow = document.getElementById(`msg-row-${loadingId}`);
        if(tempRow) tempRow.remove();
        safeShowAlert("Connection error during upload.", "error");
    }
}

async function deleteCurrentChat() {
    if (!currentConvId) return;
    if (!chatAccess.canDelete) {
        safeShowAlert('Your access profile does not allow deleting conversations.', 'warning');
        return;
    }
    let isConfirmed = false;
    if (typeof window.showMessageModal === 'function') {
        const btnResult = await window.showMessageModal({
            title: 'Confirm Delete',
            icon: 'warning',
            message: 'Are you sure? This will delete the chat for BOTH users.',
            size: 'md',
            buttons: [
                { text: 'Cancel', class: 'btn-secondary btn-md' },
                { text: 'Delete', class: 'btn-danger btn-md' }
            ]
        });
        if (btnResult === 'Delete') isConfirmed = true;
    } else {
        isConfirmed = confirm("Are you sure? This will permanently delete the conversation.");
    }

    if (!isConfirmed) return;

    try {
        const resp = await fetch(`/chat/delete/${currentConvId}`, { method: 'DELETE' });
        const res = await resp.json();
        if (res.status === 'success') {
            // Notify other user via Socket
            if (socket && socket.connected) socket.emit('conversation_deleted', { convId: currentConvId });

            currentConvId = null;
            document.getElementById('chatActiveView').classList.add('d-none');
            document.getElementById('chatEmptyState').classList.remove('d-none');
            refreshInbox();
            safeShowAlert("Conversation deleted successfully.", "success");
        } else {
            safeShowAlert(res.message || "Failed to delete chat.", "error");
        }
    } catch (e) {
        console.error(e);
        safeShowAlert("Error connecting to server.", "error");
    }
}

function messageExistsInContainer(messageId) {
    if (!messageId) return false;
    return Boolean(document.getElementById(`msg-row-${messageId}`));
}

function normalizeMessageTextForDisplay(value) {
    return String(value == null ? '' : value)
        .replace(/\r\n/g, '\n')
        .replace(/\r/g, '\n');
}

function buildMessageHtml(msg, isTemp = false) {
    const isMine = String(msg.senderId) === String(currentUser.id);
    const typeClass = isMine ? 'msg-sent' : 'msg-received';
    const alignClass = isMine ? 'align-self-end' : 'align-self-start';

    let statusIcon = '';
    if (isMine) {
        if (isTemp) {
            statusIcon = '<i class="bi bi-clock status-sending msg-status" title="Sending..."></i>';
        } else {
            switch (msg.status) {
                case 'read': statusIcon = '<i class="bi bi-check-all status-read msg-status"></i>'; break;
                case 'delivered': statusIcon = '<i class="bi bi-check-all status-delivered msg-status"></i>'; break;
                default: statusIcon = '<i class="bi bi-check status-sent msg-status"></i>'; break;
            }
        }
    }

    let contentHtml = `<div class="msg-text-content">${safeText(normalizeMessageTextForDisplay(msg.content))}</div>`;
    if (msg.type === 'image') {
        const safeUrl = encodeURI(msg.fileUrl).replace(/%25/g, '%');
        contentHtml = `<a href="${safeUrl}" target="_blank"><img src="${safeUrl}" class="img-fluid rounded mb-1" style="max-width: 200px; min-height: 50px; background: #f0f0f0;"></a>`;
    } else if (msg.type === 'file') {
        contentHtml = `<a href="${msg.fileUrl}" target="_blank" class="text-decoration-none d-flex align-items-center p-2 border rounded bg-white"><i class="bi bi-file-earmark-arrow-down fs-4 me-2 text-primary"></i><div><div class="small fw-bold text-dark">Attachment</div><div class="x-small text-muted">Download</div></div></a>`;
    }

    return `
    <div class="d-flex flex-column ${alignClass}" style="max-width: 85%;" id="msg-row-${msg.id || 'temp'}">
        <div class="msg-bubble ${typeClass}">
            ${contentHtml}
            <div class="d-flex align-items-center justify-content-end mt-1">
                <span class="msg-time small text-muted" style="font-size:0.65rem;">
                    ${isTemp ? 'Now' : new Date(msg.timestamp || msg.sentAt || Date.now()).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'})}
                </span>
                <span class="status-container" id="status-${msg.id}">${statusIcon}</span>
            </div>
        </div>
    </div>`;
}

function insertMessageHtml(html, position) {
    const container = document.getElementById('chatMessageContainer');
    if (!container) return;
    const slot = document.getElementById('chatLoadOlderSlot');
    if (position === 'afterbegin' && slot && slot.parentElement === container) {
        slot.insertAdjacentHTML('afterend', html);
        return;
    }
    container.insertAdjacentHTML(position, html);
}

function appendMessage(msg, isTemp = false, scrollAfter = true) {
    if (messageExistsInContainer(msg.id) && !isTemp) return;
    insertMessageHtml(buildMessageHtml(msg, isTemp), 'beforeend');
    if (scrollAfter) scrollToBottom();
}

function prependMessages(messages) {
    const container = document.getElementById('chatMessageContainer');
    if (!container || !Array.isArray(messages) || messages.length === 0) return;
    const previousHeight = container.scrollHeight;
    const previousTop = container.scrollTop;
    messages.forEach((message) => {
        if (messageExistsInContainer(message.id)) return;
        insertMessageHtml(buildMessageHtml(message, false), 'afterbegin');
    });
    container.scrollTop = previousTop + (container.scrollHeight - previousHeight);
}

function updateLoadOlderIndicator() {
    const container = document.getElementById('chatMessageContainer');
    if (!container) return;
    let slot = document.getElementById('chatLoadOlderSlot');
    if (!slot) {
        slot = document.createElement('div');
        slot.id = 'chatLoadOlderSlot';
        slot.className = 'text-center small text-muted py-2';
        container.insertAdjacentElement('afterbegin', slot);
    }
    if (loadingOlderMessages) {
        slot.classList.remove('d-none');
        slot.innerHTML = '<div class="spinner-border spinner-border-sm text-secondary"></div>';
        return;
    }
    if (hasMoreOlderMessages) {
        slot.classList.remove('d-none');
        slot.innerHTML = '<span>Scroll up for older messages</span>';
        return;
    }
    slot.classList.add('d-none');
    slot.innerHTML = '';
}

async function loadOlderMessages() {
    if (!currentConvId || !hasMoreOlderMessages || loadingOlderMessages || !oldestLoadedMessageId) return;
    loadingOlderMessages = true;
    updateLoadOlderIndicator();
    try {
        const url = `/chat/messages/${encodeURIComponent(currentConvId)}?limit=${CHAT_MESSAGE_PAGE_SIZE}&before=${encodeURIComponent(oldestLoadedMessageId)}`;
        const resp = await fetch(url);
        const res = await resp.json();
        if (res.status === 'success' && Array.isArray(res.data) && res.data.length) {
            prependMessages(res.data);
            hasMoreOlderMessages = Boolean(res.pagination?.hasMore);
            oldestLoadedMessageId = res.pagination?.oldestId || res.data[0]?.id || oldestLoadedMessageId;
        } else {
            hasMoreOlderMessages = false;
        }
    } catch (_) {
        hasMoreOlderMessages = false;
    } finally {
        loadingOlderMessages = false;
        updateLoadOlderIndicator();
    }
}

function scrollToBottom() {
    const container = document.getElementById('chatMessageContainer');
    if(container) container.scrollTop = container.scrollHeight;
}

function handleFileSelection(input) {
    if (!chatAccess.canUpdate || !currentConversationCanMessage) {
        safeShowAlert(currentConversationScopeReason || 'This conversation is read-only.', 'warning');
        input.value = '';
        return;
    }
    if (!input.files || input.files.length === 0) return;
    const MAX_SIZE = 5 * 1024 * 1024; 
    Array.from(input.files).forEach(file => {
        if (pendingAttachments.length >= 3) { safeShowAlert("Maximum 3 files allowed.", "warning"); return; }
        if (file.size > MAX_SIZE) { safeShowAlert("File too large (Max 5MB).", "error"); return; }
        pendingAttachments.push(file);
    });
    renderPreviews();
    input.value = ''; 
}

function renderPreviews() {
    const area = document.getElementById('attachmentPreviewArea');
    area.innerHTML = '';
    if (pendingAttachments.length === 0) { area.classList.add('d-none'); return; }
    area.classList.remove('d-none');
    pendingAttachments.forEach((file, index) => {
        const isImage = file.type.startsWith('image/');
        let innerHTML = isImage ? `<img src="${URL.createObjectURL(file)}">` : `<i class="bi bi-file-earmark-text att-preview-file"></i>`;
        const card = document.createElement('div');
        card.className = 'att-preview-card';
        card.innerHTML = `${innerHTML}<div class="att-preview-remove" onclick="removeAttachment(${index})">&times;</div>`;
        area.appendChild(card);
    });
}

function removeAttachment(index) {
    pendingAttachments.splice(index, 1);
    renderPreviews();
}

function applyChatModalTransform(modalContent) {
    if (!modalContent) return;
    modalContent.style.transform = `translate(${chatModalOffsetX}px, ${chatModalOffsetY}px)`;
}

function setChatModalDragHandleState() {
    const handle = document.getElementById('chatModalDragHandle');
    if (!handle) return;
    handle.title = chatModalIsMaximized ? 'Restore Chat Window' : 'Move Chat Window';
    handle.setAttribute('aria-label', handle.title);
    handle.innerHTML = chatModalIsMaximized
        ? '<i class="bi bi-fullscreen-exit"></i>'
        : '<i class="bi bi-arrows-move"></i>';
}

function getChatModalMaxSize() {
    return {
        width: Math.max(350, window.innerWidth - 8),
        height: Math.max(400, window.innerHeight - 8)
    };
}

function setChatModalSize(modalContent, width, height) {
    if (!modalContent) return;
    const modalDialog = document.getElementById('chatModalDialog');
    const normalizedWidth = Math.max(350, Math.floor(width));
    if (modalDialog) {
        modalDialog.style.width = `${normalizedWidth}px`;
    }
    modalContent.style.width = modalDialog ? '100%' : `${normalizedWidth}px`;
    modalContent.style.height = `${Math.max(400, Math.floor(height))}px`;
}

function toggleChatModalMaximize(modalContent, reason = 'manual') {
    if (!modalContent) return;
    if (!chatModalIsMaximized) {
        chatModalRestoreState = {
            width: modalContent.offsetWidth,
            height: modalContent.offsetHeight,
            offsetX: chatModalOffsetX,
            offsetY: chatModalOffsetY
        };
        const fullSize = getChatModalMaxSize();
        chatModalOffsetX = 0;
        chatModalOffsetY = 0;
        setChatModalSize(modalContent, fullSize.width, fullSize.height);
        applyChatModalTransform(modalContent);
        chatModalIsMaximized = true;
    } else {
        const restore = chatModalRestoreState || {};
        chatModalOffsetX = Number.isFinite(restore.offsetX) ? restore.offsetX : 0;
        chatModalOffsetY = Number.isFinite(restore.offsetY) ? restore.offsetY : 0;
        setChatModalSize(
            modalContent,
            Number.isFinite(restore.width) ? restore.width : 900,
            Number.isFinite(restore.height) ? restore.height : 600
        );
        applyChatModalTransform(modalContent);
        chatModalIsMaximized = false;
    }
    setChatModalDragHandleState();
    keepChatModalInViewport(modalContent);
}

function clampChatModalPosition(rect) {
    const minVisibleX = Math.max(72, Math.min(160, Math.floor(rect.width * 0.25)));
    const minVisibleY = Math.max(56, Math.min(120, Math.floor(rect.height * 0.2)));
    const minLeft = -(rect.width - minVisibleX);
    const maxLeft = Math.max(minLeft, window.innerWidth - minVisibleX);
    const minTop = -(rect.height - minVisibleY);
    const maxTop = Math.max(minTop, window.innerHeight - minVisibleY);
    return { minLeft, maxLeft, minTop, maxTop };
}

function keepChatModalInViewport(modalContent) {
    if (!modalContent) return;
    const rect = modalContent.getBoundingClientRect();
    const bounds = clampChatModalPosition(rect);
    let adjustX = 0;
    let adjustY = 0;
    if (rect.left < bounds.minLeft) adjustX = bounds.minLeft - rect.left;
    else if (rect.left > bounds.maxLeft) adjustX = bounds.maxLeft - rect.left;
    if (rect.top < bounds.minTop) adjustY = bounds.minTop - rect.top;
    else if (rect.top > bounds.maxTop) adjustY = bounds.maxTop - rect.top;
    if (adjustX !== 0 || adjustY !== 0) {
        chatModalOffsetX += adjustX;
        chatModalOffsetY += adjustY;
        applyChatModalTransform(modalContent);
    }
}

function resetBroadcastComposer() {
    broadcastRecipients = [];
    selectedBroadcastRecipients.clear();
    broadcastPendingAttachments = [];
    const searchInput = document.getElementById('chatBroadcastSearchInput');
    const messageInput = document.getElementById('chatBroadcastMessageInput');
    const fileInput = document.getElementById('chatBroadcastFileInput');
    const listEl = document.getElementById('chatBroadcastRecipientList');
    if (searchInput) searchInput.value = '';
    if (messageInput) messageInput.value = '';
    if (fileInput) fileInput.value = '';
    if (listEl) {
        listEl.innerHTML = '<div class="text-muted small">Use search to find recipients.</div>';
    }
    renderBroadcastSelectedRecipients();
    renderBroadcastAttachmentPreviews();
}

function renderBroadcastSelectedRecipients() {
    const selectedEl = document.getElementById('chatBroadcastSelectedRecipients');
    const counterEl = document.getElementById('chatBroadcastRecipientCount');
    const selectedRows = [...selectedBroadcastRecipients.values()];
    if (counterEl) {
        const count = selectedRows.length;
        counterEl.textContent = `${count} recipient${count === 1 ? '' : 's'} selected`;
    }
    if (!selectedEl) return;
    if (!selectedRows.length) {
        selectedEl.innerHTML = '<span class="small text-muted">No recipients selected yet.</span>';
        return;
    }
    selectedEl.innerHTML = selectedRows.map((row) => (
        `<span class="broadcast-recipient-chip">${safeText(row.name || row.id)}</span>`
    )).join('');
}

function renderBroadcastRecipients() {
    const listEl = document.getElementById('chatBroadcastRecipientList');
    if (!listEl) return;
    listEl.innerHTML = '';
    if (!broadcastRecipients.length) {
        listEl.innerHTML = '<div class="text-muted small">No users found.</div>';
        return;
    }

    broadcastRecipients.forEach((recipient) => {
        const recipientId = String(recipient.id || '').trim();
        if (!recipientId) return;
        const isSelected = selectedBroadcastRecipients.has(recipientId);
        const row = document.createElement('button');
        row.type = 'button';
        row.className = `broadcast-recipient-row chat-item d-flex align-items-center w-100 text-start border rounded mb-1 ${isSelected ? 'active' : ''}`;
        row.innerHTML = `
            <div class="me-2 flex-shrink-0">
                ${buildAvatarHtml(recipient.name || recipient.id, recipient.avatar || '', 32, 'bg-primary-subtle', 'text-primary')}
            </div>
            <div class="flex-grow-1 overflow-hidden">
                <div class="small fw-semibold text-truncate">${safeText(recipient.name || recipient.id)}</div>
                <div class="x-small text-muted text-truncate">${safeText(recipient.email || recipient.org || 'User')}</div>
            </div>
            <div class="ms-2">
                <input type="checkbox" class="form-check-input" ${isSelected ? 'checked' : ''} aria-label="Select recipient">
            </div>
        `;
        row.addEventListener('click', () => {
            if (selectedBroadcastRecipients.has(recipientId)) selectedBroadcastRecipients.delete(recipientId);
            else selectedBroadcastRecipients.set(recipientId, recipient);
            renderBroadcastSelectedRecipients();
            renderBroadcastRecipients();
        });
        listEl.appendChild(row);
    });
}

async function fetchBroadcastUsers(query = '') {
    if (!chatAccess.canBroadcast) return;
    const listEl = document.getElementById('chatBroadcastRecipientList');
    if (!listEl) return;
    listEl.innerHTML = '<div class="text-center mt-3"><div class="spinner-border spinner-border-sm text-secondary"></div></div>';
    try {
        const resp = await fetch(`/chat/broadcast/users/search?q=${encodeURIComponent(query || '')}&limit=100`);
        const payload = await resp.json();
        if (!resp.ok || payload.status !== 'success') {
            listEl.innerHTML = `<div class="text-danger small">${safeText(payload.message || 'Unable to load recipients.')}</div>`;
            return;
        }
        broadcastRecipients = Array.isArray(payload.data) ? payload.data : [];
        renderBroadcastRecipients();
    } catch (error) {
        console.error(error);
        listEl.innerHTML = '<div class="text-danger small">Unable to load recipients right now.</div>';
    }
}

function handleBroadcastFileSelection(input) {
    if (!input?.files || !input.files.length) return;
    const MAX_SIZE = 5 * 1024 * 1024;
    Array.from(input.files).forEach((file) => {
        if (broadcastPendingAttachments.length >= 3) {
            safeShowAlert('Maximum 3 files allowed.', 'warning');
            return;
        }
        if (file.size > MAX_SIZE) {
            safeShowAlert('File too large (Max 5MB).', 'error');
            return;
        }
        broadcastPendingAttachments.push(file);
    });
    renderBroadcastAttachmentPreviews();
    input.value = '';
}

function renderBroadcastAttachmentPreviews() {
    const area = document.getElementById('chatBroadcastAttachmentPreview');
    if (!area) return;
    area.innerHTML = '';
    if (!broadcastPendingAttachments.length) {
        area.classList.add('d-none');
        return;
    }
    area.classList.remove('d-none');
    broadcastPendingAttachments.forEach((file, index) => {
        const isImage = String(file.type || '').startsWith('image/');
        const innerHTML = isImage
            ? `<img src="${URL.createObjectURL(file)}">`
            : '<i class="bi bi-file-earmark-text att-preview-file"></i>';
        const card = document.createElement('div');
        card.className = 'att-preview-card';
        card.innerHTML = `${innerHTML}<div class="att-preview-remove" data-remove-index="${index}">&times;</div>`;
        const removeBtn = card.querySelector('.att-preview-remove');
        if (removeBtn) {
            removeBtn.addEventListener('click', () => {
                broadcastPendingAttachments.splice(index, 1);
                renderBroadcastAttachmentPreviews();
            });
        }
        area.appendChild(card);
    });
}

async function submitBroadcastForm(event) {
    event.preventDefault();
    if (broadcastSending) return;
    if (!chatAccess.canBroadcast) {
        safeShowAlert('Your access profile does not allow broadcast messaging.', 'warning');
        return;
    }

    const recipientIds = [...selectedBroadcastRecipients.keys()];
    const messageInput = document.getElementById('chatBroadcastMessageInput');
    const sendButton = document.getElementById('chatBroadcastSendButton');
    const content = String(messageInput?.value || '').trim();
    if (!recipientIds.length) {
        safeShowAlert('Select at least one recipient.', 'warning');
        return;
    }
    if (!content && broadcastPendingAttachments.length === 0) {
        safeShowAlert('Enter a message or attach at least one file.', 'warning');
        return;
    }

    broadcastSending = true;
    if (sendButton) {
        sendButton.disabled = true;
        sendButton.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Sending...';
    }

    const campaignId = `BROADCAST_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;
    const formData = new FormData();
    formData.append('recipientIds', JSON.stringify(recipientIds));
    formData.append('content', content);
    broadcastPendingAttachments.forEach((file) => formData.append('files', file));

    try {
        const response = await fetch(`/chat/broadcast/${encodeURIComponent(campaignId)}`, {
            method: 'POST',
            body: formData
        });
        const payload = await response.json();
        if (!response.ok || payload.status !== 'success') {
            safeShowAlert(payload.message || 'Broadcast send failed.', 'error');
            return;
        }

        const sentCount = Number(payload?.data?.sentCount) || 0;
        const skippedCount = Number(payload?.data?.skippedCount) || 0;
        const failedCount = Number(payload?.data?.failedCount) || 0;
        let summary = `Broadcast sent to ${sentCount} recipient(s).`;
        if (skippedCount > 0) summary += ` Skipped: ${skippedCount}.`;
        if (failedCount > 0) summary += ` Failed: ${failedCount}.`;
        safeShowAlert(summary, failedCount > 0 ? 'warning' : 'success');

        const modalEl = document.getElementById('chatBroadcastModal');
        if (modalEl && typeof bootstrap !== 'undefined' && bootstrap.Modal) {
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.hide();
        }
        refreshInbox();
    } catch (error) {
        console.error(error);
        safeShowAlert('Unable to send broadcast right now.', 'error');
    } finally {
        broadcastSending = false;
        if (sendButton) {
            sendButton.disabled = false;
            sendButton.innerHTML = 'Send Broadcast';
        }
    }
}

function startBroadcastWizard() {
    if (!chatAccess.canBroadcast) {
        safeShowAlert('Your access profile does not allow broadcast messaging.', 'warning');
        return;
    }
    const modalEl = document.getElementById('chatBroadcastModal');
    if (!modalEl || typeof bootstrap === 'undefined' || !bootstrap.Modal) {
