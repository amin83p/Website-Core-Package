function initBroadcastComposer() {
    const form = document.getElementById('chatBroadcastForm');
    if (!form || form.dataset.bound === '1') return;
    form.dataset.bound = '1';

    const searchInput = document.getElementById('chatBroadcastSearchInput');
    const attachButton = document.getElementById('chatBroadcastAttachButton');
    const fileInput = document.getElementById('chatBroadcastFileInput');
    const modalEl = document.getElementById('chatBroadcastModal');
    let searchTimer = null;

    if (searchInput) {
        searchInput.addEventListener('input', () => {
            if (searchTimer) clearTimeout(searchTimer);
            searchTimer = setTimeout(() => {
                fetchBroadcastUsers(searchInput.value || '');
            }, 180);
        });
    }
    if (attachButton && fileInput) {
        attachButton.addEventListener('click', () => fileInput.click());
        fileInput.addEventListener('change', () => handleBroadcastFileSelection(fileInput));
    }
    form.addEventListener('submit', submitBroadcastForm);
    if (modalEl) {
        modalEl.addEventListener('hidden.bs.modal', () => {
            resetBroadcastComposer();
        });
    }
}

function initResizers() {
    const tx = document.getElementById('chatInput');
    if (tx) {
        tx.addEventListener("input", function() {
            this.style.height = 0;
            this.style.height = this.scrollHeight + "px";
            this.style.overflowY = this.scrollHeight > 160 ? "scroll" : "hidden";
        }, false);
    }

    const sidebar = document.getElementById('chatSidebar');
    const sidebarResizer = document.getElementById('sidebarResizer');
    const modalBody = document.querySelector('#chatInterfaceModal .modal-body');
    const modalContent = document.getElementById('chatModalContent');
    const modalDialog = document.getElementById('chatModalDialog');
    const modalResizer = document.getElementById('modalResizer');
    const modalDragHandle = document.getElementById('chatModalDragHandle');

    if (sidebar && sidebarResizer && modalBody) {
        let draggingSidebar = false;

        const onSidebarMove = (clientX) => {
            if (!draggingSidebar) return;
            const bodyRect = modalBody.getBoundingClientRect();
            const minW = 180;
            const maxW = Math.max(minW, Math.floor(bodyRect.width * 0.65));
            const newW = Math.max(minW, Math.min(maxW, clientX - bodyRect.left));
            sidebar.style.width = `${newW}px`;
            previousSidebarWidth = newW;
        };

        const stopSidebarDrag = () => {
            draggingSidebar = false;
            document.body.style.userSelect = '';
            document.body.style.cursor = '';
            window.removeEventListener('mousemove', mouseSidebarMove);
            window.removeEventListener('mouseup', stopSidebarDrag);
            window.removeEventListener('touchmove', touchSidebarMove);
            window.removeEventListener('touchend', stopSidebarDrag);
        };

        const mouseSidebarMove = (e) => onSidebarMove(e.clientX);
        const touchSidebarMove = (e) => {
            if (!e.touches || !e.touches.length) return;
            onSidebarMove(e.touches[0].clientX);
        };

        sidebarResizer.addEventListener('mousedown', (e) => {
            e.preventDefault();
            draggingSidebar = true;
            document.body.style.userSelect = 'none';
            document.body.style.cursor = 'col-resize';
            window.addEventListener('mousemove', mouseSidebarMove);
            window.addEventListener('mouseup', stopSidebarDrag);
        });

        sidebarResizer.addEventListener('touchstart', (e) => {
            draggingSidebar = true;
            document.body.style.userSelect = 'none';
            document.body.style.cursor = 'col-resize';
            window.addEventListener('touchmove', touchSidebarMove, { passive: true });
            window.addEventListener('touchend', stopSidebarDrag);
        }, { passive: true });
    }

    if (modalContent && modalResizer) {
        let draggingModal = false;
        let startX = 0;
        let startY = 0;
        let startW = 0;
        let startH = 0;
        let draggingWindow = false;
        let windowStartX = 0;
        let windowStartY = 0;
        let windowStartOffsetX = 0;
        let windowStartOffsetY = 0;
        let windowStartRect = null;

        const onModalMove = (clientX, clientY) => {
            if (!draggingModal) return;
            const deltaX = clientX - startX;
            const deltaY = clientY - startY;
            const minW = 350;
            const minH = 400;
            const maxW = Math.max(minW, window.innerWidth - 8);
            const maxH = Math.max(minH, window.innerHeight - 8);
            const newW = Math.max(minW, Math.min(maxW, startW + deltaX));
            const newH = Math.max(minH, Math.min(maxH, startH + deltaY));
            if (modalDialog) modalDialog.style.width = `${newW}px`;
            modalContent.style.width = modalDialog ? '100%' : `${newW}px`;
            modalContent.style.height = `${newH}px`;
        };

        const stopModalDrag = () => {
            draggingModal = false;
            document.body.style.userSelect = '';
            document.body.style.cursor = '';
            window.removeEventListener('mousemove', mouseModalMove);
            window.removeEventListener('mouseup', stopModalDrag);
            window.removeEventListener('touchmove', touchModalMove);
            window.removeEventListener('touchend', stopModalDrag);
            keepChatModalInViewport(modalContent);
        };

        const mouseModalMove = (e) => onModalMove(e.clientX, e.clientY);
        const touchModalMove = (e) => {
            if (!e.touches || !e.touches.length) return;
            onModalMove(e.touches[0].clientX, e.touches[0].clientY);
        };

        const onWindowMove = (clientX, clientY) => {
            if (!draggingWindow || !windowStartRect) return;
            const deltaX = clientX - windowStartX;
            const deltaY = clientY - windowStartY;
            const candidateOffsetX = windowStartOffsetX + deltaX;
            const candidateOffsetY = windowStartOffsetY + deltaY;
            const nextLeft = windowStartRect.left + (candidateOffsetX - windowStartOffsetX);
            const nextTop = windowStartRect.top + (candidateOffsetY - windowStartOffsetY);
            const bounds = clampChatModalPosition(windowStartRect);
            const clampedLeft = Math.max(bounds.minLeft, Math.min(bounds.maxLeft, nextLeft));
            const clampedTop = Math.max(bounds.minTop, Math.min(bounds.maxTop, nextTop));
            chatModalOffsetX = windowStartOffsetX + (clampedLeft - windowStartRect.left);
            chatModalOffsetY = windowStartOffsetY + (clampedTop - windowStartRect.top);
            applyChatModalTransform(modalContent);
        };

        const stopWindowDrag = () => {
            draggingWindow = false;
            windowStartRect = null;
            document.body.style.userSelect = '';
            document.body.style.cursor = '';
            window.removeEventListener('mousemove', mouseWindowMove);
            window.removeEventListener('mouseup', stopWindowDrag);
            window.removeEventListener('touchmove', touchWindowMove);
            window.removeEventListener('touchend', stopWindowDrag);
            keepChatModalInViewport(modalContent);
        };

        const mouseWindowMove = (e) => onWindowMove(e.clientX, e.clientY);
        const touchWindowMove = (e) => {
            if (!e.touches || !e.touches.length) return;
            onWindowMove(e.touches[0].clientX, e.touches[0].clientY);
        };

        modalResizer.addEventListener('mousedown', (e) => {
            e.preventDefault();
            draggingModal = true;
            if (chatModalIsMaximized) {
                chatModalIsMaximized = false;
                setChatModalDragHandleState();
            }
            startX = e.clientX;
            startY = e.clientY;
            startW = modalDialog ? modalDialog.offsetWidth : modalContent.offsetWidth;
            startH = modalContent.offsetHeight;
            document.body.style.userSelect = 'none';
            document.body.style.cursor = 'nwse-resize';
            window.addEventListener('mousemove', mouseModalMove);
            window.addEventListener('mouseup', stopModalDrag);
        });

        modalResizer.addEventListener('touchstart', (e) => {
            if (!e.touches || !e.touches.length) return;
            draggingModal = true;
            if (chatModalIsMaximized) {
                chatModalIsMaximized = false;
                setChatModalDragHandleState();
            }
            startX = e.touches[0].clientX;
            startY = e.touches[0].clientY;
            startW = modalDialog ? modalDialog.offsetWidth : modalContent.offsetWidth;
            startH = modalContent.offsetHeight;
            document.body.style.userSelect = 'none';
            document.body.style.cursor = 'nwse-resize';
            window.addEventListener('touchmove', touchModalMove, { passive: true });
            window.addEventListener('touchend', stopModalDrag);
        }, { passive: true });

        if (modalDragHandle) {
            modalDragHandle.addEventListener('dblclick', () => {
                toggleChatModalMaximize(modalContent, 'double-click');
            });
            modalDragHandle.addEventListener('mousedown', (e) => {
                e.preventDefault();
                draggingWindow = true;
                windowStartX = e.clientX;
                windowStartY = e.clientY;
                windowStartOffsetX = chatModalOffsetX;
                windowStartOffsetY = chatModalOffsetY;
                windowStartRect = modalContent.getBoundingClientRect();
                document.body.style.userSelect = 'none';
                document.body.style.cursor = 'move';
                window.addEventListener('mousemove', mouseWindowMove);
                window.addEventListener('mouseup', stopWindowDrag);
            });
            modalDragHandle.addEventListener('touchstart', (e) => {
                if (!e.touches || !e.touches.length) return;
                draggingWindow = true;
                windowStartX = e.touches[0].clientX;
                windowStartY = e.touches[0].clientY;
                windowStartOffsetX = chatModalOffsetX;
                windowStartOffsetY = chatModalOffsetY;
                windowStartRect = modalContent.getBoundingClientRect();
                document.body.style.userSelect = 'none';
                document.body.style.cursor = 'move';
                window.addEventListener('touchmove', touchWindowMove, { passive: true });
                window.addEventListener('touchend', stopWindowDrag);
            }, { passive: true });
        }

        window.addEventListener('resize', () => {
            if (chatModalIsMaximized) {
                const fullSize = getChatModalMaxSize();
                setChatModalSize(modalContent, fullSize.width, fullSize.height);
                applyChatModalTransform(modalContent);
            }
            keepChatModalInViewport(modalContent);
        });
    }
}

function showInbox() {
    const t = document.getElementById('sidebarTitle');
    if (t) t.innerText = 'Messages';
    refreshInbox();
}

async function refreshInbox() {
    const listEl = document.getElementById('conversationList');
    try {
        const resp = await fetch('/chat/conversations');
        const res = await resp.json();
        if(res.status === 'success') {
            listEl.innerHTML = '';
            const previousTotalUnread = normalizeClientUnreadCount(totalUnreadCount);
            replaceUnreadState(res.data || [], res.totalUnread);
            const loadedTotalUnread = normalizeClientUnreadCount(res.totalUnread);
            if (!chatInitialUnreadSoundPlayed && loadedTotalUnread > 0 && previousTotalUnread === 0) {
                chatInitialUnreadSoundPlayed = true;
                playChatDing();
            }
            
            if(!res.data || res.data.length === 0) {
                 listEl.innerHTML = '<div class="text-center text-muted mt-5 small">No messages yet.</div>';
                 return;
            }

            res.data.forEach(c => {
                const isActive = (String(c.id) === String(currentConvId)) ? 'active' : '';
                const unreadNum = normalizeClientUnreadCount(c.unreadCount);
                const isUnreadClass = unreadNum > 0 ? 'unread' : '';
                const lastMsg = c.lastMessage ? String(c.lastMessage.content || '') : 'New Chat';
                
                let displayMsg = lastMsg.length > 25 ? lastMsg.substring(0,25)+'...' : lastMsg;
                if(c.lastMessage && String(c.lastMessage.senderId) === String(currentUser.id)) {
                    displayMsg = 'You: ' + displayMsg;
                }

                const badgeHtml = unreadNum > 0 ?
                    `<span class="unread-badge ms-2">${unreadNum}</span>` : '';

                const lastMessageTimestamp = c.lastMessage
                    ? (c.lastMessage.timestamp || c.lastMessage.sentAt || c.lastMessageAt)
                    : null;
                const timeStr = lastMessageTimestamp
                    ? new Date(lastMessageTimestamp).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'})
                    : '';
                
                // Safety check for display name
                const displayName = (c.display && c.display.name) ? c.display.name : 'Unknown';
                const targetId = (c.display && c.display.targetUserId) ? c.display.targetUserId : '';
                const avatarUrl = (c.display && c.display.avatar) ? String(c.display.avatar) : '';
                const canMessage = c.canMessage !== false && (!c.display || c.display.canMessage !== false);
                const scopeReason = c.scopeReason || (c.display && c.display.scopeReason) || '';
                const roleLabels = c.display && Array.isArray(c.display.roleLabels) ? c.display.roleLabels : [];
                const packageLabels = c.display && Array.isArray(c.display.packages) ? c.display.packages : [];
                const scopeLabel = roleLabels.length
                    ? roleLabels.join(', ')
                    : (packageLabels.length ? packageLabels.join(', ') : 'Member');
                const readOnlyBadge = canMessage
                    ? ''
                    : '<span class="badge bg-secondary-subtle text-secondary ms-1">Read-only</span>';
                const avatarHtml = buildAvatarHtml(displayName, avatarUrl, 40);

                const html = `
                <div class="chat-item d-flex align-items-center ${isActive} ${isUnreadClass}" data-conv-id="${safeAttr(c.id)}" onclick='openChat(${safeInlineJson(c.id)}, ${safeInlineJson(displayName)}, ${safeInlineJson(targetId)}, ${safeInlineJson(avatarUrl)}, ${canMessage ? 'true' : 'false'}, ${safeInlineJson(scopeReason)})'>
                    <div class="avatar-wrapper me-3">
                        ${avatarHtml}
                    </div>
                    
                    <div class="overflow-hidden flex-grow-1">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="chat-name small text-dark text-truncate">${safeText(displayName)}${readOnlyBadge}</span>
                            <span class="x-small text-muted">${timeStr}</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="chat-msg x-small text-muted text-truncate" style="max-width: 140px;" title="${safeAttr(scopeLabel)}">${safeText(displayMsg)}</div>
                            <span class="unread-badge-slot">${badgeHtml}</span>
                        </div>
                    </div>
                </div>`;
                listEl.insertAdjacentHTML('beforeend', html);
            });

        }
    } catch(e) { 
        console.error(e);
        listEl.innerHTML = '<div class="text-center text-muted mt-5 small">Failed to load.</div>';
    }
}

function startNewChatWizard(){
    if (!chatAccess.canCreate) {
        safeShowAlert('Your access profile does not allow starting new chats.', 'warning');
        return;
    }
    document.getElementById('sidebarTitle').innerText='New Chat';
    fetchUsers('');
}

async function fetchUsers(query) {
    if (!chatAccess.canCreate) return;
    const listEl = document.getElementById('conversationList');
    listEl.innerHTML = '<div class="text-center mt-4"><div class="spinner-border spinner-border-sm text-secondary"></div></div>';
    try {
        const resp = await fetch(`/chat/users/search?q=${encodeURIComponent(query)}`);
        const res = await resp.json();
        if (res.status === 'success') {
            listEl.innerHTML = '';
            if (res.data.length === 0) { listEl.innerHTML = '<div class="text-center text-muted mt-4 small">No users found.</div>'; return; }
            res.data.forEach(u => {
                const avatarHtml = buildAvatarHtml(u.name, u.avatar, 35, 'bg-primary-subtle', 'text-primary');
                const roleLabels = Array.isArray(u.roleLabels) && u.roleLabels.length
                    ? u.roleLabels
                    : ['Member'];
                const packages = Array.isArray(u.packages) ? u.packages : [];
                const packageText = packages.length ? `${packages.join(', ')} · ` : '';
                const detailText = `${u.org || 'General'} · ${packageText}${roleLabels.join(', ')}`;
                const html = `
                <div class="chat-item d-flex align-items-center p-2" onclick='createNewChat(${safeInlineJson(u.id)}, ${safeInlineJson(u.name)}, ${safeInlineJson(u.avatar || '')})'>
                    <div class="me-2 flex-shrink-0">${avatarHtml}</div>
                    <div class="flex-grow-1 overflow-hidden">
                        <div class="fw-bold small text-dark text-truncate">${safeText(u.name)}</div>
                        <div class="x-small text-muted text-truncate" title="${safeAttr(detailText)}">${safeText(detailText)}</div>
                    </div>
                </div>`;
                listEl.insertAdjacentHTML('beforeend', html);
            });
        } else {
            listEl.innerHTML = `<div class="text-center text-muted mt-4 small px-3">${safeText(res.message || 'Contacts are unavailable.')}</div>`;
        }
    } catch (e) { console.error(e); }
}

async function createNewChat(uid, name = '', avatarUrl = '') {
    if (!chatAccess.canCreate) {
        safeShowAlert('Your access profile does not allow starting new chats.', 'warning');
        return;
    }
    try {
        const resp = await fetch('/chat/start', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ targetUserId: uid })
        });
        const res = await resp.json();
        if (res.status !== 'success') {
            if (res.message) safeShowAlert(res.message, 'error');
            return;
        }

        const conversation = res.data || {};
        const display = conversation.display || {};
        await openChat(
            res.conversationId || conversation.id,
            display.name || name || 'Chat',
            display.targetUserId || uid,
            display.avatar || avatarUrl || '',
            conversation.canMessage !== false,
            conversation.scopeReason || ''
        );
    } catch (e) {
        console.error(e);
        safeShowAlert('Unable to start chat right now.', 'error');
    }
}

function handleSearch(v){if(document.getElementById('sidebarTitle').innerText==='New Chat')fetchUsers(v);}

function setConversationWriteState(canMessage, reason = '') {
    currentConversationCanMessage = Boolean(chatAccess.canUpdate && canMessage);
    currentConversationScopeReason = currentConversationCanMessage
        ? ''
        : (reason || (chatAccess.canUpdate
            ? 'This conversation is read-only.'
            : 'Your access profile does not allow sending chat messages.'));
    const form = document.getElementById('chatForm');
    const notice = document.getElementById('chatReadOnlyNotice');
    const input = document.getElementById('chatInput');
    const fileInput = document.getElementById('chatFileInput');
    const attachmentButton = document.getElementById('chatAttachmentButton');
    const sendButton = document.getElementById('chatSendButton');

    if (form) form.classList.toggle('d-none', !currentConversationCanMessage);
    if (notice) {
        notice.classList.toggle('d-none', currentConversationCanMessage);
        notice.textContent = currentConversationScopeReason;
    }
    if (input) input.disabled = !currentConversationCanMessage;
    if (fileInput) fileInput.disabled = !currentConversationCanMessage;
    if (attachmentButton) attachmentButton.disabled = !currentConversationCanMessage;
    if (sendButton) sendButton.disabled = !currentConversationCanMessage;
    if (!currentConversationCanMessage) {
        pendingAttachments = [];
        if (fileInput) fileInput.value = '';
        if (typeof renderPreviews === 'function') renderPreviews();
    }
}

async function openChat(convId, name, targetUserId, avatarUrl = '', canMessage = true, scopeReason = '') {
    currentConvId = convId;
    hasMoreOlderMessages = false;
    oldestLoadedMessageId = null;
    loadingOlderMessages = false;
    
    // Store these for the "Reopen" logic
    window.currentChatName = name; 
    window.currentChatTarget = targetUserId;
    window.currentChatAvatar = avatarUrl || '';
    window.currentChatCanMessage = canMessage !== false;
    window.currentChatScopeReason = scopeReason || '';
    setConversationWriteState(canMessage !== false, scopeReason);

    document.getElementById('chatEmptyState').classList.add('d-none');
    document.getElementById('chatActiveView').classList.remove('d-none');
    document.getElementById('chatHeaderName').innerText = name;
    const headerAvatar = document.getElementById('chatHeaderAvatar');
    if (avatarUrl) {
        headerAvatar.className = 'rounded-circle d-flex align-items-center justify-content-center me-2 fw-bold flex-shrink-0 overflow-hidden';
        headerAvatar.innerHTML = `<img src="${safeAttr(avatarUrl)}" alt="${safeText(name)}" style="width:100%;height:100%;object-fit:cover;" onerror="this.remove();">`;
    } else {
        headerAvatar.className = 'rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center me-2 fw-bold flex-shrink-0';
        headerAvatar.innerText = name.charAt(0).toUpperCase();
    }

    const container = document.getElementById('chatMessageContainer');
    container.innerHTML = '<div class="text-center py-5"><div class="spinner-border spinner-border-sm text-primary"></div></div>';
    
    try {
        await ensureChatSocket();
        const resp = await fetch(`/chat/messages/${encodeURIComponent(convId)}?limit=${CHAT_MESSAGE_PAGE_SIZE}`);
        const res = await resp.json();
        
        container.innerHTML = '';
        if(res.status === 'success') {
            const currentAccess = res.access || {};
            setConversationWriteState(currentAccess.canMessage !== false, currentAccess.reason || '');
            window.currentChatCanMessage = currentAccess.canMessage !== false;
            window.currentChatScopeReason = currentAccess.reason || '';
            res.data.forEach(msg => appendMessage(msg, false, false));
            hasMoreOlderMessages = Boolean(res.pagination?.hasMore);
            oldestLoadedMessageId = res.pagination?.oldestId || res.data[0]?.id || null;
            updateLoadOlderIndicator();
            const lastIncomingMessage = [...res.data].reverse().find((message) => (
                String(message?.senderId) !== String(currentUser.id)
            ));
            if (lastIncomingMessage?.id) {
                latestIncomingMessageByConversation.set(String(convId), lastIncomingMessage.id);
            }
            markConversationReadLocally(convId);
            scrollToBottom();
        } else {
            setConversationWriteState(false, res.message || 'This conversation is unavailable.');
            container.innerHTML = `<div class="text-danger text-center p-4">${safeText(res.message || 'Error loading history.')}</div>`;
        }
        if (res.status === 'success' && socket && socket.connected) {
            socket.emit('join_room', convId);
            socket.emit('mark_conversation_read', {
                convId,
                messageId: latestIncomingMessageByConversation.get(String(convId)) || null
            });
        }
        
        refreshInbox();
        
    } catch(e) { 
        container.innerHTML = '<div class="text-danger text-center p-4">Error loading history.</div>';
    }
}
