<%
  const printModalUser = (typeof user !== 'undefined' && user) ? user : {};
  const printModalActiveOrgId = String(printModalUser.activeOrgId || printModalUser.primaryOrgId || '').trim();
  const printModalActiveOrg = Array.isArray(printModalUser.allowedOrgs)
    ? printModalUser.allowedOrgs.find((o) => String(o?.orgId || '') === printModalActiveOrgId)
    : null;
  const printModalActiveOrgName = String(
    printModalActiveOrg?.name ||
    printModalActiveOrg?.orgName ||
    printModalActiveOrg?.organizationName ||
    printModalUser.activeOrgName ||
    ''
  ).trim();
  const printModalActiveOrgRoles = Array.isArray(printModalActiveOrg?.roles) && printModalActiveOrg.roles.length
    ? printModalActiveOrg.roles
    : (printModalActiveOrg?.role ? [printModalActiveOrg.role] : []);
  const printModalHasAdminOrgRole = printModalActiveOrgRoles
    .map((r) => String(r || '').trim().toLowerCase())
    .some((r) => ['admin', 'owner', 'superadmin', 'super_admin', 'system_admin'].includes(r));
  const printModalAdminCtx = typeof adminContext !== 'undefined' && adminContext ? adminContext : {};
  const printModalIsAdmin = Boolean(printModalAdminCtx.isRequestAdmin || printModalAdminCtx.isSystemAdmin || printModalAdminCtx.isSuperAdmin || printModalHasAdminOrgRole);
  const printModalRequestingUserName = String(
    printModalUser.identity?.displayName ||
    (printModalUser.name && typeof printModalUser.name === 'object' ? `${printModalUser.name.first || ''} ${printModalUser.name.last || ''}` : '') ||
    printModalUser.name ||
    printModalUser.username ||
    printModalUser.email ||
    printModalUser.id ||
    ''
  ).trim();
  const printModalBrand = (typeof appBrand !== 'undefined' && appBrand && typeof appBrand === 'object') ? appBrand : {};
  const printModalLogoUrl = printModalBrand.logoUrl || '/uploads/GLOBAL/logo/Logo1.png';
%>
<span id="printModalActiveOrgNameRef" data-name="<%= printModalActiveOrgName %>" hidden></span>
<span id="printModalAdminRef" data-is-admin="<%= printModalIsAdmin ? 'true' : 'false' %>" hidden></span>
<span id="printModalRequestingUserNameRef" data-name="<%= printModalRequestingUserName %>" hidden></span>
<span id="printModalBrandLogoRef" data-url="<%= printModalLogoUrl %>" hidden></span>
<div class="modal fade" id="printSettingsModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-printer me-2"></i>Print Settings</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="form-check form-switch mb-3">
          <input class="form-check-input" type="checkbox" role="switch" id="printSettingIncludeOrg" checked <%= printModalIsAdmin ? '' : 'disabled' %>>
          <label class="form-check-label fw-bold" for="printSettingIncludeOrg">Show Organization</label>
        </div>
        <div class="mb-3">
          <label class="form-label fw-bold">Organization Name</label>
          <input type="text" class="form-control" id="printSettingOrgName" placeholder="Organization name" <%= printModalIsAdmin ? '' : 'readonly' %>>
        </div>

        <div class="form-check form-switch mb-2">
          <input class="form-check-input" type="checkbox" role="switch" id="printSettingIncludeHeaderNote" <%= printModalIsAdmin ? '' : 'disabled' %>>
          <label class="form-check-label fw-bold" for="printSettingIncludeHeaderNote">Add Custom Text</label>
        </div>
        <div class="mb-3">
          <label class="form-label fw-bold">Custom Text (Optional)</label>
          <textarea class="form-control" id="printSettingHeaderNote" rows="3" placeholder="Add any extra note to show on the print header..."></textarea>
          <div class="form-text small">This is saved in your browser for the next print.</div>
          <div class="form-text small">If you still see browser header/footer items, disable "Headers and footers" in the print dialog.</div>
        </div>

        <div class="row g-2">
          <div class="col-6">
            <label class="form-label fw-bold">Orientation</label>
            <select class="form-select" id="printSettingOrientation">
              <option value="landscape">Landscape</option>
              <option value="portrait">Portrait</option>
            </select>
            <div class="form-text small">You can also change orientation in the print preview before printing.</div>
          </div>
          <div class="col-6">
            <label class="form-label fw-bold">Density</label>
            <select class="form-select" id="printSettingDensity">
              <option value="compact">Compact</option>
              <option value="normal">Normal</option>
            </select>
          </div>
        </div>
        <div class="form-text small mt-2">Use the browser print dialog <strong>Scale (%)</strong> to fit wide tables. Disable Headers and footers for a cleaner page.</div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="printSettingsApplyBtn"><i class="bi bi-printer me-1"></i>Print</button>
      </div>
    </div>
  </div>
</div>
