        }
        let aboutAppUptimeLabel = '';
        const aboutStartedRaw = (typeof buildVersionStartedAt !== 'undefined' && buildVersionStartedAt)
          ? String(buildVersionStartedAt).trim()
          : '';
        const aboutStartedLabelRaw = (typeof buildVersionStartedAtLabel !== 'undefined' && buildVersionStartedAtLabel)
          ? String(buildVersionStartedAtLabel).trim()
          : '';
        const aboutStartedMs = Date.parse(aboutStartedRaw || aboutStartedLabelRaw);
        if (!Number.isNaN(aboutStartedMs)) {
          const uptimeMs = Math.max(0, Date.now() - aboutStartedMs);
          const uptimeMinutes = Math.floor(uptimeMs / 60000);
          const uptimeHours = Math.floor(uptimeMinutes / 60);
          const uptimeDays = Math.floor(uptimeHours / 24);
          if (uptimeDays > 0) {
            aboutAppUptimeLabel = `${uptimeDays} day${uptimeDays === 1 ? '' : 's'}, ${uptimeHours % 24} hr`;
          } else if (uptimeHours > 0) {
            aboutAppUptimeLabel = `${uptimeHours} hr, ${uptimeMinutes % 60} min`;
          } else {
