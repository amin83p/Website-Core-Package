          aboutAppBackendMode ? `Backend: ${aboutAppBackendMode}${aboutAppBackendRecovery ? ' (recovery)' : ''}` : '',
          (typeof buildVersionCommitAtLabel !== 'undefined' && buildVersionCommitAtLabel)
            ? `Committed: ${buildVersionCommitAtLabel}`
            : '',
          (typeof buildVersionStartedAtLabel !== 'undefined' && buildVersionStartedAtLabel)
            ? `Running since: ${buildVersionStartedAtLabel}`
            : '',
          aboutRequestId ? `Request: ${aboutRequestId}` : ''
        ].filter(Boolean).join(' | ');
      %>
      <div class="modal fade" id="aboutAppModal" tabindex="-1" aria-labelledby="aboutAppModalLabel" aria-hidden="true">
