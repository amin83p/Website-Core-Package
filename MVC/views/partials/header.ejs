        const aboutAppBackendMode = aboutAppBackendStatus ? String(aboutAppBackendStatus.mode || '').trim() : '';
        const aboutAppBackendRecovery = Boolean(aboutAppBackendStatus?.fallback?.active);
        const aboutAppEnvironment = String(
          (typeof appEnvironment !== 'undefined' && appEnvironment) ? appEnvironment : 'development'
        ).trim();
        const aboutAppName = String(headerBrand.appName || 'Website Core').trim();
        const aboutAppShortName = String(headerBrand.appShortName || headerBrand.ownerDisplayName || 'Platform').trim();
        const aboutAppSummaryTagline = String(headerTagline || headerBrand.tagline || 'Learn, work, and thrive in new places.').trim();
        const aboutAppPlatformSummary = 'This workspace unifies day-to-day school work in one signed-in place: run classes and academic records, coordinate schedules and notifications, and communicate through organization-scoped chat. Permissions follow your active organization, and the system is built for clarity, traceability, and dependable use when real teams depend on it every day.';
        const aboutAppNodeVersion = typeof process !== 'undefined' && process.version ? process.version : '';
        const aboutAppPlatform = typeof process !== 'undefined' && process.platform ? process.platform : '';
        const aboutBuildSourceRaw = (typeof buildVersionSource !== 'undefined' && buildVersionSource)
          ? String(buildVersionSource).trim()
          : '';
        const aboutBuildSourceLabel = (() => {
          if (!aboutBuildSourceRaw) return 'Unknown';
          if (aboutBuildSourceRaw.includes('buildVersionOverride')) return 'Configured release label';
          if (aboutBuildSourceRaw.startsWith('repo:')) return 'Repository build metadata';
          if (aboutBuildSourceRaw.startsWith('env:')) return 'Deployment environment';
          if (aboutBuildSourceRaw === 'git') return 'Git commit (local)';
          return aboutBuildSourceRaw;
        })();
        const aboutCommitSourceRaw = (typeof buildVersionCommitAtSource !== 'undefined' && buildVersionCommitAtSource)
          ? String(buildVersionCommitAtSource).trim()
          : '';
        const aboutRequestId = (typeof requestId !== 'undefined' && requestId) ? String(requestId).trim() : '';
        let aboutAppActiveOrgLabel = '';
        if (typeof user !== 'undefined' && user) {
          const aboutOrgs = Array.isArray(user.allowedOrgs) ? user.allowedOrgs : [];
          const aboutActiveOrg = aboutOrgs.find((org) => String(org?.orgId || '') === String(user.activeOrgId || ''));
          if (aboutActiveOrg) {
            aboutAppActiveOrgLabel = String(
              aboutActiveOrg.name || aboutActiveOrg.orgName || aboutActiveOrg.organizationName || ''
            ).trim();
          } else if (user.activeOrgId) {
            aboutAppActiveOrgLabel = `Organization ${user.activeOrgId}`;
          } else {
            aboutAppActiveOrgLabel = 'System / Global';
