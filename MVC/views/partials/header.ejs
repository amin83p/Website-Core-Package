    <% if (canUseScheduledTaskManager) { %>
    <script>
      (function () {
        const trigger = document.getElementById('scheduledTaskManagerHeaderTrigger');
        if (!trigger) return;
        let loaderPromise = null;
        function loadManagerLoader() {
          if (window.ScheduledTaskManagerLoader) return Promise.resolve();
          if (loaderPromise) return loaderPromise;
          loaderPromise = new Promise((resolve, reject) => {
            const script = document.createElement('script');
            script.src = '<%= typeof staticAssetUrl === "function" ? staticAssetUrl("/scripts/scheduledTaskManagerLoader.js") : "/scripts/scheduledTaskManagerLoader.js" %>';
            script.async = true;
            script.onload = () => resolve();
            script.onerror = () => reject(new Error('Failed to load scheduled task manager.'));
            document.body.appendChild(script);
          });
          return loaderPromise;
        }
        trigger.addEventListener('click', function (event) {
          event.preventDefault();
          loadManagerLoader()
            .then(() => window.ScheduledTaskManagerLoader?.open())
            .catch((error) => console.error('[ScheduledTaskManager]', error));
        });
      })();
    </script>
    <% } %>
