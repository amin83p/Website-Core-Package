<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
  <div class="d-flex align-items-center gap-3 min-w-0 flex-wrap">
    <h1 class="page-heading size-md m-0">
      <%= (isEditMode ? 'Edit ' : 'Create ') + name %>
    </h1>
    <% if (isEditMode) { %>
      <span class="badge bg-primary border">Editing: <%= id %></span>
    <% } else { %>
      <span class="badge bg-success border"><%= name %> Reg.</span>
    <% } %>
  </div>
  <% if (typeof headerActions !== 'undefined' && headerActions) { %>
    <div class="d-flex flex-wrap align-items-center gap-2 ms-auto">
      <%- headerActions %>
    </div>
  <% } %>
</div>
