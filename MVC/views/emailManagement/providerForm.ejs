<%
  const isEdit = Boolean(profile && profile.id);
  const row = profile || {};
  const verifiedDomainsText = Array.isArray(row.verifiedDomains)
    ? row.verifiedDomains.join('\n')
    : String(row.verifiedDomains || '');
%>

<div class="sections-page">
  <div class="d-flex align-items-center justify-content-between mb-4">
    <div class="d-flex align-items-center gap-2 flex-wrap">
      <h1 class="page-heading size-md m-0">
        <i class="bi bi-key me-2"></i><%= isEdit ? 'Edit Provider Profile' : 'Create Provider Profile' %>
      </h1>
      <% if (isEdit) { %>
        <span class="badge bg-primary border font-monospace">ID: <%= row.id %></span>
      <% } else { %>
        <span class="badge bg-success border">New Profile</span>
      <% } %>
    </div>
    <div class="d-flex gap-2">
      <a href="/email-management/providers" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to List
      </a>
    </div>
  </div>

  <div class="form-container wide" style="max-width: 1400px;">
    <form id="emailProviderProfileForm" action="<%= isEdit ? ('/email-management/providers/' + row.id) : '/email-management/providers/new' %>" method="POST">
      <input type="hidden" name="actionStateId" value="<%= actionStateId || '' %>">

      <div class="row g-3">
        <div class="col-lg-7">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom">
              <h6 class="fw-bold m-0 text-primary"><i class="bi bi-key me-2"></i>Provider Credentials</h6>
              <div class="small text-muted mt-1">Store Resend API credentials and sender defaults for this organization.</div>
            </div>
            <div class="card-body p-4">
              <div class="row g-3">
                <div class="col-md-8">
                  <label class="form-label fw-bold" for="providerLabel">Label <span class="text-danger">*</span></label>
                  <input type="text" id="providerLabel" class="form-control size-md" name="label" value="<%= row.label || '' %>" placeholder="e.g. Production Resend" required>
                  <div class="form-text small">Unique name within this organization.</div>
                </div>
                <div class="col-md-4">
                  <label class="form-label fw-bold" for="providerType">Provider</label>
                  <select id="providerType" class="form-select size-md" name="provider">
                    <option value="resend" <%= String(row.provider || 'resend').toLowerCase() === 'resend' ? 'selected' : '' %>>Resend</option>
                  </select>
                </div>
                <div class="col-md-12">
                  <label class="form-label fw-bold" for="providerDefaultFrom">Default From Email</label>
                  <input type="email" id="providerDefaultFrom" class="form-control size-md font-monospace" name="defaultFromEmail" value="<%= row.defaultFromEmail || '' %>" placeholder="noreply@yourdomain.com">
                  <div class="form-text small">Used when templates do not override the sender address.</div>
                </div>
                <div class="col-md-12">
                  <label class="form-label fw-bold" for="providerVerifiedDomains">Verified Domains Allowlist</label>
                  <textarea id="providerVerifiedDomains" class="form-control size-md font-monospace" name="verifiedDomains" rows="5" placeholder="example.com&#10;school.org"><%= verifiedDomainsText %></textarea>
                  <div class="form-text small">One domain per line or comma-separated. Sender addresses must use one of these domains.</div>
                </div>
                <div class="col-md-12">
                  <label class="form-label fw-bold" for="providerApiKey">API Key<% if (!isEdit) { %> <span class="text-danger">*</span><% } %></label>
                  <input type="password" id="providerApiKey" class="form-control size-md font-monospace" name="apiKey" value="" autocomplete="new-password" <%= isEdit ? '' : 'required' %>>
                  <% if (isEdit) { %>
                    <div class="form-text small">Current key: <code><%= row.apiKeyMasked || 'Not set' %></code>. Leave blank to keep the existing key.</div>
                  <% } else { %>
                    <div class="form-text small">Stored encrypted. Only the last four characters are shown after save.</div>
                  <% } %>
                </div>
                <div class="col-md-6">
                  <div class="border rounded p-3 h-100 bg-light-subtle">
                    <div class="d-flex justify-content-between gap-3 align-items-start">
                      <div>
                        <label class="fw-semibold mb-1" for="providerIsActive">Active</label>
                        <div class="small text-muted">Inactive profiles cannot be selected for new template routing.</div>
                      </div>
                      <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" name="isActive" value="true" id="providerIsActive" <%= row.isActive !== false ? 'checked' : '' %>>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="col-md-6">
                  <div class="border rounded p-3 h-100 bg-light-subtle">
                    <div class="d-flex justify-content-between gap-3 align-items-start">
                      <div>
                        <label class="fw-semibold mb-1" for="providerIsDefault">Default for organization</label>
                        <div class="small text-muted">Used when templates do not specify a provider profile.</div>
                      </div>
                      <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" name="isDefault" value="true" id="providerIsDefault" <%= row.isDefault === true ? 'checked' : '' %>>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-5">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom">
              <h6 class="fw-bold m-0 text-primary"><i class="bi bi-info-circle me-2"></i>Setup Guide</h6>
            </div>
            <div class="card-body p-4 d-flex flex-column gap-3">
              <div>
                <div class="small text-muted mb-1">Routing behavior</div>
                <div class="small">Templates can optionally reference a provider profile. If none is selected, dispatch uses the org default profile, then platform env fallback.</div>
              </div>
              <div>
                <div class="small text-muted mb-1">Domain validation</div>
                <div class="small">Before send, the sender address domain must appear in the verified domains allowlist for the resolved profile.</div>
              </div>
              <div>
                <div class="small text-muted mb-1">API key security</div>
                <div class="small">Keys are encrypted at rest. Editing a profile does not reveal the full key; enter a new key only when rotating credentials.</div>
              </div>
              <% if (isEdit && row.orgId) { %>
                <div>
                  <div class="small text-muted mb-1">Organization</div>
                  <div class="font-monospace small"><%= row.orgId %></div>
                </div>
              <% } %>
              <div class="alert alert-light border small mb-0">
                <i class="bi bi-shield-lock me-1"></i>
                Only organization admins with Email Provider access can view or edit these credentials.
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="button-row mt-4 pt-3 border-top">
        <button type="submit" class="btn btn-filled btn-primary btn-md" id="emailProviderSaveBtn">
          <i class="bi bi-save me-1"></i> <%= isEdit ? 'Save Changes' : 'Create Profile' %>
        </button>
        <a href="/email-management/providers" class="btn btn-filled btn-secondary btn-md" id="emailProviderCancelBtn">Cancel</a>
      </div>
    </form>
  </div>
</div>

<script>
  (function () {
    async function showModalMessage(config = {}) {
      if (typeof showMessageModal === 'function') {
        return showMessageModal(config);
      }
      console.error('showMessageModal is unavailable.', config);
      return null;
    }

    const form = document.getElementById('emailProviderProfileForm');
    const saveBtn = document.getElementById('emailProviderSaveBtn');
    const cancelBtn = document.getElementById('emailProviderCancelBtn');
    let submitting = false;

    function setBusy(button, label) {
      if (!button) return;
      if (!button.dataset.defaultHtml) button.dataset.defaultHtml = button.innerHTML;
      button.disabled = true;
      button.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>' + label;
    }

    function restore(button) {
      if (!button) return;
      button.disabled = false;
      if (button.dataset.defaultHtml) button.innerHTML = button.dataset.defaultHtml;
    }

    if (!form) return;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submitting) return;
      submitting = true;

      try {
        setBusy(saveBtn, 'Saving...');
        if (cancelBtn) {
          cancelBtn.classList.add('disabled');
          cancelBtn.style.pointerEvents = 'none';
          cancelBtn.setAttribute('aria-disabled', 'true');
        }

        const formData = new FormData(form);
        formData.set('isActive', document.getElementById('providerIsActive')?.checked ? 'true' : 'false');
        formData.set('isDefault', document.getElementById('providerIsDefault')?.checked ? 'true' : 'false');
        const payload = new URLSearchParams();
        for (const [key, value] of formData.entries()) payload.append(key, value);

        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8', 'x-ajax-request': 'true' },
          body: payload.toString()
        });

        let result = null;
        try {
          result = await response.json();
        } catch (_) {
          result = { status: 'error', message: 'Unexpected response while saving provider profile.' };
        }
        if (!response.ok || result.status !== 'success') {
          throw new Error(result.message || 'Failed to save provider profile.');
        }

        await showModalMessage({
          title: 'Saved',
          icon: 'success',
          message: result.message || 'Provider profile saved successfully.',
          buttons: [{ text: 'OK', class: 'btn-primary' }]
        });
        window.location.href = '/email-management/providers';
      } catch (error) {
        await showModalMessage({
          title: 'Save Failed',
          icon: 'error',
          message: error?.message || 'Unable to save provider profile.',
          buttons: [{ text: 'OK', class: 'btn-primary' }]
        });
        submitting = false;
        restore(saveBtn);
        if (cancelBtn) {
          cancelBtn.classList.remove('disabled');
          cancelBtn.style.pointerEvents = '';
          cancelBtn.removeAttribute('aria-disabled');
        }
      }
    });
  })();
</script>
