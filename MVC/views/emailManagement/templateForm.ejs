<%
  const isEdit = Boolean(template && template.id);
  const row = template || {};
  const safeEventCatalog = Array.isArray(eventCatalog) ? eventCatalog : [];
  const selectedEventKey = String(row.eventKey || '').toUpperCase();
  const selectedSection = String(row.sectionId || '').toUpperCase();
  const selectedOperation = String(row.operationId || '').toUpperCase();
  const selectedPackageName = String(row.packageName || 'CORE').toUpperCase();
  const selectedTemplateKind = String(row.templateKind || '').toLowerCase() === 'general' ? 'general' : 'event';
  const selectedProviderProfileId = String(row.providerProfileId || '').trim();
  const selectedTemplateName = String(row.templateName || '').trim();
  const mediaDefaultFolder = String((typeof locals.mediaDefaultFolder !== 'undefined' && locals.mediaDefaultFolder) ? locals.mediaDefaultFolder : 'email-templates').trim() || 'email-templates';
  const systemMode = Boolean(typeof isSystemMode !== 'undefined' && isSystemMode);
  const initialEventKeyFromQuery = String((typeof locals.queryEventKey !== 'undefined' && locals.queryEventKey) ? locals.queryEventKey : '').trim().toUpperCase();
  const safeEventAssignments = (eventAssignments && typeof eventAssignments === 'object') ? eventAssignments : {};
  const currentTemplateId = String((typeof locals.currentTemplateId !== 'undefined' && locals.currentTemplateId) ? locals.currentTemplateId : '').trim();
  const safeProviderOptions = Array.isArray(providerOptions) ? providerOptions : [];
  const providerOptionsSourceToken = String((typeof locals.providerOptionsSource !== 'undefined' && locals.providerOptionsSource) ? locals.providerOptionsSource : 'org').toLowerCase();
%>

<div class="sections-page">
  <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <h1 class="page-heading size-md m-0"><%= isEdit ? 'Edit Email Template' : 'Create Email Template' %></h1>
    <div class="d-flex align-items-center gap-2 flex-wrap">
      <a href="/email-management/routing" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-signpost-split me-1"></i> Event Routing
      </a>
      <% if (isEdit) { %>
        <span class="badge bg-primary border font-monospace">ID: <%= row.id %></span>
      <% } else { %>
        <span class="badge bg-success border">New Template</span>
      <% } %>
    </div>
  </div>

  <% if (systemMode) { %>
    <div class="alert alert-info border mb-3">
      <i class="bi bi-globe2 me-2"></i>
      <strong>Platform default mode.</strong>
      One active template per event at the SYSTEM level. Organizations without their own override inherit this route at send time.
      <div class="small mt-2 mb-0">
        <strong>Resolution order:</strong> org template → SYSTEM template → code fallback.
        For one-off sends without a second stored route, callers may pass <code>templateId</code> to <code>sendByEvent()</code>.
      </div>
    </div>
  <% } else { %>
    <div class="alert alert-light border mb-3">
      <i class="bi bi-building me-2 text-primary"></i>
      <strong>Organization override.</strong>
      One template per event in your organization. If none exists, the SYSTEM platform default is used at send time.
      <div class="small mt-2 mb-0">
        <strong>Resolution order:</strong> org template → SYSTEM template → code fallback.
        For one-off sends without a second stored route, callers may pass <code>templateId</code> to <code>sendByEvent()</code>.
      </div>
    </div>
  <% } %>

  <div class="form-container" style="width:100%;max-width:1400px;">
    <form id="emailManagementTemplateForm" action="<%= isEdit ? ('/email-management/templates/' + row.id) : '/email-management/templates/new' %>" method="POST">
      <input type="hidden" name="actionStateId" value="<%= actionStateId || '' %>">

      <div class="d-flex justify-content-end mb-2">
        <button
          type="button"
          class="btn btn-outline-secondary btn-sm"
          id="emailTemplateShowGuideBtn"
        >
          <i class="bi bi-braces me-1"></i> Show Placeholder Guide
        </button>
      </div>

      <div class="row g-3" id="emailTemplateFormRow">
        <div class="col-lg-12" id="emailTemplateMainColumn">
          <div class="card border-0 shadow-sm">
            <div class="card-header bg-light fw-bold text-primary">
              <i class="bi bi-envelope-paper me-2"></i>Template Definition
            </div>
            <div class="card-body">
              <div class="row g-3">
                <div class="col-md-12">
                  <label class="form-label fw-bold small text-muted text-uppercase">Template Type</label>
                  <div class="d-flex flex-wrap gap-3">
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="templateKind" id="emailTemplateKindEvent" value="event" <%= selectedTemplateKind === 'event' ? 'checked' : '' %> <%= isEdit ? 'disabled' : '' %>>
                      <label class="form-check-label" for="emailTemplateKindEvent">Event-bound (automatic routing)</label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="templateKind" id="emailTemplateKindGeneral" value="general" <%= selectedTemplateKind === 'general' ? 'checked' : '' %> <%= isEdit ? 'disabled' : '' %>>
                      <label class="form-check-label" for="emailTemplateKindGeneral">General (manual selection)</label>
                    </div>
                  </div>
                  <% if (isEdit) { %>
                    <input type="hidden" name="templateKind" value="<%= selectedTemplateKind %>">
                  <% } %>
                  <div id="emailTemplateGeneralHelp" class="alert alert-light border small py-2 px-3 mt-2 <%= selectedTemplateKind === 'general' ? '' : 'd-none' %>">
                    General templates are picked manually by other sections (for example School Settings). Use <code>{{BODY_CONTENT}}</code> where the section-composed message should appear. Any other placeholder names are supplied at send time by the section using this template; core does not define package-specific tokens.
                  </div>
                </div>
              </div>

              <div class="row g-3 mt-1<%= selectedTemplateKind === 'general' ? ' d-none' : '' %>" id="emailTemplateEventSection">
                <div class="col-md-12">
                  <label class="form-label fw-bold small text-muted text-uppercase">Email Event <span class="text-danger email-template-event-required">*</span></label>
                  <div class="input-group">
                    <input
                      type="text"
                      class="form-control"
                      id="emailTemplateEventDisplay"
                      placeholder="Pick a supported email event"
                      value=""
                      readonly
                    >
                    <button class="btn btn-outline-primary" type="button" id="emailTemplatePickEventBtn">
                      <i class="bi bi-search me-1"></i> Pick
                    </button>
                  </div>
                  <input type="hidden" name="eventKey" id="emailTemplateEventKeyHidden" value="<%= selectedEventKey %>" <%= selectedTemplateKind === 'event' ? 'required' : '' %>>
                  <input type="hidden" name="packageName" id="emailTemplatePackageNameHidden" value="<%= selectedPackageName %>">
                  <input type="hidden" name="sectionId" id="emailTemplateSectionIdHidden" value="<%= selectedSection %>">
                  <input type="hidden" name="operationId" id="emailTemplateOperationIdHidden" value="<%= selectedOperation %>">
                  <div id="emailTemplateEventAssignmentWarning" class="alert alert-warning border small py-2 px-3 mt-2 d-none" role="alert"></div>
                </div>
                <div class="col-md-12">
                  <div class="small text-muted mb-1">Mapped Backend Route (read-only metadata)</div>
                  <div id="emailTemplateMappedRoute" class="font-monospace small">-</div>
                </div>
              </div>

              <div class="row g-3 mt-1 <%= selectedTemplateKind === 'general' ? '' : 'd-none' %>" id="emailTemplateGeneralSection">
                <div class="col-md-12">
                  <label class="form-label fw-bold small text-muted text-uppercase" for="emailTemplateNameInput">Template Name <span class="text-danger">*</span></label>
                  <input
                    type="text"
                    class="form-control"
                    id="emailTemplateNameInput"
                    name="templateName"
                    value="<%= selectedTemplateName %>"
                    placeholder="e.g. School session notification wrapper"
                    maxlength="180"
                    <%= selectedTemplateKind === 'general' ? 'required' : '' %>
                  >
                  <div class="form-text">Shown in template lists and pickers when other sections choose this general template manually.</div>
                </div>
              </div>

              <div class="row g-3 mt-1" id="emailTemplateProviderSection">
                <div class="col-md-12">
                  <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                    <label class="form-label fw-bold small text-muted text-uppercase mb-0" for="emailTemplateProviderSelect">Provider Profile (optional)</label>
                    <button
                      type="button"
                      class="btn btn-link p-0 text-info lh-1"
                      id="emailProviderProfileHelpBtn"
                      data-bs-toggle="modal"
                      data-bs-target="#emailProviderProfileHelpModal"
                      aria-label="Provider profile help"
                      title="Provider profile help"
                    >
                      <i class="bi bi-info-circle"></i>
                    </button>
                    <% if (providerOptionsSourceToken === 'system') { %>
                      <span class="badge bg-info-subtle text-info border">Using SYSTEM provider defaults</span>
                    <% } %>
                  </div>
                  <select class="form-select" id="emailTemplateProviderSelect" name="providerProfileId">
                    <option value="">Platform default (env)</option>
                    <% safeProviderOptions.forEach((profile) => { %>
                      <option
                        value="<%= profile.id %>"
                        <%= String(profile.id || '') === selectedProviderProfileId ? 'selected' : '' %>
                      ><%= profile.label || profile.id %><%= profile.isDefault ? ' (default)' : '' %></option>
                    <% }) %>
                  </select>
                  <div class="form-text" id="emailTemplateProviderEmptyHelp">
                    <% if (!safeProviderOptions.length) { %>
                      No provider profiles found for your organization or SYSTEM defaults.
                      <a href="/email-management/providers">Manage provider profiles</a>.
                    <% } else { %>
                      Select a provider profile to choose a verified sender domain below. Leave empty to use org/platform fallback.
                    <% } %>
                  </div>
                  <div id="emailTemplateProviderDomainWarning" class="alert alert-warning border small py-2 px-3 mt-2 d-none" role="alert"></div>
                </div>
              </div>

              <div class="mt-3">
                <label class="form-label fw-bold small text-muted text-uppercase">Sender Template <span class="text-danger">*</span></label>
                <div class="row g-2 align-items-end">
                  <div class="col-md-5">
                    <label class="form-label small text-muted mb-1" for="emailTemplateSenderLocalPart">Local part</label>
                    <input
                      type="text"
                      class="form-control font-monospace"
                      id="emailTemplateSenderLocalPart"
                      placeholder="noreply or info@domain.com"
                      value=""
                    >
                  </div>
                  <div class="col-md-1 text-center pb-2 d-none d-md-block">
                    <span class="text-muted fw-bold">@</span>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label small text-muted mb-1" for="emailTemplateSenderDomainSelect">Verified domain</label>
                    <select class="form-select font-monospace" id="emailTemplateSenderDomainSelect" disabled>
                      <option value="">Select provider first</option>
                    </select>
                  </div>
                </div>
                <input
                  type="hidden"
                  name="senderTemplate"
                  id="emailTemplateSenderTemplateHidden"
                  value="<%= row.senderTemplate || '' %>"
                >
                <div class="form-text">Pick a provider profile, then choose one of its verified domains. The composed address is saved as the sender template.</div>
              </div>

              <div class="mt-3">
                <label class="form-label fw-bold small text-muted text-uppercase">Recipient Template <span class="text-danger">*</span></label>
                <input
                  type="text"
                  class="form-control font-monospace"
                  name="recipientTemplate"
                  value="<%= row.recipientTemplate || '' %>"
                  placeholder="{{USER_EMAIL}} or admin@domain.com"
                  required
                >
                <div class="form-text">Use comma/semicolon for multiple recipients.</div>
              </div>

              <div class="mt-3">
                <label class="form-label fw-bold small text-muted text-uppercase">Subject Template <span class="text-danger">*</span></label>
                <input
                  type="text"
                  class="form-control"
                  name="subjectTemplate"
                  value="<%= row.subjectTemplate || '' %>"
                  placeholder="Password reset code"
                  required
                >
              </div>

              <div class="mt-3">
                <label class="form-label fw-bold small text-muted text-uppercase">Body Template <span class="text-danger">*</span></label>
                <textarea
                  class="form-control font-monospace"
                  id="emailBodyTemplateField"
                  name="bodyTemplate"
                  rows="12"
                  placeholder="Your password reset code is {{RESET_CODE}}."
                  required
                  data-html-template-title="Body Template Editor"
                ><%= row.bodyTemplate || '' %></textarea>
                <div class="d-flex justify-content-between align-items-center mt-2 flex-wrap gap-2">
                  <div class="d-flex gap-2 flex-wrap">
                    <button
                      type="button"
                      class="btn btn-outline-secondary btn-sm"
                      id="emailInsertPlaceholderBtn"
                    >
                      <i class="bi bi-braces me-1"></i>Insert Placeholder
                    </button>
                    <button
                      type="button"
                      class="btn btn-outline-primary btn-sm"
                      id="emailOpenBodyTemplateEditorBtn"
                    >
                      <i class="bi bi-code-square me-1"></i>Open Rich Editor
                    </button>
                  </div>
                  <span class="small text-muted">Use placeholders like <code>{{BODY_CONTENT}}</code> for runtime body injection.</span>
                </div>
              </div>

              <div class="mt-3 form-check form-switch">
                <input class="form-check-input" type="checkbox" id="emailTemplateActiveSwitch" name="isActive" <%= row.isActive === false ? '' : 'checked' %>>
                <label class="form-check-label fw-bold small" for="emailTemplateActiveSwitch">Active template</label>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-5 d-none" id="emailTemplateGuideColumn">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-light fw-bold text-primary d-flex align-items-center justify-content-between py-2 px-3">
              <div><i class="bi bi-braces me-2"></i>Placeholder Guide</div>
              <button
                type="button"
                class="btn btn-outline-secondary btn-sm px-2"
                id="emailTemplatePlaceholderGuideCloseBtn"
                aria-label="Hide placeholder guide"
              >
                <i class="bi bi-chevron-up"></i>
              </button>
            </div>
            <div class="card-body d-flex flex-column gap-3" id="emailTemplatePlaceholderGuideBody">
              <div>
                <div class="small text-muted mb-1">Selected Template Key</div>
                <div class="font-monospace small" id="emailTemplateSelectedKey">-</div>
              </div>
              <div>
                <div class="small text-muted mb-1">Template Label</div>
                <div class="fw-semibold" id="emailTemplateDefinitionLabel">No strict placeholder registry for this selection.</div>
              </div>
              <div>
                <div class="small text-muted mb-1">Allowed Placeholders</div>
                <div id="emailTemplateAllowedPlaceholders" class="d-flex flex-wrap gap-2"></div>
              </div>
              <div>
                <div class="small text-muted mb-1">Required Placeholders</div>
                <div id="emailTemplateRequiredPlaceholders" class="d-flex flex-wrap gap-2"></div>
              </div>
              <div class="alert alert-light border small mb-0">
                Placeholders are strict and case-sensitive (<code>{{PLACEHOLDER_KEY}}</code>). Unknown placeholders are rejected on save.
                Select an event first, then use <strong>Insert Placeholder</strong> or click a chip below.
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="button-row mt-4 pt-3 border-top">
        <button type="submit" class="btn btn-filled btn-primary btn-md" id="emailTemplateSaveBtn">
          <i class="bi bi-save me-1"></i> Save
        </button>
        <a href="/email-management/templates" class="btn btn-filled btn-secondary btn-md" id="emailTemplateCancelBtn">Cancel</a>
      </div>
    </form>
  </div>
</div>

<div class="modal fade" id="emailProviderProfileHelpModal" tabindex="-1" aria-labelledby="emailProviderProfileHelpModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-light">
        <h5 class="modal-title" id="emailProviderProfileHelpModalLabel">
          <i class="bi bi-key me-2 text-primary"></i>Provider Profile (optional)
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="mb-2">Assign a Resend provider profile to this template when you need credentials or sender settings that differ from your organization defaults.</p>
        <p class="mb-2">After selecting a provider profile by name, choose a verified domain from that profile's allowlist for the sender address.</p>
        <p class="mb-2"><strong>Fallback order at send time:</strong></p>
        <ol class="small mb-3">
          <li>Template <code>providerProfileId</code> (if set on this row)</li>
          <li>Organization default provider profile</li>
          <li>Platform environment fallback (<code>RESEND_*</code> settings)</li>
        </ol>
        <p class="mb-2">Custom sender addresses must use a domain listed in the selected profile's verified domains allowlist.</p>
        <p class="mb-0">Leave this field empty to use the org/platform fallback chain automatically.</p>
      </div>
      <div class="modal-footer">
        <a href="/email-management/providers" class="btn btn-outline-primary btn-sm">Manage Provider Profiles</a>
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/modal_GenericPicker', { user }) %>
<%- include('../partials/htmlTemplateEditorModal', { htmlEditorModalId: 'htmlTemplateEditorModal', htmlEditorModalEditorId: 'htmlTemplateEditorModalEditor' }) %>
<%- include('../partials/htmlTemplateInsertImageModal', { htmlTemplateInsertImageModalId: 'htmlTemplateInsertImageModal' }) %>
<%- include('../partials/modal_MediaManager') %>
<script src="/scripts/htmlTemplateEditor.js"></script>
<script src="/scripts/htmlTemplateEditorModal.js"></script>

<script>
  (function () {
    async function showModalMessage(config = {}) {
      if (typeof showMessageModal === 'function') {
        return showMessageModal(config);
      }
      console.error('showMessageModal is unavailable.', config);
      return null;
    }

    const eventKeyHidden = document.getElementById('emailTemplateEventKeyHidden');
    const packageNameHidden = document.getElementById('emailTemplatePackageNameHidden');
    const eventDisplayInput = document.getElementById('emailTemplateEventDisplay');
    const pickEventBtn = document.getElementById('emailTemplatePickEventBtn');
    const providerSelect = document.getElementById('emailTemplateProviderSelect');
    const senderLocalPartInput = document.getElementById('emailTemplateSenderLocalPart');
    const senderDomainSelect = document.getElementById('emailTemplateSenderDomainSelect');
    const senderTemplateHidden = document.getElementById('emailTemplateSenderTemplateHidden');
    const providerDomainWarningNode = document.getElementById('emailTemplateProviderDomainWarning');
    const mainColumnNode = document.getElementById('emailTemplateMainColumn');
    const guideColumnNode = document.getElementById('emailTemplateGuideColumn');
    const guideCloseBtn = document.getElementById('emailTemplatePlaceholderGuideCloseBtn');
    const showGuideBtn = document.getElementById('emailTemplateShowGuideBtn');
    const sectionIdHidden = document.getElementById('emailTemplateSectionIdHidden');
    const operationIdHidden = document.getElementById('emailTemplateOperationIdHidden');
    const mappedRouteNode = document.getElementById('emailTemplateMappedRoute');
    const assignmentWarningNode = document.getElementById('emailTemplateEventAssignmentWarning');
    const saveBtn = document.getElementById('emailTemplateSaveBtn');
    const selectedKeyNode = document.getElementById('emailTemplateSelectedKey');
    const labelNode = document.getElementById('emailTemplateDefinitionLabel');
    const allowedNode = document.getElementById('emailTemplateAllowedPlaceholders');
    const requiredNode = document.getElementById('emailTemplateRequiredPlaceholders');
    const imageInsertModalEl = document.getElementById('htmlTemplateInsertImageModal');
    const imageUrlInput = document.getElementById('htmlTemplateImageUrlInput');
    const imageAltInput = document.getElementById('htmlTemplateImageAltInput');
    const imageInsertFromUrlBtn = document.getElementById('htmlTemplateInsertImageFromUrlBtn');
    const imageInsertFromLibraryBtn = document.getElementById('htmlTemplateOpenSavedImageLibraryBtn');
    const mediaManagerModalEl = document.getElementById('mediaManagerModal');
    const mediaManagerModal = (window.bootstrap && window.bootstrap.Modal && mediaManagerModalEl)
      ? new window.bootstrap.Modal(mediaManagerModalEl)
      : null;
    const mediaManagerModalApi = (window.MediaManagerModal && typeof window.MediaManagerModal.open === 'function')
      ? window.MediaManagerModal
      : null;

    const selectedTemplateKind = <%- JSON.stringify(selectedTemplateKind || 'event') %>;
    const generalTemplatePlaceholders = <%- JSON.stringify(['BODY_CONTENT']) %>;
    const templateKindEventInput = document.getElementById('emailTemplateKindEvent');
    const templateKindGeneralInput = document.getElementById('emailTemplateKindGeneral');
    const templateGeneralHelpNode = document.getElementById('emailTemplateGeneralHelp');
    const templateEventSectionNode = document.getElementById('emailTemplateEventSection');
    const templateGeneralSectionNode = document.getElementById('emailTemplateGeneralSection');
    const templateNameInput = document.getElementById('emailTemplateNameInput');
    const registryMap = <%- JSON.stringify(placeholderRegistryMap || {}) %>;
    const catalog = <%- JSON.stringify(safeEventCatalog || []) %>;
    const selectedEventKey = <%- JSON.stringify(selectedEventKey || '') %>;
    const initialEventKeyFromQuery = <%- JSON.stringify(initialEventKeyFromQuery || '') %>;
    const eventAssignments = <%- JSON.stringify(safeEventAssignments) %>;
    const currentTemplateId = <%- JSON.stringify(currentTemplateId || '') %>;
    const isEditMode = <%- JSON.stringify(isEdit) %>;
    const selectedSection = <%- JSON.stringify(selectedSection || '') %>;
    const selectedOperation = <%- JSON.stringify(selectedOperation || '') %>;
    const providerOptions = <%- JSON.stringify(safeProviderOptions) %>;
    const initialSenderTemplate = <%- JSON.stringify(row.senderTemplate || '') %>;
    const selectedProviderProfileId = <%- JSON.stringify(selectedProviderProfileId || '') %>;
    const guideStorageKey = 'emailTemplate.placeholderGuide.open';
    let imageInsertTargetEditorId = 'htmlTemplateEditorModalEditor';
    const savedImageLibraryFolderCache = new Map();
    const savedImageLibraryInflightByFolder = new Map();

    const imageInsertModal = (window.bootstrap && window.bootstrap.Modal && imageInsertModalEl)
      ? window.bootstrap.Modal.getOrCreateInstance(imageInsertModalEl)
      : null;

    function appendActionState(url) {
      const base = String(url || '').trim();
      if (!base) return base;
      const token = String(document.querySelector('input[name="actionStateId"]')?.value || '').trim();
      if (!token) return base;
      return base + (base.includes('?') ? '&' : '?') + 'actionStateId=' + encodeURIComponent(token);
    }

    function cleanText(value) {
      return String(value || '').replace(/\0/g, '').trim();
    }

    function escapeAttr(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/"/g, '&quot;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');
    }

    function normalizeImageUrl(value) {
      const token = cleanText(value);
      if (!token) return '';
      if (/^https?:\/\//i.test(token)) return token;
      if (/^\/uploads\//i.test(token)) return token;
      if (/^uploads\//i.test(token)) return '/' + token;
      return token;
    }

    function normalizeFolderToken(value) {
      const token = cleanText(value).replace(/\\/g, '/');
      if (!token || token === '/' || token === '.') return '';
      return token
        .split('/')
        .map((part) => cleanText(part))
        .filter(Boolean)
        .join('/');
    }

    function closeImageInsertModal() {
      if (imageInsertModal) imageInsertModal.hide();
      else if (imageInsertModalEl) {
        imageInsertModalEl.classList.remove('show');
        imageInsertModalEl.style.display = 'none';
      }
    }

    function waitForImageInsertModalHidden(timeoutMs = 450) {
      return new Promise((resolve) => {
        if (!imageInsertModalEl || !imageInsertModalEl.classList.contains('show')) {
          resolve();
          return;
        }
        let settled = false;
        const done = () => {
          if (settled) return;
          settled = true;
          imageInsertModalEl.removeEventListener('hidden.bs.modal', onHidden);
          resolve();
        };
        const onHidden = () => done();
        imageInsertModalEl.addEventListener('hidden.bs.modal', onHidden, { once: true });
        closeImageInsertModal();
        window.setTimeout(done, Math.max(120, Number(timeoutMs) || 450));
      });
    }

    function openImageInsertModal(editorId = 'htmlTemplateEditorModalEditor') {
      imageInsertTargetEditorId = cleanText(editorId) || 'htmlTemplateEditorModalEditor';
      if (imageUrlInput) imageUrlInput.value = '';
      if (imageAltInput) imageAltInput.value = '';
      if (imageInsertModal) {
        imageInsertModal.show();
        return;
      }
      if (imageInsertModalEl) {
        imageInsertModalEl.classList.add('show');
        imageInsertModalEl.style.display = 'block';
      }
    }

    function insertImageIntoEditor(editorId, urlValue, altValue = '') {
      const editorToken = cleanText(editorId) || 'htmlTemplateEditorModalEditor';
      const url = normalizeImageUrl(urlValue);
      if (!url) return false;
      if (window.HtmlTemplateEditor && typeof window.HtmlTemplateEditor.insertImage === 'function') {
        return window.HtmlTemplateEditor.insertImage(editorToken, url, cleanText(altValue));
      }
      if (window.HtmlTemplateEditor && typeof window.HtmlTemplateEditor.insertHtml === 'function') {
        const html = `<img src="${escapeAttr(url)}" alt="${escapeAttr(cleanText(altValue))}">`;
        return window.HtmlTemplateEditor.insertHtml(editorToken, html);
      }
      return false;
    }

    async function fetchSavedImageLibrary(options = {}) {
      const forceRefresh = options && options.forceRefresh === true;
      const folder = normalizeFolderToken(options && options.folder);
      const cacheKey = folder || '__root__';
      if (!forceRefresh && savedImageLibraryFolderCache.has(cacheKey)) {
        return savedImageLibraryFolderCache.get(cacheKey);
      }
      if (!forceRefresh && savedImageLibraryInflightByFolder.has(cacheKey)) {
        return savedImageLibraryInflightByFolder.get(cacheKey);
      }
      const endpoint = appendActionState('/email-management/templates/media/library');
      const requestUrl = folder
        ? (endpoint + (endpoint.includes('?') ? '&' : '?') + 'folder=' + encodeURIComponent(folder))
        : endpoint;

      const requestPromise = (async () => {
        const response = await fetch(requestUrl, {
          method: 'GET',
          headers: { 'x-ajax-request': 'true' }
        });
        let result = null;
        try {
          result = await response.json();
        } catch (_) {
          result = null;
        }
        if (!response.ok || !result || result.status !== 'success') {
          throw new Error((result && result.message) || `Unable to load saved media library (status ${response.status}).`);
        }
        const rows = Array.isArray(result.results) ? result.results : [];
        const payload = {
          rows,
          message: cleanText(result.message) || (rows.length ? `Loaded ${rows.length} image file(s).` : 'No saved image files found.'),
          defaults: result.defaults && typeof result.defaults === 'object' ? result.defaults : null,
          folders: Array.isArray(result.folders) ? result.folders : [],
          currentFolder: normalizeFolderToken(result.currentFolder || folder),
          parentFolder: normalizeFolderToken(result.parentFolder),
          defaultFolder: normalizeFolderToken(result.defaultFolder)
        };
        savedImageLibraryFolderCache.set(cacheKey, payload);
        return payload;
      })();
      savedImageLibraryInflightByFolder.set(cacheKey, requestPromise);

      try {
        return await requestPromise;
      } finally {
        savedImageLibraryInflightByFolder.delete(cacheKey);
      }
    }

    async function openSavedImageLibraryPicker(editorId) {
      if (!mediaManagerModalApi || typeof mediaManagerModalApi.open !== 'function') {
        await showModalMessage({
          title: 'Saved Media Unavailable',
          icon: 'warning',
          message: 'Saved media library is not available on this page.',
          buttons: [{ text: 'OK', class: 'btn-primary' }]
        });
        return;
      }

      const initial = await fetchSavedImageLibrary({ forceRefresh: false });
      if (typeof mediaManagerModalApi.setModalCompat === 'function') {
        mediaManagerModalApi.setModalCompat({
          modalEl: mediaManagerModalEl,
          modalInstance: mediaManagerModal
        });
      }
      if (typeof mediaManagerModalApi.setRows === 'function') {
        mediaManagerModalApi.setRows(initial.rows);
      }

      await mediaManagerModalApi.open({
        mode: 'assign',
        mediaKind: 'image',
        maxSelection: 1,
        title: 'Select Image From Saved Media Library',
        defaultView: 'list',
        defaultFolder: initial.defaultFolder || '<%= mediaDefaultFolder %>',
        defaultPageSize: 30,
        forceRefresh: true,
        onRefresh: async (query = {}) => {
          const refreshed = await fetchSavedImageLibrary({
            forceRefresh: true,
            folder: query && query.folder
          });
          return {
            rows: refreshed.rows,
            message: refreshed.message,
            defaults: refreshed.defaults,
            folders: refreshed.folders,
            currentFolder: refreshed.currentFolder,
            parentFolder: refreshed.parentFolder,
            defaultFolder: refreshed.defaultFolder
          };
        },
        onUpload: async () => {
          await showModalMessage({
            title: 'Upload Not Available',
            icon: 'info',
            message: 'Upload is not enabled for this picker. Use existing saved files.',
            buttons: [{ text: 'OK', class: 'btn-primary' }]
          });
          return { rows: [], message: 'Upload is disabled.' };
        },
        onApply: async (selectedRows) => {
          const row = Array.isArray(selectedRows) ? selectedRows[0] : null;
          const imageUrl = normalizeImageUrl(row?.url || '');
          if (!imageUrl) {
            await showModalMessage({
              title: 'Image URL Missing',
              icon: 'warning',
              message: 'Selected media item does not have a usable URL.',
              buttons: [{ text: 'OK', class: 'btn-primary' }]
            });
            return;
          }
          const altText = cleanText(row?.originalName || row?.name || row?.filename || '');
          insertImageIntoEditor(editorId, imageUrl, altText);
        }
      });
    }

    function clearChildren(node) {
      if (!node) return;
      while (node.firstChild) node.removeChild(node.firstChild);
    }

    function insertPlaceholderToken(token) {
      const cleanToken = String(token || '').trim();
      if (!cleanToken) return;
      const wrapped = cleanToken.startsWith('{{') ? cleanToken : (`{{${cleanToken}}}`);

      const modalEl = document.getElementById('htmlTemplateEditorModal');
      const modalOpen = Boolean(modalEl && modalEl.classList.contains('show'));
      if (modalOpen && window.HtmlTemplateEditor && typeof window.HtmlTemplateEditor.insertText === 'function') {
        const inserted = window.HtmlTemplateEditor.insertText('htmlTemplateEditorModalEditor', wrapped);
        if (inserted) return;
      }

      const fallback = document.getElementById('emailBodyTemplateField');
      if (!fallback) return;
      const start = Number(fallback.selectionStart || fallback.value.length || 0);
      const end = Number(fallback.selectionEnd || fallback.value.length || 0);
      const source = String(fallback.value || '');
      fallback.value = source.slice(0, start) + wrapped + source.slice(end);
      fallback.selectionStart = fallback.selectionEnd = start + wrapped.length;
    }

    function createTag(text, className, tokenValue = '') {
      const span = document.createElement('span');
      span.className = className;
      span.textContent = text;
      if (tokenValue) {
        span.classList.add('cursor-pointer');
        span.title = 'Click to insert into Body Template';
        span.setAttribute('role', 'button');
        span.setAttribute('tabindex', '0');
        span.addEventListener('click', () => insertPlaceholderToken(tokenValue));
        span.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            insertPlaceholderToken(tokenValue);
          }
        });
      }
      return span;
    }

    function normalizeToken(value) {
      return String(value || '').trim().toUpperCase();
    }

    function findEventByKey(eventKey) {
      const token = normalizeToken(eventKey);
      return catalog.find((row) => normalizeToken(row?.eventKey) === token) || null;
    }

    function findEventAssignment(eventKey) {
      const token = normalizeToken(eventKey);
      if (!token || !eventAssignments || typeof eventAssignments !== 'object') return null;
      return eventAssignments[token] || null;
    }

    function hasConflictingEventAssignment(eventKey) {
      const assignment = findEventAssignment(eventKey);
      if (!assignment?.id) return false;
      return String(assignment.id).trim() !== String(currentTemplateId || '').trim();
    }

    function updateSaveButtonState() {
      if (!saveBtn) return;
      if (isEditMode || getActiveTemplateKind() === 'general') {
        saveBtn.disabled = false;
        saveBtn.title = '';
        return;
      }
      const conflict = hasConflictingEventAssignment(eventKeyHidden?.value || '');
      saveBtn.disabled = conflict;
      saveBtn.title = conflict
        ? 'This event already has a template in your organization. Edit the existing template instead.'
        : '';
    }

    function updateEventAssignmentWarning(eventKey, options = {}) {
      if (!assignmentWarningNode) return;
      const assignment = findEventAssignment(eventKey);
      const conflict = hasConflictingEventAssignment(eventKey);
      if (!conflict || !assignment?.id) {
        assignmentWarningNode.classList.add('d-none');
        assignmentWarningNode.innerHTML = '';
        updateSaveButtonState();
        return;
      }

      const editUrl = '/email-management/templates/' + encodeURIComponent(assignment.id);
      assignmentWarningNode.classList.remove('d-none');
      assignmentWarningNode.innerHTML = [
        '<i class="bi bi-exclamation-triangle-fill me-1"></i>',
        '<strong>Event already assigned.</strong> ',
        'This organization already has template ',
        '<span class="font-monospace">' + escapeAttr(assignment.id) + '</span>',
        assignment.subjectTemplate ? (' (“' + escapeAttr(assignment.subjectTemplate) + '”)') : '',
        '. ',
        '<a href="' + editUrl + '">Edit existing template</a>',
        ' or choose a different event.'
      ].join('');

      updateSaveButtonState();

      if (options.showModal === true) {
        showModalMessage({
          title: 'Event Already Assigned',
          icon: 'warning',
          message: 'This organization already has a template for the selected event (ID: ' + assignment.id + '). Edit the existing template or choose a different event.',
          buttons: [{ text: 'OK', class: 'btn-primary' }]
        });
      }
    }

    function setSelectedEvent(eventRow, options = {}) {
      const key = normalizeToken(eventRow?.eventKey || eventRow?.id || '');
      const fromCatalog = findEventByKey(key);
      const selected = fromCatalog || eventRow || null;
      const label = String(selected?.label || selected?.name || key || '').trim();
      const sectionId = normalizeToken(selected?.sectionId || '');
      const operationId = normalizeToken(selected?.operationId || '');
      const packageName = normalizeToken(selected?.packageName || 'CORE');

      if (eventKeyHidden) eventKeyHidden.value = key;
      if (packageNameHidden) packageNameHidden.value = packageName;
      if (eventDisplayInput) eventDisplayInput.value = label;
      if (sectionIdHidden) sectionIdHidden.value = sectionId;
      if (operationIdHidden) operationIdHidden.value = operationId;
      renderPlaceholderHelp();
      updateEventAssignmentWarning(key, { showModal: options.showModal === true });
    }

    function getActiveTemplateKind() {
      if (templateKindGeneralInput?.checked) return 'general';
      if (templateKindEventInput?.checked) return 'event';
      return normalizeToken(selectedTemplateKind).toLowerCase() === 'GENERAL' ? 'general' : 'event';
    }

    function syncTemplateKindUi() {
      const isGeneral = getActiveTemplateKind() === 'general';
      if (templateEventSectionNode) {
        templateEventSectionNode.classList.toggle('d-none', isGeneral);
      }
      if (templateGeneralSectionNode) {
        templateGeneralSectionNode.classList.toggle('d-none', !isGeneral);
      }
      if (templateGeneralHelpNode) {
        templateGeneralHelpNode.classList.toggle('d-none', !isGeneral);
      }
      if (templateNameInput) {
        if (isGeneral) {
          templateNameInput.setAttribute('required', 'required');
        } else {
          templateNameInput.removeAttribute('required');
          templateNameInput.value = '';
        }
      }
      if (eventKeyHidden) {
        if (isGeneral) {
          eventKeyHidden.removeAttribute('required');
          eventKeyHidden.value = '';
        } else {
          eventKeyHidden.setAttribute('required', 'required');
        }
      }
      if (isGeneral) {
        if (packageNameHidden) packageNameHidden.value = 'CORE';
        if (sectionIdHidden) sectionIdHidden.value = '';
        if (operationIdHidden) operationIdHidden.value = '';
        if (eventDisplayInput) eventDisplayInput.value = '';
        updateEventAssignmentWarning('');
      }
      renderPlaceholderHelp();
      updateSaveButtonState();
    }

    function renderGeneralPlaceholderHelp() {
      selectedKeyNode.textContent = 'GENERAL';
      const templateName = cleanText(templateNameInput?.value || '');
      labelNode.textContent = templateName || 'Core general template slot';
      mappedRouteNode.textContent = 'Manual selection (no event route)';
      clearChildren(allowedNode);
      clearChildren(requiredNode);
      allowedNode.appendChild(createTag('{{BODY_CONTENT}}', 'badge bg-primary-subtle text-primary border', 'BODY_CONTENT'));
      allowedNode.appendChild(createTag('Caller-supplied tokens', 'badge bg-light text-muted border'));
      requiredNode.appendChild(createTag('None at save time', 'badge bg-light text-muted border'));
    }

    function renderPlaceholderHelp() {
      if (getActiveTemplateKind() === 'general') {
        renderGeneralPlaceholderHelp();
        return;
      }
      const key = normalizeToken(eventKeyHidden?.value || '');
      const eventRow = findEventByKey(key);
      const sectionId = normalizeToken(eventRow?.sectionId || sectionIdHidden?.value || '');
      const operationId = normalizeToken(eventRow?.operationId || operationIdHidden?.value || '');
      if (sectionIdHidden) sectionIdHidden.value = sectionId;
      if (operationIdHidden) operationIdHidden.value = operationId;

      selectedKeyNode.textContent = key || '-';
      mappedRouteNode.textContent = sectionId && operationId ? (sectionId + '::' + operationId) : '-';

      const def = key ? registryMap[key] : null;
      clearChildren(allowedNode);
      clearChildren(requiredNode);

      if (!def) {
        labelNode.textContent = 'No strict placeholder registry for this selection.';
        allowedNode.appendChild(createTag('No placeholders defined', 'badge bg-light text-muted border'));
        requiredNode.appendChild(createTag('No required placeholders', 'badge bg-light text-muted border'));
        return;
      }

      labelNode.textContent = def.label || key;
      (Array.isArray(def.allowed) && def.allowed.length ? def.allowed : ['None']).forEach((token) => {
        const isInsertable = String(token || '').toUpperCase() !== 'NONE';
        allowedNode.appendChild(createTag('{{' + token + '}}', 'badge bg-primary-subtle text-primary border', isInsertable ? String(token || '') : ''));
      });
      (Array.isArray(def.required) && def.required.length ? def.required : ['None']).forEach((token) => {
        const isInsertable = String(token || '').toUpperCase() !== 'NONE';
        requiredNode.appendChild(createTag('{{' + token + '}}', 'badge bg-warning-subtle text-dark border', isInsertable ? String(token || '') : ''));
      });
    }

    function getCurrentPlaceholderTokens() {
      if (getActiveTemplateKind() === 'general') {
        return (Array.isArray(generalTemplatePlaceholders) ? generalTemplatePlaceholders : [])
          .map((token) => String(token || '').trim())
          .filter(Boolean);
      }
      const key = normalizeToken(eventKeyHidden?.value || '');
      const def = key ? registryMap[key] : null;
      if (!def || !Array.isArray(def.allowed)) return [];
      return def.allowed
        .map((token) => String(token || '').trim())
        .filter((token) => token && token.toUpperCase() !== 'NONE');
    }

    function buildGlobalPlaceholderPickerItems() {
      const byKey = new Map();
      Object.keys(registryMap || {}).forEach((mapKey) => {
        const def = registryMap[mapKey];
        if (!def) return;
        const eventKey = normalizeToken(def.eventKey || mapKey);
        const eventLabel = String(def.label || eventKey || '').trim();
        const allowed = Array.isArray(def.allowed) ? def.allowed : [];
        allowed.forEach((token) => {
          const placeholderKey = normalizeToken(token);
          if (!placeholderKey || placeholderKey === 'NONE') return;
          let entry = byKey.get(placeholderKey);
          if (!entry) {
            entry = {
              id: placeholderKey,
              key: placeholderKey,
              name: '{{' + placeholderKey + '}}',
              eventKeys: [],
              eventLabels: []
            };
            byKey.set(placeholderKey, entry);
          }
          if (eventKey && entry.eventKeys.indexOf(eventKey) === -1) {
            entry.eventKeys.push(eventKey);
            entry.eventLabels.push(eventLabel || eventKey);
          }
        });
      });
      return Array.from(byKey.values())
        .map((entry) => ({
          ...entry,
          description: entry.eventLabels.length
            ? 'Used in: ' + entry.eventLabels.join(', ')
            : ''
        }))
        .sort((a, b) => a.key.localeCompare(b.key));
    }

    function openPlaceholderPicker() {
      const localItems = buildGlobalPlaceholderPickerItems();
      if (!localItems.length) {
        showModalMessage({
          title: 'No Placeholders',
          icon: 'warning',
          message: 'No placeholders are available for your account.',
          buttons: [{ text: 'OK', class: 'btn-primary' }]
        });
        return;
      }
      if (!window.GenericPicker || typeof window.GenericPicker.open !== 'function') return;
      const pickerBaseConfig = {
        title: 'Insert Placeholder',
        icon: 'bi-braces',
        sourceMode: 'local',
        localItems,
        placeholder: 'Search placeholders (2+ chars, or type --- for all)',
        searchFields: 'id,key,name,description,eventKeys,eventLabels',
        limit: 100,
        onSelect: (item) => insertPlaceholderToken(item?.key || item?.id || '')
      };
      const normalizedPickerConfig = (window.GenericPickerPresets && typeof window.GenericPickerPresets.normalizeConfig === 'function')
        ? window.GenericPickerPresets.normalizeConfig(pickerBaseConfig)
        : pickerBaseConfig;
      window.GenericPicker.open(normalizedPickerConfig);
    }

    function ensureRichEditorPlaceholderPicker() {
      const modalEl = document.getElementById('htmlTemplateEditorModal');
      if (!modalEl) return;
      const wrap = modalEl.querySelector('.js-html-template-modal-tokens-wrap');
      if (!wrap || wrap.querySelector('.js-email-placeholder-picker-btn')) return;
      const pickerBtn = document.createElement('button');
      pickerBtn.type = 'button';
      pickerBtn.className = 'btn btn-sm btn-outline-primary js-email-placeholder-picker-btn mt-2';
      pickerBtn.innerHTML = '<i class="bi bi-braces me-1"></i>Insert Placeholder';
      pickerBtn.addEventListener('click', (event) => {
        event.preventDefault();
        openPlaceholderPicker();
      });
      wrap.appendChild(pickerBtn);
    }

    function openBodyTemplateModalEditor() {
      const target = document.getElementById('emailBodyTemplateField');
      if (!target || !window.HtmlTemplateEditorModal || typeof window.HtmlTemplateEditorModal.open !== 'function') return;
      window.HtmlTemplateEditorModal.open({
        target,
        title: 'Body Template Editor',
        tokens: getCurrentPlaceholderTokens()
      });
      ensureRichEditorPlaceholderPicker();
    }

    function parseSenderTemplateParts(senderTemplate = '') {
      const token = cleanText(senderTemplate);
      if (!token) return { localPart: '', domain: '' };
      const angleMatch = token.match(/^(.+)<[^@]+@([^>]+)>$/i);
      if (angleMatch) {
        return {
          localPart: cleanText(angleMatch[1]).replace(/^["'\s]+|["'\s]+$/g, ''),
          domain: cleanText(angleMatch[2]).toLowerCase()
        };
      }
      const atIndex = token.lastIndexOf('@');
      if (atIndex < 0) return { localPart: token, domain: '' };
      return {
        localPart: cleanText(token.slice(0, atIndex)),
        domain: cleanText(token.slice(atIndex + 1)).toLowerCase()
      };
    }

    function composeSenderTemplate(localPart = '', domain = '') {
      const local = cleanText(localPart);
      const domainToken = cleanText(domain).toLowerCase().replace(/^@+/, '');
      if (!local && !domainToken) return '';
      if (!domainToken) return local;
      if (!local) return `noreply@${domainToken}`;
      return `${local}@${domainToken}`;
    }

    function findProviderOption(profileId = '') {
      const token = cleanText(profileId);
      if (!token) return null;
      return (Array.isArray(providerOptions) ? providerOptions : []).find((row) => cleanText(row?.id) === token) || null;
    }

    function updateProviderDomainWarning(message = '') {
      if (!providerDomainWarningNode) return;
      const text = cleanText(message);
      if (!text) {
        providerDomainWarningNode.classList.add('d-none');
        providerDomainWarningNode.textContent = '';
        return;
      }
      providerDomainWarningNode.classList.remove('d-none');
      providerDomainWarningNode.textContent = text;
    }

    function populateSenderDomainOptions(profile = null, selectedDomain = '') {
      if (!senderDomainSelect) return;
      const domains = Array.isArray(profile?.verifiedDomains) ? profile.verifiedDomains : [];
      senderDomainSelect.innerHTML = '';
      const placeholder = document.createElement('option');
      placeholder.value = '';
      placeholder.textContent = profile ? 'Select verified domain' : 'Select provider first';
      senderDomainSelect.appendChild(placeholder);
      domains.forEach((domain) => {
        const option = document.createElement('option');
        option.value = domain;
        option.textContent = domain;
        if (cleanText(selectedDomain).toLowerCase() === cleanText(domain).toLowerCase()) {
          option.selected = true;
        }
        senderDomainSelect.appendChild(option);
      });
      senderDomainSelect.disabled = !profile || !domains.length;
      if (profile && !domains.length) {
        updateProviderDomainWarning('Selected provider profile has no verified domains configured.');
      } else {
        updateProviderDomainWarning('');
      }
    }

    function syncSenderTemplateHidden() {
      if (!senderTemplateHidden) return;
      const providerId = cleanText(providerSelect?.value || '');
      const local = cleanText(senderLocalPartInput?.value || '');
      const domain = cleanText(senderDomainSelect?.value || '');
      if (!providerId) {
        senderTemplateHidden.value = local;
        return;
      }
      senderTemplateHidden.value = composeSenderTemplate(local, domain);
    }

    function applyProviderSelection(profileId = '', options = {}) {
      const token = cleanText(profileId);
      const profile = findProviderOption(token);
      if (providerSelect && providerSelect.value !== token) {
        providerSelect.value = token;
      }
      const rawSender = options.senderTemplate || initialSenderTemplate || senderTemplateHidden?.value || '';
      const parsed = parseSenderTemplateParts(rawSender);
      if (!profile) {
        populateSenderDomainOptions(null, '');
        if (senderLocalPartInput) {
          senderLocalPartInput.value = cleanText(rawSender);
        }
        updateProviderDomainWarning('');
        syncSenderTemplateHidden();
        return;
      }
      populateSenderDomainOptions(profile, options.domain || parsed.domain);
      if (senderLocalPartInput) {
        senderLocalPartInput.value = options.localPart !== undefined
          ? options.localPart
          : (parsed.localPart || 'noreply');
      }
      syncSenderTemplateHidden();
    }

    function setGuideOpen(isOpen, options = {}) {
      const open = Boolean(isOpen);
      if (mainColumnNode) {
        mainColumnNode.classList.toggle('col-lg-12', !open);
        mainColumnNode.classList.toggle('col-lg-7', open);
      }
      if (guideColumnNode) {
        guideColumnNode.classList.toggle('d-none', !open);
      }
      if (showGuideBtn) {
        showGuideBtn.classList.toggle('d-none', open);
      }
      if (!options.skipStorage) {
        try {
          sessionStorage.setItem(guideStorageKey, open ? '1' : '0');
        } catch (_) {}
      }
    }

    function initPlaceholderGuideLayout() {
      let initialOpen = false;
      try {
        initialOpen = sessionStorage.getItem(guideStorageKey) === '1';
      } catch (_) {}
      setGuideOpen(initialOpen, { skipStorage: true });
      if (showGuideBtn) {
        showGuideBtn.addEventListener('click', () => setGuideOpen(true));
      }
      if (guideCloseBtn) {
        guideCloseBtn.addEventListener('click', () => setGuideOpen(false));
      }
    }

    if (providerSelect) {
      providerSelect.addEventListener('change', () => {
        applyProviderSelection(providerSelect.value, {
          localPart: senderLocalPartInput?.value || '',
          domain: ''
        });
      });
    }
    if (senderLocalPartInput) {
      senderLocalPartInput.addEventListener('input', syncSenderTemplateHidden);
    }
    if (senderDomainSelect) {
      senderDomainSelect.addEventListener('change', syncSenderTemplateHidden);
    }

    applyProviderSelection(selectedProviderProfileId || providerSelect?.value || '');
    initPlaceholderGuideLayout();

    function validateSenderBeforeSubmit() {
      const providerId = cleanText(providerSelect?.value || '');
      const senderValue = cleanText(senderTemplateHidden?.value || '');
      if (!senderValue) {
        return 'Sender template is required.';
      }
      if (!providerId) return '';
      const profile = findProviderOption(providerId);
      if (!profile) return 'Selected provider profile is not available.';
      const domains = Array.isArray(profile.verifiedDomains) ? profile.verifiedDomains : [];
      if (!domains.length) return 'Selected provider profile has no verified domains configured.';
      const domain = parseSenderTemplateParts(senderValue).domain;
      if (!domain) return 'Select a verified sender domain for the chosen provider profile.';
      if (!domains.map((item) => cleanText(item).toLowerCase()).includes(domain)) {
        return `Sender domain '${domain}' is not in the selected provider profile allowlist.`;
      }
      return '';
    }

    if (pickEventBtn) {
      pickEventBtn.addEventListener('click', () => {
        if (!window.GenericPicker || typeof window.GenericPicker.open !== 'function') return;
        const excludeQuery = currentTemplateId
          ? ('&excludeTemplateId=' + encodeURIComponent(currentTemplateId))
          : '';
        const pickerBaseConfig = {
          title: 'Select Email Event',
          icon: 'bi-envelope-paper',
          apiEndpoint: '/email-management/templates/picker/events' + excludeQuery,
          placeholder: 'Search supported email events (type --- to show all)...',
          searchFields: 'id,name,label,sectionId,operationId,description,assigned',
          limit: 20,
          onSelect: (item) => {
            setSelectedEvent({
              eventKey: normalizeToken(item?.eventKey || item?.id || ''),
              label: String(item?.label || item?.name || item?.id || '').trim(),
              sectionId: normalizeToken(item?.sectionId || ''),
              operationId: normalizeToken(item?.operationId || '')
            }, { showModal: item?.assigned === true });
          }
        };
        const normalizedPickerConfig = (window.GenericPickerPresets && typeof window.GenericPickerPresets.normalizeConfig === 'function')
          ? window.GenericPickerPresets.normalizeConfig(pickerBaseConfig)
          : pickerBaseConfig;
        window.GenericPicker.open(normalizedPickerConfig);
      });
    }

    templateKindEventInput?.addEventListener('change', syncTemplateKindUi);
    templateKindGeneralInput?.addEventListener('change', syncTemplateKindUi);
    templateNameInput?.addEventListener('input', () => {
      renderPlaceholderHelp();
      updateSaveButtonState();
    });
    templateNameInput?.addEventListener('change', updateSaveButtonState);

    let initialEvent = selectedEventKey ? findEventByKey(selectedEventKey) : null;
    if (!initialEvent && initialEventKeyFromQuery) {
      initialEvent = findEventByKey(initialEventKeyFromQuery);
    }
    if (!initialEvent && selectedSection && selectedOperation) {
      const fallback = catalog.find((event) => (
        normalizeToken(event?.sectionId) === normalizeToken(selectedSection)
        && normalizeToken(event?.operationId) === normalizeToken(selectedOperation)
      ));
      if (fallback) initialEvent = fallback;
    }
    if (initialEvent && getActiveTemplateKind() !== 'general') {
      setSelectedEvent(initialEvent);
    } else if (getActiveTemplateKind() === 'general') {
      syncTemplateKindUi();
    } else {
      if (eventDisplayInput) eventDisplayInput.value = '';
      renderPlaceholderHelp();
      updateEventAssignmentWarning('');
    }

    const openBodyEditorBtn = document.getElementById('emailOpenBodyTemplateEditorBtn');
    if (openBodyEditorBtn) {
      openBodyEditorBtn.addEventListener('click', (event) => {
        event.preventDefault();
        openBodyTemplateModalEditor();
      });
    }

    const insertPlaceholderBtn = document.getElementById('emailInsertPlaceholderBtn');
    if (insertPlaceholderBtn) {
      insertPlaceholderBtn.addEventListener('click', (event) => {
        event.preventDefault();
        openPlaceholderPicker();
      });
    }

    const richEditorModal = document.getElementById('htmlTemplateEditorModal');
    if (richEditorModal) {
      richEditorModal.addEventListener('shown.bs.modal', () => ensureRichEditorPlaceholderPicker());
    }

    if (imageInsertFromUrlBtn) {
      imageInsertFromUrlBtn.addEventListener('click', async (event) => {
        event.preventDefault();
        const imageUrl = normalizeImageUrl(imageUrlInput?.value || '');
        if (!imageUrl) {
          await showModalMessage({
            title: 'Image URL Required',
            icon: 'warning',
            message: 'Please enter a valid image URL or choose from Saved Media Library.',
            buttons: [{ text: 'OK', class: 'btn-primary' }]
          });
          return;
        }
        insertImageIntoEditor(imageInsertTargetEditorId, imageUrl, cleanText(imageAltInput?.value || ''));
        closeImageInsertModal();
      });
    }

    if (imageInsertFromLibraryBtn) {
      imageInsertFromLibraryBtn.addEventListener('click', async (event) => {
        event.preventDefault();
        await waitForImageInsertModalHidden();
        try {
          await openSavedImageLibraryPicker(imageInsertTargetEditorId);
        } catch (error) {
          await showModalMessage({
            title: 'Saved Media Error',
            icon: 'error',
            message: error?.message || 'Unable to open saved media library.',
            buttons: [{ text: 'OK', class: 'btn-primary' }]
          });
        }
      });
    }

    window.HtmlTemplateEditorHooks = window.HtmlTemplateEditorHooks || {};
    window.HtmlTemplateEditorHooks.onInsertImage = ({ editorId }) => {
      openImageInsertModal(editorId || 'htmlTemplateEditorModalEditor');
      return true;
    };

    const form = document.getElementById('emailManagementTemplateForm');
    const cancelBtn = document.getElementById('emailTemplateCancelBtn');
    let submitting = false;

    function setBusy(button, label) {
      if (!button) return;
      if (!button.dataset.defaultHtml) button.dataset.defaultHtml = button.innerHTML;
      button.disabled = true;
      button.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>' + label;
    }

    function restore(button) {
      if (!button) return;
      button.disabled = false;
      if (button.dataset.defaultHtml) button.innerHTML = button.dataset.defaultHtml;
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submitting) return;
      if (!isEditMode && getActiveTemplateKind() !== 'general' && hasConflictingEventAssignment(eventKeyHidden?.value || '')) {
        await showModalMessage({
          title: 'Event Already Assigned',
          icon: 'warning',
          message: 'This organization already has a template for the selected event. Edit the existing template or choose a different event.',
          buttons: [{ text: 'OK', class: 'btn-primary' }]
        });
        return;
      }
      if (getActiveTemplateKind() === 'general' && !cleanText(templateNameInput?.value || '')) {
        await showModalMessage({
          title: 'Template Name Required',
          icon: 'warning',
          message: 'Enter a template name for general templates.',
          buttons: [{ text: 'OK', class: 'btn-primary' }]
        });
        return;
      }
      const senderValidationMessage = validateSenderBeforeSubmit();
      if (senderValidationMessage) {
        await showModalMessage({
          title: 'Sender Configuration Required',
          icon: 'warning',
          message: senderValidationMessage,
          buttons: [{ text: 'OK', class: 'btn-primary' }]
        });
        return;
      }
      syncSenderTemplateHidden();
      submitting = true;

      try {
        setBusy(saveBtn, 'Saving...');
        if (cancelBtn) {
          cancelBtn.classList.add('disabled');
          cancelBtn.style.pointerEvents = 'none';
          cancelBtn.setAttribute('aria-disabled', 'true');
        }

        const formData = new FormData(form);
        formData.set('isActive', document.getElementById('emailTemplateActiveSwitch').checked ? 'true' : 'false');
        const payload = new URLSearchParams();
        for (const [key, value] of formData.entries()) payload.append(key, value);

        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8', 'x-ajax-request': 'true' },
          body: payload.toString()
        });

        let result = null;
        try {
          result = await response.json();
        } catch (_) {
          result = { status: 'error', message: 'Unexpected response while saving template.' };
        }
        if (!response.ok || result.status !== 'success') {
          throw new Error(result.message || 'Failed to save template.');
        }

        await showModalMessage({
          title: 'Saved',
          icon: 'success',
          message: result.message || 'Email template saved successfully.',
          buttons: [{ text: 'OK', class: 'btn-primary' }]
        });
        window.location.href = '/email-management/templates';
      } catch (error) {
        await showModalMessage({
          title: 'Save Failed',
          icon: 'error',
          message: error?.message || 'Unable to save template.',
          buttons: [{ text: 'OK', class: 'btn-primary' }]
        });
        submitting = false;
        restore(saveBtn);
        if (cancelBtn) {
          cancelBtn.classList.remove('disabled');
          cancelBtn.style.pointerEvents = '';
          cancelBtn.removeAttribute('aria-disabled');
        }
      }
    });
  })();
</script>
