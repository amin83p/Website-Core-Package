<%- include('../partials/tablePages-start', {
  title,
  user,
  tableName: null,
  print: false,
  btn_export: false,
  headerManageBtns: [
    '<a href="/dashboard/section-nav/SCHEDULED_TASK_MANAGEMENT" class="btn btn-filled btn-secondary btn-md mb-2"><i class="bi bi-speedometer2 me-1"></i> Tasks Dashboard</a>'
  ],
  manageBtns: Array.isArray(manageBtns) ? manageBtns : []
}) %>

<div class="card border-0 shadow-sm mb-3">
  <div class="card-body py-3">
    <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
      <div>
        <div class="fw-bold text-dark mb-1"><i class="bi bi-calendar2-check me-2"></i>24-Hour Task Manager</div>
        <div class="small text-muted">Upcoming scheduled tasks in the next 24 hours and completed runs from the last 24 hours.</div>
      </div>
      <div class="text-muted small" data-stm-generated-at></div>
    </div>
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body p-3 p-md-4">
    <%- include('./partials/scheduledTaskManagerPanel') %>
  </div>
</div>

<span id="urlRef" data-id="scheduled-tasks/manager" hidden></span>
<%- include('../partials/tablePages-end') %>

<script src="<%= typeof staticAssetUrl === 'function' ? staticAssetUrl('/scripts/scheduledTaskManagerPanel.js') : '/scripts/scheduledTaskManagerPanel.js' %>"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    window.ScheduledTaskManagerPanel?.init(document.querySelector('[data-scheduled-task-manager-panel]'), {
      mode: 'page',
      fullPageLink: '/scheduled-tasks/manager'
    });
  });
</script>
