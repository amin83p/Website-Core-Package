<%- include('../partials/tablePages-start', {
  title,
  user,
  tableName,
  print,
  btn_export: false,
  headerManageBtns: [
    '<a href="/dashboard/section-nav/SCHEDULED_TASK_MANAGEMENT" class="btn btn-filled btn-secondary btn-md mb-2"><i class="bi bi-speedometer2 me-1"></i> Tasks Dashboard</a>'
  ],
  manageBtns: Array.isArray(manageBtns) ? manageBtns : []
}) %>

<%
  const access = (outboxAccess && typeof outboxAccess === 'object') ? outboxAccess : {};
  const canCancel = access.canCancel === true;
  const canDelete = access.canDelete === true;
  const showBulkActions = canCancel || canDelete;
  const stateFilters = (filters && typeof filters === 'object') ? filters : {};
  const selectedStatusFilter = String(stateFilters?.status__eq || '').toLowerCase();
  const selectedOrgFilter = String(stateFilters?.orgId__eq || '').trim();
  const selectedEventKeyFilter = String(stateFilters?.eventKey__eq || '').trim();
  const hasOutboxFiltersApplied = Boolean(
    selectedStatusFilter
    || selectedOrgFilter
    || selectedEventKeyFilter
  );
%>

<div class="card border-0 shadow-sm mb-3">
  <div class="card-header bg-white d-flex align-items-center justify-content-between py-2 px-3">
    <div class="fw-bold text-dark"><i class="bi bi-funnel me-2"></i>Filter Email Outbox</div>
    <button
      id="emailOutboxFilterToggleBtn"
      type="button"
      class="btn btn-outline-secondary btn-sm px-2"
      data-bs-toggle="collapse"
      data-bs-target="#emailOutboxFilterCollapse"
      aria-expanded="<%= hasOutboxFiltersApplied ? 'true' : 'false' %>"
      aria-controls="emailOutboxFilterCollapse"
      aria-label="<%= hasOutboxFiltersApplied ? 'Close filters' : 'Open filters' %>">
      <i id="emailOutboxFilterToggleIcon" class="bi <%= hasOutboxFiltersApplied ? 'bi-chevron-up' : 'bi-chevron-down' %>"></i>
    </button>
  </div>
  <div class="collapse<%= hasOutboxFiltersApplied ? ' show' : '' %>" id="emailOutboxFilterCollapse">
    <form method="GET" action="/scheduled-tasks/outbox" id="emailOutboxFilterForm" class="card-body p-3">
      <% if (stateFilters?.q) { %><input type="hidden" name="q" value="<%= stateFilters.q %>"><% } %>
      <% if (stateFilters?.type) { %><input type="hidden" name="type" value="<%= stateFilters.type %>"><% } %>
      <% if (stateFilters?.searchFields) { %><input type="hidden" name="searchFields" value="<%= stateFilters.searchFields %>"><% } %>
      <div class="row g-3 align-items-end">
        <div class="col-md-3">
          <label class="form-label mb-1">Status</label>
          <select class="form-select size-md" name="status__eq">
            <option value="">All</option>
            <option value="queued" <%= selectedStatusFilter === 'queued' ? 'selected' : '' %>>Queued</option>
            <option value="sending" <%= selectedStatusFilter === 'sending' ? 'selected' : '' %>>Sending</option>
            <option value="sent" <%= selectedStatusFilter === 'sent' ? 'selected' : '' %>>Sent</option>
            <option value="failed" <%= selectedStatusFilter === 'failed' ? 'selected' : '' %>>Failed</option>
            <option value="cancelled" <%= selectedStatusFilter === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
          </select>
        </div>
        <div class="col-md-3">
          <label class="form-label mb-1">Organization ID</label>
          <input type="text" class="form-control size-md font-monospace" name="orgId__eq" value="<%= selectedOrgFilter %>" placeholder="ORG_...">
        </div>
        <div class="col-md-4">
          <label class="form-label mb-1">Event Key</label>
          <input type="text" class="form-control size-md font-monospace" name="eventKey__eq" value="<%= selectedEventKeyFilter %>" placeholder="SCHOOL_UNCOMPLETED_SESSION_EMAIL">
        </div>
        <div class="col-md-2 d-flex gap-2 justify-content-md-end">
          <a href="/scheduled-tasks/outbox" class="btn btn-outline-secondary btn-md">Reset</a>
          <button type="submit" class="btn btn-filled btn-primary btn-md">
            <i class="bi bi-funnel me-1"></i> Apply
          </button>
        </div>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/tablePages-search', {
  placeholder: 'Search recipient, subject, event key, status, org...',
  fields: []
}) %>

<% if (showBulkActions) { %>
  <div id="emailOutboxBulkToolbar" class="d-flex flex-wrap align-items-center gap-2 mb-3 d-none">
    <span class="text-muted small"><span id="emailOutboxSelectedCount">0</span> selected</span>
    <% if (canCancel) { %>
      <button type="button" class="btn btn-outline-danger btn-sm" id="emailOutboxBulkCancelBtn" disabled>Cancel selected</button>
    <% } %>
    <% if (canDelete) { %>
      <button type="button" class="btn btn-outline-secondary btn-sm" id="emailOutboxBulkDeleteBtn" disabled>Delete selected</button>
    <% } %>
  </div>
<% } %>

<div class="table-scroll-wrapper" data-floating-row-actions="true">
  <table class="table-responsive size-md" id="first-table">
    <thead>
      <tr>
        <% if (showBulkActions) { %>
          <th class="ps-4 text-center" style="width: 92px;" data-column="select" data-default-label="Select all" title="Select all / Deselect all">
            <label class="d-flex flex-column align-items-center gap-0 mb-0" for="emailOutboxSelectAll" style="cursor: pointer;">
              <input type="checkbox" class="form-check-input" id="emailOutboxSelectAll" aria-label="Select all rows">
              <span class="small text-muted header-label">Select all</span>
            </label>
          </th>
        <% } %>
        <th class="draggable ps-4" data-column="to">Recipient <span class="sort-icon"></span></th>
        <th class="draggable" data-column="subject">Subject <span class="sort-icon"></span></th>
        <th class="draggable" data-column="orgId">Organization <span class="sort-icon"></span></th>
        <th class="draggable" data-column="eventKey">Event <span class="sort-icon"></span></th>
        <th class="draggable" data-column="sendAt">Send At <span class="sort-icon"></span></th>
        <th class="draggable" data-column="status">Status <span class="sort-icon"></span></th>
        <th class="text-end pe-4">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (!data || !data.length) { %>
        <tr>
          <td colspan="<%= showBulkActions ? 8 : 7 %>" class="text-center text-muted py-4">No outbox emails found.</td>
        </tr>
      <% } %>
      <% (data || []).forEach((row) => { %>
        <tr data-entity-row-id="<%= row.id %>" data-outbox-status="<%= row.status || '' %>">
          <% if (showBulkActions) { %>
            <td class="ps-4 text-center" data-column="select">
              <input
                type="checkbox"
                class="form-check-input email-outbox-row-checkbox"
                value="<%= row.id %>"
                data-status="<%= row.status || '' %>"
                aria-label="Select outbox email <%= row.id %>">
            </td>
          <% } %>
          <td class="<%= showBulkActions ? '' : 'ps-4' %> small"><%= row.to %></td>
          <td class="text-truncate" style="max-width: 280px;" title="<%= row.subject || '' %>"><%= row.subject || '—' %></td>
          <td><%= row.orgId || '—' %></td>
          <td class="font-monospace small"><%= row.eventKey || '—' %></td>
          <td class="small" data-sort-value="<%= row.sendAt || '' %>">
            <%= row.sendAt ? (typeof formatOrgDateTime === 'function' ? formatOrgDateTime(row.sendAt) : row.sendAt) : '—' %>
          </td>
          <td data-sort-value="<%= row.status || '' %>">
            <% if (row.status === 'sent') { %>
              <span class="badge bg-success-subtle text-success border"><%= row.status %></span>
            <% } else if (row.status === 'failed') { %>
              <span class="badge bg-danger-subtle text-danger border"><%= row.status %></span>
            <% } else if (row.status === 'queued') { %>
              <span class="badge bg-primary-subtle text-primary border"><%= row.status %></span>
            <% } else { %>
              <span class="badge bg-secondary-subtle text-secondary border"><%= row.status %></span>
            <% } %>
          </td>
          <td class="table-actions text-end pe-4">
            <% if (row.status === 'queued' || row.status === 'sending') { %>
              <div class="row-actions-wrap">
                <button
                  type="button"
                  class="btn btn-secondary btn-sm btn-row-actions-toggle"
                  data-row-actions-id="<%= row.id %>"
                  title="Outbox actions">
                  <i class="bi bi-three-dots-vertical"></i>
                </button>
                <div class="row-actions-menu d-none" data-row-actions-id="<%= row.id %>">
                  <% if (canCancel) { %>
                    <button
                      type="button"
                      class="btn btn-outline-danger btn-sm email-outbox-cancel-btn"
                      data-id="<%= row.id %>"
                      data-subject="<%= row.subject || row.to || row.id %>">
                      <i class="bi bi-x-circle me-2"></i>Cancel
                    </button>
                  <% } else { %>
                    <span class="text-muted small px-2 py-1">No actions available</span>
                  <% } %>
                </div>
              </div>
            <% } else { %>
              <span class="text-muted small">—</span>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/pagination', {
  pagination: pagination,
  filters: filters,
  baseUrlPath: baseUrlPath || 'scheduled-tasks/outbox'
}) %>

<%- include('../partials/tablePages-end') %>
<%- include('./partials/scheduledTaskClientActions') %>

<script>
  (function () {
    const actions = window.ScheduledTaskClientActions || {};

    function initCollapseToggleIcon(options = {}) {
      const collapseEl = document.getElementById(String(options.collapseId || ''));
      const buttonEl = document.getElementById(String(options.buttonId || ''));
      const iconEl = document.getElementById(String(options.iconId || ''));
      if (!collapseEl || !buttonEl || !iconEl) return;

      const openIcon = String(options.openIcon || 'bi-chevron-down');
      const closeIcon = String(options.closeIcon || 'bi-chevron-up');
      const setState = (expanded) => {
        iconEl.classList.remove(openIcon, closeIcon);
        iconEl.classList.add(expanded ? closeIcon : openIcon);
        buttonEl.setAttribute('aria-expanded', expanded ? 'true' : 'false');
      };

      setState(collapseEl.classList.contains('show'));
      collapseEl.addEventListener('shown.bs.collapse', () => setState(true));
      collapseEl.addEventListener('hidden.bs.collapse', () => setState(false));
    }

    initCollapseToggleIcon({
      collapseId: 'emailOutboxFilterCollapse',
      buttonId: 'emailOutboxFilterToggleBtn',
      iconId: 'emailOutboxFilterToggleIcon'
    });

    const bulkToolbar = document.getElementById('emailOutboxBulkToolbar');
    const selectAll = document.getElementById('emailOutboxSelectAll');
    const selectedCountEl = document.getElementById('emailOutboxSelectedCount');
    const bulkCancelBtn = document.getElementById('emailOutboxBulkCancelBtn');
    const bulkDeleteBtn = document.getElementById('emailOutboxBulkDeleteBtn');
    const rowCheckboxes = Array.from(document.querySelectorAll('.email-outbox-row-checkbox'));

    function getSelectedRows() {
      return rowCheckboxes.filter((checkbox) => checkbox.checked);
    }

    function refreshBulkToolbar() {
      const selected = getSelectedRows();
      const count = selected.length;
      if (selectedCountEl) selectedCountEl.textContent = String(count);
      if (bulkToolbar) bulkToolbar.classList.toggle('d-none', count === 0);
      if (selectAll) {
        selectAll.indeterminate = count > 0 && count < rowCheckboxes.length;
        selectAll.checked = count > 0 && count === rowCheckboxes.length;
      }
      const hasCancellable = selected.some((checkbox) => ['queued', 'sending'].includes(String(checkbox.dataset.status || '')));
      const hasDeletable = selected.some((checkbox) => ['cancelled', 'failed', 'sent'].includes(String(checkbox.dataset.status || '')));
      if (bulkCancelBtn) bulkCancelBtn.disabled = !hasCancellable;
      if (bulkDeleteBtn) bulkDeleteBtn.disabled = !hasDeletable;
    }

    if (selectAll) {
      selectAll.addEventListener('change', () => {
        rowCheckboxes.forEach((checkbox) => {
          checkbox.checked = selectAll.checked;
        });
        refreshBulkToolbar();
      });
    }

    rowCheckboxes.forEach((checkbox) => {
      checkbox.addEventListener('change', refreshBulkToolbar);
    });

    if (bulkCancelBtn) {
      bulkCancelBtn.addEventListener('click', async () => {
        const ids = getSelectedRows()
          .filter((checkbox) => ['queued', 'sending'].includes(String(checkbox.dataset.status || '')))
          .map((checkbox) => String(checkbox.value || '').trim())
          .filter(Boolean);
        if (!ids.length) return;
        const confirmed = await actions.showModalMessage({
          title: 'Cancel Selected Emails',
          icon: 'warning',
          message: `Cancel ${ids.length} selected outbox email(s)?`,
          buttons: [
            { text: 'Keep', class: 'btn-secondary', value: 'cancel' },
            { text: 'Cancel emails', class: 'btn-danger', value: 'confirm' }
          ]
        });
        if (confirmed !== 'confirm') return;
        await actions.runScheduledTaskMutation({
          url: '/scheduled-tasks/outbox/bulk-cancel',
          loadingNote: 'Cancelling selected emails...',
          successTitle: 'Emails Cancelled',
          successMessage: 'Selected outbox emails were cancelled.',
          body: { ids: ids.join(',') }
        });
      });
    }

    if (bulkDeleteBtn) {
      bulkDeleteBtn.addEventListener('click', async () => {
        const ids = getSelectedRows()
          .filter((checkbox) => ['cancelled', 'failed', 'sent'].includes(String(checkbox.dataset.status || '')))
          .map((checkbox) => String(checkbox.value || '').trim())
          .filter(Boolean);
        if (!ids.length) return;
        const confirmed = await actions.showModalMessage({
          title: 'Delete Selected Emails',
          icon: 'warning',
          message: `Permanently delete ${ids.length} selected outbox email(s)?`,
          buttons: [
            { text: 'Cancel', class: 'btn-secondary', value: 'cancel' },
            { text: 'Delete', class: 'btn-danger', value: 'confirm' }
          ]
        });
        if (confirmed !== 'confirm') return;
        await actions.runScheduledTaskMutation({
          url: '/scheduled-tasks/outbox/bulk-delete',
          loadingNote: 'Deleting selected emails...',
          successTitle: 'Emails Deleted',
          successMessage: 'Selected outbox emails were deleted.',
          body: { ids: ids.join(',') }
        });
      });
    }

    document.querySelectorAll('.email-outbox-cancel-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = String(btn.dataset.id || '').trim();
        const subject = String(btn.dataset.subject || 'this email').trim();
        if (!id) return;

        const confirmed = await actions.showModalMessage({
          title: 'Cancel Outbox Email',
          icon: 'warning',
          message: `Cancel queued email for ${subject}?`,
          buttons: [
            { text: 'Keep', class: 'btn-secondary', value: 'cancel' },
            { text: 'Cancel email', class: 'btn-danger', value: 'confirm' }
          ]
        });
        if (confirmed !== 'confirm') return;

        await actions.runScheduledTaskMutation({
          url: `/scheduled-tasks/outbox/${encodeURIComponent(id)}/cancel`,
          loadingNote: 'Cancelling email...',
          successTitle: 'Email Cancelled',
          successMessage: 'The outbox email was cancelled.'
        });
      });
    });
  })();
</script>
