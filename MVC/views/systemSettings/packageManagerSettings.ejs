<%
  const backend = runtimeBackend || {};
  const activeMode = String(backend.mode || 'json').trim().toLowerCase();
  const installedRows = Array.isArray(installedPackages) ? installedPackages : [];
  const localOptions = Array.isArray(localManifestOptions) ? localManifestOptions : [];
  const localWarnings = Array.isArray(localManifestWarnings) ? localManifestWarnings : [];
  const startupWarnings = Array.isArray(typeof startupPackageWarnings !== 'undefined' ? startupPackageWarnings : [])
    ? (typeof startupPackageWarnings !== 'undefined' ? startupPackageWarnings : [])
    : [];
  const actionStateValue = typeof actionStateId !== 'undefined' ? actionStateId : '';
  const storageRoot = String(typeof packageStorageRoot !== 'undefined' ? packageStorageRoot : '').trim();
  const storageRootSource = String(typeof packageStorageRootSource !== 'undefined' ? packageStorageRootSource : '').trim();
  const packageRoot = storageRoot;
  const storageRootWarnings = Array.isArray(typeof packageStorageRootWarnings !== 'undefined' ? packageStorageRootWarnings : [])
    ? (typeof packageStorageRootWarnings !== 'undefined' ? packageStorageRootWarnings : [])
    : [];
  const orgRows = Array.isArray(typeof organizations !== 'undefined' ? organizations : [])
    ? (typeof organizations !== 'undefined' ? organizations : [])
    : [];
  const activeOrg = String(typeof activeOrgId !== 'undefined' ? activeOrgId : '').trim();
  const activeOrgName = (() => {
    if (!activeOrg) return '';
    const org = orgRows.find((row) => String(row?.id || row?.orgId || '').trim() === activeOrg);
    const name = String(org?.name || org?.displayName || org?.identity?.displayName || org?.identity?.legalName || '').trim();
    return name ? `${name} (#${activeOrg})` : activeOrg;
  })();
  const trustedZipKeysCount = Number.isFinite(Number(typeof zipTrustedKeysCount !== 'undefined' ? zipTrustedKeysCount : 0))
    ? Number(typeof zipTrustedKeysCount !== 'undefined' ? zipTrustedKeysCount : 0)
    : 0;
  const trustedZipKeysConfigured = Boolean(typeof zipTrustedKeysConfigured !== 'undefined'
    ? zipTrustedKeysConfigured
    : (trustedZipKeysCount > 0));
  const zipLimitValue = Number.isFinite(Number(typeof zipUploadLimitMb !== 'undefined' ? zipUploadLimitMb : 50))
    ? Number(typeof zipUploadLimitMb !== 'undefined' ? zipUploadLimitMb : 50)
    : 50;
%>

<div class="sections-page package-manager-page" data-floating-row-actions="true">
  <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <div>
      <h1 class="page-heading size-md text-start m-0">Package Manager</h1>
      <p class="text-muted mb-0 mt-1">Install and control package lifecycle from System Settings.</p>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
      <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">PACKAGE LIFECYCLE</span>
      <span class="badge bg-light text-dark border">Runtime: <%= activeMode.toUpperCase() %></span>
      <% if (typeof localPackageDevModeEnabled !== 'undefined' && localPackageDevModeEnabled) { %>
        <a href="/systemSettings/packages/local-sync" class="btn btn-outline-primary btn-sm">
          <i class="bi bi-arrow-repeat me-1"></i>Package Sync Locally
        </a>
      <% } %>
      <a href="/systemSettings" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Settings Home
      </a>
    </div>
  </div>
  <% if (storageRoot) { %>
    <div class="alert alert-info border-0 shadow-sm py-2 px-3 mb-3 small">
      <strong>Package Storage Root:</strong> <code><%= storageRoot %></code>
      <% if (storageRootSource) { %>
        <span class="ms-2 text-muted">(source: <%= storageRootSource %>)</span>
      <% } %>
    </div>
  <% } %>
  <% if (storageRootWarnings.length) { %>
    <div class="alert alert-warning border-0 shadow-sm py-2 px-3 mb-3 small">
      <div class="fw-semibold mb-1">Package Root Warnings</div>
      <ul class="mb-0 ps-3">
        <% storageRootWarnings.forEach((msg) => { %>
          <li><%= msg %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>
  <% if (startupWarnings.length) { %>
    <div class="alert alert-warning border-0 shadow-sm py-2 px-3 mb-3 small">
      <div class="fw-semibold mb-1">Startup Package Load Warnings (Registry State Unchanged)</div>
      <ul class="mb-0 ps-3">
        <% startupWarnings.slice(0, 8).forEach((msg) => { %>
          <li><%= msg %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <div id="pkgRestartRecommendedBanner" class="alert alert-warning border-0 shadow-sm py-2 px-3 mb-3 small d-none" role="alert">
    <div class="fw-semibold mb-1">Application restart recommended</div>
    <p class="mb-0" id="pkgRestartRecommendedText">
      Pause or remove updated registry and section data, but paused package routes may remain mounted until you restart the application.
    </p>
  </div>

  <div class="card border-0 shadow-sm mb-3 pkg-runtime-controls-card">
    <button
      type="button"
      class="pkg-runtime-controls-toggle card-header bg-white border-0 w-100 text-start"
      data-bs-toggle="collapse"
      data-bs-target="#pkgRuntimeControlsPanel"
      aria-expanded="false"
      aria-controls="pkgRuntimeControlsPanel"
    >
      <div class="d-flex align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3 min-w-0">
          <span class="pkg-runtime-controls-icon" aria-hidden="true">
            <i class="bi bi-cpu"></i>
          </span>
          <div class="min-w-0">
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <span class="fw-semibold">Runtime Controls</span>
              <% if (typeof inAppApplicationRestartAllowed !== 'undefined' && inAppApplicationRestartAllowed) { %>
                <span class="badge text-bg-success-subtle text-success-emphasis border border-success-subtle">In-app restart enabled</span>
              <% } else { %>
                <span class="badge text-bg-warning-subtle text-warning-emphasis border border-warning-subtle">In-app restart disabled</span>
              <% } %>
            </div>
            <div class="small text-muted mt-1">Application restart and per-package runtime reload guidance</div>
          </div>
        </div>
        <i class="bi bi-chevron-down pkg-runtime-controls-chevron flex-shrink-0" aria-hidden="true"></i>
      </div>
    </button>
    <div id="pkgRuntimeControlsPanel" class="collapse">
      <div class="card-body pt-0">
        <div class="row g-3">
          <div class="col-lg-7">
            <div class="pkg-runtime-panel pkg-runtime-panel-danger h-100">
              <div class="pkg-runtime-panel-head">
                <span class="pkg-runtime-panel-icon"><i class="bi bi-power"></i></span>
                <div>
                  <h6 class="mb-1">Restart application</h6>
                  <p class="small text-muted mb-0">Stops the Node process so your host starts a new one.</p>
                </div>
              </div>
              <ul class="pkg-runtime-panel-list small text-muted mb-3">
                <li>Required to fully apply <strong>Pause</strong> or <strong>Remove</strong> because package routes cannot be unmounted in-process.</li>
                <li>Expect brief downtime; active users may see errors until the new process is healthy.</li>
                <li>On multi-instance deployments, instances may restart one at a time.</li>
                <li>Not a substitute for deploying new code from git — use your normal deploy pipeline for releases.</li>
              </ul>
              <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                <% if (typeof inAppApplicationRestartAllowed !== 'undefined' && inAppApplicationRestartAllowed) { %>
                  <span class="small text-success mb-0">
                    <i class="bi bi-check-circle me-1"></i>
                    <code>ALLOW_IN_APP_APPLICATION_RESTART=true</code>
                  </span>
                <% } else { %>
                  <span class="small text-warning mb-0">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    Set <code>ALLOW_IN_APP_APPLICATION_RESTART=true</code> or restart from your hosting dashboard.
                  </span>
                <% } %>
                <button
                  type="button"
                  class="btn btn-outline-danger btn-sm"
                  id="pkgRestartApplicationBtn"
                  <% if (!(typeof inAppApplicationRestartAllowed !== 'undefined' && inAppApplicationRestartAllowed)) { %>disabled<% } %>>
                  <i class="bi bi-arrow-clockwise me-1"></i>Restart application
                </button>
              </div>
            </div>
          </div>
          <div class="col-lg-5">
            <div class="pkg-runtime-panel pkg-runtime-panel-info h-100">
              <div class="pkg-runtime-panel-head">
                <span class="pkg-runtime-panel-icon"><i class="bi bi-arrow-clockwise"></i></span>
                <div>
                  <h6 class="mb-1">Per-package Reload runtime</h6>
                  <p class="small text-muted mb-0">Available from each installed package row menu.</p>
                </div>
              </div>
              <ul class="pkg-runtime-panel-list small text-muted mb-0">
                <li>Re-mounts routes, views, assets, and query executors for <em>enabled</em> packages only.</li>
                <li>Refreshes navigation cache and syncs manifest declarations.</li>
                <li>Does <strong>not</strong> unmount paused packages or replace a full application restart.</li>
                <li>Use after a code deploy when package files changed on disk, or when startup recovery failed for one package.</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    .package-manager-page .pkg-runtime-controls-card {
      overflow: hidden;
    }
    .package-manager-page .pkg-runtime-controls-toggle {
      padding: 0.95rem 1rem;
      transition: background-color 0.15s ease;
    }
    .package-manager-page .pkg-runtime-controls-toggle:hover,
    .package-manager-page .pkg-runtime-controls-toggle:focus-visible {
      background: #f8f9fa !important;
    }
    .package-manager-page .pkg-runtime-controls-icon {
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 0.75rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: rgba(13, 110, 253, 0.1);
      color: #0d6efd;
      flex-shrink: 0;
      font-size: 1.1rem;
    }
    .package-manager-page .pkg-runtime-controls-chevron {
      transition: transform 0.2s ease;
      color: #6c757d;
    }
    .package-manager-page .pkg-runtime-controls-toggle[aria-expanded="true"] .pkg-runtime-controls-chevron {
      transform: rotate(180deg);
    }
    .package-manager-page .pkg-runtime-panel {
      border: 1px solid var(--bs-border-color);
      border-radius: 0.85rem;
      padding: 1rem;
      background: #fff;
      height: 100%;
    }
    .package-manager-page .pkg-runtime-panel-danger {
      border-color: rgba(220, 53, 69, 0.25);
      background: linear-gradient(180deg, rgba(220, 53, 69, 0.04), #fff 42%);
    }
    .package-manager-page .pkg-runtime-panel-info {
      border-color: rgba(13, 202, 240, 0.28);
      background: linear-gradient(180deg, rgba(13, 202, 240, 0.06), #fff 42%);
    }
    .package-manager-page .pkg-runtime-panel-head {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      margin-bottom: 0.85rem;
    }
    .package-manager-page .pkg-runtime-panel-icon {
      width: 2rem;
      height: 2rem;
      border-radius: 0.6rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: rgba(255, 255, 255, 0.85);
      border: 1px solid var(--bs-border-color);
      flex-shrink: 0;
    }
    .package-manager-page .pkg-runtime-panel-list {
      margin: 0;
      padding-left: 1.1rem;
    }
    .package-manager-page .pkg-runtime-panel-list li + li {
      margin-top: 0.45rem;
    }
  </style>

  <div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-white fw-bold small">Install / Enable Package</div>
    <div class="card-body p-3">
      <div class="row g-3">
        <div class="col-lg-3 col-md-6">
          <label class="form-label small fw-bold">Install Method</label>
          <select class="form-select" id="pkgInstallMethod">
            <option value="local">Local Discovered Manifest</option>
            <option value="path">Manual Manifest Path</option>
            <option value="json">Manifest JSON</option>
            <option value="zip">ZIP Upload (Signature Verified)</option>
          </select>
        </div>
        <div class="col-lg-3 col-md-6">
          <label class="form-label small fw-bold">Target Organization</label>
          <input type="hidden" id="pkgTargetOrgId" value="<%= activeOrg %>">
          <div class="input-group">
            <input
              type="text"
              id="pkgTargetOrgName"
              class="form-control size-md bg-white border-primary fw-bold"
              value="<%= activeOrgName %>"
              placeholder="Select organization..."
              readonly>
            <button type="button" class="btn btn-outline-primary" id="pkgPickTargetOrgBtn">
              <i class="bi bi-search"></i>
            </button>
            <button type="button" class="btn btn-outline-secondary" id="pkgClearTargetOrgBtn" title="Clear selected organization">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>
          <div class="small text-muted mt-1">Required when installing packages with org placeholders.</div>
        </div>
        <div class="col-lg-6 col-md-12">
          <div id="pkgInstallLocalPanel">
            <label class="form-label small fw-bold">Local Manifest</label>
            <select class="form-select" id="pkgLocalManifestPath">
              <option value="">Select local manifest</option>
              <% localOptions.forEach((row) => { %>
                <option value="<%= row.storedManifestPath %>"><%= row.packageId %> - <%= row.version %> (<%= row.storedManifestPath %>)</option>
              <% }) %>
            </select>
            <div class="small text-muted mt-1">
              Detected from
              <code><%= storageRoot || 'packages' %>/*/package.manifest.json</code>.
            </div>
          </div>
          <div id="pkgInstallPathPanel" class="d-none">
            <label class="form-label small fw-bold">Manifest Path</label>
            <input type="text" class="form-control" id="pkgManualManifestPath" placeholder="packages/pte/package.manifest.json or absolute path">
          </div>
          <div id="pkgInstallJsonPanel" class="d-none">
            <label class="form-label small fw-bold">Manifest JSON</label>
            <textarea class="form-control font-monospace small" id="pkgManifestJson" rows="8" placeholder='{"id":"my-package","name":"My Package","version":"1.0.0","mountPath":"/my-package"}'></textarea>
          </div>
          <div id="pkgInstallZipPanel" class="d-none">
            <label class="form-label small fw-bold">Package ZIP</label>
            <input type="file" class="form-control" id="pkgZipFile" accept=".zip,application/zip">
            <label class="form-label small fw-bold mt-2">Detached Signature (.sig)</label>
            <input type="file" class="form-control" id="pkgSigFile" accept=".sig,.txt,application/octet-stream,text/plain">
            <div class="small text-muted mt-1">Max upload size: <b><%= zipLimitValue %> MB</b> per file.</div>
            <% if (trustedZipKeysConfigured) { %>
              <div class="alert alert-success mt-2 mb-0 py-2 px-3 small">
                Trusted signature keys configured: <b><%= trustedZipKeysCount %></b>. ZIP upload will verify automatically.
              </div>
            <% } else { %>
              <div class="alert alert-warning mt-2 mb-0 py-2 px-3 small">
                No trusted signature key configured yet. Set <code>PACKAGE_INSTALL_ED25519_PUBLIC_KEYS</code> in core <code>.env</code>, then restart the app.
              </div>
            <% } %>
          </div>
        </div>
      </div>

      <% if (localWarnings.length) { %>
        <div class="alert alert-warning mt-3 mb-0 py-2 px-3">
          <div class="fw-semibold small mb-1">Some local manifests are invalid and cannot be selected:</div>
          <ul class="small mb-0 ps-3">
            <% localWarnings.slice(0, 8).forEach((row) => { %>
              <li><code><%= row.storedManifestPath || row.manifestPath %></code> - <%= row.error || 'Invalid manifest' %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>

      <div class="d-flex align-items-center gap-2 flex-wrap mt-3">
        <button type="button" class="btn btn-primary btn-filled" id="pkgInstallBtn">
          <i class="bi bi-box-arrow-in-down-right me-1"></i>Install / Enable
        </button>
        <button type="button" class="btn btn-outline-danger" id="pkgCleanupFailedBtn">
          <i class="bi bi-trash3 me-1"></i>Clean Failed Attempts
        </button>
        <button type="button" class="btn btn-outline-secondary" id="pkgRefreshSnapshotBtn">
          <i class="bi bi-arrow-clockwise me-1"></i>Refresh Snapshot
        </button>
      </div>
    </div>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-bold small d-flex align-items-center justify-content-between gap-2 flex-wrap">
      <span>Installed Packages</span>
      <span class="text-muted fw-normal"><%= installedRows.length %> item(s)</span>
    </div>
    <div class="card-body p-3">
      <div class="table-scroll-wrapper" data-floating-row-actions="true">
        <table class="table-responsive size-md" id="packageManagerTable">
          <thead>
            <tr>
              <th>Package</th>
              <th>Version</th>
              <th>Status</th>
              <th>Manifest</th>
              <th>Updated</th>
              <th>Warnings</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (!installedRows.length) { %>
              <tr><td colspan="7" class="text-center text-muted py-4">No package registry rows found.</td></tr>
            <% } %>
            <% installedRows.forEach((row) => { %>
              <tr data-package-id="<%= row.packageId %>">
                <td>
                  <div class="fw-semibold"><%= row.packageId %></div>
                  <div class="small text-muted"><%= row.name || '' %></div>
                  <% if (row.mountPath) { %><div class="small"><code><%= row.mountPath %></code></div><% } %>
                </td>
                <td><%= row.version || '-' %></td>
                <td>
                  <span class="badge <%= row.enabled ? 'bg-success-subtle text-success-emphasis border border-success-subtle' : 'bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle' %>">
                    <%= row.enabled ? 'Enabled' : 'Disabled' %>
                  </span>
                  <div class="small text-muted mt-1"><%= row.installStatus || '' %></div>
                </td>
                <td class="small">
                  <% if (row.manifestPath) { %><code><%= row.manifestPath %></code><% } else { %>-<% } %>
                </td>
                <td class="small"><%= row.updatedAt || row.installedAt || '-' %></td>
                <td class="small">
                  <% const warnings = [] %>
                  <% if (row.lastWarning) warnings.push(row.lastWarning) %>
                  <% if (row.lastError) warnings.push(row.lastError) %>
                  <% if (Array.isArray(row.warnings)) warnings.push(...row.warnings) %>
                  <% if (!warnings.length) { %>
                    <span class="text-muted">-</span>
                  <% } else { %>
                    <span class="text-warning"><%= warnings[0] %></span>
                  <% } %>
                </td>
                <td class="table-actions text-end pe-4">
                  <div class="row-actions-wrap">
                    <button
                      type="button"
                      class="btn btn-secondary btn-sm btn-row-actions-toggle"
                      data-row-actions-id="<%= row.packageId %>"
                      title="Row actions">
                      <i class="bi bi-three-dots-vertical"></i>
                    </button>
                    <div class="row-actions-menu d-none" data-row-actions-id="<%= row.packageId %>">
                      <button type="button" class="btn btn-outline-success btn-sm pkg-action-btn" data-action="enable" data-package-id="<%= row.packageId %>">
                        <i class="bi bi-play-circle me-2"></i>Enable
                      </button>
                      <button type="button" class="btn btn-outline-warning btn-sm pkg-action-btn" data-action="pause" data-package-id="<%= row.packageId %>">
                        <i class="bi bi-pause-circle me-2"></i>Pause
                      </button>
                      <button type="button" class="btn btn-outline-primary btn-sm pkg-action-btn" data-action="sync" data-package-id="<%= row.packageId %>">
                        <i class="bi bi-arrow-repeat me-2"></i>Sync Declarations
                      </button>
                      <button type="button" class="btn btn-outline-primary btn-sm pkg-action-btn" data-action="section-sync" data-package-id="<%= row.packageId %>">
                        <i class="bi bi-diagram-3 me-2"></i>Section Sync
                      </button>
                      <button type="button" class="btn btn-outline-info btn-sm pkg-action-btn" data-action="reload-runtime" data-package-id="<%= row.packageId %>">
                        <i class="bi bi-arrow-clockwise me-2"></i>Reload runtime
                      </button>
                      <button type="button" class="btn btn-outline-secondary btn-sm pkg-action-btn" data-action="preview-remove" data-package-id="<%= row.packageId %>">
                        <i class="bi bi-exclamation-circle me-2"></i>Impact Preview
                      </button>
                      <button type="button" class="btn btn-outline-danger btn-sm pkg-action-btn" data-action="remove" data-package-id="<%= row.packageId %>">
                        <i class="bi bi-trash me-2"></i>Remove
                      </button>
                    </div>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="card border-0 shadow-sm mt-3">
    <div class="card-header bg-white fw-bold small d-flex align-items-center justify-content-between">
      <span>Operation Output</span>
      <button type="button" class="btn btn-outline-secondary btn-sm" id="pkgClearOutputBtn">Clear</button>
    </div>
    <div class="card-body">
      <pre id="pkgOutput" class="small bg-dark text-success p-3 rounded mb-0" style="max-height: 320px; overflow:auto;">Ready.</pre>
    </div>
  </div>

  <div class="card border-0 shadow-sm mt-3">
    <div class="card-header bg-white fw-bold small d-flex align-items-center justify-content-between">
      <span>Recent Lifecycle Transactions</span>
      <span class="text-muted fw-normal" id="pkgTxnLabel">Select a package row</span>
    </div>
    <div class="card-body p-3">
      <div class="table-scroll-wrapper">
        <table class="table-responsive size-md mb-0" id="pkgTransactionTable">
          <thead>
            <tr>
              <th>Transaction</th>
              <th>Action</th>
              <th>Status</th>
              <th>Phase</th>
              <th>Finished</th>
            </tr>
          </thead>
          <tbody>
            <tr><td colspan="5" class="text-center text-muted py-3">No package selected.</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <input type="hidden" id="pkgActionStateId" value="<%= actionStateValue %>">
  <input type="hidden" id="pkgPackageRootDir" value="<%= packageRoot %>">
</div>

<div class="modal fade" id="pkgSectionSyncModal" tabindex="-1" aria-labelledby="pkgSectionSyncModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content pkg-section-sync-modal">
      <div class="modal-header">
        <h5 class="modal-title" id="pkgSectionSyncModalLabel">Section Sync</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="pkg-section-sync-summary mb-3" id="pkgSectionSyncSummary"></div>
        <div class="small text-muted mb-3" id="pkgSectionSyncMeta">Compare runtime section records with the package manifest.</div>
        <div class="form-check mb-4">
          <input class="form-check-input" type="checkbox" id="pkgSectionSyncIncludeTopology" checked>
          <label class="form-check-label" for="pkgSectionSyncIncludeTopology">Include topology fields (<code>subsections</code>, <code>related</code>) when applying or restoring changes</label>
        </div>

        <section class="pkg-section-sync-group mb-4">
          <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
            <div>
              <h6 class="mb-0">Package sections</h6>
              <div class="small text-muted">Manifest-declared sections for this package. App-only sections are not listed.</div>
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <div class="btn-group btn-group-sm" role="group" aria-label="Package section filter">
                <input type="radio" class="btn-check" name="pkgSectionSyncFilter" id="pkgSectionSyncFilterChanges" value="changes" checked>
                <label class="btn btn-outline-secondary" for="pkgSectionSyncFilterChanges">Changes only</label>
                <input type="radio" class="btn-check" name="pkgSectionSyncFilter" id="pkgSectionSyncFilterAll" value="all">
                <label class="btn btn-outline-secondary" for="pkgSectionSyncFilterAll">All manifest</label>
              </div>
              <div class="form-check m-0">
                <input class="form-check-input" type="checkbox" id="pkgSectionSyncSelectAll" aria-label="Select all visible package sections">
                <label class="form-check-label small" for="pkgSectionSyncSelectAll">Select visible</label>
              </div>
            </div>
          </div>
          <div id="pkgSectionSyncPackageList" class="pkg-section-sync-list">
            <div class="text-center text-muted py-4">Loading preview...</div>
          </div>
        </section>
      </div>
      <div class="modal-footer flex-wrap gap-2">
        <button type="button" class="btn btn-outline-secondary" id="pkgSectionSyncDownloadBtn">
          <i class="bi bi-download me-1"></i>Download JSON
        </button>
        <button type="button" class="btn btn-outline-secondary" id="pkgSectionSyncUploadBtn">
          <i class="bi bi-upload me-1"></i>Upload JSON
        </button>
        <input type="file" id="pkgSectionSyncUploadInput" class="d-none" accept="application/json,.json">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
        <button type="button" class="btn btn-outline-primary" id="pkgSectionSyncApplyManifestBtn">
          <i class="bi bi-box-arrow-in-down me-1"></i>Apply Manifest → App
        </button>
        <button type="button" class="btn btn-outline-dark" id="pkgSectionSyncApplyRuntimeBtn">
          <i class="bi bi-box-arrow-up me-1"></i>Apply App → Manifest
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .pkg-section-sync-modal .pkg-section-sync-summary {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .pkg-section-sync-modal .pkg-section-sync-stat {
    border: 1px solid var(--bs-border-color);
    border-radius: 0.5rem;
    padding: 0.45rem 0.75rem;
    background: var(--bs-light);
    min-width: 7rem;
  }
  .pkg-section-sync-modal .pkg-section-sync-stat strong {
    display: block;
    font-size: 1.1rem;
    line-height: 1.2;
  }
  .pkg-section-sync-modal .pkg-section-sync-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .pkg-section-sync-modal .pkg-section-sync-card {
    border: 1px solid var(--bs-border-color);
    border-radius: 0.65rem;
    background: #fff;
    overflow: hidden;
  }
  .pkg-section-sync-modal .pkg-section-sync-card.is-match {
    border-color: rgba(25, 135, 84, 0.35);
  }
  .pkg-section-sync-modal .pkg-section-sync-card.is-drift {
    border-color: rgba(255, 193, 7, 0.55);
  }
  .pkg-section-sync-modal .pkg-section-sync-card-head {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
  }
  .pkg-section-sync-modal .pkg-section-sync-card-title {
    min-width: 0;
    flex: 1 1 auto;
  }
  .pkg-section-sync-modal .pkg-section-sync-card-title strong {
    word-break: break-word;
  }
  .pkg-section-sync-modal .pkg-section-sync-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding: 0 1rem 0.85rem;
  }
  .pkg-section-sync-modal .pkg-section-sync-chip {
    font-size: 0.75rem;
    border-radius: 999px;
    padding: 0.15rem 0.55rem;
    background: var(--bs-light);
    border: 1px solid var(--bs-border-color);
  }
  .pkg-section-sync-modal .pkg-section-sync-details {
    display: none;
    border-top: 1px solid var(--bs-border-color);
    background: #f8f9fa;
    padding: 0.75rem 1rem 1rem;
  }
  .pkg-section-sync-modal .pkg-section-sync-card.is-open .pkg-section-sync-details {
    display: block;
  }
  .pkg-section-sync-modal .pkg-section-sync-diff-table th,
  .pkg-section-sync-modal .pkg-section-sync-diff-table td {
    vertical-align: top;
    font-size: 0.82rem;
  }
  .pkg-section-sync-modal .pkg-section-sync-diff-table code {
    white-space: pre-wrap;
    word-break: break-word;
  }
  .pkg-section-sync-modal .pkg-section-sync-diff-row.is-changed td {
    background: rgba(255, 193, 7, 0.12);
  }
  .pkg-section-sync-modal .pkg-section-sync-empty {
    border: 1px dashed var(--bs-border-color);
    border-radius: 0.65rem;
    padding: 1.25rem;
    text-align: center;
    color: var(--bs-secondary-color);
    background: #fff;
  }
</style>
<%- include('../partials/modal_GenericPicker', { user: locals?.user }) %>

<script>
(() => {
  const actionStateId = document.getElementById('pkgActionStateId')?.value || '';
  const outputEl = document.getElementById('pkgOutput');
  const installMethodEl = document.getElementById('pkgInstallMethod');
  const targetOrgEl = document.getElementById('pkgTargetOrgId');
  const targetOrgNameEl = document.getElementById('pkgTargetOrgName');
  const targetOrgPickBtn = document.getElementById('pkgPickTargetOrgBtn');
  const targetOrgClearBtn = document.getElementById('pkgClearTargetOrgBtn');
  const installBtn = document.getElementById('pkgInstallBtn');
  const cleanupFailedBtn = document.getElementById('pkgCleanupFailedBtn');
  const tableEl = document.getElementById('packageManagerTable');
  const transactionTableEl = document.getElementById('pkgTransactionTable');
  const transactionLabelEl = document.getElementById('pkgTxnLabel');

  const localPanel = document.getElementById('pkgInstallLocalPanel');
  const pathPanel = document.getElementById('pkgInstallPathPanel');
  const jsonPanel = document.getElementById('pkgInstallJsonPanel');
  const zipPanel = document.getElementById('pkgInstallZipPanel');
  const localManifestEl = document.getElementById('pkgLocalManifestPath');
  const packageRootInput = document.getElementById('pkgPackageRootDir');

  const actionMap = {
    enable: { endpoint: (id) => `/systemSettings/packages/${encodeURIComponent(id)}/enable`, label: 'Enable' },
    pause: { endpoint: (id) => `/systemSettings/packages/${encodeURIComponent(id)}/pause`, label: 'Pause', dangerous: true },
    'reload-runtime': { endpoint: (id) => `/systemSettings/packages/${encodeURIComponent(id)}/reload-runtime`, label: 'Reload runtime' },
    'preview-remove': { endpoint: (id) => `/systemSettings/packages/${encodeURIComponent(id)}/uninstall-preview`, label: 'Impact Preview', dangerous: true },
    remove: { endpoint: (id) => `/systemSettings/packages/${encodeURIComponent(id)}/remove`, label: 'Remove', dangerous: true },
    sync: { endpoint: (id) => `/systemSettings/packages/${encodeURIComponent(id)}/sync`, label: 'Sync Declarations' },
    'section-sync': { label: 'Section Sync' }
  };

  const restartRecommendedBanner = document.getElementById('pkgRestartRecommendedBanner');
  const restartRecommendedText = document.getElementById('pkgRestartRecommendedText');
  const restartApplicationBtn = document.getElementById('pkgRestartApplicationBtn');
  const sectionSyncModalEl = document.getElementById('pkgSectionSyncModal');
  const sectionSyncPackageListEl = document.getElementById('pkgSectionSyncPackageList');
  const sectionSyncSummaryEl = document.getElementById('pkgSectionSyncSummary');
  const sectionSyncMetaEl = document.getElementById('pkgSectionSyncMeta');
  const sectionSyncSelectAllEl = document.getElementById('pkgSectionSyncSelectAll');
  const sectionSyncFilterAllEl = document.getElementById('pkgSectionSyncFilterAll');
  const sectionSyncFilterChangesEl = document.getElementById('pkgSectionSyncFilterChanges');
  const sectionSyncIncludeTopologyEl = document.getElementById('pkgSectionSyncIncludeTopology');
  const sectionSyncApplyManifestBtn = document.getElementById('pkgSectionSyncApplyManifestBtn');
  const sectionSyncApplyRuntimeBtn = document.getElementById('pkgSectionSyncApplyRuntimeBtn');
  const sectionSyncDownloadBtn = document.getElementById('pkgSectionSyncDownloadBtn');
  const sectionSyncUploadBtn = document.getElementById('pkgSectionSyncUploadBtn');
  const sectionSyncUploadInput = document.getElementById('pkgSectionSyncUploadInput');
  let sectionSyncState = { packageId: '', preview: null, filter: 'changes' };

  const SECTION_SYNC_STATUS_META = {
    match: { label: 'In sync', badge: 'text-bg-success' },
    drift: { label: 'Changed', badge: 'text-bg-warning' },
    'manifest-only': { label: 'Manifest only', badge: 'text-bg-info' },
    'runtime-only': { label: 'App only', badge: 'text-bg-secondary' }
  };

  const SECTION_SYNC_COMPARE_FIELDS = [
    'category',
    'description',
    'active',
    'trackState',
    'minimumAccessRequirement',
    'dashboardDisplay',
    'mainDashboardDisplay',
    'navigatorSection',
    'homeURL',
    'inactiveMessage',
    'message',
    'operations',
    'subsections',
    'related'
  ];

  function escapeHtml(value = '') {
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function formatSectionSyncValue(value) {
    if (value === undefined || value === null || value === '') return '—';
    if (typeof value === 'boolean') return value ? 'true' : 'false';
    if (Array.isArray(value)) {
      if (!value.length) return '[]';
      return JSON.stringify(value);
    }
    if (typeof value === 'object') return JSON.stringify(value);
    return String(value);
  }

  function sectionSyncStatusMeta(status = '') {
    return SECTION_SYNC_STATUS_META[status] || { label: status || 'Unknown', badge: 'text-bg-light border' };
  }

  function isActionableSectionChange(row = {}) {
    return row.status === 'drift' || row.status === 'manifest-only';
  }

  function getPackageSectionRows(preview = {}) {
    const rows = Array.isArray(preview?.packageSections)
      ? preview.packageSections
      : (Array.isArray(preview?.sections) ? preview.sections : []);
    if (sectionSyncState.filter === 'changes') {
      return rows.filter((row) => isActionableSectionChange(row));
    }
    return rows;
  }

  function buildSectionSyncDiffRows(row = {}) {
    const drifted = new Set(Array.isArray(row.driftedFields) ? row.driftedFields : []);
    const fields = new Set([
      ...SECTION_SYNC_COMPARE_FIELDS,
      ...drifted,
      ...Object.keys(row.runtime || {}),
      ...Object.keys(row.manifest || {})
    ]);
    return Array.from(fields).map((field) => ({
      field,
      runtime: formatSectionSyncValue(row.runtime?.[field]),
      manifest: formatSectionSyncValue(row.manifest?.[field]),
      changed: drifted.has(field)
    }));
  }

  function renderSectionSyncStatusBadge(status = '') {
    const meta = sectionSyncStatusMeta(status);
    return `<span class="badge ${meta.badge}">${escapeHtml(meta.label)}</span>`;
  }

  function renderPackageSectionCard(row = {}) {
    const drifted = Array.isArray(row.driftedFields) ? row.driftedFields : [];
    const checked = row.status === 'drift' || row.status === 'manifest-only' ? 'checked' : '';
    const cardClass = row.status === 'match' ? 'is-match' : (row.status === 'drift' ? 'is-drift' : '');
    const chips = drifted.length
      ? drifted.map((field) => `<span class="pkg-section-sync-chip">${escapeHtml(field)}</span>`).join('')
      : '<span class="pkg-section-sync-chip text-muted">No field differences</span>';
    const diffRows = buildSectionSyncDiffRows(row).map((entry) => `
      <tr class="pkg-section-sync-diff-row${entry.changed ? ' is-changed' : ''}">
        <th scope="row">${escapeHtml(entry.field)}</th>
        <td><code>${escapeHtml(entry.runtime)}</code></td>
        <td><code>${escapeHtml(entry.manifest)}</code></td>
      </tr>
    `).join('');
    return `
      <article class="pkg-section-sync-card ${cardClass}" data-section-name="${escapeHtml(row.name)}" data-status="${escapeHtml(row.status || '')}">
        <div class="pkg-section-sync-card-head">
          <input type="checkbox" class="form-check-input mt-1 pkg-section-sync-row" data-section-name="${escapeHtml(row.name)}" ${checked} aria-label="Select ${escapeHtml(row.name)}">
          <div class="pkg-section-sync-card-title">
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <strong>${escapeHtml(row.name)}</strong>
              ${renderSectionSyncStatusBadge(row.status)}
            </div>
            <div class="small text-muted mt-1">${escapeHtml(row.id || 'No id')} · compare app runtime with manifest</div>
          </div>
          <button type="button" class="btn btn-sm btn-outline-secondary pkg-section-sync-toggle" data-section-name="${escapeHtml(row.name)}">Details</button>
        </div>
        <div class="pkg-section-sync-chips">${chips}</div>
        <div class="pkg-section-sync-details">
          <div class="table-responsive">
            <table class="table table-sm table-bordered mb-0 pkg-section-sync-diff-table">
              <thead class="table-light">
                <tr>
                  <th style="width:12rem;">Field</th>
                  <th>App (runtime)</th>
                  <th>Manifest</th>
                </tr>
              </thead>
              <tbody>${diffRows}</tbody>
            </table>
          </div>
        </div>
      </article>
    `;
  }

  function renderSectionSyncSummary(preview = {}) {
    if (!sectionSyncSummaryEl) return;
    const summary = preview?.summary || {};
    const stats = [
      { label: 'Manifest sections', value: summary.packageTotal ?? summary.total ?? 0 },
      { label: 'In sync', value: summary.packageMatch ?? summary.match ?? 0 },
      { label: 'Changed', value: summary.packageDrift ?? summary.drift ?? 0 },
      { label: 'Manifest only', value: summary.packageManifestOnly ?? summary.manifestOnly ?? 0 }
    ];
    sectionSyncSummaryEl.innerHTML = stats.map((stat) => `
      <div class="pkg-section-sync-stat">
        <span class="small text-muted">${escapeHtml(stat.label)}</span>
        <strong>${escapeHtml(stat.value)}</strong>
      </div>
    `).join('');
  }

  function renderSectionSyncPreview(preview = {}) {
    const packageRows = getPackageSectionRows(preview);

    if (sectionSyncPackageListEl) {
      if (!packageRows.length) {
        const emptyLabel = sectionSyncState.filter === 'changes'
          ? 'No section changes need action.'
          : 'No manifest sections found for this package.';
        sectionSyncPackageListEl.innerHTML = `<div class="pkg-section-sync-empty">${escapeHtml(emptyLabel)}</div>`;
      } else {
        sectionSyncPackageListEl.innerHTML = packageRows.map((row) => renderPackageSectionCard(row)).join('');
      }
    }

    if (sectionSyncSelectAllEl) sectionSyncSelectAllEl.checked = false;
  }

  function getSelectedSectionSyncNames() {
    return Array.from(document.querySelectorAll('.pkg-section-sync-row:checked'))
      .map((input) => String(input.dataset.sectionName || '').trim())
      .filter(Boolean);
  }

  function getSectionSyncModal() {
    const modalEl = sectionSyncModalEl || document.getElementById('pkgSectionSyncModal');
    if (!modalEl || !window.bootstrap?.Modal) return null;
    return window.bootstrap.Modal.getOrCreateInstance(modalEl);
  }

  async function openSectionSyncModal(packageId) {
    const sectionSyncModal = getSectionSyncModal();
    if (!sectionSyncModal) throw new Error('Section Sync modal is unavailable. Refresh and try again.');
    sectionSyncState = { packageId, preview: null, filter: sectionSyncState.filter || 'changes' };
    if (sectionSyncMetaEl) sectionSyncMetaEl.textContent = `Loading section sync preview for ${packageId}...`;
    if (sectionSyncPackageListEl) {
      sectionSyncPackageListEl.innerHTML = '<div class="text-center text-muted py-4">Loading preview...</div>';
    }
    if (sectionSyncSummaryEl) sectionSyncSummaryEl.innerHTML = '';
    sectionSyncModal.show();
    const result = await runWithWaiting('Section Sync Preview', async () => fetchJson(
      `/systemSettings/packages/${encodeURIComponent(packageId)}/section-sync/preview`,
      {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded',
          'Accept': 'application/json',
          'X-AJAX-Request': 'true'
        },
        body: new URLSearchParams({ actionStateId }).toString()
      }
    ));
    const preview = result?.report?.preview || {};
    sectionSyncState = { packageId, preview, filter: sectionSyncState.filter || 'changes' };
    if (sectionSyncMetaEl) {
      const summary = preview.summary || {};
      const hiddenAppOnly = Number(summary.runtimeOnlyHidden ?? summary.packageRuntimeOnly ?? summary.runtimeOnly ?? 0);
      const hiddenNote = hiddenAppOnly > 0
        ? ` · ${hiddenAppOnly} app-only section${hiddenAppOnly === 1 ? '' : 's'} not listed`
        : '';
      sectionSyncMetaEl.textContent = `Package ${preview.packageName || packageId} · manifest ${result?.report?.manifestPath || 'n/a'} · ${summary.packageDrift ?? summary.drift ?? 0} changed / ${summary.packageTotal ?? summary.total ?? 0} manifest sections${hiddenNote}`;
    }
    renderSectionSyncSummary(preview);
    renderSectionSyncPreview(preview);
    setOutput('Section Sync Preview', result.report || result);
    return result;
  }

  async function applySectionSync(direction) {
    const packageId = sectionSyncState.packageId;
    if (!packageId) throw new Error('No package selected for section sync.');
    const sectionNames = getSelectedSectionSyncNames();
    if (!sectionNames.length) throw new Error('Select at least one section.');
    const includeTopology = sectionSyncIncludeTopologyEl?.checked !== false;
    const endpoint = direction === 'manifest'
      ? `/systemSettings/packages/${encodeURIComponent(packageId)}/section-sync/apply-manifest`
      : `/systemSettings/packages/${encodeURIComponent(packageId)}/section-sync/apply-runtime`;
    const label = direction === 'manifest' ? 'Apply Manifest → App' : 'Apply App → Manifest';
    const confirmed = await showModal({
      title: label,
      icon: 'warning',
      message: `Apply ${sectionNames.length} selected section(s) ${direction === 'manifest' ? 'from manifest into the app database' : 'from the app database into the manifest file'}?`,
      buttons: [
        { text: 'Cancel', class: 'btn-secondary' },
        { text: label, class: 'btn-primary' }
      ]
    });
    if (confirmed !== label) return null;
    await requireAdminVerification();
    const result = await runWithWaiting(label, async () => fetchJson(endpoint, {
      method: 'POST',
      credentials: 'same-origin',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'X-AJAX-Request': 'true'
      },
      body: JSON.stringify({
        actionStateId,
        sectionNames,
        includeTopology
      })
    }));
    setOutput(label, result.report || result);
    await openSectionSyncModal(packageId);
    await showSuccess(result.message || `${label} completed.`);
    return result;
  }

  function downloadJsonFile(payload, filename = 'section-sync-backup.json') {
    const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = filename;
    document.body.appendChild(link);
    link.click();
    link.remove();
    URL.revokeObjectURL(url);
  }

  async function downloadSectionSyncBackup() {
    const packageId = sectionSyncState.packageId;
    if (!packageId) throw new Error('No package selected for section sync.');
    await requireAdminVerification();
    const result = await runWithWaiting('Download Section Sync Backup', async () => fetchJson(
      `/systemSettings/packages/${encodeURIComponent(packageId)}/section-sync/export`,
      {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded',
          'Accept': 'application/json',
          'X-AJAX-Request': 'true'
        },
        body: new URLSearchParams({ actionStateId }).toString()
      }
    ));
    const backup = result?.report?.backup;
    if (!backup || typeof backup !== 'object') {
      throw new Error('Backup export did not return JSON data.');
    }
    const filename = String(result?.report?.filename || `${packageId}-section-sync-backup.json`).trim();
    downloadJsonFile(backup, filename);
    setOutput('Section Sync Backup Export', result.report || result);
    await showSuccess(result.message || 'Section sync backup downloaded.');
    return result;
  }

  async function restoreSectionSyncBackup(file) {
    const packageId = sectionSyncState.packageId;
    if (!packageId) throw new Error('No package selected for section sync.');
    if (!file) throw new Error('Select a JSON backup file to upload.');
    const includeTopology = sectionSyncIncludeTopologyEl?.checked !== false;
    const confirmed = await showModal({
      title: 'Restore Section Sync Backup',
      icon: 'warning',
      message: `Restore section sync backup from "${file.name}"? This will overwrite runtime sections and manifest sections for package "${packageId}".`,
      buttons: [
        { text: 'Cancel', class: 'btn-secondary' },
        { text: 'Restore Backup', class: 'btn-danger' }
      ]
    });
    if (confirmed !== 'Restore Backup') return null;
    await requireAdminVerification();
    const formData = new FormData();
    formData.set('actionStateId', actionStateId);
    formData.set('backupFile', file);
    formData.set('includeTopology', includeTopology ? 'true' : 'false');
    const result = await runWithWaiting('Restore Section Sync Backup', async () => fetchJson(
      `/systemSettings/packages/${encodeURIComponent(packageId)}/section-sync/restore`,
      {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
          'Accept': 'application/json',
          'X-AJAX-Request': 'true'
        },
        body: formData
      }
    ));
    setOutput('Section Sync Backup Restore', result.report || result);
    await openSectionSyncModal(packageId);
    await showSuccess(result.message || 'Section sync backup restored.');
    return result;
  }

  sectionSyncSelectAllEl?.addEventListener('change', () => {
    const checked = sectionSyncSelectAllEl.checked;
    document.querySelectorAll('#pkgSectionSyncPackageList .pkg-section-sync-row').forEach((input) => {
      input.checked = checked;
    });
  });
  sectionSyncFilterAllEl?.addEventListener('change', () => {
    if (!sectionSyncFilterAllEl.checked) return;
    sectionSyncState.filter = 'all';
    renderSectionSyncPreview(sectionSyncState.preview || {});
  });
  sectionSyncFilterChangesEl?.addEventListener('change', () => {
    if (!sectionSyncFilterChangesEl.checked) return;
    sectionSyncState.filter = 'changes';
    renderSectionSyncPreview(sectionSyncState.preview || {});
  });
  sectionSyncPackageListEl?.addEventListener('click', (event) => {
    const toggleBtn = event.target.closest('.pkg-section-sync-toggle');
    if (!toggleBtn) return;
    const card = toggleBtn.closest('.pkg-section-sync-card');
    if (!card) return;
    const isOpen = card.classList.toggle('is-open');
    toggleBtn.textContent = isOpen ? 'Hide' : 'Details';
  });
  sectionSyncDownloadBtn?.addEventListener('click', async () => {
    try {
      await downloadSectionSyncBackup();
    } catch (error) {
      await showError(error.message || 'Download JSON backup failed.');
    }
  });
  sectionSyncUploadBtn?.addEventListener('click', () => {
    if (sectionSyncUploadInput) sectionSyncUploadInput.click();
  });
  sectionSyncUploadInput?.addEventListener('change', async () => {
    const file = sectionSyncUploadInput.files?.[0] || null;
    sectionSyncUploadInput.value = '';
    if (!file) return;
    try {
      await restoreSectionSyncBackup(file);
    } catch (error) {
      await showError(error.message || 'Upload JSON backup failed.');
    }
  });
  sectionSyncApplyManifestBtn?.addEventListener('click', async () => {
    try {
      await applySectionSync('manifest');
    } catch (error) {
      await showError(error.message || 'Apply Manifest → App failed.');
    }
  });
  sectionSyncApplyRuntimeBtn?.addEventListener('click', async () => {
    try {
      await applySectionSync('runtime');
    } catch (error) {
      await showError(error.message || 'Apply App → Manifest failed.');
    }
  });

  function showRestartRecommendedBanner(message) {
    if (!restartRecommendedBanner) return;
    if (restartRecommendedText && message) restartRecommendedText.textContent = message;
    restartRecommendedBanner.classList.remove('d-none');
  }

  function setOutput(title, payload) {
    const stamp = new Date().toISOString();
    outputEl.textContent = `[${stamp}] ${title}\n${JSON.stringify(payload || {}, null, 2)}`;
  }

  function setTargetOrgSelection(orgId, orgName = '') {
    const normalizedOrgId = String(orgId || '').trim();
    if (targetOrgEl) targetOrgEl.value = normalizedOrgId;
    if (targetOrgNameEl) {
      const fallbackName = normalizedOrgId ? `Organization #${normalizedOrgId}` : 'Select organization...';
      targetOrgNameEl.value = String(orgName || fallbackName).trim();
    }
  }

  function showInstallPanel(method) {
    localPanel.classList.toggle('d-none', method !== 'local');
    pathPanel.classList.toggle('d-none', method !== 'path');
    jsonPanel.classList.toggle('d-none', method !== 'json');
    zipPanel.classList.toggle('d-none', method !== 'zip');
  }

  async function showModal(options) {
    if (typeof window.showMessageModal === 'function') return window.showMessageModal(options);
    return options?.buttons?.[options.buttons.length - 1]?.text || 'OK';
  }

  async function requireAdminVerification() {
    if (typeof window.requestProtectedAction !== 'function') {
      throw new Error('Admin verification modal is unavailable. Refresh and try again.');
    }
    await window.requestProtectedAction();
  }

  async function fetchJson(url, options = {}) {
    const response = await fetch(url, options);
    const text = await response.text();
    let payload = {};
    try {
      payload = text ? JSON.parse(text) : {};
    } catch (_) {
      payload = { status: 'error', message: text || `Invalid response (${response.status})` };
    }
    if (!response.ok || payload.status === 'error') {
      const message = payload.message || `Request failed (${response.status}).`;
      const error = new Error(message);
      if (response.status === 403 && payload.status === 'admin_required') {
        error.code = 'ADMIN_REQUIRED';
      }
      if (payload?.code) error.code = payload.code;
      error.payload = payload;
      throw error;
    }
    return payload;
  }

  function resolvePackageRootFromLocalManifestPath(localManifestPath) {
    const rawPath = String(localManifestPath || '').replace(/\\/g, '/').trim();
    const manifestMarker = '/package.manifest.json';
    const markerIndex = rawPath.lastIndexOf(manifestMarker);
    if (markerIndex <= 0) return '';
    const packageDirectory = rawPath.slice(0, markerIndex);
    const separatorIndex = packageDirectory.lastIndexOf('/');
    if (separatorIndex < 0) return packageDirectory;
    return packageDirectory.slice(0, separatorIndex);
  }

  function syncPackageRootFromLocalSelection() {
    if (!packageRootInput || !localManifestEl) return;
    const selectedManifest = localManifestEl.value || '';
    const resolvedRoot = resolvePackageRootFromLocalManifestPath(selectedManifest);
    if (resolvedRoot) {
      packageRootInput.value = resolvedRoot;
    }
  }

  function toBoolean(value) {
    if (typeof value === 'boolean') return value;
    if (typeof value === 'number') return value === 1;
    if (typeof value === 'string') {
      const normalized = value.trim().toLowerCase();
      return normalized === '1' || normalized === 'true' || normalized === 'yes' || normalized === 'on';
    }
    return false;
  }

  function toText(value) {
    return String(value || '').trim();
  }

  function coerceInstallPreviewPayload(payload = {}) {
    if (!payload || typeof payload !== 'object') return {};
    if (payload?.report && typeof payload.report === 'object') return payload.report;
    if (payload?.result && typeof payload.result === 'object') return payload.result;
    if (payload?.data && typeof payload.data === 'object') return payload.data;
    if (payload?.payload && typeof payload.payload === 'object') return payload.payload;
    return payload;
  }

  function getInstallPreviewAckToken(preview = {}) {
    return toText(
      preview?.ackToken
      || preview?.upgradeAckToken
      || preview?.ack_token
      || preview?.upgradeAckTokenPreview
      || preview?.previewAckToken
    );
  }

  function previewIsUpgrade(preview = {}) {
    return toBoolean(preview?.isUpgrade)
      || toBoolean(preview?.isUpgraded)
      || toBoolean(preview?.upgradeRequired);
  }

  function previewRequiresAcknowledgement(preview = {}) {
    const findingCount = Number(Array.isArray(preview?.blockingFindings) ? preview.blockingFindings.length : 0)
      + Number(Array.isArray(preview?.warningFindings) ? preview.warningFindings.length : 0);
    return findingCount > 0
      || toBoolean(preview?.requiresAcknowledgement)
      || toBoolean(preview?.requires_acknowledgement)
      || toBoolean(preview?.requiresAcknowledgment)
      || toBoolean(preview?.requires_acknowledgment)
      || toBoolean(preview?.requireAcknowledgement)
      || toBoolean(preview?.require_acknowledgement)
      || toBoolean(preview?.upgradePreflightRequiredAck)
      || toBoolean(preview?.upgradePreflightRequiredAckToken)
      || toBoolean(preview?.needsUpgradeAcknowledgement)
      || toBoolean(preview?.needsAcknowledgement);
  }

  function renderTransactions(packageId, rows = []) {
    if (!transactionTableEl) return;
    const tbody = transactionTableEl.querySelector('tbody');
    if (!tbody) return;
    const list = Array.isArray(rows) ? rows : [];
    if (!list.length) {
      tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-3">No transactions.</td></tr>';
      return;
    }
    tbody.innerHTML = list.slice(0, 20).map((row) => {
      const txId = String(row?.id || row?.transactionId || '');
      const action = String(row?.action || '-');
      const status = String(row?.status || '-');
      const phase = String(row?.phase || '-');
      const finishedAt = String(row?.finishedAt || row?.audit?.lastUpdateDateTime || '-');
      const txLabel = txId ? `<code>${txId}</code>` : '-';
      return `<tr><td>${txLabel}</td><td>${action}</td><td>${status}</td><td>${phase}</td><td class="small">${finishedAt}</td></tr>`;
    }).join('');
    if (transactionLabelEl) {
      transactionLabelEl.textContent = `${packageId} (${list.length})`;
    }
  }

  async function loadTransactions(packageId) {
    if (!packageId) return;
    try {
      const payload = await fetchJson(`/systemSettings/packages/${encodeURIComponent(packageId)}/transactions?limit=20`, {
        method: 'GET',
        credentials: 'same-origin',
        headers: {
          'Accept': 'application/json',
          'X-AJAX-Request': 'true'
        }
      });
      renderTransactions(packageId, payload.rows || []);
    } catch (error) {
      renderTransactions(packageId, []);
      setOutput('Transaction Load Failed', { packageId, message: error.message || 'Unknown error' });
    }
  }

  function clampProgress(value) {
    const numeric = Number(value);
    if (!Number.isFinite(numeric)) return null;
    return Math.max(0, Math.min(100, Math.round(numeric)));
  }

  function waitMs(ms) {
    return new Promise((resolve) => setTimeout(resolve, Math.max(0, Number(ms) || 0)));
  }

  function getInstallProgressSteps(method) {
    const normalizedMethod = String(method || '').trim().toLowerCase();
    const isZip = normalizedMethod === 'zip';
    return [
      {
        progress: 6,
        note: 'Validating request and access permissions...',
        operation: 'Validation'
      },
      {
        progress: 20,
        note: isZip ? 'Preparing ZIP and signature payload...' : 'Preparing install request payload...',
        operation: 'Preparation'
      },
      {
        progress: isZip ? 38 : 34,
        note: isZip ? 'Uploading package artifacts...' : 'Submitting package install request...',
        operation: isZip ? 'Upload' : 'Submission'
      },
      {
        progress: 58,
        note: 'Verifying manifest and security constraints...',
        operation: 'Verification'
      },
      {
        progress: 78,
        note: 'Applying package declarations and data...',
        operation: 'Apply'
      },
      {
        progress: 92,
        note: 'Finalizing installation...',
        operation: 'Finalize'
      }
    ];
  }

  function buildLoadingState(title, fallbackNote, fallbackOperation, step = null) {
    const state = {
      title: String(title || '').trim() || 'Please wait',
      note: String(fallbackNote || '').trim() || 'Processing your request...',
      operation: String(fallbackOperation || '').trim(),
      progress: null
    };
    if (!step || typeof step !== 'object') return state;
    if (typeof step.note === 'string' && step.note.trim()) state.note = step.note.trim();
    if (typeof step.operation === 'string' && step.operation.trim()) state.operation = step.operation.trim();
    const nextProgress = clampProgress(step.progress);
    if (nextProgress !== null) state.progress = nextProgress;
    return state;
  }

  async function runWithWaiting(title, fn, options = {}) {
    let token = null;
    const note = String(options?.note || 'Please wait while package lifecycle operation completes.').trim();
    const operation = String(options?.operation || 'Package Lifecycle').trim();
    const progressSteps = Array.isArray(options?.progressSteps) ? options.progressSteps.filter((item) => item && typeof item === 'object') : [];
    const stepIntervalMs = Math.max(450, Number(options?.stepIntervalMs) || 1400);
    let stepIndex = 0;
    let stepTimer = null;

    const applyStep = (index) => {
      if (!progressSteps.length) return;
      const safeIndex = Math.max(0, Math.min(progressSteps.length - 1, index));
      stepIndex = safeIndex;
      if (typeof window.updateLoading === 'function') {
        window.updateLoading(buildLoadingState(title, note, operation, progressSteps[safeIndex]));
      }
    };

    try {
      if (typeof window.showLoading === 'function') {
        if (progressSteps.length) {
          token = window.showLoading(buildLoadingState(title, note, operation, progressSteps[0]));
        } else {
          token = window.showLoading({
            title,
            note,
            operation
          });
        }
      }
      if (progressSteps.length > 1) {
        stepTimer = window.setInterval(() => {
          if (stepIndex >= progressSteps.length - 1) return;
          applyStep(stepIndex + 1);
        }, stepIntervalMs);
      }
      const result = await fn();
      if (progressSteps.length && typeof window.updateLoading === 'function') {
        window.updateLoading({
          title: String(title || '').trim() || 'Please wait',
          note: 'Operation completed successfully.',
          operation: 'Completed',
          progress: 100
        });
        await waitMs(220);
      }
      return result;
    } finally {
      if (stepTimer) {
        window.clearInterval(stepTimer);
      }
      if (typeof window.hideLoading === 'function' && token) {
        window.hideLoading(token);
      }
    }
  }

  function escapeHtml(value) {
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function formatBytes(value) {
    const size = Number(value);
    if (!Number.isFinite(size) || size <= 0) return '-';
    if (size < 1024) return `${size} B`;
    if (size < 1024 * 1024) return `${(size / 1024).toFixed(1)} KB`;
    if (size < 1024 * 1024 * 1024) return `${(size / (1024 * 1024)).toFixed(1)} MB`;
    return `${(size / (1024 * 1024 * 1024)).toFixed(2)} GB`;
  }

  function createRemoveInventoryWizardState(packageId, preview = {}) {
    const inventory = preview && typeof preview === 'object' ? (preview.deletionInventory || {}) : {};
    const hasOwnSelectedFlag = (row) => row && typeof row === 'object' && Object.prototype.hasOwnProperty.call(row, 'selected');
    const defaultSelected = (row) => (hasOwnSelectedFlag(row) ? row.selected === true : true);

    return {
      packageId: String(packageId || '').trim(),
      modifiedCount: Array.isArray(preview?.modifiedRecords) ? preview.modifiedRecords.length : 0,
      criticalRows: (Array.isArray(inventory.critical) ? inventory.critical : [])
        .filter((row) => row && (row.id || row.label))
        .map((row) => ({
          id: String(row.id || '').trim(),
          label: String(row.label || row.id || 'Critical item')
        })),
      tableRows: (Array.isArray(inventory.tables) ? inventory.tables : [])
        .filter((row) => row && row.id && row.entityType)
        .map((row) => ({
          id: String(row.id || '').trim(),
          entityType: String(row.entityType || '').trim(),
          backendMode: String(row.backendMode || 'data').trim(),
          estimatedRowCount: Number(row.estimatedRowCount || 0) || 0,
          selected: defaultSelected(row)
        })),
      fileRows: (Array.isArray(inventory.files) ? inventory.files : [])
        .filter((row) => row && row.id)
        .map((row) => ({
          id: String(row.id || '').trim(),
          exists: row.exists === true,
          size: Number(row.size || 0) || 0,
          selected: defaultSelected(row)
        }))
    };
  }

  function getRemoveWizardStepModel(stepIndex = 0) {
    const steps = [
      { key: 'critical', title: 'Critical (Always Removed)', selectable: false },
      { key: 'table', title: 'Tables (Selectable)', selectable: true },
      { key: 'file', title: 'Files (Selectable)', selectable: true }
    ];
    return steps[Math.max(0, Math.min(steps.length - 1, Number(stepIndex) || 0))];
  }

  function setRemoveWizardSelection(state, kind, itemId, checked) {
    if (!state || !kind || !itemId) return;
    const key = String(kind || '').trim().toLowerCase();
    const id = String(itemId || '').trim();
    const nextChecked = checked === true;
    if (!id) return;
    if (key === 'table') {
      const row = state.tableRows.find((entry) => entry && entry.id === id);
      if (row) row.selected = nextChecked;
    }
    if (key === 'file') {
      const row = state.fileRows.find((entry) => entry && entry.id === id);
      if (row) row.selected = nextChecked;
    }
  }

  function setRemoveWizardSelectionAll(state, kind, checked) {
    if (!state || !kind) return;
    const key = String(kind || '').trim().toLowerCase();
    const nextChecked = checked === true;
    if (key === 'table') {
      state.tableRows.forEach((row) => {
        if (row && row.id) row.selected = nextChecked;
      });
    }
    if (key === 'file') {
      state.fileRows.forEach((row) => {
        if (row && row.id) row.selected = nextChecked;
      });
    }
  }

  function buildRemoveWizardItemsHtml(state, kind) {
    const key = String(kind || '').trim().toLowerCase();
    if (key === 'critical') {
      if (!Array.isArray(state.criticalRows) || state.criticalRows.length === 0) {
        return '<div class="small text-muted">No critical items were listed.</div>';
      }
      return state.criticalRows.map((row) => `
        <label class="d-flex align-items-start gap-2 small mb-2">
          <input type="checkbox" checked disabled>
          <span>${escapeHtml(row.label || row.id || 'Critical item')}</span>
        </label>
      `).join('');
    }

    if (key === 'table') {
      if (!Array.isArray(state.tableRows) || state.tableRows.length === 0) {
        return '<div class="small text-muted">No payload tables detected for this package.</div>';
      }
      return state.tableRows.map((row) => `
        <label class="d-flex align-items-start gap-2 small mb-2">
          <input
            class="pkg-remove-wizard-check"
            type="checkbox"
            data-kind="table"
            data-item-id="${escapeHtml(row.id)}"
            ${row.selected ? 'checked' : ''}>
          <span>
            <span class="fw-semibold">${escapeHtml(row.entityType)}</span>
            <span class="text-muted">(${escapeHtml(row.backendMode || 'data')} | rows: ${Number(row.estimatedRowCount || 0)})</span>
          </span>
        </label>
      `).join('');
    }

    if (!Array.isArray(state.fileRows) || state.fileRows.length === 0) {
      return '<div class="small text-muted">No payload files detected for this package.</div>';
    }
    return state.fileRows.map((row) => `
      <label class="d-flex align-items-start gap-2 small mb-2">
        <input
          class="pkg-remove-wizard-check"
          type="checkbox"
          data-kind="file"
          data-item-id="${escapeHtml(row.id)}"
          ${row.selected ? 'checked' : ''}>
        <span>
          <span class="fw-semibold">${escapeHtml(row.id)}</span>
          <span class="text-muted d-block">exists: ${row.exists ? 'yes' : 'no'} | size: ${escapeHtml(formatBytes(row.size))}</span>
        </span>
      </label>
    `).join('');
  }

  function buildRemoveWizardStepHtml(state, stepIndex = 0) {
    const stepModel = getRemoveWizardStepModel(stepIndex);
    const stepNumber = Math.max(1, Math.min(3, Number(stepIndex || 0) + 1));
    const stepHint = stepModel.key === 'critical'
      ? 'These items are mandatory and will always be removed.'
      : (stepModel.key === 'table'
        ? 'Choose package tables/collections to remove.'
        : 'Choose payload-copied files to remove.');
    const selectableControls = stepModel.selectable
      ? `
        <div class="d-flex gap-2 flex-wrap">
          <button type="button" class="btn btn-outline-secondary btn-sm pkg-remove-wizard-toggle-btn" data-kind="${escapeHtml(stepModel.key)}" data-mode="all">Select All</button>
          <button type="button" class="btn btn-outline-secondary btn-sm pkg-remove-wizard-toggle-btn" data-kind="${escapeHtml(stepModel.key)}" data-mode="none">Unselect All</button>
        </div>
      `
      : '';

    return `
      <div class="small">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
          <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">Step ${stepNumber} of 3</span>
          <span class="text-muted">Package: <code>${escapeHtml(state.packageId)}</code></span>
        </div>
        <p class="mb-2">
          Preview found <b>${Number(state.modifiedCount || 0)}</b> modified package-owned record(s).
        </p>
        <div class="border rounded p-2">
          <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
            <div>
              <div class="fw-semibold">${escapeHtml(stepModel.title)}</div>
              <div class="text-muted small">${escapeHtml(stepHint)}</div>
            </div>
            ${selectableControls}
          </div>
          <div class="border rounded p-2" style="height: 250px; overflow:auto;">
            ${buildRemoveWizardItemsHtml(state, stepModel.key)}
          </div>
        </div>
      </div>
    `;
  }

  function attachRemoveWizardStepHandlers(state, stepIndex = 0) {
    const stepModel = getRemoveWizardStepModel(stepIndex);
    if (!stepModel.selectable) return;
    const body = document.getElementById('messageModalBody');
    if (!body) return;

    body.querySelectorAll('.pkg-remove-wizard-check[type="checkbox"]').forEach((input) => {
      input.addEventListener('change', () => {
        const kind = String(input.getAttribute('data-kind') || '').trim().toLowerCase();
        const itemId = String(input.getAttribute('data-item-id') || '').trim();
        setRemoveWizardSelection(state, kind, itemId, input.checked === true);
      });
    });

    body.querySelectorAll('.pkg-remove-wizard-toggle-btn').forEach((button) => {
      button.addEventListener('click', (event) => {
        event.preventDefault();
        const kind = String(button.getAttribute('data-kind') || '').trim().toLowerCase();
        const mode = String(button.getAttribute('data-mode') || '').trim().toLowerCase();
        const selectAll = mode === 'all';
        setRemoveWizardSelectionAll(state, kind, selectAll);
        body.querySelectorAll(`.pkg-remove-wizard-check[data-kind="${kind}"]`).forEach((input) => {
          input.checked = selectAll;
        });
      });
    });
  }

  function collectDeleteSelectionFromWizardState(state) {
    return {
      tables: (Array.isArray(state?.tableRows) ? state.tableRows : [])
        .filter((row) => row && row.id && row.selected === true)
        .map((row) => row.id),
      files: (Array.isArray(state?.fileRows) ? state.fileRows : [])
        .filter((row) => row && row.id && row.selected === true)
        .map((row) => row.id)
    };
  }

  async function showRemoveInventoryWizard(packageId, preview = {}) {
    const state = createRemoveInventoryWizardState(packageId, preview);
    let stepIndex = 0;

    while (true) {
      const buttons = stepIndex === 0
        ? [
          { text: 'Cancel', class: 'btn-secondary' },
          { text: 'Next', class: 'btn-primary' }
        ]
        : (stepIndex === 1
          ? [
            { text: 'Cancel', class: 'btn-secondary' },
            { text: 'Back', class: 'btn-outline-secondary' },
            { text: 'Next', class: 'btn-primary' }
          ]
          : [
            { text: 'Cancel', class: 'btn-secondary' },
            { text: 'Back', class: 'btn-outline-secondary' },
            { text: 'Remove Package', class: 'btn-danger' }
          ]);

      const decisionPromise = showModal({
        title: 'Remove Package',
        icon: 'warning',
        size: 'lg',
        message: buildRemoveWizardStepHtml(state, stepIndex),
        buttons
      });

      attachRemoveWizardStepHandlers(state, stepIndex);
      const decision = await decisionPromise;

      if (decision === 'Cancel' || decision === 'closed') {
        return { status: 'cancelled', report: preview };
      }
      if (decision === 'Back') {
        stepIndex = Math.max(0, stepIndex - 1);
        continue;
      }
      if (decision === 'Next') {
        stepIndex = Math.min(2, stepIndex + 1);
        continue;
      }
      if (decision === 'Remove Package') {
        return {
          status: 'ready',
          report: preview,
          deleteSelection: collectDeleteSelectionFromWizardState(state)
        };
      }
      return { status: 'cancelled', report: preview };
    }
  }

  async function confirmDanger(actionLabel, packageId) {
    const selected = await showModal({
      title: `${actionLabel} Package`,
      icon: 'warning',
      message: `You are about to <b>${actionLabel.toLowerCase()}</b> package <code>${packageId}</code>. This is a destructive lifecycle action.`,
      buttons: [
        { text: 'Cancel', class: 'btn-secondary' },
        { text: actionLabel, class: 'btn-danger' }
      ]
    });
    return selected === actionLabel;
  }

  async function confirmCleanupFailedAttempts() {
    const selected = await showModal({
      title: 'Clean Failed Attempts',
      icon: 'warning',
      message: 'This removes failed package-install attempts and their leftover registry/files when possible. Continue?',
      buttons: [
        { text: 'Cancel', class: 'btn-secondary' },
        { text: 'Clean Failed Attempts', class: 'btn-danger' }
      ]
    });
    return selected === 'Clean Failed Attempts';
  }

  function buildInstallPreviewListHtml(rows = [], renderer = null, emptyText = 'No items.') {
    const list = Array.isArray(rows) ? rows : [];
    if (!list.length) {
      return `<div class="small text-muted">${escapeHtml(emptyText)}</div>`;
    }
    const itemRenderer = typeof renderer === 'function'
      ? renderer
      : ((row) => `<div class="small mb-2"><code>${escapeHtml(row?.entityType || row?.id || '')}</code></div>`);
    return list.map((row) => itemRenderer(row)).join('');
  }

  function buildInstallWizardStepHtml(preview = {}, stepIndex = 0) {
    const safeStep = Math.max(0, Math.min(2, Number(stepIndex) || 0));
    const stepNumber = safeStep + 1;
    const steps = [
      {
        title: 'New Tables/Entities',
        hint: 'Review new data entities introduced by this upgrade.',
        rows: Array.isArray(preview?.newEntities) ? preview.newEntities : [],
        renderer: (row) => `
          <div class="small mb-2">
            <span class="fw-semibold"><code>${escapeHtml(row?.entityType || '')}</code></span>
            <span class="text-muted ms-1">${escapeHtml(row?.reasonCode || '')}</span>
          </div>
        `,
        emptyText: 'No new entities detected.'
      },
      {
        title: 'Structure Changes',
        hint: 'Review schema contract differences between current and incoming manifests.',
        rows: Array.isArray(preview?.schemaChanges) ? preview.schemaChanges : [],
        renderer: (row) => `
          <div class="small mb-2">
            <span class="fw-semibold"><code>${escapeHtml(row?.entityType || '')}</code></span>
            <span class="text-muted ms-1">(${escapeHtml(row?.changeType || 'changed')})</span>
            <div class="text-muted">from <code>${escapeHtml(row?.previousSignature || '-')}</code> to <code>${escapeHtml(row?.nextSignature || '-')}</code></div>
          </div>
        `,
        emptyText: 'No schema signature changes detected.'
      },
      {
        title: 'Behavior Compatibility Checks',
        hint: 'Review guard outcomes for data compatibility requirements.',
        rows: Array.isArray(preview?.behaviorChecks) ? preview.behaviorChecks : [],
        renderer: (row) => `
          <div class="small mb-2">
            <span class="fw-semibold"><code>${escapeHtml(row?.guardId || '')}</code></span>
            <span class="badge ms-1 ${String(row?.status || '').toLowerCase() === 'ok' ? 'bg-success-subtle text-success-emphasis border border-success-subtle' : (String(row?.status || '').toLowerCase() === 'warning' ? 'bg-warning-subtle text-warning-emphasis border border-warning-subtle' : (String(row?.status || '').toLowerCase() === 'skipped' ? 'bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle' : 'bg-danger-subtle text-danger-emphasis border border-danger-subtle'))}">
              ${escapeHtml(String(row?.status || 'unknown').toUpperCase())}
            </span>
            <div class="text-muted">${escapeHtml(row?.message || '')}</div>
          </div>
        `,
        emptyText: 'No upgrade guards declared.'
      }
    ];
    const model = steps[safeStep];
    const blockingCount = Array.isArray(preview?.blockingFindings) ? preview.blockingFindings.length : 0;
    const warningCount = Array.isArray(preview?.warningFindings) ? preview.warningFindings.length : 0;
    return `
      <div class="small">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
          <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">Step ${stepNumber} of 3</span>
          <span class="text-muted"><code>${escapeHtml(preview?.packageId || '')}</code> ${escapeHtml(preview?.currentVersion || '-')} -> ${escapeHtml(preview?.nextVersion || '-')}</span>
        </div>
        <div class="mb-2">
          <span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle me-1">Blocking: ${blockingCount}</span>
          <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Warning: ${warningCount}</span>
        </div>
        <div class="border rounded p-2">
          <div class="fw-semibold mb-1">${escapeHtml(model.title)}</div>
          <div class="text-muted small mb-2">${escapeHtml(model.hint)}</div>
          <div class="border rounded p-2" style="height: 260px; overflow:auto;">
            ${buildInstallPreviewListHtml(model.rows, model.renderer, model.emptyText)}
          </div>
        </div>
      </div>
    `;
  }

  async function showInstallUpgradeWizard(preview = {}) {
    const requiresAcknowledgement = previewRequiresAcknowledgement(preview);
    if (!previewIsUpgrade(preview) || !requiresAcknowledgement) {
      return {
        status: 'ready',
        ackToken: getInstallPreviewAckToken(preview)
      };
    }
    let stepIndex = 0;
    while (true) {
      const buttons = stepIndex === 0
        ? [
          { text: 'Cancel', class: 'btn-secondary' },
          { text: 'Next', class: 'btn-primary' }
        ]
        : (stepIndex === 1
          ? [
            { text: 'Cancel', class: 'btn-secondary' },
            { text: 'Back', class: 'btn-outline-secondary' },
            { text: 'Next', class: 'btn-primary' }
          ]
          : [
            { text: 'Cancel', class: 'btn-secondary' },
            { text: 'Back', class: 'btn-outline-secondary' },
            { text: 'Confirm Upgrade', class: 'btn-danger' }
          ]);
      const decision = await showModal({
        title: 'Upgrade Compatibility Preview',
        icon: 'warning',
        size: 'lg',
        message: buildInstallWizardStepHtml(preview, stepIndex),
        buttons
      });
      if (decision === 'Cancel' || decision === 'closed') {
        return { status: 'cancelled', ackToken: '' };
      }
      if (decision === 'Back') {
        stepIndex = Math.max(0, stepIndex - 1);
        continue;
      }
      if (decision === 'Next') {
        stepIndex = Math.min(2, stepIndex + 1);
        continue;
      }
      if (decision === 'Confirm Upgrade') {
        return {
          status: 'ready',
          ackToken: getInstallPreviewAckToken(preview)
        };
      }
      return { status: 'cancelled', ackToken: '' };
    }
  }

  async function runInstallPreview(installMethod, targetOrgId) {
    if (installMethod === 'zip') {
      const zipFile = document.getElementById('pkgZipFile')?.files?.[0] || null;
      const sigFile = document.getElementById('pkgSigFile')?.files?.[0] || null;
      const formData = new FormData();
      formData.set('actionStateId', actionStateId);
      if (targetOrgId) formData.set('targetOrgId', targetOrgId);
      if (zipFile) formData.set('packageZip', zipFile);
      if (sigFile) formData.set('packageSig', sigFile);
      return runWithWaiting('Preview Package ZIP Upgrade', async () => fetchJson('/systemSettings/packages/install-zip-preview', {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
          'Accept': 'application/json',
          'X-AJAX-Request': 'true'
        },
        body: formData
      }), {
        note: 'Running upgrade compatibility checks for ZIP package...',
        operation: 'ZIP Install Preview'
      });
    }
    const payload = {
      installMethod,
      localManifestPath: document.getElementById('pkgLocalManifestPath').value || '',
      manifestPath: document.getElementById('pkgManualManifestPath').value || '',
      manifestJson: document.getElementById('pkgManifestJson').value || '',
      packageRootDir: packageRootInput?.value || '',
      actionStateId
    };
    if (targetOrgId) payload.targetOrgId = targetOrgId;
    return runWithWaiting('Preview Package Upgrade', async () => fetchJson('/systemSettings/packages/install-preview', {
      method: 'POST',
      credentials: 'same-origin',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
        'Accept': 'application/json',
        'X-AJAX-Request': 'true'
      },
      body: new URLSearchParams(payload).toString()
    }), {
      note: 'Running upgrade compatibility checks...',
      operation: 'Install Preview'
    });
  }

  async function installPackage() {
    const installMethod = String(installMethodEl.value || '').trim();
    const targetOrgId = String(targetOrgEl?.value || '').trim();
    const progressSteps = getInstallProgressSteps(installMethod);
    await requireAdminVerification();
    const previewResult = await runInstallPreview(installMethod, targetOrgId);
    const preview = coerceInstallPreviewPayload(previewResult);
    const wizard = await showInstallUpgradeWizard(preview);
    if (wizard?.status === 'cancelled') {
      return {
        status: 'cancelled',
        report: preview
      };
    }
    const upgradeAckToken = String(wizard?.ackToken || '').trim();

    if (installMethod === 'zip') {
      const zipFile = document.getElementById('pkgZipFile')?.files?.[0] || null;
      const sigFile = document.getElementById('pkgSigFile')?.files?.[0] || null;
      const formData = new FormData();
      formData.set('actionStateId', actionStateId);
      if (targetOrgId) formData.set('targetOrgId', targetOrgId);
      if (upgradeAckToken) formData.set('upgradeAckToken', upgradeAckToken);
      if (zipFile) formData.set('packageZip', zipFile);
      if (sigFile) formData.set('packageSig', sigFile);
      return runWithWaiting('Installing Package ZIP', async () => fetchJson('/systemSettings/packages/install-zip', {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
          'Accept': 'application/json',
          'X-AJAX-Request': 'true'
        },
        body: formData
      }), {
        note: 'Preparing secure package upload...',
        operation: 'ZIP Install',
        progressSteps
      });
    }

    const payload = {
      installMethod,
      localManifestPath: document.getElementById('pkgLocalManifestPath').value || '',
      manifestPath: document.getElementById('pkgManualManifestPath').value || '',
      manifestJson: document.getElementById('pkgManifestJson').value || '',
      packageRootDir: packageRootInput?.value || '',
      actionStateId
    };
    if (upgradeAckToken) payload.upgradeAckToken = upgradeAckToken;
    if (targetOrgId) payload.targetOrgId = targetOrgId;
    return runWithWaiting('Installing Package', async () => fetchJson('/systemSettings/packages/install', {
      method: 'POST',
      credentials: 'same-origin',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
        'Accept': 'application/json',
        'X-AJAX-Request': 'true'
      },
      body: new URLSearchParams(payload).toString()
    }), {
      note: 'Preparing package installation...',
      operation: 'Install',
      progressSteps
    });
  }

  async function runRowAction(action, packageId) {
    const config = actionMap[action];
    if (!config) throw new Error('Unknown action.');
    if (action === 'section-sync') {
      await requireAdminVerification();
      await openSectionSyncModal(packageId);
      return { status: 'modal', report: sectionSyncState.preview || {} };
    }
    if (action === 'preview-remove') {
      await requireAdminVerification();
      const result = await runWithWaiting('Preview Uninstall Impact', async () => fetchJson(config.endpoint(packageId), {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded',
          'Accept': 'application/json',
          'X-AJAX-Request': 'true'
        },
        body: new URLSearchParams({ actionStateId }).toString()
      }));
      await loadTransactions(packageId);
      return result;
    }

    if (action === 'remove') {
      await requireAdminVerification();
      const previewResult = await runWithWaiting('Preview Uninstall Impact', async () => fetchJson(
        `/systemSettings/packages/${encodeURIComponent(packageId)}/uninstall-preview`,
        {
          method: 'POST',
          credentials: 'same-origin',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'Accept': 'application/json',
            'X-AJAX-Request': 'true'
          },
          body: new URLSearchParams({ actionStateId }).toString()
        }
      ));
      const preview = previewResult.report || {};
      let removeUrl = config.endpoint(packageId);
      const bodyPayload = {
        actionStateId,
        cleanupMode: 'full',
        previewTransactionId: preview.previewTransactionId || ''
      };

      if (preview.mode === 'blocked_missing_manifest') {
        const blockedText = Array.isArray(preview.blockedReasons) && preview.blockedReasons.length
          ? preview.blockedReasons.join(' ')
          : 'Manifest or builder payload is missing, so full cleanup remove is blocked.';
        throw new Error(blockedText);
      }

      const wizardResult = await showRemoveInventoryWizard(packageId, preview);
      if (wizardResult?.status !== 'ready') return { status: 'cancelled', report: preview };
      bodyPayload.deleteSelection = JSON.stringify(wizardResult.deleteSelection || { tables: [], files: [] });

      const removeResult = await runWithWaiting('Removing Package', async () => fetchJson(removeUrl, {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded',
          'Accept': 'application/json',
          'X-AJAX-Request': 'true'
        },
        body: new URLSearchParams(bodyPayload).toString()
      }));
      await loadTransactions(packageId);
      return removeResult;
    }

    if (config.dangerous) {
      const confirmed = await confirmDanger(config.label, packageId);
      if (!confirmed) return { status: 'cancelled' };
    }
    await requireAdminVerification();
    const response = await runWithWaiting(`${config.label} Package`, async () => fetchJson(config.endpoint(packageId), {
      method: 'POST',
      credentials: 'same-origin',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
        'Accept': 'application/json',
        'X-AJAX-Request': 'true'
      },
      body: new URLSearchParams({ actionStateId }).toString()
    }));
    await loadTransactions(packageId);
    return response;
  }

  async function cleanupFailedAttempts() {
    const confirmed = await confirmCleanupFailedAttempts();
    if (!confirmed) return { status: 'cancelled' };
    await requireAdminVerification();
    return runWithWaiting('Cleaning Failed Attempts', async () => fetchJson('/systemSettings/packages/cleanup-failed', {
      method: 'POST',
      credentials: 'same-origin',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
        'Accept': 'application/json',
        'X-AJAX-Request': 'true'
      },
      body: new URLSearchParams({ actionStateId }).toString()
    }), {
      note: 'Removing failed package attempts and stale package files...',
      operation: 'Cleanup Failed Attempts',
      progressSteps: [
        { progress: 15, note: 'Validating access and request token...', operation: 'Validation' },
        { progress: 40, note: 'Scanning installed package snapshot...', operation: 'Snapshot' },
        { progress: 70, note: 'Applying cleanup for failed package attempts...', operation: 'Cleanup' },
        { progress: 92, note: 'Finalizing cleanup report...', operation: 'Finalize' }
      ]
    });
  }

  async function showSuccess(message) {
    await showModal({
      title: 'Completed',
      icon: 'success',
      message,
      buttons: [{ text: 'OK', class: 'btn-success' }]
    });
  }

  function buildCleanupWarningHtml(result = {}) {
    const report = result && typeof result === 'object' ? (result.report || result) : {};
    const rows = Array.isArray(report?.results) ? report.results : [];
    const failed = rows
      .filter((row) => String(row?.result || '').trim().toLowerCase() === 'failed')
      .map((row) => escapeHtml(row?.packageId || row?.name || '(unknown)'));
    const skipped = rows
      .filter((row) => String(row?.result || '').trim().toLowerCase() === 'skipped')
      .map((row) => escapeHtml(row?.packageId || row?.name || '(unknown)'));
    const warnings = Array.isArray(report?.warnings)
      ? report.warnings.map((row) => escapeHtml(String(row || '').trim())).filter(Boolean)
      : [];

    const failedHtml = failed.length
      ? `<div><b>Failed:</b> ${failed.map((id) => `<code>${id}</code>`).join(', ')}</div>`
      : '';
    const skippedHtml = skipped.length
      ? `<div><b>Skipped:</b> ${skipped.map((id) => `<code>${id}</code>`).join(', ')}</div>`
      : '';
    const warningHtml = warnings.length
      ? `<div class="mt-2 small text-muted">${warnings.join('<br>')}</div>`
      : '';
    const summaryHtml = `<div>${escapeHtml(result?.message || 'Cleanup completed with warnings.')}</div>`;
    return `${summaryHtml}${failedHtml}${skippedHtml}${warningHtml}`;
  }

  async function showWarning(messageHtml) {
    await showModal({
      title: 'Completed With Warnings',
      icon: 'warning',
      message: messageHtml,
      buttons: [{ text: 'OK', class: 'btn-warning' }]
    });
  }

  async function showError(message) {
    await showModal({
      title: 'Operation Failed',
      icon: 'error',
      message,
      buttons: [{ text: 'Close', class: 'btn-danger' }]
    });
  }

  installMethodEl.addEventListener('change', () => showInstallPanel(installMethodEl.value));
  showInstallPanel(installMethodEl.value);
  localManifestEl?.addEventListener('change', syncPackageRootFromLocalSelection);
  syncPackageRootFromLocalSelection();
  targetOrgPickBtn?.addEventListener('click', () => {
    if (!window.GenericPicker || !window.GenericPickerPresets || !window.GenericPickerContexts) {
      showError('Generic organization picker is not ready yet.');
      return;
    }
    window.GenericPicker.open(window.GenericPickerPresets.organization({
      title: 'Select Target Organization',
      context: window.GenericPickerContexts.allOrganizations(),
      onSelect: (item) => {
        setTargetOrgSelection(item?.id, item?.identity?.displayName || item?.name || `Organization #${item?.id}`);
      }
    }));
  });
  targetOrgClearBtn?.addEventListener('click', () => {
    setTargetOrgSelection('', '');
  });

  installBtn.addEventListener('click', async () => {
    const original = installBtn.innerHTML;
    installBtn.disabled = true;
    installBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Running...';
    try {
      const result = await installPackage();
      if (result?.status === 'cancelled') {
        setOutput('Cancelled', { action: 'install-preview-or-upgrade-confirmation' });
        return;
      }
      setOutput('Install / Enable', result.report || result);
      await showSuccess(result.message || 'Package operation completed.');
      window.location.reload();
    } catch (error) {
      setOutput('Install Failed', {
        status: 'error',
        message: error.message || 'Unknown error',
        code: error?.code || '',
        details: error?.payload?.details || null
      });
      await showError(error.message || 'Package install failed.');
    } finally {
      installBtn.disabled = false;
      installBtn.innerHTML = original;
    }
  });

  cleanupFailedBtn?.addEventListener('click', async () => {
    const original = cleanupFailedBtn.innerHTML;
    cleanupFailedBtn.disabled = true;
    cleanupFailedBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Running...';
    try {
      const result = await cleanupFailedAttempts();
      if (result?.status === 'cancelled') {
        setOutput('Cancelled', { action: 'cleanup-failed-attempts' });
        return;
      }
      setOutput('Cleanup Failed Attempts', result.report || result);
      if (String(result?.status || '').trim().toLowerCase() === 'warning') {
        await showWarning(buildCleanupWarningHtml(result));
      } else {
        await showSuccess(result.message || 'Failed package attempts cleanup completed.');
      }
      window.location.reload();
    } catch (error) {
      setOutput('Cleanup Failed Attempts Failed', {
        status: 'error',
        message: error.message || 'Unknown error',
        code: error?.code || '',
        details: error?.payload?.details || null
      });
      await showError(error.message || 'Failed package attempts cleanup failed.');
    } finally {
      cleanupFailedBtn.disabled = false;
      cleanupFailedBtn.innerHTML = original;
    }
  });

  document.addEventListener('click', async (event) => {
    const btn = event.target.closest('.pkg-action-btn');
    if (!btn) return;
    if (!btn.closest('.row-actions-menu')) return;
    const action = String(btn.dataset.action || '').trim();
    const packageId = String(btn.dataset.packageId || '').trim();
    if (!action || !packageId) return;
    if (!actionMap[action]) return;
    const original = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
    try {
      const result = await runRowAction(action, packageId);
      if (result?.status === 'cancelled') {
        setOutput('Cancelled', { action, packageId });
        return;
      }
      setOutput(`${actionMap[action]?.label || action} ${packageId}`, result.report || result);
      if (result?.report?.restartRecommended === true) {
        const pkgLabel = result?.report?.packageName || packageId;
        showRestartRecommendedBanner(
          `Package "${pkgLabel}" registry and sections were updated, but paused package routes may remain mounted until you restart the application.`
        );
      }
      if (action !== 'section-sync') {
        await showSuccess(result.message || 'Package operation completed.');
      }
      if (action === 'preview-remove' || action === 'section-sync') return;
      window.location.reload();
    } catch (error) {
      setOutput('Action Failed', {
        action,
        packageId,
        message: error.message || 'Unknown error',
        code: error?.code || '',
        details: error?.payload?.details || null
      });
      await showError(error.message || 'Package action failed.');
    } finally {
      btn.disabled = false;
      btn.innerHTML = original;
    }
  });

  document.getElementById('pkgRefreshSnapshotBtn')?.addEventListener('click', () => {
    window.location.reload();
  });

  restartApplicationBtn?.addEventListener('click', async () => {
    const confirmed = await showModal({
      title: 'Restart application?',
      icon: 'warning',
      message: 'This stops the Node process so your host can start a new one. Active users may see errors during the brief downtime. Continue?',
      buttons: [
        { text: 'Cancel', class: 'btn-secondary' },
        { text: 'Restart application', class: 'btn-danger' }
      ]
    });
    if (confirmed !== 'Restart application') return;
    const original = restartApplicationBtn.innerHTML;
    restartApplicationBtn.disabled = true;
    restartApplicationBtn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
    try {
      await requireAdminVerification();
      const result = await runWithWaiting('Restart Application', async () => fetchJson('/systemSettings/application/restart', {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded',
          'Accept': 'application/json',
          'X-AJAX-Request': 'true'
        },
        body: new URLSearchParams({ actionStateId }).toString()
      }), {
        note: 'Scheduling graceful shutdown...',
        operation: 'Restart Application',
        progressSteps: [
          { progress: 30, note: 'Validating restart permission...', operation: 'Validation' },
          { progress: 70, note: 'Closing HTTP server...', operation: 'Shutdown' },
          { progress: 95, note: 'Exit scheduled — connection may drop...', operation: 'Exit' }
        ]
      });
      setOutput('Restart application', result.report || result);
      await showWarning('Application restart was scheduled. This page may stop responding while the host starts a new process.');
    } catch (error) {
      setOutput('Restart Application Failed', { message: error.message || 'Unknown error', code: error?.code || '' });
      await showError(error.message || 'Application restart failed.');
      restartApplicationBtn.disabled = false;
      restartApplicationBtn.innerHTML = original;
    }
  });

  document.getElementById('pkgClearOutputBtn')?.addEventListener('click', () => {
    outputEl.textContent = 'Ready.';
  });

  const firstPackageRow = tableEl?.querySelector('tbody tr[data-package-id]');
  if (firstPackageRow?.dataset?.packageId) {
    loadTransactions(firstPackageRow.dataset.packageId);
  }
})();
</script>
